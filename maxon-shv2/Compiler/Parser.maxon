		let typeParamCount = self.enclosingTypeParams.count()
		for i in 0 upto positions.count() 'eachParam'
			if self.paramIsTypeParamTyped(positions, index: i) 'namesATypeParameter'
				return OpaqueParamInfo.create(paramNames, positions: positions, typeParamCount: typeParamCount)
			end 'namesATypeParameter'
		end 'eachParam'

		return sharedNoOpaqueParams
	end 'opaqueParamsDeclaredBy'

	// ⭐ **RECORD THIS FUNCTION'S PARAMETER DEFAULTS WHOLE-PROGRAM (BATCH2 slice 4)** — one
	// `ParamDefaultEntry` per function that declares at least one, and one `FuncReturnTypeEntry` per default
	// naming the synthesized helper that produces it (see `SignatureIndex.ParamDefaultInfo` for what the
	// helper is). Both must come from the SWEEP rather than from the real parse, because both answer a
	// question a CALL SITE asks about a callee that may be declared in another file: "may I omit this
	// argument?" and "what type does the helper I am about to call return?".
	//
	// The names are recorded CALL-ALIGNED — `SelfParamName` at slot 0 for an instance method — exactly as
	// `callAlignedInstanceParams` aligns the consume facts, and for that routine's reason: the call site
	// slots a label to a position in the list the RECEIVER-PREPENDING caller built. The helper's own name is
	// minted from the parameter's SOURCE position, which is the position `parseFunctionParameters` knows, so
	// the two ends of the mint need share nothing but `paramDefaultHelperName`.
	//
	// It is TOLERANT like every other routine on this walk: a parameter type it cannot read abandons the
	// whole function's defaults rather than publishing half of them, and the real parse reports the malformed
	// declaration with a position.
	//
	// A helper is published at the DECLARING function's own tier, which is the only true statement about it:
	// nobody writes its name, so no file can be refused it, and every call to it is the compiler's own mint.
	function recordScannedParamDefaults(funcName ByteArray, paramsStart TokenIndex, takesReceiver bool, visibility Visibility, entries FuncReturnTypeEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray)
		if not self.paramListDeclaresDefault(paramsStart) 'noDefaults'
			return
		end 'noDefaults'

		var names = ByteArrayArray.create()
		var producers = ParamDefaultProducerArray.create()
		if takesReceiver 'prependReceiver'
			names.push(SelfParamName)
			producers.push(ParamDefaultProducer.required)
		end 'prependReceiver'

		let resume = self.pos
		var q = paramsStart + 1
		while true 'params'
			names.push(self.tokenAt(q).value)
			let typeStart = q + 1
			let typeEnd = self.skipParamType(typeStart)
			let itemEnd = self.paramItemEndFrom(typeEnd)
			if self.kindAt(typeEnd) != TokenKind.equals 'noDefault'
				producers.push(ParamDefaultProducer.required)
			end 'noDefault' else 'hasDefault'
				let callerLocation = self.callerLocationDefaultAt(typeEnd, exprEnd: itemEnd)
				if isCallerLocationDefault(callerLocation) 'materializedAtEachCallSite'
					// ⭐ **A CALLER-LOCATION SLOT PUBLISHES THE KEYWORD AND NOTHING ELSE (W72)** — no helper
					// name, and so no `FuncReturnTypeEntry` either: there is no synthesized function whose
					// return type a caller could need. The parameter's own declared type is not read here
					// for the same reason, so a malformed one no longer abandons this function's defaults on
					// the sweep's account — the real parse reports it with a position, as it always did.
					producers.push(paramDefaultProducerOf(callerLocation))
				end 'materializedAtEachCallSite' else 'synthesizedHelper'
					// The helper RETURNS the parameter's declared type, so the default expression is typed and
					// range-checked against exactly what the parameter demands, by the ordinary `return` rules.
					self.pos = typeStart
					let paramType = try self.parseTypeReference() otherwise 'malformedType'
						self.pos = resume
						return
					end 'malformedType'
					// ⚠ **THE INDEX IS THE PARAMETER'S CALL-ALIGNED POSITION, NOT ITS SOURCE POSITION**, which for
					// an instance method differ by the prepended receiver. `producers.count()` IS that position
					// — one entry has been pushed per parameter already named, plus one for the receiver — and it
					// is also the index `ParamDefaultInfo.producerFor` is asked with, so the mint and the lookup
					// cannot key on different numbers. (They did: minted from the SOURCE index, a defaulted
					// instance method published `#0` and its declaration looked up `#1`, and the divergence
					// surfaced as a backend `call to unknown function` with no source position at all.)
					let helperName = paramDefaultHelperName(funcName, paramIndex: producers.count())
					producers.push(ParamDefaultProducer.helper(helperName))
					// ⭐ **AND ITS PRE-ERASURE SPELLING RIDES TOO (A2j / A2m).** The helper's return type IS the
					// parameter's declared type, so if the parameter was written `__ManagedMemory` — or a TUPLE
					// with a buffer in a slot — the helper RETURNS that surface, and `emitCall`'s
					// `markDeclaredSurface` reads it off the whole-program index by callee name, which for this
					// callee is the entry pushed here. Hardcoded plain, a defaulted buffer parameter would hand
					// its call site a value bearing the `Array` member roster instead of the buffer's: a wrong
					// surface, which is a wrong answer rather than a compile error. Asked at `typeStart`, the one
					// place the spelling is still readable, through the same door `parseFunctionParameters` uses.
					// `slotElementsFromAliases: false` for `returnDeclaredSurface`'s reason, and it is the same
					// reason: this helper is published by the SWEEP, whose copy is the one the whole-program index
					// stores, so a SLOT's element bit read here would be how far the sweep had got.
					entries.push(FuncReturnTypeEntry.create(helperName, returnType: MaxonReturnType.value(paramType), declaredSurface: self.declaredSurfaceAt(typeStart, slotElementsFromAliases: false), visibility: visibility))
					self.recordDefaultHelperGlobalAliasReturn(helperName, valueStart: (typeEnd + 1) as TokenIndex, exprEnd: itemEnd, globalAliasReturns: globalAliasReturns)
				end 'synthesizedHelper'
			end 'hasDefault'

			if self.kindAt(itemEnd) != TokenKind.comma 'endList'
				break
			end 'endList'
			q = itemEnd + 1
		end 'params'
		self.pos = resume

		paramDefaults.push(ParamDefaultEntry.create(funcName, info: ParamDefaultInfo.create(names, producers: producers), takesReceiver: takesReceiver))
	end 'recordScannedParamDefaults'

	// ⭐⭐ **W117 FOR THE OTHER `return` IN THE LANGUAGE: A PARAMETER DEFAULT.** The captured expression becomes
	// the whole body of a synthesized nullary helper (`parseDefaultHelperBody`), so `f(p T = A)` hands its
	// caller precisely what `f(A)` hands it — and until this rung the two spellings had DIFFERENT answers to
	// "may this argument alias a `let` global's record?", which is the one thing a default may never differ from
	// the written-out argument in. Both halves of that were measured on the tip:
	//
	//   • `f(p T = A)` naming the global BARE was refused outright — `ownedFormOfBorrowedValue` keeps its E2015
	//     for a helper the sweep never published, and the sweep read `return` statements only. That refusal is
	//     `ParseStaging.maxon:129` and `Project.maxon:682` in shv2's own source, on a shape the bootstrap
	//     compiles and runs.
	//   • `f(p T = accessor())` naming one THROUGH A CALL was silently ACCEPTED and mutated the global, where
	//     the written-out `f(accessor())` beside it is E3019. A missed EDGE costs no refusal here, because the
	//     helper returns an already-owned call result and never reaches the promotion — so this door had to be
	//     opened for soundness and not only to lift a refusal.
	//
	// ⚠ **KEYED BY THE HELPER NAME THE SWEEP ITSELF MINTS, WHICH IS AN OVERLOAD SET'S FIRST MEMBER'S (W74).**
	// A later member re-points its own helper to a name derived from its REGISTRATION name
	// (`declaredParamDefaultHelperName`), which no entry here is filed under — so that member's default is
	// refused E2015 rather than admitted unmarked. That is the family rule holding in the one place a key can
	// be wrong: the sweep publishes ONE entry per bare name, and the direction it errs in is a REFUSAL.
	//
	// ⚡ Four columns per default expression, unconditionally. The per-BODY twin had to be gated behind a
	// `sawAReturn` flag because every function in the program walks it; this one is reached only for a
	// parameter that declares an expression default, of which a program has tens.
	function recordDefaultHelperGlobalAliasReturn(helperName ByteArray, valueStart TokenIndex, exprEnd TokenIndex, globalAliasReturns GlobalAliasReturnEntryArray)
		var returnedNames = ByteArrayArray.create()
		var returnedHeads = ByteArrayArray.create()
		var returnedAt = TokenIndexColumn.create()
		var returnCalls = ForwardCallArray.create()
		self.noteReturnedGlobalOrForward(valueStart, regionEnd: SweptValueRegionEnd.atToken(exprEnd), returnedNames: returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, returnCalls: returnCalls)

		// The same "states nothing, records nothing" gate `scanBodyFacts` raises, and it is nearly every
		// default: `= 0`, `= false`, `= ""`, `= Colour.red` all leave both columns empty.
		//
		// ⚠ **AND NO SHADOWING FILTER, WHICH IS A PROPERTY OF THE HELPER RATHER THAN AN OMISSION.**
		// `returnedNamesNotBoundHere` exists because a BODY may bind the name it returns; a default expression
		// is one expression parsed into a helper whose scope is created empty and whose parameter list is
		// empty (`parseDefaultHelperBody`), so there is nothing it could bind and no local for a name to
		// resolve to ahead of the global.
		if not GlobalAliasReturnInfo.statesAnything(returnedNames, returnCalls: returnCalls) 'statesNothing'
			return
		end 'statesNothing'

		// `bareCallOnly` and no receiver: the helper is a free function whose name is in the reserved `__`
		// space with a `#` in it (`Project.paramDefaultHelperName`), so it wears its own node in the closure's
		// graph and no call any source can write reaches it. Its own forwarding EDGES are ordinary and are
		// what carries the mark up from a default that calls an accessor.
		globalAliasReturns.push(GlobalAliasReturnEntry.create(helperName, info: GlobalAliasReturnInfo.create(returnedNames, returnCalls: returnCalls, bareName: helperName, callability: DeclCallability.bareCallOnly, declFilePath: self.filePath), takesReceiver: false))
	end 'recordDefaultHelperGlobalAliasReturn'

	// Does the parameter list at `parenPos` declare a default on ANY parameter? A peek-only, allocation-free
	// walk asked once per declared function.
	//
	// ⚠ It is a SEPARATE walk from `recordScannedParamDefaults`' and deliberately so: merged, every function
	// in the program would allocate the two name arrays that routine builds, on the sweep's hottest path, to
	// discover that the overwhelming majority declare no default at all. This is the same gate
	// `recordScannedSignature` puts in front of the `throws` clause and the inner-alias parameter info.
	function paramListDeclaresDefault(parenPos TokenIndex) returns bool
		if self.kindAt(parenPos) != TokenKind.leftParen 'noParens'
			return false
		end 'noParens'
		var q = parenPos + 1
		if self.kindAt(q) == TokenKind.rightParen 'noParams'
			return false
		end 'noParams'

		while true 'params'
			let typeEnd = self.skipParamType(q + 1)
			if self.kindAt(typeEnd) == TokenKind.equals 'found'
				return true
			end 'found'
			if self.kindAt(typeEnd) != TokenKind.comma 'endList'
				return false
			end 'endList'
			q = typeEnd + 1
		end 'params'
		// No `paramItemEndFrom` step here, and that is not an omission: this walk RETURNS at the first `=`
		// it finds, so it never has one to step over.
		panic("paramListDeclaresDefault: the parameter loop only exits by returning at `=`, the closing `)` or EOF")
	end 'paramListDeclaresDefault'

	// ⭐ **THE CALL-ALIGNED PARAMETER LIST of an instance method in a generic type** — `SelfParamName` at slot 0
	// (its sentinel type-parameter position), then the source parameters, in the SAME order the receiver-prepending
	// call site pushes them (`parseCallNamed`), so a per-position consume/feed fact lands at the argument's own
	// call-site position. `typeParamPositionsOut` is filled in lockstep (self's sentinel, then each source
	// parameter's declared position from `paramNamesIn`).
	//
	// ⚠ **THE ALIGNMENT IS SPELLED IN TWO SHARED PIECES, NOT IN THIS ONE PLACE, AND THE HEADER SAID OTHERWISE.**
	// `pushReceiverTypeParamSlot` is the POSITION half and `callAlignedFrom` the NAME half, and they must
	// straddle the parameter-list walk — so a caller that needs the walk's own SOURCE names back
	// (`recordScannedSignature`, for the overload surface it publishes) cannot go through this wrapper and
	// calls the two halves itself. Neither half is written out at a call site, which is what keeps the two
	// scans from drifting on where `self` sits — a drift that would land a feed on the wrong parameter (a
	// wrong-consume double-free at the concrete call site). This wrapper is the transitive array-feed scan's
	// (`scanTypeMethodFeeds`) door onto them.
	function callAlignedInstanceParams(paramsStart TokenIndex, typeParamPositionsOut TypeParamPositionArray) returns ByteArrayArray
		self.pushReceiverTypeParamSlot(typeParamPositionsOut)
		return callAlignedFrom(self.paramNamesIn(paramsStart, typeParamPositionsOut: typeParamPositionsOut, collectTypeParamFlags: true, typesOut: self.emptySweptParamTypes, collectTypes: false))
	end 'callAlignedInstanceParams'

	// The POSITION half of the alignment above — the receiver's slot-0 entry, which names no `uses` parameter
	// and so takes the "not a type parameter" sentinel. It is its own routine because the two halves cannot
	// be spelled together: this one has to be pushed BEFORE `paramNamesIn` appends the source parameters'
	// positions, while `callAlignedFrom` prepends to the NAMES the same walk returns. Two callers stand
	// between those two moments — this file's declaration sweep (`recordScannedSignature`, which needs the
	// SOURCE names back for the overload surface) and `callAlignedInstanceParams` — so the sentinel is named
	// once rather than written out at each.
	function pushReceiverTypeParamSlot(typeParamPositionsOut TypeParamPositionArray)
		typeParamPositionsOut.push(self.enclosingTypeParams.count())
	end 'pushReceiverTypeParamSlot'

	// ⭐ **THE CONSUME SCAN (P1.4a wave 2)** — one entry per function whose body MOVES a parameter into
	// durable storage (a struct-literal field value). A peek-only walk of the body from `bodyStart` to its
	// matching `end`: it tracks the bracket stack (a struct literal is `{…}`, a call is `(…)`), and when a
	// `:` appears with the innermost open bracket a `{`, it is a struct-field separator — if the value that
	// follows is a bare reference (parens stripped) to a parameter, that parameter is CONSUMED.
	//
	// ⚠ **THIS IS A SOUND APPROXIMATION, NOT AN ORACLE, AND IT DOES NOT NEED TO BE ONE.** The callee-side
	// move (`moveInPayload`) refuses to move a parameter that is NOT enrolled owned, so an UNDER-detected
	// consume becomes a clean `E2015` at the constructor rather than a double-free; an OVER-detected one (a
	// shadowed name) makes the callee OWN and DROP the value once while its caller was poisoned — sound, just
	// stricter. So the scan may be simple: it detects the direct constructor sink (`Self{f: p}`) the corpus
	// uses and leaves the transitive case (a parameter forwarded to a consuming CALLEE — a `:` at a `(`
	// level, or a call argument) to the borrowed-value refusal. Parens are stripped exactly as the real
	// parse's `rhsWasBareLocalReference` strips them, so the two agree on what a bare-parameter value is.
	// The type-parameter position parameter `index` was declared with (P1.6-B2), or `enclosingTypeParams.count()`
	// (the "not a type parameter" sentinel `typeParamPositionOf` uses) when it is a plain type or out of range.
	// SAFE against the SHARED EMPTY positions array outside a generic type (`collectTypeParamFlags` false): a
	// missing index reads as the sentinel — a plain parameter.
	function paramTypeParamPositionAt(positions TypeParamPositionArray, index ParamCount) returns TypeParamPosition
		return try positions.get(index) otherwise self.enclosingTypeParams.count()
	end 'paramTypeParamPositionAt'

	// Is parameter `index` type-parameter-typed, per the positions `paramNamesIn` filled? A position below the
	// type-parameter count names a real `uses` parameter; the sentinel (or a short/empty array) is a plain one.
	function paramIsTypeParamTyped(positions TypeParamPositionArray, index ParamCount) returns bool
		return self.paramTypeParamPositionAt(positions, index: index) < self.enclosingTypeParams.count()
	end 'paramIsTypeParamTyped'

	// ⚠ **IT WAS `scanBodyParamFacts` AND IS NOT ANY MORE, BECAUSE W117 GAVE IT A FACT THAT IS NOT ABOUT
	// PARAMETERS**: what this body RETURNS. The three facts share this walk rather than getting one each, for
	// the reason the walk exists at all — it already stands on every token of the body carrying the bracket
	// and block-depth state a second walk would have to rebuild — so the name says "this body's facts" and the
	// list of them is the paragraphs below.
	function scanBodyFacts(funcName ByteArray, funcBareName ByteArray, paramNames ByteArrayArray, byRefParamNames ByteArrayArray, typeParamPositions TypeParamPositionArray, bodyStart TokenIndex, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, divergingDecls DivergingDeclEntryArray, declaresThrows bool, detectFieldStores bool, takesReceiver bool)
		// ⚠ **TWO NAME LISTS, AND THEY ARE NOT THE SAME LIST.** The CONSUME half reads `paramNames`, which the
		// caller leaves EMPTY for a non-generic instance method (a direct `Self{f: p}` store there is left to the
		// callee-side borrowed-value refusal — see the call site). The BY-REFERENCE half reads `byRefParamNames`,
		// which is call-aligned and filled for every declaration, because an instance method that forwards a
		// parameter into a reassigning one is exactly as much a forwarder as a free function is
		// (`pass-by-reference.transitive-reassign-through-sibling-methods` is that program). So the parameter
		// half runs when EITHER has something to look for — that disjunction is `scansParams` below.
		// ⭐ **THE WALK IS UNCONDITIONAL SINCE W117, BUT THE PARAMETER PROBES ARE NOT — THE OLD GUARD BECAME A
		// SCOPE RATHER THAN A `return`.** It used to return here whenever neither name list had anything to look
		// for; W117's question — does this body RETURN a `let` global's record? — has nothing to do with
		// parameters, and the functions that ask it most are exactly the receiverless zero-parameter accessors
		// that guard skipped (`Box.get()`, `CharacterSet.whitespaces()`). So the walk widened and the guard
		// stayed, one level in: with BOTH lists empty every parameter probe below is provably inert (each is
		// gated on an index below a count of zero, and the bracket stacks exist only to feed those probes), so a
		// zero-parameter body pays the token walk and the return scan and nothing else. ⚠ Do not fold
		// `scansParams` into the probes individually — it is the pre-W117 guard, and keeping it whole is what
		// makes "what this widening costs" one predicate rather than five.
		let scansParams = paramNames.count() > 0 or byRefParamNames.count() > 0
		// ⭐ **THE THREE PER-PARAMETER BIT COLUMNS START EMPTY AND ARE GROWN AT THE FACT** — see `setParamBit`,
		// which carries both halves of why they are no longer pre-filled from a shared module-level empty.
		var consumed = BoolArray.create()
		// The two by-reference columns — see `SignatureIndex.ParamReassignInfo` for what each means and why the
		// sweep records them separately instead of combining them here.
		var reassignedDirect = BoolArray.create()
		var reassignedForwarded = BoolArray.create()
		var forwardCalls = ForwardCallArray.create()
		var statesByRef = false
		// ⭐ **W117's THREE COLUMNS: the names this body RETURNS as a whole statement, their first SEGMENTS, and
		// the calls whose result it returns.** `returnedHeads` is the head of each name (`Box` of `Box.shared`),
		// which is what the shadowing filter compares against — a body that binds `Box` returns its own local,
		// not the global.
		//
		// ⚡ These were COPY-ON-WRITTEN off shared module-level empties at the first `return` token, and are
		// FRESH since shv2 compiled itself — see the deleted anchors' note above `sharedOverloadIncompatible`
		// for why the privatise flag that made the sharing safe is not a thing an analysis can be asked to
		// believe. A body with no `return` now pays four empty records; it used to pay none.
		var returnedNames = ByteArrayArray.create()
		var returnedHeads = ByteArrayArray.create()
		var returnedAt = TokenIndexColumn.create()
		var returnCalls = ForwardCallArray.create()
		// The type-parameter FEED column, EMPTY until a feed is actually recorded (`setParamFeed`) — a feed
		// requires a type-parameter-typed field, so a top-level function and a non-generic type's method (all of
		// them on the generics-free corpus) never grow it past zero and `typeParamFeedOf` reads every one of their
		// positions as `none`.
		let genericScope = self.enclosingTypeParams.count() > 0
		var feeds = TypeParamFeedArray.create()
		var any = false
		// The bracket stack: `true` for a `{` (struct literal), `false` for a `(`. A `[` is not pushed at all
		// (`trackBracketAt`). The innermost open bracket being a `{` is what distinguishes a struct-field `:`
		// from a labelled-call-argument one. ⚡ Both were SHARED EMPTIES for a body with no parameters to watch
		// — `trackBracketAt` is the only writer and it runs under `scansParams`, as does every reader — and
		// both are FRESH now, for the reason the deleted anchors' note records: `scansParams` is a flag, and a
		// name that may hold a `let` global's record may not be passed somewhere that writes it.
		var braceStack = BoolArray.create()
		var openBrackets = TokenIndexArray.create()
		var blockDepth = 0 as BlockDepth
		// ⭐⭐ **G17's COLUMNS — the whole of "can this body return?", read off the same walk.** There are exactly
		// three ways out of a body that are not its tail: a `return`, a `throw`
		// (or the `otherwise throws` re-throw, which spells the OTHER keyword), and falling off the end. The
		// first two are tokens; the third is ruled out by the tail statement itself being a `panic`. The fourth
		// way — a bare `try f()` propagating the callee's error — is invisible here and is excluded at the
		// declaration by `declaresThrows`, which is the only evidence of it the sweep can hold.
		//
		// ⚠ **THE SAFE DIRECTION IS "IT RETURNS", AND EVERY UNCERTAINTY HERE RESOLVES THAT WAY.** A body this
		// declines to mark compiles exactly as it did before the fact existed; a body wrongly marked stops
		// emitting the edge control really takes, which is a wrong ANSWER with no diagnostic anywhere.
		var bodyCanExitBeforeItsTail = false
		// ⭐ **THE `return` HALF ON ITS OWN, for G18.** The `panic` rule rules out all three exit keywords
		// together; the `throw` rule cannot, because its own tail spells one of them. A `return` is the only
		// keyword that is an exit NEITHER rule's tail can be, so it is the one that needs a column of its own.
		var bodySpellsAReturn = false
		var atStatementStart = false
		var lastTopLevelStatement = bodyStart
		var sawATopLevelStatement = false
		var sawTheFunctionsOwnEnd = false

		var q = bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			// The function's own `end` (at block depth 0) closes the scan.
			if blockDepth == 0 and self.closesBlockAt(q) 'funcEnd'
				sawTheFunctionsOwnEnd = true
				break
			end 'funcEnd'

			let kind = self.kindAt(q)

			// The body's statements are newline-separated, so the first token after a newline at BODY depth
			// opens a top-level statement. `atStatementStart` seeds FALSE rather than true: `bodyStart` is the
			// newline that ends a well-formed header, and a malformed declaration the tolerant sweep landed
			// mid-line on must not have that line read as a statement.
			if kind == TokenKind.newline 'aLineEnds'
				atStatementStart = true
			end 'aLineEnds' else 'aRealToken'
				if blockDepth == 0 and atStatementStart 'aTopLevelStatementOpensHere'
					lastTopLevelStatement = q
					sawATopLevelStatement = true
				end 'aTopLevelStatementOpensHere'
				atStatementStart = false
			end 'aRealToken'

			// `throws` rides beside `throw` because they are two spellings of one exit: the divergent handler
			// form (`otherwise throws E.case`) and a `match` `default throws` both re-throw to the caller
			// without spelling `throw`. Both need an enclosing `throws` clause, so `declaresThrows` already
			// excludes every body that can hold one — this is the guard that keeps that true of a form the
			// grammar has not grown yet.
			if kind == TokenKind.return or kind == TokenKind.throw or kind == TokenKind.throws 'anExitThatIsNotTheTail'
				bodyCanExitBeforeItsTail = true
			end 'anExitThatIsNotTheTail'

			if kind == TokenKind.return 'aReturnAnywhereInThisBody'
				bodySpellsAReturn = true
			end 'aReturnAnywhereInThisBody'

			// ⭐⭐ **W117's SEED AND EDGE, both read off a `return` statement's own first tokens.** Probed here
			// rather than in a walk of its own because this walk already stands on every token of the body with
			// the block-depth state a second one would have to rebuild. AHEAD of the parameter probes because it
			// is the one fact this walk collects for a body that has no parameters at all.
			if kind == TokenKind.return 'returnStatement'
				self.noteReturnedGlobalOrForward((q + 1) as TokenIndex, regionEnd: sharedSweptValueLineEnd, returnedNames: returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, returnCalls: returnCalls)
			end 'returnStatement'

			if scansParams 'aBodyWithParametersToWatch'
				self.trackBracketAt(q, braceStack: braceStack, openBrackets: openBrackets)

				// ⭐⭐ **PBR-2's SEED: `p =` AT STATEMENT POSITION.** Asked through `assignsAt` — the SAME predicate the
				// loop-phi scan decides a loop's carried vars by — so "what does a rebind look like in tokens" has one
				// answer in this compiler. A write form taught to one is taught to both.
				//
				// ⚠ It still over-detects a `let cur = …` that SHADOWS a parameter, which is safe in the only
				// direction that matters: the consequence is a parameter passed by reference that did not have to
				// be — wasteful, never wrong, because a cell is a legal way to hold any value and both ends read
				// this one column. The FIELD-store shape (`p.x = 5` where a parameter is named `x`) is excluded
				// exactly, by `rebindsANameAt`; see there for the golden it moved.
				// ⭐ **AND THE TUPLE-ASSIGNMENT SPELLING OF THE SAME WRITE** (`(p, _) = f()`), which carries no `=`
				// of its own and so is invisible to the shape above. Without it a by-reference parameter could be
				// rebound by `p = f()` and not by `(p, _) = f()` — one operation, two answers decided by spelling.
				// See `tupleAssignRebindsANameAt` for why the enclosing `(` is free here.
				if self.rebindsANameAt(q) or self.tupleAssignRebindsANameAt(q, openBrackets: openBrackets) 'rebindsAName'
					let target = self.paramIndexIn(byRefParamNames, name: self.tokenAt(q).value)
					if target < byRefParamNames.count() 'ofOwnParameter'
						setParamBit(reassignedDirect, index: target)
						statesByRef = true
					end 'ofOwnParameter'
				end 'rebindsAName'

				// ⭐⭐ **PBR-2's FORWARDING EDGE: this parameter handed on as a bare argument.** The parameter's bit and
				// the callee's NAME are recorded together; whether the edge is LIVE is settled whole-program by
				// `ProgramSignatures.closeByRefForwarding`, which is the only party that can see what the callee does.
				if self.bareCallArgumentAt(q, braceStack: braceStack) 'handedOn'
					let forwarded = self.paramIndexIn(byRefParamNames, name: self.tokenAt(q).value)
					if forwarded < byRefParamNames.count() 'ofOwnParameter'
						setParamBit(reassignedForwarded, index: forwarded)
						noteForwardCall(forwardCalls, call: self.forwardCallOpeningAt(try openBrackets.get(openBrackets.count() - 1) otherwise panic("scanBodyFacts: openBrackets is empty inside a call argument — `bareCallArgumentAt` has just established an open `(`")))
						statesByRef = true
					end 'ofOwnParameter'
				end 'handedOn'

				if detectFieldStores and kind == TokenKind.colon and self.braceStackInnermostIsBrace(braceStack) 'fieldSep'
					let idx = self.consumedParamAfterColon(q, paramNames: paramNames)
					if idx < paramNames.count() 'isParam'
						let feedPos = self.paramTypeParamPositionAt(typeParamPositions, index: idx)
						if feedPos < self.enclosingTypeParams.count() 'typeParamField'
							// ⭐ **A TYPE-PARAMETER-typed store is a FEED, not a plain consume (P1.6-A/B2).**
							// `Self{value: v}` on `type Box uses T` stores `v` into `T`, whose managed-ness the shared
							// body cannot see (it is opaque here). P1.6-A EXCLUDED it (the box borrowed, the caller kept
							// the +1); B2 records WHICH type parameter it feeds instead, so the CONCRETE call site — which
							// knows the instance's argument at that position — consumes it iff that argument OWNS managed
							// heap (`Box with String`) and borrows it otherwise (`Box with Point`, byte-identical to A).
							// The sink is the CONSTRUCTED VALUE: the store lands in a field of the `Self` this call
							// RETURNS, so the caller's value owns it and this frame must not be enrolled its owner.
							setParamFeed(feeds, index: idx, feed: TypeParamFeed.feeds(feedPos, sink: FeedSink.constructedValue))
							any = true
						end 'typeParamField' else 'plainField'
							// A NON-type-parameter field store (a monomorphic `Self{value: v}` into an `Integer` field,
							// or a direct `String`/struct field) — the callee OWNS it whatever the concrete type, so the
							// plain consume bit is set. A scalar argument makes it inert at the call site anyway.
							setParamBit(consumed, index: idx)
							any = true
						end 'plainField'
					end 'isParam'
				end 'fieldSep'

				// ⭐ **`items.push(item)` — AN OPAQUE-`T` `Array` MUTATOR IS A CALLEE-STORAGE FEED (P1.7 slice
				// 3b-iii, W10).** A generic method that pushes/sets/inserts a type-parameter argument into an
				// `Array` moves that argument into that array, whose element the array OWNS (its `__managed_decref` walk
				// destroys it exactly once). The shared body cannot see the element's managed-ness — it is opaque
				// here — so the parameter is recorded as a FEED of the type parameter it fills, and the CONCRETE call
				// site consumes it iff that instance's argument owns managed heap (`Container with String`) and
				// borrows it otherwise (`Container with SmallInt`, byte-identical). Only a BARE type-parameter
				// argument is fed — a concrete element (a monomorphic `Array with String` field) already moves in at
				// the array call.
				//
				// A container MUTATOR call (`markOpaqueContainerMutatorFeeds`, receiver-blind) and a bare-field REASSIGNMENT
				// `self.saved = item` (`markOpaqueFieldReassignFeed`, P1.7 Finding A) are the two opaque-`T`
				// callee-storage shapes.
				//
				// ⚠ **THE REASSIGNMENT IS STILL `self`-HEADED, AND NOT BECAUSE IMPLICIT SELF CANNOT SPELL IT**
				// (this said *"a bare `saved = item` is a local assignment"* — corrected at review; a bare field name
				// on the left of an `=` inside an instance method IS a store through the receiver, routed to
				// `parseSelfFieldAssignment` at the `binding.isSelfField` arm of the assignment parse). It is
				// `self`-headed because the SWEEP cannot tell the two apart: `self . <ident> =` is self-identifying,
				// while a bare `<ident> =` needs the enclosing type's FIELD NAMES, which are not merged into
				// `self.signatures` when this runs — and marking a local assignment as a feed would enrol a parameter
				// owned that nothing moves. So the implicit spelling records no feed. MEASURED, on this tip and on
				// `cad4cf30d` alike, that is a FALSE REJECT and not a memory-safety hole: `emitOpaqueFieldReassign`
				// demands an owned value at the store and refuses the un-fed parameter cleanly (E2015), where the
				// `self.`-spelled twin compiles and runs. Widening it needs a sweep-time opaque-field roster — filed,
				// not built here.
				//
				// ⚡ Gated on `genericScope` because a feed needs a type-parameter-typed parameter and outside a
				// generic type there is none (`paramIsTypeParamTyped` is false for every index when
				// `enclosingTypeParams` is empty) — so the whole probe is skipped for every function on a
				// generics-free program, which the `self`-headed predecessor paid for at every `self` token.
				if genericScope 'maybeOpaqueFeed'
					if self.markOpaqueContainerMutatorFeeds(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: feeds) 'fedContainer'
						any = true
					end 'fedContainer'
					if kind == TokenKind.self and self.markOpaqueFieldReassignFeed(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: feeds) 'fedField'
						any = true
					end 'fedField'
				end 'maybeOpaqueFeed'
			end 'aBodyWithParametersToWatch'

			blockDepth = self.blockDepthAfter(q, depth: blockDepth)

			q = q + 1
		end 'walk'

		// ⭐⭐ **G17: A BODY THAT CANNOT RETURN.** Every condition, in one place, because leaving any one of them
		// out is a MISCOMPILE rather than a missed diagnostic — see the columns' own header:
		//
		//   • the walk reached the declaration's OWN `end`, so the tail below really is the body's tail and
		//     not wherever a malformed body ran the scan off the end of the file;
		//   • the declaration states no `throws`, so no bare `try` inside it can propagate to the caller;
		//   • no `return`/`throw`/`throws` anywhere in it;
		//   • its LAST top-level statement is a `panic(…)`, which is what rules out falling off the end.
		//
		// ⚠ **THE TAIL TEST IS `panic (`, NOT THE KEYWORD ALONE.** A statement-position `panic` is the abort
		// statement whatever follows it, but the pairing is what says the scan is standing where it thinks it
		// is; a lone keyword at a line start is a malformed body the real parse is about to report.
		if sawTheFunctionsOwnEnd and not declaresThrows and not bodyCanExitBeforeItsTail and sawATopLevelStatement and self.kindAt(lastTopLevelStatement) == TokenKind.panic and self.kindAt((lastTopLevelStatement + 1) as TokenIndex) == TokenKind.leftParen 'neverReturns'
			divergingDecls.push(DivergingDeclEntry.create(funcName, takesReceiver: takesReceiver, leavesByThrowing: false))
		end 'neverReturns'

		// ⭐⭐ **G18: A BODY THAT CAN ONLY EVER THROW.** The rule above one way out over, and every condition is
		// here for the same reason it is there — leaving one out is a MISCOMPILE, not a missed diagnostic:
		//
		//   • the walk reached the declaration's OWN `end`, so the tail below really is the body's tail;
		//   • the declaration DOES state `throws` — the inverse of the `panic` rule's column, and for the
		//     inverse reason. A tail `throw` needs the clause, so its absence means the scan is not standing in
		//     the body it thinks it is; and a bare `try` propagating a callee's error, which the `panic` rule
		//     must exclude because it cannot see it, needs no exclusion here — propagating IS throwing, one more
		//     way of leaving that is not a return;
		//   • no `return` anywhere in it. `throw`/`throws` are deliberately NOT excluded (the tail is one, and a
		//     `default throws` re-throw is another exit by the error edge), so this is the ONE column the two
		//     rules cannot share;
		//   • its LAST top-level statement is a `throw`, which is what rules out falling off the end.
		//
		// ⚠ **THE TAIL TEST NEEDS NO PAIRING TOKEN, WHERE THE `panic` ONE DOES.** `panic` is a call and its `(`
		// is what says the scan is standing on a statement rather than on a stray keyword; `throw` is a statement
		// keyword the grammar admits nowhere else, so its own kind carries that.
		if sawTheFunctionsOwnEnd and declaresThrows and not bodySpellsAReturn and sawATopLevelStatement and self.kindAt(lastTopLevelStatement) == TokenKind.throw 'alwaysThrows'
			divergingDecls.push(DivergingDeclEntry.create(funcName, takesReceiver: takesReceiver, leavesByThrowing: true))
		end 'alwaysThrows'

		if any 'consumes'
			paramConsumes.push(ParamConsumeEntry.create(funcName, info: ParamConsumeInfo.create(paramNames, bits: consumed, feeds: feeds), takesReceiver: takesReceiver))
		end 'consumes'

		// A body that neither reassigns nor forwards a parameter states nothing, exactly as a non-consuming one
		// does — which is every function in every program written before PBR-2, so the whole-program map stays
		// empty and `programTakesAParamByRef` answers false after one `count()`.
		if statesByRef 'takesOrForwardsAByRefParam'
			paramReassigns.push(ParamReassignEntry.create(funcName, info: ParamReassignInfo.create(byRefParamNames, direct: reassignedDirect, forwarded: reassignedForwarded, forwardCalls: forwardCalls, bareName: funcBareName, callability: self.declarationCallability()), takesReceiver: takesReceiver))
		end 'takesOrForwardsAByRefParam'

		// ⚡ **NOTHING IS BUILT FOR A BODY THAT STATES NOTHING** — the predicate is asked of the raw COLUMNS,
		// ahead of the record, because building the record to ask it cost a `GlobalAliasReturnInfo` and a
		// `DeclCallability` per swept declaration to discover that neither was wanted.
		if GlobalAliasReturnInfo.statesAnything(returnedNames, returnCalls: returnCalls) 'returnedANameOrACall'
			// ⭐ **THE SHADOWING FILTER RUNS ONLY FOR A BODY THAT RETURNED A BARE NAME** — not for one that
			// merely returns a call, and not at all for one that returns neither. See
			// `returnedNamesNotBoundHere` for what it decides and which way it errs.
			//
			// ⚠ **THIS USED TO SAY *"a handful of functions in a program and none at all in most"*, AND THAT
			// WAS NEVER MEASURED.** `return EmptySourceText` and `return SomeConstant` are ordinary, so the
			// population is bodies-returning-an-unbound-name, not accessors-returning-a-global — the same
			// over-estimate `sawGlobalNameReturn` makes, one tier down. What IS measured is the price: a
			// SECOND O(tokens) walk of the body plus two arrays, per such body. It stands because the
			// alternative — carrying the names bound so far through the first walk — costs a per-body set and
			// an insert per binder, which is more than one allocation-free re-walk.
			let unshadowed = self.returnedNamesNotBoundHere(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, bodyStart: bodyStart, paramNames: byRefParamNames) if returnedNames.count() > 0 else returnedNames
			// Asked a second time because the FILTER can empty the name column: a body whose only `return` named
			// a local of its own states nothing after all, and must not reach the map.
			if GlobalAliasReturnInfo.statesAnything(unshadowed, returnCalls: returnCalls) 'mayHandBackAGlobalsRecord'
				globalAliasReturns.push(GlobalAliasReturnEntry.create(funcName, info: GlobalAliasReturnInfo.create(unshadowed, returnCalls: returnCalls, bareName: funcBareName, callability: self.declarationCallability(), declFilePath: self.filePath), takesReceiver: takesReceiver))
			end 'mayHandBackAGlobalsRecord'
		end 'returnedANameOrACall'
	end 'scanBodyFacts'

	// ⭐⭐ **W117's SEED AND EDGE, READ OFF ONE VALUE EXPRESSION.** Exactly four shapes are recognised, and
	// the region must hold nothing BUT the shape — its own end after a name, an opening `(` for a call:
	//
	//   • `<name>`            — a seed candidate, the name as written;
	//   • `<Type>.<member>`   — a seed candidate under the JOINED spelling, which is the key a static
	//                           member is looked up under (`parseStaticMemberAccess`);
	//   • `<name>(…)`         — a forwarding edge, bare;
	//   • `<recv>.<name>(…)`  — a forwarding edge through a receiver, or through `self` inside a type.
	//   • `<name> if <cond> else <arm>` — the INLINE CONDITIONAL, whose BOTH arms are candidates
	//                           because either may be the value. See below.
	//
	// ⭐⭐ **TWO DOORS ASK IT, AND THE ONLY THING THEY DIFFER IN IS WHERE THE REGION ENDS (`SweptValueRegionEnd`).**
	// A `return` statement is the obvious one. The other is a captured PARAMETER DEFAULT, which is a value
	// expression the compiler turns into a nullary helper whose entire body is `return <that expression>`
	// (`parseDefaultHelperBody`) — so `f(p T = A)` hands its caller exactly what `f(A)` hands it, and the
	// question "may this call's argument alias a `let` global's record?" has to have the same answer for both
	// spellings or a default stops being sugar for writing the argument out. It did not: MEASURED before this
	// rung, a `grow(names Names = shared())` whose body pushes silently mutated the global while the written-out
	// `grow(shared())` beside it was refused E3019.
	//
	// ⭐⭐ **THE CONDITIONAL ARM WAS ADDED BECAUSE IT WAS REACHED — by shv2's own source, in a shape this
	// list's own tail predicted.** `return sharedEmptyDeclaredConformances if boundTypeNames.count() <
	// associatedTypeNames.count() else associatedTypeNames` (`ConformanceCheck.pairableAssociatedTypeNames`)
	// is a `return` whose value IS a global's record on one path, and it recorded nothing — so the bit stayed
	// clear and the return was refused on a program the bootstrap compiles. BOTH arms are seeded, never one:
	// the shape says the value is one of two records and the sweep cannot know which, so recording only the
	// half it happened to read first would be a fact about the parser rather than about the program.
	//
	// ⚠⚠ **ANYTHING ELSE RECORDS NOTHING, AND THAT IS SOUND BECAUSE OF THE FALLBACK RATHER THAN BECAUSE THE
	// LIST IS COMPLETE.** A value this does not recognise leaves the function's bit clear, and a clear bit
	// is precisely the condition under which `ownedFormOfBorrowedValue` keeps the ORIGINAL E2015 refusal at the
	// return — so a missed shape costs a REFUSAL, never a silent acceptance. The hazard runs the other way:
	// recording a shape whose value is not really the global's record would taint a caller's value and refuse a
	// write on a legal program. ⇒ **Every ambiguity resolves toward recording NOTHING**, which is why the
	// shape test is exact rather than "a value mentioning a name somewhere".
	//
	// The edge reuses `forwardCallOpeningAt` — the one place a call's tokens are turned into a `ForwardCall` —
	// so a return-forward and a parameter-forward cannot come to disagree about which declarations a spelling
	// can name.
	function noteReturnedGlobalOrForward(valueStart TokenIndex, regionEnd SweptValueRegionEnd, returnedNames ByteArrayArray, returnedHeads ByteArrayArray, returnedAt TokenIndexColumn, returnCalls ForwardCallArray)
		if not tokenCanBeAName(self.tokenAt(valueStart)) 'notANameAtAll'
			return
		end 'notANameAtAll'

		if self.kindAt((valueStart + 1) as TokenIndex) == TokenKind.leftParen 'returnsABareCall'
			noteForwardCall(returnCalls, call: self.forwardCallOpeningAt((valueStart + 1) as TokenIndex))
			return
		end 'returnsABareCall'

		if self.sweptValueRegionEndsAt((valueStart + 1) as TokenIndex, regionEnd: regionEnd) 'returnsABareName'
			noteReturnedCandidate(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, name: self.tokenAt(valueStart).value, head: self.tokenAt(valueStart).value, valueStart: valueStart)
			return
		end 'returnsABareName'

		// The INLINE CONDITIONAL. `valueStart + 1` being `if` fixes the THEN arm at exactly the one token the
		// region opens with, which the two tests above have already established is a name — so it is seeded
		// here on the same terms `returnsABareName` seeds its own, and the ELSE arm is read on those terms too.
		if self.kindAt((valueStart + 1) as TokenIndex) == TokenKind.if 'returnsAConditional'
			noteReturnedCandidate(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, name: self.tokenAt(valueStart).value, head: self.tokenAt(valueStart).value, valueStart: valueStart)
			self.noteConditionalElseArm((valueStart + 2) as TokenIndex, regionEnd: regionEnd, returnedNames: returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, returnCalls: returnCalls, valueStart: valueStart)
			return
		end 'returnsAConditional'

		if self.kindAt((valueStart + 1) as TokenIndex) != TokenKind.dot or not tokenCanBeAName(self.tokenAt((valueStart + 2) as TokenIndex)) 'notADottedShape'
			return
		end 'notADottedShape'

		if self.kindAt((valueStart + 3) as TokenIndex) == TokenKind.leftParen 'returnsADottedCall'
			noteForwardCall(returnCalls, call: self.forwardCallOpeningAt((valueStart + 3) as TokenIndex))
			return
		end 'returnsADottedCall'

		if self.sweptValueRegionEndsAt((valueStart + 3) as TokenIndex, regionEnd: regionEnd) 'returnsAStaticMember'
			noteReturnedCandidate(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, name: qualifiedMethodName(self.tokenAt(valueStart).value, methodName: self.tokenAt((valueStart + 2) as TokenIndex).value), head: self.tokenAt(valueStart).value, valueStart: valueStart)
		end 'returnsAStaticMember'
	end 'noteReturnedGlobalOrForward'

	// ⭐ **HAS THE VALUE THE SWEEP IS READING RUN OUT AT `index`?** — the one place `SweptValueRegionEnd`'s two
	// answers are spent, so the recogniser's three "and nothing follows it" tests cannot come to mean different
	// things at the two doors. See the union for why the default door states a TOKEN where the return door
	// states a line.
	function sweptValueRegionEndsAt(index TokenIndex, regionEnd SweptValueRegionEnd) returns bool
		return match regionEnd 'ends'
			atLineEnd gives self.kindAt(index) == TokenKind.newline
			atToken(stop) gives index == stop
		end 'ends'
	end 'sweptValueRegionEndsAt'

	// ⭐ **THE ELSE ARM OF A RETURNED INLINE CONDITIONAL**, read on the SAME two terms the statement-level
	// shapes are read on — a bare name to the region's end, or a bare call — so an arm this admits is an
	// arm `noteReturnedGlobalOrForward` would have admitted had it stood alone.
	//
	// ⚠ **THE `else` IT LOOKS FOR IS AT BRACKET DEPTH ZERO, and everything else records NOTHING.** A
	// conditional nested inside the CONDITION (`return A if (x if y else z) else B`) puts an `else` behind a
	// paren, and one nested in the ELSE arm (`return A if x else B if y else C`) leaves an arm that is not a
	// bare name — both fall through recording nothing, which is this function's family rule: an unrecognised
	// shape costs a REFUSAL at the return, never a silent acceptance. The THEN arm is already seeded by the
	// caller either way, so a missed else arm cannot make the function's bit WRONG, only incomplete.
	function noteConditionalElseArm(condStart TokenIndex, regionEnd SweptValueRegionEnd, returnedNames ByteArrayArray, returnedHeads ByteArrayArray, returnedAt TokenIndexColumn, returnCalls ForwardCallArray, valueStart TokenIndex)
		var depth = 0
		var q = condStart
		while not self.sweptValueRegionEndsAt(q, regionEnd: regionEnd) and self.kindAt(q) != TokenKind.eof 'scanForElse'
			let kind = self.kindAt(q)
			if kind == TokenKind.leftParen or kind == TokenKind.leftBracket or kind == TokenKind.leftBrace 'opensGroup'
				depth = depth + 1
			end 'opensGroup'
			if kind == TokenKind.rightParen or kind == TokenKind.rightBracket or kind == TokenKind.rightBrace 'closesGroup'
				depth = depth - 1
			end 'closesGroup'
			if depth == 0 and kind == TokenKind.else 'foundTheElse'
				self.noteConditionalArmValue((q + 1) as TokenIndex, regionEnd: regionEnd, returnedNames: returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, returnCalls: returnCalls, valueStart: valueStart)
				return
			end 'foundTheElse'

			q = q + 1
		end 'scanForElse'
	end 'noteConditionalElseArm'

	// One arm's VALUE, on the two terms above. Split from the scan so the admission rule is written once and
	// reads the same as the statement-level one it mirrors.
	function noteConditionalArmValue(armStart TokenIndex, regionEnd SweptValueRegionEnd, returnedNames ByteArrayArray, returnedHeads ByteArrayArray, returnedAt TokenIndexColumn, returnCalls ForwardCallArray, valueStart TokenIndex)
		if not tokenCanBeAName(self.tokenAt(armStart)) 'notANameAtAll'
			return
		end 'notANameAtAll'

		if self.kindAt((armStart + 1) as TokenIndex) == TokenKind.leftParen 'aBareCall'
			noteForwardCall(returnCalls, call: self.forwardCallOpeningAt((armStart + 1) as TokenIndex))
			return
		end 'aBareCall'

		if self.sweptValueRegionEndsAt((armStart + 1) as TokenIndex, regionEnd: regionEnd) 'aBareName'
			noteReturnedCandidate(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, name: self.tokenAt(armStart).value, head: self.tokenAt(armStart).value, valueStart: valueStart)
		end 'aBareName'
	end 'noteConditionalArmValue'

	// ⭐⭐ **DROP EVERY RETURNED NAME THIS BODY BINDS ITSELF (W117).** `function f() returns Names  let A = …
	//  return A  end` returns its own LOCAL, and the sweep — which has no scope — would otherwise file it as a
	// return of the global `A` and taint every caller's result. The real parse resolves a local first
	// (`parseVariableReference` asks `scope.contains` before any top-level probe), so this is what keeps the
	// swept fact agreeing with what the body will actually mean.
	//
	// ⚠ **THE BINDER TEST IS DELIBERATELY GENEROUS, AND THE DIRECTION IS THE POINT.** A name is treated as
	// bound when it follows `let`, `var`, `for`, `(` or `,` — which catches every binder form the language has
	// (a declaration, a loop variable, a caught-error binder, a `match` payload, a destructuring name) and also
	// catches plain call ARGUMENTS, which are not binders at all. Under-inclusion is the costly direction — a
	// spurious seed refuses a write on a legal program — so the SET errs the way it does on purpose. Do not
	// narrow it: a `match` payload `case(a, b)` is character for character a call, and no token test separates
	// them.
	//
	// ⛔⛔ **BUT THE OVER-INCLUSION WAS NOT FREE, AND THIS HEADER USED TO SAY IT WAS.** It read *"that
	// over-inclusion drops a seed, and a dropped seed falls back to the E2015 refusal at the return: the answer
	// the compiler gave before this rung existed"* — true, and it stops being acceptable the moment a real
	// program is the one refused. `SignatureIndex.surfaceOfRootBits` returns `sharedEmptyDeclaredSurface` BARE
	// on one path and hands that same name to a call on the next line; the walk was POSITION-BLIND, so the
	// argument marked the candidate bound and the bare return was refused — on source the bootstrap compiles.
	//
	// ⭐ **THE CURE IS POSITION AND IT LEAVES THE SET ALONE** (`markBoundHead`, where the argument lives): a
	// binder can only shadow a `return` that comes AFTER it, because a name cannot resolve to a local at a
	// point before that local is declared. That is EXACT for the question, so it drops only FALSE shadowings —
	// which is why the generous set can stay generous.
	function returnedNamesNotBoundHere(returnedNames ByteArrayArray, returnedHeads ByteArrayArray, returnedAt TokenIndexColumn, bodyStart TokenIndex, paramNames ByteArrayArray) returns ByteArrayArray
		// A PARAMETER shadows exactly as a local does, and it is known without walking anything.
		var bound = BoolArray.create()
		for candidateHead in returnedHeads 'eachHead'
			bound.push(self.paramIndexIn(paramNames, name: candidateHead) < paramNames.count())
		end 'eachHead'

		var depth = 0 as BlockDepth
		var q = bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			if depth == 0 and self.closesBlockAt(q) 'bodyEnds'
				break
			end 'bodyEnds'

			if q > bodyStart and tokenCanBeAName(self.tokenAt(q)) and kindBindsTheNameAfterIt(self.kindAt((q - 1) as TokenIndex)) 'aBinderPosition'
				markBoundHead(returnedHeads, bound: bound, returnedAt: returnedAt, name: self.tokenAt(q).value, binderIndex: q)
			end 'aBinderPosition'

			depth = self.blockDepthAfter(q, depth: depth)
			q = q + 1
		end 'walk'

		var kept = ByteArrayArray.create()
		for i in 0 upto returnedNames.count() 'eachCandidate'
			let shadowed = try bound.get(i) otherwise panic("returnedNamesNotBoundHere: bound.get({i}) OOB — the two columns are parallel by construction")
			if shadowed 'shadowed'
				continue
			end 'shadowed'
			kept.push(try returnedNames.get(i) otherwise panic("returnedNamesNotBoundHere: returnedNames.get({i}) OOB below its own count"))
		end 'eachCandidate'

		return kept
	end 'returnedNamesNotBoundHere'

	// ⭐⭐ **WHICH CALL SHAPES CAN NAME THE DECLARATION THE SWEEP IS STANDING ON (PBR-2)** — decided here
	// because this is where both its inputs are. `enclosingType` says "a method" (the same test
	// `declaredMethodName` qualifies on, and the same name it qualifies WITH, so a `self.`-shaped edge and
	// this declaration join the identical two halves) and `namespace` says "this file has a directory route"
	// (the same test `recordScannedSignature` publishes a namespace-qualified spelling on). Neither survives
	// past this scan, and neither is derivable from the registration name: a root-level free function and a
	// method in a namespace-free program are both spelled bare.
	function declarationCallability() returns DeclCallability
		if not self.enclosingType.isEmpty() 'aMethod'
			return DeclCallability.methodOf(self.enclosingType)
		end 'aMethod'

		return DeclCallability.bareCallOrDirectoryRoute if not self.namespace.isEmpty() else DeclCallability.bareCallOnly
	end 'declarationCallability'

	// ⭐⭐ **RECORD ONE PARAMETER'S BIT IN A SWEEP COLUMN, GROWING THE COLUMN TO REACH IT** — the ONE writer of
	// the three (the consume column and the two by-reference ones), paired with the ONE reader every consumer
	// goes through (`SignatureIndex.bitAt` / `ParamConsumeInfo.isConsumed`). A column reaches only as far as the
	// highest position that has a fact, which is exactly what those readers already mean by a SHORT column:
	// *"a position past either column is a parameter the sweep recorded nothing for"*. So the old pre-fill was
	// writing out, per parameter of every declaration in the program, the very default its readers supply free.
	//
	// ⛔⛔ **THE COLUMNS USED TO START FROM A SHARED MODULE-LEVEL EMPTY FOR AN EMPTY NAME LIST, AND THAT HANDED A
	// `let` GLOBAL'S RECORD TO A NAME THIS SWEEP THEN WRITES.** `initialBitColumn` returned the module-level
	// shared empty when the count was zero and a fresh array otherwise — so whether its result could be written
	// depended on an ARGUMENT, and the only thing making that safe was the caller's own `target <
	// byRefParamNames.count()` gate: an invariant no analysis can see and nothing but a comment held. W117 —
	// shv2's rule that a value which may alias a `let` global's record may not be written through — refused the
	// write on this compiler's own source (`E3019 cannot pass 'reassignedDirect' to function that mutates
	// parameter 'self'`), and it was right to: the laundering was real, and only the gate made it harmless.
	// A column that is always fresh can alias nothing, and costs one empty record where the shared anchor cost
	// a `count`-long fill.
	//
	// ⚡ **WHY THESE GO FRESH WHILE `nameColumnWith`'s COLUMNS KEEP THEIR ANCHOR AND COPY — MEASURED, NOT
	// TASTE.** Both obey the one rule (nothing writes a shared anchor); which side of it is cheaper follows
	// from what the column DID. These were PRE-FILLED per declaration, so dropping the anchor drops the fill
	// with it and freshness costs a record while saving a buffer. An edge column has no fill to drop, so
	// freshness would be a record for nothing — measured on one compile, `phase:signatures` reads 163,839
	// allocations with the edge columns copying against 164,147 with them fresh (163,839 / 164,147 / 164,579
	// for copy / fresh / the shared-anchor original).
	function setParamBit(column BoolArray, index ParamCount)
		while column.count() <= index 'reach'
			column.push(false)
		end 'reach'

		try column.set(index, value: true) otherwise panic("setParamBit: column.set OOB at {index} despite the growth above reaching it")
	end 'setParamBit'

	// `setParamBit`'s twin for the type-parameter FEED column (P1.6-B2), read under the same rule —
	// `ParamConsumeInfo.typeParamFeedOf` answers `none` for a position past the end, *"exactly as `isConsumed`
	// answers `false` for its short `bits`"*. Growing on demand buys more here than it does for a bit:
	// `TypeParamFeed.none` is a UNION value, so the old pre-fill BOXED one per parameter of every method of
	// every generic type in the program purely to say "nothing here".
	function setParamFeed(column TypeParamFeedArray, index ParamCount, feed TypeParamFeed)
		while column.count() <= index 'reach'
			column.push(TypeParamFeed.none)
		end 'reach'

		try column.set(index, value: feed) otherwise panic("setParamFeed: column.set OOB at {index} despite the growth above reaching it")
	end 'setParamFeed'

	// ⭐ `setParamFeed`'s READER twin for a bare feed column — does position `index` carry a feed? A position past
	// the end carries none, which is the same "absence is the answer" default `ParamConsumeInfo.typeParamFeedOf`
	// reads a short column under, and the reason a column need only reach its highest fact.
	//
	// ⚠ It answers the BOOLEAN rather than the `TypeParamFeed`, deliberately: a miss returning `TypeParamFeed.none`
	// would BOX a union value per unfed parameter of every method in the fixpoint — the same cost
	// `SignatureIndex.recordParamConsume` names when it reads its stored feeds directly rather than through
	// `typeParamFeedOf` — and `isFeed()` is the whole of what the one asker wants.
	function paramIsFed(column TypeParamFeedArray, index ParamCount) returns bool
		if index >= column.count() 'past'
			return false
		end 'past'

		return (try column.get(index) otherwise panic("paramIsFed: column.get OOB at {index} despite index < count")).isFeed()
	end 'paramIsFed'

	// ⭐⭐ **APPEND ONE NAME TO A COLUMN THAT MAY STILL BE ITS SHARED EMPTY ANCHOR — BY COPYING, WHICH IS THE
	// ONLY WAY A SHARED ANCHOR CAN BE SAFE.** The descriptor scan's three edge columns
	// (`sizedContainerSelfCallees`, `corpusContainerCallees`, `nestedInstanceCallees`) start at a module-level
	// `let` empty so that a body recording no edge — nearly every body — allocates nothing for them, and that
	// property is what a copying append keeps: the first edge pays one array, the anchor is never touched, and
	// a body with no edge pays nothing at all.
	//
	// ⛔⛔ **THEY USED TO PRIVATISE IN PLACE ON AN `is`-IDENTITY TEST AND THEN `push`, AND THE COMPILER WAS
	// RIGHT TO REFUSE IT.** `if col is sharedEmpty then col = fresh end  col.push(…)` is safe only because the
	// test ran — and the binding the `push` sees JOINS both arms, so what it may hold is a `let` global's
	// record. W117 says a value that may alias one may not be written through, and it named this exact site:
	// `E3019 cannot pass 'sizedContainerSelfCallees' to function that mutates parameter 'self'`. Copying
	// removes the join rather than arguing with it — the value handed back was built here and can alias
	// nothing. `append` copies element-by-element with copy semantics (`stdlib/Array.appendMemory`), so the
	// anchor is only ever READ.
	//
	// ⚡ The COPY is bounded by the column's own length, and an edge column holds a handful of names: a body
	// recording `k` edges does `k` appends over at most `k` elements, against the ONE array a body recording
	// none no longer has to allocate. That trade is why these columns keep an anchor where `setParamBit`'s go
	// FRESH — see there for the measurement that decided each.
	function nameColumnWith(column ByteArrayArray, name ByteArray) returns ByteArrayArray
		var out = ByteArrayArray.create()
		out.append(column)
		out.push(name)
		return out
	end 'nameColumnWith'

	// ⭐⭐ **ONE SITE'S CONTRIBUTION TO THE WHOLE-PROGRAM LAYOUT-DESCRIPTOR-NEED FIXPOINT (P1.6-B1, W23c)** —
	// every method declared between `site.bodyStart` and the body's `end`, with its direct-need seed and the
	// siblings it calls on `self`, keyed by the qualified `Type.method` name a call resolves to.
	//
	// ⛔⛔ **THE FIXPOINT USED TO BE LOCAL TO ONE `type` DECLARATION, AND THE LOCALITY CLAIM WAS FALSE.** Its
	// header read *"the self-call graph is LOCAL to this one type declaration (a method self-calls only
	// siblings, same file, contiguous), so … no whole-program index"* — and an `extension` body is outside
	// that declaration and may be in another file. So a method an extension contributed was in no fixpoint,
	// reserved nothing, and was still asked to FORWARD a descriptor to a callee that had one: **MEASURED,
	// `panic at LowerMaxonToStd.maxon:1587: forwardCallerLayout: caller 'Bag.absorbTwice' has no layout
	// descriptor to forward to 'Bag.absorb'`**, on a program the oracle runs. A sibling is a method of the
	// same TYPE, which is not the same thing as a method of the same DECLARATION.
	//
	// ⚠ **IT RUNS AFTER `allFilesFolded` AND IT HAS TO**, which is the other half of why the walk cannot be
	// the sweep's own. Three of its seeds are whole-program answers the sweep is still building while it walks
	// a body: `functionFeedsCalleeStorage` (the consume/feed record), an inner alias naming an OPAQUE `Array`
	// (`opaqueContainerConstructionAt` → `isGenericAlias`), and a managed opaque field (`opaqueFieldReassignAt`).
	// Read mid-sweep they answer "no" for a declaration folded later, and a reservation is ABI — so the sweep
	// records a POSITION and this walks it once the index is whole. That is also what makes the answer
	// independent of declaration order, which a descriptor parameter must be.
	//
	// The same framework `scanBodyFacts` uses (`opensBlockAt` / `closesBlockAt`) delimits each method body;
	// a named `function <ident>` opens one (a closure is `function(` — no name, no `end`). Peek-only: the
	// cursor is positioned from the site and the `Parser` this runs on parses nothing.
	export function scanDescriptorNeedsInto(site DescriptorScanSite, methodNames ByteArrayArray, directSeeds DescriptorNeedMap, countSeeds DescriptorNeedMap, selfCallees SelfCalleesMap, countCallees SelfCalleesMap)
		// The type scope the seeds are read against: `sizeofOperandIsTypeParamAt` needs the `uses` list, and
		// `opaqueContainerConstructionAt` / `opaqueFieldReassignAt` key on `enclosingType`. Taken from the
		// whole-program layout rather than re-read from a header, so an EXTENSION body — which has no `uses`
		// clause of its own — is scanned in exactly its target's scope.
		self.enterTypeScope(site.typeName, isEnum: false)
		self.enclosingTypeParams = self.signatures.structTypeParamsOf(site.typeName)
		// ⭐ Is this type instantiated at all (W41-opaque)? A property of the TYPE, so it is read once per site
		// rather than once per method. See `genericTypeIsInstantiated` for why this is the weakest question the
		// store-side seed can ask and why a stronger one is measurably wrong here.
		let instantiated = self.signatures.genericTypeIsInstantiated(site.typeName)
		// ⭐ Does a `for … in self` in this type's bodies own an OPAQUE element per trip (W159)? A property of
		// the TYPE — every method walks the same cursor — so it is read once per site beside `instantiated`
		// rather than once per method.
		let receiverElementIsOpaque = self.receiverCursorElementIsOpaque(site.typeName)

		var q = site.bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			if self.closesBlockAt(q) 'bodyEnd'
				break
			end 'bodyEnd'
			// A named `function <name>` at the member level opens a method body (a closure is `function(` —
			// no name, no `end`). Its whole body is scanned in one nested pass, and the walk resumes past its
			// `end` — so this outer loop only ever sees member-level tokens. Asked through the SHARED
			// `functionDeclarationAt` so a KEYWORD-named method (D8) is a method here too.
			if self.functionDeclarationAt(q) 'method'
				let qualified = qualifiedMethodName(site.typeName, methodName: self.tokenAt(q + 1).value)
				let scan = self.scanOneMethodDescriptorSignals(q + 2)
				// ⭐ A method that DROPS a consumed opaque CALLEE-STORAGE feed parameter needs the descriptor too
				// (P1.7 slice 3b-v) — the runtime `__drop_type_param` reads the instance's `destroyFunc@40`. That
				// drop happens only when a feed can be left LIVE at an exit: a feed parameter present AND the body
				// is not straight-line (`hasControlFlow`). The whole-program feed fact
				// (`functionFeedsCalleeStorage`, from the sweep) is joined with the local body shape; seeded like a
				// direct `sizeof(T)` so the fixpoint propagates it to every method that forwards the descriptor.
				//
				// ⚠ It used to carry `not isStatic` as well, standing in for *"only an INSTANCE method's feed is an
				// array feed"* — false since W10, when a STATIC that pushes into a local `Array with T` became a
				// feed too. The clause the static test was really protecting is the OTHER one: a P1.6-B2
				// `Self{value: v}` constructor feed is consumed at its call site and never dropped here, so seeding
				// it would reserve a descriptor a multi-parameter generic constructor cannot materialize. That is
				// now said directly — the sink `functionFeedsCalleeStorage` asks for is exactly the feed kind
				// `bindParameters` enrols, so the reservation and the drop cannot disagree.
				let dropsFeed = scan.hasControlFlow and self.signatures.functionFeedsCalleeStorage(qualified)
				// ⭐ A method that MOVES an opaque container element OUT (`.pop()`/`.remove()`/`.removeFirst()`) drops the owned
				// `typeParameter` result at scope exit through `__drop_type_param`, so it needs the descriptor too
				// (P1.7 slice 3b-vi-a). `not isStatic` for `dropsFeed`'s reason — a generic constructor cannot
				// materialize a descriptor it does not receive; a static never moves an element out of a shared-body
				// opaque array (it has no `self` to reach one and no threaded `T` instance). Over-reserving an unused
				// descriptor for a move-out that turns out concrete is sound; seeded like a direct `sizeof(T)` so the
				// fixpoint gives every self-caller a descriptor to forward.
				let movesOutContainerElement = scan.hasContainerMoveOut and not self.functionDeclIsStatic(q)
				// ⭐ A method that COPIES an opaque array element (`.slice()`/`.clone()`/`.append()`) lowers to an
				// `__managed_*_opaque(arr, …, descriptor)` wrapper reading `copyFunc@32`, so it needs the descriptor too
				// (P1.7 slice 3b-vi-b-β). `not isStatic` mirrors the sibling opaque signals — a static generic method
				// has no `self`-threaded instance descriptor to source. Over-reserving for a concrete-array copy in a
				// generic body is sound; seeded like a direct `sizeof(T)` so the fixpoint forwards it to self-callers.
				let copiesArrayElement = scan.hasArrayCopy and not self.functionDeclIsStatic(q)
				// ⭐ A method that REASSIGNS a bare opaque MANAGED type-parameter field (`self.saved = next`, P1.7
				// Finding A) drops the field's OLD value through the descriptor-gated `__drop_type_param`, so it
				// needs the descriptor. `not isStatic` mirrors the sibling signals — a static has no `self` to reach
				// a field, and one that needed a descriptor would have no receiver to source it from.
				// `scan.reassignsOpaqueField` is already gated on the field being managed for some instantiation
				// (`isManagedOpaqueTypeParamField`), so a trivial-only instantiation reserves nothing and stays
				// byte-identical; seeded like a direct `sizeof(T)` so the fixpoint gives every self-caller a
				// descriptor to forward.
				let reassignsOpaqueManagedField = scan.reassignsOpaqueField and not self.functionDeclIsStatic(q)
				// ⭐⭐ **A method that BUILDS A RECORD may store a BORROWED opaque `T` into it, and that store
				// takes its reference through the descriptor's `retainFunc@64` (W41-opaque), so it needs the
				// descriptor.** `MapIterator.current`'s `return (k, v)` — two `keys.get(i)`/`values.get(i)`
				// BORROWS into a tuple the caller's substituted `(String, Integer)` destructor then drops — is
				// exactly this shape, and it is the one that measured 0xC0000005.
				//
				// ⚠ **THE SOURCE OF THE OPAQUE VALUE IS NOT RESOLVED HERE, AND THAT IS THE SIBLING SIGNALS'
				// DISCIPLINE, NOT A GAP.** A borrowed `T` reaches a record from an array READ, a bare field
				// read OR a non-consumed parameter, and the pre-scan runs before any body is parsed — so no
				// token separates a body that will store one from a body that will not. Over-reserving costs
				// one ignored parameter; missing one aborts the compiler.
				//
				// ⛔ **`instantiated` IS THE WEAKEST GATE THAT SEPARATES THE TWO SHAPES, AND A STRONGER ONE WAS
				// MEASURED AS A REFUSAL ON A LEGAL PROGRAM** — `genericTypeIsInstantiated` carries the argument
				// in full: "is some instantiation MANAGED" cannot be asked here, because a CONCRETE instance is
				// interned by the parse that meets it and this scan runs before any body is parsed. A type no
				// `with` in the program ever names is the one this must decline for: its value is held as a bare
				// `structRef(Base)` that no call site can source a descriptor for.
				//
				// `not isStatic` mirrors every sibling opaque signal: a static generic constructor has no
				// receiver to source a descriptor from, and one that needed one would be `E2015`
				// (`staticLayoutNeedsSelfReturn`). A static that stores a borrowed opaque value is refused with
				// a position instead (`requireDescriptorForOpaqueStores`).
				let buildsRecordFromOpaqueSource = scan.buildsRecord and instantiated and not self.functionDeclIsStatic(q)
				// ⭐⭐ **A METHOD DECLARED `returns <its own type parameter>` HANDS THE CALLER A `+1`, AND THE
				// SHAPE IT CANNOT DISCHARGE STATICALLY IS A BORROW (P1.7 slice 3b-vi-a).** `return self.value`,
				// `return v` for a borrowed `T` parameter — the reference is taken through `retainFunc@64`
				// (`emitOwnedValueReturn` → `coOwnBorrowedOpaque`), so the method needs the descriptor.
				//
				// ⚠ **THE RETURN TYPE IS THE ONLY HALF THIS CAN SEE, AND THAT IS THE SIBLING SIGNALS'
				// DISCIPLINE.** Whether a given `return` yields a borrow or a value the body already owns is a
				// fact about an EXPRESSION, and this scan runs before any body is parsed. Over-reserving for a
				// body whose every return is owned costs one ignored parameter; missing one refuses a legal
				// program with `requireDescriptorForOpaqueStores`.
				//
				// ⛔⛔ **AND IT CARRIES NO `instantiated` GATE, WHICH EVERY SIBLING OPAQUE SIGNAL DOES — because
				// this signal's EMISSION side cannot ask that question and get the same answer.** The registry
				// this scan reads holds the instances a top-level `typealias X = G with A` declared; an instance
				// minted by an EXPRESSION (`{1: "a"}`, or a bare generic name retyped through a call result) is
				// interned by the parse that meets it, which is strictly later. So `stdlib/Map.maxon`'s
				// `get(key Key) returns Value` reads NOT INSTANTIATED here and INSTANTIATED when its body is
				// parsed — MEASURED: gated, the reservation declined, the retain was emitted anyway, and 38
				// `map/*` cases died on `requireDescriptorForOpaqueStores`. A declaration-level signal must be
				// answerable from the declaration alone, so this one is, and the retain in
				// `emitOwnedValueReturn` is ungated to match. A type no `with` ever names reserves a parameter
				// nobody passes, which is the sibling signals' stated asymmetry and costs one ignored slot.
				//
				// `not isStatic` mirrors those siblings: the corpus declares no `static function` with a bare
				// type-parameter return at all, and one that did would have no receiver to source a descriptor
				// from — `staticLayoutNeedsSelfReturn` says so with a position.
				let returnsBorrowableOpaque = self.signatures.calleeReturnsBareTypeParameter(qualified) and not self.functionDeclIsStatic(q)
				// ⭐⭐ **A method that ADOPTS a `returns T` result owes that `+1` a release, and the release
				// is the descriptor-gated `__drop_type_param` (W58).** The exact dual of the signal above: that
				// one reserves for the body that HANDS a bare `T` over, this one for the body that TAKES it.
				// Written apart because they are asked of different things — a declaration's own return type
				// against the calls its body makes — and folded here so one reservation covers a body that does
				// both.
				//
				// `not isStatic` mirrors every sibling opaque signal: a static generic method has no receiver to
				// source a descriptor from, and one that needed one is `E2015` (`staticLayoutNeedsSelfReturn`).
				// Gated on the enclosing type being GENERIC as well, which the siblings get for free from the
				// questions they ask and this one does not: a non-generic type's method has no opaque `T` to
				// adopt and no `uses` position a descriptor could describe.
				// ⭐⭐ **A METHOD THAT FORWARDS A BORROWED OPAQUE `T` TO A SIBLING GENERIC'S CONSTRUCTOR TAKES A
				// REFERENCE THROUGH `retainFunc@64`, SO IT NEEDS THE DESCRIPTOR (BATCH41).** The dual of
				// `adoptsOpaqueResult`: that one reserves for the body that TAKES a bare `T` over, this one for
				// the body that HANDS one to something that will keep it.
				//
				// ⚠⚠ **ITS STATIC GATE IS NOT THE SIBLINGS' PLAIN `not isStatic`, AND THE DIFFERENCE IS A
				// COMMITTED PROGRAM.** `generic-opaque-value-store`'s
				// `a-record-over-the-enclosing-parameter-in-a-plain-field-round-trips` feeds its record from
				// `static create(x Element, tag Integer) returns Self` — the constructor feed's static
				// spelling, and exactly what this rung serves — so excluding every static refuses it.
				//
				// ⇒ the gate is the one `staticLayoutNeedsSelfReturn` itself draws: a static that RETURNS its
				// declaring type HAS a descriptor source (`materializeStaticConstructorLayout` reads it off the
				// instance the static builds) and a static returning anything else has none. Asking that
				// refusal's own question here is what keeps the reservation and the refusal from disagreeing;
				// reserving where the refusal would throw is an E2015 on a program that used to compile, and
				// that is not hypothetical — the first cut, which admitted every static AND read both feed
				// sinks, did exactly that to
				// `generic-type-nested-array-typealias.static-forward-keeps-its-constructor-feed`.
				//
				// Gated on the enclosing type being GENERIC, which the sibling signals get for free from the
				// questions they ask: a non-generic type's method has no opaque `T` to forward. And gated on the
				// method being ABLE to hold a borrowed `T` at all (`methodCanForwardABorrowedOpaque`), which is
				// what keeps a `.create(` — a name everything wears — from reserving across the whole corpus.
				let staticCanSourceADescriptor = not self.functionDeclIsStatic(q) or self.signatures.calleeReturnsItsDeclaringType(qualified)
				let forwardsBorrowedOpaqueToAFeed = scan.forwardsToATypeParamFeed and not self.enclosingTypeParams.isEmpty() and staticCanSourceADescriptor and self.signatures.methodCanForwardABorrowedOpaque(qualified, typeName: site.typeName)
				let adoptsOpaqueResult = scan.adoptsOpaqueCallResult and not self.enclosingTypeParams.isEmpty() and not self.functionDeclIsStatic(q)
				// ⭐⭐ **A method that STORES INTO A CONTAINER may store a BORROWED opaque `T`, and that store
				// takes its reference through the descriptor's `retainFunc@64` (W60), so it needs the
				// descriptor.** `stdlib/Array.maxon`'s `appendMemory` — `push(try source.get(i) otherwise …)`,
				// one borrow per iteration into a column the concrete instance's `destroyFunc@40` then walks —
				// is exactly this shape, and it is the one that could not compile at all.
				//
				// It is `buildsRecordFromOpaqueSource`'s twin and carries the identical gates for the identical
				// reasons: the SOURCE of the element is not resolved here (a borrow reaches a container from an
				// array read, a bare field read or a non-consumed parameter, and no token separates a body that
				// will store one from a body that will not), `instantiated` is the weakest gate that declines
				// for a type no `with` ever names, and `not isStatic` mirrors every sibling opaque signal — a
				// static has no receiver to source a descriptor from, and one that needs one is refused with a
				// position (`requireDescriptorForOpaqueStores`).
				// ⛔⛔ **AN INTERFACE-EXTENSION BODY IS THE ONE PLACE THIS SEED IS A FALSE POSITIVE AND THE
				// FALSE POSITIVE IS NOT FREE (W183).** `stdlib/Interfaces.maxon`'s `extension Iterable.map` is
				// `var result = ElementArray{}` … `result.push(transform(item))`, and no token separates that
				// push from `stdlib/Array.maxon`'s `appendMemory`. But an interface-extension body is written in
				// the INTERFACE's terms: it can name no field of the conformer and no parameter of its `uses`
				// list, so the only routes by which it can hold a bare associated-type value are a PARAMETER
				// declared at that type — which `methodCanForwardABorrowedOpaque` answers — and the per-trip
				// element of `for … in self`, which `walksAnOwnedOpaqueElement` below already seeds off
				// `receiverCursorElementIsOpaque`. A conformer whose element IS opaque (`Bag with String`)
				// therefore keeps its reservation through that seed; `Map`, whose element is the tuple `Entry`,
				// does not — and must not.
				//
				// ⛔ **MEASURED, and it is why the gate is the EXTENSION and not the predicate alone:**
				// `methodCanForwardABorrowedOpaque` on every body refuses `Container.copyInto`
				// (`generic-type-nested-array-typealias/push-for-element-into-second-opaque-array`), whose
				// `dst.push(e)` reads `e` out of `self.items` — a route neither a parameter at `Element` nor a
				// field at `Element` describes. A TYPE body keeps the unnarrowed seed for exactly that reason.
				//
				// ⚠ **IT IS A CONTAINMENT OF THE CHAIN, NOT A FIX OF IT.** `Map.map` handed a REAL descriptor
				// makes `MapIterator.current` CLONE each key into the `(Key, Value)` tuple it returns, and that
				// tuple then enters a container whose element destructor is ONE STAMPED WORD called with the
				// element alone — so there is nowhere to carry the descriptor its release needs. Both endings
				// are measured: with the shallow tuple copy the array's element points at a freed record, and
				// with the copy co-owning instead the record leaks (exit 101). The chain is sound only while it
				// is inert on BOTH ends, which is what this keeps.
				let storesBorrowedOpaqueElement = scan.storesContainerElement and instantiated and not self.functionDeclIsStatic(q) and (not site.bodyIsAnInterfaceExtension or self.signatures.methodCanForwardABorrowedOpaque(qualified, typeName: site.typeName))
				// ⭐⭐ **A `for … in self` OWNS ITS ELEMENT FOR ONE TRIP, AND RELEASES IT THROUGH THE
				// DESCRIPTOR (W159).** The element is `current()`'s result, which the impl hands over as a `+1`
				// (`coOwnBorrowedOpaque`); when the cursor yields the enclosing type's own parameter that
				// release is the descriptor-gated `__drop_type_param`, so the method needs the parameter
				// carrying it. `stdlib/Interfaces.maxon`'s `extension Iterable` is the whole of why this is
				// reachable at all: `contains` reads its element and stores it NOWHERE, so it is the one
				// traversal that drops rather than moves, and it is re-parsed onto every conformer.
				//
				// ⚠ **NO SIBLING SIGNAL COULD SEE IT**, and that is what made it a refusal rather than a
				// reservation: the loop's `createIterator()`/`current()`/`advance()` are emitted by the parser,
				// so `adoptsOpaqueCallResult`'s `.<name>(` test and the self-call edges walk a body in which
				// those three calls appear in no token.
				//
				// ⛔ The two gates are NOT interchangeable with the siblings' `instantiated`, which this
				// deliberately does not carry: `receiverElementIsOpaque` is the narrowing that keeps a
				// concrete-element traversal out (see it). `not enclosingTypeParams.isEmpty()` because a
				// descriptor describes the ENCLOSING type's parameters and a non-generic type has none;
				// `not isStatic` mirrors every sibling opaque signal — a static cannot name `self`, so it has
				// no receiver to source a descriptor from and one that needed one is `E2015`
				// (`staticLayoutNeedsSelfReturn`).
				let walksAnOwnedOpaqueElement = scan.walksReceiverAsACursor and receiverElementIsOpaque and not self.enclosingTypeParams.isEmpty() and not self.functionDeclIsStatic(q)
				// ⭐⭐ **TWO DECLARATIONS CAN WEAR ONE QUALIFIED NAME, AND THE MERGE IS A UNION — NOT THE LAST
				// ONE IN (found at review).** The columns are keyed by `Type.method` and nothing above this
				// line guarantees that key is unique: a type body may declare `slotSize()` twice (shv2 keeps
				// the FIRST signature and reports no duplicate), and a body and an extension over it may each
				// declare one. A plain `upsert` makes the LAST writer the whole answer, so the earlier
				// declaration's `sizeof(T)` — and its self-call edges — are simply gone. That is an ABI slot
				// decided by declaration order: **MEASURED, `panic at LowerMaxonToStd.maxon:1644:
				// lowerSizeofType: sizeof(T) in 'Bag.slotSize' but the function carries no layout descriptor
				// parameter`**, on a program the oracle compiles and runs.
				//
				// ⚠ **THE UNION IS THE ONLY SAFE DIRECTION, AND THE ASYMMETRY IS WHY.** Reserving a descriptor
				// no body reads costs one ignored parameter, and the supply side reads the reservation itself
				// (`LowerMaxonToStd.buildLayoutNeedingFuncs` counts params), so the two still agree. NOT
				// reserving one a body does read has no error path at all — it aborts the compiler. So an
				// answer that must be wrong is wrong upwards, and `solveDescriptorNeeds`' claim that same-named
				// methods "share one answer" is made true here rather than assumed.
				let alreadyContributed = directSeeds.contains(qualified)
				// ⭐ The COUNT seed rides the same graph and takes the same union, for the identical reason: two
				// declarations may wear one qualified name, and a plain `upsert` would make the last one the whole
				// answer for a slot that is ABI (W190, on `directSeeds`' measured terms).
				var readsACount = scan.readsFixedElementCount
				var directlyNeeded = scan.direct or dropsFeed or movesOutContainerElement or reassignsOpaqueManagedField or copiesArrayElement or buildsRecordFromOpaqueSource or returnsBorrowableOpaque or adoptsOpaqueResult or forwardsBorrowedOpaqueToAFeed or storesBorrowedOpaqueElement or walksAnOwnedOpaqueElement
				var edges = self.descriptorEdgesFor(site.typeName, scan: scan, isStatic: self.functionDeclIsStatic(q))
				var countEdges = self.fixedElementCountEdgesFor(site.typeName, scan: scan)
				// ⭐ A `Self{…}` CALLS this type's field-default helpers, so it is a call edge like any other
				// (W43b). See `fieldDefaultHelperNamesOf` for why every helper is named rather than only the
				// fields the literal omits.
				if scan.constructsSelfLiteral 'constructsSelf'
					edges.append(self.fieldDefaultHelperNamesOf(site.typeName))
				end 'constructsSelf'
				if alreadyContributed 'aSecondDeclarationWearingThisName'
					directlyNeeded = directlyNeeded or (try directSeeds.get(qualified) otherwise panic("scanDescriptorNeedsInto: '{String.from(qualified)}' is a seeded key by `contains` and absent by `get`"))
					readsACount = readsACount or (try countSeeds.get(qualified) otherwise panic("scanDescriptorNeedsInto: '{String.from(qualified)}' is a seeded key by `contains` and absent from the count column — the two seed columns are written in one act"))
					edges.append(try selfCallees.get(qualified) otherwise panic("scanDescriptorNeedsInto: '{String.from(qualified)}' has a direct-need seed but no self-callee row — the two columns are written in one act"))
					countEdges = mergedCountEdges(countEdges, previous: try countCallees.get(qualified) otherwise panic("scanDescriptorNeedsInto: '{String.from(qualified)}' has a direct-need seed but no count-callee row — the two edge columns are written in one act"))
				end 'aSecondDeclarationWearingThisName'

				directSeeds.upsert(qualified, value: directlyNeeded)
				countSeeds.upsert(qualified, value: readsACount)
				selfCallees.upsert(qualified, value: edges)
				countCallees.upsert(qualified, value: countEdges)
				// Once per NAME, not once per declaration: `solveDescriptorNeeds` indexes the graph by this
				// array, and a name listed twice would be two nodes standing for one method.
				if not alreadyContributed 'firstDeclarationWearingThisName'
					methodNames.push(qualified)
				end 'firstDeclarationWearingThisName'

				q = scan.endPos
				continue
			end 'method'

			// ⭐⭐ **A FIELD'S `= <expression>` DEFAULT IS A FUNCTION TOO, AND IT NEEDS THE DESCRIPTOR ON
			// EXACTLY THE SAME TERMS (W43b).** `var keys as KeyArray = KeyArray.create()` inside a generic
			// type becomes the synthesized nullary `__fieldDefault#Map#keys` (`FieldDefault.helper`), whose
			// body constructs an OPAQUE `Array with Key` — so it reads the enclosing instance's layout
			// descriptor exactly as a method doing the same thing does. Nothing scanned it, so nothing
			// reserved the slot: **MEASURED, `panic at LowerMaxonToStd.maxon:1963: appendOpaqueArrayCreate:
			// opaque `Array.create()` in '__fieldDefault#Bag#items' but the function carries no layout
			// descriptor parameter`**, on the one-parameter `type Bag uses Element` the oracle compiles and
			// runs. It is a NODE of this same fixpoint rather than a rule of its own, so a default that
			// merely CALLS something needing one is covered by the same transitive closure.
			if self.structFieldKeywordAt(q) 'field'
				q = self.recordFieldDefaultDescriptorNeeds(q, typeName: site.typeName, methodNames: methodNames, directSeeds: directSeeds, countSeeds: countSeeds, selfCallees: selfCallees, countCallees: countCallees)
				continue
			end 'field'
			q = q + 1
		end 'walk'

		self.closeTypeParamScope()
	end 'scanDescriptorNeedsInto'

	// ⭐ **EVERY `__fieldDefault#<Type>#<field>` HELPER THIS TYPE DECLARES** — the call edges a `Self{…}`
	// carries. Read off the whole-program `StructLayout`, which is complete by the time this fixpoint runs, so
	// the names here and the names `Parser.fillFieldDefault` emits calls to are ONE mint
	// (`Project.fieldDefaultHelperName`) rather than two spellings.
	//
	// ⚠ **EVERY HELPER, NOT ONLY THE FIELDS THE LITERAL OMITS — and the asymmetry is the reason.** Naming only
	// the omitted fields would need the literal's labels read at brace depth 1, and a nested literal
	// (`Self\{a: Other\{x: 1}}`) mis-read there would DROP an edge; a dropped edge has no error path at all, it
	// aborts the compiler two passes later (the panic quoted above). An extra edge only ever reserves a
	// descriptor parameter nothing reads, which `solveDescriptorNeeds`' own header calls the safe direction. It
	// is bounded besides: the edge is inert unless the helper genuinely needs a descriptor, which only a generic
	// type's opaque-`T` default can produce.
	function fieldDefaultHelperNamesOf(typeName ByteArray) returns ByteArrayArray
		match self.signatures.structOf(typeName) 'declaringType'
			undeclared then return ByteArrayArray.create()
			declared(layout) then return fieldDefaultHelpersIn(layout)
		end 'declaringType'
	end 'fieldDefaultHelperNamesOf'

	// Record ONE field's default-expression node in the descriptor fixpoint, and answer the token index just
	// past the declaration. A field with no `= <expression>` default contributes nothing and is stepped over.
	//
	// ⚠ The region is `(=, end of line)` — `fieldDefaultEnd`'s extent, read through that same function so the
	// tokens scanned here and the tokens `captureFieldDefault` hands the drain are one region. A LITERAL default
	// (`= 7`) mints no helper at all (`FieldDefault.literal`), and scanning one finds nothing, so the two doors
	// need no shared verdict: an entry keyed on a helper name no layout carries is dropped by the fixpoint's own
	// name→index filter.
	function recordFieldDefaultDescriptorNeeds(q TokenIndex, typeName ByteArray, methodNames ByteArrayArray, directSeeds DescriptorNeedMap, countSeeds DescriptorNeedMap, selfCallees SelfCalleesMap, countCallees SelfCalleesMap) returns TokenIndex
		let afterModifier = self.pastVisibilityModifier(q)
		let fieldName = self.tokenAt(afterModifier + 1).value

		var eq = (afterModifier + 2) as TokenIndex
		while self.kindAt(eq) != TokenKind.newline and self.kindAt(eq) != TokenKind.eof and self.kindAt(eq) != TokenKind.equals 'findDefault'
			eq = eq + 1
		end 'findDefault'
		if self.kindAt(eq) != TokenKind.equals 'noDefault'
			return eq
		end 'noDefault'

		let regionEnd = self.fieldDefaultEnd(eq)
		let helperName = fieldDefaultHelperName(typeName, fieldName: fieldName)
		let scan = self.scanFieldDefaultDescriptorSignals((eq + 1) as TokenIndex, regionEnd: regionEnd)
		// A field name is unique within one declaration, so — unlike a METHOD name, which a body and an
		// extension may both wear — one helper name cannot be contributed twice and there is no union to take.
		directSeeds.upsert(helperName, value: scan.direct)
		countSeeds.upsert(helperName, value: scan.readsFixedElementCount)
		countCallees.upsert(helperName, value: self.fixedElementCountEdgesFor(typeName, scan: scan))
		// A field default is a nullary helper OF this type, so it holds the enclosing instance's descriptor on
		// exactly the terms a method does — which is why the edge set is `descriptorEdgesFor`'s and not this
		// door's own. A field default is never STATIC, and that is the one thing it has to say for itself.
		let edges = self.descriptorEdgesFor(typeName, scan: scan, isStatic: false)

		selfCallees.upsert(helperName, value: edges)
		methodNames.push(helperName)
		return regionEnd
	end 'recordFieldDefaultDescriptorNeeds'

	// The bare sibling names a body calls on `self`, qualified to the type they are siblings OF — the join
	// that makes a `self.appendOps(…)` written in `extension Mergeable`'s body and the `appendOps` declared in
	// `type Container`'s body one node of one graph. A callee that is not a sibling at all (a free function, a
	// builtin) survives the join as a name no method wears and is dropped by the fixpoint's own index filter,
	// exactly as the bare form was.
	// The union of two count-edge rows for one qualified name — `scanDescriptorNeedsInto`'s union rule, on the
	// column whose empty answer is a SHARED object. The descriptor column appends in place because its row is
	// always freshly minted (`qualifiedSelfCallees`); a count row for anything but the sized container is
	// `sharedEmptySizedContainerSelfCallees`, and appending into that would grow an array every scanned method
	// in the program is reading.
	function mergedCountEdges(edges ByteArrayArray, previous ByteArrayArray) returns ByteArrayArray
		if previous.count() == 0 'nothingToMerge'
			return edges
		end 'nothingToMerge'

		var merged = ByteArrayArray.create()
		merged.append(edges)
		merged.append(previous)
		return merged
	end 'mergedCountEdges'

	function qualifiedSelfCallees(typeName ByteArray, callees ByteArrayArray) returns ByteArrayArray
		var qualified = ByteArrayArray.create()
		for callee in callees 'eachCallee'
			qualified.push(qualifiedMethodName(typeName, methodName: callee))
		end 'eachCallee'
		return qualified
	end 'qualifiedSelfCallees'

	// ⭐⭐ **THE EDGE SET ONE SCANNED REGION CONTRIBUTES TO THE DESCRIPTOR-NEED FIXPOINT, WRITTEN ONCE
	// (found at review).** Two doors feed the graph — a METHOD body (`scanDescriptorNeedsInto`) and a FIELD
	// DEFAULT (`recordFieldDefaultDescriptorNeeds`) — and each assembled this list itself. Nothing made the
	// two agree: W161 had to add its line to both copies, and a signal added to one and not the other is an
	// edge the fixpoint never draws. **A MISSING RESERVATION HAS NO ERROR PATH** — it is
	// `forwardCallerLayout`'s ABORT at lowering, thousands of lines from the omission — so the two copies are
	// one expression here and the doors differ only in what they can say about themselves.
	//
	// `isStatic` is that difference and the only one: a field default is never static, so that door passes
	// `false` and reads exactly as it did. (`constructsSelfLiteral` stays at the method door: the names it
	// appends are the type's field-default HELPERS, and a field default is one of them.)
	function descriptorEdgesFor(typeName ByteArray, scan MethodDescriptorScan, isStatic bool) returns ByteArrayArray
		var edges = self.qualifiedSelfCallees(typeName, callees: scan.callees)

		// ⭐⭐ **THE CROSS-TYPE EDGES (ARRG)** — already qualified, because they name a method of ANOTHER
		// type. Gated exactly as `adoptsOpaqueResult` is and for its reasons: a NON-generic enclosing type has
		// no descriptor to forward, and a STATIC has no receiver to source one from
		// (`staticLayoutNeedsSelfReturn` refuses one that needs it, with a position). Without both gates this
		// edge would reserve a parameter whose only supply is `forwardCallerLayout`'s panic.
		if not self.enclosingTypeParams.isEmpty() and not isStatic 'aGenericInstanceMethod'
			edges.append(scan.corpusContainerCallees)
			// ⭐ The sized container's CHAINED self-call edges (W190) ride the SAME gate for the SAME reason —
			// the receiver is inferred rather than resolved, and a static that reserves a dictionary it cannot
			// source is a refusal on a program that used to compile. See the arm that records them.
			edges.append(scan.sizedContainerSelfCallees)
			// ⭐⭐ **AND THE CALLS THE `for … in self` ITSELF MAKES (found at review — W159's other half).**
			// W159 read this loop shape to SEED the per-trip drop and stopped there, but the very fact it
			// rests on — the loop's `createIterator()`/`current()`/`advance()` are emitted by the parser and
			// appear in NO token — hides the CALL EDGES just as completely as it hides the drop. While no
			// cursor entry point needed a descriptor the omission was inert; W161 ended that, because
			// `<InnerAlias>.create()` inside a `createIterator()` now reserves one. **MEASURED at review**: a
			// `type Bag uses Element` whose `createIterator` returns a `BagIter with Element` built through an
			// inner alias took `panic at LowerMaxonToStd.maxon:2209: forwardCallerLayout: caller 'Bag.walk'
			// has no layout descriptor to forward to 'Bag.createIterator'`.
			//
			// They are EDGES and not a seed, so they cost nothing where the entry points need nothing — which
			// is every corpus conformer today.
			if scan.walksReceiverAsACursor 'anEmittedCursorWalk'
				edges.append(self.emittedCursorProtocolCallees(typeName))
			end 'anEmittedCursorWalk'
		end 'aGenericInstanceMethod'

		// W161's edge carries NO static gate: it is recorded only for a receiver already resolved to a
		// nested parameterised instance, whose static constructor sources its descriptor from the RESULT it
		// builds. A static that could not source one is `staticLayoutNeedsSelfReturn`'s positioned refusal,
		// which is the answer that shape has always owed and is strictly better than the compiler abort it
		// replaces.
		edges.append(scan.nestedInstanceCallees)
		return edges
	end 'descriptorEdgesFor'

	// ⭐⭐⭐ **THE COUNT COLUMN'S EDGES ARE *NOT* THE DESCRIPTOR'S, AND "TWO SEEDS AND ONE EDGE SET" WAS
	// MEASURED WRONG THE FIRST TIME A `Vector` MEMBER RETIRED (W190 step 2).** `foldDescriptorNeeds` solved
	// both columns over `selfCallees` on the stated ground that a count and a descriptor *"propagate along
	// exactly the same self-call edges"*. They do not, and the difference is the direction each may err in:
	//
	//   • **AN OVER-RESERVED DESCRIPTOR COSTS ONE IGNORED PARAMETER** — every cross-type and receiver-blind
	//     edge in `descriptorEdgesFor` is licensed by that, in so many words.
	//   • **AN OVER-RESERVED COUNT REFUSES A LEGAL PROGRAM.** The slot's supply is the CALLER's, and a caller
	//     holding an instance that states no count has nothing to give: it meets
	//     `requireFixedElementCountSourceForForwarding`. **MEASURED, the moment the cross-type corpus edge
	//     (`corpusContainerCallees`) learned about the sized container**: `slot.capacity()` inside
	//     `type Holder uses Element` drew `Holder.size → Vector.capacity`, so `Holder.size` reserved a count
	//     and `countof.a-sized-field-of-another-generic-answers-its-own-count` — a case whose `slot` STATES 4
	//     and needs no forward at all — was refused at `h.size()`. A second case
	//     (`error.an-alias-of-a-Self-typed-parameter-is-refused`) stopped being refused for the mirror reason.
	//
	// ⭐ **THE PRECISE RULE IS A FACT ABOUT WHERE A COUNT CAN BE READ AT ALL: only inside the SIZED
	// CONTAINER's own body.** `countof(Self)` requires it (`countofOperandIsTheOwnInstanceAt`) and so does the
	// `Self{}` that publishes the slots (`ownRecordLiteralOfTheSizedContainerAt`). Everywhere else a receiver's
	// instance STATES its count, so the call site folds a constant and owes its caller nothing. So the count
	// graph is the container's own call graph and is EMPTY for every other type — which is also why this costs
	// no allocation where it says nothing.
	function fixedElementCountEdgesFor(typeName ByteArray, scan MethodDescriptorScan) returns ByteArrayArray
		if not self.signatures.isVectorBaseName(typeName) 'notTheSizedContainersOwnBody'
			return sharedEmptySizedContainerSelfCallees
		end 'notTheSizedContainersOwnBody'

		var edges = self.qualifiedSelfCallees(typeName, callees: scan.callees)
		edges.append(scan.sizedContainerSelfCallees)
		return edges
	end 'fixedElementCountEdgesFor'

	// The three calls a `for … in self` emits, qualified to the type they are made on — `self`, so the
	// enclosing type, whichever of the two cursor shapes it is: a type with a FACTORY wears all three, and
	// one declaring the cursor protocol directly wears the last two and no `createIterator`. Naming all three
	// unconditionally is safe for the reason `qualifiedSelfCallees` gives — a name no method of the type
	// wears is dropped by the fixpoint's own index filter.
	function emittedCursorProtocolCallees(typeName ByteArray) returns ByteArrayArray
		var names = ByteArrayArray.create()
		names.push(qualifiedMethodName(typeName, methodName: CreateIteratorMethodName))
		names.push(qualifiedMethodName(typeName, methodName: CurrentMethodName))
		names.push(qualifiedMethodName(typeName, methodName: AdvanceMethodName))
		return names
	end 'emittedCursorProtocolCallees'

	// Scan ONE method's body — from `bodyStart` (just past `function <name>`) to its own `end` — for the
	// descriptor signals. The EXTENT is found first and the signals are then read over that bounded region, so
	// the FIELD-DEFAULT door (`scanFieldDefaultDescriptorSignals`, whose region is a line rather than a block)
	// reads its tokens through the very same signal walk: the two regions differ in how they END and in nothing
	// else, and a signal added for one would otherwise have to be added twice.
	function scanOneMethodDescriptorSignals(bodyStart TokenIndex) returns MethodDescriptorScan
		return self.scanDescriptorSignalsIn(bodyStart, regionEnd: self.methodBodyEndFrom(bodyStart))
	end 'scanOneMethodDescriptorSignals'

	// The token index just past the `end` that closes the method body opening at `bodyStart`. `depth` starts at
	// 1 because the method's own block is already open; EOF answers itself, which is what an unterminated body
	// (a program the real parse refuses with a position) leaves.
	function methodBodyEndFrom(bodyStart TokenIndex) returns TokenIndex
		var depth = 1 as BlockDepth
		var q = bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			if self.opensBlockAt(q) 'opensBlock'
				depth = depth + 1
			end 'opensBlock' else 'notOpener'
				if self.closesBlockAt(q) 'closes'
					depth = depth - 1
					if depth == 0 'methodEnd'
						return (q + 1) as TokenIndex
					end 'methodEnd'
				end 'closes'
			end 'notOpener'
			q = q + 1
		end 'walk'
		return q
	end 'methodBodyEndFrom'

	// ⭐ **A FIELD'S `= <expression>` DEFAULT, READ FOR THE SAME SIGNALS (W43b)** — the region is `fieldDefaultEnd`'s
	// (the `=` to the end of its line), because that is the region `captureFieldDefault` hands the drain, so the
	// tokens seeded here and the tokens compiled into `__fieldDefault#<Type>#<field>` are one region by
	// construction. `hasControlFlow` and `reassignsOpaqueField` come back false from a one-line nullary
	// expression, which is the truth about it rather than an omission: it opens no block and has no `self`.
	function scanFieldDefaultDescriptorSignals(start TokenIndex, regionEnd TokenIndex) returns MethodDescriptorScan
		return self.scanDescriptorSignalsIn(start, regionEnd: regionEnd)
	end 'scanFieldDefaultDescriptorSignals'

	// The signal walk itself, over `[start, regionEnd)`. ALSO records `hasControlFlow` (P1.7 slice 3b-v): the
	// region is NOT straight-line — a nested block-opener, or a `return`/`throw`/`break`/`continue` — the token
	// signal the caller pairs with "has an opaque feed parameter" to decide the drop needs the descriptor.
	// ⭐ **THE TWELVE SIGNALS `scanDescriptorSignalsIn` COLLECTS, AS BIT POSITIONS IN ONE MASK.** Named
	// rather than numbered at the use sites for the reason every other bit vocabulary in this compiler is
	// (`maskHasParam`'s `ParamPositionMask`, whose two accessors these mirror): a bare `1 shl 7` in a `match`
	// arm is a fact nothing can check. See the mask's declaration inside the function for why the flags stopped
	// being twelve `var bool`s.
	function scanDescriptorSignalsIn(start TokenIndex, regionEnd TokenIndex) returns MethodDescriptorScan
		// ⭐⭐ **THE TWELVE ANSWERS THIS WALK COLLECTS TRAVEL AS ONE MASK — E5001's OWN CURE, NOT A STYLE**
		// **CHOICE.** Each was a `var bool` declared here and set inside the token loop below, so each was a
		// value LIVE ACROSS that loop and the allocator owed it a register for the whole body. shv2 refused
		// its own source over exactly this: *"the loop at Parser.maxon:14977 needs 10 more register(s) than
		// are available — 24 values must be held in registers at once"*, and twelve of those twenty-four
		// were these, every one reported as **read 0 times in the loop** — written on the way past and not
		// consulted until the walk is over. One machine word carries all twelve, and the loop's working set
		// drops by eleven. The named slots and the two accessors are `ScanSignal` above this function.
		var signals = NoScanSignals
		var callees = ByteArrayArray.create()
		// ⭐ Copied off its shared anchor at each chained edge (`nameColumnWith`), so every body of every other
		// type allocates nothing for it — the `sharedEmptyCorpusContainerCallees` discipline, one column over.
		var sizedContainerSelfCallees = sharedEmptySizedContainerSelfCallees
		// Hoisted out of the walk: it is a property of the enclosing DECLARATION, not of a token.
		let insideTheSizedContainer = self.signatures.isVectorBaseName(self.enclosingType)
		// ⭐ **THE LOCALS THIS BODY BINDS TO A `Self{…}` — a call on one of them is a SELF-CALL** (W43b). See
		// `selfTypedLocalBoundAt` for why the binding is read rather than every receiver over-approximated.
		var selfTypedLocals = ByteArrayArray.create()
		// ⭐ **THE LOCALS THIS BODY BINDS TO A NESTED PARAMETERISED INSTANCE, AND THE BASE EACH DENOTES**
		// (W161) — two columns in lockstep, so a later `<local>.<m>(` draws the same edge the field or alias it
		// was bound from would. See `nestedInstanceLocalBaseAt`.
		var nestedInstanceLocals = ByteArrayArray.create()
		var nestedInstanceLocalBases = ByteArrayArray.create()
		// ⭐ Does this region write a `Self{…}`? Every field-default helper of the enclosing type is CALLED by
		// one (`Parser.fillFieldDefault`), so the caller turns this into edges (W43b).
		// ⭐ Does this region build a RECORD — a struct literal or a tuple literal (W41-opaque)?
		// ⭐ Does this region CALL a method that hands back a bare type parameter (W58)? See
		// `MethodDescriptorScan.adoptsOpaqueCallResult`.
		// ⭐ Does this region CALL a method some declaration gives a type-parameter FEED parameter (BATCH41)?
		// See `MethodDescriptorScan.forwardsToATypeParamFeed`.
		// ⭐ Does this region STORE INTO A CONTAINER (W60)? See `MethodDescriptorScan.storesContainerElement`.
		// ⭐ Does this region walk `for … in self` (W159)? See `MethodDescriptorScan.walksReceiverAsACursor`.
		// ⭐ The cross-type call edges (ARRG), copied off the anchor at each one (`nameColumnWith`). See
		// `MethodDescriptorScan.corpusContainerCallees` and `sharedEmptyCorpusContainerCallees`.
		var corpusContainerCallees = sharedEmptyCorpusContainerCallees
		// ⭐ The nested-instance construction edges (W161), copied off the anchor at each one (`nameColumnWith`). See
		// `MethodDescriptorScan.nestedInstanceCallees` and `sharedEmptyNestedInstanceCallees`.
		var nestedInstanceCallees = sharedEmptyNestedInstanceCallees
		// The open `(`/`[`/`{` groups enclosing the cursor, each carrying whether a comma directly inside it
		// would be a TUPLE's separator rather than an argument list's. See the comma arm below.
		var groupIsTuplePosition = BoolArray.create()
		var q = start
		while q < regionEnd 'walk'
			let kind = self.kindAt(q)
			if kind == TokenKind.sizeof and self.sizeofOperandIsTypeParamAt(q) 'directSizeof'
				signals = maskWithSignal(signals, signal: ScanSignalDirect)
			end 'directSizeof'
			// ⭐ `countof(Self)` reserves the COUNT slot, and deliberately NOT the descriptor one (W190): the
			// count travels as its own hidden constant argument, so a body that reads nothing else about its
			// type argument can be called from a frame that carries no descriptor at all.
			if kind == TokenKind.countof and self.countofOperandIsTheOwnInstanceAt(q) 'directCountof'
				signals = maskWithSignal(signals, signal: ScanSignalReadsFixedElementCount)
			end 'directCountof'
			// ⭐⭐ **AND SO DOES `Self{}` INSIDE THE SIZED CONTAINER, WHICH IS `stdlib/Vector.maxon`'s `create()`
			// (W190).** That literal BUILDS the record, and a fixed-size container's record is born with its
			// slots published — so the number of them is exactly what the shared body cannot state and its
			// caller can. It is the same slot `countof(Self)` reads, seeded off a second token shape because
			// the corpus body spells no `countof`: `stdlib/` is compiled by the BOOTSTRAP too, which has no
			// such expression, so the count reaches this one body through the construction rather than
			// through a keyword.
			if self.ownRecordLiteralOfTheSizedContainerAt(q) 'sizedContainerLiteral'
				signals = maskWithSignal(signals, signal: ScanSignalReadsFixedElementCount)
			end 'sizedContainerLiteral'
			// A `return`/`throw`/`break`/`continue` is a NON-final exit (or, at the tail, harmless over-inclusion):
			// with one of these OR a nested block below, a feed parameter can be left live at an exit and dropped,
			// so the method needs the descriptor. A straight-line body has none and unconditionally consumes its
			// feed. Over-inclusion only reserves an unused descriptor parameter (sound), never a wrong drop.
			if kind == TokenKind.return or kind == TokenKind.throw or kind == TokenKind.break or kind == TokenKind.continue 'earlyExit'
				signals = maskWithSignal(signals, signal: ScanSignalHasControlFlow)
			end 'earlyExit'
			// Constructing an opaque-`T` container (`ElementArray.create()`, or the literal `ElementArray{}` it
			// shares a producer with — and since S2u a `Vector with <N> <type parameter>`, since W134 a
			// `__ManagedList with <type parameter>`) stamps its element destructor from the enclosing instance's
			// threaded descriptor, so — like `sizeof(T)` — it needs the descriptor param (P1.7 slice 3b-i, S2i).
			if kind == TokenKind.identifier and self.opaqueContainerConstructionAt(q) 'opaqueContainerConstruction'
				signals = maskWithSignal(signals, signal: ScanSignalDirect)
			end 'opaqueContainerConstruction'
			// ⭐⭐ **`Self{}` IS A THIRD SPELLING OF THAT SAME CONSTRUCTION (W57)**, and it is here for the
			// reason the header above records the literal form being added for: the parser grew a producer and
			// this scan did not, so `appendOpaqueArrayCreate` met a function with no descriptor reserved and
			// **PANICKED — measured, on `Array.create`'s own `return Self{}`.** Inside `type Array` the
			// enclosing instance is `Array with <its own parameter>`, so the create stamps `element_destroy@40`
			// from the threaded descriptor exactly as `ElementArray{}` does one arm up.
			if kind == TokenKind.selfType and self.opaqueSelfArrayConstructionAt(q) 'opaqueSelfArrayConstruction'
				signals = maskWithSignal(signals, signal: ScanSignalDirect)
			end 'opaqueSelfArrayConstruction'
			// A `.pop()`/`.remove(i)` array MOVE-OUT hands back an OWNED element dropped at scope exit; when the
			// element is an opaque `typeParameter` that drop routes through the descriptor-gated
			// `__drop_type_param`, so — like `sizeof(T)` and an opaque `X.create()` — the method needs the
			// descriptor param (P1.7 slice 3b-vi-a). The receiver is NOT resolved here (the pre-scan runs before
			// the body is parsed), so ANY move-out is recorded and the caller decides — over-reserving an unused
			// descriptor for a concrete-array move-out is sound. READ accessors (`get`/`first`/`last`) BORROW and
			// drop nothing, so they are not move-outs and are excluded.
			if kind == TokenKind.identifier and self.containerMoveOutMethodAt(q) 'arrayMoveOut'
				signals = maskWithSignal(signals, signal: ScanSignalHasContainerMoveOut)
			end 'arrayMoveOut'
			// A `.slice()`/`.clone()`/`.append()` array COPY lowers, on an OPAQUE array, to an
			// `__managed_{slice,clone,append}_opaque(arr, …, descriptor)` wrapper that reads the enclosing instance's
			// `copyFunc@32` (P1.7 slice 3b-vi-b-β), so — like the move-out — the method needs the descriptor param.
			// The receiver is NOT resolved here, so ANY copy is recorded and the caller decides; over-reserving an
			// unused descriptor for a concrete-array copy is sound.
			if kind == TokenKind.identifier and self.arrayCopyMethodAt(q) 'arrayCopy'
				signals = maskWithSignal(signals, signal: ScanSignalHasArrayCopy)
			end 'arrayCopy'
			// A `.push()`/`.set()`/`.insert()` MOVE-IN may store a BORROWED opaque `T`, whose reference is taken
			// through the enclosing instance's `retainFunc@64` (W60) — so, like the move-out and the copy, the
			// method needs the descriptor param. The receiver is NOT resolved here and neither is the ARGUMENT's
			// provenance: over-reserving for a concrete-array store, or for one whose element the frame already
			// owns, costs an unused parameter; missing one refuses a legal program at
			// `requireDescriptorForOpaqueStores`.
			if kind == TokenKind.identifier and self.containerMoveInMutatorCallAt(q) 'containerStore'
				signals = maskWithSignal(signals, signal: ScanSignalStoresContainerElement)
			end 'containerStore'
			// A `self.<opaqueManagedField> = …` REASSIGNMENT drops the field's OLD opaque value through the
			// descriptor-gated `__drop_type_param` (P1.7 Finding A), so — like an opaque array move-out — the
			// method needs the descriptor. `opaqueFieldReassignAt` reads the field's opacity AND managed-ness off
			// `self.signatures` (the SAME `isManagedOpaqueTypeParamField` the reserved slot and the emitted drop
			// decide off), so a trivial-only field reserves nothing (byte-identical) and a managed one reserves.
			if kind == TokenKind.self and self.opaqueFieldReassignAt(q) 'opaqueFieldReassign'
				signals = maskWithSignal(signals, signal: ScanSignalReassignsOpaqueField)
			end 'opaqueFieldReassign'
			if kind == TokenKind.self and self.isSelfMethodCallAt(q) 'selfCall'
				callees.push(self.tokenAt(q + 2).value)
			end 'selfCall'
			// ⭐⭐ **A CHAINED CALL INSIDE THE SIZED CONTAINER'S OWN BODY IS A SELF-CALL ON A VALUE WITH NO NAME
			// (W190).** The two precise columns key on a NAME — `self`, or a local a `Self{…}`/`Self.<static>()`
			// bound, or a parameter declared `Self` — and `self.dup().capacity()` has none of them: it calls a
			// method of this very type on a temporary. **MEASURED: `panic at emitFixedElementCountOf: caller
			// 'Vector.chained' has no fixed-element-count parameter to forward to 'Vector.capacity'`** — a
			// compiler abort on a legal program, which is what a missing edge in this fixpoint always costs.
			//
			// ⛔⛔ **THE `)` IS WHAT MAKES IT PRECISE, AND WITHOUT IT THIS ARM OVER-RESERVED FOUR CASES OF
			// EMITTED CODE.** The first cut matched EVERY `.<member>(` in the body, which is the receiver-blind
			// shape `selfTypedLocalBoundAt`'s ⛔ paragraph warns about — and it read `VectorIter.create(managed)`
			// inside `createIterator` as a call to `Vector.create`, whose `Self{}` seeds a descriptor need. So
			// `createIterator` reserved a descriptor nothing reads and every `for … in` over a vector grew a
			// `lea` of the instance's `__layout_*` blob: **MEASURED as four drifting goldens** (`vector/iterate`,
			// `vector/from-array-literal-iterate`, `vector/bool-vector-from-literal`,
			// `vector-static-index/variable-index-set-keeps-the-bounds-check`). A receiver spelled as a NAME is
			// already covered by a precise column; the only receiver they cannot see is one that has no name,
			// and a value with no name is a call's RESULT.
			//
			// It is still gated by the enclosing declaration here and by the static rule at
			// `descriptorEdgesFor`, on those columns' own terms; a name this type does not declare is dropped
			// by the fixpoint's own name→index filter.
			if insideTheSizedContainer and kind == TokenKind.dot and self.memberCallFollows(q) and q != 0 and self.kindAt((q - 1) as TokenIndex) == TokenKind.rightParen 'aChainedSelfCallInTheSizedContainer'
				// Already QUALIFIED, like `corpusContainerCallees` and unlike `callees`: this column is appended to
				// the edge list directly rather than through `qualifiedSelfCallees`, so a bare name here would match
				// no node and the edge would be silently dropped by the fixpoint's own name filter.
				sizedContainerSelfCallees = nameColumnWith(sizedContainerSelfCallees, name: qualifiedMethodName(self.enclosingType, methodName: self.tokenAt(q + 1).value))
			end 'aChainedSelfCallInTheSizedContainer'
			// ⭐⭐ **`Self.<member>(…)` IS THE SAME EDGE UNDER THE OTHER KEYWORD, AND IT WAS MISSING (W190).**
			// `self.m(` is an instance call and `Self.m(` a STATIC one, but the fixpoint does not ask which:
			// what it records is *"this body reaches a sibling, so whatever that sibling's ABI needs, this
			// body has to supply"* — and a static reached this way sources its dictionary from the RESULT it
			// returns, which inside the declaring body is the enclosing instance itself. **MEASURED: a
			// `Vector` instance method writing `var fresh = Self.counted()`, where `counted()` reads
			// `countof(Self)`, reserved nothing and hit `emitFixedElementCountOf: caller 'Vector.rebuild' has
			// no fixed-element-count parameter to forward`.** `selfTypedLocalBoundAt` one door over already
			// recognizes this exact token shape — to record the LOCAL it binds — so the shape was seen and
			// only the edge out of it was not drawn.
			if kind == TokenKind.selfType and self.memberCallFollows((q + 1) as TokenIndex) 'selfTypeStaticCall'
				callees.push(self.tokenAt(q + 2).value)
			end 'selfTypeStaticCall'
			// ⭐ A `var result = Self{…}` LOCAL is a value of the enclosing type, so `result.upsert(…)` reaches
			// the same shared body `self.upsert(…)` does and must feed the fixpoint identically (W43b). Recorded
			// on the way past the binding, so the call sites below it are recognized in this one walk.
			if self.selfTypedLocalBoundAt(q) 'selfTypedBinding'
				selfTypedLocals.push(self.tokenAt(q + 1).value)
			end 'selfTypedBinding'
			// ⭐⭐ **A `Self`-TYPED PARAMETER IS A VALUE OF THE ENCLOSING TYPE TOO, AND ITS EDGE WAS MISSING
			// (W190).** `merge(other Self)` binds `other` to the very instance the receiver is
			// (`substitutedFixedSize` gives a countless `Self` the RECEIVER's count, and a differently-sized
			// argument is refused outright), so `other.<m>()` reaches the same shared body `self.<m>()` does
			// and the caller can forward its own dictionary. The scan region opens at the `(` of the parameter
			// list, so the declaration is in it and no signature lookup is needed.
			//
			// ⚠ **THE SHAPE COULD ONLY BE THIS SPELLING, WHICH IS WHY A TOKEN PAIR IS ENOUGH.** `Self` is
			// preceded by an IDENTIFIER only in a parameter declaration — a field writes `as Self`, a return
			// writes `returns Self`, an alias writes `= Self`, a type argument follows `with` or a count. It is
			// PRECISE rather than receiver-blind (it reads the parameter's declared TYPE), which is what
			// `selfTypedLocalBoundAt`'s ⛔ paragraph requires of anything feeding this list.
			//
			// ⛔⛔ **WITHOUT IT THE COUNT PATH ABORTS THE COMPILER, WHERE THE DESCRIPTOR PATH ONLY REFUSED.**
			// `requireSelfForDescriptorForwarding` catches this shape for a DECLARED generic, whose `Self` is a
			// `structRef` — but a container whose record the compiler owns has a `genericInstance` `Self`, which
			// that guard tests its way past. **MEASURED: `Vector.pairWith(other Self)` calling
			// `other.capacity()` hit `emitFixedElementCountOf: caller 'Vector.pairWith' has no
			// fixed-element-count parameter to forward`.** Drawing the edge is the answer that guard's own
			// header calls the later slice, and it retires the refusal for the declared-generic case as well.
			if self.selfTypedParamDeclaredAt(q) 'selfTypedParam'
				selfTypedLocals.push(self.tokenAt(q).value)
			end 'selfTypedParam'
			if self.selfTypedLocalCallAt(q, locals: selfTypedLocals) 'selfTypedLocalCall'
				callees.push(self.tokenAt(q + 2).value)
			end 'selfTypedLocalCall'
			// A BARE sibling call `method(…)` (#65) is a self-call too: implicit-self resolves it to
			// `self.method(…)`, so it must feed the descriptor-need fixpoint exactly as an explicit
			// `self.method(…)` does — otherwise a method reading `sizeof(T)` reached only through a bare sibling
			// call would leave its caller with no descriptor to forward (a `forwardCallerLayout` panic). A
			// callee that is NOT a sibling (a free function, a builtin) is dropped by the fixpoint's name->index
			// filter, so over-including here is harmless.
			// ⚠ A sibling's name may be a KEYWORD (D8: `to(item)` resolving to `self.to(item)`), so the callee is
			// read through `tokenCanBeAName` — MINUS the block-structure kinds, which is not a hedge: a
			// parenthesized loop condition IS `while (`, and a bare call to a sibling literally named by one of
			// those keywords is a program `keywordIsANameInOperandPosition` already refuses, so every kind in
			// that set can only be a false positive here. (Deliberately NOT a count: the set grows — `try`
			// joined it with the block form — and a number written here would rot on the day it did.)
			if tokenCanBeAName(self.tokenAt(q)) and not kindSpellsBlockStructure(kind) and self.isBareCallAt(q) 'bareCall'
				callees.push(self.tokenAt(q).value)
			end 'bareCall'
			// ⭐⭐ **A `.<name>(` WHOSE NAME SOME DECLARATION RETURNS A BARE `T` FROM (W58)** — the CALLER's
			// half of the `returns T` hand-off, and the one shape whose descriptor the sibling signals could not
			// reach. A SELF call is already covered twice over (its callee's own `returnsBorrowableOpaque` seed
			// reaches this caller through the fixpoint), so this arm exists for the receivers the fixpoint has no
			// edge for: a field, a parameter, a local — `cell.get()` inside `type Holder uses T` over a
			// `Cell with T`, which adopted a `+1` on `T` and had nothing to release it through.
			//
			// Read at the `.` rather than at the name, so a keyword-named method (D8) is seen for
			// `tokenCanBeAName`'s reason and a bare `name(` — which is a SIBLING call, and covered — is not.
			if kind == TokenKind.dot and tokenCanBeAName(self.tokenAt(q + 1)) and self.kindAt(q + 2) == TokenKind.leftParen and self.signatures.methodNameEverReturnsBareTypeParameter(self.tokenAt(q + 1).value) 'adoptsOpaqueResult'
				signals = maskWithSignal(signals, signal: ScanSignalAdoptsOpaqueCallResult)
			end 'adoptsOpaqueResult'
			// ⭐⭐ **THE CALLER'S HALF OF THE CONSTRUCTOR-FEED RETAIN (BATCH41)** — the exact twin of the arm
			// above, one direction over: that one is a `.<name>(` whose callee HANDS BACK a bare `T`, this one
			// a `.<name>(` whose callee will KEEP one. `EBox.create(x, tag: tag)` inside `type Bag uses
			// Element` is the shape, and the reference it owes is taken through `retainFunc@64`
			// (`handleEscapingBorrowFeed`), so the body needs the descriptor. Read at the `.` for that arm's
			// reason: a keyword-named method (D8) is seen, and a bare `name(` is a SIBLING call the fixpoint
			// already reaches through its own edge.
			if kind == TokenKind.dot and tokenCanBeAName(self.tokenAt(q + 1)) and self.kindAt(q + 2) == TokenKind.leftParen and self.signatures.methodNameEverFeedsATypeParameter(self.tokenAt(q + 1).value) 'forwardsToAFeed'
				signals = maskWithSignal(signals, signal: ScanSignalForwardsToATypeParamFeed)
			end 'forwardsToAFeed'
			// ⭐⭐ **THE CROSS-TYPE EDGE (ARRG)** — a `.<member>(` the CORPUS serves on a builtin generic
			// container. Read at the `.` for the arm above's reason, and recorded as an EDGE rather than as a
			// seed because whether the callee needs a descriptor is the fixpoint's own answer, not this scan's.
			// The list is COPIED off `sharedEmptyCorpusContainerCallees` at each edge (`nameColumnWith`), so a body
			// with no corpus call — nearly every body there is — allocates nothing for this arm.
			if kind == TokenKind.dot and self.memberCallFollows(q) and self.corpusServesArrayMember(self.tokenAt(q + 1).value) 'aCorpusContainerCall'
				// ONE edge per `Array` DECLARATION that serves the name (ARR2) — normally one, and two only
				// while a user program's own `type Array` has the corpus declaration in the reserved space. The
				// gate above says SOME declaration serves it; the callee name has to say WHICH, because that is
				// what the fixpoint indexes by.
				for declaration in self.arrayDeclarationNames() 'eachArrayDeclaration'
					if self.corpusArrayDeclarationServes(declaration, member: self.tokenAt(q + 1).value) 'thisDeclarationServesIt'
						corpusContainerCallees = nameColumnWith(corpusContainerCallees, name: qualifiedMethodName(declaration, methodName: self.tokenAt(q + 1).value))
					end 'thisDeclarationServesIt'
				end 'eachArrayDeclaration'
			end 'aCorpusContainerCall'
			// ⭐⭐ **A CALL ON A NESTED PARAMETERISED INSTANCE, AND THE BINDING THAT CARRIES ONE (W161)** — an
			// inner alias (`EChain.create()`), a field declared at one (`chain.count()`), or a local bound
			// from either. The callee reads the ENCLOSING instance's descriptor, which has no blob to point
			// at, so the caller has to forward its own blocks and therefore has to carry them.
			//
			// The binding is recorded BEFORE the call test, so a `var i = EChain.create()` whose result is
			// used later in the same walk is already known when `i.count()` is reached; the two arms share
			// one resolution (`nestedInstanceBaseOfNameAt`) so a receiver cannot be one thing to the binding
			// and another to the call.
			let nestedInstanceLocalBase = self.nestedInstanceLocalBaseAt(q, locals: nestedInstanceLocals, localBases: nestedInstanceLocalBases)
			if not nestedInstanceLocalBase.isEmpty() 'aNestedInstanceBinding'
				nestedInstanceLocals.push(self.tokenAt(q + 1).value)
				nestedInstanceLocalBases.push(nestedInstanceLocalBase)
			end 'aNestedInstanceBinding'
			self.recordNestedInstanceDeclarationAt(q, locals: nestedInstanceLocals, localBases: nestedInstanceLocalBases)
			let nestedCallee = self.nestedInstanceCalleeAt(q, locals: nestedInstanceLocals, localBases: nestedInstanceLocalBases)
			if not nestedCallee.isEmpty() 'aNestedInstanceCall'
				nestedInstanceCallees = nameColumnWith(nestedInstanceCallees, name: nestedCallee)
			end 'aNestedInstanceCall'
			// ⭐⭐ **A `for … in self` IS AN EMITTED `current()` CALL, AND NO TOKEN SPELLS IT (W159).** See
			// `forStatementWalksBareReceiverAt` for why the source must be the BARE receiver and why every
			// other source stays with the refusal.
			if kind == TokenKind.for and self.forStatementWalksBareReceiverAt(q) 'walksTheReceiver'
				signals = maskWithSignal(signals, signal: ScanSignalWalksReceiverAsACursor)
			end 'walksTheReceiver'
			if kind == TokenKind.selfType and self.kindAt(q + 1) == TokenKind.leftBrace 'selfLiteral'
				signals = maskWithSignal(signals, signal: ScanSignalConstructsSelfLiteral)
			end 'selfLiteral'
			// ⭐ A `<TypeName>{` / `Self{` STRUCT literal is a record construction (W41-opaque) — the half of
			// the signal that IS a token test. The tuple half is folded in below, off a paren stack.
			//
			// ⛔⛔ **AN EMPTY `X{}` IS NOT ONE, AND ADMITTING IT REACHED A CHAIN THAT MUST STAY INERT (W183).**
			// The signal asks whether this body may STORE a borrowed opaque `T` into a record; a literal with
			// no arguments stores nothing a body could have borrowed (a field DEFAULT is filled by its own
			// `__fieldDefault#…` helper, which reserves its own descriptor), so it can never be that store.
			// `stdlib/Interfaces.maxon`'s `extension Iterable.map` opens with `var result = ElementArray{}` —
			// an empty CONTAINER literal, which no token test can tell from a record — and MEASURED, seeded
			// off it, `Map.map` reserved a descriptor and `emitInstanceDescriptorAddr` then FORWARDED a real
			// one into the `MapIterator with (Key, Value)` chain whose own header records that it is
			// deliberately inert on both ends: `MapIterator.current` CLONED each key into the `(Key, Value)`
			// tuple it hands back and nothing released it — `interface-extensions/stdlib-map-on-map-with-function`
			// at exit 101 where 6 is correct. It is the THIRD time this one chain has been broken by an
			// over-reservation (`W159`'s cursor-element signal and `feedsATypeParameterConstructor`'s feed
			// signal were the first two), and each cure was the same: ask the narrower question the signal
			// actually means.
			if kind == TokenKind.leftBrace and tokenCanBeAName(self.tokenAt(q - 1)) and self.kindAt(q + 1) != TokenKind.rightBrace 'structLiteral'
				signals = maskWithSignal(signals, signal: ScanSignalBuildsRecord)
			end 'structLiteral'
			// ⭐⭐ **A TUPLE LITERAL IS A `(` IN EXPRESSION POSITION HOLDING A DEPTH-1 COMMA, and a token test
			// cannot see it (W41-opaque).** A `(` FOLLOWING something that can end a primary expression opens a
			// CALL or an index, whose commas separate arguments; every other `(` opens a grouping, and a
			// grouping holding a top-level comma is a tuple. The stack is what makes "top-level" exact: a comma
			// inside a nested call, bracket or brace belongs to that opener and not to this one.
			//
			// ⚠ A STACK rather than a rescan from each `(`, for the cost this project keeps measuring: a
			// rescan is O(tokens) per paren and so quadratic in a body of nested calls, where the signal walk
			// is O(tokens) for everything else it collects. `groupDepths` is empty for a body with no
			// parenthesis at all, which is not the common case here but is the cheap one.
			if kind == TokenKind.leftParen or kind == TokenKind.leftBracket or kind == TokenKind.leftBrace 'opensGroup'
				groupIsTuplePosition.push(kind == TokenKind.leftParen and not self.tokenEndsAPrimaryExpression((q - 1) as TokenIndex))
			end 'opensGroup'
			if kind == TokenKind.comma and not groupIsTuplePosition.isEmpty() and (try groupIsTuplePosition.last() otherwise panic("scanDescriptorSignalsIn: groupIsTuplePosition is non-empty by the guard and has no last")) 'topLevelCommaInAGrouping'
				signals = maskWithSignal(signals, signal: ScanSignalBuildsRecord)
			end 'topLevelCommaInAGrouping'
			if (kind == TokenKind.rightParen or kind == TokenKind.rightBracket or kind == TokenKind.rightBrace) and not groupIsTuplePosition.isEmpty() 'closesGroup'
				// A region may CLOSE more groups than it opens (a field default is the `=` to the end of its
				// line), so an unmatched closer pops nothing rather than faulting.
				_ = try groupIsTuplePosition.pop() otherwise panic("scanDescriptorSignalsIn: groupIsTuplePosition is non-empty by the guard and cannot pop")
			end 'closesGroup'

			// A nested block-opener (`if`/`while`/`match`/`for`/`try`/inner block) — the feed's consume may be
			// guarded, so it can be left live at the merge. A method's own block is already open before this
			// walk starts (`methodBodyEndFrom` consumed it), so every opener here is a nested one.
			if self.opensBlockAt(q) 'opensBlock'
				signals = maskWithSignal(signals, signal: ScanSignalHasControlFlow)
			end 'opensBlock'

			q = q + 1
		end 'walk'
		return MethodDescriptorScan.create(maskHasSignal(signals, signal: ScanSignalDirect), callees: callees, hasControlFlow: maskHasSignal(signals, signal: ScanSignalHasControlFlow), hasContainerMoveOut: maskHasSignal(signals, signal: ScanSignalHasContainerMoveOut), reassignsOpaqueField: maskHasSignal(signals, signal: ScanSignalReassignsOpaqueField), hasArrayCopy: maskHasSignal(signals, signal: ScanSignalHasArrayCopy), constructsSelfLiteral: maskHasSignal(signals, signal: ScanSignalConstructsSelfLiteral), buildsRecord: maskHasSignal(signals, signal: ScanSignalBuildsRecord), adoptsOpaqueCallResult: maskHasSignal(signals, signal: ScanSignalAdoptsOpaqueCallResult), forwardsToATypeParamFeed: maskHasSignal(signals, signal: ScanSignalForwardsToATypeParamFeed), storesContainerElement: maskHasSignal(signals, signal: ScanSignalStoresContainerElement), walksReceiverAsACursor: maskHasSignal(signals, signal: ScanSignalWalksReceiverAsACursor), corpusContainerCallees: corpusContainerCallees, nestedInstanceCallees: nestedInstanceCallees, readsFixedElementCount: maskHasSignal(signals, signal: ScanSignalReadsFixedElementCount), sizedContainerSelfCallees: sizedContainerSelfCallees, endPos: regionEnd)
	end 'scanDescriptorSignalsIn'

	// ⭐⭐⭐ **THE ONE EDGE IN THE DESCRIPTOR-NEED FIXPOINT THAT LEAVES THE ENCLOSING TYPE (ARRG).** A `.<m>(`
	// whose `<m>` the ROSTER does not carry and `stdlib/Array.maxon` DOES declare is a call to a
	// SHARED GENERIC BODY over `Element`, and such a body may reserve a layout descriptor its caller must
	// SUPPLY. When the receiver is an `Array with <a parameter of the enclosing generic>` the only supply is
	// the enclosing frame's own descriptor, FORWARDED — so the caller has to carry one, and nothing in the
	// fixpoint said so: its edges followed SELF calls only.
	//
	// ⛔⛔ **AND A MISSING EDGE HERE IS A COMPILER ABORT, NOT A DIAGNOSTIC.** MEASURED with `set` struck from
	// `arraySurfaceMemberNames`: 38 cases — 34 `map/*` plus `tuples`, `interface-extensions` and
	// `for-destructuring-pattern` — died at `panic … primitiveTypeByteSize: a typeParameter's size is a
	// runtime layout-descriptor read`, raised by `MaxonToStdLowering.materializeLayoutArgFor` for
	// `Array with Key` inside `stdlib/Map.maxon`'s `insertAtSlot`. The reservation side had every seed it
	// needed and no edge to carry the callee's obligation across the `Map`/`Array` boundary.
	//
	// ⚠ **IT IS AN EDGE AND NOT A SEED, WHICH IS THE WHOLE OF WHY IT COSTS NOTHING WHERE IT IS NOT NEEDED.**
	// Whether `Array.set` reserves is `solveDescriptorNeeds`' own answer about `Array.set`; this only says
	// "and if it does, so does the caller". A member the ROSTER still serves is not a corpus call at all, so
	// it records no edge — which is why striking a name from the roster is the whole of what turns this on,
	// one name at a time, exactly as the retirement chain is designed to proceed.
	//
	// ⚠ **THE RECEIVER IS NOT RESOLVED, for every sibling signal's reason** — the scan runs before any body
	// is parsed. An edge to a callee the receiver could never have reached only ever reserves a descriptor
	// parameter nothing reads; a missing one aborts the compiler.
	//
	// ⚠ **`Array` ALONE, AND THE OTHER ROSTERED GENERIC SURFACE IS A DELIBERATE OMISSION.** `Map`'s roster is
	// also incomplete against the corpus (`extension Iterable` publishes `map`/`filter`/`contains` onto it),
	// so the identical edge exists there — but a `Map` edge reserves a descriptor in bodies that hold a
	// `Map`'s element, which is a TUPLE over two of its parameters, and the layout descriptor has one block
	// per type PARAMETER with no block a composite argument could occupy. Turning those reservations on
	// therefore trades a wrong answer for a different one; the measurement is in `ARRG`'s report and the
	// mechanism is the descriptor ABI's, not this edge's.
	//
	// ⛔⛔ **AND `Array` IS STILL ALONE AFTER THE SIZED CONTAINER RETIRED (W190), WHICH IS THE OPPOSITE OF
	// WHAT THAT RUNG WAS BRIEFED TO BUILD — SO IT IS WRITTEN DOWN WITH ITS MEASUREMENT.** The twin was built
	// (a `corpusServesSizedContainerMember` asking `stdlib/Vector.maxon`'s declaration the same two clauses),
	// and it is REDUNDANT and NOT FREE.
	//
	//   • **NOT FREE: 34 `map` goldens moved**, every one of them a `Map` body gaining a hidden descriptor
	//     parameter it never reads (`x64.loadRegBaseDisp.word64 rcx, [rbp + 56]` where the golden had none).
	//     `set` and `get` are declared on BOTH containers, so this receiver-BLIND edge gave every `arr.set(…)`
	//     inside `stdlib/Map.maxon` a second callee — `Vector.set`, which does reserve one.
	//   • **REDUNDANT BY CONSTRUCTION, not merely on today's corpus.** The shape that would abort is a call on
	//     a `Vector with <N> <a parameter of the enclosing generic>`, and **that instance cannot be spelled
	//     except through a typealias**: `function f(v Vector with 4 Element)` is `E2010 Expected ')' but got
	//     'with'` (measured). An alias-named receiver is exactly what `nestedInstanceCalleeAt` RESOLVES (W161),
	//     and a resolved edge is what costs no codegen where it is not needed. MEASURED with the twin removed:
	//     a `Vector with 4 Element` reached through a FIELD, a LOCAL, a PARAMETER and a CHAINED call inside
	//     `type Holder uses Element` all compile and answer correctly (7, 9, 11, and the suite's own
	//     `vector.a-vector-field-in-a-generic-body-round-trips-its-elements`), with `map` drift back to 0.
	//
	// ⇒ **A BLIND edge is what a container needs when its receivers wear names nothing resolves** — the
	// `Array`'s case (`bytes`, and every local in `stdlib/Map.maxon`) and not the sized container's.
	//
	// The verdict itself is memoized per NAME (`corpusServedContainerMembers` carries why), so the scan's `.` arm
	// pays it once per distinct member name in a file rather than once per call site.
	//
	// ⛔⛔ **A STATIC IS NOT A MEMBER CALL, AND ADMITTING ONE IS THE MEASURED WAY THIS EDGE GOES WRONG.**
	// `MapIterator.create(self, …)` has the identical token shape `<name> . <name> (`, and
	// `stdlib/Array.maxon` declares a `create` — so the receiver-blind test read that as a call to
	// `Array.create`, which reserves a descriptor for its own `return Self{}`. MEASURED: the edge gave
	// `Map.createIterator` a descriptor its own caller does not carry, and
	// `interface-extensions/stdlib-map-on-map-with-function` died at
	// `forwardCallerLayout: caller 'Map.map' has no layout descriptor to forward to 'Map.createIterator'`.
	// The receiver-blind over-approximation the sibling signals take is only free where the fixpoint can
	// still reach the caller; a STATIC's descriptor comes from its RESULT, not from a receiver, so an edge to
	// one describes a supply route the call site does not have.
	function corpusServesArrayMember(member ByteArray) returns bool
		if let remembered = try self.corpusServedContainerMembers.get(member) 'askedBefore'
			return remembered
		end 'askedBefore'

		// ⭐ **ASKED OF EVERY `Array` DECLARATION THIS COMPILE HAS (ARR2)**, which is exactly one for every
		// program that does not declare a container of its own. The `or` stops at the first that serves it.
		var served = false
		for declaration in self.arrayDeclarationNames() 'eachArrayDeclaration'
			served = served or self.corpusArrayDeclarationServes(declaration, member: member)
		end 'eachArrayDeclaration'

		if self.corpusServedContainerMembers is sharedEmptyCorpusMemberVerdicts 'firstQuestionThisFileAsks'
			self.corpusServedContainerMembers = DescriptorNeedMap.create()
		end 'firstQuestionThisFileAsks'

		self.corpusServedContainerMembers.upsert(member, value: served)
		return served
	end 'corpusServesArrayMember'

	// Does ONE named `Array` declaration serve `member` through a corpus body a caller may have to supply a
	// layout descriptor for? The first two clauses are the DISPATCH's own (`corpusServesNamedMemberOffRoster`),
	// so the call this edge is drawn for and the call the parser will actually route to a corpus body are one
	// decision. The receiver clause is this asker's alone — the ⛔⛔ paragraph above carries what admitting a
	// static cost. Written once because the memo above and the callee-NAME loop in the scan both ask it, and a
	// second copy is how the edge would come to be recorded for a member the dispatch does not route.
	function corpusArrayDeclarationServes(declaration ByteArray, member ByteArray) returns bool
		return self.corpusServesNamedMemberOffRoster(member, surface: MemberSurface.array, typeName: declaration) and self.signatures.declaredMethodTakesReceiver(qualifiedMethodName(declaration, methodName: member))
	end 'corpusArrayDeclarationServes'

	// ⭐⭐ **THE CALLEE A CALL ON A NESTED PARAMETERISED INSTANCE LINKS TO, or NONE (W161).**
	// `EChain.create()` inside `type Bag uses Element` answers `Inner.create` and `chain.count()` answers
	// `Inner.count`: BOTH spellings dispatch to the BASE struct (`denotedGenericBaseName` for the alias, the
	// receiver's declared type for the field), so that is the node the fixpoint indexes and the name this edge
	// has to carry. The MISS is `EmptySourceText`, `innerAliasMember`'s convention for the same shape of
	// question; a caller tests `isEmpty()`.
	//
	// ⚠ **THE RECEIVER IS RESOLVED, WHICH THE SIBLING CROSS-TYPE EDGE DELIBERATELY DOES NOT DO** — and here
	// it is not an option: the answer turns on WHICH instance the name denotes (is it written over the
	// enclosing type's own parameters?), and a receiver-blind name test cannot ask that. It is also what keeps
	// the edge OFF every ordinary call: a name denoting nothing of the kind is answered by two map lookups.
	//
	// ⛔ **AND RESOLVING IT IS WHY THIS COSTS NO CODEGEN WHERE IT IS NOT NEEDED, WHICH A SEED DID NOT.**
	// MEASURED: seeding every method of a type that HOLDS such an instance moved 13 committed goldens —
	// `Holder.create(cell Cell)`, whose whole body is `Self{cell: cell}`, gained a hidden descriptor parameter
	// and every call site gained a `lea` for a blob it never reads. An edge leaves "does `Inner.create`
	// actually need one?" to the fixpoint's own answer about `Inner.create`, which is also what keeps every
	// corpus iterator's `ArrayIter.create(managed)` inert.
	function nestedInstanceCalleeAt(q TokenIndex, locals ByteArrayArray, localBases ByteArrayArray) returns ByteArray
		if not tokenCanBeAName(self.tokenAt(q)) or not self.memberCallFollows(q + 1) 'notAMemberCallHead'
			return EmptySourceText
		end 'notAMemberCallHead'
		if not self.nameOpensAReceiverChainAt(q) 'aDeeperChainsMember'
			return EmptySourceText
		end 'aDeeperChainsMember'

		let base = self.nestedInstanceBaseOfNameAt(q, locals: locals, localBases: localBases)
		if base.isEmpty() 'namesNoNestedInstance'
			return EmptySourceText
		end 'namesNoNestedInstance'

		return qualifiedMethodName(base, methodName: self.tokenAt(q + 2).value)
	end 'nestedInstanceCalleeAt'

	// Is the name at `q` the RECEIVER's own spelling — a bare local, field or alias, or the field of a
	// `self.<field>.<method>(`? Any deeper chain (`a.b.c()`) names a value produced by an expression this
	// pre-scan cannot type, and is left to the fixpoint's other edges.
	function nameOpensAReceiverChainAt(q TokenIndex) returns bool
		if q == 0 or self.kindAt((q - 1) as TokenIndex) != TokenKind.dot 'aBareName'
			return true
		end 'aBareName'

		return q >= 2 and self.kindAt((q - 2) as TokenIndex) == TokenKind.self
	end 'nameOpensAReceiverChainAt'

	// The base type of the nested parameterised instance the NAME at `q` denotes — an inner ALIAS of the
	// enclosing type (`EChain`), a FIELD of it (`chain`), or a LOCAL this region bound to one — or
	// `EmptySourceText`. Three doors and one answer, so the static spelling and the instance spelling of the
	// same receiver cannot draw different edges.
	function nestedInstanceBaseOfNameAt(q TokenIndex, locals ByteArrayArray, localBases ByteArrayArray) returns ByteArray
		let name = self.tokenAt(q).value
		let fromAlias = self.signatures.nestedParameterisedInstanceBaseOfAlias(joinQualifiedName(self.enclosingType, member: name), readerFilePath: self.filePath)
		if not fromAlias.isEmpty() 'anInnerAlias'
			return fromAlias
		end 'anInnerAlias'

		let fromField = self.signatures.nestedParameterisedInstanceBaseOfField(self.enclosingType, fieldName: name)
		if not fromField.isEmpty() 'aFieldOfTheEnclosingType'
			return fromField
		end 'aFieldOfTheEnclosingType'

		for i in 0 upto locals.count() 'eachLocal'
			if (try locals.get(i) otherwise panic("nestedInstanceBaseOfNameAt: locals.get({i}) OOB below count {locals.count()}")).equals(name) 'hit'
				return try localBases.get(i) otherwise panic("nestedInstanceBaseOfNameAt: localBases.get({i}) has no row for a recorded local — the two columns are pushed in one act")
			end 'hit'
		end 'eachLocal'

		return EmptySourceText
	end 'nestedInstanceBaseOfNameAt'

	// ⭐ **DOES `var|let <name> = <a name denoting a nested parameterised instance>` BIND ONE (W161)?** — the
	// binding test that lets a call on a LOCAL draw the edge the field or alias it came from would.
	// `selfTypedLocalBoundAt`'s shape one receiver over, and it carries that function's stated
	// over-approximation for the same reason: the RHS is read as a NAME rather than typed, so
	// `var c = chain.somethingElse()` records `c` too. A local later reassigned, or recorded off a call
	// returning something else, only ever ADDS edges the fixpoint's own name filter may drop.
	function nestedInstanceLocalBaseAt(q TokenIndex, locals ByteArrayArray, localBases ByteArrayArray) returns ByteArray
		let kind = self.kindAt(q)
		if kind != TokenKind.var and kind != TokenKind.let 'notABinding'
			return EmptySourceText
		end 'notABinding'
		if self.kindAt(q + 1) != TokenKind.identifier or self.kindAt(q + 2) != TokenKind.equals 'notAPlainInitializer'
			return EmptySourceText
		end 'notAPlainInitializer'
		if not tokenCanBeAName(self.tokenAt(q + 3)) 'notANamedSource'
			return EmptySourceText
		end 'notANamedSource'

		return self.nestedInstanceBaseOfNameAt((q + 3) as TokenIndex, locals: locals, localBases: localBases)
	end 'nestedInstanceLocalBaseAt'

	// ⭐⭐ **A NAME DECLARED *AT* A NESTED PARAMETERISED INSTANCE HOLDS ONE TOO, AND NONE OF THE THREE NAME
	// DOORS COULD SEE IT (found at review).** `nestedInstanceBaseOfNameAt` resolves a receiver's own spelling
	// — an inner ALIAS, a FIELD of the enclosing type, a LOCAL bound by `var <n> = <name>`. A PARAMETER
	// (`probeVia(c EChain)`) is none of those, and neither is `var x as EChain`: the alias appears as the
	// TYPE of a declaration rather than as a value. So `c.slotSize()` drew no edge, the method reserved
	// nothing, and the call reached `ensureLayoutDescriptor` for an instance that can never have a blob —
	// **MEASURED at review, on this tip and on the merge base alike: `panic at LayoutDescriptor.maxon:571:
	// primitiveTypeByteSize: a `typeParameter`'s size is a runtime layout-descriptor read`**.
	//
	// It is recorded into the very columns the `var <n> = <name>` door writes, so a later `c.<m>(` draws
	// exactly the edge the field or alias it was declared from would — the same requirement that made those
	// three doors one predicate.
	//
	// ⚠ The shape is read off the TYPE token because that is the token the alias registry can answer for:
	// what precedes it is the declared name (`c EChain`) or `as` and the declared name (`x as EChain`).
	// Every other predecessor — `=`, `:`, `return`, `(`, `,` — is a USE of the alias, which the doors above
	// already own. The ALIAS spelling only: a parameter written as the inline `Inner with Element` is not
	// answered here, and reaches the same abort.
	function recordNestedInstanceDeclarationAt(q TokenIndex, locals ByteArrayArray, localBases ByteArrayArray)
		if q < 1 or not tokenCanBeAName(self.tokenAt(q)) 'notATypeSpellingWithRoomForAName'
			return
		end 'notATypeSpellingWithRoomForAName'

		var nameAt = (q - 1) as TokenIndex
		if self.kindAt(nameAt) == TokenKind.as 'theAsSpelling'
			if q < 2 'noRoomForItsName'
				return
			end 'noRoomForItsName'

			nameAt = (q - 2) as TokenIndex
		end 'theAsSpelling'
		if self.kindAt(nameAt) != TokenKind.identifier 'notADeclaration'
			return
		end 'notADeclaration'

		// Asked LAST: the two token tests above are comparisons and this one is two map lookups, and every
		// `<identifier> <identifier>` pair in every body reaches it.
		let base = self.signatures.nestedParameterisedInstanceBaseOfAlias(joinQualifiedName(self.enclosingType, member: self.tokenAt(q).value), readerFilePath: self.filePath)
		if base.isEmpty() 'namesNoNestedInstance'
			return
		end 'namesNoNestedInstance'

		locals.push(self.tokenAt(nameAt).value)
		localBases.push(base)
	end 'recordNestedInstanceDeclarationAt'

	// The `Array` declaration names, memoized per file off the roster anchor — see `arrayDeclarationRoster`.
	function arrayDeclarationNames() returns ByteArrayArray
		if self.arrayDeclarationRoster is sharedEmptySurfaceRoster 'firstAskInThisFile'
			self.arrayDeclarationRoster = self.signatures.arrayDeclarationNames()
		end 'firstAskInThisFile'

		return self.arrayDeclarationRoster
	end 'arrayDeclarationNames'

	// ⭐ **DOES THE TOKEN AT `q` END A PRIMARY EXPRESSION — i.e. does a `(` after it open a CALL rather than a
	// GROUPING (W41-opaque)?** The whole of how the signal walk tells `f(a, b)` from `(a, b)`. An identifier, a
	// literal, `self`/`Self` and a closing bracket can each be the thing being CALLED or INDEXED; a KEYWORD, an
	// operator, a comma or an opening bracket cannot, so a `(` after one of those opens a grouping.
	//
	// ⛔ **THE WIDE NAME TEST IS THE WRONG ONE HERE, AND USING IT MADE THE SIGNAL SEE NOTHING.**
	// `tokenCanBeAName` admits every keyword with a spelling (D8's keyword-named methods), so `return (k, v)`
	// — the exact shape this signal exists for — read as a call to `return` and detected no tuple at all
	// (MEASURED: all three `generic-opaque-value-store` cases refused for want of a descriptor nothing
	// reserved). A keyword therefore ends a primary expression only where it can be a METHOD NAME, which is
	// exactly "immediately after a `.`".
	//
	// A BARE sibling call to a keyword-named method (`to(a, b)` resolving to `self.to(a, b)`) is read as a
	// tuple and over-reserves a descriptor. That is the sound direction and the same one every sibling signal
	// takes: an unused parameter costs nothing, a missing one aborts the compiler.
	function tokenEndsAPrimaryExpression(q TokenIndex) returns bool
		let kind = self.kindAt(q)
		if kind == TokenKind.identifier 'plainName'
			return true
		end 'plainName'
		if kind == TokenKind.rightParen or kind == TokenKind.rightBracket or kind == TokenKind.rightBrace 'closesAValue'
			return true
		end 'closesAValue'
		if tokenIsLiteralKind(kind) 'literal'
			return true
		end 'literal'
		if kind == TokenKind.self or kind == TokenKind.selfType 'receiver'
			return true
		end 'receiver'

		return self.kindAt(q - 1) == TokenKind.dot and tokenCanBeAName(self.tokenAt(q))
	end 'tokenEndsAPrimaryExpression'

	// Is the token at `selfPos` the start of a `self.<method>(` call — the self-call the descriptor-need
	// fixpoint threads through? `self` `.` `<name>` `(`, four contiguous tokens — the tail asked through the
	// shared `memberCallFollows`, so a KEYWORD-named method (D8: `self.to(item)`) is a self-call here too, and
	// so this scan cannot come to disagree with the statement dispatchers about what a call looks like. Missed,
	// the forward edge is never collected and the fixpoint leaves the forwarder's own argument borrowed.
	function isSelfMethodCallAt(selfPos TokenIndex) returns bool
		return self.memberCallFollows(selfPos + 1)
	end 'isSelfMethodCallAt'

	// ⭐⭐ **DOES `var|let <name> = Self{` OR `var|let <name> = Self.<static>(` BIND A LOCAL OF THE ENCLOSING
	// TYPE? (W43b)** — the token shape that lets the descriptor-need fixpoint see a call on a `Self`-typed
	// LOCAL as the self-call it is. `stdlib/Map.maxon:58-68` is the program: `var result = Self{…}` then
	// `result.upsert(k, value: v)`, where `upsert` reads the layout descriptor. Without this the fixpoint gave
	// `Map.init` no descriptor to forward and `requireSelfForDescriptorForwarding` refused the call outright.
	//
	// ⛔ **IT IS A BINDING TEST AND DELIBERATELY NOT A RECEIVER-BLIND OVER-APPROXIMATION.** The sibling signals
	// above (`containerMoveOutMethodAt`, `arrayCopyMethodAt`) DO ignore the receiver, because over-reserving a
	// descriptor there is free. It is not free here: a STATIC that needs one and does not return `Self` is a
	// hard `E2015` (`staticLayoutNeedsSelfReturn` — a static has no descriptor source), so a receiver-blind
	// edge from a static whose inner-container method merely SHARES A NAME with a descriptor-needing sibling
	// would turn a legal program into a refused one. Reading the binding costs one name list and refuses nothing.
	//
	// A local later reassigned to something else only ever ADDS edges the fixpoint's own name filter may drop,
	// so the over-approximation that remains is in the sound direction.
	function selfTypedLocalBoundAt(q TokenIndex) returns bool
		let kind = self.kindAt(q)
		if kind != TokenKind.var and kind != TokenKind.let 'notABinding'
			return false
		end 'notABinding'
		if self.kindAt(q + 1) != TokenKind.identifier or self.kindAt(q + 2) != TokenKind.equals 'notAPlainInitializer'
			return false
		end 'notAPlainInitializer'
		if self.kindAt(q + 3) != TokenKind.selfType 'notSelfValued'
			return false
		end 'notSelfValued'
		return self.kindAt(q + 4) == TokenKind.leftBrace or self.memberCallFollows((q + 4) as TokenIndex)
	end 'selfTypedLocalBoundAt'

	// Is the token at `q` a `<name> Self` PARAMETER DECLARATION — the other way a name in this body denotes a
	// value of the enclosing type (W190)? See the walk's own arm for why an identifier followed by `Self` can
	// only be that, and for the compiler abort the missing edge produced.
	function selfTypedParamDeclaredAt(q TokenIndex) returns bool
		return self.kindAt(q) == TokenKind.identifier and self.kindAt((q + 1) as TokenIndex) == TokenKind.selfType
	end 'selfTypedParamDeclaredAt'

	// Is the token at `q` a `<local>.<method>(` call whose receiver `selfTypedLocalBoundAt` recorded — the
	// self-call the line above makes visible. The name list is a handful of locals per body, so a scan is what
	// it costs; `typeParamPositionOf` answers the same shape of question the same way.
	function selfTypedLocalCallAt(q TokenIndex, locals ByteArrayArray) returns bool
		if self.kindAt(q) != TokenKind.identifier or not self.memberCallFollows(q + 1) 'notAMemberCall'
			return false
		end 'notAMemberCall'
		let receiver = self.tokenAt(q).value
		for name in locals 'eachLocal'
			if name.equals(receiver) 'hit'
				return true
			end 'hit'
		end 'eachLocal'
		return false
	end 'selfTypedLocalCallAt'

	// Is the identifier at `q` a BARE call `<identifier>(` — followed by `(` and NOT preceded by a `.` (which
	// would make it the member of a `receiver.method(…)` or a qualified `Type.method(…)` call, neither of which
	// is a bare self-call)? The callee is the identifier itself. Used by the descriptor-need scan to treat an
	// implicit-self bare sibling call (#65) as the `self.method(…)` it lowers to.
	function isBareCallAt(q TokenIndex) returns bool
		return self.kindAt(q + 1) == TokenKind.leftParen and (q == 0 or self.kindAt(q - 1) != TokenKind.dot)
	end 'isBareCallAt'

	// Does the `function` keyword at `functionTok` carry a `static` modifier — the token IMMEDIATELY before it?
	// `[export] static function` is the only member shape (`export` precedes `static`; `parseTypeMember`), so the
	// token adjacent to `function` is exactly the modifier or not. THE one token-level answer to "is this a
	// receiver-less method?", shared by the descriptor sweep (`recordScannedSignature`) and the implicit-self
	// sibling walk (`ensureSiblingReceivers`, #65) so those two token scans cannot come to disagree about which
	// methods take `self`. The FORWARD twin is `parseTypeMember`'s `not isStatic`, which mints the actual
	// `SelfParamName` parameter every later reader recovers the fact from (`FuncSignature.takesReceiver`).
	function functionDeclIsStatic(functionTok TokenIndex) returns bool
		return functionTok > 0 and self.kindAt((functionTok - 1) as TokenIndex) == TokenKind.static
	end 'functionDeclIsStatic'

	// ⛔ **DOES A DECLARATION CARRYING `hasStaticModifier` TAKE A RECEIVER — the ONE place that conjunction is
	// spelled.** `static` alone does not answer it: a TOP-LEVEL function carries no modifier and takes no
	// receiver either, so the enclosing type has to be in the test. It is the fact both scans of a generic type's
	// methods align their per-parameter facts to — `recordScannedSignature` prepends `SelfParamName` at slot 0
	// iff this is true, and `feedScanParams` must prepend it in exactly the same cases or the transitive fixpoint
	// republishes a method's feeds one slot off its call site. Written twice, the two spellings agreed only
	// because `scanTypeMethodFeeds` runs where `enclosingType` is never empty — an accident of the caller, not a
	// property of the rule, and `callAlignedInstanceParams`' own header names the price of losing it (a feed that
	// fires on the wrong parameter, so a leak or a double-move).
	function declarationTakesReceiver(hasStaticModifier bool) returns bool
		return not self.enclosingType.isEmpty() and not hasStaticModifier
	end 'declarationTakesReceiver'

	// Is the identifier at `aliasPos` a member-level opaque-`T` CONTAINER alias being CONSTRUCTED — the
	// construction that seeds the descriptor need (P1.7 slice 3b-i)? `X` qualifies (`Container.X`) to a
	// whole-program generic alias naming an OPAQUE instance of a container whose `create` reads the enclosing
	// instance's layout descriptor — `Array with <type parameter>`, since S2u the fixed-size `Vector with <N>
	// <type parameter>` (whose create IS that same one plus the `__managed_resize` that publishes its slots),
	// and since W134 a `__ManagedList`/`List with <type parameter>` (a different runtime create reading the
	// same `destroyFunc@40` word). WHICH containers those are is
	// `ProgramSignatures.opaqueInstanceCreateReadsTheDescriptor`'s to say, for the reason that function
	// carries: asked separately here and at the emit, the two are free to disagree, and the disagreement is
	// a compiler panic. The opacity is read straight off
	// `self.signatures` — the SAME index and the SAME `containerElementIsOpaque` predicate `emitArrayCreateOp`
	// branches the descriptor-reading create on — so the reserved slot and the emitted read decide off ONE fact
	// and cannot diverge, whatever their token distance. The sweep has folded every inner alias before the real
	// parse reaches here, so the lookup is complete regardless of where the alias sits in the body (a
	// constructing method may textually precede it).
	//
	// ⚠ **BOTH SPELLINGS OF THE CONSTRUCTION SEED IT, AND MISSING ONE IS A COMPILER PANIC RATHER THAN A WRONG
	// ANSWER** (S2i, measured): the literal form was added to the parser and not to this scan, and
	// `Holder.create` writing `ElementArray{}` reached `appendOpaqueArrayCreate` with no descriptor parameter
	// reserved — *"the parser's descriptor-need seed and this lowering disagree"*, which is exactly what
	// happened. The two spellings are one construction (`parseInnerAliasLiteral` routes them to one producer),
	// so they are one shape test here.
	function opaqueContainerConstructionAt(aliasPos TokenIndex) returns bool
		if not self.aliasConstructionFollows(aliasPos) 'notAConstruction'
			return false
		end 'notAConstruction'
		let qualified = joinQualifiedName(self.enclosingType, member: self.tokenAt(aliasPos).value)
		if not self.signatures.isGenericAlias(qualified) 'notAlias'
			return false
		end 'notAlias'
		let giid = self.signatures.genericAliasInstanceFrom(qualified, readerFilePath: self.filePath)
		return self.signatures.opaqueInstanceCreateReadsTheDescriptor(giid) and self.signatures.containerElementIsOpaque(giid)
	end 'opaqueContainerConstructionAt'

	// ⭐ **THE `Self{…}` SPELLING OF THE CONSTRUCTION ABOVE (W57)** — a separate shape test because `Self` is a
	// KEYWORD and names no alias, so there is no qualified name to look an instance up by; the instance is the
	// enclosing declaration's own (`ProgramSignatures.ownRecordSelfInstance`). The opacity is read through the
	// SAME `containerElementIsOpaque` the sibling asks and `emitArrayCreateOp` branches on, so the reserved
	// slot and the emitted read still decide off one fact.
	//
	// ⚠ It deliberately does not require the literal to be EMPTY, though only the empty one creates
	// (`parseStructLiteral`'s `theEmptyContainer` arm; `Self{managed: m}` is the identity and needs no
	// descriptor). A `{` may be followed by a newline before its fields, so a token test for emptiness would
	// have to re-derive the field reader's whitespace rule — and the asymmetry the sibling signals state
	// applies here too: over-reserving costs one ignored parameter, missing one aborts the compiler.
	function opaqueSelfArrayConstructionAt(selfPos TokenIndex) returns bool
		if self.kindAt(selfPos + 1) != TokenKind.leftBrace 'notALiteral'
			return false
		end 'notALiteral'
		if not self.signatures.declarationsValueIsTheManagedRecord(self.enclosingType) 'notTheOwnRecordArray'
			return false
		end 'notTheOwnRecordArray'

		return self.signatures.containerElementIsOpaque(self.signatures.ownRecordSelfInstance(self.enclosingType))
	end 'opaqueSelfArrayConstructionAt'

	// ⭐⭐ **THE SAME LITERAL, ASKED FOR THE COUNT RATHER THAN FOR THE DESCRIPTOR (W190).** `Self{}` inside
	// `type Vector uses Element` is the construction `stdlib/Vector.maxon`'s `create()` IS, and a fixed-size
	// container's record is born with all of its slots published — so that literal owes a COUNT, which the
	// declaration's own countless `Self` cannot state and every call site can.
	//
	// ⚠ **IT IS A SECOND QUESTION ABOUT ONE SHAPE, NOT A SECOND COPY OF ONE QUESTION.** The sibling above
	// asks whether the construction reads the ELEMENT's layout descriptor and answers for `Array` as well;
	// this one asks whether it needs the INSTANCE's element count and is the sized container's alone. The two
	// slots are reserved by two independent columns of the same fixpoint, exactly as `W190`'s own header
	// argues they must be — a body that reads only the count carries no descriptor, and vice versa.
	//
	// ⭐ **BOTH SPELLINGS, for `countofOperandIsTheOwnInstanceAt`'s reason** — `Self` and the container's own
	// name denote the same countless instance, and a check filed against one of them would be narrower than
	// the fact it is about. Emptiness is deliberately NOT tested, on the sibling's stated ground: a `{` may be
	// followed by a newline before its fields, and over-reserving costs one ignored parameter where missing
	// one aborts the compiler.
	function ownRecordLiteralOfTheSizedContainerAt(headPos TokenIndex) returns bool
		if not self.signatures.isVectorBaseName(self.enclosingType) 'notTheSizedContainersOwnBody'
			return false
		end 'notTheSizedContainersOwnBody'
		if self.kindAt(headPos + 1) != TokenKind.leftBrace 'notALiteral'
			return false
		end 'notALiteral'

		let head = self.tokenAt(headPos)
		return head.kind == TokenKind.selfType or (head.kind == TokenKind.identifier and head.value.equals(self.enclosingType))
	end 'ownRecordLiteralOfTheSizedContainerAt'

	// The two TOKEN SHAPES that construct the container an alias at `aliasPos` names: the static call
	// `X` `.` `create` `(` and the literal `X` `{` (S2i). Read by the descriptor-need pre-scan, which runs
	// before any body is parsed and so has only tokens to go on; an identifier followed by `{` is a struct
	// literal and nothing else in this grammar, and the caller narrows it to an alias naming an opaque array
	// anyway — over-inclusion there only reserves a descriptor parameter nothing reads, which is sound.
	function aliasConstructionFollows(aliasPos TokenIndex) returns bool
		if self.kindAt(aliasPos + 1) == TokenKind.leftBrace 'literalForm'
			return true
		end 'literalForm'
		return self.kindAt(aliasPos + 1) == TokenKind.dot and self.kindAt(aliasPos + 2) == TokenKind.identifier and self.tokenAt(aliasPos + 2).value.equals(CreateMethod) and self.kindAt(aliasPos + 3) == TokenKind.leftParen
	end 'aliasConstructionFollows'

	// Is the token at `q` a `<receiver> . <method> (` call HEAD — a preceding `.` and a following `(`? The shared
	// shape of the receiver-blind array-method descriptor signals (`containerMoveOutMethodAt` / `arrayCopyMethodAt`):
	// it distinguishes an array method from a bare free call `pop(…)` without resolving the receiver, which the
	// pre-scan (running before the body is parsed) cannot do. Each caller pairs this shape with its own
	// method-name set.
	function isDotMethodCallHeadAt(q TokenIndex) returns bool
		return q != 0 and self.kindAt((q - 1) as TokenIndex) == TokenKind.dot and self.kindAt(q + 1) == TokenKind.leftParen
	end 'isDotMethodCallHeadAt'

	// Is the identifier at `q` the method name of a `<receiver> . pop/remove/removeFirst (` container MOVE-OUT
	// — the descriptor signal for an opaque element drop (P1.7 slice 3b-vi-a)? The RECEIVER is deliberately NOT
	// resolved: the pre-scan cannot tell whether it is `self.<opaque-field>`, a local bound to it, or an opaque
	// container parameter — every one of which reaches the same descriptor-gated `__drop_type_param` drop — so
	// ANY move-out is signalled and the caller reserves an (at worst unused, always sound) descriptor.
	// `get`/`first`/`last`/`value` BORROW and drop nothing, so they are not move-outs and are not matched.
	//
	// ⚠⚠ **THIS IS THE MOVE-**OUT** TWIN OF `isContainerMoveInMutator`, AND IT WAS NAMED FOR THE `Array` WHILE
	// ITS TWIN WAS NAMED FOR THE CONTAINER — WHICH IS EXACTLY HOW W134 SHIPPED A HALF-OPEN DOOR (W134 review).**
	// That rung admitted an opaque-`T` chain and widened the move-IN roster to the chain's four insertions, and
	// this set — one fact over, "which methods hand an element OUT across the container boundary" — kept the
	// two `Array` names it had. `__ManagedList.remove` was covered only by accident, because the `Array` spells
	// `remove` too; the `List` surface's `removeFirst` was not, so
	// `let gone = try self.chain.removeFirst()` in a shared generic body — a legal program, and the exact twin
	// of the `self.arr.pop()` that compiles — reserved no descriptor and was REFUSED by
	// `requireDescriptorForOpaqueDrops` with a sentence naming three shapes, none of them its own. MEASURED
	// both ways: refused with `removeFirst` alone in the body, correct (exit 0, nothing leaked) as soon as an
	// unrelated `EChain.create()` in the same body happened to reserve the descriptor — so the machinery was
	// whole and only this roster was short. It is named for the CONTAINER now, so the next surface that grows
	// a move-out is asked about here rather than silently omitted.
	//
	// ⭐ **`removeLast` IS THAT NEXT SURFACE, AND IT ARRIVED AS PREDICTED** (spec-port `list`). It hands an
	// element out across the container boundary exactly as `removeFirst` does, so a
	// `let gone = try self.chain.removeLast()` in a shared generic body reserves its descriptor here. ⚠ `remove`
	// needs no second entry: the `List` dispatcher matches the very same `RemoveMethod` constant the `Array` and
	// the `__ManagedList` do — one byte string, one arm — which is this file's method-name rule paying off
	// rather than the coincidence the paragraph above had to call it when only the `Array` spelled it.
	// `get`/`first`/`last`/`isEmpty`/`count` BORROW or read and drop nothing, so they stay off the list.
	function containerMoveOutMethodAt(q TokenIndex) returns bool
		if not self.isDotMethodCallHeadAt(q) 'notMethodCall'
			return false
		end 'notMethodCall'
		let name = self.tokenAt(q).value
		return name.equals(ArrayPopMethod) or name.equals(RemoveMethod) or name.equals(ListRemoveFirstMethod) or name.equals(ListRemoveLastMethod)
	end 'containerMoveOutMethodAt'

	// Is the identifier at `q` the method name of a `<receiver> . slice/clone/append (` array COPY — the
	// descriptor signal for an OPAQUE array copy (P1.7 slice 3b-vi-b-β)? A preceding `.` and a following `(`
	// distinguish the array method from a bare free call; the RECEIVER is deliberately NOT resolved (the pre-scan
	// runs before the body is parsed), so ANY copy is signalled and the caller reserves an (at worst unused,
	// always sound) descriptor. Shares `isDotMethodCallHeadAt` with `containerMoveOutMethodAt`, over the COPY names.
	//
	// ⚠ **`clone` STAYED ON THIS LIST AFTER ARRH TOOK IT OFF THE `Array` ROSTER, and the two lists ask different
	// questions.** A roster says what the SURFACE serves; this says what a body might have to reserve a descriptor
	// FOR. Since ARRH an `arr.clone()` performs its copy inside `stdlib/Array.maxon`'s body rather than in the
	// function that wrote it, so naming it here is over-approximate — which is the direction this pre-scan is
	// built to err in, the other one being a MISSING descriptor. `String.clone()` and a user `clone()` spell the
	// name too, and this resolves no receiver for either.
	function arrayCopyMethodAt(q TokenIndex) returns bool
		if not self.isDotMethodCallHeadAt(q) 'notMethodCall'
			return false
		end 'notMethodCall'
		let name = self.tokenAt(q).value
		return name.equals(SliceMethod) or name.equals(CloneMethodName) or name.equals(AppendMethod)
	end 'arrayCopyMethodAt'

	// ⭐ Is the identifier at `q` the method name of a container MOVE-IN — the descriptor signal for a BORROWED
	// opaque element store (W60)? Like its two siblings above it resolves no RECEIVER, for
	// the reason they do not: the pre-scan runs before any body is parsed, and the container owns its element
	// wherever the container lives (`markOpaqueContainerMutatorFeeds` states that argument in full). It reads the
	// ONE move-in name set (`isContainerMoveInMutator`), so "which methods take ownership of an element" cannot
	// come to mean two things between the feed sweep and this reservation.
	//
	// ⚠ **IT ASKS FOR A CALL HEAD AND NOT FOR `isDotMethodCallHeadAt`, WHICH BOTH SIBLINGS DO — because the
	// BARE spelling is a store too.** Implicit self resolves `push(v)` to `self.push(v)` and that is the same
	// store (`stdlib/Array.maxon`'s `appendMemory` is written exactly that way), so a dot-only test would leave
	// that body with no descriptor to take its reference through. The union of the dotted head and the bare one
	// is just "a `(` follows", so it is spelled as the one condition it is rather than as two that cover
	// everything. A bare `push(…)` that is a FREE function reserves a parameter nothing reads, which is this
	// whole family's stated asymmetry.
	function containerMoveInMutatorCallAt(q TokenIndex) returns bool
		return self.kindAt(q + 1) == TokenKind.leftParen and self.isContainerMoveInMutator(self.tokenAt(q).value)
	end 'containerMoveInMutatorCallAt'

	// ⛔⛔ **THE SOURCE MUST BE THE BARE RECEIVER, AND THAT IS THE WHOLE OF WHY THIS SIGNAL DOES NOT LIFT
	// THE LOAD-BEARING REFUSAL (W159).** `for … in self` walks the enclosing instance itself, whose protocol
	// calls are DIRECT (`emitDeclaredProtocolCall`) — the conformer is this very type, so the descriptor the
	// loop's drop reads is the one the method already carries. Every OTHER source may be a value held at a
	// PARAMETERIZED INTERFACE or at a `where`-constrained type parameter, whose protocol calls are WITNESS
	// DISPATCHES through a table that carries no dictionary at all; that shape is what
	// `requireDescriptorForOpaqueDrops` refuses, and its measured cost is `0xC0000005`. The pre-scan runs
	// before any body is parsed and cannot resolve a receiver, so `self` — the one spelling that can never be
	// an existential — is the discriminator.
	//
	// ⚠ **`self.item` IS SUCH A SOURCE, AND TESTING ONLY THE `self` TOKEN CAUGHT IT.** MEASURED on the way
	// here: `for v in self.item` inside `type Wrap uses T where T is Seq`
	// (`specs-shv2/for-in-existential.md`'s `existential.constrained-type-parameter`) reserved a descriptor
	// and moved that case's emitted code — a witness-dispatched loop given a slot it must not have. So the
	// test is positive: what follows `self` is the loop's own LABEL or the end of the line, and nothing else.
	function forStatementWalksBareReceiverAt(forPos TokenIndex) returns bool
		var q = (forPos + 1) as TokenIndex
		while self.kindAt(q) != TokenKind.newline and self.kindAt(q) != TokenKind.eof 'toTheSource'
			if self.kindAt(q) != TokenKind.in 'notTheSourceYet'
				q = q + 1
				continue
			end 'notTheSourceYet'

			if self.kindAt(q + 1) != TokenKind.self 'someOtherSource'
				return false
			end 'someOtherSource'

			// A block label is a `charLiteral` (`skipOptionalLabel`); a bodiless line ends at the newline.
			return self.kindAt(q + 2) == TokenKind.charLiteral or self.kindAt(q + 2) == TokenKind.newline
		end 'toTheSource'
		return false
	end 'forStatementWalksBareReceiverAt'

	// ⭐⭐ **DOES A `for … in self` IN A BODY OF THIS TYPE HAND OUT AN OPAQUE ELEMENT (W159)?** The element
	// is `current()`'s result, and the CURSOR it is called on is whatever this type's `createIterator()`
	// returns — or this type itself, when it declares the cursor protocol directly and the loop walks it with
	// no factory (`ProgramSignatures.declaresCursorProtocol`). So the answer is two declared returns deep, and
	// it decides a reservation rather than merely widening one: a shared generic body whose cursor yields the
	// enclosing type's own parameter owes a `__drop_type_param` per trip, and one whose cursor yields anything
	// else owes nothing at all.
	//
	// ⛔⛔ **IT IS A NARROWING THAT IS LOAD-BEARING, NOT A TIDY-UP — MEASURED.** `stdlib/Map.maxon`'s cursor
	// yields the tuple `Entry`, so `Map.map`'s per-trip element is concrete and no descriptor is owed. Seeded
	// anyway, `Map.map` gains a slot, and `LowerMaxonToStd.emitInstanceDescriptorAddr` then FORWARDS a real descriptor
	// into a `MapIterator with (Key, Value)` chain whose own header records that it is deliberately inert on
	// both ends — *"forwarding a real descriptor into half of such a chain would make the retains fire while
	// the drops still read the mint"*. **MEASURED: `interface-extensions/stdlib-map-on-map-with-function`
	// exits 101 where 6 is correct.** So over-reserving is NOT free for this signal, which is exactly why it
	// asks about the element instead of about the loop.
	//
	// ⚠ **NOT `StructLayout.bindingsForInterface("Iterable")`, WHICH IS THE OBVIOUS KEY AND IS THE WRONG
	// ONE** — it answers only when the type names that interface LAST, so `implements Iterable with (…),
	// Printable` would silently answer nothing, and it would be a SECOND derivation of the element disagreeing
	// with the declaration whenever the two drift. `extensionElementTransformHint` measured that one door
	// over. A callee's own declared return cannot drift from the callee.
	//
	// ⚠ It is asked of the DECLARATIONS and not of the tokens for `calleeReturnsBareTypeParameter`'s reason:
	// an inner alias may NAME the parameter, and the loop's own calls are emitted by the compiler and appear
	// in no token this scan could read.
	function receiverCursorElementIsOpaque(typeName ByteArray) returns bool
		match self.signatures.returnTypeOf(qualifiedMethodName(typeName, methodName: CreateIteratorMethodName), into: self.artifact.typeNames) 'factory'
			declared(returnType) then return self.cursorReturnYieldsOpaqueElement(returnType)
			undeclared then break 'factory'
		end 'factory'

		// No factory: the loop walks `self` AS the cursor, so `current()` is this type's own.
		return self.signatures.calleeReturnsBareTypeParameter(qualifiedMethodName(typeName, methodName: CurrentMethodName))
	end 'receiverCursorElementIsOpaque'

	// The `value`/`void` split of the factory's declared return — unwrapped a level at a time because a
	// `match` arm holds one statement, `mappedArrayElementHint`'s shape for its reason.
	function cursorReturnYieldsOpaqueElement(returnType MaxonReturnType) returns bool
		match returnType 'returned'
			value(cursor) then return self.cursorTypeYieldsOpaqueElement(cursor)
			void then return false
		end 'returned'
	end 'cursorReturnYieldsOpaqueElement'

	// A factory returning something that names no aggregate declares no `current()` to ask about — the loop
	// over such a source is refused by `materializeIterableIterationSource` with a position long before any
	// descriptor is owed.
	function cursorTypeYieldsOpaqueElement(cursor MaxonType) returns bool
		if not self.signatures.tagMayNameAggregate(maxonTypeTag(cursor)) 'notANamedCursor'
			return false
		end 'notANamedCursor'

		// `localTypeName`, because `returnTypeOf` ADOPTED the cursor type into this artifact's interner — so
		// the id is one this table holds, which is exactly that helper's precondition.
		//
		// ⭐⭐ **THROUGH `denotedGenericBaseName`, BECAUSE A CURSOR HAS TWO SPELLINGS AND ONLY ONE OF THEM IS A
		// TYPE'S OWN NAME (W172).** `returns BagIterator` names the declaring type; `returns BagIter`, on a
		// `typealias BagIter = BagIterator with Element`, names an ALIAS, under which no `current()` is filed —
		// so the unresolved question answered `false`, no descriptor was reserved, and the loop's own drop was
		// then refused at `stdlib/Interfaces.maxon`. The corpus writes it the second way
		// (`stdlib/List.maxon:147`, `Set.maxon:15`, `Array.maxon:502`, `Vector.maxon:8`); `stdlib/Map.maxon:18`
		// writes it the first. See there for why the resolution is deliberately ungated.
		let cursorTypeName = self.signatures.denotedGenericBaseName(self.localTypeName(cursor, asker: "cursorTypeYieldsOpaqueElement"), readerFilePath: self.filePath)
		return self.signatures.calleeReturnsBareTypeParameter(qualifiedMethodName(cursorTypeName, methodName: CurrentMethodName))
	end 'cursorTypeYieldsOpaqueElement'

	// ⭐ **THE `self . <field> =` REASSIGNMENT HEAD — ONE token-shape recognizer (P1.7 Finding A).** Both the
	// descriptor-need scan (`opaqueFieldReassignAt`, real parse) and the sweep feed (`markOpaqueFieldReassignFeed`,
	// pre-layout) must agree on what OPENS a self field reassignment, or one enrolls the reassigned parameter owned
	// while the other fails to reserve the method's layout descriptor — an owned value then drops through a
	// `__drop_type_param` whose descriptor was never reserved, a fault. So the three tokens after `self` — `.`
	// `<ident>` `=` — are recognized in ONE place, ~240 lines from the other caller; each caller adds only its own
	// tail (the scan checks the field's managed-ness, the feed checks the RHS is a bare type-parameter parameter).
	// `self` is never a value, so a match here is always a field WRITE head, and the trailing `=` separates it from
	// a `self.<field>` READ (`x = self.saved`) and from a nested `self.a.b = …` (a `.`, not `=`, follows the field).
	function fieldReassignHeadAt(selfPos TokenIndex) returns bool
		return self.kindAt(selfPos + 1) == TokenKind.dot and self.kindAt(selfPos + 2) == TokenKind.identifier and self.kindAt(selfPos + 3) == TokenKind.equals
	end 'fieldReassignHeadAt'

	// Is the token at `selfPos` the start of a `self.<field> = ` REASSIGNMENT of a bare opaque type-parameter
	// field that some instantiation makes MANAGED (P1.7 Finding A)? The `self . <ident> =` head is recognized by
	// the shared `fieldReassignHeadAt`; here the `<ident>` must additionally be a `typeParameter` field of the
	// enclosing generic type with a managed instantiation (`isManagedOpaqueTypeParamField`). Only such a
	// reassignment drops the field's old opaque value through `__drop_type_param`, so it is what reserves the
	// layout descriptor — the field-STORE twin of `containerMoveOutMethodAt`'s move-out call. Runs in the real parse
	// (`Queries.foldDescriptorNeeds`, after the whole-program sweep), so the layout AND the instance registry the
	// managed-ness gate reads are complete.
	function opaqueFieldReassignAt(selfPos TokenIndex) returns bool
		if not self.fieldReassignHeadAt(selfPos) 'notReassignShape'
			return false
		end 'notReassignShape'
		return self.signatures.isManagedOpaqueTypeParamField(self.enclosingType, fieldName: self.tokenAt(selfPos + 2).value)
	end 'opaqueFieldReassignAt'

	// Is the `sizeof` at `sizeofPos` a `sizeof(<typeParam>)` — the 4 contiguous tokens `sizeof ( ident )`
	// whose identifier names an enclosing type parameter? `parseSizeof` consumes exactly this shape with no
	// newline tolerance, so matching it token-for-token keeps the pre-scan and the real parse in lockstep.
	function sizeofOperandIsTypeParamAt(sizeofPos TokenIndex) returns bool
		if self.kindAt(sizeofPos + 1) != TokenKind.leftParen 'noOpen'
			return false
		end 'noOpen'
		if self.kindAt(sizeofPos + 2) != TokenKind.identifier 'notIdent'
			return false
		end 'notIdent'
		if self.kindAt(sizeofPos + 3) != TokenKind.rightParen 'noClose'
			return false
		end 'noClose'
		return self.typeParamPositionOf(self.tokenAt(sizeofPos + 2).value) < self.enclosingTypeParams.count()
	end 'sizeofOperandIsTypeParamAt'

	// Is the `countof` at `countofPos` a `countof(<the enclosing declaration's own instance>)` — the 4
	// contiguous tokens `countof ( Self )`, or the same with the type's OWN NAME in place of the keyword
	// (W190)? `parseCountof` consumes exactly this shape with no newline tolerance, so matching it
	// token-for-token keeps the pre-scan and the real parse in lockstep — `sizeofOperandIsTypeParamAt`'s
	// contract, unchanged.
	//
	// ⭐ **BOTH SPELLINGS, BECAUSE `parseTypeReference` ANSWERS THE SAME TYPE FOR BOTH.** `Self` and the
	// enclosing type's own name both reach `enclosingSelfType`, which for a container whose record the
	// compiler owns is `ownRecordSelfInstance` — the countless instance whose count only the caller can
	// supply. A check filed against one spelling would be narrower than the fact it is about.
	//
	// ⚠ **AN OPERAND THIS CANNOT SEE IS A POSITIONED REFUSAL, NOT A COMPILER ABORT**, which is the one place
	// `countof`'s door is stronger than `sizeof`'s: `parseCountof` gates the read on the slot ACTUALLY being
	// reserved, so a spelling that reaches the read without passing here (an inner `typealias` naming the
	// countless instance) is refused with a line and a column rather than reaching the lowering's panic.
	//
	// ⛔ **AND IT ASKS WHETHER THE ENCLOSING TYPE IS THE SIZED CONTAINER, WHICH IS A NARROWING AND NOT AN
	// OVER-APPROXIMATION.** The sibling signals may over-match freely because an unread descriptor parameter
	// costs one slot; this one may not, because a reservation ALSO drags in `staticLayoutNeedsSelfReturn` —
	// so a `countof(Self)` inside an ordinary generic's `static function f() returns Int`, which
	// `parseCountof` refuses as *"a type that states no element count"*, would instead be refused for
	// failing to return `Self`: a diagnostic about the wrong thing entirely. The narrowing cannot
	// UNDER-match, which is the direction that aborts the compiler: `enclosingSelfType` yields a countable
	// instance for exactly the names this admits, so every operand the parse serves passes here first.
	function countofOperandIsTheOwnInstanceAt(countofPos TokenIndex) returns bool
		if not self.signatures.isVectorBaseName(self.enclosingType) 'notTheSizedContainersOwnBody'
			return false
		end 'notTheSizedContainersOwnBody'
		if self.kindAt(countofPos + 1) != TokenKind.leftParen 'noOpen'
			return false
		end 'noOpen'
		if self.kindAt(countofPos + 3) != TokenKind.rightParen 'noClose'
			return false
		end 'noClose'

		let operand = self.tokenAt(countofPos + 2)
		if operand.kind == TokenKind.selfType 'theSelfKeyword'
			return true
		end 'theSelfKeyword'

		return operand.kind == TokenKind.identifier and operand.value.equals(self.enclosingType)
	end 'countofOperandIsTheOwnInstanceAt'

	// Is the innermost OPEN bracket a `{` (a struct literal)? The stack's top decides whether a `:` is a
	// struct-field separator (yes) or a labelled call argument's (no).
	function braceStackInnermostIsBrace(braceStack BoolArray) returns bool
		if braceStack.count() == 0 'empty'
			return false
		end 'empty'
		return try braceStack.get(braceStack.count() - 1) otherwise panic("braceStackInnermostIsBrace: get OOB on non-empty stack")
	end 'braceStackInnermostIsBrace'

	// The parameter index of the VALUE that follows a struct-field `:` at `colonPos`, or `paramNames.count()`
	// (a non-parameter) when the value is not a bare parameter reference. The value runs to the field's `,`
	// or the literal's `}`; surrounding parens are stripped (matching `rhsWasBareLocalReference`), so
	// `f: p`, `f: (p)` and `f: ((p))` all name `p`, while `f: p + 1`, `f: g(p)` and `f: q.x` name none.
	function consumedParamAfterColon(colonPos TokenIndex, paramNames ByteArrayArray) returns ParamCount
		var q = colonPos + 1
		var opens = 0
		while self.kindAt(q) == TokenKind.leftParen 'stripOpen'
			opens = opens + 1
			q = q + 1
		end 'stripOpen'

		// ⚠ **A PARAMETER'S NAME MAY BE A KEYWORD (D8), SO THE REFERENCE TO IT IS ONE TOO** — asked through
		// `tokenCanBeAName` and not `== identifier`. MEASURED before this: `Self{value: from}` inside
		// `static function create(from T)` on a `Box uses T` instantiated `with String` recorded NO consume,
		// so the caller kept its +1 while the box also owned it — `StrBox.create(msg)` SEGFAULTED on a
		// double free, where the identical program spelling the parameter `v` ran. Widening claims nothing
		// extra: the name is looked up in `paramNames` below, and a keyword that names no parameter is
		// dropped exactly as an unrelated identifier is.
		if not tokenCanBeAName(self.tokenAt(q)) 'notAName'
			return paramNames.count()
		end 'notAName'
		let idx = self.paramIndexIn(paramNames, name: self.tokenAt(q).value)
		if idx >= paramNames.count() 'notParam'
			return paramNames.count()
		end 'notParam'
		q = q + 1

		var closes = 0
		while self.kindAt(q) == TokenKind.rightParen and closes < opens 'stripClose'
			closes = closes + 1
			q = q + 1
		end 'stripClose'
		if closes != opens 'unbalanced'
			return paramNames.count()
		end 'unbalanced'

		// The value must END here — the next token is the field separator `,` or the literal close `}`.
		// Anything else (`+`, `.`, `(`) means the parameter was READ inside a larger expression, not moved.
		if self.kindAt(q) == TokenKind.comma or self.kindAt(q) == TokenKind.rightBrace 'bareMove'
			return idx
		end 'bareMove'
		return paramNames.count()
	end 'consumedParamAfterColon'

	// The index of `name` in `paramNames`, or `paramNames.count()` when absent — the linear-scan door the
	// consume scan maps a value token back to a parameter position through.
	function paramIndexIn(paramNames ByteArrayArray, name ByteArray) returns ParamCount
		for i in 0 upto paramNames.count() 'each'
			let paramName = try paramNames.get(i) otherwise panic("paramIndexIn: paramNames.get OOB at {i}")
			if paramName.equals(name) 'match'
				return i
			end 'match'
		end 'each'
		return paramNames.count()
	end 'paramIndexIn'

	// ⭐⭐ **MARK EACH BARE TYPE-PARAMETER ARGUMENT of a `<receiver> . push/set/insert ( … )` CALL AS A
	// CALLEE-STORAGE FEED (P1.7 slice 3b-iii, W10)**, returning whether any was marked. Cursor `mutatorPos` is the
	// method-name token. `paramNames`/`typeParamPositions` are CALL-ALIGNED (self at slot 0 for an instance
	// method), so a feed lands at the argument's own call-site position. Only a BARE type-parameter argument is
	// fed (a `push`'s sole positional argument, a `set`/`insert`'s labelled `value:` element); an index
	// expression, a chain or a `value` label token is not.
	//
	// ⚠⚠ **THE RECEIVER IS DELIBERATELY NOT RESOLVED, AND THAT IS THE W10 FIX.** It used to demand a literal
	// `self . <field> .` head, which recognized ONE of the spellings of one store: `items.push(item)` (implicit
	// self — the SAME store, #65 resolves the bare field read to `self.items`) and `xs.push(first)` (a local
	// array a static then hands to the `Self` it returns) were both invisible, and an unrecognized feed hands the
	// array a BORROW the concrete call site never transferred — freed by the array's one-shot element drop and by
	// nobody else, which is `0xC0000005` on an `.rdata` literal and a double free on a heap record.
	//
	// **What makes receiver-blindness SOUND is that the array owns its element wherever the array lives** — the
	// `__managed_decref` walk destroys each element exactly once whether the array is a field of `self`, a local, or
	// a parameter — which is the same reason `containerMoveOutMethodAt` and `arrayCopyMethodAt` (the two descriptor
	// signals right above) resolve no receiver either.
	//
	// ⚠ **A NON-ARRAY RECEIVER CAN REACH HERE, and the predecessor's header claimed it could not** (*"no
	// NON-array field can type-check a bare type-parameter element through push/set/insert"*). A user generic
	// type may declare its own `push(x T)`, and MEASURED: one that merely BORROWS its argument marks that
	// argument a feed here, which enrols it owned in a callee that never moves it. Ownership still BALANCES — the
	// enrolled parameter is released once at the method's exit — but that release is
	// `__drop_type_param`, which needs a layout descriptor a straight-line body reserves none of. That
	// disagreement is caught and REFUSED once the body is emitted (`requireDescriptorForOpaqueDrops`); it is not
	// swallowed here, because nothing at sweep time can resolve the receiver's type.
	function markOpaqueContainerMutatorFeeds(mutatorPos TokenIndex, paramNames ByteArrayArray, typeParamPositions TypeParamPositionArray, feeds TypeParamFeedArray) returns bool
		if not self.isDotMethodCallHeadAt(mutatorPos) or not tokenCanBeAName(self.tokenAt(mutatorPos)) 'notMethodCall'
			return false
		end 'notMethodCall'
		if not self.isContainerMoveInMutator(self.tokenAt(mutatorPos).value) 'notMoveInMutator'
			return false
		end 'notMoveInMutator'

		var any = false
		for arg in self.bareTypeParamArgsIn((mutatorPos + 2) as TokenIndex, paramNames: paramNames, typeParamPositions: typeParamPositions) 'eachArg'
			setParamFeed(feeds, index: arg.paramIndex, feed: TypeParamFeed.feeds(self.paramTypeParamPositionAt(typeParamPositions, index: arg.paramIndex), sink: FeedSink.calleeStorage))
			any = true
		end 'eachArg'
		return any
	end 'markOpaqueContainerMutatorFeeds'

	// ⭐ **THE BARE TYPE-PARAMETER ARGUMENTS of ONE call's argument list**, whose first argument token is at
	// `argsStart` (just past the `(`). An argument qualifies when it is the WHOLE of its argument slot
	// (`isBareArgValueAt` — so an index expression, a `.`-chain hop and a label token are all excluded), names a
	// caller parameter, and that parameter is type-parameter-typed (a plain-typed one cannot BE a feed). Nested
	// parens are tracked so only top-level arguments are considered.
	//
	// A parameter's name may be a KEYWORD (D8), so the bare reference to it is one too — read through
	// `tokenCanBeAName`, `consumedParamAfterColon`'s rule and for its measured reason (a missed feed leaves the
	// concrete call site BORROWING a managed argument the owner then destroys).
	function bareTypeParamArgsIn(argsStart TokenIndex, paramNames ByteArrayArray, typeParamPositions TypeParamPositionArray) returns BareTypeParamArgArray
		var found = BareTypeParamArgArray.create()
		var depth = 1
		var p = argsStart
		while depth > 0 and self.kindAt(p) != TokenKind.eof 'args'
			let kind = self.kindAt(p)
			if kind == TokenKind.leftParen 'openNested'
				depth = depth + 1
			end 'openNested' else 'notOpen'
				if kind == TokenKind.rightParen 'closeArg'
					depth = depth - 1
				end 'closeArg' else 'notClose'
					if depth == 1 and tokenCanBeAName(self.tokenAt(p)) and self.isBareArgValueAt(p) 'candidate'
						let idx = self.paramIndexIn(paramNames, name: self.tokenAt(p).value)
						if idx < paramNames.count() and self.paramIsTypeParamTyped(typeParamPositions, index: idx) 'typeParamArg'
							found.push(BareTypeParamArg.create(idx, valuePos: p))
						end 'typeParamArg'
					end 'candidate'
				end 'notClose'
			end 'notOpen'
			p = p + 1
		end 'args'
		return found
	end 'bareTypeParamArgsIn'

	// ⭐ **`self.<opaqueField> = param` — REASSIGNING A BARE OPAQUE-`T` FIELD IS A FEED (P1.7 Finding A).** A
	// generic instance method that reassigns a bare type-parameter field of `self` from a type-parameter argument
	// MOVES that argument into the field, whose opaque content the enclosing instance OWNS (its
	// `__destruct_<instance>` cascade, or the shared body's `__drop_type_param` on the next reassign, drops it).
	// The shared body cannot see the field's managed-ness — it is opaque here — so the parameter is recorded as a
	// FEED of the type parameter it fills, exactly like a `Self{field: v}` construction feed or a
	// `self.items.push(item)` array feed, and the CONCRETE call site consumes it iff that instance's argument owns
	// managed heap (`Box with String`) and borrows it otherwise (`Box with SmallInt`, byte-identical). Without
	// this the caller would BORROW the managed argument the box then destroys — a double-free (`0xC0000005`), the
	// field-store twin of the array-feed hole `recordTransitiveArrayFeeds` closes. The head test recognises
	// `self . <field> = <param>` where the RHS is a bare type-parameter parameter.
	function markOpaqueFieldReassignFeed(selfPos TokenIndex, paramNames ByteArrayArray, typeParamPositions TypeParamPositionArray, feeds TypeParamFeedArray) returns bool
		// The field's opacity is NOT queried here: this runs in the SWEEP, before the struct layouts are merged
		// into `self.signatures` (exactly why `markOpaqueContainerMutatorFeeds` is purely token-based too). It need
		// not be — a type-parameter argument can be assigned ONLY to a type-parameter (opaque) field, so a bare
		// type-parameter RHS on a `self.<field> =` write IMPLIES the field is opaque; any non-opaque target is a
		// type error the real parse rejects before this feed can matter. The precise opacity + managed-ness check
		// lives in the descriptor scan (`opaqueFieldReassignAt`) and the emit (`emitOpaqueFieldReassign`), which
		// run in the real parse where the layout is known — the two agree on a valid program, and disagree only
		// on one the real parse already refuses.
		// The RHS is a PARAMETER reference, whose name may be a KEYWORD (D8) — `tokenCanBeAName`, for
		// `consumedParamAfterColon`'s measured reason. The FIELD name (`selfPos + 2`, inside
		// `fieldReassignHeadAt`) stays an identifier: a field DECLARATION admits no keyword.
		if not self.fieldReassignHeadAt(selfPos) or not tokenCanBeAName(self.tokenAt(selfPos + 4)) 'notReassignShape'
			return false
		end 'notReassignShape'
		// The RHS must be JUST the parameter — a `.`/`(` after it would make it `next.x`/`next(...)`, a type error
		// on an opaque value the parse rejects, but excluded here so no larger expression is misread as a move.
		if self.kindAt(selfPos + 5) == TokenKind.dot or self.kindAt(selfPos + 5) == TokenKind.leftParen 'notBareMove'
			return false
		end 'notBareMove'
		let idx = self.paramIndexIn(paramNames, name: self.tokenAt(selfPos + 4).value)
		if idx >= paramNames.count() or not self.paramIsTypeParamTyped(typeParamPositions, index: idx) 'notTypeParamArg'
			return false
		end 'notTypeParamArg'
		setParamFeed(feeds, index: idx, feed: TypeParamFeed.feeds(self.paramTypeParamPositionAt(typeParamPositions, index: idx), sink: FeedSink.calleeStorage))
		return true
	end 'markOpaqueFieldReassignFeed'

	// The container mutators that MOVE an element in, all of which transfer ownership of that element to the
	// container (P1.7 slice 3b-iii): the `Array`'s `push` (its sole argument) and `set` / `insert` (their
	// labelled `value:` argument), and the CHAIN's four (W134) — `append` / `prepend` on the `List` surface,
	// `insertFirst` / `insertLast` on the `__ManagedList` one, each taking the element as its sole argument.
	// `reserve`/`resize`/`clear` take no element, so none feeds.
	//
	// ⚠ **`append` IS ALSO AN `Array` METHOD, WHERE IT BORROWS ANOTHER ARRAY RATHER THAN MOVING AN ELEMENT —
	// AND SHARING THE NAME COSTS NOTHING, BECAUSE BOTH READERS ASK A SECOND QUESTION THE ARRAY'S ANSWERS NO.**
	// `markOpaqueContainerMutatorFeeds` marks only a BARE TYPE-PARAMETER argument, and `xs.append(other)` hands
	// over an `Array with T`, never a `T`; `containerMoveInMutatorCallAt` reserves a descriptor parameter this
	// family is explicitly allowed to over-reserve. What the shared name may NOT do is go missing, which is the
	// other direction: a chain insert with no descriptor is a refused legal program.
	//
	// ⚠ **`insert` STAYS HERE THOUGH IT LEFT THE ROSTER (ARR1), AND THAT IS THE SAME SPLIT `clone` KEEPS ONE
	// SWEEP UP** (`arrayCopyMethodAt`): a roster says which surface shv2 SERVES, and this asks what a method
	// DOES to its element. A corpus-served `insert` still takes ownership, so a body forwarding its own `T` to
	// `self.items.insert(i, value: item)` still owes a descriptor to take that reference through — and this
	// pre-scan resolves no receiver, so it is over-approximate BY DESIGN and errs toward reserving one. The
	// other direction is a MISSING descriptor, which is a fault.
	function isContainerMoveInMutator(name ByteArray) returns bool
		return name.equals(ArrayPushMethod) or name.equals(ArraySetMethod) or name.equals(InsertMethod) or self.isChainMoveInMutator(name)
	end 'isContainerMoveInMutator'

	// The chain's four END insertions, split out because they are the ones whose receiver is a
	// `List`/`__ManagedList` and because the two SURFACES spell the same act differently — `append`/`prepend`
	// link an element the caller never sees again, `insertFirst`/`insertLast` link it and hand back the node
	// handle. What both surfaces share is the only thing this asks: the chain becomes the element's sole owner,
	// released once by `element_drop@24` (`ListRuntime.maxon`), exactly as an array slot is by
	// `element_destroy@40`.
	//
	// ⚠ **`List.insert` IS A FIFTH CHAIN MOVE-IN AND IS DELIBERATELY NOT NAMED HERE (spec-port `list`)** — it
	// is covered by the caller's own `InsertMethod` arm, which it matches on the very same constant. ⭐ **But
	// it is covered for a DIFFERENT REASON than the one the header above states for that arm**, and the
	// difference is worth writing down: that paragraph justifies `insert`'s presence as an over-approximation
	// for a CORPUS-SERVED `Array.insert` whose body takes ownership out of sight. `List.insert` is
	// compiler-emitted, and its ownership is not an approximation at all — `parseArraySet` calls
	// `moveElementIntoContainer` at the parse, so the chain provably becomes the owner and the descriptor is
	// provably owed. ⇒ The shared arm is EXACT for this spelling and over-approximate for the other; a name
	// added here would be a second claim about one byte string, which is what the caller's block refuses.
	function isChainMoveInMutator(name ByteArray) returns bool
		return name.equals(AppendMethod) or name.equals(ListPrependMethod) or name.equals(ManagedListInsertFirstMethod) or name.equals(ManagedListInsertLastMethod)
	end 'isChainMoveInMutator'

	// Is the identifier at `p` a BARE argument value — the whole of its argument slot? True iff it is bounded
	// by an argument delimiter on both sides: `(`, a top-level `,`, or a label `:` before it, and a `,` or the
	// closing `)` after it. So `push(item)`'s `item` and `set(i, value: item)`'s `item` match, while an index
	// expression, a `.`-chain hop, or a label token (`value`, which is followed by `:`) does not.
	function isBareArgValueAt(p TokenIndex) returns bool
		let before = self.kindAt(p - 1)
		let after = self.kindAt(p + 1)
		let leftBounded = before == TokenKind.leftParen or before == TokenKind.comma or before == TokenKind.colon
		let rightBounded = after == TokenKind.comma or after == TokenKind.rightParen
		return leftBounded and rightBounded
	end 'isBareArgValueAt'

	// ⭐ **CLOSE THE ARRAY-FEED RELATION OVER SELF-CALL FORWARDS (P1.7 slice 3b-iv)** — after every method of a
	// generic type is scanned, a method M's parameter P is ALSO a type-parameter FEED when M forwards P (as a bare
	// argument) to a self-call `self.N(...)` whose corresponding parameter is itself a feed. Without this only the
	// method that DIRECTLY pushes into the array (`store`) is a feed, so a forwarder (`add(item){ self.store(item) }`)
	// leaves its OWN concrete call site (`sc.add("x")`) BORROWING the managed argument — which the owning array then
	// destroys, freeing a value nobody transferred (a double-free, `0xC0000005`). This is the per-parameter analogue
	// of `Queries.foldDescriptorNeeds`: a least fixpoint over the same self-call graph, mirrored here with FORWARD
	// edges (M's parameter -> N's parameter) rather than a per-method boolean, solved by the same linear
	// reverse-reachability BFS. It runs in the SWEEP — feeds are a whole-program `ParamConsumeInfo` fact a cross-file
	// concrete call site reads — after the method loop, so every sibling's parameter list is known for edge
	// resolution. A NON-generic type has no type parameter to feed, so it does nothing.
	function recordTransitiveArrayFeeds(paramConsumes ParamConsumeEntryArray, bodyStart TokenIndex, feedStart ElementCount)
		if self.enclosingTypeParams.isEmpty() 'notGeneric'
			return
		end 'notGeneric'
		self.solveAndPublishTransitiveFeeds(self.scanTypeMethodFeeds(bodyStart), paramConsumes: paramConsumes, feedStart: feedStart)
	end 'recordTransitiveArrayFeeds'

	// Walk the generic type's body once, returning one `MethodFeedScan` per method — its parameters, direct
	// array-mutator feeds, and self-call forward edges. Mirrors `scanDescriptorNeedsInto`' body walk: a
	// named `function <name>` opens a method whose whole body is scanned in one nested pass
	// (`scanOneMethodFeedSignals`), and the walk resumes past its `end`, so this outer loop only ever sees
	// member-level tokens.
	//
	// ⚠ **A `static` IS ALIGNED AS A `static`, AND IT USED TO BE ALIGNED AS AN INSTANCE METHOD (W10).** The
	// comment here said a static *"has no `self`, so it contributes no direct feed and no self-call edge — inert
	// in the fixpoint (it is never published), so it needs no special case"*. Its FIRST clause was already false
	// — a static durably stores a type-parameter argument through a local `Array with T` it hands to the `Self`
	// it returns — and once a static can be published, prepending `SelfParamName` to a receiverless parameter
	// list is not a harmless over-alignment: every call site slots its arguments against these very names
	// (`argSlotPosition`), so a published static would consume at the position one to the left of the one the
	// author wrote. So the list is built the way the SWEEP builds it, per method, through the one door that
	// spells each alignment (`feedScanParams`).
	function scanTypeMethodFeeds(bodyStart TokenIndex) returns MethodFeedScanArray
		var scans = MethodFeedScanArray.create()
		var q = bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			if self.closesBlockAt(q) 'typeEnd'
				break
			end 'typeEnd'
			if self.functionDeclarationAt(q) 'method'
				var typeParamPositions = TypeParamPositionArray.create()
				let takesReceiver = self.declarationTakesReceiver(self.functionDeclIsStatic(q))
				let paramNames = self.feedScanParams((q + 2) as TokenIndex, takesReceiver: takesReceiver, typeParamPositionsOut: typeParamPositions)
				let scan = self.scanOneMethodFeedSignals(q + 2, funcName: qualifiedMethodName(self.enclosingType, methodName: self.tokenAt(q + 1).value), paramNames: paramNames, typeParamPositions: typeParamPositions, takesReceiver: takesReceiver)
				scans.push(scan)
				q = scan.endPos
				continue
			end 'method'
			q = q + 1
		end 'walk'
		return scans
	end 'scanTypeMethodFeeds'

	// The parameter list one method's feed facts are recorded against, aligned exactly as the SWEEP aligns them
	// (`recordScannedSignature`): CALL-aligned (`SelfParamName` at slot 0) for an instance method, and the plain
	// SOURCE list for a receiverless one, whose own parameter list already IS its call-site list. The transitive
	// fixpoint REPLACES the sweep's entry for a method that gains a feed, so the two alignments have to be the
	// same list — this is the one place that says which is which.
	function feedScanParams(paramsStart TokenIndex, takesReceiver bool, typeParamPositionsOut TypeParamPositionArray) returns ByteArrayArray
		if not takesReceiver 'receiverless'
			return self.paramNamesIn(paramsStart, typeParamPositionsOut: typeParamPositionsOut, collectTypeParamFlags: true, typesOut: self.emptySweptParamTypes, collectTypes: false)
		end 'receiverless'
		return self.callAlignedInstanceParams(paramsStart, typeParamPositionsOut: typeParamPositionsOut)
	end 'feedScanParams'

	// Scan ONE method's body — from `startPos` (the `(` of its parameter list) to its own `end` — for the array-feed
	// signals: the DIRECT array-mutator feeds it performs on ANY receiver (`items.push(param)`, W10) and the
	// self-call forward edges out of it (`self.N(param)`, plus an implicit-self bare-sibling `N(param)` #65, which
	// lowers to the same self-call). `depth` starts at 1 because the method's own block is already open; the
	// parameter list and return type carry no `.mutator(` call, no `self.N` shape and no bare-sibling call, so
	// scanning from `startPos` costs one harmless pass over them — mirroring `scanOneMethodDescriptorSignals`,
	// which starts at the same token.
	function scanOneMethodFeedSignals(startPos TokenIndex, funcName ByteArray, paramNames ByteArrayArray, typeParamPositions TypeParamPositionArray, takesReceiver bool) returns MethodFeedScan
		var directFeeds = TypeParamFeedArray.create()
		var edges = ForwardFeedEdgeArray.create()
		var depth = 1 as BlockDepth
		var q = startPos
		while self.kindAt(q) != TokenKind.eof 'walk'
			let kind = self.kindAt(q)
			// `<receiver>.push/set/insert(param)` is a DIRECT feed wherever its receiver lives (W10) — probed at
			// every token, exactly as `scanBodyFacts` probes it, so the two seedings cannot disagree about what a
			// direct feed is.
			_ = self.markOpaqueContainerMutatorFeeds(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: directFeeds)
			if kind == TokenKind.self 'selfToken'
				// `self.<opaqueField> = param` (P1.7 Finding A) is a DIRECT feed too — seeded here so the transitive
				// closure marks a forwarder INTO a field-reassigning sibling as consuming its own argument.
				_ = self.markOpaqueFieldReassignFeed(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: directFeeds)
				if self.isSelfMethodCallAt(q) 'selfCall'
					self.collectForwardFeedEdges(q + 4, calleeName: qualifiedMethodName(self.enclosingType, methodName: self.tokenAt(q + 2).value), paramNames: paramNames, typeParamPositions: typeParamPositions, edges: edges)
				end 'selfCall'
			end 'selfToken' else 'notSelf'
				// A BARE sibling call `N(param)` (#65) lowers to `self.N(param)`, so it forwards exactly as an explicit
				// self-call does. The callee is qualified to `<enclosingType>.N`; a call to a name that is not a sibling
				// method is dropped by the fixpoint's name->index filter, so over-including here is harmless.
				// A sibling's name may be a KEYWORD (D8), read through `tokenCanBeAName` minus the block-structure
				// kinds — the twin of the descriptor scan's bare-call test, for the reason given there.
				if tokenCanBeAName(self.tokenAt(q)) and not kindSpellsBlockStructure(kind) and self.isBareCallAt(q) 'bareCall'
					self.collectForwardFeedEdges(q + 2, calleeName: qualifiedMethodName(self.enclosingType, methodName: self.tokenAt(q).value), paramNames: paramNames, typeParamPositions: typeParamPositions, edges: edges)
				end 'bareCall'
			end 'notSelf'

			if self.opensBlockAt(q) 'opensBlock'
				depth = depth + 1
			end 'opensBlock' else 'notOpener'
				if self.closesBlockAt(q) 'closes'
					depth = depth - 1
					if depth == 0 'methodEnd'
						return MethodFeedScan.create(funcName, paramNames: paramNames, typeParamPositions: typeParamPositions, directFeeds: directFeeds, edges: edges, takesReceiver: takesReceiver, endPos: (q + 1) as TokenIndex)
					end 'methodEnd'
				end 'closes'
			end 'notOpener'

			q = q + 1
		end 'walk'
		return MethodFeedScan.create(funcName, paramNames: paramNames, typeParamPositions: typeParamPositions, directFeeds: directFeeds, edges: edges, takesReceiver: takesReceiver, endPos: q)
	end 'scanOneMethodFeedSignals'

	// Extract the self-call forward edges from ONE `self.N(...)` / bare-sibling `N(...)` call's argument list, whose
	// first argument token is at `argsStart` (just past the `(`). For each argument that is a BARE reference to a
	// caller parameter that is type-parameter-typed, append an edge to `calleeName` — positional (empty `argLabel`)
	// for the first argument, labelled (`argLabel:`) otherwise — for the fixpoint to resolve to the callee's own
	// parameter position. A non-parameter argument, an index expression, or a `.`-chain hop is not a bare forward and
	// is skipped; a plain-typed caller parameter cannot BE a feed, so it is skipped too — which is exactly what
	// `bareTypeParamArgsIn` answers, and the reason the walk lives there rather than here.
	function collectForwardFeedEdges(argsStart TokenIndex, calleeName ByteArray, paramNames ByteArrayArray, typeParamPositions TypeParamPositionArray, edges ForwardFeedEdgeArray)
		for arg in self.bareTypeParamArgsIn(argsStart, paramNames: paramNames, typeParamPositions: typeParamPositions) 'eachArg'
			edges.push(ForwardFeedEdge.create(arg.paramIndex, calleeName: calleeName, argLabel: self.argLabelBefore(arg.valuePos)))
		end 'eachArg'
	end 'collectForwardFeedEdges'

	// The argument LABEL immediately before a bare argument value at `valuePos`, or `EmptySourceText` for the first
	// POSITIONAL argument. A labelled argument is `label : value`, so the label is two tokens back; a positional one
	// is bounded by `(` or `,`. Mirrors how a call site slots a labelled argument by name and the first argument by
	// position (`slotCallArgs`).
	// ⚠ A LABEL MAY BE SPELLED WITH A KEYWORD (D8), because the PARAMETER it names may be
	// (`combine(1, enum: 2)`) — so the label token is read through `tokenCanBeAName`. Missed, the label read
	// as EMPTY, which means "the first POSITIONAL argument": the forward edge would resolve to the callee's
	// parameter 0 instead of the one actually named, and the fixpoint would mark the wrong parameter a feed.
	function argLabelBefore(valuePos TokenIndex) returns ByteArray
		if self.kindAt((valuePos - 1) as TokenIndex) == TokenKind.colon and tokenCanBeAName(self.tokenAt((valuePos - 2) as TokenIndex)) 'labelled'
			return self.tokenAt((valuePos - 2) as TokenIndex).value
		end 'labelled'
		return EmptySourceText
	end 'argLabelBefore'

	// Solve the array-feed relation to its least fixpoint over the self-call forward edges, then publish each
	// method's transitive feeds into `paramConsumes`. A (method, parameter) NODE is a feed iff it directly feeds an
	// array mutator OR it forwards to a feed node — iff it can REACH a directly-fed node over the forward edges. So
	// REVERSE the edges (`buildCsr` with (callee, caller) SWAPPED, exactly as `Queries.foldDescriptorNeeds`) and mark
	// reachability BACKWARD from the seeds: each node enters the worklist at most once (the first time its bit flips
	// on) and each edge is walked once, for O(nodes + edges).
	function solveAndPublishTransitiveFeeds(scans MethodFeedScanArray, paramConsumes ParamConsumeEntryArray, feedStart ElementCount)
		let methodCount = scans.count()

		// Dense method index per qualified name, and the per-method NODE base (prefix sum of call-aligned parameter
		// counts), so a `(method, parameter)` pair flattens into one dense CSR key space. `nodeMethod` is the inverse
		// (node -> its method), read when a newly-fed node marks its method for publishing.
		var nameToIndex = MethodIndexMap.create()
		var paramBase = CsrColumn.create()
		var nodeMethod = CsrColumn.create()
		var totalNodes = 0 as CsrIndex
		for i in 0 upto methodCount 'index'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB below count {methodCount}")
			nameToIndex.upsert(scan.funcName, value: i)
			paramBase.push(totalNodes)
			for _ in 0 upto scan.paramNames.count() 'node'
				nodeMethod.push(i)
			end 'node'
			totalNodes = totalNodes + scan.paramNames.count()
		end 'index'

		// The REVERSED forward edges: a forward node edge (caller -> callee) is recorded as `callee -> caller`, so a
		// BFS from a fed node reaches the callers that forward INTO it. An edge to a name that is not a sibling
		// method, or to a callee parameter position out of range (a malformed call), is not a real edge and is
		// dropped — `buildCsr` counting-sorts the rest into the reverse adjacency in O(edges + nodes).
		var edgeCallee = CsrColumn.create()
		var edgeCaller = CsrColumn.create()
		for i in 0 upto methodCount 'edges'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB in edges")
			let callerBase = try paramBase.get(i) otherwise panic("solveAndPublishTransitiveFeeds: paramBase.get({i}) OOB")
			for edge in scan.edges 'edge'
				if let j = try nameToIndex.get(edge.calleeName) 'sibling'
					let calleeScan = try scans.get(j) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({j}) OOB for callee")
					let calleePos = self.forwardEdgeCalleePos(edge, calleeScan: calleeScan)
					if calleePos < calleeScan.paramNames.count() 'realEdge'
						edgeCallee.push((try paramBase.get(j) otherwise panic("solveAndPublishTransitiveFeeds: paramBase.get({j}) OOB")) + calleePos)
						edgeCaller.push(callerBase + edge.callerParamPos)
					end 'realEdge'
				end 'sibling'
			end 'edge'
		end 'edges'
		let feedersOf = buildCsr(edgeCallee, to: edgeCaller, nodeCount: totalNodes)

		// Seed each DIRECTLY-fed node, then mark every node that REACHES one over the reversed forward edges — a
		// (method, parameter) node is a feed iff it directly feeds an array mutator or forwards (transitively) to a
		// feed node.
		var seeds = BoolArray.create()
		for i in 0 upto methodCount 'seedNodes'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB in seed")
			for p in 0 upto scan.paramNames.count() 'param'
				seeds.push(paramIsFed(scan.directFeeds, index: p))
			end 'param'
		end 'seedNodes'
		let isFeed = reverseReachabilityMark(feedersOf, seeds: seeds)

		// A method must have its `paramConsumes` entry (re)written iff it GAINED a feed at a node that was not a
		// direct seed — a method whose feeds are entirely direct already carries the right entry from the sweep.
		var gained = BoolArray.create()
		for _ in 0 upto methodCount 'seedGained'
			gained.push(false)
		end 'seedGained'
		for node in 0 upto totalNodes 'markGained'
			let transitively = (try isFeed.get(node) otherwise panic("solveAndPublishTransitiveFeeds: isFeed.get({node}) OOB")) and not (try seeds.get(node) otherwise panic("solveAndPublishTransitiveFeeds: seeds.get({node}) OOB"))
			if transitively 'gainedFeed'
				try gained.set(try nodeMethod.get(node) otherwise panic("solveAndPublishTransitiveFeeds: nodeMethod.get({node}) OOB"), value: true) otherwise panic("solveAndPublishTransitiveFeeds: gained.set OOB")
			end 'gainedFeed'
		end 'markGained'

		self.publishTransitiveFeeds(scans, paramBase: paramBase, isFeed: isFeed, gained: gained, paramConsumes: paramConsumes, feedStart: feedStart)
	end 'solveAndPublishTransitiveFeeds'

	// The callee's parameter position a forward edge targets: its FIRST user parameter for a positional argument,
	// or the labelled parameter's position (`paramIndexIn`) otherwise — the same slotting a call site applies. The
	// first user parameter is slot 1 for an INSTANCE method (the receiver holds call-aligned slot 0) and slot 0 for
	// a receiverless one, which is why the scan carries `takesReceiver` rather than assuming one (W10).
	function forwardEdgeCalleePos(edge ForwardFeedEdge, calleeScan MethodFeedScan) returns ParamCount
		if edge.argLabel.isEmpty() 'positional'
			return (1 if calleeScan.takesReceiver else 0) as ParamCount
		end 'positional'
		return self.paramIndexIn(calleeScan.paramNames, name: edge.argLabel)
	end 'forwardEdgeCalleePos'

	// Write each transitively-fed method's final feeds into `paramConsumes`. Only a method that GAINED a feed at a
	// non-directly-fed parameter is touched, so a type with no forwarder is byte-identical.
	//
	// ⚠ EVERY feed published here is a CALLEE-STORAGE one, and structurally so: the fixpoint's seeds are exactly
	// the two direct callee-storage shapes (`markOpaqueContainerMutatorFeeds`, `markOpaqueFieldReassignFeed`), and a
	// `Self{f: p}` CONSTRUCTOR feed is not a seed and has no forward edge, so nothing here can reach one. A
	// forwarder INTO callee storage owns its own argument for the same reason its callee does — it hands it on.
	function publishTransitiveFeeds(scans MethodFeedScanArray, paramBase CsrColumn, isFeed BoolArray, gained BoolArray, paramConsumes ParamConsumeEntryArray, feedStart ElementCount)
		for i in 0 upto scans.count() 'publish'
			if not (try gained.get(i) otherwise panic("publishTransitiveFeeds: gained.get({i}) OOB")) 'noGain'
				continue
			end 'noGain'
			let scan = try scans.get(i) otherwise panic("publishTransitiveFeeds: scans.get({i}) OOB")
			self.mergeGainedFeedsInto(paramConsumes, feedStart: feedStart, scan: scan, nodeBase: try paramBase.get(i) otherwise panic("publishTransitiveFeeds: paramBase.get({i}) OOB"), isFeed: isFeed)
		end 'publish'
	end 'publishTransitiveFeeds'

	// ⛔⛔ **THE SWEEP'S ENTRY IS THE BASE THE SOLVED FEEDS ARE MERGED ONTO — NOT A DRAFT TO BE THROWN AWAY.**
	// Replace this method's swept entry in place, or append a fresh one when the sweep filed none (a pure
	// forwarder). Only entries added since `feedStart` — this declaration's own methods — are searched, and method
	// names are whole-program unique, so the match is exact; ONE search serves both the READ of the swept facts and
	// the WRITE of the merged entry, so the two cannot come to disagree about which entry is this method's.
	//
	// ⚠ **IT USED TO REBUILD THE ENTRY FROM THE SOLVED NODES ALONE, ON A PREMISE W10 RETIRED.** The premise was
	// *"an instance method has no plain consume bit (`detectFieldStores: false`), so the bits are all false"* — and
	// it held only while a RECEIVERLESS function could never be published here (`scanTypeMethodFeeds` called a
	// `static` "inert in the fixpoint"). A receiverless function is the one kind scanned with
	// `detectFieldStores: true`, so it is the one kind that carries facts this fixpoint never computes — its plain
	// consume bits AND its `Self{f: p}` CONSTRUCTOR feeds, which have no node here and so read as `none` off the
	// solved column. MEASURED: a `static of(first Element, single Element)` that FORWARDS `first` to a sibling that
	// pushes, and stores `single` into a type-parameter field, lost `single`'s constructor feed the moment `first`
	// made the method `gained` — the concrete call site then borrowed a `String` the box destroys, `0xC0000005`.
	// (Its direct-feed twin, one `xs.push(first)` instead of the forward, never entered here and was correct — a
	// difference no rule could justify.) So the fixpoint may only turn feeds ON.
	function mergeGainedFeedsInto(paramConsumes ParamConsumeEntryArray, feedStart ElementCount, scan MethodFeedScan, nodeBase CsrIndex, isFeed BoolArray)
		for i in feedStart upto paramConsumes.count() 'find'
			let filed = try paramConsumes.get(i) otherwise panic("mergeGainedFeedsInto: paramConsumes.get({i}) OOB")
			if filed.name.equals(scan.funcName) 'match'
				try paramConsumes.set(i, value: ParamConsumeEntry.create(scan.funcName, info: self.feedsMergedOnto(filed.info, scan: scan, nodeBase: nodeBase, isFeed: isFeed), takesReceiver: filed.takesReceiver)) otherwise panic("mergeGainedFeedsInto: paramConsumes.set({i}) OOB")
				return
			end 'match'
		end 'find'

		// The sweep filed NOTHING for this method — a PURE forwarder, which neither consumes nor directly feeds.
		// An EMPTY facts record says exactly that and is not a placeholder: `isConsumed` / `typeParamFeedOf` read
		// every index past their own column as `false` / `none`, which is the content of "the sweep recorded
		// nothing here".
		paramConsumes.push(ParamConsumeEntry.create(scan.funcName, info: self.feedsMergedOnto(ParamConsumeInfo.create(scan.paramNames, bits: BoolArray.create(), feeds: TypeParamFeedArray.create()), scan: scan, nodeBase: nodeBase, isFeed: isFeed), takesReceiver: scan.takesReceiver))
	end 'mergeGainedFeedsInto'

	// `prior` with this method's solved feed nodes turned ON: a node the fixpoint marked becomes a CALLEE-STORAGE
	// feed, every other position keeps whatever the sweep put there. The plain consume bits ride across untouched —
	// the fixpoint has no opinion about them, and an opinion it does not hold must not be published as `false`.
	function feedsMergedOnto(prior ParamConsumeInfo, scan MethodFeedScan, nodeBase CsrIndex, isFeed BoolArray) returns ParamConsumeInfo
		var feeds = TypeParamFeedArray.create()
		for p in 0 upto scan.paramNames.count() 'buildFeeds'
			let feedParam = try isFeed.get(nodeBase + p) otherwise panic("feedsMergedOnto: isFeed.get OOB at ({nodeBase}+{p})")
			if feedParam 'feedParam'
				feeds.push(TypeParamFeed.feeds(self.paramTypeParamPositionAt(scan.typeParamPositions, index: p), sink: FeedSink.calleeStorage))
			end 'feedParam' else 'sweptParam'
				feeds.push(prior.typeParamFeedOf(p))
			end 'sweptParam'
		end 'buildFeeds'
		return ParamConsumeInfo.create(scan.paramNames, bits: prior.bits, feeds: feeds)
	end 'feedsMergedOnto'

	// ⭐ **READ A PARAMETER LIST IN ONE WALK (P1.6-A/B2)** — the ordered NAMES out of the `(…)` beginning at
	// `parenPos` (returned), and IN THE SAME PASS the type-parameter POSITION each parameter's declared type
	// names (the sentinel `enclosingTypeParams.count()` for a plain type), pushed into
	// `typeParamPositionsOut`. Peek-only (the cursor is untouched). Each parameter is `name Type`, so the
	// first token after `(` or a top-level `,` is the name and the type runs to the next top-level `,` or the
	// closing `)`; `skipParamType` finds that end (paren depth tracked, because a type may itself contain
	// parens — `int(0 to 100)`, `function(X) returns Y`).
	//
	// ⭐ **AND, ON THE SAME WALK, THE DECLARED TYPE ITSELF** (`typesOut`, gated by `collectTypes` exactly as the
	// positions are by their own flag) — the CALL-side half of an overload set, read through `sweptParamTypeAt`.
	// It rides this walk rather than one of its own for the reason the positions do: `names[i]` and `types[i]`
	// describe the same parameter by construction, and a call scores an overload on both together.
	//
	// ⚠ **NAME AND TYPE-PARAM POSITION ARE PRODUCED TOGETHER, SO `names[i]` AND `positions[i]` ALWAYS
	// DESCRIBE THE SAME PARAMETER.** The consume scan reads the position to decide whether parameter `i` was
	// moved into a plain field (`Self{f: p}` — consumed), fed a type parameter (a concrete-site managed
	// consume, B2), or merely aliased — a MISALIGNMENT would fire on the wrong parameter and leak or
	// double-move. Two independent walks would agree only by coincidence; ONE walk makes it structural. When
	// `collectTypeParamFlags` is false — every function OUTSIDE a generic type, i.e. all of them on the
	// generics-free corpus — the position work is skipped and `typeParamPositionsOut` is left untouched (the
	// caller passes the SHARED empty array, ⚡ so the hot path allocates no per-function array).
	//
	// ⚠ **`recordParamNameKeywords` (D8) DELIBERATELY DOES NOT SHARE THIS WALK, and that is not an oversight**
	// — see there: it needs a strictly COARSER answer that this grammar cannot give more cheaply, and a shared
	// walk that returned index COLUMNS measured **+7,794 allocations at rung 0 of the scale ladder, doubling
	// per rung**, because it put three heap objects on a once-per-function path.
	function paramNamesIn(parenPos TokenIndex, typeParamPositionsOut TypeParamPositionArray, collectTypeParamFlags bool, typesOut MaxonTypeArray, collectTypes bool) returns ByteArrayArray
		var names = ByteArrayArray.create()
		var q = parenPos
		if self.kindAt(q) != TokenKind.leftParen 'noParens'
			return names
		end 'noParens'
		q = q + 1
		if self.kindAt(q) == TokenKind.rightParen 'noParams'
			return names
		end 'noParams'

		while true 'params'
			// The parameter's first token is its NAME (an identifier — or a keyword like `type`, which is a
			// legal parameter name; the type reader that follows is what tells them apart, and the sweep only
			// needs the text, not the kind).
			names.push(self.tokenAt(q).value)
			let typeStart = q + 1
			let typeEnd = self.skipParamType(typeStart)
			if collectTypeParamFlags 'flag'
				typeParamPositionsOut.push(self.paramTypeParamPosition(typeStart, typeEnd: typeEnd))
			end 'flag'
			if collectTypes 'overloadSurface'
				typesOut.push(self.sweptParamTypeAt(typeStart, typeEnd: typeEnd))
			end 'overloadSurface'
			// The TYPE ends at `typeEnd` and the PARAMETER may not — see `paramItemEndFrom`.
			let itemEnd = self.paramItemEndFrom(typeEnd)
			if self.kindAt(itemEnd) != TokenKind.comma 'endList'
				return names
			end 'endList'
			q = itemEnd + 1
		end 'params'
		panic("paramNamesIn: the parameter loop only exits by returning at the closing `)` or at EOF")
	end 'paramNamesIn'

	// The TYPE-PARAMETER POSITION the parameter type spanning `[typeStart, typeEnd)` names (P1.6-A/B2) — a
	// SINGLE identifier (`typeEnd == typeStart + 1`) whose text is a `uses` parameter of the enclosing type
	// resolves to its position; anything else yields the "not a type parameter" sentinel
	// (`enclosingTypeParams.count()`, what `typeParamPositionOf` returns for a non-parameter name). The
	// consume scan reads it BOTH as "is it a type parameter?" (position below count) and, for B2, as the
	// feed position — one walk, one fact.
	function paramTypeParamPosition(typeStart TokenIndex, typeEnd TokenIndex) returns TypeParamPosition
		if typeEnd == typeStart + 1 and self.kindAt(typeStart) == TokenKind.identifier 'singleIdent'
			return self.typeParamPositionOf(self.tokenAt(typeStart).value)
		end 'singleIdent'
		return self.enclosingTypeParams.count()
	end 'paramTypeParamPosition'

	// ⭐⭐ **WHAT THE SWEEP PUBLISHES ABOUT ONE PARAMETER'S DECLARED TYPE — the CALL-side half of an overload
	// set** (`ProgramSignatures.overloadedDeclsOf`). It is read through `parseTypeReference`, the ONE type
	// reader this sweep already reads a `returns` clause with, so a parameter's swept type and its parsed one
	// cannot become two opinions of what a spelling means.
	//
	// ⚠⚠ **ONLY A SINGLE-TOKEN TYPE IS READ, AND THAT BOUNDARY IS DELIBERATE ON BOTH SIDES.**
	//   • **COST** — this runs at every parameter of every declaration in the program, and a compound type is
	//     where the reader allocates.
	//   ⚠ **THE COMMONEST COMPOUND TYPE IS A RANGED INT, NOT A GENERIC INSTANTIATION.** `n int(0 to 100)`
	//     spans six tokens, so a set with one such parameter is UNSCOREABLE — far more of the corpus than
	//     `Array with T`, `(A, B)` and `function(X) returns Y` suggest. It is the fallback's commonest
	//     customer, and the reason that fallback has to stay exactly as good as it was.
	//   • **REGISTRATION ORDER** — reading a compound type REGISTERS it whole-program: `parseTupleTypeReference`
	//     interns the tuple through `ProgramSignatures.internTupleType`, which mints a canonical name and a
	//     layout on the index.
	//     ⛔ **THIS BULLET USED TO SAY "A PARAMETER LIST IS NOT A PLACE THE SWEEP MAY MINT INSTANCES FROM",
	//     AND THAT IS FALSE — the sweep already mints them from a RETURN clause two lines from here.**
	//     `recordScannedSignature` reads `returns (A, B)` through `parseOptionalReturnType` →
	//     `parseTypeReference` → that same tuple arm, which is deliberately OUTSIDE the `allFilesFolded` gate
	//     its neighbours sit behind (`sweptStructReturnOf`'s header records what that costs and why it stays).
	//     So there is no rule being kept here. What is true is narrower and still worth the line: every
	//     registration the sweep makes moves the `GenericInstanceId` of every later one, and those ids decide
	//     mangled instance names and which claimant `checkTypeSymbolNamespace` calls the newcomer. Reading
	//     every parameter list too would add registrations across the whole corpus to buy this decider
	//     something its fallback already covers.
	//
	// A type it does not read is recorded as `MaxonType.unresolved` — the tag's own "no type is known here"
	// arm, never a stand-in for one — and the overload picker treats a declaration carrying one as
	// UNSCOREABLE rather than as matching anything.
	//
	// The cursor is saved and restored, so the peek-only contract of the walk that calls this holds.
	function sweptParamTypeAt(typeStart TokenIndex, typeEnd TokenIndex) returns MaxonType
		if typeEnd != typeStart + 1 'aCompoundTypeIsNotReadHere'
			return sharedUnreadParamType
		end 'aCompoundTypeIsNotReadHere'

		let saved = self.pos
		self.pos = typeStart
		// TOLERANT for `foldDeclaredSignaturesInto`'s reason: a type this reader cannot make sense of is the
		// REAL parse's to report, with a position, and a sweep that vetoed would reject a correct program.
		let swept = try self.parseTypeReference() otherwise sharedUnreadParamType
		self.pos = saved
		return swept
	end 'sweptParamTypeAt'

	// ⭐ The inner-alias PARAMETER shape of the parameter list at `parenPos` (P1.6-C) — its SOURCE parameter
	// names and, per position, the bare inner-alias MEMBER (`Idx`) or `EmptySourceText`. It walks the list the
	// way `paramNamesIn` does (the ONE parameter grammar) but reads the TYPE token span rather than skipping
	// it. Only called inside a generic type that declares inner aliases.
	function innerAliasParamsIn(parenPos TokenIndex) returns InnerAliasParamInfo
		var names = ByteArrayArray.create()
		var members = ByteArrayArray.create()
		var q = parenPos
		if self.kindAt(q) != TokenKind.leftParen 'noParens'
			return InnerAliasParamInfo.create(names, members: members)
		end 'noParens'
		q = q + 1
		if self.kindAt(q) == TokenKind.rightParen 'noParams'
			return InnerAliasParamInfo.create(names, members: members)
		end 'noParams'

		while true 'params'
			names.push(self.tokenAt(q).value)
			let typeStart = q + 1
			let typeEnd = self.skipParamType(typeStart)
			members.push(self.innerAliasMemberOfParamType(typeStart, typeEnd: typeEnd))
			// The TYPE ends at `typeEnd` and the PARAMETER may not — see `paramItemEndFrom`.
			let itemEnd = self.paramItemEndFrom(typeEnd)
			if self.kindAt(itemEnd) != TokenKind.comma 'endList'
				return InnerAliasParamInfo.create(names, members: members)
			end 'endList'
			q = itemEnd + 1
		end 'params'
		panic("innerAliasParamsIn: the parameter loop only exits by returning at the closing `)` or at EOF")
	end 'innerAliasParamsIn'

	// The bare inner-alias MEMBER a parameter type spanning `[typeStart, typeEnd)` names (P1.6-C), or
	// `EmptySourceText`. A SINGLE identifier (`typeEnd == typeStart + 1`) that denotes an inner alias here is a
	// bare inner alias (`Idx`); anything else — a `T`, a plain alias, a qualified `Inst.Idx`, a `function(…)` —
	// is not one and reads as empty.
	//
	// ⚠ **THE TEST IS `namesInnerAliasHere`, THE ONE HOME OF THAT QUESTION, AND NOT THE BODY WALK'S SET
	// DIRECTLY (F10).** It used to be the set, which made this door and `parseTypeReference`'s inner-alias arm
	// two answers to one written name: in an `extension` body the arm resolved a member declared elsewhere and
	// this door did not, so the parameter carried the per-instance TYPE while the index carried no per-instance
	// ENTRY for it. See the gate in `recordScannedSignature` for the measured missing refusal.
	function innerAliasMemberOfParamType(typeStart TokenIndex, typeEnd TokenIndex) returns ByteArray
		if typeEnd == typeStart + 1 and self.kindAt(typeStart) == TokenKind.identifier and self.namesInnerAliasHere(self.tokenAt(typeStart).value) 'innerAlias'
			return self.tokenAt(typeStart).value
		end 'innerAlias'
		return EmptySourceText
	end 'innerAliasMemberOfParamType'

	// Advance past ONE parameter's TYPE — from the token AFTER the parameter's name to the token that
	// ENDS the type: the `=` opening its DEFAULT VALUE, the `,` before the next parameter, the `)` closing
	// the list, or EOF on a malformed list. Balanced over nested `(...)` (a `function(…)`-typed parameter).
	//
	// ⚠ **THE `=` STOP IS NOT ONLY FOR THE DEFAULT WALK — IT IS WHAT KEEPS THE EXISTING SCANS CORRECT**
	// (BATCH2 slice 4). Every caller reads the SPAN `[typeStart, typeEnd)` as the declared type:
	// `paramTypeParamPosition` calls a span of length 1 a bare type parameter, and
	// `innerAliasMemberOfParamType` reads its tokens. Left running to the `,`, `p T = 1` would hand both of
	// them a three-token "type" and a `uses`-parameter-typed parameter would stop being recognized as one
	// the moment it gained a default. No type reference can CONTAIN a top-level `=` — `int(0 to 100)` and
	// `function(X) returns Y` are the two shapes with internal structure and neither spells one — so the
	// stop is unambiguous.
	function skipParamType(fromType TokenIndex) returns TokenIndex
		var q = fromType
		var depth = 0
		while true 'skip'
			let kind = self.kindAt(q)
			if kind == TokenKind.eof 'malformed'
				return q
			end 'malformed'
			if kind == TokenKind.leftParen 'openType'
				depth = depth + 1
			end 'openType'
			if kind == TokenKind.rightParen 'closeType'
				if depth == 0 'endList'
					return q
				end 'endList'
				depth = depth - 1
			end 'closeType'
			if (kind == TokenKind.comma or kind == TokenKind.equals) and depth == 0 'endOfType'
				return q
			end 'endOfType'
			q = q + 1
		end 'skip'
		panic("skipParamType: the loop only exits by returning at `=`, `,`, `)` or EOF")
	end 'skipParamType'

	// ⭐ **THE TOKEN THAT ENDS ONE PARAMETER — ITS TYPE, PLUS ITS DEFAULT IF IT HAS ONE.** THE one stepper
	// every peek-only parameter-list walk advances by, and it exists because the alternative shipped a
	// SEGFAULT.
	//
	// ⚠⚠ **A WALK THAT STEPS BY `skipParamType` STOPS AT THE FIRST DEFAULTED PARAMETER AND SILENTLY REPORTS
	// A SHORT LIST.** `skipParamType` ends the TYPE, which for `tag Integer = 1, item T` is the `=` — not a
	// `,`, so the walk reads the list as finished and never sees `item`. A short parameter list is a
	// well-formed one, so nothing downstream notices: what is lost is the per-parameter OWNERSHIP fact those
	// walks exist to publish. MEASURED (`specs-shv2/param-default-list-walks.md`): with `item` dropped from
	// `scanBodyFacts`' view, a `Box uses T` constructor's type-parameter FEED went unrecorded, the concrete
	// call site did not consume the `String` it passed, caller and box both owned it — and the program died
	// with an access violation, against a control identical but for the default that answered 6.
	//
	// So the TYPE SPAN and the STEP are two different questions and are now asked separately: a caller that
	// wants `[typeStart, typeEnd)` still calls `skipParamType`, and every caller that wants the NEXT
	// parameter calls this.
	function paramItemEndFrom(typeEnd TokenIndex) returns TokenIndex
		if self.kindAt(typeEnd) != TokenKind.equals 'noDefault'
			return typeEnd
		end 'noDefault'

		return self.skipParamDefault(typeEnd)
	end 'paramItemEndFrom'

	// Advance past ONE parameter's DEFAULT VALUE expression — from the `=` that opens it to the token that
	// ENDS it: the `,` before the next parameter, the `)` closing the list, or EOF on a malformed list.
	// `skipParamType`'s twin, one token span over, and balanced over all THREE bracket kinds rather than
	// just parens: a default is an arbitrary expression, so `[10, 20, 12]`, `Point.create(10, y: 32)` and
	// `Self{x: 1, y: 2}` each carry commas that are not parameter separators.
	//
	// ⚠ It never sees a top-level `=` of its own: `parseFunctionParameters` and the sweep both enter here
	// AT the `=` and start their walk one token past it, and Maxon has no assignment expression.
	function skipParamDefault(fromEquals TokenIndex) returns TokenIndex
		var q = fromEquals + 1
		var depth = 0
		while true 'skip'
			let kind = self.kindAt(q)
			if kind == TokenKind.eof 'malformed'
				return q
			end 'malformed'
			if kind == TokenKind.leftParen or kind == TokenKind.leftBracket or kind == TokenKind.leftBrace 'openGroup'
				depth = depth + 1
			end 'openGroup'
			if kind == TokenKind.rightBracket or kind == TokenKind.rightBrace 'closeGroup'
				depth = depth - 1
			end 'closeGroup'
			if kind == TokenKind.rightParen 'closeParen'
				if depth == 0 'endList'
					return q
				end 'endList'
				depth = depth - 1
			end 'closeParen'
			if kind == TokenKind.comma and depth == 0 'nextParam'
				return q
			end 'nextParam'
			q = q + 1
		end 'skip'
		panic("skipParamDefault: the loop only exits by returning at `,`, `)` or EOF")
	end 'skipParamDefault'

	// ⭐⭐ **IS THIS PARAMETER DEFAULT ONE OF THE TWO CALLER-LOCATION KEYWORDS? (W72)** — asked of the token
	// region `(fromEquals, exprEnd)` a default occupies, by BOTH walks of a parameter list: the declaration
	// sweep, which publishes the slot's `ParamDefaultProducer`, and the real parse, which must mint no helper
	// for one. ONE classifier, for `sweptParamDefaultHelperName`'s reason — two walks answering this
	// differently give a call site a helper the drain never declares, or a drain a helper nothing calls.
	//
	// ⚠ **EXACTLY ONE TOKEN, NOT "CONTAINS ONE"** — `= __line__ + 1` is REFUSED rather than expanded (see
	// `requireNoEmbeddedCallerLocation`), and the reason is architectural rather than a reach limit: the value
	// must be materialized AT THE CALLER, and a caller cannot re-parse the declaring file's tokens — that
	// impossibility is the very property making shv2's per-file parse a pure function
	// (`SignatureIndex.ParamDefaultInfo`). The bootstrap accepts the arithmetic because replaying a default's
	// tokens at each call site is exactly what it does.
	function callerLocationDefaultAt(fromEquals TokenIndex, exprEnd TokenIndex) returns CallerLocationDefault
		let onlyToken = fromEquals + 1
		if exprEnd != onlyToken + 1 or self.kindAt(onlyToken) != TokenKind.identifier 'notASingleName'
			return CallerLocationDefault.none
		end 'notASingleName'

		return callerLocationNamed(self.tokenAt(onlyToken).value)
	end 'callerLocationDefaultAt'

	// The refusal the classifier above owes the region it just called ORDINARY: a default that MENTIONS
	// `__line__`/`__file__` without being one. Asked only by the real parse — the sweep publishes a helper
	// for such a region and the parse then refuses the file, so the two never disagree about a program that
	// compiles.
	//
	// It is a separate diagnostic from E2060 and not that one reworded: E2060's sentence says the keyword is
	// legal only as a parameter default, and here it IS in one. What is wrong is the ARITHMETIC around it.
	function requireNoEmbeddedCallerLocation(fromEquals TokenIndex, exprEnd TokenIndex) throws ParseError
		var q = fromEquals + 1
		while q < exprEnd 'scan'
			if self.kindAt(q) == TokenKind.identifier 'aName'
				let tok = self.tokenAt(q)
				match callerLocationNamed(tok.value) 'keyword'
					none then break 'keyword'
					line to file then throw ParseError.unsupported("'{String.from(tok.value)}' inside a larger default expression — a caller-location default is materialized AT THE CALL SITE, from the caller's own position, and the declaring file's expression is not available there to evaluate around it. The whole default must be the keyword alone; do the arithmetic in the body", line: tok.line, column: tok.column)
				end 'keyword'
			end 'aName'
			q = q + 1
		end 'scan'
	end 'requireNoEmbeddedCallerLocation'

	// The name a `function <nameTok>` is DECLARED under: its own, at file scope; `Point.create`
	// inside `type Point`.
	//
	// It reads `enclosingType`, which BOTH the sweep and the real parse set (see that field), so
	// the key the index records and the key the `IrFunction` carries are one name derived one way.
	// The alternative — the sweep recording `create` and the parse declaring `Point.create` — is
	// not a subtle failure: every call would report E3004 against a name nothing declared.
	// ⭐⭐ **AND A FREE FUNCTION WHOSE BARE NAME IS CONTESTED ACROSS DIRECTORIES IS DECLARED UNDER ITS
	// DIRECTORY-QUALIFIED SPELLING (N1c)** — `alpha.duplicate` for a `duplicate` in `alpha/` when `beta/`
	// declares one too. It is the same construction a method gets and lands in the same flat name space, so
	// the two declarations have distinct signatures, distinct `IrFunction`s and distinct emitted symbols
	// rather than one of them silently winning.
	//
	// ⚠ **GATED ON `allFilesFolded`, and the two passes MUST answer differently here.** The declaration sweep
	// is what DISCOVERS the contest, so during it the answer is always the bare name — and `foldFile` moves
	// the sweep's own entries onto the qualified key at the moment it learns better. The real parse runs
	// against a complete index and mints the final name. Without the gate the answer would depend on how far
	// the sweep had got, which is a property of the filesystem's walk order.
	//
	// ⚠ **`main` IS NEVER CONTESTED**, so it never reaches the qualifying arm — `recordScannedSignature`
	// keeps the entry point out of the contest entirely, which is what leaves two `main`s a hard duplicate.
	function declaredMethodName(nameTok Token) returns ByteArray
		if not self.enclosingType.isEmpty() 'method'
			return qualifiedMethodName(self.enclosingType, methodName: nameTok.value)
		end 'method'

		if self.signatures.allFilesFolded and self.signatures.isContestedFreeFunction(nameTok.value) 'contestedAcrossDirectories'
			return self.signatures.freeFunctionRegistrationName(nameTok.value, moduleDirectory: self.signatures.moduleDirectoryOf(self.filePath))
		end 'contestedAcrossDirectories'

		return nameTok.value
	end 'declaredMethodName'

	// ⭐⭐ **THE REGISTRATION NAME A DECLARATION CLAIMS — bare for the first of its name, MANGLED for a
	// later overload of it** (D7). Every registry this function's declaration reaches is keyed by what this
	// returns (`funcSignatures`, `funcReturnTypes`, `rangeChecks`, the `IrFunction` itself, and so the
	// emitted symbol), which is exactly why it is decided HERE — before `IrFunction.create` — rather than at
	// the merge: a name chosen later would have to be re-keyed through all of them, and a lifted closure
	// parsed inside the body already derives ITS name from this one (`<enclosing>$closure_<k>`).
	//
	// ⭐ **THE FIRST DECLARATION KEEPS THE BARE NAME.** Mangling ON CONTEST ONLY is what makes this rung
	// golden-neutral: a program that overloads nothing registers every function under exactly the name it
	// did before, so no committed fragment moves. It is the same construction
	// `ProgramSignatures.mangleGenericInstance` uses for a contested instance name, and both reference
	// compilers independently arrived at it (v1's `tryRegisterOverload` re-keys the incumbent instead, which
	// shv2 does not need to: the incumbent's bare name is a perfectly good member key).
	//
	// The escalation ladder, and each rung's reason:
	//   1. **bare name** — nothing has claimed it in this file.
	//   2. **the TYPE suffix** (`process#String`) — the name is claimed and the parameter TYPES differ.
	//      Types first, because that is what "overloading" means: the suffix then survives a parameter
	//      RENAME, so renaming a parameter cannot silently move a symbol.
	//   3. **the LABEL suffix** (`create#label`) — the types collide, so only the labels can tell the two
	//      apart. This is the `slice(start, endIndex)` / `slice(start, length)` case both references carry
	//      a dedicated fallback for, and the one `/specs` documents under "disambiguation by parameter
	//      names". Two overloads that reach here are indistinguishable at a POSITIONAL call, which the
	//      resolver reports as E3007 — a call-site fact, not a declaration-site one, which is why they are
	//      both registered rather than refused.
	//   4. **BOTH suffixes already claimed** ⇒ this is a genuine REDECLARATION. It keeps the bare name, so
	//      it collides in `commitFuncSignatures` and earns the E3006 it always did.
	//
	// ⚠ **UNIQUENESS IS ESTABLISHED BY CONSTRUCTION, NOT BY AN INJECTIVITY ARGUMENT.** A suffix is built
	// from names, and however carefully it joins them there is always a pathological program whose label
	// spells another program's type; two functions sharing one symbol is a wild dispatch, so the last step
	// simply asks whether the file has already registered the name and counts up until it has not. The
	// ordinal is unreachable for any program a human writes and costs one `Set.contains` when it is.
	//
	// ⭐⭐ **THE CONTEST IS WHOLE-PROGRAM, AND IT IS READ BACK RATHER THAN RE-DERIVED.** A parser is a pure
	// function of its own file, so a later overload of a name ANOTHER file claimed cannot know it is later —
	// this function's own registry (`declaredFuncNames`) sees one file. What supplies the missing fact is a
	// walk that completes before any file is parsed, and there are two of them, one per declaration kind:
	//
	//   • **an `extension` METHOD** — `Parser.foldExtensionDeclarationInto` visits every `extension` in the
	//     program, so `ProgramSignatures.contestedExtensionMethods` can say that a `<Conformer>.<method>` is
	//     declared by extensions in more than one FILE (X-contains).
	//   • **a FREE FUNCTION** — the declaration sweep visits every `function` in the program, so
	//     `ProgramSignatures.isCrossFileOverloadedFreeFunction` can say that a registration base is declared
	//     by more than one FILE OF ONE DIRECTORY. (More than one DIRECTORY is a different rule and a
	//     different name: each such declaration is registered under its directory-qualified spelling, N1c.)
	//
	// ⚠ **BOTH ANSWER ABOUT FILES AND NEITHER ABOUT PARAMETERS**, which is what keeps the mint below the one
	// place a signature decides a name: a contested base sends EVERY declaration of it down the suffix
	// ladder, and two that spell one parameter list then collide there exactly as a same-file redeclaration
	// does. The sweep publishes each declaration's parameter-type SPELLINGS for the CALL side of the same
	// question (`ProgramSignatures.overloadedDeclsOf`), never for this one.
	//
	// ⚠⚠ **WHEN THE NAME IS CONTESTED, NOBODY KEEPS THE BARE SPELLING — INCLUDING THE FIRST DECLARATION.**
	// That is the whole of why the refusal below still works. Two declarations whose parameters differ mint
	// DIFFERENT suffixes and are two live overloads; two whose parameters agree mint the SAME suffix, claim
	// one registration name and collide in `commitFuncSignatures` — the E3006 a genuine redeclaration has
	// always earned, established by CONSTRUCTION rather than by a second cross-file check written beside this
	// one and free to disagree with it. Letting the first claimant keep the bare name would leave that pair
	// as two live functions under two names, and the only thing left to notice it would be an E3007 at a call
	// site — silent for a method nobody calls.
	//
	// It is the construction `freeFunctionRegistrationName` already takes for a free function contested
	// across DIRECTORIES, where neither claimant keeps the bare name either, and it costs the same thing:
	// the quoted name in a duplicate diagnostic is one no declaration wrote, which `duplicateFunctionMessage`
	// answers for.
	//
	// ⚠ The bare name remains the overload set's KEY (`OverloadSetMap`) and the callee a call op carries, so
	// nothing at a call site changes — `SemanticCheck.resolveOverloadedCalls` rebinds it to a member exactly
	// as it does for a same-file set.
	//
	// ⭐⭐ **THE ONE CONTEST THAT IS NOT AN OVERLOAD SET AT ALL: a `static` MEMBER BESIDE AN INSTANCE MEMBER OF
	// THE SAME NAME** (`same-name-methods.md`). It changes the BASE this whole ladder runs against rather than
	// adding a rung to it, so the static's set — if it has one — is keyed by that base and the call door mints
	// the same base. See the body, and `staticMemberRegistrationName` for the name.
	function overloadRegistrationNameFor(base ByteArray, paramTypes MaxonTypeArray, paramNames ByteArrayArray, takesReceiver bool, nameTok Token) returns ByteArray throws ParseError
		// ⭐⭐ **A `static` MEMBER AND AN INSTANCE MEMBER OF ONE TYPE ARE TWO NAMES, NOT ONE OVERLOAD SET** —
		// `same-name-methods.md`. Nothing in the ARGUMENTS can separate them (their user parameter lists may be
		// identical), so the language separates them by SYNTAX at the call and this compiler separates them by
		// NAME at the declaration: the instance keeps the source spelling and the static takes
		// `staticMemberRegistrationName`. Both reference compilers make the same split, and neither puts the
		// receiver in its overload key either (v1's `tryResolveStaticInstanceCollision`, the bootstrap's
		// `ResolveStaticInstanceCollision`).
		//
		// ⚠ **IT IS A CHANGE OF *BASE*, NOT AN EXTRA SUFFIX, and that is what makes the two mechanisms compose.**
		// Two statics of one contested name then contest with EACH OTHER under the static base — `m#__static`
		// and `m#__static#Integer` — and their overload SET is keyed by the base the call door mints, so the
		// resolver finds it exactly as it finds any other. Putting receiver-presence in the SUFFIX instead
		// would have merged both kinds into one set, where the receiver is the only discriminator and every
		// existing candidate rule reads arguments.
		//
		// ⚠ And it makes `overloadTypeSuffix`'s premise TRUE rather than assumed: every member of one base now
		// agrees about whether it takes a receiver, so the receiver really does distinguish nothing within a
		// base. See there.
		//
		// ⚠ **THE NAME COMES FROM `memberRegistrationKey` AND IS NOT COMPOSED HERE.** The sweep files this
		// declaration's facts under that key and the static call door asks for the same one; three spellings of
		// "contest ⇒ the static name" would be three chances to disagree about a symbol.
		let registrationBase = self.signatures.memberRegistrationKey(base, takesReceiver: takesReceiver)
		let contested = self.signatures.isContestedExtensionMethod(base) or self.namesACrossFileOverloadedFreeFunction(nameTok)
		if not contested and not self.declaredFuncNames.contains(registrationBase) 'firstOfThisName'
			// ✅ **A PAIR MEMBER USED TO BE PUT THROUGH THE OVERLOAD REFUSALS HERE, AND W75 RETIRED THAT.** The
			// four facts those refusals are about — a consume set, a by-reference column, a parameter default
			// and a `throws` clause — were filed by the sweep under the ONE name the two members share, so
			// neither key could read its own. They are now filed per registration key
			// (`ProgramSignatures.sweepRegistrationKey`), which leaves a pair with nothing shared to be
			// ambiguous about: a pair member is the FIRST of its own base and takes it outright, exactly as any
			// other first declaration of a name does.
			self.claimFuncName(registrationBase)
			return registrationBase
		end 'firstOfThisName'

		var members = self.overloadMembersOf(registrationBase)
		let hasTransferableParam = self.declaresTransferableParam(paramTypes, takesReceiver: takesReceiver)
		try self.requireOverloadableName(base, nameTok: nameTok, transfersOwnership: hasTransferableParam or overloadMembersTransferOwnership(members))
		let typeSuffix = self.overloadTypeSuffix(paramTypes, takesReceiver: takesReceiver)
		let labelSuffix = overloadLabelSuffix(paramNames, takesReceiver: takesReceiver)
		match overloadMemberHoldingSignature(members, typeSuffix: typeSuffix, labelSuffix: labelSuffix) 'redeclaration'
			redeclares(registered) then return registered
			newSignature then break 'redeclaration'
		end 'redeclaration'

		let suffix = labelSuffix if overloadMembersHoldTypeSuffix(members, typeSuffix: typeSuffix) else typeSuffix
		let registered = self.unclaimedRegistrationName(registrationBase, suffix: suffix)
		self.claimFuncName(registered)
		members.push(OverloadMember.create(registered, typeSuffix: typeSuffix, labelSuffix: labelSuffix, hasTransferableParam: hasTransferableParam))
		self.artifact.recordOverloadSet(registrationBase, members: overloadMemberNames(members))
		return registered
	end 'overloadRegistrationNameFor'

	// ⭐ **THE FREE-FUNCTION HALF OF THE CONTEST ABOVE** — is this declaration a free function whose
	// registration base a SECOND FILE OF ITS OWN DIRECTORY also declares? The `extension` half
	// (`isContestedExtensionMethod`) is keyed by the qualified method name; this one is keyed by the base a
	// DIRECTORY qualifies, so it is asked with the SOURCE token rather than with `base` — which for a free
	// function contested across directories already carries that qualifier.
	//
	// A METHOD is excluded by `enclosingType`, not by inspecting the name: a method is keyed `Type.method`
	// and can never be in the free-function contest, so asking would answer for an unrelated free function
	// that happens to share the bare spelling.
	function namesACrossFileOverloadedFreeFunction(nameTok Token) returns bool
		if not self.enclosingType.isEmpty() 'aMethodIsKeyedByItsEnclosingType'
			return false
		end 'aMethodIsKeyedByItsEnclosingType'

		return self.signatures.isCrossFileOverloadedFreeFunction(nameTok.value, moduleDirectory: self.signatures.moduleDirectoryOf(self.filePath))
	end 'namesACrossFileOverloadedFreeFunction'

	// ⭐⭐ **THE TWO FACTS THE PRE-PARSE DECLARATION SWEEP PUBLISHES PER BARE NAME, WHICH IS WHY THEY CANNOT
	// BE OVERLOADED** (D7). `ProgramSignatures` is built from a TOKEN sweep before any file is parsed and is
	// keyed by the name the source wrote, so two declarations of one name leave ONE entry — and the parser
	// commits to it STRUCTURALLY, at both ends of a call:
	//
	//   • **CONSUME/FEED bits** decide whether a call MOVES its argument (`applyCallerConsume` poisons the
	//     source binding, so the caller stops dropping it) and whether the callee's own parameter is owned
	//     (`bindParameters`). Applying one member's bits at a call that resolves to another is a LEAK in one
	//     direction and a USE-AFTER-FREE in the other — neither is a diagnosable event later, because the
	//     drop ops are already emitted or already absent by then.
	//   • **The `throws` clause** decides the error-flag ABI at both ends (`E3055`/`E3057`, and which type an
	//     `otherwise (e)` binding recovers). One member's clause read as another's delivers a throw as a real
	//     answer.
	//
	// Both are absence-is-the-answer registries — the sweep records ONLY a consuming function and ONLY a
	// throwing one — so "the name has an entry" catches a divergence whichever member contributed it.
	//
	// ⚠ **THAT LAST STEP IS WHERE THE TWO NOW PART, AND THE THROWS HALF NO LONGER TAKES IT (W77).** "The name
	// has an entry" catches a divergence, but it also catches an AGREEMENT, and an agreeing set has nothing
	// for a call to be told apart by: one error type, recovered whichever member wins. So the throws refusal
	// asks the SWEEP whether the entry can be applied to every declaration wearing the name
	// (`ProgramSignatures.throwsClauseCollide`) rather than whether it exists. The CONSUME half still refuses
	// on existence, and that is the conservative direction for a fact whose divergence mode is a leak or a
	// double free rather than a diagnostic — closing it needs per-member consume bits, below.
	//
	// ⚠ **THE CONSUME HALF ALSO ASKS WHETHER ANY MEMBER CAN TRANSFER ANYTHING, and that is not caution — it
	// is what keeps the rule about ownership rather than about field stores.** The sweep sets a consume bit
	// for ANY `Self{f: p}` store, a SCALAR parameter included, and a scalar transfer is inert at both ends
	// (`transferConsumedArg` returns immediately, and no drop is enrolled for it). So a set of scalar-only
	// constructors — `Counter.create()` beside `Counter.create(value Integer, step Integer)`, which
	// `specs-shv2/structs.md` pins — carries consume bits that decide nothing, and refusing it would be
	// refusing a legal program over a bit no call can act on. The transferable test is what distinguishes
	// the two, and it is asked of EVERY member: a member is recorded with the bit at its own declaration, so
	// the set is refused the moment the managed one joins it, whichever order they are written in.
	//
	// ⚠ **THE FIX IS NOT A BETTER TEST HERE, IT IS PER-MEMBER FACTS IN THE SWEEP** — which needs the sweep to
	// key these tables by something finer than the bare name. Until then this is the boundary, stated where a
	// reader meets it.
	//
	// ⚠ **"AND THAT IS A WHOLE-PROGRAM-QUERY CHANGE WITH A PARSE-MEMO HASH BEHIND IT" WAS THE REST OF THAT
	// SENTENCE, AND THE CHANGE HAS SINCE HAPPENED — FOR A DIFFERENT FACT.** The sweep now publishes each
	// declaration's PARAMETER TYPES and its own RETURN TYPE (`ProgramSignatures.overloadedDeclsOf`, hash and
	// all), which is what lets a call read the return type of the overload it means. It did NOT re-key the
	// four tables above, and doing so is a strictly larger change than that one: a consume bit, a by-reference
	// column, a default and a `throws` clause are each read at a call by NAME, before any member is known, so
	// per-member versions of them need the call site to pick a member for something other than a type — which
	// is the pass boundary each of these four refusals exists because of.
	//
	// ✅ **IT WAS ASKED OF A `static`/INSTANCE PAIR TOO, AND W75 RETIRED THAT.** Such a pair is not an
	// overload set at all: the two take two registration names and are told apart at the call by SYNTAX
	// (`ProgramSignatures.isStaticInstanceContest`). What they used to SHARE is the source name every table
	// named above was keyed by — so the four sentences below were true of them word for word, and the pair was
	// refused on exactly those terms rather than on a rule of its own. The sweep files each member's consume
	// set, by-reference columns, defaults and `throws` clause under that member's OWN key now
	// (`ProgramSignatures.sweepRegistrationKey`), which leaves a pair with nothing shared to be ambiguous
	// about; a pair member reaches this function only as the first declaration of its own base, which is to
	// say not at all.
	//
	// ⚠ It takes the transfer answer as ONE bool rather than the member set, because the two callers know it
	// from different places: the overload path ORs the newcomer's bit over the incumbent members', while a
	// pair member has no member set to consult. The refusal owns the rule; neither caller owns a copy of it.
	function requireOverloadableName(base ByteArray, nameTok Token, transfersOwnership bool) throws ParseError
		if transfersOwnership and overloadBlockingConsume(self.signatures.consumeOf(base)) 'consumingOverload'
			throw ParseError.unsupported("overloading '{String.from(base)}' — one of its declarations MOVES a parameter into durable storage and one of them takes a managed parameter, and the whole-program declaration sweep publishes a function's consume facts under the name the source wrote, so a call to this name cannot be told which overload's ownership transfer to apply (it would leak in one direction and free twice in the other). Give the overloads distinct names", line: nameTok.line, column: nameTok.column)
		end 'consumingOverload'

		// ⭐⭐ **THE `throws` REFUSAL IS ONE SENTENCE AGAIN, AND THAT IS W78's DOING.** It was three: an
		// overload set whose declarations genuinely disagree, plus two claimants whose clause was filed under a
		// key that was NEITHER member's — a `static`/instance pair, and a free function contested across
		// directories — each of which had to say "there is nothing here to compare" in its own sentence. The
		// sweep now files a declaration's clause AND the tallies that judge it under the key the parser asks
		// with (`ProgramSignatures.sweepRegistrationKey`), so both of those keys have a verdict of their own
		// and only the genuine disagreement is left.
		//
		// ⭐⭐ **AND THE BLANKET TEST WAS ONE CONCLUSION TOO STRONG, WHICH IS THE RUNG.** The sentence it rested
		// on is TRUE — the clause is published under the name the source wrote, and a `try` is desugared when the
		// call is PARSED, a whole pass before `SemanticCheck.resolveOverloadedCalls` picks a member. What it
		// missed is that when every member of an overload SET states the same clause there is nothing per-member
		// left to be told apart: the `try` recovers that one error type whichever member wins, and no re-point
		// after resolution is needed — unlike the defaults twin, whose default EXPRESSION does belong to one
		// member (W74). MEASURED against the oracle, which accepts what shv2 refused: two `Chk.want` statics both
		// `throws Boom`, returning 5 and 9, each called under `try … otherwise 0`, answer **14**.
		//
		// ⚠ **THE ORACLE ACCEPTS THE DISAGREEING SETS TOO** (measured: `throws Boom` beside `throws Splat`
		// answers 14, and a throwing member beside a non-throwing one likewise), so this is a CONSERVATIVE
		// refusal rather than a rule of the language. Lifting it needs per-MEMBER facts in the sweep — the
		// boundary this function's header states for all four of these refusals — not a better test. Per-KEY
		// facts, which is what W78 supplied, are a different thing: they separate two DECLARATIONS wearing one
		// source name, not two members of one overload set, which share a registration key by design.
		if self.signatures.throwsClauseCollide(base) 'declarationsDisagree'
			throw ParseError.unsupported("overloading '{String.from(base)}' — its declarations do not all state the same `throws` clause, and the whole-program declaration sweep publishes a function's throws clause under the name the source wrote, so a `try` at a call to this name cannot be told whether the call throws at all or which error type it recovers. The `try` is desugared when the call is PARSED and the overload is resolved a whole pass later, so nothing downstream can repair it. Give every overload the same `throws` clause, or give the overloads distinct names", line: nameTok.line, column: nameTok.column)
		end 'declarationsDisagree'

		// ⚠ **ASKED OF THE WHOLE SURFACE AND NOT ONLY THE OUTRIGHT SPELLING (A2m).** A tuple slot and an array
		// element name the buffer through the same one-entry-per-bare-name sweep and are chosen at the same
		// moment, so an overload set that differs only at a slot has the identical unrepairable ambiguity — the
		// message therefore says NAMES rather than returns.
		if not surfaceIsPlain(self.signatures.declaredReturnSurface(base)) 'bufferReturningOverload'
			throw ParseError.unsupported("overloading '{String.from(base)}' — one of its declarations NAMES `{String.from(ManagedMemoryTypeName)}` in its return type, and the whole-program declaration sweep publishes that SPELLING under the name the source wrote, so a call to this name cannot be told whether its result carries the buffer's member roster or the `Array`'s. The surface is chosen when the call is PARSED and the overload is resolved a whole pass later, so nothing downstream can repair it. Give the overloads distinct names", line: nameTok.line, column: nameTok.column)
		end 'bufferReturningOverload'

		// ⭐⭐ **PARAMETER DEFAULTS WERE THE FIFTH REFUSAL HERE AND ARE NOT ANY MORE (W74).** They were refused
		// on the sentence the four above are refused on — a default is published under the name the SOURCE
		// wrote, and the omitted argument is filled when the call is PARSED, a whole pass before
		// `resolveOverloadedCalls` picks a member — and that sentence is TRUE. What was wrong is the
		// conclusion: it is only unanswerable when the members DISAGREE, and the fill commits to nothing an
		// agreeing set can be wrong about (`SignatureIndex.ParamDefaultInfo.matches` states exactly which
		// facts those are). So the question moved to the SWEEP, which sees every declaration of the name in
		// the whole program rather than the ones this file happens to hold, and the refusal moved to the `=`
		// that writes the disagreeing default (`captureParamDefault`). MEASURED against the oracle, which
		// accepts what shv2 refused: two `Expect.equal` overloads with `message String = "ni"` and
		// `= "nope"`, each returning `message.count()`, answer **6**.
		// ⭐⭐ **A BY-REFERENCE PARAMETER (PBR-2) — the same unattributable-sweep-fact shape as the four above,
		// and the one whose consequence is not a wrong diagnostic but a wrong ABI.** The declaration sweep
		// publishes by-reference columns under the name the SOURCE wrote, and the caller decides whether to
		// hand over an ADDRESS or a VALUE when the call is PARSED — a whole pass before `resolveOverloadedCalls`
		// picks a member. So an overload set whose members disagree would have every call site compiled
		// against whichever declaration the by-name sweep recorded last: the callee would dereference an
		// integer, or read a pointer as its declared type. Nothing downstream can repair it, and unlike the
		// four above there is no diagnostic to be missing — the program simply runs wrong.
		//
		// ⛔⛔ **THE MESSAGE SAYS "ONE OF ITS DECLARATIONS", AND IT CAN STILL FIRE WHERE NEITHER DOES. READ
		// THIS BEFORE BELIEVING A REPORT OF IT.**
		//
		// The by-reference answer it reads is a whole-program CLOSURE that matches a call to a declaration by
		// what the SOURCE WROTE before the `(`, never by resolution (`SignatureIndex.ForwardCall`). Two
		// declarations a spelling cannot tell apart share a node, and a mark on either marks both — so an
		// unrelated user function can make a `stdlib` method by-reference and the mark can travel up to an
		// overloaded name that reassigns and forwards nothing. **The clause is not the thing to weaken**: an
		// overload set really does share one registration key and that key really is the source name, so the
		// sentence is true of this refusal's actual subject. What was wrong is which programs reach it.
		//
		// ✅ **CLOSED, both MEASURED against `stdlib/Array.maxon`'s overloaded `sort`:**
		//   • a ROOT-LEVEL FREE function sharing a `stdlib` METHOD's name — `function swap(n Node)` that
		//     reassigns `n`. A dotted call can never name a root-level free function (it has no qualified
		//     spelling), so the two no longer share a node.
		//   • a user METHOD sharing the name of a `stdlib` method that is only ever called `self.`-qualified —
		//     `Holder.compareAndSwap`, and with it `reverseRange`, `smallSortRange`, `sortNetwork*`,
		//     `driftsortRange` and every other sort helper. A `self.`/`Self.` receiver IS the enclosing type,
		//     statically, so those calls name one type's method and no other's.
		//
		// ⛔ **STILL OPEN, and it is a FALSE REJECT with no workaround but renaming**: a user METHOD sharing
		// the name of a `stdlib` method that is reached through a NON-`self` dotted call. `temp/methodswap`
		// is the measured program — `type Holder` with a reassigning `swap(n Node)` — and it fails on this
		// very line. The carrier is `stdlib/helpers/sort/smallSort.maxon:32`, `Array.swap`'s own
		// `try managed.swap(i, j: j)`: the receiver is a FIELD, so the sweep can read neither its type nor
		// the callee's, and the bare `swap` reaches every method wearing that name. **ATTRIBUTION PROVED BY
		// SABOTAGE, not inferred**: routing that call's two arguments through locals (so the body forwards no
		// parameter) makes the identical program compile and exit 99, then reverted.
		//
		// ⚠ **DO NOT "FIX" IT IN `stdlib`.** Rewriting `Array.swap` to dodge the widening is an accommodation
		// in library source hiding a compiler limitation, and it would hold only until the next stdlib method
		// hands a bare parameter to a dotted call. Closing it needs the RECEIVER'S TYPE at the sweep — either
		// a field-type roster available before bodies are scanned, or an arity/labels test on the edge — and
		// neither is this rung's.
		if self.signatures.calleeTakesAnyParamByRef(base) 'byReferenceOverload'
			throw ParseError.unsupported("overloading '{String.from(base)}' — one of its declarations REASSIGNS a parameter (or hands one to something that does), so that parameter is passed by REFERENCE, and the whole-program declaration sweep publishes that under the name the source wrote. A call to this name cannot be told which overload's parameter is an address, and the choice is made when the call is PARSED while the overload is resolved a whole pass later. Give the overloads distinct names", line: nameTok.line, column: nameTok.column)
		end 'byReferenceOverload'
	end 'requireOverloadableName'

	// Does this signature declare a parameter whose OWNERSHIP a call can transfer — a managed value (String,
	// struct, union, array, generic instance) or an opaque `T`, which `transferConsumedArg` may move as an
	// owned value it cannot see the type of? A scalar cannot: it is inert at a consumed position. The receiver
	// is excluded for the reason every overload key excludes it (`overloadTypeSuffix`) — within one base it is
	// the same value of the same type for every member, and a borrowed receiver transfers nothing anyway.
	function declaresTransferableParam(paramTypes MaxonTypeArray, takesReceiver bool) returns bool
		for i in firstUserParamIndex(takesReceiver) upto paramTypes.count() 'eachParam'
			let paramType = try paramTypes.get(i) otherwise panic("declaresTransferableParam: paramTypes.get OOB at {i} inside its own count()")
			if self.signatures.typeIsManaged(paramType, from: self.artifact.typeNames) or maxonTypeTag(paramType) == ValueTypeTag.typeParameter 'transferable'
				return true
			end 'transferable'
		end 'eachParam'
		return false
	end 'declaresTransferableParam'

	// Record `name` as claimed by this file, COPY-ON-WRITING off the shared empty set before the first
	// insert — see `sharedEmptyDeclaredFuncNames`.
	function claimFuncName(name ByteArray)
		if self.declaredFuncNames is sharedEmptyDeclaredFuncNames 'firstDeclarationInThisFile'
			self.declaredFuncNames = DeclaredFuncNameSet.create()
		end 'firstDeclarationInThisFile'

		self.declaredFuncNames.insert(name)
	end 'claimFuncName'

	// The overload members recorded for `base` so far, MATERIALIZING the incumbent on the first contest.
	// The incumbent's suffixes were never computed — a first declaration renders none, which is what keeps a
	// non-overloading program from building two strings per function — so they are recomputed here from the
	// signature it recorded, on the contest path alone.
	//
	// ⚠ **THERE IS NO INCUMBENT WHEN THE CONTEST IS CROSS-FILE (X-contains).** A name contested by an
	// `extension` in ANOTHER file is contested from this file's very first declaration of it, and the
	// incumbent lives in a file this parser cannot see — so the set starts EMPTY and this file's own first
	// declaration takes a suffix like every later one. `declaredFuncNames` is the exact test, because that is
	// what `recordedSignatureOf` needs to be able to find something.
	function overloadMembersOf(base ByteArray) returns OverloadMemberArray
		if let existing = try self.overloadMembers.get(base) 'alreadyContested'
			return existing
		end 'alreadyContested'

		// COPY-ON-WRITE off the shared empty table before the first overload in this file — see
		// `sharedEmptyOverloadMembers`.
		if self.overloadMembers is sharedEmptyOverloadMembers 'firstOverloadInThisFile'
			self.overloadMembers = OverloadMemberMap.create()
		end 'firstOverloadInThisFile'

		var members = OverloadMemberArray.create()
		if self.declaredFuncNames.contains(base) 'thisFileHoldsTheIncumbent'
			let incumbent = self.recordedSignatureOf(base)
			members.push(OverloadMember.create(base, typeSuffix: self.overloadTypeSuffix(incumbent.paramTypes, takesReceiver: incumbent.takesReceiver()), labelSuffix: overloadLabelSuffix(incumbent.paramNames, takesReceiver: incumbent.takesReceiver()), hasTransferableParam: self.declaresTransferableParam(incumbent.paramTypes, takesReceiver: incumbent.takesReceiver())))
		end 'thisFileHoldsTheIncumbent'

		self.overloadMembers.upsert(base, value: members)
		return members
	end 'overloadMembersOf'

	// The signature this file recorded for `name` — a LINEAR scan of the artifact's contributions, which is
	// affordable because only a contest asks (an overload is rare, and there is one ask per overload member).
	// A map keyed by name would be a second copy of `funcSignatures` paid for by every function in every
	// program to serve the few that overload.
	//
	// It cannot miss: `overloadMembersOf` only asks after `declaredFuncNames` says this file has already
	// registered the name, and every registration is followed by a `recordFuncSignature` under it in the same
	// `parseFunction`.
	function recordedSignatureOf(name ByteArray) returns FuncSignature
		var i = self.artifact.funcSignatures.count()
		while i > 0 'eachEntry'
			i = i - 1
			let entry = try self.artifact.funcSignatures.get(i) otherwise panic("recordedSignatureOf: funcSignatures.get OOB at {i} inside its own count()")
			if entry.name.equals(name) 'found'
				return entry.signature
			end 'found'
		end 'eachEntry'
		panic("recordedSignatureOf: this file registered '{String.from(name)}' but recorded no signature for it — every `parseFunction` records one under the name it claimed")
	end 'recordedSignatureOf'

	// `base#suffix`, counting up an ordinal until this file has not already claimed it. See
	// `overloadRegistrationNameFor`'s uniqueness note for why the ordinal exists and why it is unreachable
	// in practice.
	function unclaimedRegistrationName(base ByteArray, suffix ByteArray) returns ByteArray
		var candidate = overloadRegistrationName(base, suffix: suffix)
		var ordinal = FirstOverloadNameOrdinal
		while self.declaredFuncNames.contains(candidate) 'claimed'
			candidate = overloadRegistrationName(base, suffix: overloadSuffixPart(String.from(suffix), part: "{ordinal}").toByteArray())
			ordinal = ordinal + 1
		end 'claimed'
		return candidate
	end 'unclaimedRegistrationName'

	// The TYPE half of an overload key: every parameter's source-level type name, receiver excluded.
	//
	// ⚠⚠ **THE RECEIVER IS EXCLUDED BECAUSE THE *BASE* CARRIES ITS PRESENCE, NOT BECAUSE IT "DISTINGUISHES
	// NOTHING".** This sentence used to read *"the receiver is the same type for every overload of one method,
	// so it distinguishes nothing"*, and that premise is FALSE of a `static` member beside an instance member:
	// one of them has no receiver at all. It was the sentence that made `same-name-methods.basic` an E3006 —
	// static `getValue()` and instance `getValue()` both rendered the empty suffix and claimed one registration
	// name. What is true, and is now made true by construction rather than assumed, is that every member of
	// ONE BASE agrees about receiver-presence: `overloadRegistrationNameFor` gives a contested static its own
	// base (`staticMemberRegistrationName`), so within a base the receiver genuinely is the same value of the
	// same type. Both references exclude it from their overload key for the same reason and separate the two
	// kinds by NAME, exactly as shv2 now does.
	//
	// A zero-parameter overload renders the EMPTY suffix, which is still a
	// distinct name (`Counter.create#`) because the separator is unconditional: `create()` and
	// `create(value Integer)` are a legitimate arity-only overload pair.
	//
	// `maxonTypeName` is the renderer, not a mangling of its own — so the suffix reads as the source wrote
	// it (`process#String`, `lookup#Registry#bool`) and a ranged alias keeps its own name here, PRE-
	// resolution, where `Integer` and `int` are still two spellings. Two overloads written with two spellings
	// of one underlying type therefore both register, and the resolver reports the pair as ambiguous at the
	// call (E3007) rather than at the declaration — the bootstrap flattens the alias and reports E3006
	// instead. Both refuse the program; only the code and the site differ, and no spec pins either.
	function overloadTypeSuffix(paramTypes MaxonTypeArray, takesReceiver bool) returns ByteArray
		var rendered = ""
		for i in firstUserParamIndex(takesReceiver) upto paramTypes.count() 'eachParam'
			let paramType = try paramTypes.get(i) otherwise panic("overloadTypeSuffix: paramTypes.get OOB at {i} inside its own count()")
			rendered = overloadSuffixPart(rendered, part: maxonTypeName(paramType, typeNames: self.artifact.typeNames))
		end 'eachParam'
		return rendered.toByteArray()
	end 'overloadTypeSuffix'

	// Cursor is AT `typealias`. Append the alias the declaration names, if it is well-formed enough
	// to read one off.
	//
	// TOLERANT, exactly as `recordScannedSignature` is, and for the same reason: a malformed alias
	// is the REAL parse's to report, with a position; a sweep that could veto would reject a correct
	// program the moment it failed to recognize something the parser accepts.
	//
	// It reads through `readTypeAliasDeclaration` — the very routine the real parse reads with — so
	// the sweep and the parse cannot drift into two opinions of what a range MEANS. That shared
	// routine consumes the `typealias` keyword before it can fail, so the cursor always advances and
	// the caller's loop cannot spin.
	//
	// The FORM it read is discarded here alone: the sweep's job is the registries, and the type-name
	// collision the form feeds is decided at the merge from the REAL parse's artifact (whose position
	// is the one a diagnostic must be anchored on).
	// ⚠ **THE SWEEP MUST READ THE `export` ITSELF**, because its walk skips the keyword as an ordinary
	// token and the visibility it drops is the one `RangedAliasRegistry.lookup` resolves by. The
	// cursor's `export` is consumed here rather than in the caller's loop for the same reason the
	// alias's whole grammar is read here: the two passes must agree about what a declaration SAYS, and
	// the fewer places that read a declaration, the fewer can disagree.
	function recordScannedTypeAlias(aliases RangedTypeAliasArray, functionAliases FunctionTypeAliasArray, genericAliases GenericAliasEntryArray)
		let visibility = try self.consumeOptionalVisibility() otherwise return
		_ = try self.readTypeAliasDeclaration(aliases, functionOut: functionAliases, genericOut: genericAliases, tupleOwner: TupleAliasOwner.fileScope, recordFunctionSignature: false, visibility: visibility) otherwise return
	end 'recordScannedTypeAlias'

	// Consume an optional leading `export` / `module` modifier and answer what it means. THE one reader of
	// those two — four walks meet it (the top-level dispatch, a type member, the declaration sweep's typealias
	// arm and its type-body scan) and each used to spell the same four lines, which is one rule written
	// down four times in a file where a fifth walk is always about to be added.
	//
	// ⚠ **`export` NOW MINTS `Visibility.global`, NOT `Visibility.module` (N1a).** The two were
	// indistinguishable while every reader asked `!= Visibility.file`; they are not once `module` names a
	// DIRECTORY SUBTREE. See the `Visibility` enum's header.
	//
	// It THROWS, and the tolerant sweep's callers absorb that with `try … otherwise return` exactly as they
	// absorb a malformed declaration: a modifier conflict is the REAL parse's to report, with a position.
	function consumeOptionalVisibility() returns Visibility throws ParseError
		if self.at(TokenKind.export) 'exported'
			self.advance()
			// The anchor is the SECOND modifier's token and not the first: the modifier that cannot be there is
			// the one the message is about, and it is the oracle's position (`module-keyword`'s 4:8).
			try self.refuseSecondVisibilityModifier(VisibilityModifierWord.wordExport)

			return Visibility.global
		end 'exported'

		if self.at(TokenKind.public) 'publicApi'
			self.advance()
			try self.refuseSecondVisibilityModifier(VisibilityModifierWord.wordPublic)

			return Visibility.public
		end 'publicApi'

		if self.atModuleModifier() 'moduleScoped'
			self.advance()
			try self.refuseSecondVisibilityModifier(VisibilityModifierWord.wordModule)

			return Visibility.module
		end 'moduleScoped'

		return Visibility.file
	end 'consumeOptionalVisibility'

	// A modifier has just been consumed; refuse a second one. Split out because there are now THREE words
	// and so three arms that would otherwise each re-spell "which other modifiers could be here", which is
	// the modifier SET written down a fourth time.
	function refuseSecondVisibilityModifier(consumed VisibilityModifierWord) throws ParseError
		if not self.atVisibilityModifier() 'onlyOne'
			return
		end 'onlyOne'

		let tok = self.current()
		let offending = self.visibilityModifierWordAt(self.pos)

		// Sorted into `VisibilityModifierWord`'s declaration order, NOT the order they were written. Six
		// live cases pin `'export' and 'module' cannot be combined`, so `module export` must render exactly
		// what `export module` renders. The POSITION stays the offending token's either way.
		if consumed.ordinal <= offending.ordinal 'alreadyInOrder'
			throw ParseError.visibilityModifiersCombined(consumed, later: offending, line: tok.line, column: tok.column)
		end 'alreadyInOrder'

		throw ParseError.visibilityModifiersCombined(offending, later: consumed, line: tok.line, column: tok.column)
	end 'refuseSecondVisibilityModifier'

	// Which modifier word sits at `index`. Only ever asked where `visibilityModifierAt` already answered
	// true, so a token that is none of the three is a caller bug rather than an input.
	function visibilityModifierWordAt(index TokenIndex) returns VisibilityModifierWord
		if self.kindAt(index) == TokenKind.export 'exported'
			return VisibilityModifierWord.wordExport
		end 'exported'

		if self.kindAt(index) == TokenKind.public 'publicApi'
			return VisibilityModifierWord.wordPublic
		end 'publicApi'

		if self.moduleModifierAt(index) 'moduleScoped'
			return VisibilityModifierWord.wordModule
		end 'moduleScoped'

		panic("visibilityModifierWordAt: token at {index} is not a visibility modifier")
	end 'visibilityModifierWordAt'

	// ⭐⭐ **`module` IS A CONTEXTUAL MODIFIER, NEVER A LEXER KEYWORD, AND THAT IS A MEASUREMENT.** The word is
	// used as an ORDINARY IDENTIFIER **6,537 times in `maxon-shv2/` alone** (`var module = try
	// queryAllModule(project)`, `module.addFunction(…)`, `module MaxonModule` parameters) and as an enum CASE
	// and a `match` ARM in `specs-shv2/`. D8's keyword-as-a-declared-name rule rescues the NAME positions, but
	// not `module.addFunction(…)` in expression position — that dispatches on `TokenKind` long before any name
	// reader is reached. A `keywordMap` entry is two lines with a four-figure blast radius, and shv2 must
	// compile itself.
	//
	// The recognition is EXACT rather than heuristic: an identifier spelled `module` is the modifier iff the
	// very next token opens a declaration. Nothing may sit between a modifier and what it modifies, and no
	// expression begins with an identifier immediately followed by a declaration keyword.
	function atModuleModifier() returns bool
		return self.moduleModifierAt(self.pos) and declarationOpensAt(self.kindAt(self.pos + 1))
	end 'atModuleModifier'

	// Is the token at `index` the WORD `module`? Split from `atModuleModifier` because the sweep reads the
	// modifier BACKWARDS, from the declaration keyword (`scannedVisibility`), where "the next token opens a
	// declaration" is established by the position itself — re-asking it there would ask about the wrong token.
	function moduleModifierAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.identifier and self.tokenAt(index).value.equals(ModuleModifierName)
	end 'moduleModifierAt'

	// ⭐ **WHICH WORDS ARE VISIBILITY MODIFIERS — ASKED ONCE, BY THE LOOK-AHEAD DOORS.** `atStructFieldKeyword`
	// and `atTypeAliasDeclaration` both need "is a modifier here, whatever it is?" before they can look past
	// it at the keyword they are actually testing for, and each spelled the disjunction itself until this
	// review. Two copies of the modifier SET is the same defect `consumeOptionalExport` was created to end —
	// a third modifier taught to `consumeOptionalVisibility` and to one door would make the other silently
	// read `module`'s successor as an ordinary expression.
	function atVisibilityModifier() returns bool
		return self.visibilityModifierAt(self.pos)
	end 'atVisibilityModifier'

	// The same question at an arbitrary INDEX — split out for `moduleModifierAt`'s reason, one door up: the
	// descriptor-need pre-scan (`Parser.fieldDeclarationAt`) walks a type body by index and parses nothing, so
	// it cannot ask a cursor-relative predicate. One rule, two entry points, and the cursor form is now the
	// indexed one asked at `self.pos`.
	function visibilityModifierAt(index TokenIndex) returns bool
		if self.kindAt(index) == TokenKind.export or self.kindAt(index) == TokenKind.public 'realKeyword'
			return true
		end 'realKeyword'
		return self.moduleModifierAt(index) and declarationOpensAt(self.kindAt(index + 1))
	end 'visibilityModifierAt'

	// ⭐ **AN ALIAS DECLARED IN `stdlib/` IS `global` WHATEVER IT WROTE (P1.9)** — the spec's "reachable
	// as a cast target from any file, regardless of its source-level visibility modifier". Seven of the
	// aliases user code has to be able to name are declared without `export`
	// (`stdlib/Sleep.maxon`'s `Milliseconds` among them), because inside their own module they never
	// needed to be; they appear in the PUBLIC signatures anyway, so a user must be able to write the
	// name in an `as` cast.
	//
	// Called from `readTypeAliasDeclaration` — the ONE reader of the whole typealias grammar, which
	// every declaration site goes through (the real parse, the declaration sweep, and a NESTED alias
	// inside a type body) — so no site can be added that forgets it. `recordTypeName` asks it a second
	// time for the E3062 candidate list, which is the same function answering the same question, not a
	// second copy of the rule.
	//
	// ⚠ **IT IS A PROPERTY OF ALIASES, NOT OF STDLIB MEMBERSHIP**, so it is deliberately NOT applied to
	// a stdlib FUNCTION or top-level binding: a non-exported stdlib method stays uncallable from user
	// code, which `export-keyword/error.stdlib-non-exported-method-is-not-callable` pins.
	function typeAliasVisibility(declared Visibility) returns Visibility
		return Visibility.global if self.isStdlibSource else declared
	end 'typeAliasVisibility'

	// Replace the shared empty with a real array, once, on the first generic type this file declares. EMPTY
	// IS THE TEST because the shared instance is never mutated — the field is the shared one exactly while it
	// is empty — so the swap costs one comparison per generic type and one allocation per file that has any.
	function growDescriptorScanSites()
		if self.descriptorScanSites.count() != 0 'alreadyItsOwn'
			return
		end 'alreadyItsOwn'
		self.descriptorScanSites = DescriptorScanSiteArray.create()
	end 'growDescriptorScanSites'

	// Cursor is AT `type`. Append the struct it declares, plus a `FuncReturnTypeEntry` for each
	// method it declares, and leave the cursor PAST the declaration's `end`.
	//
	// TOLERANT, exactly as `recordScannedSignature` and `recordScannedTypeAlias` are, and for the
	// same reason: a malformed `type` is the REAL parse's to report, with a position. It shares
	// `readTypeHeader`, `atStructFieldKeyword`, `readStructFieldInto` and `recordScannedSignature`
	// with `parseTypeDeclaration`, so the sweep and the parse cannot drift on what a field IS, what
	// a method is CALLED, or where the declaration ENDS — the three facts they must agree on,
	// because the layout THIS pass records is the one the real parse reads every offset out of.
	//
	// ⚠ IT WALKS THE BODY ITSELF rather than letting the caller's loop do it, and the reason is the
	// depth-0 gate on fields: `export var x as Integer` is a FIELD at the type's top level and a
	// LOCAL BINDING one level down, and only a counter that knows where the type's body starts can
	// tell them apart. `depth` here is relative to the body — 0 is directly inside it — and
	// `blockDepthAfter` is the same opener/closer rule the caller counts with, so a method's `if`
	// and `while` nest correctly and its `end` cannot be mistaken for the type's.
	function recordScannedType(structs StructLayoutArray, entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, divergingDecls DivergingDeclEntryArray, innerAliasOut InnerAliasEntryArray, genericAliasOut GenericAliasEntryArray, functionAliasOut FunctionTypeAliasArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray, freeFunctionNameOut ByteArrayArray, conformanceSiteOut ConformanceClauseDeclSiteArray, bindingOut TopLevelDeclArray)
		// The DECLARATION keyword, taken before anything moves the cursor — the position
		// `Queries.foldConformanceClauses` puts a reader back down on. See `ConformanceClauseDeclSite`.
		let declStart = self.pos
		// ⚠ **THE SWEEP MUST READ THE MODIFIER ITSELF**, and BACKWARDS, exactly as `recordScannedBinding`
		// does: the caller's loop meets `export`/`module` as an ordinary token and steps over it, so the
		// cursor arrives here already on the `type` keyword. Read forwards it would answer `file` for every
		// declaration in the program — and the sweep's layout is the one the PARSER resolves every type name
		// against, so the two passes disagreeing about a tier is a wrong answer about what another file may
		// name.
		let visibility = self.visibilityBefore(self.pos)
		let nameTok = try self.readTypeHeader() otherwise return
		self.enterTypeScope(nameTok.value, isEnum: false)

		var layout = StructLayout.create(nameTok.value, visibility: visibility, declFilePath: self.filePath)
		// `uses T` (P1.6-A) — parsed here, in the tolerant sweep, exactly as `parseTypeDeclaration` does
		// it, so the scanned layout carries the SAME parameter list the real parse reads a field's
		// `typeParameter(token)` against. The cursor lands past the clause, at the type body the loop walks.
		self.openTypeParamScope(layout)

		// ⭐ **`implements I1, I2 [with …]` — THE NAMES AND THE FINAL `with` BINDINGS, AND THAT IS WHY IT IS
		// STILL NOT `parseTypeImplementsClause`.** The sweep needs this for exactly one reader: an EXTENSION is
		// expanded onto every type whose clause names its interface — and, when the extension is CONDITIONAL,
		// only onto those whose bindings satisfy its `where` clause — and that expansion must land in the
		// whole-program signature index before any file is parsed. The real parse's `parseTypeImplementsClause`
		// records the richer `ConformanceDecl` (bindings + POSITION) that `checkConformance` verifies from; see
		// `StructLayout.conformsTo` for why the two records are deliberately not one.
		//
		// ⚠ **AN UNPARENTHESIZED `with` STILL ENDS THE READ HERE, so `implements Container with Score, Other`
		// records `Container` alone.** Whether that comma opens a second ARGUMENT or a second INTERFACE is the
		// interface's `uses` ARITY (R7), and the arity is a fact only the COMPLETE index holds — this walk is
		// what builds it. Reading it here as a second interface would be the R7 false reject in the other
		// direction, so the reader stops and the answer is a SUBSET of the clause.
		//
		// ⭐ **AND THAT SUBSET IS NO LONGER THE FINAL ANSWER (W95): THE POSITION IS RECORDED AND THE CLAUSE IS
		// RE-READ WHOLE-PROGRAM.** A type that names an interface after a `with` used to receive none of that
		// interface's extensions, which made the ORDER of a conformance clause change what the program means.
		// `Queries.foldConformanceClauses` puts this same reader back down on `declStart` once
		// `foldInterfaceDeclarations` has made the arity knowable. See `ConformanceClauseDeclSite`.
		//
		// Tolerant like every other read on this walk: a malformed clause records no conformance and leaves
		// the positioned diagnostic to the real parse. The cursor is left wherever the read stopped, which the
		// body loop below steps over token by token exactly as it stepped over the whole clause before.
		// ⚠ **ONLY A CLAUSE THAT WRITES A `with` DEFERS ANYTHING** (`implementsClauseBindsAnything`): the arity
		// this reader cannot know is consulted inside the `with` arm and nowhere else, so a clause without one
		// is read the same by both passes and the re-read would re-derive this answer.
		if self.at(TokenKind.implements) and self.implementsClauseBindsAnything() 'deferredConformances'
			conformanceSiteOut.push(ConformanceClauseDeclSite.create(self.filePath, tokenPos: declStart, declName: nameTok.value, declIsEnum: false))
		end 'deferredConformances'

		self.openConformanceClauseAliasScope()
		let scannedConformances = try self.readOptionalImplementsClause() otherwise ScannedConformanceClause.declaringNothing()
		self.closeConformanceClauseAliasScope()
		layout.recordConformances(scannedConformances.names, bindings: scannedConformances.bindings)

		// The cursor now sits at the type body's first token — captured for the transitive array-feed post-pass
		// (P1.7 slice 3b-iv), which re-walks the body once EVERY method's parameter list is known. `feedStart` marks
		// the point in `paramConsumes` this type's own entries begin, so that post-pass patches only them.
		let bodyStart = self.pos
		let feedStart = paramConsumes.count()
		// ⭐ **AND THE SAME POSITION IS THE DESCRIPTOR-NEED FIXPOINT'S SITE (W23c)** — recorded only for a
		// GENERIC type, because a descriptor carries a TYPE PARAMETER's layout and a type with no `uses`
		// clause can never need one. `openTypeParamScope` has just filled the list, so the test is free.
		if not self.enclosingTypeParams.isEmpty() 'aGenericType'
			self.growDescriptorScanSites()
			self.descriptorScanSites.push(DescriptorScanSite.create(self.filePath, bodyStart: bodyStart, typeName: nameTok.value, bodyIsAnInterfaceExtension: false))
		end 'aGenericType'

		var depth = 0 as BlockDepth
		while not self.isEof() 'body'
			// `closesBlockAt`, not a `TokenKind.end` test of its own — the sweep's twin of
			// `recordScannedInterface`'s fix, and for its reason. Unreachable here today (a member always
			// begins at `export`/`static`/`function`/`var`/`let`/`typealias`/`where`, so a method NAMED `end`
			// is never at this loop head), which is exactly why it must not be left resting on that: the one
			// place the "an `end` may be a NAME" rule lives is `closesBlockAt`, and a scan that spells the
			// test itself is the next reachable panic waiting for a member form to be added.
			if depth == 0 and self.closesBlockAt(self.pos) 'closesType'
				self.advance()
				self.skipOptionalLabel()
				break
			end 'closesType'

			// A NESTED (inner) typealias (P1.6-C / P1.7 slice 3b-i). Gated on depth 0 so a `typealias` inside a
			// method body is left to the outer walk. Read into `enclosingInnerAliases` (so the rest of the body's
			// bare references resolve while the sweep is still building the whole-program index) AND keyed
			// whole-program — a RANGED alias by `base.member` into `innerAliases`, a GENERIC-INSTANCE alias
			// (`Array with T`) under its base-qualified name into `genericAliases` (so `Container.ElementArray`
			// resolves the way a top-level `IntBox` does, and stays distinct from another type's `ElementArray`),
			// and — when the type is not generic and the member is not the type's own name — under its BARE
			// member too, which is the file-scope reading `publishNestedGenericAlias` carries the rule for.
			// Tolerant, like `readStructFieldInto`: a malformed nested alias is the real parse's to report, and
			// stopping here leaves the remaining tokens to the robust outer walk.
			if depth == 0 and self.atTypeAliasDeclaration() 'isInnerAlias'
				let nestedVisibility = try self.consumeOptionalVisibility() otherwise break
				let nested = try self.readNestedTypeAlias(nestedVisibility, recordFunctionSignature: false, tupleOwner: TupleAliasOwner.enclosingType(self.enclosingType)) otherwise break
				match nested 'nested'
					ranged(alias) then innerAliasOut.push(InnerAliasEntry.create(self.enclosingType, alias: alias))
					genericInstance(entry) then self.publishNestedGenericAlias(entry, into: genericAliasOut)
					// A TUPLE alias is keyed whole-program by the reader itself, under the `<Type>.<member>` name
					// `TupleAliasOwner.enclosingType` just gave it — there is no per-declaration column for it to
					// land in, because it mints no identity of its own (see `NestedAliasResult`).
					tupleAlias then break 'nested'
					// Into the FILE's function-alias array, the one a top-level `typealias Fn = function(…)`
					// lands in — under BOTH its bare name and `<Type>.<member>`, because a nested one declares
					// both scopes (see `publishNestedFunctionAlias`).
					functionAlias(alias) then self.publishNestedFunctionAlias(alias, into: functionAliasOut)
				end 'nested'
				continue
			end 'isInnerAlias'

			// `where T is <Interface> …` (P1.7a slice 2a) at the type's top level — recorded on the swept
			// layout so `ProgramSignatures.recordStruct` hashes the constraints and the witness lowering /
			// E3017 read them off `structOf` (the sweep's layout is the whole-program one). Handled here in
			// the body loop rather than pre-consumed after `openTypeParamScope`, so it lands whether or not an
			// `implements` clause (which the loop tolerantly skips token-by-token) precedes it. Tolerant, like
			// `readStructFieldInto`: a malformed `where` is the real parse's to report.
			if depth == 0 and self.at(TokenKind.where) 'isWhere'
				layout.recordWhereConstraints(try self.readWhereClause() otherwise break)
				continue
			end 'isWhere'

			// ⭐⭐ **`static let` / `static var` — A TYPE-QUALIFIED TOP-LEVEL BINDING (W65), swept exactly as a
			// file-scope one is.** It has to be recorded HERE and not by the caller's depth-0 gate for
			// `recordScannedType`'s own reason: this walk consumes the whole `type` declaration, so its members
			// are never offered to the outer loop — and the outer loop could not qualify the name in any case,
			// because only this walk knows which type encloses it.
			//
			// Gated on depth 0 like every other member arm, so a `static` token inside a METHOD BODY is left to
			// the token-by-token walk. `recordScannedBinding` is tolerant like every other reader on this walk:
			// a malformed declaration records nothing and the real parse reports it with a position.
			if depth == 0 and self.staticBindingKeywordAt(self.pos) 'isStaticBinding'
				// The `static` keyword's index is the anchor the visibility is read backwards from: `export
				// static let X` puts `static` where the modifier would otherwise be, exactly as it does for a
				// method (`declaredFunctionVisibility`). The cursor is then seated on the `let`/`var` itself,
				// which is where the shared binding reader begins — the outer walk arrives here on whichever
				// of the three tokens opens the declaration.
				let modifierAnchor = self.pastVisibilityModifier(self.pos)
				self.pos = (modifierAnchor + 1) as TokenIndex
				self.recordScannedBinding(bindingOut, qualifier: self.enclosingType, modifierAnchor: modifierAnchor)
				continue
			end 'isStaticBinding'

			if depth == 0 and self.atStructFieldKeyword() 'isField'
				// Captured BEFORE the read so the field's own index is exact rather than derived from a
				// count that a failed read would leave standing still.
				let fieldIndex = layout.fieldCount()
				// A field the sweep cannot read leaves the layout SHORT, which would put every later
				// field at the wrong offset — so the scan stops rather than recording a layout it
				// knows is wrong. The real parse reports the malformed declaration properly.
				try self.readStructFieldInto(layout) otherwise break
				self.recordScannedFieldDefaultHelper(layout, index: fieldIndex, entries: entries)
				continue
			end 'isField'

			// A method DECLARATION, asked through the same `functionDeclarationAt` the outer sweep asks:
			// a closure literal in a method body spells `function` too, and counting it here overshoots
			// the type's `end` — the sweep then reads the NEXT declaration's members into THIS layout.
			if self.functionDeclarationAt(self.pos) 'isMethod'
				// The method opens a block closed by its own `end`. Counted BEFORE the signature is
				// read, because reading it moves the cursor past the `function` keyword — the caller's
				// loop does exactly this, for exactly this reason.
				depth = depth + 1
				self.advance()
				self.recordScannedSignature(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, divergingDecls: divergingDecls, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut)
				continue
			end 'isMethod'

			depth = self.blockDepthAfter(depth)
			self.advance()
		end 'body'

		// Close the array-feed relation over self-call forwards (P1.7 slice 3b-iv) now every method's parameter list
		// is scanned — marking a forwarder's parameter a feed so its OWN concrete call site consumes the managed
		// argument, exactly as the directly-pushing method's does. Runs before `closeTypeParamScope` so
		// `enclosingType`/`enclosingTypeParams` still name this type.
		self.recordTransitiveArrayFeeds(paramConsumes, bodyStart: bodyStart, feedStart: feedStart)

		structs.push(layout)
		self.closeTypeParamScope()
	end 'recordScannedType'

	// ⭐ **PUBLISH A FIELD DEFAULT'S SYNTHESIZED HELPER WHOLE-PROGRAM (S2f)** — the field twin of
	// `recordScannedParamDefaults`' `entries.push`, and it is on this walk for that routine's exact reason:
	// the helper's RETURN TYPE is what the site that CALLS it needs to type the call it emits
	// (`mintCallResult`), and that site — `applyFieldDefaults`, inside a `Self{…}` — is reached by the real
	// parse long before the drain declares the helper's body. Only the sweep can answer ahead of it.
	//
	// It reads the LAST-READ field rather than being handed the facts, because `readStructFieldInto` is the
	// one shared field reader and must stay one: a second out-parameter on it would be a second place a
	// field's declared type is stated, and the layout it just wrote already holds every fact needed here.
	//
	// ⚠ **THE RETURN TYPE IS THE FIELD'S DECLARED TYPE AND THE SURFACE IS THE FIELD'S DECLARED SPELLING**,
	// both taken from that one write. That is what makes `var buf as __ManagedMemory = makeBuffer()` hand
	// its `Self{}` a value bearing the BUFFER's member roster (A2j / A2m) — hardcoded plain, the default
	// would arrive wearing `Array`'s.
	//
	// ⚠ **THE TIER IS `file`, AND IT IS THE SAME `file` `parseDefaultHelper` STAMPS ON THE `IrFunction`** —
	// deliberately, because a helper's tier is asked of two different registries (this one through
	// `calleeVisibilityFrom`, the `IrFunction`'s through `SemanticCheck.calleeVisibleFrom`) and one
	// declaration must not answer two ways. It is TRUE rather than merely consistent: a struct literal may
	// only be written inside the type's own body, so every call is in the declaring file. Neither reader can
	// actually reach it — a minted callee is exempt from both — which is exactly why a disagreement here
	// would have gone unnoticed.
	function recordScannedFieldDefaultHelper(layout StructLayout, index FieldIndex, entries FuncReturnTypeEntryArray)
		match layout.fieldDefault(index) 'declared'
			// A field with no default, and a LITERAL one, declare no function: the literal is emitted
			// straight into the box (`Parser.fillFieldDefault`) and there is nothing to call.
			none to literal then return
			helper(helperName) then entries.push(FuncReturnTypeEntry.create(helperName, returnType: MaxonReturnType.value(try layout.fieldTypes.get(index) otherwise panic("recordScannedFieldDefaultHelper: fieldTypes.get OOB at {index} for `type {String.from(layout.name)}`, whose field was just written by `readStructFieldInto`")), declaredSurface: layout.fieldDeclaredSurface(index), visibility: Visibility.file))
		end 'declared'
	end 'recordScannedFieldDefaultHelper'

	// ⭐ **CONSUME A WHOLE `interface` DECLARATION IN THE TOLERANT SWEEP (P1.7a slice 1)** — the twin of
	// `recordScannedType`/`recordScannedEnum`, and it MUST walk the body itself for a sharp reason: an
	// interface method is a `function` SIGNATURE with NO body and NO `end`. Left to the sweep's outer loop,
	// each would trip the `function` arm — registering the method as a free function AND incrementing the
	// block-depth counter with no matching `end` to decrement it, corrupting the scan for the rest of the
	// file. So the whole declaration is consumed here and lands the cursor past the closing `end`. An
	// interface body opens no blocks, so the first `end` that is not a NAME closes it.
	//
	// ⭐⭐ **IT RECORDS WHERE THE DECLARATION IS, AND THAT IS ALL IT RECORDS (R8).** A `type`'s layout and an
	// `interface`'s requirements are both read by files that may be parsed before the declaring one, so both
	// have to be whole-program — but they cannot be gathered the same way. A layout is id-free and can be built
	// the moment the sweep reads it; an interface REQUIREMENT is stored as a rendered SOURCE STRING, and one of
	// those spellings (`IrInterface.renderDeclaredTypeName`'s `genericInstance` arm) is a question only the
	// COMPLETE index can answer. Read here, `IntArray` would render as the raw alias name; read by the real
	// parse, as the canonical instance name — two spellings of one type, which is a false ACCEPT on the
	// conformance and a wrong formal at every witness dispatch.
	//
	// So the sweep contributes the ONE thing it uniquely has — the position, in a walk that already knows what
	// a top-level declaration is — and `Queries.foldInterfaceDeclarations` reads the declaration itself once
	// every file has folded. R7's per-header `uses`-arity read is GONE with it: the arity is
	// `associatedTypeNames.count()` on the declaration that pass records, and two sources of one fact is the
	// thing R7 itself deleted.
	//
	// ⚠⚠ **AND "NOT A NAME" IS THE WHOLE OF IT — asked through `closesBlockAt`, never `TokenKind.end`.** D8
	// made a REQUIREMENT's name a declared name (`parseInterfaceMethod` reads it with `consumeNameToken`), so
	// `function end() returns Integer` is a legal interface method — and a raw `end` test stopped the walk ON
	// THAT NAME, returning with the cursor mid-signature. The remaining signatures then fell to the sweep's
	// outer loop, which is exactly the corruption the paragraph above describes: each tripped the `function`
	// arm and left `depth` one too deep, so every `depth == 0` gate — `type`, `enum`, `interface` — stopped
	// firing for the REST OF THE FILE. MEASURED on an interface declaring `end()` plus two more requirements
	// ahead of a `type Cell`: **`panic: requireConstructible: type Cell is being parsed right now, but the
	// declaration sweep never recorded it`**. (With exactly ONE trailing requirement the stray `function`'s
	// +1 happened to cancel the interface's own `end`, so the file compiled — an accident of arithmetic, and
	// the reason this needed a THIRD requirement to show itself.) A keyword-named PARAMETER inside a
	// requirement (`function scale(end Integer)`) is covered by the same call, through
	// `keywordIsAName`'s declaration-name index.
	function recordScannedInterface(sites InterfaceDeclSiteArray)
		// The site is the cursor BEFORE the keyword is consumed, because that is where the reader has to be
		// put back down: `readInterfaceDeclaration` opens by consuming `interface`, exactly as the real parse
		// reaches it.
		// The NAME travels with the site (A1s wave 2, see `InterfaceDeclSite.name`) — read off the token after
		// the keyword, which is the same one `readInterfaceDeclaration` consumes. A malformed header carries
		// the empty name and records nothing the contest can act on, which is the tolerance every sweep entry
		// point keeps: the real parse reports it, with a position.
		sites.push(InterfaceDeclSite.create(self.filePath, tokenPos: self.pos, name: self.identifierNameAt(self.pos + 1)))

		try self.consume(TokenKind.interface) otherwise return
		while not self.isEof() 'body'
			if self.closesBlockAt(self.pos) 'closes'
				self.advance()
				self.skipOptionalLabel()
				return
			end 'closes'
			self.advance()
		end 'body'
	end 'recordScannedInterface'

	// ⭐⭐ **READ THE `interface` DECLARATION AT `tokenPos` INTO THE WHOLE-PROGRAM INDEX (R8).** The second half
	// of `recordScannedInterface`, driven by `Queries.foldInterfaceDeclarations` once every file has folded —
	// which is the whole point of the split (see `recordScannedInterface`, and `InterfaceDeclSite`).
	//
	// It runs the parser's OWN `readInterfaceDeclaration`, the same function `parseInterfaceDeclaration` calls,
	// so there is exactly ONE builder of an `IrInterface` and the swept declaration cannot drift from the
	// parsed one — the discipline `recordScannedType` keeps with `readTypeHeader`, applied where the drift
	// would be silent rather than loud.
	//
	// TOLERANT, exactly as every other sweep entry point is: a declaration this cannot read records NOTHING and
	// leaves the positioned diagnostic to the real parse, which reaches the same tokens moments later and
	// refuses the program. What such an interface costs meanwhile is one unresolvable `with`-arity default and
	// one "not declared" reject at a dispatch — both on a build that is already failing.
	export function foldInterfaceDeclarationInto(index ProgramSignatures, tokenPos TokenIndex)
		self.pos = tokenPos
		let iface = try self.readInterfaceDeclaration() otherwise 'malformed'
			self.clearPendingRequirementParam()
			return
		end 'malformed'
		// The reader may have NOTED an interface-typed requirement parameter. The fold does not refuse — the
		// real parse does, with a position — so the note is dropped rather than carried into the next
		// declaration this same reader folds.
		self.clearPendingRequirementParam()
		index.recordInterfaceDeclaration(iface)
		// ⭐ **AND THE BODY'S GENERIC-INSTANCE TYPEALIASES (W61)** — drained HERE and nowhere else, because
		// this is the one read of an interface that is allowed to write whole-program state. The reader's
		// own interner is handed over with them: their right-hand sides carry `MaxonType`s minted against
		// it, which only the index can remap into its own (`recordInterfaceAliases`).
		index.recordInterfaceAliases(self.interfaceAliasScratch, interfaceName: iface.name, fileTypeNames: self.artifact.typeNames)
	end 'foldInterfaceDeclarationInto'

	// ⭐⭐ **RE-READ THE `implements` CLAUSE OF THE DECLARATION AT `site.tokenPos`, NOW THAT THE ARITY THAT
	// ENDS A `with` IS KNOWN (W95).** The second half of the note `recordScannedType` /`recordScannedEnum`
	// leave behind, driven by `Queries.foldConformanceClauses` — `foldInterfaceDeclarationInto`'s shape, one
	// declaration kind over, and for the sharper version of its reason: there the risk was two spellings of
	// one type, here it is a conformance that is not recorded at all, so the extensions of the interface
	// named after the `with` land on nobody.
	//
	// It runs the SAME `readOptionalImplementsClause` the sweep ran, so there is exactly one reader of this
	// grammar and the two passes cannot drift on what a clause SAYS — only on how much of it they can prove.
	// See that reader for the arity rule that makes one pass stop where the other continues.
	//
	// ⚠ **A CLAUSE THIS CANNOT READ LEAVES THE SWEEP'S RECORD STANDING**, which is the one shape of tolerance
	// that fits here: the sweep's answer is a SUBSET of the clause, and `declaringNothing()` would be a WRONG
	// one. Nothing is closed on that path either — `enterTypeScope` assigns every per-declaration scope
	// unconditionally, so the next site cannot observe the failed one (`Queries.foldInterfaceDeclarations`
	// states the argument for the reader this pass shares with it).
	export function foldConformanceClauseInto(index ProgramSignatures, site ConformanceClauseDeclSite)
		self.pos = site.tokenPos
		// The declaration keyword the sweep stood on — `type`, `enum` or `union` — and the name after it.
		// Stepped over rather than read through `readTypeHeader`, which asserts the `type` keyword: one reader
		// serves both declaration kinds here, and WHICH keyword opened the declaration is a fact the re-read
		// has no use for. `declIsEnum` already carries the only distinction that matters, which registry the
		// answer is written to.
		self.advance()
		let nameTok = try self.consume(TokenKind.identifier) otherwise return
		self.enterTypeScope(nameTok.value, isEnum: site.declIsEnum)

		// ⚠ **THE `uses` CLAUSE IS RE-READ FOR ITS SCOPE ALONE, ONTO NO LAYOUT** — see `openTypeParamNames`,
		// which exists for this caller. A `with` argument is rendered against the declaration's own parameter
		// names (`type Box uses T implements Holder with T` binds `Element := T`), so the scope has to be
		// re-entered; the layout it would otherwise be stamped onto may belong to another declaration of the
		// same name, and that guard belongs in one place.
		_ = self.openTypeParamNames()

		self.openConformanceClauseAliasScope()
		let clause = try self.readOptionalImplementsClause() otherwise return
		self.closeConformanceClauseAliasScope()
		index.refoldConformanceClause(site, clause: clause)
	end 'foldConformanceClauseInto'

	// ⭐ **CONSUME A WHOLE `extension <Interface>` DECLARATION IN THE TOLERANT SWEEP** — the twin of
	// `recordScannedInterface`, recording a POSITION and nothing else for a reason that is stronger here than
	// there: an extension's methods are declared on the CONFORMERS of its interface, and a conformer may be
	// declared in a file this sweep has not reached. See `ExtensionDeclSite`.
	//
	// It walks the body itself and MUST: an extension member is a full method with its own `end`, so the
	// caller's loop would register each under its BARE name as a free function (see the arm that calls this).
	// The depth counter is `recordScannedType`'s — a named `function` opens a block the caller does not count,
	// `blockDepthAfter` counts the rest — and the terminator is asked through `closesBlockAt`, never a raw
	// `TokenKind.end`, because a method may be NAMED `end` (D8).
	function recordScannedExtension(sites ExtensionDeclSiteArray)
		// The site is the cursor BEFORE the keyword is consumed, because that is where the two later passes
		// have to be put back down: both open by consuming `extension`, exactly as the real parse reaches it.
		// The TARGET does not travel with it — each pass reads the header for itself through the one reader
		// (`readExtensionHeader`); see `ExtensionDeclSite` for the dead copy W133 removed and why a copy taken
		// here could not have seen a primitive keyword anyway.
		sites.push(ExtensionDeclSite.create(self.filePath, tokenPos: self.pos))

		try self.consume(TokenKind.extension) otherwise return
		self.skipPastBlockEnd()
	end 'recordScannedExtension'

	// ⭐ **LAND THE CURSOR PAST THE `end` THAT CLOSES THE BLOCK IT IS CURRENTLY INSIDE** — entered anywhere
	// within exactly one open block, and landing just past that block's own `end` and its optional label.
	//
	// FOUR walks need it and they must agree to the token, because they are four answers to "where does this
	// construct stop?": the tolerant sweep steps over a whole `extension`, the whole-program fold steps over
	// each of its METHOD BODIES after taking that method's signature, the fold's driver and the REAL parse
	// step over the whole declaration again after publishing / emitting each conformer's. A second spelling of
	// the extent is a resume point one token off, which reads the next declaration into this one.
	//
	// The depth counter is `recordScannedType`'s: a NAMED `function` opens a block `blockDepthAfter` does not
	// count (it knows `if`/`while`/`match`), a closure literal is `function(` with no name and no `end`, and a
	// closer is asked through `closesBlockAt` — never a raw `TokenKind.end` — because a method may be NAMED
	// `end` (D8). An `extension` keyword is the block opener for its callers' purposes, so they enter with the
	// cursor just past it; the interface name after it is an identifier, which opens and closes nothing.
	function skipPastBlockEnd()
		var depth = 1 as BlockDepth
		while not self.isEof() 'walk'
			if self.functionDeclarationAt(self.pos) 'opensAMethod'
				depth = depth + 1
				self.advance()
				continue
			end 'opensAMethod'

			// The closer test is taken BEFORE the counter moves, because "this token closed the outermost
			// block" is the conjunction of the two and neither half says it alone.
			let closes = self.closesBlockAt(self.pos)
			depth = self.blockDepthAfter(depth)
			self.advance()
			if closes and depth == 0 'closesTheOutermost'
				self.skipOptionalLabel()
				return
			end 'closesTheOutermost'
		end 'walk'
	end 'skipPastBlockEnd'

	// ⭐⭐ **WHICH NESTED `typealias` MEMBERS THIS EXTENSION BODY DECLARES, PUBLISHED ONTO EVERY CONFORMER — AND
	// NOTHING ELSE (F10).** The first of the two passes `Queries.foldExtensionDeclarations` makes over the same
	// sites, and it exists because the second one RESOLVES type names while it fills the alias registries: six
	// files write `export extension Array`, `stdlib/helpers/sort/insertionSort.maxon:14` declares `SortIndex`
	// and the other five spell it bare, so whichever body the fold reached first would resolve that name
	// differently from the ones it reached later — a written name meaning what the directory walk says, which
	// `StdlibLoader`'s header rules out. Names, taken from the tokens alone, are the smallest thing that has to
	// be known ahead of the whole fold for the answer to be a property of the program.
	//
	// ⚠ **IT READS THE HEADER RATHER THAN CARRYING THE CONFORMERS ON THE SITE**, because the conformer list is
	// `extensionTargetConformers`' and both later passes take it from there (`foldExtensionDeclarationInto`'s
	// own ⚠ says why the three must share one answer). A second copy travelling on the site would be that list
	// derived twice, and it could not be derived at the SWEEP in any case: an interface extension's conformers
	// are not known until every file has folded.
	//
	// TOLERANT, exactly as every other sweep entry point: a header it cannot read publishes nothing and leaves
	// the positioned diagnostic to the real parse.
	export function publishExtensionInnerAliasNames(index ProgramSignatures, site ExtensionDeclSite)
		self.pos = site.tokenPos
		let header = try self.readExtensionHeader() otherwise return

		var members = ByteArrayArray.create()
		self.collectNestedAliasMembersInBody(members)
		if members.isEmpty() 'declaresNone'
			return
		end 'declaresNone'

		// ⚠ Published for EVERY conformer, including one a CONDITIONAL extension withholds its methods from.
		// That is deliberate and it is the one place this pass may not follow `foldExtensionDeclarationInto`'s
		// withheld rule: the verdict is what decides whether these declarations are that conformer's, and it is
		// taken per (extension, conformer) by the fold — which is the pass that then declines to publish them.
		// A set that had already applied the verdict would be answering a question this pass cannot yet ask,
		// and the cost of not applying it is bounded: `declaresInnerAlias` reports a name whose declaration the
		// fold withheld, in a body that receives no methods and emits nothing.
		for conformer in extensionTargetConformers(header.target) 'eachConformer'
			for member in members 'eachMember'
				index.recordExtensionInnerAliasMember(joinQualifiedName(conformer, member: member))
			end 'eachMember'
		end 'eachConformer'
	end 'publishExtensionInnerAliasNames'

	// ⭐⭐ **PUBLISH THE `extension` AT `tokenPos` ONTO EVERY CONFORMER, IN THE WHOLE-PROGRAM INDEX.** The
	// second half of `recordScannedExtension`, driven by `Queries.foldExtensionDeclarations` once every file
	// has folded — which is the whole point of the split.
	//
	// ⭐ **IT IS THE SAME `recordScannedSignature` A `type`'s OWN METHOD GOES THROUGH, RUN ONCE PER
	// CONFORMER WITH `enclosingType` SET TO THAT CONFORMER.** So `function count() returns Integer` inside
	// `extension Countable` publishes exactly what `function count() returns Integer` written inside
	// `type IntList` would have published, under exactly the name `declaredMethodName` gives it —
	// `IntList.count`. Nothing downstream learns that extensions exist: a call site types `list.count()`
	// through the ordinary method door.
	//
	// ⚠ **THE CONFORMER LIST AND ITS ORDER ARE `conformersOf`'s, AND THE REAL PARSE WALKS THE IDENTICAL ONE.**
	// A signature published here with no body emitted there — or the reverse — is a link failure at best and
	// a call typed against the wrong declaration at worst, so the two halves share one answer rather than each
	// deriving "which types conform".
	//
	// TOLERANT, exactly as every other sweep entry point: a member it cannot read publishes nothing and
	// leaves the positioned diagnostic to the real parse, which reaches the same tokens moments later.
	export function foldExtensionDeclarationInto(index ProgramSignatures, site ExtensionDeclSite)
		var entries = FuncReturnTypeEntryArray.create()
		var paramConsumes = ParamConsumeEntryArray.create()
		var paramReassigns = ParamReassignEntryArray.create()
		var globalAliasReturns = GlobalAliasReturnEntryArray.create()
		var paramDefaults = ParamDefaultEntryArray.create()
		var throwsEntries = ThrowsClauseEntryArray.create()
		// ⭐ Per-function DIVERGENCE (G17) — recorded from the SAME token walk. One entry per function whose body
		// PROVABLY cannot return, so a bare call to it can be told that it ends its caller's block.
		var divergingDecls = DivergingDeclEntryArray.create()
		var methodInnerAliasParamOut = MethodInnerAliasParamEntryArray.create()
		// ⭐⭐ **AN EXTENSION BODY'S NESTED TYPEALIASES, KEYED WHOLE-PROGRAM UNDER EACH CONFORMER (W3).** They
		// were not, and the two things that followed were both real: a `typealias` member ENDED this walk, so
		// every method declared after one published no signature at all; and a generic-instance alias reached
		// the real parse's `enclosingInnerAliases` without reaching `genericAliases`, so `ElementArray\{\}`
		// inside `stdlib/Interfaces.maxon`'s `extension Iterable` was refused as "never keyed whole-program".
		// The keying is per CONFORMER and that is the whole of why it works: the interface's associated types
		// are substituted by this conformer's `with` bindings (`openExtensionBodyScope`), so `IntSeq`'s
		// `ElementArray` interns `Array with Integer` while another conformer's interns its own — the same
		// `<Type>.<member>` key a nested alias of a `type` body takes (`recordScannedType`).
		var innerAliasOut = InnerAliasEntryArray.create()
		var genericAliasOut = GenericAliasEntryArray.create()
		var functionAliasOut = FunctionTypeAliasArray.create()
		// An extension member is always a METHOD or a nested typealias (`enclosingType` is the conformer), so
		// nothing is ever pushed here — but `recordScannedSignature` writes through the parameter, and passing
		// a shared empty to a routine that MAY push is how a shared empty stops being empty.
		var freeFunctionNameOut = ByteArrayArray.create()
		// ⭐ **AN EXTENSION BODY IS A DESCRIPTOR-NEED SITE TOO, AND ITS ABSENCE WAS A COMPILER ABORT (W23c).**
		// One per (extension body, GENERIC conformer): the methods published here belong to that conformer, so
		// they sit in the same fixpoint — under the same `Type.method` keys — as the methods of its own body.
		// A non-generic conformer contributes none, for `recordScannedType`'s reason.
		var descriptorScanSiteOut = DescriptorScanSiteArray.create()

		self.pos = site.tokenPos
		// It cannot fail — the site was recorded AT this keyword — but the sweep's discipline is that a read it
		// cannot make publishes nothing rather than throwing.
		let header = try self.readExtensionHeader() otherwise return
		// Where each conformer's pass restarts — read ONCE, exactly as `parseExtensionDeclaration` does it, so
		// the header is not re-parsed per conformer and the two passes agree about where a body begins.
		let bodyStart = self.pos
		// The whole `where` clause, rendered ONCE per declaration rather than per withheld method: it is a
		// property of the extension, and every skip this fold files quotes the same sentence.
		let clause = renderWhereConstraints(header.constraints, paramNames: extensionTargetParamNames(header.target))

		for conformer in extensionTargetConformers(header.target) 'eachConformer'
			self.pos = bodyStart
			self.enterTypeScope(conformer, isEnum: false)
			self.openExtensionBodyScope(header, conformer: conformer, index: index)

			// ⭐⭐ **THE CONFORMANCE THIS EXTENSION DECLARES IS FILED WHOLE-PROGRAM HERE, *BEFORE* THE VERDICT,
			// AND THE POSITION IS THE OPPOSITE OF `parseExtensionDeclaration`'s ON PURPOSE (review of W90).**
			// There the record is the program's own answer to *"does this conformer implement this?"*, so it
			// must sit past the clause. This one exists for a SUPPRESSION
			// (`ProgramSignatures.instantiationViolatesItsOwnWhereClause`), which is sound only while its index
			// is a SUPERSET of the merged one the E3017 report reads — so an over-grant here can only withhold
			// a suppression and restore a loud over-refusal, where an under-grant is a silent accept. Filing
			// unconditionally is the direction that cannot fail quietly; see
			// `ProgramSignatures.extensionDeclaredConformances`.
			index.recordExtensionDeclaredConformances(conformer, declares: header.interfaces)

			// ⭐ **THE CONDITIONAL FILTER, TAKEN ONCE PER CONFORMER.** An INTERFACE extension's `where` clause
			// is checked against what this conformer binds the interface's associated types to; a TYPE
			// extension's is not checkable here at all (the parameters are bound per INSTANTIATION) and becomes
			// witness constraints instead — see `ExtensionTarget`. Both answers are pure functions of the
			// whole-program index, which is what lets `parseExtensionDeclaration` take the identical one.
			let verdict = self.extensionConformerVerdict(header, conformer: conformer, index: index)

			// ⭐⭐ **A WITHHELD CONFORMER GETS NO SITE, AND THAT GATE IS THE VERDICT'S — NOT A SECOND RULE
			// (found at review).** A CONDITIONAL extension the conformer does not satisfy publishes it no
			// methods at all: the fold files a `ConditionalExtensionSkip` instead of a signature, and the real
			// parse skips the conformer whole. Scanned anyway, this body files `<Conformer>.<method>` seeds for
			// methods that do not exist on that conformer — and a name a real method of it already wears is
			// OVERWRITTEN, because the fixpoint's columns are keyed by that name alone.
			// **MEASURED at review, on this rung's own tip: a `where Item is Comparable` extension declaring
			// `slotSize()`, withheld from a `Bag uses T` that declares its own `slotSize()` returning
			// `sizeof(T)`, erased that method's seed — `panic at LowerMaxonToStd.maxon:1644: lowerSizeofType:
			// sizeof(T) in 'Bag.slotSize' but the function carries no layout descriptor parameter`**, with no
			// position and no `error E….`, on a program the merge base and the oracle both compile and run.
			// It cannot be caught as a duplicate declaration either: a withheld method publishes no signature,
			// so E3006 never sees two.
			//
			// ⚠ The site is recorded HERE rather than beside `openExtensionBodyScope` for exactly that reason —
			// the verdict is what says whether these methods are this conformer's, and a site taken before it
			// is a scan of a body that was never this type's.
			if not extensionMethodsWithheld(verdict) and index.structDeclaresTypeParams(conformer) 'aGenericConformerThatKeepsThem'
				descriptorScanSiteOut.push(DescriptorScanSite.create(self.filePath, bodyStart: bodyStart, typeName: conformer, bodyIsAnInterfaceExtension: extensionTargetIsAnInterface(header.target)))
			end 'aGenericConformerThatKeepsThem'

			while not self.isEof() 'members'
				self.skipNewlines()
				if self.closesBlockAt(self.pos) 'closesExtension'
					break
				end 'closesExtension'

				// The member header is read through the SAME two readers `parseTypeMember` reads it through —
				// `consumeOptionalVisibility` (so a contextual `module` is recognized identically) and the bare
				// `static` test — so the sweep and the real parse cannot disagree about which member takes a
				// receiver. A member neither understands ends the scan for this conformer rather than being
				// stepped over: half a signature set is worse than none, and the real parse refuses the
				// declaration with a position moments later.
				let memberVisibility = try self.consumeOptionalVisibility() otherwise break

				// A NESTED TYPEALIAS, read exactly as `recordScannedType` reads one and keyed under the SAME
				// `<Type>.<member>` name — the conformer's, because that is `enclosingType` here. It is read
				// BEFORE the `static` test because a nested alias takes no `static` (the real parse refuses one
				// that does), and continuing rather than breaking is what lets the methods below it publish.
				// Tolerant like every other read on this walk: a malformed alias publishes nothing and leaves the
				// positioned diagnostic to the real parse.
				if self.atTypeAliasDeclaration() 'nestedTypeAlias'
					// ⚠ **THE TUPLE FORM'S KEY IS DECIDED BY THE VERDICT, BEFORE THE READ, AND IT MUST BE** — the
					// `unpublished` owner is the "READ ALWAYS, PUBLISH ONLY WHEN THE EXTENSION IS THIS CONFORMER'S"
					// rule below, applied to the one alias form the READER publishes rather than the caller
					// (see `TupleAliasOwner`). Every other form is filed after the withheld test; this one cannot be.
					let nestedTupleOwner = TupleAliasOwner.unpublished if extensionMethodsWithheld(verdict) else TupleAliasOwner.enclosingType(conformer)
					let nested = try self.readNestedTypeAlias(memberVisibility, recordFunctionSignature: false, tupleOwner: nestedTupleOwner) otherwise break

					// ⚠ **READ ALWAYS, PUBLISH ONLY WHEN THE EXTENSION IS THIS CONFORMER'S** — the withheld
					// method rule applied to a declaration instead of a signature, and for its reason. The READ
					// must run whatever the verdict is, or the cursor lands somewhere a published one would not;
					// the PUBLISH must not, because a CONDITIONAL extension withheld from this conformer gives it
					// no members, and keying `Box.TagArray` anyway would make the extension's private vocabulary
					// nameable on a type that receives none of its methods (`parseTypeReference`'s inner-alias arm
					// resolves that spelling). The real parse skips the conformer whole, so nothing here would
					// have been looked up — which is precisely why it must not be published.
					if extensionMethodsWithheld(verdict) 'notThisConformers'
						continue
					end 'notThisConformers'

					match nested 'nested'
						ranged(alias) then innerAliasOut.push(InnerAliasEntry.create(self.enclosingType, alias: alias))
						genericInstance(entry) then genericAliasOut.push(self.qualifiedInnerGenericAlias(entry))
						// Already keyed (or deliberately not) by the reader, off `nestedTupleOwner` above.
						tupleAlias then break 'nested'
						// ⭐⭐ **AND THE FUNCTION FORM IS PER-CONFORMER TOO — IT IS THE READING INSIDE THE BODY THAT
						// IS, WHICH IS WHY IT TOOK A SECOND KEY RATHER THAN A DIFFERENT ONE (W49b).** This comment
						// read "one name however many conformers there are, and the last fold wins" and stated it
						// as settled; it was the defect. `ElementTransform` is `function(Byte) returns Byte` in
						// `ByteView`'s fold and `function(Character) returns Character` in `String`'s, so one key
						// cannot hold both and `map`'s own body stopped type-checking once a third element type
						// joined them. Filed under BOTH names by `publishNestedFunctionAlias`: the bare one keeps
						// the file-scope reading a top-level `typealias Fn = function(…)` has, and the
						// `<conformer>.<member>` one is what the body resolves — the same `<Type>.<member>` key
						// the three per-instance forms above take, for the same reason.
						functionAlias(alias) then self.publishNestedFunctionAlias(alias, into: functionAliasOut)
					end 'nested'
					continue
				end 'nestedTypeAlias'

				if self.at(TokenKind.static) 'staticMember'
					self.advance()
				end 'staticMember'
				if not self.functionDeclarationAt(self.pos) 'notAMethod'
					break
				end 'notAMethod'

				self.advance()
				let methodName = self.current().value
				// Which witness parameters this method will carry, filed in the same act that publishes its
				// signature — see `ProgramSignatures.witnessConstraintsOfMethod`. Above the verdict because a
				// TYPE extension's methods are never withheld (its clause is not a filter), so this is not on
				// the withheld path at all.
				self.noteTypeExtensionWitnessConstraints(index, header: header, conformer: conformer, methodName: methodName)

				// ⚠ **A WITHHELD METHOD IS STILL READ, INTO ARRAYS THAT ARE THROWN AWAY.** What must not
				// happen is that it is PUBLISHED; what must not happen either is that the cursor lands anywhere
				// but where a published one leaves it, and the only way to guarantee that is to run the same
				// reader over it. A second, shorter walk of a signature is exactly the resume point one token
				// off that `skipPastBlockEnd`'s header warns about.
				// ⭐⭐ **THE CONFORMER'S OWN DECLARATION SHADOWS THE EXTENSION'S (W43), AND THE DECISION IS TAKEN
				// HERE AND RECORDED.** `stdlib/Map.maxon` declares `contains(key Key)` and
				// `stdlib/Interfaces.maxon`'s `extension Iterable` declares `contains(predicate …)`: both wanted
				// to be `Map.contains`, and the result was `E3006 duplicate definition of function
				// 'Map.contains'` — with the extension's signature having ALREADY overwritten the type's in the
				// index on the way there, which is the wrong-answer half nothing reported.
				//
				// ⚖ **BOTH REFERENCES MAKE THIS AN OVERLOAD AND shv2 CANNOT, WHICH IS WHY IT SHADOWS.** The
				// bootstrap re-parses the extension body as a member of the conformer, so `MangleOverloadName`
				// distinguishes `contains(self, key)` from `contains(self, predicate)`; v1's
				// `tryRegisterOverload` re-keys the incumbent. Both registries are WHOLE-PROGRAM. shv2's is
				// deliberately PER FILE — `overloadRegistrationNameFor`'s own header states the boundary, "two
				// FILES declaring one name still collide at the merge" — and a conformer and the extension over
				// it are in different files by construction here. Making it an overload therefore needs the
				// per-member whole-program facts that header names as a rung of its own.
				//
				// So the rule shv2 takes is the one an interface extension already means: its methods are
				// DEFAULT implementations, and a conformer that declares the name has said what it means there.
				// It is also the bootstrap's own rule for CONDITIONAL extensions
				// (`FilterConflictingExtensionMethods`, `2-Parser.cs:4925-4944`: *"Skip this extension method if
				// the same specific overload already has a body"*), applied to every extension rather than to
				// the one arm that happened to have it. ⚠ The capability it costs is real and is named: a
				// conformer's own `contains` HIDES `Iterable.contains(predicate)` on that type, where both
				// references would offer both. Nothing in `/specs` calls the hidden one.
				let qualifiedMethodName = qualifiedMethodName(conformer, methodName: methodName)
				let shadowed = index.conformerDeclaresOwnMethod(qualifiedMethodName)
				if shadowed 'theConformerDeclaresItsOwn'
					index.noteExtensionShadowedMethod(qualifiedMethodName)
				end 'theConformerDeclaresItsOwn'

				match verdict 'verdict'
					satisfied then self.publishOrShadowExtensionMethod(index, shadowed: shadowed, qualifiedMethodName: qualifiedMethodName, entries: entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, divergingDecls: divergingDecls, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut)
					unmet(unmetInterfaceName, bindingName) then self.foldWithheldExtensionMethod(index, conformer: conformer, methodName: methodName, clause: clause, unmetInterfaceName: unmetInterfaceName, bindingName: bindingName)
				end 'verdict'
				// `recordScannedSignature` leaves the cursor at the method BODY's first token, i.e. inside the
				// one block the method's own `end` closes — exactly this walk's entry condition.
				self.skipPastBlockEnd()
			end 'members'

			self.closeTypeParamScope()
		end 'eachConformer'

		// Folded through `ProgramSignatures.foldFile` — the SAME door a file's own declarations go through, so
		// there is one place that decides what a scanned signature means. Everything an extension does not
		// contribute is passed empty; the type-name interner is this reader's own artifact's, exactly as the
		// per-file sweep passes its own.
		index.foldFile(entries, aliases: RangedTypeAliasArray.create(), functionAliases: functionAliasOut, structs: StructLayoutArray.create(), enums: EnumLayoutArray.create(), genericAliasEntries: genericAliasOut, innerAliasEntries: innerAliasOut, methodInnerAliasParamEntries: methodInnerAliasParamOut, interfaceSites: InterfaceDeclSiteArray.create(), extensionSites: ExtensionDeclSiteArray.create(), conformanceSites: ConformanceClauseDeclSiteArray.create(), scanSites: descriptorScanSiteOut, bindings: TopLevelDeclArray.create(), paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, divergingDecls: divergingDecls, freeFunctionNames: freeFunctionNameOut, moduleDirectory: index.moduleDirectoryOf(self.filePath), filePath: self.filePath, fileTypeNames: self.artifact.typeNames, isStdlibSource: self.isStdlibSource)
	end 'foldExtensionDeclarationInto'

	// ⭐⭐ **`extension <Name> [where <constraints>]` — THE ONE READER OF THE HEADER, for the three passes that
	// meet it** (conditional extensions). The cursor enters on `extension` and lands on the body's first
	// token. Every fact the two later passes disagree about at their peril comes out of here: WHICH types get
	// the methods, under WHAT condition, and the NAME token a malformed clause is blamed on.
	//
	// ⚠ **THE `where` CLAUSE'S PARAMETER NAMES ARE THE TARGET'S, AND THE SCOPE IS OPENED AROUND THE CLAUSE
	// READ AND CLOSED AGAIN AT ITS END.** `readWhereClause` resolves each constrained name to a POSITION in
	// `enclosingTypeParams` and refuses a name that is not in it — which is exactly the check wanted here,
	// provided the list it checks against is the extended declaration's (an interface's associated types, a
	// type's `uses` list) and not whatever declaration the file was last inside. That is why the assignment is
	// here and not at the call sites: a caller that forgot it would not fail, it would resolve `Element`
	// against a stale list.
	//
	// ⛔⛔ **AND IT IS CLOSED AGAIN BECAUSE THIS IS THE ONE WRITER OF THAT FIELD THAT DOES NOT ALSO WRITE
	// `enclosingType`, AND SINCE W14 THE TWO ARE READ AS A PAIR (W14 review).** `parseTypeReference` mints a
	// `typeParameter` as `typeParamTokenFor(self.enclosingType, paramName: name)` for any `name` in
	// `enclosingTypeParams`, and `recordStruct`/`recordInterfaceDeclaration` file an owner for exactly the
	// pairs a DECLARATION makes. Left standing, this assignment publishes the target's parameter names under
	// an `enclosingType` that is not the target — which is what happened whenever the header belonged to an
	// INTERFACE EXTENSION NO TYPE IMPLEMENTS: `extensionTargetConformers` is empty, the conformer loop that
	// would have called `enterTypeScope` never runs, and the names stayed live at FILE SCOPE for the rest of
	// the parse.
	// ⚠ MEASURED on the unchanged tree, and the two symptoms are one bug at two depths:
	//   `function f(x Element) returns Element` after such an extension COMPILED CLEAN — `Element` names no
	//     declared type, and the merge base accepted it too, so this half is older than W14;
	//   the same `f` returning a generic instance PANICKED the compiler at
	//     `ProgramSignatures.opaqueTypeParamPosition` ("type-parameter token … has no owner"), because
	//     `SemanticCheck.checkTypeParameterArgsAt` asks that door for the formal's position and no fold ever
	//     filed an owner for `("", Element)`. The merge base compiled and ran that program (exit 7).
	// Closing the window makes both the correct **E3011 Unknown type 'Element'**.
	//
	// ⚠ A `readWhereClause` that THROWS leaves the window open, and that is bounded rather than ignored: a
	// `ParseError` in the real parse abandons the whole file (`abortedParseArtifact`), and in the fold the
	// throw is swallowed by `foldExtensionDeclarationInto`'s `otherwise return`, whose only successor is the
	// next site's own call to this reader — which overwrites the field before anything reads it.
	function readExtensionHeader() returns ExtensionHeader throws ParseError
		try self.consume(TokenKind.extension)
		// ⭐⭐ **THE TARGET IS READ THROUGH THE TYPE-BASE READER, NOT `consume(TokenKind.identifier)`, AND THAT
		// ONE LINE IS THE WHOLE OF W133's PARSE HALF.** Three of Maxon's types are spelled with a KEYWORD
		// (`Lexer.keywordTable`), so `extension int` arrived here as `E2010 Expected identifier but got 'int'` —
		// a refusal of the very declaration `stdlib/PrimitiveExtensions.maxon` opens with and both references
		// accept. `typeBaseTokenAt` is ALREADY the compiler's one answer to *"which token names a type here?"*:
		// it re-mints a primitive keyword as an identifier-kinded token carrying the keyword's own spelling,
		// line, column and span, so every reader below — `extensionTargetOf`, `enterTypeScope`,
		// `declaredMethodName`, the `where` clause's blame token — serves a primitive without learning that a
		// keyword got here. Widening this reader instead would have been a second table of "which keywords name
		// types", which is the one-fact-written-twice bug this file keeps paying for.
		//
		// ⚠ **AND IT IS WIDENED IN EXACTLY ONE PLACE BECAUSE THIS IS THE ONE READER** (see this function's
		// header): the pre-scan, the whole-program fold and the real parse all come through here, so the three
		// cannot come to disagree about whether `int` names a target.
		//
		// ⚠ It also admits `Self`, which the reader resolves to the enclosing declaration's name — and an
		// `extension` is always at file scope, so that path is `requireEnclosingTypeName`'s positioned
		// *"'Self' outside a type declaration"* rather than the `E2010` it used to be. A strictly better
		// sentence about the same rejected program; no case in the corpus writes it.
		let nameTok = try self.consumeTypeBaseToken()
		let target = self.signatures.extensionTargetOf(nameTok.value)

		// ⭐ **THE `implements` CLAUSE IS READ BEFORE THE `where`, WHICH IS THE ORDER THE LANGUAGE WRITES
		// THEM** (`extension Array implements Hashable, Equatable where Element is Hashable and Equatable`).
		// It reuses the `type` declaration's own reader — one grammar for one clause — so an associated-type
		// binding (`implements Iterable with (Element, Iter)`) means here exactly what it means there.
		let interfaces = try self.readImplementsList()

		if not self.at(TokenKind.where) 'unconditional'
			return ExtensionHeader.create(nameTok, target: target, interfaces: interfaces, constraints: sharedEmptyWhereConstraints)
		end 'unconditional'

		self.enclosingTypeParams = extensionTargetParamNames(target)
		let constraints = try self.readWhereClause()
		self.enclosingTypeParams = self.emptyTypeParams

		return ExtensionHeader.create(nameTok, target: target, interfaces: interfaces, constraints: constraints)
	end 'readExtensionHeader'

	// The parser state an extension BODY is read under, for whichever door the extension came through — set
	// after `enterTypeScope(conformer)`, which deliberately clears every one of these.
	//
	// ⚠⚠ **AN INTERFACE EXTENSION'S BODY NEVER GETS THE *INTERFACE'S* ASSOCIATED NAMES AS TYPE PARAMETERS, AND
	// THAT IS NOT AN OMISSION.** Its `where` clause names those associated types, which this body may not
	// refer to as type PARAMETERS: they are bound concretely per conformer, and installing them in
	// `enclosingTypeParams` would make a written `Element` resolve to a parameter of the CONFORMER — a
	// different type, silently. Its constraints are a filter that has already been applied by the time this is
	// called (`extensionConformerVerdict`), so there is nothing left for the body to dispatch through either.
	//
	// ⭐ **WHAT THE ASSOCIATED NAMES GET INSTEAD IS THE NAME SUBSTITUTION** (conditional extensions), which is
	// available here for exactly the reason the parameter reading is wrong: this pass is monomorphizing for ONE
	// conformer, and that conformer's `implements … with …` says what its `Element` IS. See
	// `Parser.extensionAssociatedTypeNames` and the ⚠ in `parseTypeReference`.
	//
	// ⭐ **THE CONFORMER'S OWN `uses` PARAMETERS ARE A DIFFERENT LIST AND ARE INSTALLED** — see the block
	// at the assignment below for why the two are not the same fact, and for the two things that break
	// without it.
	function openExtensionBodyScope(header ExtensionHeader, conformer ByteArray, index ProgramSignatures)
		// ⭐⭐ **AN EXTENSION BODY RESOLVES A BARE NESTED-ALIAS MEMBER AGAINST THE WHOLE PROGRAM, NOT AGAINST ITS
		// OWN BODY WALK (F10)** — set FIRST, ahead of the `undeclaredTarget` return, because it is a property of
		// being an extension body and not of which kind of target the extension has. See `namesInnerAliasHere`
		// for the rule and for why the type's OWN body deliberately does not get it.
		self.innerAliasesFromIndex = true

		match header.target 'target'
			interfaceExtension then self.openInterfaceExtensionBodyScope(header, conformer: conformer, index: index)
			undeclaredTarget then return
			// A TYPE extension's body IS inside the extended type's own parameter scope: `function matches(other
			// Item)` names the type's `uses` parameter, and `item == other` dispatches `Equatable.equals` through
			// the hidden witness the constraint reserves — the same two mechanisms a `where` clause written on
			// the `type` itself drives, reached through the same two fields. It installs NO substitution: its
			// parameters are bound per INSTANTIATION, so there is no single binding to substitute.
			typeExtension then self.openTypeExtensionBodyScope(header, index: index)
		end 'target'
	end 'openExtensionBodyScope'

	// ⭐ **THE INTERFACE-EXTENSION ARM'S BODY, WHICH USED TO BE THE TAIL THIS FUNCTION FELL OUT INTO.**
	//
	// ⛔⛔ **RETURNING A VOID CALL IS NOT VALID (user ruling, 2026-08-23), AND THE `typeExtension` ARM WAS
	// DOING IT.** `return self.openTypeExtensionBodyScope(…)` hands back a callee that declares no return
	// type — `specs-shv2/void-call-result.md` makes a void call's result unusable in every expression
	// position, `return <expr>` included. It was written that way because a `match` arm is exactly ONE
	// statement (`specs/match-statements.md`), so an arm could not both do its work AND leave the function
	// ahead of the tail below.
	//
	// ⭐ **THE CURE IS TO MAKE THE CLASSIFICATION TERMINAL** — every arm now CALLS and none falls out, so the
	// tail needs a name instead of a fallthrough. It is the same cure `LowerMaxonToStd`'s four residues took
	// (`appendRuntimeCall` / `appendThrowingCall` / `appendStdUnaryOp`), and for the same reason.
	//
	// ⚠ The bootstrap ACCEPTS the old spelling, and that is a hole in it rather than a rule: it refuses a
	// plain `return voidFn()` with E2004 and admits this one only because the `self.method()` route hands
	// back the RECEIVER as the call's value, after which `CheckReturnType` bails on a null return type.
	function openInterfaceExtensionBodyScope(header ExtensionHeader, conformer ByteArray, index ProgramSignatures)
		// ⭐⭐ **A GENERIC CONFORMER'S OWN `uses` PARAMETERS ARE INSTALLED, AND THAT IS NOT THE THING THE ⚠ ABOVE
		// FORBIDS.** What must never be installed is the INTERFACE's associated names — that would make a
		// written `Element` resolve to a parameter of the CONFORMER, a different type. These are the
		// CONFORMER's own names, and this body is being specialized for exactly that conformer: `Box.map` IS a
		// method of `type Box uses T`, so a `T` reachable here means `Box.T` and can mean nothing else. The
		// substitution and the scope compose rather than compete — `Element` is rewritten to the binding the
		// conformer wrote (`T`), and the scope is what then gives that name a type at all.
		//
		// ⛔ **WITHOUT IT, `extension Iterable`'s BODY CANNOT BE PARSED FOR ANY GENERIC CONFORMER** — its
		// `typealias ElementArray = Array with Element` substitutes to `Array with T` and `T` names nothing:
		// **`E3011 stdlib/Interfaces.maxon:195:38: Unknown type 'T'`**, five times, for a legal program the
		// oracle runs. That is why no generic type in the corpus implemented `Iterable` before this assignment
		// existed — the conformance was unrepresentable, not merely unused.
		//
		// ⛔⛔ **AND THE WITNESS SLOTS MUST BE INSTALLED IN THE SAME ACT, OR THE BODY RESERVES ZERO ARGUMENT
		// REGISTERS WHILE EVERY CALLER FILLS TWO (the W23 defect, one door over).** The SUPPLY side answers
		// `witnessConstraintsOfMethod("Map.map")` → `typeExtensionWitnessConstraints("Map", …)`, which returns
		// the TYPE's own clause whether the method came from the type's body or from an interface extension —
		// an interface extension files no EXTRA constraints (`noteTypeExtensionWitnessConstraints`), but "adds
		// none" is not "carries none". Asked through the same one door the type extension asks through, so the
		// two sides remain one call and not two agreeing lists.
		//
		// ⚠ **MEASURED INDEPENDENTLY, ON A CONFORMER WHOSE OWN CLAUSE IS THE ONLY ONE THERE IS:**
		// `stdlib/Interfaces.maxon`'s `extension Iterator.advanceBy`, published onto a conformer declared
		// `where Key is Hashable and Equatable`, reserved zero witness slots while its `try self.advance()`
		// forwarded two — the precise shape `witnessConstraintsOfMethod`'s header records two crashes for.
		// `sharedEmptyWhereConstraints` is the extension's OWN side, which is empty for the reason above.
		self.enclosingTypeParams = index.structTypeParamsOf(conformer)
		self.enclosingWhereConstraints = index.typeExtensionWitnessConstraints(conformer, extensionConstraints: sharedEmptyWhereConstraints)
		self.enclosingExtensionConstraints = sharedEmptyWhereConstraints

		// BOTH COLUMNS OR NEITHER — the length agreement `conformerAssociatedBindings` enforces has already
		// emptied a list that cannot be paired, so an empty one here means only "this conformer binds nothing
		// positionally" and installing it against a non-empty `associated` would invent the pairing that door
		// just refused.
		let associated = extensionTargetParamNames(header.target)
		let bindings = self.conformerAssociatedBindings(header, conformer: conformer, index: index)
		if associated.count() != bindings.count() 'noPositionalPairing'
			return
		end 'noPositionalPairing'

		self.extensionAssociatedTypeNames = associated
		self.extensionAssociatedTypeBindings = bindings
	end 'openInterfaceExtensionBodyScope'

	// The TYPE-extension half of the door above, split out so the interface half reads as one path rather than
	// as an early return threaded through a `match` arm.
	//
	// ⭐⭐ **THE WITNESS SLOTS THIS BODY RESERVES ARE THE ONES `ProgramSignatures.witnessConstraintsOfMethod`
	// ANSWERS WITH — the SAME call, not a second derivation of the same rule (W23).** It used to install
	// `header.constraints`, the extension's own clause, while the supply side fell back to the TYPE's `where`
	// clause; the two lists agreed only when the extension's happened to contain the type's, and where they
	// did not the body reserved fewer argument registers than every caller filled. See
	// `typeExtensionWitnessConstraints` for the two measured crashes and for why the union is
	// declaration-order independent.
	//
	// `header.nameTok.value` IS the extended type's name — the type arm of `extensionTargetOf` is taken only
	// when that name resolves in the struct registry, and the single conformer it publishes is that same name.
	function openTypeExtensionBodyScope(header ExtensionHeader, index ProgramSignatures)
		self.enclosingTypeParams = extensionTargetParamNames(header.target)
		self.enclosingWhereConstraints = index.typeExtensionWitnessConstraints(header.nameTok.value, extensionConstraints: header.constraints)
		self.enclosingExtensionConstraints = header.constraints
	end 'openTypeExtensionBodyScope'

	// What `conformer` binds the extended interface's associated types to — the same column
	// `extensionConformerVerdict` evaluates the `where` clause against (`StructLayout.bindingsForInterface`),
	// read through one accessor so the CONDITION a method is withheld under and the TYPES its body is parsed
	// with can never come from two different readings of one `implements` clause.
	//
	// ⚠⚠ **A LIST WHOSE LENGTH DISAGREES WITH THE INTERFACE'S ARITY IS EMPTIED HERE, AND THAT IS THE ONE
	// GATE — it used to be `openExtensionBodyScope`'s alone, which left `extensionConformerVerdict` reading
	// the same column UNGATED.** Both pair POSITIONALLY (a body's substitution by index, a
	// `WhereConstraint.typeParamIndex` by index), so a surplus list makes the verdict read a NEIGHBOUR's
	// binding — `extension One where A is Comparable` asking about the first of two items rather than about
	// what `A` actually is. That is a wrong answer where the body scope's own gate gives a missing one, and
	// the two must not differ: this accessor's whole stated purpose is that the CONDITION and the TYPES come
	// from one reading.
	//
	// It is reachable because the DECLARATION SWEEP cannot know an arity — `Queries.foldInterfaceDeclarations`
	// runs after the last file is folded — so `with (Source, Element)` against a one-`uses` `Iterator` is
	// recorded as two items by the sweep and as one interned tuple by the real parse
	// (`parenthesizedWithBindsOneTuple`, which argues why that cannot be settled later). Emptied here, the
	// consequence is a conditional extension WITHHELD from that conformer and a body parsed with no
	// substitution — `readOptionalImplementsClause`'s standard, bounded and missing rather than wrong.
	function conformerAssociatedBindings(header ExtensionHeader, conformer ByteArray, index ProgramSignatures) returns ByteArrayArray
		match index.structOf(conformer) 'conformerLayout'
			declared(layout) then return pairableConformanceBindings(layout.bindingsForInterface(header.nameTok.value), associatedTypeNames: extensionTargetParamNames(header.target))
			undeclared then panic("Parser.conformerAssociatedBindings: conformer '{String.from(conformer)}' came out of `extensionTargetConformers`, which walks the struct registry this lookup misses")
		end 'conformerLayout'
	end 'conformerAssociatedBindings'

	// ⭐ **DOES THIS CONFORMER GET THE EXTENSION'S METHODS?** — the conditional filter, stated once for both
	// passes. See `ExtensionTarget` for why only the interface door has anything to decide.
	function extensionConformerVerdict(header ExtensionHeader, conformer ByteArray, index ProgramSignatures) returns ExtensionConstraintCheck
		if header.constraints.isEmpty() 'unconditional'
			return ExtensionConstraintCheck.satisfied
		end 'unconditional'

		match header.target 'target'
			// A TYPE extension's parameters are bound per INSTANTIATION, not per conformer, so there is no
			// binding here to test: the constraints become witness parameters instead.
			typeExtension then return ExtensionConstraintCheck.satisfied
			// An undeclared target has no conformers, so this is unreachable; answering `satisfied` keeps the
			// arm from being a place a future door could quietly acquire a different rule.
			undeclaredTarget then return ExtensionConstraintCheck.satisfied
			interfaceExtension then break 'target'
		end 'target'

		// Through `conformerAssociatedBindings`, NOT a second `bindingsForInterface` of its own: that accessor
		// is where the positional-pairing gate lives, and this reader indexes the column exactly as the body
		// scope does. Reading the column directly is what let the two answer differently — see its header.
		return checkExtensionConstraints(index, constraints: header.constraints, bindings: self.conformerAssociatedBindings(header, conformer: conformer, index: index))
	end 'extensionConformerVerdict'

	// File the witness constraints a TYPE-extension method adds ON TOP of its target type's own, under the
	// qualified name a call to it resolves to. A no-op for every other extension: an interface extension's
	// clause is a filter (its methods carry no witnesses), and an UNCONDITIONAL extension adds none.
	//
	// ⚠ **"ADDS NONE" IS NOT "CARRIES NONE" (W23).** An unconditional extension on a `where`-constrained type
	// carries that type's witnesses like every other instance method of it; there is simply nothing EXTRA for
	// this to file, and `ProgramSignatures.typeExtensionWitnessConstraints` recovers the type's half from the
	// type. Reading this early return as "no witnesses" is exactly the mistake that made the body reserve zero
	// argument registers while its callers filled two.
	function noteTypeExtensionWitnessConstraints(index ProgramSignatures, header ExtensionHeader, conformer ByteArray, methodName ByteArray)
		match header.target 'target'
			interfaceExtension then return
			undeclaredTarget then return
			typeExtension then break 'target'
		end 'target'

		// ⭐ An UNCONDITIONAL declaration files no constraint and is still a FACT about the name: it says the
		// call-site gate is not the only reading of it. See `ProgramSignatures.hasUnconstrainedExtensionDeclaration`.
		let qualified = qualifiedMethodName(conformer, methodName: methodName)
		if header.constraints.isEmpty() 'unconditional'
			index.noteUnconstrainedExtensionMethod(qualified)
			return
		end 'unconditional'

		index.recordExtensionMethodConstraints(qualified, constraints: header.constraints)
	end 'noteTypeExtensionWitnessConstraints'

	// ⭐ **PUBLISH THE EXTENSION METHOD, OR READ IT AND THROW THE SIGNATURE AWAY (W43).** A SHADOWED method is
	// read exactly as a withheld one is — the cursor must land where a published one leaves it — and files no
	// `ConditionalExtensionSkip`, because nothing is missing: the conformer's own method wears the name, and a
	// call to it resolves through the ordinary member door with the ordinary diagnostics.
	//
	// The published name is noted so `conformerDeclaresOwnMethod` can tell a conformer's own declaration from
	// an extension's the next time it is asked — see that door for why the distinction is what keeps the
	// verdict independent of fold order.
	function publishOrShadowExtensionMethod(index ProgramSignatures, shadowed bool, qualifiedMethodName ByteArray, entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, divergingDecls DivergingDeclEntryArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray, freeFunctionNameOut ByteArrayArray)
		if shadowed 'theConformerDeclaresItsOwn'
			self.recordScannedSignature(FuncReturnTypeEntryArray.create(), paramConsumes: ParamConsumeEntryArray.create(), paramReassigns: ParamReassignEntryArray.create(), globalAliasReturns: GlobalAliasReturnEntryArray.create(), paramDefaults: ParamDefaultEntryArray.create(), throwsEntries: ThrowsClauseEntryArray.create(), divergingDecls: DivergingDeclEntryArray.create(), methodInnerAliasParamOut: MethodInnerAliasParamEntryArray.create(), freeFunctionNameOut: ByteArrayArray.create())
			return
		end 'theConformerDeclaresItsOwn'

		// The DECLARING FILE rides along because a SECOND file publishing this same name is what makes the two
		// an overload set rather than a duplicate (X-contains) — see `ProgramSignatures.contestedExtensionMethods`.
		// Its PROVENANCE rides too, because a stdlib claimant against a user claimant is not a contest at all:
		// the user's declaration wins and this one is withheld (W188).
		//
		// ⚠ **THE NOTE COMES FIRST, AND THE ORDER IS THE POINT** — it is what answers whether THIS declaration
		// is the one being withheld, and a signature published before asking would be a corpus signature
		// standing where the user's belongs whenever the sweep folds `stdlib/` last.
		let beaten = index.noteExtensionPublishedMethod(qualifiedMethodName, declFilePath: self.filePath, isStdlibSource: self.isStdlibSource)
		if beaten 'aUserFileDeclaresIt'
			self.recordScannedSignature(FuncReturnTypeEntryArray.create(), paramConsumes: ParamConsumeEntryArray.create(), paramReassigns: ParamReassignEntryArray.create(), globalAliasReturns: GlobalAliasReturnEntryArray.create(), paramDefaults: ParamDefaultEntryArray.create(), throwsEntries: ThrowsClauseEntryArray.create(), divergingDecls: DivergingDeclEntryArray.create(), methodInnerAliasParamOut: MethodInnerAliasParamEntryArray.create(), freeFunctionNameOut: ByteArrayArray.create())
			return
		end 'aUserFileDeclaresIt'

		self.recordScannedSignature(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, divergingDecls: divergingDecls, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut)
	end 'publishOrShadowExtensionMethod'

	// Read a WITHHELD method's signature into arrays that are discarded, and file why it is missing. The read
	// is what keeps the cursor where a published method's leaves it (see the call site); the filing is what
	// lets the call site say something better than "no such method".
	function foldWithheldExtensionMethod(index ProgramSignatures, conformer ByteArray, methodName ByteArray, clause String, unmetInterfaceName ByteArray, bindingName ByteArray)
		self.recordScannedSignature(FuncReturnTypeEntryArray.create(), paramConsumes: ParamConsumeEntryArray.create(), paramReassigns: ParamReassignEntryArray.create(), globalAliasReturns: GlobalAliasReturnEntryArray.create(), paramDefaults: ParamDefaultEntryArray.create(), throwsEntries: ThrowsClauseEntryArray.create(), divergingDecls: DivergingDeclEntryArray.create(), methodInnerAliasParamOut: MethodInnerAliasParamEntryArray.create(), freeFunctionNameOut: ByteArrayArray.create())
		index.recordConditionalExtensionSkip(qualifiedMethodName(conformer, methodName: methodName), skip: ConditionalExtensionSkip.create(conformer, methodName: methodName, clause: clause, unmetInterfaceName: unmetInterfaceName, bindingName: bindingName))
	end 'foldWithheldExtensionMethod'

	// Cursor is AT `enum`/`union`. Append the enum/union it declares and leave the cursor PAST the
	// declaration's `end` — `recordScannedType`'s twin.
	//
	// TOLERANT, for `recordScannedType`'s reason: a malformed enum is the REAL parse's to report,
	// with a position. It shares `readEnumCaseInto` and `enumBodyEndsAt` with `parseEnumDeclaration`,
	// so the sweep and the parse cannot drift on how a case's TAG is assigned — the fact the parser
	// reads back at every `Color.red` and every `match`. `readEnumCaseInto` consumes the keyword
	// before it can fail (below), so the cursor always advances and the caller's loop cannot spin.
	//
	// It walks the body ITSELF (like `recordScannedType`) rather than letting the caller's loop do
	// it: a case named `end` means only `enumBodyEndsAt`'s label-lookahead rule can tell the
	// terminator from a case, which the caller's generic `blockDepthAfter` cannot.
	//
	// ⭐ **A METHOD MEMBER IS SCANNED, NOT SKIPPED (D1)**, through the same `recordScannedSignature`
	// `recordScannedType` uses — so `Direction.isNorth`'s return type is in the whole-program index before
	// any file is parsed, which is what types `d.isNorth()` at a call site in ANOTHER file.
	//
	// ⚠ **AND THAT IS WHY THIS WALK COUNTS BLOCK DEPTH.** A method's own `end 'isNorth'` is an `end`
	// followed by a character literal — byte-for-byte what `enumBodyEndsAt` recognizes as the ENUM's
	// terminator. Ungated by depth it would close the enum at the first method's `end`, truncating the case
	// list and leaving the rest of the method's body to be read as top-level declarations.
	function recordScannedEnum(enums EnumLayoutArray, entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, divergingDecls DivergingDeclEntryArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray, freeFunctionNameOut ByteArrayArray, conformanceSiteOut ConformanceClauseDeclSiteArray, isUnion bool)
		// Read BACKWARDS, before the keyword is consumed — see `recordScannedType` for why the sweep cannot
		// read this modifier forwards. `declStart` is that same position kept for the whole-program clause
		// re-read (`recordScannedType`'s twin, and `ConformanceClauseDeclSite`).
		let declStart = self.pos
		let visibility = self.visibilityBefore(self.pos)
		try self.consume(TokenKind.union if isUnion else TokenKind.enum) otherwise return
		let nameTok = try self.consume(TokenKind.identifier) otherwise return

		// ⭐ **AN ENUM'S CLAUSE IS TRUNCATED BY THE SAME `with` RULE AND IS RE-READ BY THE SAME PASS (W95).**
		// It binds nothing an extension is evaluated against — an enum has no conditional extension — but a
		// LOST NAME is the same loss on both kinds: `enum E implements Marker with Tag, Error` would drop the
		// `Error` that `throws E` is narrowed against (`EnumLayout.conformsTo`).
		// Deferred on the same one condition the `type` half defers on — see `implementsClauseBindsAnything`.
		if self.at(TokenKind.implements) and self.implementsClauseBindsAnything() 'deferredConformances'
			conformanceSiteOut.push(ConformanceClauseDeclSite.create(self.filePath, tokenPos: declStart, declName: nameTok.value, declIsEnum: true))
		end 'deferredConformances'

		let scannedConformances = try self.readOptionalImplementsClause() otherwise return
		let conformsTo = scannedConformances.names
		self.enterTypeScope(nameTok.value, isEnum: true)

		var layout = EnumLayout.create(nameTok.value, isUnion: isUnion, conformsTo: conformsTo, visibility: visibility, declFilePath: self.filePath, backing: EnumBacking.unresolved)
		var counter = EnumTagCounter.create()

		var depth = 0 as BlockDepth
		while not self.isEof() 'body'
			self.skipNewlines()
			if depth == 0 and self.enumBodyEndsAt(self.pos) 'closes'
				self.advance()
				self.skipOptionalLabel()
				break
			end 'closes'

			// A method (`[export] [static] function <name>(`) at the enum's own level. `function` ALONE is a
			// legal case name, so only a real method-start is one. The block it opens is counted BEFORE the
			// signature is read, because reading it moves the cursor past the `function` keyword — exactly as
			// `recordScannedType`'s method arm does, and for the same reason.
			if depth == 0 and self.atEnumMethodStart() 'method'
				self.pos = self.enumMethodKeywordIndex(self.pos)
				depth = depth + 1
				self.advance()
				self.recordScannedSignature(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, divergingDecls: divergingDecls, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut)
				continue
			end 'method'

			if depth == 0 'caseMember'
				// A case the sweep cannot read leaves the layout SHORT, which would misassign every later
				// case's tag — so the scan stops rather than recording a layout it knows is wrong.
				try self.readEnumCaseInto(layout, counter: counter) otherwise break
				continue
			end 'caseMember'

			depth = self.blockDepthAfter(depth)
			self.advance()

			// ⚠⚠ **A METHOD'S CLOSING `end` CARRIES ITS BLOCK LABEL, AND THIS WALK MUST EAT IT** — because the
			// token right after it is read as a MEMBER, and a label is a `charLiteral`. ⛔ **THE COST OF
			// MISSING IT ROSE WHEN CHAR BACKING LANDED**: `readEnumCaseInto` used to REFUSE a charLiteral
			// member outright, so any missed label aborted the scan loudly; a ONE-character label (`end 'a'`)
			// is now a legal implicitly-backed case, so missing it would silently declare a case `a` and fix
			// the enum's backing to `character`. (A longer label still aborts, now as an invalid character
			// literal rather than as a refused backing. The D1 review measured what the loud version cost: with
			// `end 'bump'` the sweep stopped at the label, so a SECOND method's signature never reached the
			// whole-program index — `e.second()` typed `unresolved` and PANICKED in lowering — and every case
			// declared after a method was silently dropped from the layout). `recordScannedType` needs no such
			// step only because its depth-0 fall-through advances one token instead of reading a member.
			//
			// Only the return to the enum's OWN level matters: a label on an inner `end 'spin'` leaves the walk
			// at depth > 0, where it is an ordinary token.
			if depth == 0 'memberClosed'
				self.skipOptionalLabel()
			end 'memberClosed'
		end 'body'

		enums.push(layout)
		appendUnionCasesCompanion(enums, layout: layout)
		self.closeTypeParamScope()
	end 'recordScannedEnum'

	// `type <Name>` — the two tokens every type declaration opens with, read by BOTH the tolerant
	// sweep and the real parse. One reader, so the two can never disagree about what a type is
	// CALLED, which is the name every method of it is declared under and every use of it resolves
	// through.
	function readTypeHeader() returns Token throws ParseError
		try self.consume(TokenKind.type)
		return try self.consume(TokenKind.identifier)
	end 'readTypeHeader'

	// ⭐ **ENTER THE SCOPE OF A NAMED DECLARATION — ITS NAME AND ITS KIND, WRITTEN IN ONE PLACE.** The
	// opening half of `closeTypeParamScope`, called by every door that reads a declaration's header: the
	// real parse and the tolerant sweep of a `type` and of an `enum`/`union`, and the interface parse.
	//
	// ⭐ **THE KIND RIDES WITH THE NAME BECAUSE THE TWO ARE ONE FACT** — "which declaration encloses the
	// cursor" — and a `structRef`-vs-`named` receiver type is decided from it (`enclosingSelfType`). Set
	// apart, an enum door that remembered to write the name and forgot the kind would give an enum's `self`
	// a struct's type: a receiver typed `structRef(Toggle)` against a `StructLayout` no file declares.
	//
	// It also resets the three PER-DECLARATION scopes, for the reason `closeTypeParamScope` restores them:
	// a sibling declaration's `Idx`, `T` or `where` constraint must not leak into this one. All three point
	// at their SHARED empty, so entering a scope allocates nothing.
	// ⚠ It takes the NAME and not the name TOKEN, because one caller has no token to give: an interface
	// extension enters the scope of each CONFORMING type in turn, and those names come from the whole-program
	// conformance relation rather than from any token in the extension's own file.
	function enterTypeScope(name ByteArray, isEnum bool)
		self.enclosingType = name
		self.enclosingTypeIsEnum = isEnum
		self.enclosingTypeParams = self.emptyTypeParams
		self.enclosingInnerAliases = sharedEmptyInnerAliases
		self.innerAliasesFromIndex = false
		self.enclosingWhereConstraints = sharedEmptyWhereConstraints
		self.enclosingExtensionConstraints = sharedEmptyWhereConstraints
		self.clearExtensionAssociatedTypes()
	end 'enterTypeScope'

	// Point both associated-type columns back at the shared empty — the FOURTH per-declaration scope, reset by
	// the same two doors as the other three. Its own function because both halves must move together: a
	// bindings list left standing beside a cleared name list is a substitution keyed by position against
	// nothing, which is exactly the shape that answers for the wrong conformer's binding.
	function clearExtensionAssociatedTypes()
		self.extensionAssociatedTypeNames = sharedEmptyExtensionAssociatedTypes
		self.extensionAssociatedTypeBindings = sharedEmptyExtensionAssociatedTypes
	end 'clearExtensionAssociatedTypes'

	// ⭐ **WHAT THIS EXTENSION BODY'S CONFORMER BINDS `name` TO, or `name` ITSELF when it is not an associated
	// type of the extended interface** (conditional extensions). Answering the name unchanged is what lets
	// `parseTypeReference` ask unconditionally: outside an interface extension the columns are the shared
	// empty, the loop does not run, and the caller resolves exactly the name the author wrote.
	//
	// A linear scan for `typeParamPositionOf`'s reason: an interface declares a handful of associated types,
	// so a per-parse name→binding map would be a heap object bought to serve one or two lookups.
	function extensionAssociatedTypeBinding(name ByteArray) returns ByteArray
		for i in 0 upto self.extensionAssociatedTypeNames.count() 'eachAssociated'
			let associated = try self.extensionAssociatedTypeNames.get(i) otherwise panic("extensionAssociatedTypeBinding: extensionAssociatedTypeNames.get OOB at {i} below count {self.extensionAssociatedTypeNames.count()}")
			if not associated.equals(name) 'notThisOne'
				continue
			end 'notThisOne'

			return try self.extensionAssociatedTypeBindings.get(i) otherwise panic("extensionAssociatedTypeBinding: the conformer binds nothing at associated-type position {i}, where the interface declares {self.extensionAssociatedTypeNames.count()} — `openExtensionBodyScope` installs the two columns only when their lengths agree")
		end 'eachAssociated'

		return name
	end 'extensionAssociatedTypeBinding'

	// ⭐ **OPEN A GENERIC TYPE'S PARAMETER SCOPE (P1.6-A)** — `type Box uses T` / `type Pair uses A, B`.
	// Called by BOTH `parseTypeDeclaration` and the tolerant sweep `recordScannedType` right after
	// `enterTypeScope`, so the two record the SAME parameter list (the one a field's `typeParameter(token)`
	// is meaningful against). It sets `self.enclosingTypeParams` — how `parseTypeReference` recognizes a
	// bare `T` — and stamps the names onto the layout so the whole-program arity check can read them off
	// `structOf`. The cursor lands past the clause (at the type body); a type with no `uses` leaves the
	// list empty and consumes nothing.
	//
	// Commas separate the names (`uses A, B`), NO parentheses (the oracle's grammar). The loop stops at
	// the first non-identifier (a newline opening the body), exactly as a top-level `uses` clause does.
	function openTypeParamScope(layout StructLayout)
		let names = self.openTypeParamNames()
		// A NON-GENERIC type allocates nothing: it keeps the layout's create-time empty `typeParamNames`
		// and keeps the shared empty list `enterTypeScope` has just pointed the parser at. Only a `uses`
		// clause builds a real list — which is the rare case, and absent from the scale corpus entirely.
		if names.isEmpty() 'noUses'
			return
		end 'noUses'

		layout.recordTypeParams(names)
	end 'openTypeParamScope'

	// ⭐ **THE `uses` READ ITSELF — THE SCOPE HALF OF THE DOOR ABOVE, WITHOUT THE LAYOUT (W95).** The
	// whole-program conformance-clause re-read (`foldConformanceClauseInto`) has to re-enter a declaration's
	// parameter scope to render its `with` arguments, and it has NO layout to stamp: the registry's may belong
	// to a DIFFERENT declaration of the same name, which is the guard
	// `ProgramSignatures.refoldConformanceClause` carries and which must not be written twice.
	//
	// ⚠ Split rather than copied, so all three readers — the sweep, the real parse and the re-read — take the
	// SAME reading of `uses A, B`. That is the property `openTypeParamScope`'s header claims for the first two,
	// and a third walk of this grammar is exactly how a re-read would come to disagree about a parameter list
	// every field's `typeParameter(token)` is resolved against.
	//
	// Commas separate the names (`uses A, B`), NO parentheses (the oracle's grammar). The loop stops at
	// the first non-identifier (a newline opening the body), exactly as a top-level `uses` clause does.
	function openTypeParamNames() returns ByteArrayArray
		if not self.at(TokenKind.uses) 'noUses'
			return self.emptyTypeParams
		end 'noUses'

		var names = ByteArrayArray.create()
		self.advance()
		while self.at(TokenKind.identifier) 'usesLoop'
			let paramTok = self.current()
			self.advance()
			names.push(paramTok.value)
			if not self.at(TokenKind.comma) 'doneUses'
				break
			end 'doneUses'
			self.advance()
		end 'usesLoop'
		self.enclosingTypeParams = names
		return names
	end 'openTypeParamNames'

	// Close the enclosing-type scope (P1.6-A) — clears `enclosingType`, its KIND and `enclosingTypeParams`
	// in lockstep, so a sibling type at file scope starts fresh and a bare `T` outside a generic body
	// resolves as an ordinary named type, not a stale parameter. Restores the SHARED empty list rather
	// than a fresh one, so closing a type scope allocates nothing.
	function closeTypeParamScope()
		self.enclosingType = EmptySourceText
		// Cleared with the name it belongs to (see `enterTypeScope`): a stale `true` at file scope would tell
		// `enclosingSelfType` a `Self` it can no longer resolve at all is an enum's.
		self.enclosingTypeIsEnum = false
		self.enclosingTypeParams = self.emptyTypeParams
		// Restored to the SHARED empty in lockstep (P1.6-C) so a bare `Idx` at file scope, after a type that
		// declared one, resolves as an ordinary named type rather than a stale inner alias — and allocates
		// nothing, exactly as `emptyTypeParams` restores.
		self.enclosingInnerAliases = sharedEmptyInnerAliases
		// Restored in lockstep for the same reason, one layer up: a drained default's index-scoped answer must
		// not survive into the next declaration, where the set above is the only truth again.
		self.innerAliasesFromIndex = false
		// Restored in lockstep (P1.7a slice 2a) so a dispatch outside a constrained type body resolves against
		// no stale constraints — and allocates nothing, exactly as `emptyTypeParams` restores.
		self.enclosingWhereConstraints = sharedEmptyWhereConstraints
		self.enclosingExtensionConstraints = sharedEmptyWhereConstraints
		// Restored in lockstep for the identical reason (conditional extensions): the NEXT conformer's pass
		// over the same extension body installs its own bindings, and a `Element` left pointing at the previous
		// conformer's would be a silently wrong type rather than an error.
		self.clearExtensionAssociatedTypes()
	end 'closeTypeParamScope'

	// ⭐⭐ **THE ASSOCIATED-TYPE BINDINGS ONE `where` CONSTRAINT CARRIES — `where Source is Iterator with
	// Element` (G19).** The `with` clause an `implements` line already carries, read by the SAME reader
	// (`readConformanceWithArg`, under the `identity` spelling) so a binding written on a constraint and the
	// same binding written on a conformance are the same rendered string and compare without a second
	// resolution.
	//
	// ⚠ **A MULTI-BINDING `with` MUST BE PARENTHESIZED HERE, WHERE ON AN `implements` LINE IT NEED NOT BE —
	// and that is forced rather than chosen.** `parseConformanceWithArgs`' comma-continued spelling is bounded
	// by the interface's `uses` ARITY, and that arity is UNRESOLVABLE in the declaration sweep (which is the
	// pass whose layout `ProgramSignatures.structOf` answers from). An `implements` clause can defer — it
	// stops early and `skipRestOfImplementsClause` consumes the tail, costing at worst a conformance the real
	// parse re-reads. A `where` clause cannot: its constraint list IS the witness-slot numbering, so a sweep
	// that read `where T is Pair with A, B` as `T is Pair with A` and then tried to read `B` as a constrained
	// PARAMETER would abandon the clause and file a SHORTER slot list whole-program — a wrong ABI, not a
	// wrong message. Parentheses make the extent a token fact, so both passes read the same list.
	function readWhereConstraintBindings(interfaceName ByteArray) returns ByteArrayArray throws ParseError
		if self.at(TokenKind.leftParen) 'delimited'
			return try self.parseConformanceWithArgs(interfaceName, spelling: ConformanceArgSpelling.identity)
		end 'delimited'

		var bindings = ByteArrayArray.create()
		bindings.push(try self.readConformanceWithArg(ConformanceArgSpelling.identity))
		return bindings
	end 'readWhereConstraintBindings'

	// ⭐ **PARSE A `where <T> is <Interface> [with <Bindings>] [and <Interface> …]… [, <U> is …]…` CLAUSE
	// (P1.7a slice 2a, `with` added at G19).** The
	// cursor sits on `where`. Each `<param> is <Interface>` records a `WhereConstraint`, in SOURCE ORDER —
	// and that order is the witness-slot order the dictionary-passing ABI threads, so it must be stable
	// between the tolerant sweep and the real parse (both call this). A conjunction `is A and B` and a comma
	// list `T is A, U is B` each flatten to one entry per (param, interface) pair. The constrained parameter
	// is resolved to its `uses`-list INDEX against `enclosingTypeParams` (set by `openTypeParamScope`); a name
	// that is not a declared type parameter is rejected — a `where` on a non-parameter has no witness slot to
	// fill. Returns the (possibly empty) constraint list; the caller records it on the layout.
	function readWhereClause() returns WhereConstraintArray throws ParseError
		try self.consume(TokenKind.where)
		var constraints = WhereConstraintArray.create()

		while true 'params'
			let paramTok = try self.consume(TokenKind.identifier)
			let paramIndex = self.typeParamPositionOf(paramTok.value)
			if paramIndex >= self.enclosingTypeParams.count() 'notTypeParam'
				throw ParseError.unsupported("a `where` clause constrains '{String.from(paramTok.value)}', which is not a type parameter of this type — a constraint must name one of its `uses` parameters", line: paramTok.line, column: paramTok.column)
			end 'notTypeParam'
			try self.consume(TokenKind.is)

			while true 'interfaces'
				let ifaceTok = try self.consume(TokenKind.identifier)
				var bindings = sharedEmptyDeclaredConformances
				if self.at(TokenKind.with) 'bindsAssociatedTypes'
					try self.consume(TokenKind.with)
					bindings = try self.readWhereConstraintBindings(ifaceTok.value)
				end 'bindsAssociatedTypes'
				constraints.push(WhereConstraint.create(paramIndex, interfaceName: ifaceTok.value, associatedBindings: bindings))
				if not self.at(TokenKind.and) 'doneInterfaces'
					break
				end 'doneInterfaces'
				self.advance()
			end 'interfaces'

			if not self.at(TokenKind.comma) 'doneParams'
				break
			end 'doneParams'
			self.advance()
		end 'params'

		return constraints
	end 'readWhereClause'

	// Is the cursor on a FIELD declaration — `[export] (let|var) <name> as <Type>`?
	//
	// It defers to `atTopLevelBindingKeyword` for the keyword test rather than respelling it, for
	// that predicate's own reason: `let` and `var` introduce a binding in three places now (file
	// scope, a type body, a function body), and a keyword taught to one spelling and not another
	// would put two readers of one grammar a token apart.
	function atStructFieldKeyword() returns bool
		return self.structFieldKeywordAt(self.pos)
	end 'atStructFieldKeyword'

	// The same question at an arbitrary INDEX, and the ONE place a field declaration's `[modifier] let|var`
	// head is recognized. `visibilityModifierAt`'s split, one door up, and for its reason: the
	// descriptor-need pre-scan walks a type body by index and parses nothing.
	function structFieldKeywordAt(index TokenIndex) returns bool
		let afterModifier = self.pastVisibilityModifier(index)
		let kind = self.kindAt(afterModifier)
		return kind == TokenKind.let or kind == TokenKind.var
	end 'structFieldKeywordAt'

	// The index of the `let`/`var` a field declaration opening at `index` reaches — past its visibility
	// modifier when it has one. Both readers of a field head by index need it, so the step is taken once.
	function pastVisibilityModifier(index TokenIndex) returns TokenIndex
		return (index + 1) as TokenIndex if self.visibilityModifierAt(index) else index
	end 'pastVisibilityModifier'

	// ⭐ **DOES A MEMBER DECLARATION OPENING AT `index` DECLARE TYPE-QUALIFIED MODULE STORAGE — `[export]
	// static (let|var)` (W65)?** The `static` prefix is the whole difference between this and
	// `structFieldKeywordAt` one door up, which is why the two are written as siblings: a `let`/`var`
	// WITHOUT `static` is a per-instance FIELD and one WITH it is one copy for the type, and the predicates
	// that tell a member list which it is read the same head from the same index.
	//
	// It defers to `structFieldKeywordAt` for the keyword half rather than respelling `let or var`, for
	// that predicate's own reason: the set of keywords that introduce a binding lives in ONE place, so a
	// keyword taught to one reader and not another cannot put two readers of one grammar a token apart.
	function staticBindingKeywordAt(index TokenIndex) returns bool
		let afterModifier = self.pastVisibilityModifier(index)
		return self.kindAt(afterModifier) == TokenKind.static and self.structFieldKeywordAt((afterModifier + 1) as TokenIndex)
	end 'staticBindingKeywordAt'

	// Read one field declaration into `layout`. THE one field reader, shared by the sweep and the
	// real parse, so `StructLayout`'s field ORDER (which IS the box's slot order — see
	// `StructLayout.offsetOfField`) is read exactly once from one grammar. Two readers would be free
	// to disagree about how many fields a type has, and the one that was wrong would place every
	// later field at the wrong offset: a silent out-of-bounds read, not a compile error.
	//
	// **THE THREE LEGAL SHAPES**, and the `as` is what tells them apart:
	//
	//   1. `export var x as Integer`     — annotated, no default. A literal must supply it (E3086).
	//   2. `export var x = 0`            — the default supplies BOTH the value and the TYPE, so it must
	//                                      BE a literal; anything else is E2004 (S2f).
	//   3. `export var x as Integer = 0` — annotated AND defaulted. The annotation is the type, so the
	//                                      default may be ANY expression (S2f): a literal is checked
	//                                      against the annotation here, and everything else becomes a
	//                                      synthesized nullary helper checked by the ordinary `return`
	//                                      rules (`FieldDefault.helper`).
	//
	// Neither `as` nor `=` is E2010 — the `consume(equals)` below reporting the token it wanted.
	//
	// **TWO KEYWORDS, TWO BITS, AND BOTH ARE KEPT.** `let` vs `var` decides FIELD MUTABILITY
	// (`c.version = 2` on a `let` field is E2013 — `StructLayout.fieldMutable`); `export`/`module` decides
	// FIELD VISIBILITY (`v.private` from outside `type Value` is E3014 —
	// `StructLayout.fieldVisibility`, read by `requireFieldAccessible`). They ride the same
	// `addField` call, which is the one writer of every column.
	//
	// ⚠ **THE MODIFIER IS READ THROUGH `consumeOptionalVisibility`, THE FILE'S ONE READER OF BOTH WORDS.**
	// It used to be a bare `self.at(TokenKind.export)` here, which was a second answer to "what modifier is
	// this?" — and it is what a `module var x` would have silently ignored (N1a).
	//
	// ⚠ The `export` bit was CONSUMED AND DROPPED until P1.1a wave 3, and the reason this comment
	// gave for dropping it was false twice over. It said *"field visibility gates cross-FILE access
	// (E3014), and shv2 has no cross-file name resolution to gate"* — but visibility gates access
	// from outside the TYPE, in the same file (measured: `type B` reading `type A`'s unexported
	// field is E3014 on the bootstrap), so the bit always had a live consumer and shv2 silently
	// accepted a program the language rejects. It is kept now, and the rung that reads it is the
	// one that ported `specs/export-var-fields.md`'s two `error.unexported-field-*` cases.
	function readStructFieldInto(layout StructLayout) throws ParseError
		let visibility = try self.consumeOptionalVisibility()

		let mutable = self.at(TokenKind.var)
		try self.consume(TokenKind.var if mutable else TokenKind.let)

		let nameTok = try self.consume(TokenKind.identifier)
		// A `__`-prefixed field is reserved. This reader is shared with the tolerant sweep
		// (`recordScannedType`), which swallows the throw (`otherwise break`) and leaves the positioned
		// diagnostic to the real parse — the sweep is not a validator.
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)

		if not self.at(TokenKind.as) 'typeFromLiteral'
			// Shape 2. There is no annotation to read the type off, so the literal's TOKEN KIND is
			// the whole of the type inference — see `readFieldDefaultLiteral`.
			let inferrableEnd = self.fieldDefaultEnd(self.pos)
			try self.consume(TokenKind.equals)
			// ⭐ **BEFORE THE LITERAL TEST BELOW, BECAUSE THAT TEST WOULD ANSWER FIRST AND ANSWER THE WRONG
			// THING (W72).** `let at = __line__` is not a field whose type cannot be inferred; it is a
			// caller-location keyword in a position that has no caller. Asked in the other order it earned
			// E2004 "add a type annotation", which sends the author to write `let at as SourceLineNumber =
			// __line__` — the very program the annotated shape refuses. The two field shapes therefore ask
			// this ONE question in the same place relative to their own inference, and the reference answers
			// E2060 for both.
			let inferrableDefaultTok = self.current()
			try requireNotACallerLocationDefault(inferrableDefaultTok.value, at: inferrableDefaultTok)
			// ⭐ **AND THAT IS WHY THE SHORTHAND ADMITS ONLY A BARE LITERAL (S2f).** An annotated field takes
			// an arbitrary expression, because the annotation says what the expression must produce; here
			// there is no annotation, and a type read off the raw tokens of `IntArray.create()` or `7 + 1`
			// would be a guess. So anything that is not exactly a literal earns E2004 — see
			// `ParseError.uninferrableFieldDefault` — positioned at the default's first token, which is
			// where the annotation would have to be added to make it legal.
			if not self.defaultRegionIsLiteral(self.pos, regionEnd: inferrableEnd) 'uninferrable'
				let uninferrableTok = self.current()
				throw ParseError.uninferrableFieldDefault(uninferrableTok.line, column: uninferrableTok.column)
			end 'uninferrable'
			let inferred = try self.readFieldDefaultLiteral()
			// Shape 2 has no annotation at all, so no spelling can name the buffer alias (A2j); the type
			// comes from a LITERAL, and no literal produces a `__ManagedMemory`.
			layout.addField(nameTok.value, declaredType: self.constantValueTypeOf(inferred.tag, typeName: inferred.typeName), mutable: mutable, tier: visibility, defaultValue: FieldDefault.literal(inferred.payload, tag: inferred.tag), declaredSurface: sharedEmptyDeclaredSurface)
			return
		end 'typeFromLiteral'

		try self.consume(TokenKind.as)
		// ⭐ **THE FIELD's PRE-ERASURE SPELLING (A2j / A2m)** — asked at the cursor, which now sits on the
		// annotation's first token, because `parseTypeReference` on the next line folds `__ManagedMemory`
		// into the very `genericInstance` a `ByteArray` field resolves to. Captured in the ONE shared field
		// reader, so the tolerant sweep's layout — the whole-program one every read door consults — and the
		// real parse's carry the identical word, for the reason this reader is shared at all.
		//
		// ⚠ A tuple SLOT's element bit is held clear here — `slotElementsFromAliases: false` — because the
		// SWEEP also fills this column while the alias table is still being built, so `var t as (BufArray,
		// Int)` asked there answers *how far the sweep had got*. The field's ROOT keeps asking, because
		// `ProgramSignatures.fieldSurfaceOf` ORs in the complementary derivation; see `declaredSurfaceAt`.
		let declaredSurface = self.declaredSurfaceAt(self.pos, slotElementsFromAliases: false)
		// ⭐ **A FIELD ASKS NO STORABILITY DOOR, AND THAT IS THE SLICE-2 CHANGE** (P1.7a-existentials). Every
		// other position `DeclaredStoragePosition` names still lacks room for an existential's second word; a
		// FIELD now carves out two slots for it (`Project.fieldSlotCount`), so it is the one declared place
		// with somewhere to put both halves. The annotation's first token went with the call — nothing else
		// anchored a diagnostic on it.
		let fieldType = try self.parseTypeReference()

		if not self.at(TokenKind.equals) 'noDefault'
			layout.addField(nameTok.value, declaredType: fieldType, mutable: mutable, tier: visibility, defaultValue: FieldDefault.none, declaredSurface: declaredSurface)
			return
		end 'noDefault'

		// Shape 3. The ANNOTATION is the field's type and the default must agree with it: `as
		// Integer = 50.0` is the same lossy coercion `var x as Integer` then `x = 50.0` is, so it
		// asks the same rule (`requireAssignable`) rather than a second opinion about floats.
		//
		// ⭐⭐ **AND WITH AN ANNOTATION IN HAND THE DEFAULT MAY BE ANY EXPRESSION (S2f), WHICH IS THE ONE
		// FORM THAT DOES NOT COME BACK THROUGH THIS LINE.** It becomes a synthesized nullary function whose
		// body is `return <the expression>` (`FieldDefault.helper`), so the annotation binds it by the
		// ordinary `return` rules — `as Integer = "x"` is an ordinary return-type mismatch, `as Real = 3` an
		// ordinary widening — with no rule written twice. The LITERAL form deliberately stays here; see
		// `fillFieldDefault` for the one thing a helper cannot do.
		try self.requireDefaultableFieldType(nameTok, layout: layout, fieldType: fieldType)

		let defaultEnd = self.fieldDefaultEnd(self.pos)
		try self.consume(TokenKind.equals)

		// ⭐ **THE CAPTURE-POSITION HALF OF E2060 (W72).** A field default shares the `= <expr>` spelling with
		// a parameter default and is a different thing: it expands at a struct LITERAL, which is not a call
		// and has no caller to name.
		//
		// ⚠ **IT IS A FIRST-REPORT GUARANTEE, NOT THE ONLY DIAGNOSIS — and this comment used to claim it was
		// (W72 review).** The claim was that a field default no `Self{…}` ever omits "is never expanded at
		// all", so the misuse would go undiagnosed without this raise. MEASURED false on this tree: an
		// annotated default is not `defaultRegionIsLiteral`, so it is CAPTURED as a helper, and `parseModule`
		// DRAINS every captured helper whether or not any literal omits the field — the body's own
		// `emitFunctionRef` door then reports the same E2060 at the same token. The probe that separates the
		// two is `= 1 + __line__`, where `self.current()` is `1` and this raise cannot fire: it is still
		// refused, at the `__line__` token. What this raise actually buys is that the whole-region shapes and
		// the bare-keyword shape report identically, from one wording, before any drain ordering can vary
		// which of them speaks first.
		let annotatedDefaultTok = self.current()
		try requireNotACallerLocationDefault(annotatedDefaultTok.value, at: annotatedDefaultTok)

		if not self.defaultRegionIsLiteral(self.pos, regionEnd: defaultEnd) 'anExpression'
			let helperName = self.captureFieldDefault(layout.name, fieldName: nameTok.value, fieldType: fieldType, regionEnd: defaultEnd)
			layout.addField(nameTok.value, declaredType: fieldType, mutable: mutable, tier: visibility, defaultValue: FieldDefault.helper(helperName), declaredSurface: declaredSurface)
			return
		end 'anExpression'

		// **THE LITERAL IS RECORDED EXACTLY AS WRITTEN — payload AND tag, unconverted.** The widening a
		// `float` field's `= 3` needs is paid at the ONE place a default becomes a value
		// (`fillFieldDefault`), off the tag recorded here. It cannot be paid at this line: the declaration
		// SWEEP shares this reader and may not resolve `fieldType` when it is a ranged-alias NAME, yet it is
		// the SWEEP's layout a `Self{…}` reads its defaults out of — so a conversion decided here would be
		// decided blind for exactly the fields that need it, and written into the wrong copy besides.
		let given = try self.readFieldDefaultLiteral()
		try self.requireFieldDefaultType(nameTok, fieldType: fieldType, owner: layout.name, given: given)
		layout.addField(nameTok.value, declaredType: fieldType, mutable: mutable, tier: visibility, defaultValue: FieldDefault.literal(given.payload, tag: given.tag), declaredSurface: declaredSurface)
	end 'readStructFieldInto'

	// ⛔⛔ **A FIELD DECLARED AT A TYPE PARAMETER MAY NOT CARRY A DEFAULT — OF EITHER FORM (S2f).** `type Box
	// uses T … var value as T = <anything>` is not a missing feature: a default is produced ONCE, from this
	// type's SHARED body, where `T` is an opaque 8-byte word. No literal and no expression in that body can
	// produce a value OF `T` — the concrete type is not known until an instantiation, and two instantiations
	// may pick different ones — so whatever the default produces is stored into a slot whose real type
	// somebody else decides later.
	//
	// ⚠⚠ **MEASURED, AND IT IS A MEMORY-SAFETY BUG IN BOTH COMPILERS, WHICH IS WHY THE ORACLE IS NOT
	// FOLLOWED HERE.** `type Box uses T … var value as T = makeIt()` (returning an `Integer`) instantiated as
	// `Box with String` COMPILED on both, and on both the field read then treated the integer 9 as a String
	// record: shv2 access-violated (`0xC0000005`), the bootstrap panicked inside `mm_incref` at address `0x1`.
	// The LITERAL form (`as T = 0`) is the identical fault and PRE-DATES this rung, which is why the refusal
	// is written here — against the field's declared TYPE, before either default form is read — rather than
	// on the expression arm alone. One rule, one place, both forms.
	//
	// It refuses at the `=`, because the `=` is what has to go: the field itself is perfectly legal, and the
	// cure is either a concrete type or a value supplied at each `Self{…}`.
	//
	// ⚠ Thrown from the SHARED field reader, so the tolerant sweep swallows it (`otherwise break`) and the
	// real parse raises it with a position — `requireUnreservedName`'s arrangement, three lines up.
	function requireDefaultableFieldType(nameTok Token, layout StructLayout, fieldType MaxonType) throws ParseError
		if maxonTypeTag(fieldType) != ValueTypeTag.typeParameter 'aConcreteSlot'
			return
		end 'aConcreteSlot'

		let paramName = String.from(self.typeParamDisplayName(typeNameIdOf(fieldType)))
		let eqTok = self.current()
		throw ParseError.unsupported("a default value on field '{String.from(nameTok.value)}' of `type {String.from(layout.name)}`, whose declared type is the type parameter '{paramName}' — a default is produced by a function compiled ONCE from this type's shared body, where '{paramName}' is an opaque word, so nothing written there can produce a value of it, and each instantiation may bind it to a different type. Declare the field at a concrete type, or give it a value at every struct literal of '{String.from(layout.name)}'", line: eqTok.line, column: eqTok.column)
	end 'requireDefaultableFieldType'

	// ⭐⭐ **WHERE A FIELD DEFAULT ENDS — AT THE END OF ITS LINE, AND THAT CHOICE IS WHAT MAKES A TRAILING
	// TOKEN REPORTABLE AT ALL (S2f).** `skipParamDefault` answers the same question for a PARAMETER, where
	// the terminator is the `,` or `)` the list supplies; a field declaration has no such punctuation, so
	// the line is the extent. `var v as Integer = 7 zzz` therefore has a default region of two tokens, the
	// expression parser consumes one, and the drain's end-of-default check reports the other
	// (`parseDefaultHelperBody`) rather than leaving `v` silently initialized to 7.
	//
	// ⚠ It counts no brackets, and does not need to: it stops at the FIRST newline whatever the nesting,
	// which is exactly the rule the language already applies to every other declaration and statement — a
	// field declaration is one line. A default that wanted to span lines would need a continuation syntax
	// the language does not have, so there is nothing here to be tolerant of.
	//
	// The cursor is AT the `=`; the answer is an index into the token stream, never a cursor move.
	function fieldDefaultEnd(fromEquals TokenIndex) returns TokenIndex
		var q = fromEquals + 1
		while self.kindAt(q) != TokenKind.newline and self.kindAt(q) != TokenKind.eof 'scan'
			q = q + 1
		end 'scan'
		return q
	end 'fieldDefaultEnd'

	// ⭐ **IS THE DEFAULT OCCUPYING `[start, regionEnd)` EXACTLY A LITERAL — `5`, `50.0`, `true`, optionally
	// signed — AND NOTHING ELSE?** THE dispatch between a field default's two forms, asked once per
	// defaulted field, before either reader runs. It is a TOKEN-SHAPE test and can be nothing else: the
	// answer decides which of the two doors reads the tokens, so it must be decidable without reading them.
	//
	// ⚠ **THE WHOLE REGION MUST BE THE LITERAL, WHICH IS WHY IT COMPARES AGAINST `regionEnd`.** `= 7 + 1`
	// opens with a literal token and is not one, and taking the literal door on the strength of the first
	// token would consume the `7` and abandon the rest — the exact silent-drop this rung exists to close.
	//
	// ⚠ **A LEADING `-` IS A SIGN, AND ONLY A NUMBER HAS ONE.** `-true` is not a signed literal, it is a
	// negation applied to a bool: an EXPRESSION, which the annotated door hands to a helper (where it earns
	// the ordinary type error) and the shorthand door refuses as uninferrable. Before this rung that case
	// had a refusal of its own inside the literal reader, which was the same rule stated in a second place.
	function defaultRegionIsLiteral(start TokenIndex, regionEnd TokenIndex) returns bool
		var q = start
		var signed = false
		if self.kindAt(q) == TokenKind.minus 'sign'
			signed = true
			q = q + 1
		end 'sign'

		let kind = self.kindAt(q)
		let isNumber = kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral
		let isBool = kind == TokenKind.true or kind == TokenKind.false
		if not (isNumber or (isBool and not signed)) 'notALiteralToken'
			return false
		end 'notALiteralToken'

		return (q + 1) as TokenIndex == regionEnd
	end 'defaultRegionIsLiteral'

	// Capture one field's `= <expression>` for the drain and leave the cursor at the token that ENDS it, so
	// the field reader resumes exactly as it would have without a default. The cursor arrives just PAST the
	// `=`. It answers the helper's NAME, because the LAYOUT must carry the same bytes
	// (`FieldDefault.helper`) — minted once, here, and handed to both.
	//
	// ⚠ **THE DECLARATION SWEEP CAPTURES TOO, AND THAT IS DELIBERATE RATHER THAN AN OVERSIGHT.**
	// `readStructFieldInto` is SHARED by the tolerant sweep and the real parse (its header says why it must
	// be), and only the real parse ever DRAINS — `parseModule` is the sole drain site, and a Parser used for
	// a sweep never reaches it, so the sweep's captures are discarded with the sweep's Parser. Gating this
	// on "which pass am I?" would put a second answer to that question in this file; the first is
	// `requireFieldDefaultType`'s `allFilesFolded`, and it is about something else entirely (whether the
	// INDEX is complete). The cost is one record per defaulted field on a walk that already builds a
	// `StructLayout` per type.
	function captureFieldDefault(typeName ByteArray, fieldName ByteArray, fieldType MaxonType, regionEnd TokenIndex) returns ByteArray
		let helperName = fieldDefaultHelperName(typeName, fieldName: fieldName)
		self.pendingDefaultHelpers = materializedPendingDefaultHelpers(self.pendingDefaultHelpers)
		self.pendingDefaultHelpers.push(PendingDefaultHelper.create(DefaultHelperOwner.field(helperName), declaredType: fieldType, exprStart: self.pos, exprEnd: regionEnd, enclosingType: self.enclosingType))
		self.pos = regionEnd
		return helperName
	end 'captureFieldDefault'

	// ⭐ **THE VERDICT ON A FIELD'S LITERAL DEFAULT, ASKED ONLY WHERE IT CAN BE ANSWERED.** `as Integer =
	// 50.0` is the same lossy coercion `var x as Integer` then `x = 50.0` is, so it is the same
	// `requireAssignable` — but the DECLARED type may be a ranged-alias NAME, and a name reads as an
	// INTEGER (`tagIsIntegral`) until the alias registry can resolve it.
	//
	// ⚠ **`allFilesFolded` IS THE GATE**, the same one `checkGenericArgType` and `checkGenericInstance` sit
	// behind and for the identical reason: during the sweep this index is still being BUILT
	// (`Queries.queryProgramSignatures` hands the sweeper the index it is filling), so an alias that is
	// genuinely a `float(low to high)` reads as undeclared and the verdict is not merely discarded, it is
	// systematically WRONG — `as Weight = 2.5` would be refused as a lossy float→int conversion, which is
	// a rejection of legal code. The sweep is not a validator; the real parse is the only reader that
	// reports, and it is on the far side of the fold, so it resolves the alias and decides.
	function requireFieldDefaultType(nameTok Token, fieldType MaxonType, owner ByteArray, given ConstValue) throws ParseError
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		try self.requireAssignable(nameTok, value: given.tag, declared: self.floatResolvedTag(maxonTypeTag(fieldType), nameId: typeNameIdOf(fieldType)), declaredNameId: typeNameIdOf(fieldType), door: FunctionTypeDoor.field, placeOwner: owner, voice: SlotMismatchVoice.assignedPlace)
	end 'requireFieldDefaultType'

	// The literal a field default is, as the SAME tagged pair the constant evaluator speaks in — its
	// VALUE and its TAG, off one token, returned together so a caller cannot read one without the
	// other. `constantValueType` turns the tag into the field's declared type, which is the point:
	// shape 2 above derives that type from nothing but this token.
	//
	// It is a `ConstValue` and not a private record because it IS one — payload plus tag — and the
	// tag→`MaxonType` mapping already exists for the other producer of folded literals. A second
	// pair would have been a second answer to "what type is an integer literal".
	//
	// ⭐ **TYPE INFERENCE HERE IS A TOKEN-KIND LOOKUP, NOT CONSTANT EVALUATION**, and it has to be:
	// the type must be known when `ProgramSignatures.recordStruct` hashes the layout, and that runs
	// inside the declaration SWEEP — before `evaluateInitializers` has folded a single constant. A
	// token kind is available at scan time; a constant's value is not. (v1 infers it the same way,
	// from the same three token kinds: `inferShorthandFieldType`, Parser.maxon:3634-3665.)
	//
	// The three literal DECODERS are the emitting path's own (`intLiteralValue`, `__float_bitsFromText`,
	// `BoolTrueValue`) — the same ones `evalConstIntLiteral` and friends call, for their stated
	// reason: a field default must read a literal exactly as a function body reads it.
	// ⚠ **ITS PRECONDITION IS `defaultRegionIsLiteral`, AND THE FINAL PANIC IS WHAT SAYS SO.** Both callers
	// ask that question first, because the ANSWER decides which door reads the tokens at all; reaching the
	// bottom of this function means the classifier and the reader disagree about what a literal is, which is
	// a compiler defect and not a program the source can write.
	function readFieldDefaultLiteral() returns ConstValue throws ParseError
		let negated = self.at(TokenKind.minus)
		if negated 'signed'
			self.advance()
		end 'signed'

		if self.at(TokenKind.intLiteral) 'intLit'
			let tok = try self.consume(TokenKind.intLiteral)
			return ConstValue.create(try self.intLiteralValue(tok, negated: negated), tag: ValueTypeTag.integer)
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			let tok = try self.consume(TokenKind.floatLiteral)
			let bits = try self.floatLiteralBits(tok)
			return ConstValue.create(negatedFloatBits(bits) if negated else bits, tag: ValueTypeTag.float)
		end 'floatLit'

		// `= true` / `= false`. It cannot be NEGATED here — `defaultRegionIsLiteral` refuses a signed bool
		// as the expression it is — so no second refusal is written for it.
		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			let isTrue = self.at(TokenKind.true)
			self.advance()
			return ConstValue.create(BoolTrueValue if isTrue else BoolFalseValue, tag: ValueTypeTag.boolean)
		end 'boolLit'

		panic("readFieldDefaultLiteral: the default at token {self.pos} is not a literal, but `defaultRegionIsLiteral` said it was — the classifier that routes a field default and the reader that decodes it have come apart on which token kinds a literal is")
	end 'readFieldDefaultLiteral'

	// The index of the `)` that closes the balanced `( … )` group opening at `index`, or the EOF token's
	// index when the stream holds no matching one. Depth-counted rather than "scan to the first `)`"
	// because a group can nest (`int(0 to 100)` in a parameter's type, `(a) or (b)` in a condition).
	//
	// ⚠ ONLY MEANINGFUL AT A `(` — it panics otherwise, exactly as `matchingEndOf` does, rather than
	// answering for a token that opens no group.
	//
	// ⚠ It takes an INDEX because TWO walks ask it and only one of them is cursor-driven:
	// `skipBalancedParens` moves the cursor with it, while `keywordIsAName` asks it of an arbitrary
	// token (a keyword case name's payload binding list, `end(m) then …`). Written twice, the second
	// copy would be free to grow the "scan to the first `)`" shortcut this one refuses.
	function matchingRightParenOf(index TokenIndex) returns TokenIndex
		if self.kindAt(index) != TokenKind.leftParen 'notAGroup'
			panic("matchingRightParenOf: token {index} is not a `(` — a balanced group's extent is meaningful only at its opener")
		end 'notAGroup'

		let count = self.tokens.count()
		var depth = 0
		var i = index
		while i < count 'scan'
			let kind = self.kindAt(i)
			if kind == TokenKind.leftParen 'open'
				depth = depth + 1
			end 'open' else if kind == TokenKind.rightParen 'close'
				depth = depth - 1
				if depth == 0 'balanced'
					return i
				end 'balanced'
			end 'close' else if kind == TokenKind.eof 'unterminated'
				// The tolerant answer, for `skipBalancedParens`'s reason: an unbalanced group is malformed
				// source the real parse reports with a position. The EOF index is what tells the two callers
				// apart from a match — it is the one index at which `kindAt` is not a `)`.
				return i
			end 'unterminated'

			i = i + 1
		end 'scan'
		panic("matchingRightParenOf: ran off the end of a {count}-token stream — the lexer terminates every stream with an `eof` token, so the walk above must have returned at it")
	end 'matchingRightParenOf'

	// Advance past a balanced `( … )` starting at the cursor. Returns false — leaving the
	// cursor where the walk stopped — when the token stream does not hold one, which the real
	// parse will report properly.
	function skipBalancedParens() returns bool
		if not self.at(TokenKind.leftParen) 'noParen'
			return false
		end 'noParen'

		let closeIndex = self.matchingRightParenOf(self.pos)
		// An unterminated group answers the EOF index, so this test is exact rather than a proxy: on a
		// match the answer IS the `)`, and the cursor lands one past it.
		if self.kindAt(closeIndex) != TokenKind.rightParen 'unbalanced'
			self.pos = closeIndex
			return false
		end 'unbalanced'

		self.pos = (closeIndex + 1) as TokenIndex
		return true
	end 'skipBalancedParens'

	// One top-level declaration: an optional `export`, then a `function`, a `typealias` in any of its
	// three forms, a `type`, an `enum`, a `union`, an `interface`, an `extension`, or a `let`/`var` binding.
	// Anything else is rejected with a positioned error.
	//
	// ⭐ **`visibility` IS NOW LOAD-BEARING FOR A TYPEALIAS TOO (P1.9), where it used to be read and
	// dropped.** It decides two things, and neither could be answered without it:
	//
	//   • **REACHABILITY** — a non-exported alias is invisible to another file, which
	//     `export-keyword/error.non-exported-typealias-cross-file` pins as E2003 at the cast target.
	//     The carve-out that made this "a field nothing reads" — a stdlib alias must be nameable from
	//     anywhere regardless of what it wrote — is kept, and kept as a THIRD tier rather than as an
	//     exception: a stdlib declaration is `Visibility.global` (`RangedAliasRegistry`), so the
	//     visibility test has no special case in it at all.
	//   • **WHETHER AN UNUSED ALIAS CAN BE REPORTED** — an exported one cannot, because this file
	//     cannot see the uses another file makes of it (E3062, `reportUnusedTypeAliases`).
	//
	// It reaches the ranged registry through `readTypeAliasDeclaration` and the E3062 candidate list
	// through `recordTypeName`, from this one local — so the two records cannot come to disagree about
	// what the source wrote.
	//
	// A `type`'s visibility RIDES ITS LAYOUT (N1a). It used to be dropped here for the reason a typealias's
	// was — `project.structTypes` is whole-program — which made every declared type nameable from every file
	// whatever it wrote. Its METHODS each carry
	// their own, read at the member (see `parseTypeMember`), because that is where the source writes it.
	function dispatchTopLevel() throws ParseError
		let visibility = try self.consumeOptionalVisibility()

		// ⭐ **THE ONE PLACE THAT SEES ALL FIVE TYPE-MINTING KEYWORDS**, which is why the type-name
		// declaration record is taken here and not inside each of the five parsers: the record's whole
		// value is that its ORDER is the file's source order ACROSS kinds, and no per-kind site can
		// know that. The name token sits one past the keyword in every one of the five grammars, so its
		// INDEX is captured before the dispatch (each of those parsers leaves the cursor past its own
		// `end`) and the token itself is fetched only on the paths that record one — a `function` or a
		// `let` pays a scalar add and nothing else. The record is pushed only if the declaration
		// PARSED: a malformed one is the ParseError's, and must not claim a name.
		let nameIndex = self.pos + 1

		if self.at(TokenKind.function) 'isFunction'
			// A FILE-scope function takes no receiver: there is no enclosing type for one to be.
			try self.parseFunction(visibility, takesReceiver: false)
		end 'isFunction' else if self.at(TokenKind.typealias) 'isTypeAlias'
			let form = try self.readTypeAliasDeclaration(self.artifact.typeAliases, functionOut: self.artifact.functionTypeAliases, genericOut: self.genericAliasScratch, tupleOwner: TupleAliasOwner.fileScope, recordFunctionSignature: true, visibility: visibility)
			self.recordTypeName(nameIndex, kind: form, visibility: self.typeAliasVisibility(visibility))
		end 'isTypeAlias' else if self.at(TokenKind.type) 'isTypeDecl'
			try self.parseTypeDeclaration(visibility)
			self.recordTypeName(nameIndex, kind: TypeDeclKind.structType, visibility: visibility)
		end 'isTypeDecl' else if self.at(TokenKind.enum) or self.at(TokenKind.union) 'isEnumDecl'
			let isUnion = self.at(TokenKind.union)
			try self.parseEnumDeclaration(isUnion, visibility: visibility)
			self.recordTypeName(nameIndex, kind: TypeDeclKind.unionType if isUnion else TypeDeclKind.enumType, visibility: visibility)
		end 'isEnumDecl' else if self.at(TokenKind.interface) 'isInterfaceDecl'
			try self.parseInterfaceDeclaration()
			self.recordTypeName(nameIndex, kind: TypeDeclKind.interfaceType, visibility: visibility)
		end 'isInterfaceDecl' else if self.at(TokenKind.extension) 'isExtensionDecl'
			// It mints NO type name, so no `recordTypeName` — an extension names nothing, it adds methods to
			// types other declarations named. See `parseExtensionDeclaration`.
			try self.parseExtensionDeclaration()
		end 'isExtensionDecl' else if self.atTopLevelBindingKeyword() 'isBinding'
			// The declaration EMITS NOTHING — for a `var` exactly as for a `let`. A constant inlines at
			// every read; a var's slot is laid down by the backend from the arena
			// (`ProgramSignatures.declaredGlobals`), and its every read and write is emitted at the USE
			// site. So there is nothing for the real parse to build here either way, only something for
			// it to REPORT.
			let decl = try self.readTopLevelBinding(visibility, qualifier: EmptySourceText)
			try self.raiseBindingFailure(decl)
		end 'isBinding' else 'notADeclaration'
			let tok = self.current()
			throw ParseError.expectedDeclaration(tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'notADeclaration'
	end 'dispatchTopLevel'

	// File the type name a top-level declaration just minted, for the whole-program duplicate check
	// `commitTypeNameDecls` makes at the merge. The position is the NAME token's — the collision blames
	// the declaration the author wrote, never the keyword and never the incumbent. Takes the token's
	// INDEX rather than the token, because the cursor has already moved past the declaration by the
	// time this is called and `dispatchTopLevel` must not pay for a token it may never record.
	// It ALSO enrols a non-exported typealias as an E3062 candidate, because this is the one site that
	// holds all three facts at once — the name token, the FORM (only a `typealias` is a candidate;
	// `isTypeAliasDecl` is the one place that classification lives), and the visibility the source
	// wrote. Splitting it out would mean fetching the same token twice off the same index.
	//
	// ⚠ Only a TOP-LEVEL alias is a candidate. A nested one (`typealias Idx = …` inside a `type` body)
	// never reaches here — `parseTypeMember` reads it — and it is deliberately not enrolled elsewhere:
	// it is a member of a type, not a declaration of a file, and its uses are the type's.
	function recordTypeName(nameIndex TokenIndex, kind TypeDeclKind, visibility Visibility)
		let nameTok = self.tokenAt(nameIndex)
		self.artifact.recordTypeNameDecl(TypeNameDecl.create(nameTok.value, kind: kind, declFilePath: self.filePath, nameLine: nameTok.line, nameColumn: nameTok.column))

		if not isTypeAliasDecl(kind) or visibility != Visibility.file 'notAnUnusedCandidate'
			return
		end 'notAnUnusedCandidate'

		self.declaredTypeAliases = appendDeferredNameDiagnostic(self.declaredTypeAliases, entry: DeferredNameDiagnostic.create(nameTok.value, filePath: self.filePath, line: nameTok.line, column: nameTok.column))
	end 'recordTypeName'

	// ⭐ **RECORD THAT THIS FILE WROTE A TYPE NAME IN A TYPE POSITION (P1.9) — the E3062 "used" half.**
	//
	// ⚠ **THE RULE IS A LITERAL NAME IN A TYPE POSITION, AND NOTHING ELSE.** In particular, being
	// IMPLICITLY INFERABLE is not a use: a bare `[1, 2, 3]` literal in a file that declares
	// `typealias IntArray = Array with Integer` COULD be inferred as that alias, and both reference
	// compilers still report the alias unused — the bootstrap's own comment says implicit binding
	// "masked real unused-typealias mistakes" (`2-Parser.cs:18637`). `arrays/error.unused-array-typealias`
	// pins exactly that program.
	//
	// ⭐ **THREE SITES, and they are three because that is how many DOORS shv2 has, not because a list
	// was drawn up.** v1 marks uses at ~26 hand-maintained call sites scattered through its parser, and
	// its own surveyor flags that as a completeness risk — a new type position silently forgets to mark.
	// shv2 resolves written type names through far fewer doors, so a use is recorded where a name is
	// RESOLVED:
	//
	//   1. `parseTypeReference` — the ONE type-reference parser, reached by every parameter type, return
	//      type, field and payload type, generic type ARGUMENT, function-alias signature, `sizeof(T)`
	//      operand and body `as` cast target. Ten call sites, one hook.
	//   2. `parseQualifiedCall` — `IntArray.create()`. A generic-instance alias is very often named ONLY
	//      here, and this base name is a raw token that never reaches (1).
	//   3. A TYPE NAME A TOP-LEVEL INITIALIZER WRITES — a cast's target, or a container factory's alias
	//      (`ProgramSignatures.namesTypeInConstInitializer`) — which the real parse cannot see at all,
	//      because it SKIPS the initializer's tokens and the const evaluator that does read them runs
	//      before any file is parsed. See that function.
	//
	// It takes NAMES indiscriminately — a struct name, an interface name, a type parameter — because a
	// recording site does not know what a written name denotes and must not have to ask. The filtering
	// happens once, at `reportUnusedTypeAliases`, against this file's own declarations.
	function recordTypeNameUse(name ByteArray)
		if not self.collectsTypeNameUses 'notTheReportingWalk'
			return
		end 'notTheReportingWalk'

		if self.usedTypeNames is sharedEmptyUsedTypeNames 'stillShared'
			self.usedTypeNames = UsedTypeNameSet.create()
		end 'stillShared'
		self.usedTypeNames.insert(name)
	end 'recordTypeNameUse'

	// ⭐ **A TYPE THIS FILE REACHED INTO — `recordTypeNameUse`'s twin for the fact a written name cannot
	// carry.** Two call sites, one per family of reach and each stating its own rule: `requireFieldAccessible`
	// (a struct's field) and `emitEnumTagOf` (an enum's or union's tag). The copy-on-write shape and the
	// `collectsTypeNameUses` gate are its twin's, for its twin's reason — `parseModule` is the only walk whose
	// artifact anyone reads these sets off, so any other one would hash into a set it discards.
	// Sharing ONE empty singleton with `usedTypeNames` is deliberate: the seed is an identity test, so a
	// second empty of the same type would be a fact to remember rather than one to derive.
	function recordMemberAccessedTypeName(name ByteArray)
		if not self.collectsTypeNameUses 'notTheReportingWalk'
			return
		end 'notTheReportingWalk'

		if self.memberAccessedTypeNames is sharedEmptyUsedTypeNames 'stillShared'
			self.memberAccessedTypeNames = UsedTypeNameSet.create()
		end 'stillShared'
		self.memberAccessedTypeNames.insert(name)
	end 'recordMemberAccessedTypeName'

	// ⭐ **E3062, ONCE PER FILE, AT THE END OF ITS PARSE** — every non-exported top-level typealias whose
	// name this file never wrote in a type position, in DECLARATION order.
	//
	// The report is not made here: it is recorded and drained after every file is parsed, for the
	// ordering reason `DeferredNameDiagnostic`'s header states in full.
	//
	// ⚠ An EXPORTED alias is exempt, and that is not leniency — it is the only sound answer a per-file
	// check can give. Its uses may be in any other file, and this check sees one file, so reporting it
	// could only ever be a false positive. (It is also why the pinned cross-file case reports TWICE: an
	// alias that is non-exported AND used only from elsewhere is genuinely unused in its own file, and
	// genuinely invisible at the use.) The exemption is applied at `recordTypeName`, so an exported
	// alias is never even a candidate.
	function reportUnusedTypeAliases()
		for candidate in self.declaredTypeAliases 'each'
			if self.usedTypeNames.contains(candidate.name) 'usedInABody'
				continue
			end 'usedInABody'

			// The third door, asked SECOND because it costs a composite key where the set above costs a
			// hash of bytes already in hand — and asked once per file-private alias DECLARED, which is
			// the smallest population any of the three is asked of.
			if self.signatures.namesTypeInConstInitializer(candidate.name, declFilePath: self.filePath) 'usedByAConstant'
				continue
			end 'usedByAConstant'

			self.artifact.recordUnusedTypeAlias(candidate)
		end 'each'
	end 'reportUnusedTypeAliases'

	// ⭐ A TOP-LEVEL `let` IS A COMPILE-TIME CONSTANT, AND THE DECLARATION IS WHERE ITS DIAGNOSTIC
	// LANDS — but not where its VALUE is computed.
	//
	// The declaration itself emits NO op and reserves NO storage. The whole-program sweep already
	// folded this initializer to a number (`ProgramSignatures.evaluateInitializers`), and every USE
	// inlines that number as an ordinary `literal` (`topLevelConstantReference`). So there is nothing
	// left for the real parse to build — only something for it to REPORT, if the fold failed.
	//
	// That split is why the value is not simply computed here: this file's parse can see this file's
	// initializer, and neither a forward reference (`let TOTAL = FIRST + SECOND` above `FIRST`) nor a
	// cross-file `export let` is visible to it. Both are ordinary in the corpus, so the fold has to
	// happen where every declaration is already in view, and that is the sweep. v1 splits it exactly
	// here too — its parser records an unresolved initializer and TypeResolution evaluates it.
	//
	// A DECL WHOSE FOLD FAILED IS REPORTED HERE, AND EXACTLY ONCE. `poisoned` is silent on purpose —
	// its defect belongs to another declaration, which reports it (see `TopLevelConstant.poisoned`).
	//
	// `declaredOutcome` carries the DRIFT GUARD: a `let` the real parse dispatches at top
	// level must be one the sweep recorded, and a miss panics rather than compiling.
	function raiseBindingFailure(decl TopLevelDecl) throws ParseError
		// A REDECLARATION is reported HERE, at the later declaration — the top-level twin of the
		// duplicate-FUNCTION E3006 `commitFuncSignatures` raises. Checked BEFORE the outcome match
		// because a duplicate is an error independent of whether the first declaration's initializer
		// also failed: that failure reports at the FIRST declaration's own statement, this at the later.
		if self.signatures.isRedeclaredBinding(decl) 'redeclared'
			throw ParseError.duplicateTopLevelDeclaration(String.from(decl.name), line: decl.nameLine, column: decl.nameColumn)
		end 'redeclared'

		// ⚠ The outcome is bound to a LOCAL before the match, and the match's payload is bound to a
		// second one before the throw. Neither is style. Matching the CALL directly and throwing the
		// arm's binding —
		//
		//     match self.signatures.declaredOutcome(decl) 'outcome'
		//         failed(error) then throw error
		//
		// — crashes the compiled compiler with `mm_incref called with NULL pointer`, because the
		// bootstrap drops the temporary scrutinee's box while the payload it lent out is still in
		// flight. This is the sharp end of the hazard `emitShift` already documents (a `throw` of a
		// union that was RETURNED rather than constructed inline LEAKS); here it is not a leak but a
		// null-pointer panic. Recorded for OPEN.md.
		let outcome = self.signatures.declaredOutcome(decl)

		// ⭐⭐ **A STRUCT CONSTRUCTION FILLING AN INTERFACE-TYPED FIELD IS REFUSED HERE, AND HERE IS THE
		// EARLIEST DOOR THAT CAN (W116 review).** The constant evaluator cannot see such a field at all — the
		// swept column is still a bare `named` while it runs — so its slot check compared a scalar against a
		// slot nothing had yet called an interface and admitted a box with an uninitialized witness half.
		// `ProgramSignatures.existentialFieldOfConstConstruction` carries the measurement; the SENTENCE is the
		// body path's own, through the one producer both doors throw it from.
		//
		// It reads the outcome bound just above rather than fetching its own: the settled outcome is one fact
		// and `declaredOutcome` carries the drift guard that asserts it, so asking twice would be one lookup
		// spent twice on a value that cannot have changed between the two lines.
		match self.signatures.existentialFieldOfConstConstruction(outcome) 'existentialField'
			none then break 'existentialField'
			existentialField(layout, index) then throw self.existentialFieldStoreUnsupported(layout, index: index, line: decl.nameLine, column: decl.nameColumn)
		end 'existentialField'

		match outcome 'outcome'
			// ⭐ **NOTHING A TOP-LEVEL BINDING CAN FOLD TO IS UNSTORABLE ANY MORE** (P1.7 slice 2a). A
			// scalar occupies its `.data` slot as a value; a MANAGED one occupies it as a POINTER that
			// `__module_init` fills before `main` (see `ModuleInit`). The `requireStorableGlobal` guard
			// that used to stand here — the E2015 refusing `var s = "hi"` — is gone with the reason for
			// it, and its remaining half lives in `globalStdType`, which was already the other copy of
			// the same enumeration and is now the only one.
			value then break 'outcome'
			failed(error) then try self.throwRecordedConstantError(error)
			poisoned to boxedUnionValue then break 'outcome'
			pending to evaluating then panic("Parser.raiseBindingFailure: top-level binding '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` runs to completion inside `queryProgramSignatures`, before any file is parsed")
		end 'outcome'
	end 'raiseBindingFailure'

	// Re-raise a diagnostic the constant evaluator recorded earlier, on another file's behalf. It
	// exists only to give the borrowed payload a scope of its own — see `raiseConstantFailure`.
	function throwRecordedConstantError(error ParseError) throws ParseError
		throw error
	end 'throwRecordedConstantError'

	// Read a top-level binding declaration: `[export] (let|var) <NAME> = <constant expression>`.
	//
	// It READS and does not RECORD, for exactly `readTypeAliasDeclaration`'s reason: it has two
	// callers that record differently. The tolerant declaration sweep folds what it reads into the
	// whole-program index (`recordScannedBinding`); the real parse reads it only to ask that index
	// what the initializer came to, and to raise the answer as a POSITIONED diagnostic if it failed.
	//
	// One reader, so the sweep and the parse can never drift on where an initializer ENDS — which is
	// the one thing they must agree on, because the range this returns is the range the evaluator
	// walks. Two scanners would put the sweep's idea of the initializer and the parser's idea of it a
	// token apart, and the evaluator would fold a different expression than the one the user wrote.
	//
	// ⭐ **`let` AND `var` READ IDENTICALLY, WHICH IS WHY THIS IS ONE FUNCTION.** They differ in the
	// keyword and in nothing else: `static-variables.md` states that a top-level `var`'s initializer
	// obeys the same constant-expression rules as a `let`'s, so the same token range feeds the same
	// evaluator. The mutability is simply carried through to the decl, where it decides storage.
	//
	// ⭐⭐ **AND A `static let` / `static var` MEMBER OF A `type` BODY READS THROUGH IT TOO (W65), WHICH IS
	// THE WHOLE OF THAT FEATURE'S STORAGE MODEL.** `qualifier` is empty at file scope and the enclosing
	// type's name inside a `type` body, so a static member is a top-level binding whose NAME is
	// `Counter.count` — and every downstream mechanism (the constant evaluator, the `.data` arena, the
	// `__module_init` store, dead-global elimination, the read and write doors) is keyed by that name and
	// needed no teaching at all. See `declaredBindingName` for why the qualification IS the per-type
	// identity rather than something built beside it.
	function readTopLevelBinding(visibility Visibility, qualifier ByteArray) returns TopLevelDecl throws ParseError
		let mutable = self.at(TokenKind.var)
		try self.consume(TokenKind.var if mutable else TokenKind.let)
		let nameTok = try self.consume(TokenKind.identifier)
		// The BARE name is what the reserved test sees, exactly as `parseFunction` checks `create` rather
		// than `Point.create`: the qualifier is the compiler's, not the author's, and a `__`-prefixed
		// member is the mistake being looked for.
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try self.consume(TokenKind.equals)

		let initStart = self.pos
		let initEnd = self.initializerEndIndex(initStart)
		self.pos = initEnd

		// ⭐ **THE SCOPE IS READ OFF THE QUALIFIER, HERE, WHERE IT IS A PARAMETER** — the caller states which
		// body it is reading (`parseTypeMember` passes the enclosing type, the file-scope dispatcher passes
		// nothing), so the fact is recorded at the one place that is TOLD it rather than inferred later from
		// the shape of the name. See `TopLevelDecl.scope` for why the two positions differ at all.
		return TopLevelDecl.create(self.declaredBindingName(qualifier, nameTok: nameTok), mutable: mutable, visibility: visibility, declFilePath: self.filePath, tokens: self.tokens, initStart: initStart, initEnd: initEnd, nameLine: nameTok.line, nameColumn: nameTok.column, scope: TopLevelBindingScope.fileScope if qualifier.isEmpty() else TopLevelBindingScope.typeMember(qualifier))
	end 'readTopLevelBinding'

	// ⭐ **THE STORAGE NAME A BINDING DECLARATION CLAIMS — bare at file scope, `Type.member` inside a `type`
	// body (W65).** The same construction `declaredMethodName` gives a method, because a static member and a
	// static method are qualified by the same thing for the same reason: the enclosing type is the scope the
	// name lives in. Both references key a static field exactly this way — the bootstrap's `ParseStaticField`
	// builds `$"{typeName}.{fieldName}"` (`maxon-sharp/Compiler/2-Parser.cs:7812`) and v1 keys a `static let`
	// "by its enclosing type" (`maxon-selfhosted/Compiler/Project.maxon:187`) — so `TypeA.value` and
	// `TypeB.value` are two slots BY CONSTRUCTION, with no per-type disambiguation left to get wrong.
	//
	// ⚠ It deliberately does NOT route through `declaredMethodName`, which also applies the free-function
	// DIRECTORY CONTEST (N1c). That rule is about two directories declaring one callable name; a top-level
	// binding's name is flat and project-wide by ruling (`ProgramSignatures.isRedeclaredBinding`), so
	// borrowing the contest here would give a static member a directory-qualified spelling no read door
	// looks it up under.
	function declaredBindingName(qualifier ByteArray, nameTok Token) returns ByteArray
		return nameTok.value if qualifier.isEmpty() else qualifiedMethodName(qualifier, methodName: nameTok.value)
	end 'declaredBindingName'

	// One past the last token of a top-level initializer: an initializer runs to the END OF ITS LINE.
	// Maxon has no statement terminator, so the newline IS the boundary — the bootstrap reads it the
	// same way (`SkipToEndOfLine`, 2-Parser.cs:1701).
	//
	// ⚠ **EXCEPT INSIDE `[…]`, WHERE A NEWLINE IS LAYOUT AND NOT A TERMINATOR.** `var xs = [10,\n\t20]`
	// is one initializer written on two lines, and the runnable oracle folds it as one; ending the range at
	// the first newline handed the evaluator `[10,` and reported `Expected expression but got 'newline'`
	// against a program the language accepts. The depth counter is what tells the two newlines apart, and it
	// is the SAME rule the element walks below apply at their own boundaries (`finishArrayLiteral`) — a
	// literal's shape must not depend on where its author pressed return.
	//
	// It cannot run away: `kindAt` answers `eof` past the end of the token array (see `tokenAt`), so
	// an unterminated last line — or an unclosed `[` — stops at the file's end rather than walking off it.
	function initializerEndIndex(start TokenIndex) returns TokenIndex
		var i = start
		var depth = 0 as BracketDepth
		while true 'scan'
			let kind = self.kindAt(i)
			if kind == TokenKind.eof 'fileEnd'
				break
			end 'fileEnd'

			if kind == TokenKind.newline and depth == 0 'lineEnd'
				break
			end 'lineEnd'

			if kind == TokenKind.leftBracket 'openBracket'
				depth = depth + 1
			end 'openBracket'

			// Guarded, because `BracketDepth` is unsigned: a stray `]` with no `[` before it would wrap the
			// counter to its maximum and the scan would swallow the rest of the FILE. Left at 0 it is simply
			// not a bracket the initializer opened, and the line's own newline still ends the range — which
			// is what the malformed initializer's diagnostic then names.
			if kind == TokenKind.rightBracket and depth > 0 'closeBracket'
				depth = depth - 1
			end 'closeBracket'

			i = i + 1
		end 'scan'

		return i
	end 'initializerEndIndex'

	// Parse a ranged typealias declaration: `typealias <Name> = int(<low> to|upto <high>)` or
	// `typealias <Name> = float(<low> to <high>)`. Nearly every real Maxon file opens with one —
	// `int` is almost never written bare in a type position (specs/ranged-typealias.md) — so this
	// is the declaration that gates most of the corpus.
	//
	// It emits NO op: an alias is a DECLARATION, and its whole effect is the registry
	// entry its caller records, which TypeResolution substitutes for every `MaxonType.named`
	// use of the name. Two aliases over the same range are therefore the SAME type — an
	// alias creates no nominal distinction — and a use in a type position needs no parser
	// change at all (`parseTypeReference` already interns a bare identifier).
	//
	// It READS and PUSHES into the caller's arrays, because it has two callers that collect differently:
	// the real parse files the alias in this file's artifact arrays, and the whole-program declaration
	// sweep folds it into its own arrays. One reader, so the two can never disagree about what a range
	// means. A typealias is EITHER a ranged numeric one (into `rangedOut`) or a FUNCTION one (into
	// `functionOut`), and pushing into the target array directly avoids boxing a discriminated-union
	// return on the per-typealias path (nearly every file opens with a `typealias`, so it is a hot one).
	//
	// The RANGE is not yet enforced as a bound: a narrowing conversion into a ranged alias is
	// checked at run time, and that check is a later milestone. It IS read, and by more than the
	// registry — a range whose low bound is 0 declares an UNSIGNED type, and that decides how every
	// `shr` on a value of it fills (TypeRules' `rangeIsUnsigned`).
	//
	// It RETURNS THE FORM it read, and that is not a convenience: the three forms denote three
	// different things and only the ranged one is resolved per declaring FILE, so a duplicate-name
	// rule has to tell them apart (`TypeNameRegistry`). The alternative — the caller inferring the
	// form from which array grew, or re-deciding it off the tokens — would be a second copy of the
	// discrimination this function already makes, which is this project's signature bug.
	// `visibility` reaches the RANGED form's registry entry and — since N3 — the GENERIC-INSTANCE form's,
	// because those are the two alias registries a cross-file reference is resolved through
	// (`RangedAliasRegistry.lookup`, `ProgramSignatures.scopedGenericAliasInstance`). Both apply it at the
	// READ and not as a key, for the reason `RangedAliasRegistry`'s header gives. A FUNCTION alias still
	// mints its nominal identity in a whole-program registry with no visibility reader — and that registry
	// has the defect N3 cured here, but curing it needs more than a scoped lookup: a function alias resolves
	// to `MaxonType.function(<the alias NAME>)`, so two files' declarations stay ONE type however the lookup
	// is scoped. See `ProgramSignatures.contestedGenericAliases`.
	function readTypeAliasDeclaration(rangedOut RangedTypeAliasArray, functionOut FunctionTypeAliasArray, genericOut GenericAliasEntryArray, tupleOwner TupleAliasOwner, recordFunctionSignature bool, visibility Visibility) returns TypeDeclKind throws ParseError
		try self.consume(TokenKind.typealias)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try self.consume(TokenKind.equals)

		// A FUNCTION typealias — `function(paramTypes) [returns T]` (P1.5-A1). The literal `function(…)`
		// form is legal ONLY as a typealias RHS (the spec), so this is the one place it is parsed as a
		// type. It records its own registry (`FunctionTypeAlias`), not the ranged one.
		// `recordFunctionSignature` is the REAL parse's signal that this alias's whole declared signature —
		// its `#81` display string and its parameter types — is wanted; the sweep and the nested-alias reader
		// pass false (see `readFunctionTypeAlias` for why only the real parse may record it).
		if self.at(TokenKind.function) 'functionAlias'
			// A function alias mints a NOMINAL identity (`resolveNamedAlias` re-tags a `named` reference to
			// `function`), so it may not take a compiler-owned type name — unlike the ranged form below, which
			// erases, and unlike the generic-instance form below, which names an instance rather than minting
			// one. See `requireTypeNameNotCompilerOwned`.
			try self.requireTypeNameNotCompilerOwned(nameTok, declares: DeclaredTypeMeaning.nominalIdentity)
			functionOut.push(try self.readFunctionTypeAlias(nameTok, recordSignature: recordFunctionSignature))
			return TypeDeclKind.functionAlias
		end 'functionAlias'

		// A GENERIC-INSTANCE typealias (P1.6-A) — `IntBox = Box with Integer`. Recognized by a base
		// identifier followed by `with`. It records its own registry (`GenericAliasEntry`), not the
		// ranged one, and (in the REAL parse) checks the instantiation's arity and managed arguments.
		if self.at(TokenKind.identifier) and self.kindAt(self.pos + 1) == TokenKind.with 'genericAlias'
			// ⭐⭐ **THE ONE FORM WHOSE MEANING HAS TO BE *READ* BEFORE THE COMPILER-OWNED RULE CAN BE ASKED**
			// (spec-port `lazy-static`). A generic-instance alias mints no identity — it NAMES the instance its
			// base and arguments intern to (`resolveNamedAlias` re-tags a `named` reference to
			// `genericInstance`) — so a redeclaration of an owned name AGREES exactly when that instance is the
			// compiler's own, which is a fact about the RHS. Hence: read the alias, then judge it.
			//
			// ⚠ **AND THE ENTRY IS PUSHED ONLY AFTER THE VERDICT.** The guard used to stand ahead of the read,
			// so a refused declaration reached no registry; pushing first would leave the SWEEP holding a
			// contested alias whose diagnostic the real parse raises later, i.e. a registry describing a
			// program the compiler rejected.
			let entry = try self.readGenericInstanceAlias(nameTok, visibility: self.typeAliasVisibility(visibility))
			try self.requireTypeNameNotCompilerOwned(nameTok, declares: DeclaredTypeMeaning.genericInstance(entry.baseName, args: entry.args, argCount: entry.argCount))
			genericOut.push(entry)
			return TypeDeclKind.genericAlias
		end 'genericAlias'

		// A TUPLE typealias (P1.10) — `typealias Pair = (Num, Num)`. Its RHS is a tuple TYPE, read by the same
		// `parseTupleTypeReference` a parameter or return annotation uses, so a tuple written as an alias and
		// one written inline are ONE type. Like the RANGED form and unlike the function/generic ones it mints
		// no nominal identity — a `Pair` reference resolves straight through to the tuple's `structRef` — so
		// `requireTypeNameNotCompilerOwned` does not apply to it either.
		if self.at(TokenKind.leftParen) 'tupleAlias'
			let tupleType = try self.parseTupleTypeReference()
			let target = try self.artifact.typeNames.nameOf(typeNameIdOf(tupleType)) otherwise panic("readTypeAliasDeclaration: the tuple type just minted for this alias carries an id that is not in this file's interner — `parseTupleTypeReference` interns its name into exactly that table")

			// The KEY is the caller's, never this reader's (W43) — see `TupleAliasOwner`. The tuple itself is
			// interned above whatever the owner says, because the ELEMENTS have to be validated on every read
			// or a malformed nested alias inside a withheld extension body would go unreported.
			match tupleOwner 'owner'
				fileScope then self.signatures.recordTupleAlias(nameTok.value, tupleName: target)
				enclosingType(owner) then self.signatures.recordTupleAlias(joinQualifiedName(owner, member: nameTok.value), tupleName: target)
				unpublished then break 'owner'
			end 'owner'
			return TypeDeclKind.tupleAlias
		end 'tupleAlias'

		// `int(...)` or `float(...)`. A `bool` alias has no range and a generic alias (`Array with T`)
		// is handled above — each remaining RHS is rejected here, naming its own gap, rather than
		// being mapped onto a numeric path where it would silently mean something else. The two
		// numeric forms differ ONLY in how their bounds read (int literals + `<int>.min/.max` versus
		// float literals + `f32`/`f64.min/.max`), so `isFloat` threads through the shared bound parser
		// rather than forking it.
		let isFloat = self.at(TokenKind.float)
		if not self.at(TokenKind.int) and not isFloat 'notNumeric'
			let tok = self.current()

			// ⭐ A BARE SIZED TYPE (`typealias Integer = i64`) gets its OWN diagnostic, not the generic
			// "unsupported" below, because it is not a missing feature — it is a rule, and the rule
			// comes with the rewrite that satisfies it. `i64` names a WIDTH and no RANGE, and every
			// reader shv2 has asks a ranged alias for its bounds, so the shorthand would mint a type
			// whose narrowing check has nothing to check against.
			//
			// ⚠ **GUARDED ON THE NEXT TOKEN NOT BEING `.`**, exactly as v1 guards it
			// (`maxon-selfhosted/Compiler/Parser.maxon:4967`): the sized names are also the qualifiers
			// of a range BOUND, and a diagnostic that fired on the first token of `i64.min` would
			// refuse the very syntax it recommends.
			if tok.kind == TokenKind.identifier and self.kindAt(self.pos + 1) != TokenKind.dot and isSizedTypeName(tok.value) 'bareSizedType'
				throw ParseError.bareSizedTypeAlias(String.from(tok.value), line: tok.line, column: tok.column)
			end 'bareSizedType'

			throw ParseError.unsupported("a typealias over '{tok.kind.rawValue}' (only `int(low to high)`, `float(low to high)` and `function(...)` are parsed; generic and bare-sized aliases arrive with the milestones that give them meaning)", line: tok.line, column: tok.column)
		end 'notNumeric'

		// The `int`/`float` keyword itself — the anchor for both range diagnostics below, taken before
		// it is consumed. Both reference compilers blame this token and not a bound's own, because the
		// defect is the RANGE and neither end is more at fault than the other.
		let primitiveTok = self.current()

		if isFloat 'consumeFloat'
			try self.consume(TokenKind.float)
		end 'consumeFloat' else 'consumeInt'
			try self.consume(TokenKind.int)
		end 'consumeInt'

		try self.consume(TokenKind.leftParen)
		let low = try self.parseRangeBound(isFloat)
		let high = try self.parseRangeUpperBound(isFloat)
		try self.consume(TokenKind.rightParen)
		try self.requireRepresentableRange(primitiveTok, low: low, high: high, isFloat: isFloat)

		let underlying = MaxonType.float if isFloat else MaxonType.integer
		let tier = self.typeAliasVisibility(visibility)
		rangedOut.push(RangedTypeAlias.create(nameTok.value, underlying: underlying, low: low.value, high: high.value, visibility: tier, declFilePath: self.filePath, nameLine: nameTok.line, nameColumn: nameTok.column))
		self.pushNamespaceQualifiedAlias(rangedOut, nameTok: nameTok, underlying: underlying, low: low.value, high: high.value, tier: tier)

		return TypeDeclKind.rangedAlias
	end 'readTypeAliasDeclaration'

	// ⭐⭐ **THE DIRECTORY-QUALIFIED MIRROR OF A RANGED TYPEALIAS (N1b)** — `api/types.maxon`'s `Score` is
	// filed a SECOND time under `api.Score`, which is what makes `50 as api.Score` resolve to THAT
	// declaration's range rather than to whichever same-named one the bare lookup happened to win with.
	//
	// ⭐ **IT IS A SECOND DECLARATION IN THE SAME ARRAY, AND THAT IS THE WHOLE DESIGN.** `readTypeAliasDeclaration`
	// is the ONE reader of the typealias grammar — the tolerant sweep and the real parse both come through it —
	// so one push here reaches BOTH ranged-alias registries (`ProgramSignatures.typeAliases` via `foldFile`,
	// `Project.typeAliases` via `commitTypeAliases`) and every door they already have answers for the qualified
	// key with no new code: the scoped `lookup`, the visibility test `aliasVisibleFrom`, the erasure
	// `underlyingInAnyFile`, the whole-program stride `storageBytesInEveryFile`, the parse-memo hash. A
	// dedicated qualified index would have had to re-implement each of those, and would have been free to
	// disagree with them. It is v1's answer, in shv2's idiom (`maxon-selfhosted/Compiler/Parser.maxon:4794-4806`,
	// "register under the qualified key `{namespace}.{name}` whenever the declaration is observable").
	//
	// ⚠ **GATED ON `visibility != file`, WHICH IS v1's GATE AND IS NOT THE FUNCTION SIDE'S.** A file-private
	// alias can be named from nowhere but its own file, where the BARE name already reaches it — so a
	// qualified mirror would be an entry no program can legally use, bought for every private alias in every
	// namespaced file. (The function side deliberately does NOT gate, because a call's tier is decided by a
	// check that runs AFTER resolution and would report the wrong mistake if resolution swallowed it; a cast
	// target's tier is decided by `everyDeclarationHidden` on the resolved alias, which needs the alias found
	// first — and a private alias's own file finds it bare.)
	//
	// ⚠ **THE MIRROR IS NOT A DUPLICATE DECLARATION.** `commitTypeNameDecls` owns E3061 and reads a different
	// array, and `commitTypeAliases`'s E3105 is suppressed for the mirror — see `mirrorsANamespaceQualifiedAlias`.
	function pushNamespaceQualifiedAlias(rangedOut RangedTypeAliasArray, nameTok Token, underlying MaxonType, low ParsedInt, high ParsedInt, tier Visibility)
		if tier == Visibility.file or self.namespace.isEmpty() 'noQualifiedSpelling'
			return
		end 'noQualifiedSpelling'

		rangedOut.push(RangedTypeAlias.create(namespaceQualifiedName(self.namespace, name: nameTok.value), underlying: underlying, low: low, high: high, visibility: tier, declFilePath: self.filePath, nameLine: nameTok.line, nameColumn: nameTok.column))
	end 'pushNamespaceQualifiedAlias'

	// ⭐ **CAN A SINGLE 64-BIT TYPE HOLD THIS DECLARED RANGE?** The two ways it cannot, checked at the
	// declaration — which is the only place the answer is still knowable, because `RangedTypeAlias`
	// stores the bounds as bare numbers and `u64.max` rides as the wrapped -1 (see `ParsedRangeBound`).
	//
	// ⚠ **THE ORDER OF THE TWO IS DELIBERATE AND IT IS PINNED.** `int(i64.min to u64.max)` fails both
	// tests, and the MISMATCH is the sharper fact: the author named two types, and once that is fixed
	// the representability question does not arise. Reporting unrepresentability first would describe a
	// consequence and leave the cause unnamed. Both reference compilers order it this way for this
	// reason (`2-Parser.cs:4826-4830` says so in a comment); `error.unrepresentable-range` pins it.
	function requireRepresentableRange(primitiveTok Token, low ParsedRangeBound, high ParsedRangeBound, isFloat bool) throws ParseError
		// Two TYPE-QUALIFIED ends naming different types. A LITERAL end names no type at all and is
		// compatible with every qualifier — `int(0 to i32.max)` is legal and common — which is why the
		// test is "both are qualified AND they disagree" and not "they disagree".
		if not low.qualifier.isEmpty() and not high.qualifier.isEmpty() and not low.qualifier.equals(high.qualifier) 'mismatchedBoundTypes'
			throw ParseError.mismatchedRangeBoundTypes(low.spelling(), high: high.spelling(), line: primitiveTok.line, column: primitiveTok.column)
		end 'mismatchedBoundTypes'

		// ⚠ INTEGER ALIASES ONLY. A float bound's `value` is an IEEE-754 BIT PATTERN, so a negative
		// float has its sign bit set and reads `< 0` here while meaning nothing of the sort; and
		// `namesUnsignedMax` cannot fire in a float alias anyway, since a `u64.max` bound there is the
		// integer bound `float(...)` deliberately tolerates. Testing it would be comparing a bit
		// pattern with a count.
		if isFloat 'floatAlias'
			return
		end 'floatAlias'

		// A negative lower with a `u64.max` upper needs 65 bits. Left unchecked, the wrapped upper
		// collapses the range to `-1 to -1` and every later check answers about a range nobody wrote.
		if low.value < 0 and high.namesUnsignedMax 'unrepresentable'
			throw ParseError.unrepresentableIntegerRange(low.value, line: primitiveTok.line, column: primitiveTok.column)
		end 'unrepresentable'
	end 'requireRepresentableRange'

	// Is the cursor at a typealias declaration — `typealias …`, or the `export typealias …` the spec
	// writes? A peek only; the caller consumes. Shared by the two walks that must recognize the form
	// WITHOUT having consumed the `export` first: the type-body scan (P1.6-C nested aliases) and the
	// declaration sweep, whose loop treats `export` as an ordinary token.
	function atTypeAliasDeclaration() returns bool
		if self.atVisibilityModifier() 'modified'
			return self.kindAt(self.pos + 1) == TokenKind.typealias
		end 'modified'
		return self.at(TokenKind.typealias)
	end 'atTypeAliasDeclaration'

	// ⭐ **READ ONE NESTED (INNER) TYPEALIAS (P1.6-C / P1.7 slice 3b-i / W43)** — `typealias Idx = int(0 to
	// u64.max)`, `typealias ElementArray = Array with T`, `typealias Entry = (Key, Value)` or
	// `typealias Fn = function(Integer) returns Integer` inside a type body. The cursor sits at `typealias`
	// (any `export` is consumed by the caller, which is why the visibility is passed rather than read). It
	// reuses `readTypeAliasDeclaration` — the ONE typealias grammar the sweep and the real parse share —
	// which routes each RHS into its own out-array. The three PER-INSTANCE forms record their bare member
	// into `enclosingInnerAliases` so the rest of the body's bare references resolve; the FUNCTION form does
	// not, because it is a file-scope declaration written inside a body and its name must mean the same thing
	// on both sides of the type's `end` (see `NestedAliasResult`). The caller keys the returned shape.
	//
	// ⚠ **NOTHING HERE IS GATED ON THE ENCLOSING TYPE BEING GENERIC, AND NOTHING EVER WAS** — `parseTypeMember`
	// and the sweep's body walk reach this for a plain `type Config` exactly as for a `type Container uses T`.
	// The refusal below said "inside a generic type" for a year and was read as a statement about which types
	// admit a nested alias; it was only ever a statement about which RHS FORMS are built.
	//
	// ⭐⭐ **THE TUPLE FORM WAS THE LAST OF THE FOUR AND IS NO LONGER REFUSED (W43).** Its refusal said "a
	// later slice", and what that slice turned out to be was a ROUTING job: a FILE-SCOPE tuple alias already
	// compiled and ran, so the reader, the interning and the resolution all existed — what was missing was the
	// per-type KEY (`TupleAliasOwner`), the `enclosingInnerAliases` membership, and the tuple arm in
	// `parseTypeReference`'s inner-alias lookup. It is `stdlib/Map.maxon:20`'s first line of body.
	function readNestedTypeAlias(visibility Visibility, recordFunctionSignature bool, tupleOwner TupleAliasOwner) returns NestedAliasResult throws ParseError
		// The MEMBER name, peeked before the shared reader consumes it — the grammar `atTypeAliasDeclaration`
		// already rests on (`typealias` then the name), and `recordScannedExtension` reads its target the same
		// way. The tuple form is the one shape that hands back no declaration to take a name off, and it needs
		// one for exactly the reason the other two per-instance forms do: `enclosingInnerAliases`.
		let memberNameIndex = (self.pos + 1) as TokenIndex
		var ranged = RangedTypeAliasArray.create()
		var functionAliases = FunctionTypeAliasArray.create()
		var generics = GenericAliasEntryArray.create()

		// The FORM comes from the reader that decided it, never from which array grew: that inference
		// would be a second copy of a discrimination `readTypeAliasDeclaration` already makes, free to
		// drift the day a fifth form appears.
		let form = try self.readTypeAliasDeclaration(ranged, functionOut: functionAliases, genericOut: generics, tupleOwner: tupleOwner, recordFunctionSignature: recordFunctionSignature, visibility: visibility)

		// A generic-instance nested alias (`Array with T`) — recorded by `readGenericInstanceAlias` into
		// `generics`. Its instance is PARTIALLY OPAQUE (`Array with typeParameter(token)`), keyed whole-program by
		// the caller under its base-qualified name so a same-named inner alias of another generic type stays
		// distinct, exactly as a ranged inner alias is.
		if form == TypeDeclKind.genericAlias 'genericInstance'
			let entry = try generics.get(0) otherwise panic("readNestedTypeAlias: the generic-instance form was read but generics.get(0) failed")
			self.recordInnerAliasName(entry.aliasName)
			return NestedAliasResult.genericInstance(entry)
		end 'genericInstance'

		// A TUPLE nested alias (`(Key, Value)`) — already keyed whole-program by the reader under the name
		// `tupleOwner` names, so all that is left is the membership every per-instance form records.
		if form == TypeDeclKind.tupleAlias 'tupleAlias'
			self.recordInnerAliasName(self.identifierNameAt(memberNameIndex))
			return NestedAliasResult.tupleAlias
		end 'tupleAlias'

		// A FUNCTION nested alias. It is NOT entered into `enclosingInnerAliases`, and that is unchanged by
		// W49b: membership in that set means "a MEMBER of this type", which routes a `Name{…}` literal
		// (`parseInnerAliasLiteral`) and files the per-instance parameter entries a concrete receiver
		// re-qualifies (`innerAliasMemberOfParamType`) — a function alias is neither constructible nor
		// per-instance, so both would be wrong answers. Its `<Type>.<member>` reading is served instead by the
		// registry itself, which the CALLER files it into under both names (`publishNestedFunctionAlias`).
		if form == TypeDeclKind.functionAlias 'functionAlias'
			return NestedAliasResult.functionAlias(try functionAliases.get(0) otherwise panic("readNestedTypeAlias: the function form was read but functionAliases.get(0) failed"))
		end 'functionAlias'

		// The RANGED form is the one remaining nested shape. A nominal kind cannot reach here at all,
		// `typealias` being the only keyword this reader consumes, so anything else is a form
		// `readTypeAliasDeclaration` grew and this enumeration did not.
		if form != TypeDeclKind.rangedAlias 'unroutedForm'
			panic("readNestedTypeAlias: `readTypeAliasDeclaration` read the form '{form.rawValue}', which this reader routes nowhere — every RHS form it can return needs an arm here or a nested declaration of it is silently dropped")
		end 'unroutedForm'

		let alias = try ranged.get(0) otherwise panic("readNestedTypeAlias: the ranged form was read but ranged.get(0) failed")
		self.recordInnerAliasName(alias.name)
		return NestedAliasResult.ranged(alias)
	end 'readNestedTypeAlias'

	// ⭐ **KEEP ONE `interface`-SCOPED GENERIC-INSTANCE TYPEALIAS FOR THE FOLD (W61).** It is re-keyed under
	// `<Interface>.<member>` by the SAME `qualifiedInnerGenericAlias` a `type` body's nested alias goes
	// through — one re-keying rule, and it is what keeps two interfaces declaring `ElementArray` distinct.
	// COPY-ON-WRITE off the shared empty, `recordInnerAliasName`'s discipline for its reason.
	function noteInterfaceAlias(entry GenericAliasEntry)
		if self.interfaceAliasScratch is sharedEmptyInterfaceAliases 'stillShared'
			self.interfaceAliasScratch = GenericAliasEntryArray.create()
		end 'stillShared'
		self.interfaceAliasScratch.push(self.qualifiedInnerGenericAlias(entry))
	end 'noteInterfaceAlias'

	// Record a nested alias's bare member into `enclosingInnerAliases` so the rest of the body's bare
	// references resolve. COPY-ON-WRITE off the shared empty set: only a type that actually declares a nested
	// typealias gets its own set here, so the generics-free corpus never allocates one (the reset points at
	// the shared one). Shared by both nested-alias shapes, so ranged and generic aliases enter the set the
	// same way.
	function recordInnerAliasName(name ByteArray)
		if self.enclosingInnerAliases is sharedEmptyInnerAliases 'stillShared'
			self.enclosingInnerAliases = InnerAliasNameSet.create()
		end 'stillShared'
		self.enclosingInnerAliases.insert(name)
	end 'recordInnerAliasName'

	// ⭐⭐ **A CONFORMANCE ARGUMENT MAY NAME THE TYPE'S OWN NESTED TYPEALIAS, AND THE CLAUSE IS READ BEFORE
	// THE BODY THAT DECLARES IT (W43).** `stdlib/Map.maxon` writes
	// `type Map … implements Iterable with (Entry, MapIterator)` and declares `typealias Entry = (Key, Value)`
	// on its first body line; `type MapIterator … implements Iterator with Entry` does the same. An
	// `implements` clause is part of the HEADER, so at the moment `readConformanceWithArg` renders `Entry`
	// the body has not been read — in EITHER pass — and the binding was recorded as the BARE member, which is
	// not the name a nested alias is keyed under and not the name the declared type renders to.
	// **MEASURED: `E3016 … current() returns __Tuple2.T38ee….Taebb… (expected current() returns Entry)`** —
	// the two sides of ONE type, spelled two ways.
	//
	// ⇒ The names are pre-scanned out of the body the clause belongs to and put in scope FOR THE CLAUSE ONLY.
	// Not for the body: `closeConformanceClauseAliasScope` puts the shared empty back, and the body records
	// each alias as it reaches it exactly as before, so a bare name inside a method still resolves against the
	// aliases DECLARED ABOVE IT and nothing about the body's scoping moves.
	//
	// ⚠ It is the ONE repair of this ordering, deliberately, and not one per reader. A binding is compared
	// ACROSS conformers (`associatedAbiBindingOf` refuses two conformers that bind one associated type
	// differently) and substituted at three tiers, so a resolver bolted onto any one of them would leave the
	// others reading a name the first had already decided meant something else.
	//
	// ⚠ Gated on `implements` AND on the clause actually writing a `with`, so only a declaration that binds
	// something walks — a type with no conformance clause, which is nearly every type, pays one token test,
	// and one whose clause binds nothing pays a walk of the clause LINE instead of a walk of its BODY.
	function openConformanceClauseAliasScope()
		if not self.at(TokenKind.implements) 'declaresNoConformance'
			return
		end 'declaresNoConformance'

		if not self.implementsClauseBindsAnything() 'bindsNothingToResolve'
			return
		end 'bindsNothingToResolve'

		let resume = self.pos
		var members = ByteArrayArray.create()
		self.collectNestedAliasMembersInBody(members)
		self.pos = resume

		for member in members 'eachMember'
			self.recordInnerAliasName(member)
		end 'eachMember'
	end 'openConformanceClauseAliasScope'

	// ⭐⭐ **THE PER-INSTANCE NESTED `typealias` MEMBERS DECLARED AT THE TOP LEVEL OF THE BLOCK THE CURSOR IS
	// CURRENTLY INSIDE** — a PEEK-shaped walk that reads names and resolves nothing, shared by the two passes
	// that need the scope before the declarations (`openConformanceClauseAliasScope`, which needs it for the
	// `implements` clause written ABOVE the body, and `publishExtensionInnerAliasNames`, which needs it for
	// every OTHER FILE's `extension` body over the same type). It leaves the cursor just past the block's own
	// `end`; a caller that must resume where it started saves and restores `self.pos` itself.
	//
	// The extent rule is `skipPastBlockEnd`'s, to the token, and for its reason: a NAMED `function` opens a
	// block `blockDepthAfter` does not count, the closer test is taken BEFORE the counter moves, and a closer
	// is asked through `closesBlockAt` because a member may be NAMED `end` (D8). `depth` starts at 1 because
	// both callers enter INSIDE exactly one open block.
	//
	// ⚠ **THE FUNCTION FORM IS EXCLUDED HERE AND NOT AT THE CALLERS**, because both callers want the same
	// answer and for the same reason: a nested `typealias Fn = function(…)` is a file-scope name written
	// inside a body and never enters the per-instance scope (`readNestedTypeAlias`'s own arm says why). The
	// test is the one token `readTypeAliasDeclaration` discriminates the form on, asked of the same position.
	function collectNestedAliasMembersInBody(into ByteArrayArray)
		var depth = 1 as BlockDepth
		while not self.isEof() 'walk'
			if self.functionDeclarationAt(self.pos) 'opensAMethod'
				depth = depth + 1
				self.advance()
				continue
			end 'opensAMethod'

			let member = self.nestedAliasNameAt(self.pos)
			if depth == 1 and not member.isEmpty() and not self.nestedAliasAtIsFunctionForm(self.pos) 'perInstanceNestedAlias'
				into.push(member)
			end 'perInstanceNestedAlias'

			let closes = self.closesBlockAt(self.pos)
			depth = self.blockDepthAfter(depth)
			self.advance()
			if closes and depth == 0 'closesTheDeclaration'
				return
			end 'closesTheDeclaration'
		end 'walk'
	end 'collectNestedAliasMembersInBody'

	// Does the nested `typealias` declaration starting at `index` — one `nestedAliasNameAt` has already
	// recognized — have a `function(…)` right-hand side? A PEEK, walking the same header shape that reader
	// walks (an optional visibility modifier, `typealias`, the member name) and then the `=`.
	//
	// ⚠ It reads the ONE token `readTypeAliasDeclaration` discriminates the function form on, at the position
	// that reader would read it, so the two cannot disagree about which declarations are per-instance.
	function nestedAliasAtIsFunctionForm(index TokenIndex) returns bool
		let at = self.pastVisibilityModifier(index)

		// `typealias` at `at`, the member name at `at + 1`, and the `=` at `at + 2` — a malformed declaration
		// that lacks the `=` simply is not the function form, and the real parse reports it with a position.
		if self.kindAt((at + 2) as TokenIndex) != TokenKind.equals 'noRightHandSide'
			return false
		end 'noRightHandSide'

		return self.kindAt((at + 3) as TokenIndex) == TokenKind.function
	end 'nestedAliasAtIsFunctionForm'

	// ⭐⭐ **DOES THE `implements` CLAUSE AT THE CURSOR WRITE A `with` ANYWHERE? — the one question that decides
	// whether the clause is INDEX-DEPENDENT at all.** Two readers ask it and both take the same two things off
	// a `false`: `openConformanceClauseAliasScope` skips the pre-scan of the declaration's whole BODY (nothing
	// in it can be named by a clause that names no argument), and `recordScannedType`/`recordScannedEnum` skip
	// the `ConformanceClauseDeclSite` (`readOptionalImplementsClause` consults the interface arity only inside
	// its `with` arm, so a clause without one is read identically by the sweep and by the whole-program
	// re-read, and `Queries.foldConformanceClauses` would re-derive the sweep's own answer).
	//
	// ⚠ **IT IS SOUND IN ONE DIRECTION ONLY, WHICH IS THE DIRECTION BOTH CALLERS NEED.** The walk stops at the
	// header's `newline`, and `readOptionalImplementsClause` cannot consume past one — its interface loop
	// continues only on a `comma` — so a `false` PROVES the clause holds no `with`. A `true` may come from a
	// `with` in the `where` clause that follows on the same line, which costs the pre-W95 behaviour and
	// nothing else.
	function implementsClauseBindsAnything() returns bool
		var at = self.pos
		while self.kindAt(at) != TokenKind.newline and self.kindAt(at) != TokenKind.eof 'theHeaderLine'
			if self.kindAt(at) == TokenKind.with 'bindsOne'
				return true
			end 'bindsOne'
			at = (at + 1) as TokenIndex
		end 'theHeaderLine'

		return false
	end 'implementsClauseBindsAnything'

	// Put the shared empty set back after the clause — see the door above for why the pre-scanned names are
	// deliberately NOT left in scope for the body.
	function closeConformanceClauseAliasScope()
		self.enclosingInnerAliases = sharedEmptyInnerAliases
	end 'closeConformanceClauseAliasScope'

	// The MEMBER a nested typealias declaration starting at `index` names, or the empty source text when the
	// token is not one. A PEEK — the pre-scan above must not consume — and it reads the header in the order
	// `atTypeAliasDeclaration` recognizes it: an optional visibility modifier, then `typealias <name>`.
	function nestedAliasNameAt(index TokenIndex) returns ByteArray
		var at = self.pastVisibilityModifier(index)

		if self.kindAt(at) != TokenKind.typealias 'notATypeAlias'
			return EmptySourceText
		end 'notATypeAlias'

		return self.identifierNameAt((at + 1) as TokenIndex)
	end 'nestedAliasNameAt'

	// Re-key a nested generic-instance alias entry under its BASE-QUALIFIED name (`Container.ElementArray`)
	// before the sweep folds it whole-program (P1.7 slice 3b-i). `readGenericInstanceAlias` records the BARE
	// member (`ElementArray`), but a bare member collides with a same-named inner alias of another generic
	// type, so it is qualified with the enclosing type — the SAME name `parseTypeReference`'s inner-alias arm
	// stamps the field type with (`joinQualifiedName`), so the field's stored `named("Container.ElementArray")`
	// and this `genericAliases` key are one string.
	//
	// ⚠ It is only HALF of what a `type` body's nested alias is published under — see
	// `publishNestedGenericAlias`, which files this copy plus, for a plain type, a bare file-scope one.
	//
	// ⚠ **IT RE-KEYS AND RECORDS THE SCOPING — `scopedToEnclosingType`, not a rebuild through `create`.** A
	// nested alias is a declaration a person wrote in a file, and every fact `readGenericInstanceAlias`
	// captured about it (its declaring FILE above all, but also its visibility, its `Vector` size and its
	// anchors) is as true of it under the qualified name as under the bare one. Rebuilding took `create`'s
	// defaults for all of them and filed the entry as declared by the file `""`, which
	// `deriveInstanceDisplayNames` then panicked on — see `GenericAliasEntry.scopedToEnclosingType`. The ONE
	// thing that does change beside the name is `typeScoped`, the fact this call site is the sole evidence of.
	function qualifiedInnerGenericAlias(entry GenericAliasEntry) returns GenericAliasEntry
		return entry.scopedToEnclosingType(joinQualifiedName(self.enclosingType, member: entry.aliasName))
	end 'qualifiedInnerGenericAlias'

	// ⭐⭐ **A NESTED GENERIC-INSTANCE ALIAS OF A PLAIN `type` IS PUBLISHED UNDER TWO KEYS (G17)** —
	// `publishNestedFunctionAlias`'s twin one alias FORM over, and the asymmetry between the two was the
	// defect. A nested `typealias Fn = function(…)` has been filed under BOTH its bare name and
	// `<Type>.<member>` since W49b, the bare one being *"the file-scope reading this form has always had"*;
	// a nested `typealias Bag = Array with Num` was filed under the qualified name ALONE. So a member of a
	// non-generic type had no spelling outside its own body, and neither did any signature built on it:
	// `stdlib/Directory.maxon:12`'s `FilePathArray` is what `Directory.list` RETURNS, and no other file could
	// write that type — `FilePathArray.create()` typed its result `unknown` (E2015 at the next member
	// access) and `returns FilePathArray` was E3011. The compiler routed around it rather than fixing it
	// (`Compiler.maxon`'s `MaxonSourcePathArray`), which is how the hole survived.
	//
	// ⚠⚠ **A GENERIC TYPE'S MEMBER GETS NO BARE KEY, AND THE PRICE OF PUBLISHING ONE IS MEASURED RATHER
	// THAN FEARED.** Such a member is PER-INSTANCE — `Wrapper with A`'s `Idx` and `Wrapper with B`'s are
	// distinct types (`per-instance-typealias.md`'s `wrong-instance-error`) — so there is no one type for a
	// file-scope name to denote, and the entry it would file names the enclosing type's own PARAMETER.
	// MEASURED on the ungated build: a free function writing `firstOf(b Bag)` over `type Holder uses T`'s
	// `Bag = Array with T` was not refused but MISCOMPILED, reaching the layout-descriptor refusal
	// (*"takes a reference to a borrowed type-parameter value"*) for a program whose actual defect is that
	// `Bag` names nothing outside `Holder`. `stdlib` alone would have filed FIVE disagreeing `ElementArray`
	// declarations (`Array.maxon:566`, `Builtins.maxon:56`, `Interfaces.maxon:195`, `List.maxon:13`,
	// `Set.maxon:12`) — a contest over a name no program can legally write.
	//
	// ⚠⚠ **AND A MEMBER SPELLED LIKE ITS OWN TYPE GETS NONE EITHER, WHICH IS `namesEnclosingType`'s RULE
	// READ AT THE PUBLISH DOOR RATHER THAN A SECOND ONE.** `inner-alias-construction.md`'s
	// `an-inner-alias-shadowing-its-own-type` pins that `type Holder` declaring `typealias Holder = Array with
	// …` still means the TYPE at `Holder.create()`; a bare key makes that declaration indistinguishable from
	// a file-scope alias, which WINS at the static door (`inner-alias-shadowing-another-type-wins-at-the-static
	// -door`). MEASURED: all three of that spec's shadowing cases went red, `Holder.create()` building the
	// array. The read door already refuses the name for this reason — asking the same predicate here is what
	// keeps the two from drifting.
	//
	// ⚠ **ONLY A `type` BODY REACHES THIS — an `extension` body is deliberately left publishing the
	// qualified key alone.** `foldExtensionDeclarationInto` reads a body once per CONFORMER
	// (`extensionTargetConformers`), so a bare key filed from there is ONE name for N declarations that are
	// allowed to disagree: `stdlib/Interfaces.maxon`'s `extension Iterable` would file `ElementArray` as
	// `Array with Character` for `String` and `Array with Byte` for `ByteView`, from one file, which no
	// contest can separate. That is the eleven-signature shape W49b measured for the function form, which
	// that form carries as a wart rather than as a thing to copy. Nothing needs it: an extension's member is
	// already spelled from any `extension` over the same type through the `<Type>.<member>` key
	// (`per-instance-typealias.md`'s `cross-file-extension-declares-the-generic-instance-member`).
	function publishNestedGenericAlias(entry GenericAliasEntry, into GenericAliasEntryArray)
		into.push(self.qualifiedInnerGenericAlias(entry))

		if not self.enclosingTypeParams.isEmpty() 'aGenericTypesMemberIsPerInstance'
			return
		end 'aGenericTypesMemberIsPerInstance'

		if self.namesEnclosingType(entry.aliasName) 'theTypesOwnNameStillMeansTheType'
			return
		end 'theTypesOwnNameStillMeansTheType'

		into.push(entry.asBareFileScopeName())
	end 'publishNestedGenericAlias'

	// ⭐⭐ **A NESTED FUNCTION ALIAS IS PUBLISHED UNDER TWO KEYS, AND THEY ANSWER TWO DIFFERENT QUESTIONS
	// (W49b).** The BARE name is the file-scope reading this form has always had and which the corpus pins —
	// `specs-shv2/ownership.md`'s `closure-captures-borrow` declares `FnTypeAlias1` inside `type Config` and
	// names it from a FREE function below the type, and `specs-shv2/type-name-collision.md`'s form table calls
	// the function-alias registry "bare, whole-program". The `<Type>.<member>` name is the reading INSIDE the
	// declaring body, and it is the one this rung adds.
	//
	// ⛔ **RE-KEYING INSTEAD OF ADDING WAS THE OBVIOUS CURE AND IT IS WRONG** — it deletes the file-scope
	// reading and reddens `closure-captures-borrow`. The two keys are not one fact written twice: they are
	// allowed to disagree, and on `stdlib/Interfaces.maxon` they DO. That body is read once per CONFORMER
	// with that conformer's substitution (`foldExtensionDeclarationInto`), so eleven folds write eleven
	// signatures — `function(Byte) returns Byte` for `ByteView`, `function(Character) returns Character` for
	// `String`, `function(Entry) returns Entry` for `Map`. Under one key the last fold won and `map`'s own
	// body stopped type-checking: `result.push(transform(item))` was **`E3005 … expected 'Byte', got
	// 'Character'`**, which took every `Map` literal in the suite with it (66 cases). The qualified key gives
	// each fold its own identity, which is exactly what the three PER-INSTANCE nested forms already have.
	//
	// ⚠ **PUBLISHING BOTH IS ALSO WHAT MAKES THE READ DOOR'S GATE EXACT AND FREE** — `parseTypeReference`
	// probes the qualified key only after the BARE one has hit, which is sound precisely because a nested
	// declaration always files both. See there.
	//
	// The bare key stays LAST-WINS across declarations, unchanged and deliberately so: that is the cross-file
	// "two function aliases with different signatures" case `specs-shv2/type-name-collision.md` calls out of
	// scope, and PLAN.md's `A3w` owns it. Nothing here narrows or widens it.
	//
	// ⚠ **THE NON-EMPTY PRECONDITION IS CHECKED, NOT MERELY WRITTEN DOWN** — `namespaceQualifiedName`'s guard
	// for its reason. All three callers are inside a type or extension body and cannot reach here otherwise,
	// which is exactly why a fourth that forgot would file `.Fn` — a key no source can spell, unreachable
	// behind the read door's own `isEmpty` gate, and red nowhere. Once per DECLARATION, so the test is free.
	function publishNestedFunctionAlias(alias FunctionTypeAlias, into FunctionTypeAliasArray)
		if self.enclosingType.isEmpty() 'noEnclosingTypeToQualifyWith'
			panic("publishNestedFunctionAlias: nested function typealias '{String.from(alias.name)}' was published with an EMPTY enclosing type — every caller reads a `type`/`extension` BODY, where `enterTypeScope` has set one")
		end 'noEnclosingTypeToQualifyWith'

		into.push(alias)
		into.push(alias.scopedToEnclosingType(joinQualifiedName(self.enclosingType, member: alias.name)))
	end 'publishNestedFunctionAlias'

	// ⭐ **A GENERIC-INSTANCE TYPEALIAS (P1.6-A)** — `typealias IntBox = Box with Integer`. The cursor
	// sits on the base identifier. It RECORDS the instance into `genericOut` (which `foldFile` interns
	// into the whole-program `GenericInstanceRegistry`) and THEN checks the instantiation.
	//
	// ⚠ **THE CHECK RECORDS A DIAGNOSTIC, IT DOES NOT THROW, AND THAT IS WHAT MAKES THE SWEEP TOLERANT
	// FOR FREE.** A malformed instantiation (a non-generic base, wrong arity, a managed argument) is a
	// WHOLE-PROGRAM SEMANTIC error, not a syntax error — it does not abort the file's parse, it gates the
	// build like `SemanticCheck`'s errors do. This is why the diagnostic path, not a throw, is the correct
	// tool: a throw would need the sweep to swallow it, and this needs no swallowing at all.
	//
	// ⭐ **AND IT DOES NOT RUN AT ALL DURING THE SWEEP — `signatures.allFilesFolded` IS THE GATE, read by
	// both this check and `checkGenericArgType`.** The verdict is a function of the whole-program index,
	// which is COMPLETE in the real parse and still BUILDING during the sweep, so the sweep's answer is a
	// fact about how far the sweep has got and not about the program. It was previously computed anyway
	// and discarded, on the argument that the SWEEP'S artifact is never merged (`queryProgramSignatures`
	// uses a throwaway `Parser`) — true, and it is still what makes SKIPPING it invisible: the real parse
	// re-reads every one of these declarations with the index complete, so every diagnostic a program
	// earns is still recorded exactly once, at the same position, by the same check. What the discard
	// argument got wrong is that a diagnostic nothing reads is not free: building one is a positioned
	// `Diagnostic` plus an interpolated message, MEASURED at ~6 allocations per generic type ARGUMENT and
	// again per malformed-looking INSTANCE, linear in the program's generic declarations. Spending it to
	// produce an answer that is thrown away — and would be wrong if it were not — is the whole of the cost.
	//
	// ⛔ **THIS COMMENT USED TO CLAIM A SECOND REASON — A 64-MANAGED-CASE UNION LIMIT — AND THAT CLAIM IS
	// MEASURED FALSE.** It said `ParseError` sat at exactly 64 String-carrying arms and that a 65th would
	// overflow the C# runtime's u64 droppable-case bitmask. `ParseError` passed 64 long ago (A2w measured 96
	// and added the 97th; S2f added the 98th, `uninferrableFieldDefault`), and every suite has stayed green.
	// It is struck out rather than quietly deleted because the false version COST A DESIGN: A2w's implementer
	// recorded a diagnostic instead of throwing, specifically to avoid "a 97th arm", and the recorded one was
	// swallowed by `abortedParseArtifact`. The reason above stands entirely on its own — a diagnostic nobody
	// reads is not free — and needs no help from a limit that is not there.
	//
	// ⚠ **IT RETURNS THE ENTRY RATHER THAN PUSHING IT** (spec-port `lazy-static`): the compiler-owned-name
	// rule needs the alias's MEANING — its base and its arguments — and must be able to refuse the
	// declaration after reading it, which a reader that had already filed it could not allow.
	function readGenericInstanceAlias(aliasTok Token, visibility Visibility) returns GenericAliasEntry throws ParseError
		let baseTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.with)
		// ⭐ **ARGUMENT 0's PRE-ERASURE SPELLING (A2m)**, read with the cursor still on it — `parseGenericArgNodes`
		// below reaches `parseTypeReference`, whose generic-alias arm folds `__ManagedMemory` into the very
		// `genericInstance(Array with Byte)` a `ByteArray` argument resolves to. For an `Array` base argument 0
		// is the ELEMENT, so this is the whole of what tells `Array with __ManagedMemory` from
		// `Array with ByteArray` — one instance, two spellings. See `GenericAliasEntry.elementIsBuffer`.
		// ⭐ **A SIZED BASE EATS ITS COUNT BEFORE THE ARGUMENT LIST** — `Vector with 3 Int`. The count is a
		// VALUE, not a type argument (see `VectorBuiltinBaseName`), so it is consumed here and the list below
		// reads the ONE type argument `builtinGenericTypeParamCount` validates against. Read in the SWEEP as
		// well as the real parse, because the sweep is what interns the instance and the size is half of that
		// instance's identity — a sweep that skipped it would file every `Vector with N Int` under one gid.
		let fixedSize = try self.readSizedBaseElementCount(baseTok)
		let elementIsBuffer = self.firstGenericArgSpellingDenotesBuffer()
		// ⭐ **`__ManagedMemory with T` INTERNS AS `Array with T` (W43)** — one record, one instance; see
		// `canonicalGenericBaseName`. The SPELLING is kept only as `baseIsBuffer`, which decides the member
		// surface every declared position naming this alias takes.
		let baseIsBuffer = baseTok.value.equals(ManagedMemoryTypeName)
		let baseName = self.canonicalGenericBaseNameInThisFile(baseTok.value)
		var args = GenericArgNodeArray.create()
		let argsStart = self.pos
		let argCount = try self.parseGenericArgNodes(args, inlineElement: self.baseStoresArgumentsInline(baseName), bareCommaList: true, slot: self.genericArgSlotOf(baseName))
		let selfRef = self.selfNamingArgToken(aliasTok, argsStart: argsStart)
		self.checkGenericInstance(baseTok, argCount: argCount)

		return GenericAliasEntry.create(aliasTok.value, baseName: baseName, argCount: argCount, args: args, elementIsBuffer: elementIsBuffer, baseIsBuffer: baseIsBuffer, nameLine: aliasTok.line, nameColumn: aliasTok.column, filePath: self.filePath, visibility: visibility, fixedSize: fixedSize, selfRefLine: selfRef.line, selfRefColumn: selfRef.column)
	end 'readGenericInstanceAlias'

	// ⭐ **THE TOKEN AT WHICH THIS DECLARATION NAMES ITSELF** — the second `A` of `typealias A = Array with A`.
	// It is the word the author has to change, and it is the anchor `specs/type-checking.md` blames a
	// SELF-cycle at (column 26 of that line), against the alias NAME for a cycle that runs through other
	// aliases. See `GenericAliasEntry.selfRefLine` for why the position must be captured here.
	//
	// It SCANS the argument tokens rather than threading the alias name down through `parseGenericArgNodes`,
	// so a NESTED occurrence (`typealias A = Box with (Box with A)`) is found by the same three lines that
	// find a top-level one. The span is one declaration's argument list — a handful of tokens, compared
	// without allocating.
	//
	// **Falls back to the alias's own name token**, which is every declaration that is not a self-reference:
	// the entry stores an ANCHOR and never an absence, so no reader downstream has to decode one.
	function selfNamingArgToken(aliasTok Token, argsStart TokenIndex) returns Token
		for i in argsStart upto self.pos 'eachArgumentToken'
			let tok = self.tokenAt(i)
			if tok.kind == TokenKind.identifier and tok.value.equals(aliasTok.value) 'namesItself'
				return tok
			end 'namesItself'
		end 'eachArgumentToken'

		return aliasTok
	end 'selfNamingArgToken'

	// ⭐⭐ **THE ELEMENT COUNT OF A SIZED CONTAINER SPELLING, cursor just past `with`** — `NoFixedSize` for
	// every base that is not sized, which is every base but `Vector`, and for those the cursor does not move.
	//
	// ⚠ **A MISSING OR UNUSABLE COUNT IS RECORDED, NOT THROWN** — `checkGenericInstance`'s discipline, for its
	// reason: this is a whole-program semantic verdict about a declaration, not a token the grammar cannot
	// consume, so it must not abort the file's parse. `Vector with Int` goes on to parse `Int` as the element
	// and interns an instance nothing can reach, because a recorded diagnostic gates the build.
	//
	// ⚠ **AND IT IS SILENT DURING THE SWEEP, exactly as `checkGenericInstance` is.** The sweep re-reads none
	// of its diagnostics (`queryProgramSignatures` throws its artifact away) and the real parse re-reads every
	// one of these declarations, so recording here would build a positioned `Diagnostic` plus an interpolated
	// message per sized alias for an answer nothing reads.
	// ⭐⭐ **DOES BASE `name` STORE ITS TYPE ARGUMENT AS AN INLINE BUFFER SLOT, rather than in a
	// dictionary-passed type-parameter slot — the ONE home of `checkGenericArgType`'s rule-1 exemption.**
	//
	// ⚠ **IT IS ONE HOME BECAUSE THE ANSWER IS NEEDED AT BOTH `Base with …` DOORS — the top-level alias and
	// the NESTED argument — and a widening applied to only one is a SILENT DIVERGENCE IN A REFUSAL** (review
	// finding 3): with the derivation spelled at each site, `Vector with 2 Real` would stop earning E2062
	// while `Box with (Vector with 2 Real)` went on earning it, or the reverse, with nothing to say which is
	// the rule. `checkGenericArgType`'s header promises the exemption widens in one line; this is that line.
	//
	// ⚠ **IT IS A ROSTER OF THE BASES WHOSE FLOAT SLOT IS MEASURED, NOT `isBuiltinGenericBaseName` (A4d).**
	// `Set` and `Map` hash their key and `List` boxes its payload, and each already REFUSES a float in its
	// own terms at its own door (E2015, naming the container and the slot). Admitting them here would delete
	// a DECLARATION-site diagnostic in exchange for a later one at the first method call — and for a
	// declared-but-unused alias, for none at all.
	function baseStoresArgumentsInline(name ByteArray) returns bool
		return self.signatures.isVectorBaseName(name) or self.signatures.isArrayBaseName(name)
	end 'baseStoresArgumentsInline'

	// ⭐⭐⭐ **THE WHOLE OF `__ManagedMemory`'s FOLD, AND ITS TARGET IS *DISCOVERED* (ARR5b).** A written
	// `__ManagedMemory with T` and the array record's `<Name> with T` are ONE `GenericInstanceId` (W43, see
	// `ManagedMemoryTypeName`); this decides which `<Name>`, and it reads the answer off the
	// `BuiltinArrayLiteral` conformance rather than from a constant. Three arms, and each one is a different
	// question:
	//
	//   • **NOT the buffer spelling** — nothing to fold. Every other base name arrived as a TOKEN and has
	//     already been through the stdlib rename, so it is returned untouched.
	//   • **INSIDE A CONFORMER'S OWN BODY, the conformer.** `type Bag uses Element implements
	//     BuiltinArrayLiteral` whose sole field is a `__ManagedMemory with Element` IS that record, so its
	//     field's instance must be `Bag`'s own and not the corpus declaration's — otherwise the identity
	//     `Parser.emitFusedWrapperLiteral` performs hands back a value of a type `Self` is not, which is why
	//     `ProgramSignatures.declarationIsTheManagedRecord` had to keep a NAME clause until this arm existed.
	//     `enclosingType` is the DECLARING TOKEN, so inside `stdlib/Array.maxon` under a contest it is already
	//     `__Array` and this arm needs no rename of its own.
	//   • **OTHERWISE, the corpus's declaration, as THIS FILE spells it (F31).** A user file spells it bare;
	//     a stdlib file spells it under the contest's mint.
	//
	// ⛔ **THE THIRD ARM MAY NOT BE THE ENCLOSING CONFORMER WIDENED TO THE FILE, AND THE MEASUREMENT IS
	// F31's.** Under a user `type Array` the corpus declaration is `__Array`, so `stdlib/String.maxon`'s
	// `typealias ByteBuffer = __ManagedMemory with Byte` folded to a bare `Array with Byte` — the USER's
	// container — while the same file's `ByteArray = Array with Byte` had been rewritten to
	// `__Array with Byte`. MEASURED: **`E3005 stdlib/String.maxon:160:20: argument type mismatch for
	// 'managed': expected '__ManagedMemory with Byte', got 'ByteBuffer'`**, i.e. one record with two ids,
	// which is exactly what the fold exists to prevent. A `__ManagedMemory` outside every conformer is the
	// record the stdlib's own signatures are written against, and that is the corpus's declaration whatever
	// else the program declares.
	function canonicalGenericBaseNameInThisFile(baseName ByteArray) returns ByteArray
		if not baseName.equals(ManagedMemoryTypeName) 'notTheBufferSpelling'
			return baseName
		end 'notTheBufferSpelling'

		if self.signatures.isArrayBaseName(self.enclosingType) 'theConformersOwnBody'
			return self.enclosingType
		end 'theConformersOwnBody'

		return self.signatures.arrayRecordBaseNameIn(self.isStdlibSource)
	end 'canonicalGenericBaseNameInThisFile'

	function readSizedBaseElementCount(baseTok Token) returns FixedElementCount throws ParseError
		if not self.signatures.isVectorBaseName(baseTok.value) 'unsizedBase'
			return NoFixedSize
		end 'unsizedBase'

		if not self.at(TokenKind.intLiteral) 'noCount'
			self.recordSizedBaseCountRefusal(self.current(), fault: "it states no element count")
			return NoFixedSize
		end 'noCount'

		let countTok = try self.consume(TokenKind.intLiteral)
		let count = try self.intLiteralValue(countTok, negated: false)
		if count < MinFixedElementCount or count > MaxFixedElementCount 'outOfRange'
			self.recordSizedBaseCountRefusal(countTok, fault: "its element count is {count}")
			return NoFixedSize
		end 'outOfRange'

		return count as FixedElementCount
	end 'readSizedBaseElementCount'

	// The ONE wording of E2069, shared by the two faults that reach it (no count, and a count outside the
	// usable range) so a reader meets one sentence about one rule however the declaration went wrong.
	//
	// ⚠ It takes only the token to BLAME. The base it names is `VectorBuiltinBaseName` and cannot be anything
	// else — `readSizedBaseElementCount` returns before this is reachable for every other base — so passing
	// the base token in and then interpolating both it and the constant was one name written twice, free to
	// disagree with itself in a single sentence.
	function recordSizedBaseCountRefusal(spelledAt Token, fault String)
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		self.recordArtifactDiagnostic(ErrorCode.vectorSizeMalformed, message: "`{String.from(VectorBuiltinBaseName)} with …` needs a positive element count before its element type (`{String.from(VectorBuiltinBaseName)} with 3 Int`), and {fault}. The count is part of the TYPE — a `{String.from(VectorBuiltinBaseName)} with 3 Int` is a different type from a `{String.from(VectorBuiltinBaseName)} with 4 Int` — so there is no size a sizeless spelling could mean and none is assumed. Counts run from {MinFixedElementCount} to {MaxFixedElementCount}", range: SourceRange.ofToken(spelledAt))
	end 'recordSizedBaseCountRefusal'

	// Was the FIRST type argument of the `Base with …` at the cursor spelled `__ManagedMemory` (A2m)? The
	// cursor sits just past `with`, so the answer is the token there — or the one after it for the
	// parenthesized list form, whose `(` is not an argument. Asked HERE rather than inside
	// `parseGenericArgNode`, because that routine also reads NESTED instances' arguments, where "argument 0 of
	// the alias being declared" is not a question it can answer.
	function firstGenericArgSpellingDenotesBuffer() returns bool
		if self.at(TokenKind.leftParen) 'parenthesizedArgList'
			return self.typeSpellingAtDenotesBuffer((self.pos + 1) as TokenIndex)
		end 'parenthesizedArgList'

		return self.typeSpellingAtDenotesBuffer(self.pos)
	end 'firstGenericArgSpellingDenotesBuffer'

	// Record a whole-program semantic DIAGNOSTIC the pure parser detected, WITHOUT unwinding the parse
	// (P1.6-A) — the parser twin of `reportPositioned`, writing into the artifact (which `mergeArtifact`
	// folds into `project.diagnostics`) rather than into `project`, so the pure-parser invariant holds.
	//
	// It takes the SPAN and not the token, because a reporter may hold one without holding the other: a
	// parameter's name token is consumed inside `parseFunctionParameters` and only its `SourceRange`
	// survives into `bindParameters`, where E3012's candidate is recorded. A `Diagnostic` wants a line and
	// a column in any case, which is exactly what a range carries.
	function recordArtifactDiagnostic(code ErrorCode, message String, range SourceRange)
		self.artifact.diagnostics.push(Diagnostic.create(code, message: message, line: range.line, column: range.column, filePath: self.artifact.filePath))
	end 'recordArtifactDiagnostic'

	// The DECLARATION-HYGIENE twin of the above (E3012, E3077) — same record, a different list, and the
	// difference is WHEN it is reported rather than what it says. See `Project.bindingHygieneDiagnostics`
	// for the cascade that makes the second list necessary.
	function recordBindingHygieneDiagnostic(code ErrorCode, message String, range SourceRange)
		self.artifact.bindingHygieneDiagnostics.push(Diagnostic.create(code, message: message, line: range.line, column: range.column, filePath: self.artifact.filePath))
	end 'recordBindingHygieneDiagnostic'

	// The argument list of a `Base with Args` (P1.6-A) — a single arg (`Box with Integer`) or a
	// parenthesized comma list (`Pair with (Integer, Bool)`). Each arg is an ordinary type reference,
	// so `Box with Integer` binds `[Integer]` and `Pair with (A, B)` binds `[A, B]`.
	// Parse a `Base with Args` argument LIST — `Box with Integer` (a single arg) or `Pair with (A, B)` (a
	// parenthesized comma list) — appending its pre-order nodes to `nodes` and returning the number of
	// TOP-LEVEL arguments (the arity `checkGenericInstance` validates).
	//
	// ⭐ **`inlineElement` SAYS THE ARGUMENT NAMES AN ELEMENT STORED INLINE IN A BUFFER, WHICH IS THE ONE
	// THING THAT DECIDES WHETHER A FLOAT MAY BE IT** — see `checkGenericArgType`'s rule 1. It is a fact about
	// the BASE, so it is passed down from the base that was read rather than re-derived per argument, and a
	// NESTED instance recomputes it from its own base (a `Vector with 2 (Box with Real)` puts `Real` in a
	// declared generic's slot, not in a buffer).
	function parseGenericArgNodes(nodes GenericArgNodeArray, inlineElement bool, bareCommaList bool, slot GenericArgSlot) returns FieldIndex throws ParseError
		if not self.at(TokenKind.leftParen) 'unparenthesized'
			try self.parseGenericArgNode(nodes, inlineElement: inlineElement, slot: slot, position: 0)

			// ⭐⭐ **`Map with String, UnaryOp` IS THE SAME LIST `Map with (String, UnaryOp)` SPELLS, AND
			// `/specs/map.md:function-valued.dispatch` WRITES IT WITHOUT THE PARENS.** The parenthesized form
			// already parsed; the bare one stopped after argument 0 and left the `,` for the DECLARATION reader,
			// which reported it as `E2001 Expected function declaration, got ','` — a complaint about the next
			// top-level declaration, on a line that declares a two-argument instance. Two spellings of one type
			// must reach one arity, so the comma continues the list here.
			//
			// ⚠ **AND ONLY WHERE THE LIST IS THE DECLARATION'S OWN — `bareCommaList`, which the NESTED caller
			// passes false.** Inside a parenthesized list a comma belongs to the ENCLOSING list, so a greedy
			// nested reading would turn `Box with (Map with String, Int)` from a two-argument `Box` into a
			// one-argument `Box` over a two-argument `Map` — the same tokens, two meanings, decided by whichever
			// reader ran first. The outermost list of a `typealias` is terminated by the end of the declaration
			// and has no such second claimant, which is exactly why the form is unambiguous there and nowhere else.
			if not bareCommaList 'oneArgumentOnly'
				return 1
			end 'oneArgumentOnly'

			var bareCount = 1 as FieldIndex
			while self.at(TokenKind.comma) 'moreBareArgs'
				try self.consume(TokenKind.comma)
				try self.parseGenericArgNode(nodes, inlineElement: inlineElement, slot: slot, position: bareCount)
				bareCount = bareCount + 1
			end 'moreBareArgs'
			return bareCount
		end 'unparenthesized'
		try self.consume(TokenKind.leftParen)
		var count = 0 as FieldIndex
		while true 'argLoop'
			try self.parseGenericArgNode(nodes, inlineElement: inlineElement, slot: slot, position: count)
			count = count + 1
			if not self.at(TokenKind.comma) 'doneArgs'
				break
			end 'doneArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'
		try self.consume(TokenKind.rightParen)
		return count
	end 'parseGenericArgNodes'

	// ⭐⭐ **WHICH STORAGE POSITION A `Base with Args` ARGUMENT OCCUPIES — decided from the BASE, once, and
	// passed down.** A `type` base's arguments are its container's element slots; an `interface` base's are the
	// associated-type BINDINGS of an existential (`ProgramSignatures.instanceDenotedType`). Only the base can
	// tell them apart, and `parseGenericArgNode` sees an argument, so the answer travels with the walk exactly
	// as `inlineElement` does — and for the same reason: it is a fact about the base, and re-deriving it per
	// argument would be the same lookup done N times.
	//
	// ⚠ **IT CARRIES THE INTERFACE NAME AND NOT MERELY THE FACT, because the binding arm's refusal is about
	// the ASSOCIATED TYPE at that position** — which requirement writes it, and where. A bare
	// `DeclaredStoragePosition` said only "this is a binding", so the one thing the check needs to look the
	// associated type up had to be re-derived at the argument or not asked at all; it was not asked, and every
	// interface-typed binding was refused alike.
	//
	// ⚠ **THE `allFilesFolded` GATE IS THE ONE `parseTypeReference`'s interface arm carries**, and it costs
	// this door nothing: during the declaration SWEEP the interface registry is EMPTY, so the sweep answers
	// `containerElement` — and it cannot refuse on that answer either, because an interface-typed argument
	// resolves to a bare `named` in the sweep and never reaches the existential test at all.
	function genericArgSlotOf(baseName ByteArray) returns GenericArgSlot
		if self.signatures.allFilesFolded and isInterfaceName(self.signatures.interfaceMap(), name: baseName) 'anInterfaceInstance'
			return GenericArgSlot.associatedTypeBinding(baseName)
		end 'anInterfaceInstance'

		return GenericArgSlot.containerElement
	end 'genericArgSlotOf'

	// ⭐ **ONE generic-instance argument (P1.6-A/B2)** — a LEAF type reference (`Integer`, `Point`,
	// `String`), or a NESTED instance `Inner with (…)` now that managed instances are owned and dropped. A
	// nested instance's gid is not known at parse time (interning lives in `recordGenericAlias`), so it is
	// FLATTENED pre-order: an `instanceHeader(base, k)` node followed by its `k` args' nodes. It is VALIDATED
	// here, at its own `with`, so a malformed nested base (`Box with (Plain with Integer)`, wrong arity) is
	// diagnosed with the tolerant sweep's index-complete answer, exactly as the outer instance is
	// (`checkGenericInstance` records, never throws). The header is pushed BEFORE its sub-args (parsed into a
	// temp so the header's count is known), preserving pre-order.
	function parseGenericArgNode(nodes GenericArgNodeArray, inlineElement bool, slot GenericArgSlot, position FieldIndex) throws ParseError
		if self.at(TokenKind.identifier) and self.kindAt(self.pos + 1) == TokenKind.with 'nested'
			let baseTok = try self.consume(TokenKind.identifier)
			try self.consume(TokenKind.with)
			// ⭐ **A NESTED INSTANCE READS ITS SIZE THROUGH THE SAME DOOR THE TOP-LEVEL ONE DOES (review
			// finding 5).** Without it `typealias X = Box with (Vector with 3 Int)` died as
			// `E2010 Expected 'a type' but got 'integer literal'` — the raw token complaint the top-level
			// spelling stopped giving the moment `Vector` existed — instead of reaching E2069 or the element
			// gate. This arm had already been taught the OTHER `Vector`-specific fact (`inlineElement` below),
			// so the asymmetry was an omission and not a decision.
			let subSize = try self.readSizedBaseElementCount(baseTok)
			// The canonical base, for the top-level arm's reason (W43): a nested `__ManagedMemory with T` must
			// intern to the same instance a nested `Array with T` does, or one record has two ids.
			let subBaseName = self.canonicalGenericBaseNameInThisFile(baseTok.value)
			var subNodes = GenericArgNodeArray.create()
			let subCount = try self.parseGenericArgNodes(subNodes, inlineElement: self.baseStoresArgumentsInline(subBaseName), bareCommaList: false, slot: self.genericArgSlotOf(subBaseName))
			self.checkGenericInstance(baseTok, argCount: subCount)
			nodes.push(GenericArgNode.instanceHeader(subBaseName, argCount: subCount, fixedSize: subSize))
			nodes.append(subNodes)
			return
		end 'nested'

		let argTok = self.current()
		let argType = try self.parseTypeReference()
		try self.requireCarryableGenericArg(argType, slot: slot, position: position, argTok: argTok)
		self.checkGenericArgType(argType, argTok: argTok, inlineElement: inlineElement)
		nodes.push(GenericArgNode.leaf(argType))
	end 'parseGenericArgNode'

	// ⭐ **WHAT A TYPE ARGUMENT MAY BE — THREE RULES, AND THE ORDER IS LOAD-BEARING, NOT TIDINESS.**
	//
	// **1. It may not resolve to `float` (E2062) UNLESS IT NAMES AN INLINE BUFFER ELEMENT** — bare or through
	// a ranged float alias. A COMPILER limitation, not a language rule: dictionary-passing gives a type
	// parameter a general-purpose slot, which a float cannot travel in. ONE rule with ONE message, decided at
	// TWO points, and each placement is forced. The BARE keyword goes before rule 2, because a bare `float`
	// satisfies rule 2 as well and rule 2's workaround is a trap for it. The ALIAS goes after rule 3 — a name
	// must denote something before it can denote a float, and rule 3's answer already carries the domain, so
	// asking there is free where asking separately is a heap box per argument.
	//
	// ⭐⭐ **THE `inlineElement` EXEMPTION, AND WHAT IT IS AND IS NOT.** The rule's own stated reason is about a
	// TYPE PARAMETER's opaque slot; a `Vector with 2 Real`'s element is not one — it is a stride in a buffer,
	// written and read as its 64 BITS (`containerElementWord` / `containerSlotValueType`), which is machinery
	// this port had to build for `/specs/vector.md`'s float cases and which works. So the exemption is exactly
	// as wide as the reason is narrow.
	//
	// ⚠⚠ **`Array` IS IN IT TOO (A4d), BECAUSE THE COMPILER ALREADY MINTS AND RUNS THE VERY INSTANCE THE
	// REFUSAL NAMED.** `[1.5, 2.5]` types as `Array with float` — the literal's instance is minted rather
	// than read off a `Base with Args`, so it never reached this check — and that instance stores, loads,
	// clones and iterates end to end. Refusing the same type when a program NAMES it was therefore not a
	// limitation but a POLICY, and an expensive one: `Array with float` cannot be written in a parameter, a
	// return or a field position at all (`Expected ')' but got 'with'`), so before the element was nameable
	// a float array could not leave the expression that built it. E2062's stated reason — an opaque 8-byte
	// general-purpose slot — is simply not true of a buffer stride. `Box with float`, where it IS true,
	// still earns the refusal, and `error.float-type-arg` still pins that.
	//
	// **2. It may not be a BARE NUMERIC KEYWORD (E2061).** A bare `int` is minted CONCRETE by
	// `parseTypeReference`, so it too is answered before the `named` cascade it never enters.
	//
	// **3. If it NAMES something, that name must denote a type (E3011).** `checkGenericInstance` validated
	// the BASE and the ARITY and nothing else, so `typealias BadArray = Array with UnknownType` COMPILED,
	// RAN and returned an answer — a silent acceptance of a program naming a type the program does not have,
	// which is the one class of defect a suite cannot catch by being green. The runnable oracle rejects it,
	// and so does this.
	//
	// Rule 3 asks `denotedNamedType` — the ONE cascade `TypeResolution` and both `as`-cast sites ask — so an
	// argument and a cast target can never come to disagree about what a name means. Only a `named` type can
	// be in question THERE: `parseTypeReference` has already answered every spelling it settles syntactically
	// (`Self`, the enclosing type's own name, `String`, a type PARAMETER, a bare inner alias, a
	// generic-instance alias, a function alias, the primitive keywords) with a concrete arm, and a
	// `typeParameter`/`genericInstance`/`structRef` argument is exactly the legal case that must not be
	// refused. Which is precisely why rules 1 and 2 cannot be expressed as extra arms of that cascade — the
	// tags they reject are ones the cascade is never reached for.
	//
	// ⚠ **RECORDED, NOT THROWN, AND NOT COMPUTED AT ALL UNTIL THE INDEX IS WHOLE-PROGRAM** — the same two
	// rules `checkGenericInstance` states beside it, for the same reason and off the same gate
	// (`signatures.allFilesFolded`); its header carries the argument. This check is the sharper case of it:
	// a generic-instance or function alias declared later in the program — or anywhere in this file, whose
	// own declarations fold only after its whole token walk — legitimately reads "undeclared" during the
	// sweep, so the sweep's verdict is not merely discarded, it is systematically wrong.
	//
	// ⚠ **A `b"…"` BYTE-STRING NEEDS NO EXEMPTION, and that is a property of where its instance comes from.**
	// The compiler MINTS `Array with Byte` for a byte-string literal (`internArrayByteInstance`) rather than
	// reading it off a `Base with Args` in source, so a byte string never reaches this check at all. A program
	// that WRITES `Array with Byte` declares its own `typealias Byte = int(0 to u8.max)` — a ranged alias the
	// cascade resolves — which is exactly what `undeclaredNamedElementSlot` means when it says no user
	// type can name the literal's own instance.
	function checkGenericArgType(argType MaxonType, argTok Token, inlineElement bool)
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		let tag = maxonTypeTag(argType)

		// ⭐ **A FLOAT TYPE ARGUMENT IS REFUSED, HOWEVER IT IS SPELLED (E2062).** shv2 DICTIONARY-PASSES
		// rather than monomorphizing, so a type parameter is one opaque 8-byte GENERAL-PURPOSE slot; a float
		// is born in XMM and has no way to travel through it. Both spellings reach the same x64
		// cross-register-file assertion — MEASURED: bare `Box with float` and `Box with Real` over
		// `typealias Real = float(f64.min to f64.max)` panic identically — so refusing only the bare keyword
		// would leave the panic reachable through the very alias E2061 recommends.
		//
		// ⚠ **THE BARE ARM IS ASKED BEFORE E2061, AND THAT ORDER IS THE POINT, not a tidy-up.** A bare
		// `float` satisfies BOTH rules — `tagIsBareNumericKeyword` genuinely admits it, which is what makes
		// this a resolved OVERLAP rather than two disjoint tests in an arbitrary sequence — and E2061's
		// advice ("declare a ranged typealias") is TRUE for `int` and a TRAP for `float`. Asking float first
		// is what stops this compiler from routing a reader into a crash with its own diagnostic, and
		// `error.float-type-arg` is the spec case that turns RED the moment the two arms are swapped. The
		// ALIAS spelling is decided further down instead, off the name cascade's own answer — see there for
		// why that is the cheap place and not merely the late one.
		//
		// ⭐ **ON A BUFFER BASE THE OVERLAP RESOLVES THE OTHER WAY, AND IT DOES SO BY ITSELF (A4d).** The
		// exemption drops this arm, E2061 takes the bare keyword back, and its advice is no longer a trap
		// there but a working program: `Array with float` is E2061, and the `typealias Real = float(…)` it
		// recommends now compiles. Two rules, one keyword, and which one answers is decided by whether the
		// workaround exists — pinned in both directions by `error.bare-float-type-arg-on-a-buffer-base` and
		// `error.float-type-arg`.
		//
		// ⚠ **A DELIBERATE DIVERGENCE FROM BOTH REFERENCES**, which accept a float type argument because
		// they MONOMORPHIZE — the instantiation gets a genuine f64 slot and the question never arises. This
		// is a COMPILER limitation, not a language rule, so the message names no workaround: at this
		// milestone there is none. It retires when a float register class for descriptor-typed values lands,
		// and until then the diagnostic is what makes that a decision someone takes rather than a panic
		// someone trips over.
		if tagIsFloat(tag) and not inlineElement 'bareFloatArg'
			self.recordArtifactDiagnostic(ErrorCode.genericFloatTypeArg, message: floatTypeArgMessage(typeTagName(tag)), range: SourceRange.ofToken(argTok))
			return
		end 'bareFloatArg'

		// ⭐ **A BARE `int` IS NOT A TYPE ARGUMENT (E2061)** — the ranged-typealias rule reaching the one
		// type position that never enforced it. Everywhere else a numeric domain must be DECLARED
		// (`typealias Integer = int(i64.min to i64.max)`); a `with` clause let the keyword straight through,
		// and it was silently ACCEPTED. `bool` is DELIBERATELY ADMITTED — it is already a constrained type,
		// with no range to name — as are `String`, a user type, a type PARAMETER, a nested instance, and the
		// ranged INT alias this message names, which is verified to work.
		//
		// It is a TAG test, and it has to be: a bare keyword is minted CONCRETE by `parseTypeReference`
		// (`MaxonType.integer`, never `named`), so it never reached the name cascade below — which is
		// exactly what hid it.
		//
		// ⚠ **IT ASKS FOR THE WHOLE SET — `int` AND `float` — AND RELIES ON THE ARM ABOVE HAVING TAKEN THE
		// FLOAT.** Narrowing this guard to `tagIsInteger` would state the rule as "the bare numeric keywords,
		// minus whatever an earlier arm happened to claim", which reads identically whether the author knew
		// about the overlap or never heard of it — and it would make the ordering above unfalsifiable, since
		// two disjoint equality tests can be swapped with no effect at all. Stated whole, a swap is a
		// behaviour change the suite catches.
		if tagIsBareNumericKeyword(tag) 'barePrimitive'
			// ⚠ **REPORTED AT THE OFFENDING ARGUMENT, NOT AT THE ALIAS NAME — a deliberate divergence from the
			// oracle**, which passes its `aliasNameToken` (`RejectBarePrimitiveTypeArgs`, all three call
			// sites) and so points at the name LEFT of the `=`, away from the token that has to change. Two
			// reasons the argument wins: the E3011 arm below already reports at `argTok`, so one function
			// would otherwise answer one question from two columns; and no corpus case asserts the column.
			let spelling = typeTagName(tag)
			self.recordArtifactDiagnostic(ErrorCode.genericBarePrimitiveArg, message: "Cannot use bare type '{spelling}' as a type argument; use a ranged typealias instead (e.g. typealias MyType = {spelling}(...))", range: SourceRange.ofToken(argTok))
			return
		end 'barePrimitive'

		if tag != ValueTypeTag.named 'alreadyConcrete'
			return
		end 'alreadyConcrete'

		let nameId = typeNameIdOf(argType)
		let name = self.internedName(nameId)
		let denoted = try denotedNamedType(self.signatures, name: name, id: nameId) otherwise 'undeclared'
			self.recordArtifactDiagnostic(ErrorCode.unknownType, message: unknownTypeMessage(String.from(name)), range: SourceRange.ofToken(argTok))
			return
		end 'undeclared'

		// ⭐ **THE FLOAT RULE'S SECOND SPELLING (E2062), READ OFF THE CASCADE'S OWN ANSWER** — a ranged FLOAT
		// alias, whose `named` tag says nothing about the domain behind it. It is asked HERE, after E3011
		// rather than beside the bare arm above, for two reasons and both are load-bearing:
		//
		// **1. A name must denote something before it can denote a float.** The domain of a name the program
		// does not declare is a question with no answer, and E3011 is the honest verdict.
		//
		// **2. HERE IT COSTS NOTHING, WHERE ASKING SEPARATELY COST ONE HEAP BOX PER ARGUMENT.**
		// `denotedNamedType` erases a plain ranged alias to its UNDERLYING primitive, so the answer is
		// already in its result — and this call was being made anyway, its value discarded into `_`. The
		// obvious alternative, `resolveFloatAliasType`, reaches the registry through `aliasOf`, which hands
		// back a payload union Maxon HEAP-BOXES per call; `denotedNamedType` deliberately goes through
		// `aliasUnderlyingInAnyFile` instead, whose header states that exact reason ("hands back the
		// primitive rather than a `DeclaredAlias` that would be heap-boxed per call"). MEASURED on the scale
		// ladder: the separate lookup cost **+16 / +30 / +58 allocations of 16 bytes** over three rungs — one
		// box per named type argument, linear in the program — and reading it off the cascade is delta-ZERO.
		//
		// A declared `enum`/`union` erases to `integer` here (a float-BACKED enum too — its bits ARE an i64)
		// and a struct stays `structRef`, so `float` reaches this test only from a genuine float alias.
		if tagIsFloat(maxonTypeTag(denoted)) and not inlineElement 'floatAliasArg'
			// Named by the ALIAS the source wrote, not by `float`: a reader told "cannot use 'float'" about a
			// line that says `Real` would have to work out which of its aliases is meant.
			self.recordArtifactDiagnostic(ErrorCode.genericFloatTypeArg, message: floatTypeArgMessage(String.from(name)), range: SourceRange.ofToken(argTok))
			return
		end 'floatAliasArg'
	end 'checkGenericArgType'

	// The ONE wording of "a float type argument is not supported yet", shared by the two spellings that
	// reach it — the bare `float` keyword and a ranged float alias. They are decided at different points of
	// `checkGenericArgType` (one syntactically, one off the name cascade) and must not be free to drift into
	// two texts for one rule; `spelling` is the only thing that legitimately differs between them.
	function floatTypeArgMessage(spelling String) returns String
		return "Cannot use '{spelling}' as a type argument: a float type argument is not supported yet. A type parameter is an opaque 8-byte general-purpose slot under shv2's dictionary-passing, and a float value travels in a floating-point register, so it has no way through"
	end 'floatTypeArgMessage'

	// ⭐ **CHECK A `Base with Args` INSTANTIATION (P1.6-A/B2)** — reads the whole-program index (complete in
	// the real parse). Two rejections, in the order the reader most wants to hear them, each RECORDED as a
	// diagnostic (not thrown — see `readGenericInstanceAlias`):
	//   1. `Base` is not a generic type — E2055 "has no associated types";
	//   2. wrong arity — `Pair with Integer` for a two-parameter `Pair` (E2056).
	// The P1.6-A managed-argument rejection (E2057) is GONE: B2 owns and drops managed type arguments, so a
	// String / managed-struct / nested-instance argument is now legal. A nested instance validates itself at
	// its own `with` (`parseGenericArgNode`), so this checks ONE level.
	function checkGenericInstance(baseTok Token, argCount FieldIndex)
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		// ⭐ **A SYNTHESIZED BUILTIN GENERIC HAS NO DECLARATION TO READ AN ARITY OFF** — `Array with Element`,
		// `Set with Element` and `Map with (Key, Value)` are all built by the compiler, so `structOf` finds
		// nothing for any of them and the arity is validated against the index's own table instead. Their
		// KEY/ELEMENT-type restrictions are not checked here: those need the RESOLVED argument type and are
		// enforced where the container is materialized — `requireListElementType` for a chain's element, and a
		// declared container's own `where` clause for a hash table's key (`checkWhereConstraints`).
		//
		// ⚠ One arm for all three, reading `builtinGenericTypeParamCount` — this used to be a per-builtin arm
		// that spelled the predicate and the count together, and a third builtin generic is exactly the edit
		// that would have left one of the two behind.
		// ⭐ **ASKED ABOUT THE CANONICAL BASE AND BLAMED ON THE WRITTEN ONE (W43)** — `__ManagedMemory with T`
		// is an `Array` instance (`canonicalGenericBaseName`), so it must be checked against `Array`'s arity;
		// the sentence still quotes the spelling the author actually wrote, because that is the word to change.
		let baseName = self.canonicalGenericBaseNameInThisFile(baseTok.value)
		if self.signatures.isBuiltinGenericBaseName(baseName) 'builtinGeneric'
			let expected = self.signatures.builtinGenericTypeParamCount(baseName)
			if argCount != expected 'wrongArity'
				self.recordArtifactDiagnostic(ErrorCode.genericArityMismatch, message: "generic type '{String.from(baseTok.value)}' expects {expected} type argument(s), but {argCount} were supplied", range: SourceRange.ofToken(baseTok))
			end 'wrongArity'
			return
		end 'builtinGeneric'

		// ⭐⭐ **AN INTERFACE'S `uses` NAMES ARE ASSOCIATED TYPES, SO `Iterator with Element` IS A BASE THIS
		// CHECK MUST ANSWER FOR — AND IT ASKED ONLY `structOf`, WHICH AN INTERFACE IS NEVER IN.** The verdict
		// that followed was `recordBaseNotGeneric`'s "has no associated types", about the one kind of
		// declaration whose type parameters ARE called associated types — the message contradicting itself at
		// the exact name it was printed for.
		//
		// MEASURED on `stdlib/Array.maxon`, which cannot be listed without it: `typealias ElementIterator =
		// Iterator with Element` and `typealias ElementIterable = Iterable with (Element, ElementIterator)`
		// were **E2055** at `:121` and `:122`.
		//
		// It goes through `lookupInterface` rather than the raw map for `parseTypeReference`'s stated reason —
		// that is the ONE lookup rule, and it is what puts the SYNTHESIZED protocols on the same footing as
		// the user-declared ones. The arity is the interface's OWN `uses` list; an inherited `extends` parent
		// contributes none, because a parent's associated types are bound by the child's own declaration.
		match lookupInterface(self.signatures.interfaceMap(), name: baseName) 'interfaceBase'
			found(iface) then self.checkInterfaceGenericArity(iface, baseTok: baseTok, argCount: argCount)
			notFound then self.checkStructGenericInstance(baseName, baseTok: baseTok, argCount: argCount)
		end 'interfaceBase'
	end 'checkGenericInstance'

	// ⭐ **THE NON-INTERFACE BASE'S CHECK, WHICH USED TO BE THE TAIL `checkGenericInstance` FELL OUT INTO.**
	//
	// ⛔ **RETURNING A VOID CALL IS NOT VALID (user ruling, 2026-08-23)**, and the `found` arm above was doing
	// it — `checkInterfaceGenericArity` declares no return type. The arm was written that way because a
	// `match` arm is exactly ONE statement, so it could not both check the arity AND leave the function ahead
	// of this tail. Making the classification TERMINAL is the cure: every arm calls, none falls out, and the
	// tail takes a name. Second instance of the shape `LowerMaxonToStd`'s residues took, one file over.
	function checkStructGenericInstance(baseName ByteArray, baseTok Token, argCount FieldIndex)
		match self.signatures.structOf(baseName) 'base'
			undeclared then self.recordBaseNotGeneric(baseTok)
			declared(layout) then self.checkGenericInstanceAgainst(layout, baseTok: baseTok, argCount: argCount)
		end 'base'
	end 'checkStructGenericInstance'

	// The interface half of `checkGenericInstance` — associated-types-at-all, then arity. It mirrors
	// `checkGenericInstanceAgainst` rather than sharing it because the two read the count off different
	// declarations (a `StructLayout`'s `uses` list against an `IrInterface`'s associated-type names) and
	// there is no common handle to pass; both verdicts are the shared `recordBaseNotGeneric` /
	// `genericArityMismatch` pair, which is where the sentences actually have to agree.
	function checkInterfaceGenericArity(iface IrInterface, baseTok Token, argCount FieldIndex)
		let expected = iface.associatedTypeNames.count()
		if expected == 0 'notGeneric'
			self.recordBaseNotGeneric(baseTok)
			return
		end 'notGeneric'

		if argCount != expected 'wrongArity'
			self.recordArtifactDiagnostic(ErrorCode.genericArityMismatch, message: "generic type '{String.from(baseTok.value)}' expects {expected} type argument(s), but {argCount} were supplied", range: SourceRange.ofToken(baseTok))
		end 'wrongArity'
	end 'checkInterfaceGenericArity'

	// The "has no associated types" verdict (E2055), from its ONE home (P1.6-A). Reached by BOTH halves
	// of the base check — a `Base` that is not a declared type at all (`structOf` undeclared) and a `Base`
	// that is a declared type with an empty `uses` list (`typeParamCount() == 0`) — which are the same
	// diagnostic. Bound here rather than spelled at each site so the two callers cannot drift the message.
	function recordBaseNotGeneric(baseTok Token)
		self.recordArtifactDiagnostic(ErrorCode.genericBaseNotGeneric, message: "Type '{String.from(baseTok.value)}' has no associated types", range: SourceRange.ofToken(baseTok))
	end 'recordBaseNotGeneric'

	// The declared-base half of `checkGenericInstance` — base-is-generic, then arity. The P1.6-A per-argument
	// managed rejection is GONE (B2 owns and drops managed type arguments).
	// ⭐ **A TRAILING TYPE ARGUMENT MAY BE OMITTED, AND FOR ONE BASE ITS OMISSION IS THE SPELLING OF A FACT**
	// (P1.5-B2c). `type Promise uses Element, ErrorType` is written with two parameters and
	// `Promise with String` supplies one — that is not an under-application to be diagnosed, it is how the
	// language says *"this thunk does not throw"*. The language has no syntax for an optional type
	// parameter, so neither compiler can read the rule off the declaration: `maxon-sharp` stamps
	// `OptionalTrailingTypeParamCount` on the completed struct, and shv2 derives it from the base NAME in
	// `PromiseType.maxon`, which is the one place that has to learn a second such base if one ever appears.
	function checkGenericInstanceAgainst(layout StructLayout, baseTok Token, argCount FieldIndex)
		if layout.typeParamCount() == 0 'notGeneric'
			self.recordBaseNotGeneric(baseTok)
			return
		end 'notGeneric'

		let least = layout.typeParamCount() - promiseOptionalTrailingTypeParams(layout.name)
		if argCount < least or argCount > layout.typeParamCount() 'wrongArity'
			self.recordArtifactDiagnostic(ErrorCode.genericArityMismatch, message: "generic type '{String.from(baseTok.value)}' expects {genericArityPhrase(least, most: layout.typeParamCount())} type argument(s), but {argCount} were supplied", range: SourceRange.ofToken(baseTok))
			return
		end 'wrongArity'
	end 'checkGenericInstanceAgainst'

	// How E2056 spells the arity it wanted. A base with no optional parameters says one number, exactly as
	// it always did — every existing pin on this message is over such a base — and only a base that admits a
	// range says so.
	function genericArityPhrase(least FieldIndex, most FieldIndex) returns String
		return "{most}" if least == most else "{least} or {most}"
	end 'genericArityPhrase'

	// Parse `function(paramTypes) [returns T]` on a typealias RHS (P1.5-A1), the cursor sitting on
	// `function`. The whole declared SIGNATURE is stored INTERNER-FREE (a tag + a name per parameter and for
	// the return) so it rides the no-remap fold, plus the `#81` `fn(…) returns …` DISPLAY STRING built from
	// the same parameter list. An absent `returns` clause is a void function type.
	//
	// ⚠ **ONLY THE REAL PARSE MAY RECORD THE SIGNATURE, and that is a property of the SWEEP rather than an
	// optimization.** `parseTypeReference` answers a type spelling differently during the whole-program token
	// sweep — `isFunctionAlias`/`isGenericAlias` consult the very registries the sweep is still building, so a
	// parameter spelled with a function or generic alias reads back as a bare `named` there — and a fact
	// recorded twice from two answers is two facts. The sweep and the nested-alias reader therefore pass
	// `recordSignature: false` and store the RETURN type alone, which they read identically; every consumer
	// of a parameter type reads the real parse's copy in `project.functionTypeAliases`. The params are PARSED
	// either way: the syntax must be consumed, and a malformed one rejected, wherever it is met.
	function readFunctionTypeAlias(nameTok Token, recordSignature bool) returns FunctionTypeAlias throws ParseError
		try self.consume(TokenKind.function)
		try self.consume(TokenKind.leftParen)

		// Two lists off one parse: the `MaxonType`s the display string renders (this file's interner ids, used
		// and dropped here) and the interner-free `(tag, name)` pairs the alias stores. The empty arrays a
		// sweep still constructs grow no heap buffer — an `Array`'s backing storage is allocated lazily on the
		// first `push`, which a sweep never makes.
		var paramTypes = MaxonTypeArray.create()
		var declaredParams = FunctionAliasParamArray.create()
		if not self.at(TokenKind.rightParen) 'params'
			while true 'paramLoop'
				let paramAnchor = self.tokenAt(self.pos)
				let paramType = try self.readFunctionTypeParam()
				if recordSignature 'collectParam'
					// ⭐ REFUSED HERE, and `recordSignature` is what keeps the tolerant declaration sweep out of it: the
					// sweep passes `false` and must never veto, exactly as it must not for the six sibling positions.
					// This is the ONLY place a function type's parameter list is parsed — an inline `function(...)` in a
					// parameter position is E2010 — so one call site covers the position.
					try self.requireStorableDeclaredType(paramType, position: DeclaredStoragePosition.functionTypeParameter, line: paramAnchor.line, column: paramAnchor.column)
					paramTypes.push(paramType)
					declaredParams.push(FunctionAliasParam.create(maxonTypeTag(paramType), typeName: self.functionAliasTypeName(paramType), typeParamToken: functionAliasTypeParamToken(paramType), aggregateName: self.erasedAggregateNameOf(paramType)))
				end 'collectParam'
				if not self.at(TokenKind.comma) 'endParams'
					break
				end 'endParams'
				try self.consume(TokenKind.comma)
			end 'paramLoop'
		end 'params'

		try self.consume(TokenKind.rightParen)

		var returnTag = ValueTypeTag.void
		var returnTypeName = EmptySourceText
		var returnTypeParamToken = NoTypeParamId
		var returnAggregateName = EmptySourceText
		var returnForDisplay = MaxonReturnType.void
		if self.at(TokenKind.returns) 'hasReturn'
			let returnsTok = try self.consume(TokenKind.returns)
			let returnType = try self.parseTypeReference()
			if recordSignature 'realParse'
				// The RETURN half of this position, and since the return ABI landed it is its OWN position:
				// a declared function's return now WRITES the second register, and a call through a function
				// value cannot read it (`callIndirect` declares one result). Gated on `recordSignature`
				// exactly as the parameter half above is: the sweep may not veto.
				try self.requireStorableDeclaredType(returnType, position: DeclaredStoragePosition.functionTypeReturnType, line: returnsTok.line, column: returnsTok.column)
				// ⚠ Inside the gate with the parameter half, and NOT beside the four unconditional lines below,
				// because it is the one fact of the four the sweep cannot read identically: `erasedAggregateNameOf`
				// classifies through `self.signatures`, the registry the sweep is still filling. The sweep's copy
				// of an alias carries the return TAG and no identity, which is exactly what it can honestly say.
				returnAggregateName = self.erasedAggregateNameOf(returnType)
			end 'realParse'
			returnTag = maxonTypeTag(returnType)
			returnTypeName = self.functionAliasTypeName(returnType)
			// ⭐ UNCONDITIONAL, unlike the aggregate name above, and that is the W14 digest's whole property: the
			// token is a pure function of two SOURCE SPELLINGS (`ProgramSignatures.typeParamTokenFor`), so the
			// tolerant sweep mints the identical one without consulting the registry it is still building.
			returnTypeParamToken = functionAliasTypeParamToken(returnType)
			returnForDisplay = MaxonReturnType.value(returnType)
		end 'hasReturn'

		var display = EmptySourceText
		if recordSignature 'display'
			display = formatFnTypeDisplay(paramTypes, returnType: returnForDisplay, typeNames: self.artifact.typeNames).toByteArray()
		end 'display'
		return FunctionTypeAlias.create(nameTok.value, returnTag: returnTag, returnTypeName: returnTypeName, returnTypeParamToken: returnTypeParamToken, returnAggregateName: returnAggregateName, display: display, paramTypes: declaredParams)
	end 'readFunctionTypeAlias'

	// One parameter of a function-type signature — an optional NAME followed by its type, or a bare type,
	// returning the parameter's TYPE (the #81 display needs it; the NAME is documentation only, discarded).
	// A `name Type` param is one where an identifier is followed by another type-starting token
	// (`function(x Score)`); otherwise the token IS the type (`function(Integer)`, `function(Integer, Integer)`).
	function readFunctionTypeParam() returns MaxonType throws ParseError
		if self.at(TokenKind.identifier) and self.peekStartsType() 'namedParam'
			try self.consume(TokenKind.identifier)
		end 'namedParam'
		return try self.parseTypeReference()
	end 'readFunctionTypeParam'

	// True when the token ONE past the cursor can BEGIN a type reference — an identifier (a named type
	// or `String`), the `int`/`bool`/`float` keywords, or `Self`. Used to tell a function-type param's
	// optional NAME from its TYPE (`x Score` vs a bare `Integer`).
	function peekStartsType() returns bool
		let k = self.peekKind()
		return k == TokenKind.identifier or k == TokenKind.int or k == TokenKind.bool or k == TokenKind.float or k == TokenKind.selfType
	end 'peekStartsType'

	// The interned NAME behind one type in a function alias's declared signature — a PARAMETER's or the
	// RETURN's — stored so the type can be re-interned into any reader's own interner (see
	// FunctionTypeAlias). A primitive (`bool`/`int`/`float`/`ExitCode`/`void`) carries no name and yields the
	// empty string. ONE extractor for both halves of the signature: they are stored the same way, so a second
	// copy of this match is a second answer waiting to disagree.
	function functionAliasTypeName(declared MaxonType) returns ByteArray
		return match declared 'k'
			named(id) gives self.internedName(id)
			structRef(id) gives self.internedName(id)
			function(id) gives self.internedName(id)
			boolean to float gives EmptySourceText
			exitCode to unresolved gives EmptySourceText
			string gives EmptySourceText
			// A type parameter / generic instance carries no re-internable NAME (its id is a W14 TOKEN — a
			// digest of `(declaring type, parameter)` — / a GenericInstanceId, P1.6-A), so like a primitive
			// it yields the empty string. ⭐ For a TYPE PARAMETER that is not the end of the story and used to
			// be: the identity travels in its own column instead (`FunctionAliasParam.typeParamToken`, filled by
			// `TypeResolution.functionAliasTypeParamToken`), because a digest needs no interner — so it belongs
			// in neither the name slot nor, as it did until F3, a refusal of the whole declaration.
			typeParameter gives EmptySourceText
			genericInstance gives EmptySourceText
			// A Character is a builtin with no interned name, exactly like `string` above.
			character gives EmptySourceText
			// An existential DOES carry a re-internable name — the interface's — so a function alias whose
			// parameter or result is declared at an interface type round-trips through a reader's interner
			// exactly as a `structRef` one does.
			interfaceRef(id) gives self.internedName(id)
		end 'k'
	end 'functionAliasTypeName'

	// The `to <high>` / `upto <high>` half of a range, returned as an INCLUSIVE upper
	// bound: `upto` is exclusive, so it normalizes to `high - 1` here and the registry
	// keeps exactly one representation of a range (`0 upto 10` and `0 to 9` are the same
	// alias, which is what the language says they are).
	//
	// `i64.min` has no `upto` form — its exclusive bound would be one BELOW the smallest
	// representable value. Rejected with a positioned error, because the subtraction that
	// normalizes it would otherwise underflow `ParsedInt` and take the COMPILER down on a
	// source file it should merely have diagnosed.
	function parseRangeUpperBound(isFloat bool) returns ParsedRangeBound throws ParseError
		if self.at(TokenKind.upto) 'exclusive'
			let uptoTok = try self.consume(TokenKind.upto)

			// `upto` normalizes to an inclusive `high - 1` (below) — INTEGER arithmetic on the bound.
			// A float bound is an IEEE-754 bit pattern, not a count, so `bits - 1` is nonsense on it,
			// and no float alias in the corpus uses `upto`. Rejected rather than mis-normalized; a
			// float exclusive bound is a concern only for the P1.9 range check that would read it.
			if isFloat 'floatExclusive'
				throw ParseError.unsupported("an exclusive `upto` upper bound on a float typealias — a float bound is a bit pattern with no integer predecessor; use `to`", line: uptoTok.line, column: uptoTok.column)
			end 'floatExclusive'

			let bound = try self.parseRangeBound(isFloat)
			if bound.value == I64MinBound 'unrepresentable'
				throw ParseError.unsupported("an exclusive upper bound of i64.min — its inclusive form is one below the smallest 64-bit integer, so the range is empty and not representable", line: uptoTok.line, column: uptoTok.column)
			end 'unrepresentable'
			return bound.withValue(bound.value - 1)
		end 'exclusive'

		try self.consume(TokenKind.to)
		return try self.parseRangeBound(isFloat)
	end 'parseRangeUpperBound'

	// One endpoint of a range. For an INT alias: an integer literal (`0`, `-273`, `0xFFFF`) or a
	// type-qualified bound (`i64.min`, `u32.max`). For a FLOAT alias (`isFloat`): a float literal or a
	// float type-qualified bound — see `parseFloatRangeBound`. The two endpoints of one range are
	// parsed with the same `isFloat`, so a range cannot mix an int and a float bound.
	function parseRangeBound(isFloat bool) returns ParsedRangeBound throws ParseError
		if isFloat 'float'
			return try self.parseFloatRangeBound()
		end 'float'

		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.intLiteral)
			return ParsedRangeBound.literal(try self.intLiteralValue(tok, negated: true))
		end 'negative'

		if self.at(TokenKind.intLiteral) 'literal'
			let tok = try self.consume(TokenKind.intLiteral)
			return ParsedRangeBound.literal(try self.intLiteralValue(tok, negated: false))
		end 'literal'

		return try self.parseTypeQualifiedBound(false)
	end 'parseRangeBound'

	// One endpoint of a FLOAT range: a float literal (`0.0`, `100.0`, `-2.5`) or a type-qualified
	// float bound (`f32.min`, `f64.max`). The value is the endpoint's IEEE-754 **f64** bit pattern,
	// carried in the same `ParsedInt` an integer bound uses — a float alias resolves to
	// `MaxonType.float` = f64, so its bounds are f64 bits (`RangedTypeAlias`). The literal path reuses
	// the one float decoder `parseFloatLiteral` does (`__float_bitsFromText`), so `0.0` reads the same bits
	// in a bound as in an expression. A negated literal FLIPS the sign bit (`negatedFloatBits`) rather
	// than subtracting: `0 - bits` on a bit pattern would be nonsense (see `FloatSignBit`).
	function parseFloatRangeBound() returns ParsedRangeBound throws ParseError
		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.floatLiteral)
			let bits = try self.floatLiteralBits(tok)
			return ParsedRangeBound.literal(negatedFloatBits(bits))
		end 'negative'

		if self.at(TokenKind.floatLiteral) 'literal'
			let tok = try self.consume(TokenKind.floatLiteral)
			return ParsedRangeBound.literal(try self.floatLiteralBits(tok))
		end 'literal'

		return try self.parseTypeQualifiedBound(true)
	end 'parseFloatRangeBound'

	// Convert an integer-literal token's text to its value, re-raising NumberParsing's
	// overflow as a POSITIONED parse error. THE one place a literal's text becomes a
	// number: the expression parser (`parseIntLiteral`) and the range-bound parser both
	// come through it, so how a literal is read — the radix prefixes it accepts, the
	// overflow it rejects — cannot come to mean one thing in `return 42` and another in
	// `int(0 to 42)`.
	//
	// `negated` routes to `parseNegatedInt` rather than negating the result: `i64.min`'s
	// magnitude does not fit a POSITIVE i64, so negating after the fact would overflow on
	// the one bound that most needs to work.
	function intLiteralValue(tok Token, negated bool) returns ParsedInt throws ParseError
		if negated 'negative'
			return try parseNegatedInt(tok.value) otherwise (err) 'rejected'
				throw self.literalDecodeError(err, tok: tok, isFloat: false)
			end 'rejected'
		end 'negative'
		return try parseInt(tok.value) otherwise (err) 'rejected'
			throw self.literalDecodeError(err, tok: tok, isFloat: false)
		end 'rejected'
	end 'intLiteralValue'

	// The float twin of `intLiteralValue`: THE one place a float literal's text becomes BITS. Six
	// sites used to spell `try <the reader>(tok.value) otherwise throw …` for themselves — a field
	// default, both float range bounds, an enum raw value, a constant initializer and the expression
	// parser — which is the same fact written down six times, and the integer side had already been
	// centralized for exactly that reason.
	//
	// ⭐ **THE READER ANSWERS WITH A RESULT AND THIS IS WHERE IT BECOMES A `ParserError`.**
	// `__float_bitsFromText` lives in `stdlib/Builtins.maxon` and deliberately does not throw (a stdlib
	// error enum is language surface — see `__FloatTextResult`), so its two failure arms are named in the
	// compiler's own vocabulary exactly once, HERE, and go on to the same `literalDecodeError` the
	// integer path uses. Mapping them anywhere else would be a second opinion about which diagnostic a
	// bad literal deserves.
	//
	// ⭐⭐ **SPELLED `float.bitsFromText`, BECAUSE THIS FILE MAY NOT WRITE THE RESERVED NAME.** To the
	// compiler compiling it, `Compiler/Parser.maxon` is an ordinary user program, and
	// `requireCalleeIsNotReservedName` — the rule this very file states — refuses a `__` callee written
	// out in a file that does not DECLARE it. The primitive-static spelling mints exactly those bytes
	// (`primitiveStaticCallee`), so it links to the same body through the door the rule leaves open.
	// `TypeRules.formatBound` spells the printer the same way. See
	// `specs-shv2/reserved-double-underscore.md`'s primitive-static pair.
	function floatLiteralBits(tok Token) returns ParsedInt throws ParseError
		match float.bitsFromText(String.from(tok.value)) 'decoded'
			bits(value) then return value
			overflow then throw self.literalDecodeError(ParserError.overflow, tok: tok, isFloat: true)
			// Reachable from source — `1.5.3` is the shape. See `literalDecodeError`, which used to
			// panic here on a premise the lexer disproved.
			malformed then throw self.literalDecodeError(ParserError.malformed, tok: tok, isFloat: true)
		end 'decoded'
	end 'floatLiteralBits'

	// Turn a NumberParsing failure into the POSITIONED parse error that reports it, quoting the
	// token's RAW TEXT — the radix prefix and `_` separators the source wrote, which the decoded
	// value can no longer say.
	//
	// ⛔⛔ **`malformed` IS REPORTED, AND IT USED TO PANIC.** The panic asserted this arm was
	// unreachable from source — "`Lexer.scanNumber` hands a literal token nothing but digits, `_`,
	// `.`, `e`/`E` and an exponent sign, so a rejection means the lexer and the reader have diverged,
	// a compiler defect rather than a program's". **The premise was false.** The lexer's trailing-byte
	// rule appended a SECOND `.` to a token that already carried a fraction, so `1.5.3` arrived here
	// as `1.5.` and CRASHED the compiler; `1.5.`, `1..5` and `1.5e2.3` did the same. That hole is now
	// closed in the lexer too (see `scanNumber`'s `not isFloat` clause), and BOTH layers are fixed
	// deliberately: a parser that cannot answer "this literal is not well-formed" with a position is a
	// parser whose caller's leniency has nowhere to surface, which is exactly how the lexer's went
	// unnoticed. A diagnostic here costs nothing and stops the next one being a crash.
	function literalDecodeError(err ParserError, tok Token, isFloat bool) returns ParseError
		let literal = String.from(tok.value)
		match err 'kind'
			overflow then break 'kind'
			malformed then return ParseError.malformedNumericLiteral(literal, line: tok.line, column: tok.column)
		end 'kind'

		return ParseError.floatLiteralOverflow(literal, line: tok.line, column: tok.column) if isFloat else ParseError.integerOverflow(literal, line: tok.line, column: tok.column)
	end 'literalDecodeError'

	// A type-qualified numeric bound — `<sized>.min` / `<sized>.max`, three tokens
	// (identifier, `.`, identifier). Shared by the range-declaration parser and the
	// expression parser, which meet the same three tokens in two positions. `isFloat` is the
	// caller's domain: true only for the bound of a `float(...)` alias, where an `f32`/`f64` bound
	// is what is wanted; false for an int alias and for expression position (`let x = u16.max`),
	// where a float bound has no integer value to carry and is rejected.
	function parseTypeQualifiedBound(isFloat bool) returns ParsedRangeBound throws ParseError
		// Read through `consumeTypeBaseToken` for the reason every other type-named base is (D9): this is the
		// LAST-RESORT arm of `parseDottedPrimary`, so it is where a `Self.<member>` that is neither an enum
		// case nor a static call lands — and it must report what the same program spelled `<TypeName>.<member>`
		// reports ("expected a sized numeric type … but got 'Box'"), not an E2010 about the keyword.
		let typeTok = try self.consumeTypeBaseToken()
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		let wantMax = try self.boundFieldIsMax(fieldTok)

		match sizedTypeBound(typeTok.value, wantMax: wantMax) 'resolve'
			// An integer bound is accepted in every position — including a `float(...)` alias, where
			// `float(0.0 to i64.max)` is as malformed as an out-of-order int range and left equally
			// unchecked (F1 emits no range check that would read the bound; this matches the int path's
			// existing laxness rather than adding a validation the int path does not have).
			value(bound) then return ParsedRangeBound.qualified(bound, qualifier: typeTok.value, isMax: wantMax)
			floatBound(bits) then return ParsedRangeBound.qualified(try floatBoundInFloatAlias(bits, isFloat: isFloat, typeTok: typeTok, fieldTok: fieldTok), qualifier: typeTok.value, isMax: wantMax)
			notASizedType then throw ParseError.unexpectedToken("a sized numeric type (u8/u16/u32/u64/i8/i16/i32/i64/f32/f64)", got: tokenDisplayText(typeTok), line: typeTok.line, column: typeTok.column)
		end 'resolve'
	end 'parseTypeQualifiedBound'

	// True for `.max`, false for `.min`. Any other field name is a positioned error —
	// a sized type exposes exactly these two bounds.
	function boundFieldIsMax(fieldTok Token) returns bool throws ParseError
		if fieldTok.value.equals(MaxBoundField) 'max'
			return true
		end 'max'
		if fieldTok.value.equals(MinBoundField) 'min'
			return false
		end 'min'
		// ⚠ **UNQUOTED, BECAUSE THE QUOTES ARE `expectationDisplayText`'s TO ADD.** This site used to pass its
		// expectation ALREADY QUOTED, so the renderer quoted it again and the message carried a doubled pair
		// around a doubly-quoted string — the renderer quoting text that had quoted itself, which is what a
		// second site deciding presentation looks like from the outside. It was the one live counterexample to
		// that function's claim to be the only decider.
		throw ParseError.unexpectedToken("min or max", got: tokenDisplayText(fieldTok), line: fieldTok.line, column: fieldTok.column)
	end 'boundFieldIsMax'

	// Parse a struct type declaration (P1.0r):
	//
	//     type Point
	//         export var x as Integer
	//         export var y as Integer
	//         static function create(x Integer, y Integer) returns Self
	//             return Self{x: x, y: y}
	//         end 'create'
	//     end 'Point'
	//
	// ⭐ **THE DECLARATION EMITS NOTHING** — no op, no storage, no code. A `type` is a LAYOUT, and
	// its whole effect is the `StructLayout` recorded below, which `Self{…}` sizes its `__mm_alloc`
	// from and `p.x` reads its offsets out of. Its METHODS are ordinary functions, named
	// `Point.create` (`declaredMethodName`) and built by the very same `parseFunction` a free
	// function is: there is no method table, no receiver, and nothing for a call to dispatch
	// through. That is the whole of `static function` at this rung.
	//
	// ⚠ **THE LAYOUT IS RECORDED AFTER THE BODY, AND NOTHING IN THE BODY READS IT.** `Self{x: x, y:
	// y}` inside `create` needs the field list — and it asks `signatures.structOf`, the WHOLE-PROGRAM
	// sweep, which is complete before this file's parse begins. So there is no ordering hazard, and
	// deliberately no half-built artifact registry for a method body to race: a `type` whose fields
	// are declared BELOW its methods parses identically to one that declares them above.
	function parseTypeDeclaration(visibility Visibility) throws ParseError
		let nameTok = try self.readTypeHeader()
		// The real parse alone rejects a reserved `type __T` or a compiler-owned `type Ordering` —
		// `readTypeHeader` stays a pure reader shared with the tolerant sweep, which is not a validator
		// (see `recordScannedType`).
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try self.requireTypeNameNotCompilerOwned(nameTok, declares: DeclaredTypeMeaning.nominalIdentity)
		self.enterTypeScope(nameTok.value, isEnum: false)

		var layout = StructLayout.create(nameTok.value, visibility: visibility, declFilePath: self.filePath)
		// `uses T` (P1.6-A) — parsed here so `parseTypeReference` recognizes `T` in the fields and
		// methods below, and the arity check reads the list off the recorded layout.
		self.openTypeParamScope(layout)

		// `implements I1, I2` (P1.7a slice 1) — parsed AFTER `uses` per the grammar
		// `type Name [uses …] [implements …]`. Records a whole-program ConformanceDecl (anchored on the
		// type NAME token) that `checkConformance` validates; the declaration itself emits nothing.
		self.openConformanceClauseAliasScope()
		try self.parseTypeImplementsClause(nameTok)
		self.closeConformanceClauseAliasScope()

		// `where T is <Interface> …` (P1.7a slice 2a) — parsed AFTER `implements` per the grammar
		// `type Name uses T [implements I] where T is C`. The constraints are set on `enclosingWhereConstraints`
		// (so the body parse below recognizes a `self.item.digest()` witness dispatch and reserves witness
		// parameters) AND recorded on the layout (so the instantiation-site check validates `Box with Point`).
		if self.at(TokenKind.where) 'whereClause'
			let constraints = try self.readWhereClause()
			self.enclosingWhereConstraints = constraints
			layout.recordWhereConstraints(constraints)
		end 'whereClause'

		// The cursor sits at the type body start; remember it so the lazy sibling-receiver walk (#65) can begin
		// here once a method body's bare call needs it. The memo is invalidated implicitly — its key still names
		// the previous type, so the first call in this body rebuilds against this start.
		self.enclosingTypeBodyStart = self.pos

		while true 'members'
			let atEnd = try self.atDeclarationBodyEnd()
			if atEnd 'closes'
				break
			end 'closes'

			if self.atStructFieldKeyword() 'isField'
				try self.readStructFieldInto(layout)
				continue
			end 'isField'

			try self.parseTypeMember(MemberList.typeBody)
		end 'members'

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.recordStructType(layout)
		self.closeTypeParamScope()
	end 'parseTypeDeclaration'

	// The member list's TERMINATOR test, shared by a `type` body and an `extension` body: blank lines are
	// skipped, an `end` closes, and EOF is the unterminated-declaration throw. The two bodies differ only in
	// what a member may BE — one may declare storage and the other may not — so only the loop BODY is theirs.
	function atDeclarationBodyEnd() returns bool throws ParseError
		self.skipNewlines()
		if self.at(TokenKind.end) 'closes'
			return true
		end 'closes'

		if self.isEof() 'eof'
			let tok = self.current()
			throw ParseError.unexpectedEof(tok.line, column: tok.column)
		end 'eof'

		return false
	end 'atDeclarationBodyEnd'

	// ⭐⭐ **`extension <Interface> … end` — MONOMORPHIZED BY RE-PARSE, ONE PASS PER CONFORMING TYPE.**
	//
	// An extension method has ONE source body and must become a CONCRETE method of every type whose
	// `implements` clause names the interface, because shv2 dispatches statically: `list.count()` is an
	// ordinary direct call to `IntList.count`, and `IntList.count` has to exist as a function. So the body's
	// TOKENS are parsed again for each conformer, with `enclosingType` set to that conformer — which is
	// exactly the state `type IntList`'s own body would have been parsed in. Nothing downstream learns that
	// extensions exist: `declaredMethodName` names the method `IntList.count`, `enclosingSelfType` types the
	// receiver `structRef(IntList)`, and the call site resolves through the ordinary method door.
	//
	// ⭐⭐ **RE-PARSE RATHER THAN IR-CLONE, AND THAT IS THE DEPARTURE FROM BOTH REFERENCES.** v1 captures the
	// body once into `project.unresolvedExtensions` and clones the IR per substitution
	// (`ParseDelta.MonomorphizeExtensions`); the C# bootstrap clones MLIR functions
	// (`FunctionCloner`). Both then have to hunt down every construct inside the clone whose identity is
	// per-substitution — which is precisely what the bootstrap's `SpecializeClosureName` +
	// `ClosureSpecializations` drain exists for, and what v1 panics on with *"closure '_$closure_N'
	// referenced from a monomorphized extension body"*. Re-parsing has NO clone and therefore no such hunt:
	// every ValueId, every lifted closure and every temporary is MINTED FRESH by the parser, in the conformer's
	// own scope. A closure inside `callTag` lifts to `Three.callTag$closure_0` on one pass and
	// `Seven.callTag$closure_0` on the next — two distinct functions, each with its own `tag()` resolved
	// against its own receiver — because the lifted name is derived from the ENCLOSING FUNCTION's name, which
	// is already per-conformer. The substitution-dependent-closure miscompile is unrepresentable rather than
	// cured. It costs one parse of the body per conformer, which is exactly the code that has to be generated.
	//
	// ⚠ **THE BODY IS NOT PARSED AT ALL WHEN NOTHING CONFORMS**, so an extension on an interface no type
	// implements is unchecked. That is the same bargain a generic body strikes in a monomorphizing compiler,
	// and the alternative — checking it against a `Self` that has no type — is not available.
	//
	// ⚠ The cursor is re-seated from the body start each pass and, at the end, walked past the declaration's
	// own `end` through `skipPastBlockEnd` — the same walk the sweep used, so the real parse and the sweep
	// cannot disagree about where this declaration stops. That also makes the zero-conformer case need no arm
	// of its own.
	//
	// An `export`/`module` modifier on the `extension` keyword is consumed by `dispatchTopLevel` and means
	// nothing here: an extension declares no name to make visible, and each of its METHODS carries its own
	// visibility exactly as a `type`'s members do (`parseTypeMember`).
	function parseExtensionDeclaration() throws ParseError
		let header = try self.readExtensionHeader()

		// ⛔⛔ **`extension byte` IS REFUSED HERE, AND THE REFUSAL IS DERIVED RATHER THAN SPELLED (W133).**
		// `namesAPrimitiveType` admits FOUR names because that is the set with STATICS (`byte.fromString`);
		// `primitiveTagOfTypeName` admits THREE because that is the set with a VALUE TAG, and only the second
		// set can be extended — `byte` names no type in shv2 at all, and a byte VALUE is an ordinary `int`
		// range (`typealias Byte = int(0 to u8.max)`, `stdlib/Character.maxon:12`) which reaches every receiver
		// door tagged `integer`. So an `extension byte` body would publish `byte.<method>` symbols nothing can
		// ever dispatch.
		//
		// ⚠ **WITHOUT THIS IT IS NOT AN ERROR, IT IS SILENCE — WHICH IS THE WORSE HALF OF THE TRADE.** `byte`
		// falls to `undeclaredTarget`, whose zero conformers mean the body is never parsed at all, so the whole
		// declaration compiles to nothing with no diagnostic (MEASURED on this tree before this gate: exit 0,
		// the extension inert, and its body's own `Integer` reported unused because nothing ever read it).
		// That general silence is DELIBERATE and stays — an `extension <Interface>` no type implements is a
		// legal, documented no-op (see this function's ⚠) — so the refusal is narrowed to the one case where
		// the author named something the compiler DOES recognize as a primitive and cannot honour.
		//
		// ⇒ Written as the DIFFERENCE between the two tables, not as `b"byte"`: the day a fifth primitive
		// joins `namesAPrimitiveType` without a value representation it is refused here automatically, and the
		// day `byte` acquires one it is admitted by `extensionTargetOf` and never reaches this line.
		if namesAPrimitiveType(header.nameTok.value) and primitiveTagOfTypeName(header.nameTok.value) == ValueTypeTag.unresolved 'aPrimitiveWithNoValuesOfItsOwn'
			throw ParseError.unsupported("`extension {String.from(header.nameTok.value)}` — `{String.from(header.nameTok.value)}` is the qualifier of a static (`{String.from(header.nameTok.value)}.fromString`) and names no type of its own, so it has no values for these methods to be dispatched on; a byte-sized value is an `int` range (`typealias Byte = int(0 to u8.max)`), so extend `int`", line: header.nameTok.line, column: header.nameTok.column)
		end 'aPrimitiveWithNoValuesOfItsOwn'

		let bodyStart = self.pos

		// The conformer list and the per-conformer verdict are `readExtensionHeader`'s and
		// `extensionConformerVerdict`'s — the SAME answers, in the SAME order, that
		// `foldExtensionDeclarationInto` published a signature for. A body emitted here with no signature
		// published there is a call that cannot be typed; a signature with no body is a link failure — and a
		// CONDITIONAL extension adds a third way for the two to disagree, so the filter is one function both
		// call rather than a rule each applies.
		for conformer in extensionTargetConformers(header.target) 'eachConformer'
			match self.extensionConformerVerdict(header, conformer: conformer, index: self.signatures) 'verdict'
				// A withheld method has no signature, so a body emitted for it would be a function nothing can
				// call — and its own statements would not type, which is the whole reason the clause exists.
				unmet then continue
				satisfied then break 'verdict'
			end 'verdict'

			// ⭐ **THE EXTENSION'S OWN `implements` IS RECORDED HERE, PAST THE VERDICT, AND THAT POSITION IS THE
			// WHOLE MEANING OF A CONDITIONAL CONFORMANCE.** `extension Array implements Hashable where Element
			// is Hashable` says the conformance holds for the conformers that satisfy the clause and for no
			// others; recorded before the verdict it would claim `Hashable` for every one of them, which is the
			// same sentence with the condition deleted. The `unmet` arm above has already `continue`d, so a
			// conformer reaching this line is one the clause admits.
			//
			// It is the REAL PARSE that records it and not the fold, for the reason the fold publishes only
			// signatures: `recordConformance` writes the per-file artifact `checkConformance` later reads, and
			// the fold runs once per declaration over a shared index that has no file to attribute it to.
			self.recordExtensionConformance(header, conformer: conformer)

			self.pos = bodyStart
			self.enterTypeScope(conformer, isEnum: false)
			self.openExtensionBodyScope(header, conformer: conformer, index: self.signatures)
			// Where the sibling-receiver walk begins for a bare call in these bodies — the EXTENSION's member
			// list, not the conformer's, because a bare call here may name a sibling extension method. What
			// the conformer itself declares is NOT on this walk and comes from the whole-program index
			// (`isImplicitSelfMethod`); the extended interface's own requirements are added to the map by
			// `ensureSiblingReceivers`, which is what makes a bare `tag()` resolve against a REQUIREMENT the
			// index files under no conformer. See `extensionInterfaceName`.
			self.enclosingTypeBodyStart = bodyStart
			self.extensionInterfaceName = self.extendedInterfaceName(header)

			while true 'members'
				let atEnd = try self.atDeclarationBodyEnd()
				if atEnd 'closes'
					break
				end 'closes'

				// ⭐ **A SHADOWED METHOD IS STEPPED OVER WHOLE (W43)** — the conformer declares its own, so the
				// fold published no signature for this one and a body emitted here would be a second definition
				// under the same symbol. The DECISION is the fold's, read back rather than re-derived: by now the
				// index also holds the extension's OWN published names, so `conformerDeclaresOwnMethod` can no
				// longer tell them apart. See `ProgramSignatures.extensionPublishedMethods`.
				// ⭐⭐ **AND A STDLIB MEMBER A USER FILE DECLARES TOO IS STEPPED OVER FOR THE SAME REASON (W188)** —
				// the user's `extension int` wears the name (`ProgramSignatures.noteExtensionPublishedMethod`),
				// so a body emitted here is a second definition under one symbol, which is `E3006` at the merge.
				// The provenance test is THIS parser's own: the set is keyed by name alone, and the file that
				// WON must go on emitting its body.
				let extensionMemberName = qualifiedMethodName(conformer, methodName: self.extensionMemberMethodNameAt(self.pos))
				if self.signatures.extensionMethodIsShadowed(extensionMemberName) or (self.isStdlibSource and self.signatures.stdlibExtensionMethodIsBeatenByUser(extensionMemberName)) 'anotherDeclarationWearsTheName'
					self.skipPastExtensionMember()
					continue
				end 'anotherDeclarationWearsTheName'

				// An extension member is a TYPE member — same visibility, same `static`, same `function`.
				// A `var`/`let` is refused by that reader (`requireMemberListDeclaresStorage`), which is the
				// right answer: an extension adds behaviour, never storage, so there is no layout for a field
				// to join and no declaration for a `static` binding's slot to belong to.
				try self.parseTypeMember(MemberList.extensionBody)
			end 'members'

			self.closeTypeParamScope()
			self.extensionInterfaceName = EmptySourceText
		end 'eachConformer'

		self.pos = bodyStart
		self.skipPastBlockEnd()
	end 'parseExtensionDeclaration'

	// ⭐ **THE METHOD NAME AN EXTENSION MEMBER STARTING AT `index` DECLARES, as a PEEK** — the empty source
	// text for a nested typealias, for a malformed member, and for anything that is not a method, so the one
	// caller can ask unconditionally. It mirrors the header order the fold and `parseTypeMember` both read —
	// an optional visibility modifier, an optional `static`, then `function <name>` — because the shadow
	// decision has to be taken BEFORE the member is consumed, and a member the decision skips is stepped over
	// whole rather than parsed.
	function extensionMemberMethodNameAt(index TokenIndex) returns ByteArray
		var at = self.pastVisibilityModifier(index)
		if self.kindAt(at) == TokenKind.static 'staticMember'
			at = at + 1
		end 'staticMember'
		if not self.functionDeclarationAt(at) 'notAMethod'
			return EmptySourceText
		end 'notAMethod'

		return self.tokenAt(at + 1).value
	end 'extensionMemberMethodNameAt'

	// Step the cursor past a whole extension MEMBER, leaving it exactly where `parseTypeMember` would have.
	// The member's own `end` is found by `skipPastBlockEnd`, which needs the cursor INSIDE the one block that
	// `end` closes — so the `function` keyword is consumed first, exactly as every other walk over a method
	// enters it.
	function skipPastExtensionMember()
		while not self.isEof() and self.kindAt(self.pos) != TokenKind.function 'toTheKeyword'
			self.advance()
		end 'toTheKeyword'
		self.advance()
		self.skipPastBlockEnd()
	end 'skipPastExtensionMember'

	// The interface whose REQUIREMENTS are siblings of this body's methods — see `ensureSiblingReceivers`.
	// Empty for a TYPE extension, and that is the point: a type has no requirement list to add.
	//
	// ⚠ **IT IS NOT EMPTY BECAUSE THE WALK ALREADY FINDS A TYPE'S OWN MEMBERS — IT DOES NOT, AND THIS COMMENT
	// SAID IT DID.** The walk starts at the EXTENSION's member list (`enclosingTypeBodyStart` is set to the
	// extension's body, one line above the assignment of this field), so `extension Box`'s bare `tag()` never
	// saw `type Box`'s `tag` at all. The conformer's own methods come from the whole-program index instead,
	// which is where they are for an INTERFACE extension's conformer too — see `isImplicitSelfMethod`. What a
	// requirement list adds on top is the one thing the index cannot: an interface's requirement is not filed
	// under the conformer, so a conformer that has not yet been reached by any declaration of it still
	// resolves `tag()` here.
	function extendedInterfaceName(header ExtensionHeader) returns ByteArray
		match header.target 'target'
			interfaceExtension then return header.nameTok.value
			typeExtension then return EmptySourceText
			undeclaredTarget then return EmptySourceText
		end 'target'
	end 'extendedInterfaceName'

	// ⭐ **`interface Name [extends …] [uses …] … end` (P1.7a slice 1)** — the FRONT-END half of interfaces,
	// as the REAL parse reaches it. Its whole effect is the `IrInterface` it puts on this file's artifact, which
	// `mergeArtifact` folds into `project.interfaces` for `checkConformance` to verify every `implements`-ing
	// type against. It EMITS NOTHING: an interface declares a contract, not code — there are no witness tables,
	// no dispatch, no lowering at this slice.
	//
	// The READING is `readInterfaceDeclaration`'s, shared with the declaration sweep's second pass; what this
	// arm owns is the artifact, which the sweep has none of. See that function for why the two are split.
	function parseInterfaceDeclaration() throws ParseError
		let iface = try self.readInterfaceDeclaration()
		try self.requireNoUnstorableRequirementType()
		self.artifact.recordInterface(iface)
	end 'parseInterfaceDeclaration'

	// ⭐⭐ **THE REFUSAL IS RECORDED BY THE SHARED READER AND THROWN ONLY HERE, AND THAT SPLIT IS FORCED.**
	// `readInterfaceDeclaration` has TWO callers: this one, the real parse, and `foldInterfaceDeclarationInto`,
	// which is TOLERANT — it swallows a `ParseError` and records nothing. Throwing from inside the reader would
	// therefore drop the interface out of the whole-program index whenever the fold reached it, and the fold
	// runs with `allFilesFolded` already set, so `parseTypeReference` CAN mint an `interfaceRef` there for any
	// interface folded earlier. The result would be order-dependent: the same program would lose a declaration
	// or not depending on which interface was declared first. So the reader notes and this throws.
	//
	// The message is `requireStorableDeclaredType`'s, through the same `DeclaredStoragePosition` door the five
	// other interface-typed positions use — see `interfaceStoragePositionMessage`.
	function requireNoUnstorableRequirementType() throws ParseError
		if self.pendingRequirementParamInterface.count() == 0 'noneSeen'
			return
		end 'noneSeen'

		let interfaceName = self.pendingRequirementParamInterface
		let position = self.pendingRequirementParamPosition
		let line = self.pendingRequirementParamLine
		let column = self.pendingRequirementParamColumn
		self.clearPendingRequirementParam()
		throw ParseError.unsupported(interfaceStoragePositionMessage(position, interfaceName: interfaceName), line: line, column: column)
	end 'requireNoUnstorableRequirementType'

	// Note an interface-typed slot of a requirement — a PARAMETER or the RETURN — for the real parse to
	// refuse. Only the FIRST: one refusal per declaration is what the author acts on, and the sibling
	// positions report one too.
	function noteUnstorableRequirementType(declaredType MaxonType, position DeclaredStoragePosition, line LineNumber, column ColumnNumber)
		if self.pendingRequirementParamInterface.count() != 0 'alreadyNoted'
			return
		end 'alreadyNoted'

		if maxonTypeTag(declaredType) != ValueTypeTag.interfaceRef 'notAnExistential'
			return
		end 'notAnExistential'

		self.pendingRequirementParamInterface = self.internedName(typeNameIdOf(declaredType))
		self.pendingRequirementParamPosition = position
		self.pendingRequirementParamLine = line
		self.pendingRequirementParamColumn = column
	end 'noteUnstorableRequirementType'

	// The fold's counterpart to the throw above: it must leave no record behind for the NEXT declaration this
	// same reader parses to inherit.
	function clearPendingRequirementParam()
		self.pendingRequirementParamInterface = EmptySourceText
		self.pendingRequirementParamPosition = DeclaredStoragePosition.interfaceRequirementParameter
		self.pendingRequirementParamLine = 0
		self.pendingRequirementParamColumn = 0
	end 'clearPendingRequirementParam'

	// ⭐ **THE ONE READER OF AN `interface` DECLARATION (R8)** — cursor AT the `interface` keyword, landing past
	// the closing `end`. TWO parties build an `IrInterface` and they must build the SAME one: the real parse,
	// which records it on the file's artifact for `checkConformance` to read whole-program after every merge;
	// and `foldInterfaceDeclarationInto`, which records it in the declaration index for the PARSE-time witness
	// dispatch and `with`-arity readers. A second builder would be free to render a requirement's types
	// differently from this one, and a rendered type name is an IDENTITY here, not a caption — the failure mode
	// is a silent false accept on a conformance (`renderDeclaredTypeName`'s header carries the measurement).
	//
	// Method signatures have an implicit `self` (never declared), so `parseFunctionParameters` reads the USER
	// parameters only — exactly what the conformance check compares against an impl's parameters once it drops
	// the impl's prepended `__self`. `Self` in a signature resolves against `enclosingType` (set to the
	// interface name here), so the check can substitute the conforming type for it.
	function readInterfaceDeclaration() returns IrInterface throws ParseError
		try self.consume(TokenKind.interface)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		// An interface is neither a struct nor an enum, and `isEnum: false` is the right answer for the one
		// thing the kind decides: a `Self` in an interface method's signature is a `structRef`, which is what
		// `checkConformance` substitutes the CONFORMING type into (and only a `type` may conform at this rung).
		self.enterTypeScope(nameTok.value, isEnum: false)
		// Per DECLARATION, so the entries a previous interface in this file left behind cannot be folded under
		// this one's name. It points back at the shared empty rather than allocating, so an interface that
		// declares no generic-instance alias — every interface in the corpus but a handful — costs nothing.
		self.interfaceAliasScratch = sharedEmptyInterfaceAliases

		var extendsInterfaces = ByteArrayArray.create()
		var associatedTypeNames = ByteArrayArray.create()
		try self.parseInterfaceHeaderClauses(extendsInterfaces, associatedTypeNames: associatedTypeNames)
		// ⭐ **AN INTERFACE'S `uses` NAMES ARE ITS TYPE-PARAMETER SCOPE (D6)** — the same field a `type`'s
		// `uses` sets (`openTypeParamScope`), because the body asks the same question of it: inside
		// `interface InitableFromArrayLiteral uses Element`, a written `Element` denotes the associated type
		// and nothing else. Without it a `typealias ElementArray = Array with Element` below reads `Element`
		// as an ordinary `named` type, and `checkGenericArgType`'s rule 3 refuses it with **E3011 Unknown
		// type 'Element'** — a diagnostic against a name the interface's own header declares.
		// A `uses`-less interface keeps the SHARED empty list `enterTypeScope` just installed, so it
		// allocates nothing (`openTypeParamScope`'s discipline).
		if associatedTypeNames.count() != 0 'hasAssociatedTypes'
			self.enclosingTypeParams = associatedTypeNames
		end 'hasAssociatedTypes'

		var methods = InterfaceMethodSigArray.create()
		while true 'members'
			self.skipNewlines()
			if self.at(TokenKind.end) 'closes'
				break
			end 'closes'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'

			// ⭐ **AN ASSOCIATED-TYPE ALIAS (D6)** — `typealias ElementArray = Array with Element`, the shape
			// `stdlib/Builtins.maxon:56` opens with. It is ACCEPTED AND RECORDED, never resolved or
			// substituted: `readNestedTypeAlias` enters the bare member into `enclosingInnerAliases`, so the
			// very next line's `static function init(value ElementArray)` reads a name this interface actually
			// DECLARES. Nothing SUBSTITUTES the instance for it, and nothing here needs to — an interface EMITS
			// NOTHING, and a requirement's parameter types exist only as the SOURCE STRINGS `checkConformance`
			// compares (`renderInterfaceTypeName`). Binding `Element := <arg>` at an `implements … with …` is a
			// rung of its own; `specs-shv2/associated-types.md` carries its nine red cases.
			//
			// ⚠ **BOTH REFERENCES THROW THIS LINE AWAY** — bootstrap `2-Parser.cs:4276-4281`, v1
			// `Parser.maxon:6578-6585`, each a skip-to-end-of-line — and v1's comment claims the alias
			// "contributes to associated-type resolution" while nothing reads it back. **A SKIP WOULD PARSE
			// HERE TOO, AND THAT IS MEASURED RATHER THAN ASSUMED**: an interface requirement's declared types
			// are never RESOLVED, only rendered, so `static function init(value Nonesuch)` — a requirement
			// naming a type no file declares — compiles and runs clean today, no diagnostic. The reason not to
			// skip is therefore not that it fails; it is that it works BY LEANING ON THAT HOLE. A skipped alias
			// leaves `ElementArray` denoting nothing at all, matching the conformer only because the string
			// happens to be spelled the same in both files (`stdlib/List.maxon:13`, `Set.maxon:14`), and the
			// substitution rung has to resolve exactly these types.
			//
			// Recording it costs one set insert and buys the alias a real meaning: `Array with Element` is
			// checked like any other instantiation, so `typealias A = Array with Nonesuch` inside an interface
			// is **E3011 Unknown type 'Nonesuch'** where a skip reports nothing. That check is also what forces
			// the `uses` scope installed above — without it the interface's own `Element` is the undeclared
			// name E3011 fires on.
			//
			// The whole-program shape is DISCARDED here for the reason `parseTypeMember` discards it: an
			// inner alias is keyed whole-program by the tolerant sweep, and the sweep records nothing of an
			// interface's BODY (`recordScannedInterface`) because an interface contributes no layout, no
			// signature and no emitted symbol for a later pass to look one up from. Its header's `uses` ARITY
			// is the one exception, and it is one because a PARSE reads it back (R7).
			//
			// ⚠ **A FUNCTION alias is REFUSED here though a `type` body now takes one**, and the asymmetry is
			// the sweep's, not the grammar's: a function alias is resolved through the WHOLE-PROGRAM
			// `signatures.functionTypeAliases`, which `foldFile` fills from the declaration sweep — and the
			// sweep reads no interface BODY at all (`recordScannedInterface` consumes the declaration whole).
			// Recorded from the real parse alone the name would be a function alias to `project` and an
			// unknown type to `parseTypeReference`, which is a wrong answer rather than a missing feature.
			if self.atTypeAliasDeclaration() 'associatedTypeAlias'
				let aliasTok = self.current()
				// ⚠ **`unpublished`, and for the very reason the FUNCTION form is refused two paragraphs down**
				// (see `TupleAliasOwner`): the declaration sweep reads no interface BODY, so a tuple alias keyed
				// from the real parse alone would be a name whose resolution depended on which file the walk
				// reached first. Read and validated here — `parseTupleTypeReference` checks its elements — and
				// entered into `enclosingInnerAliases`, which is all an interface requirement's RENDERED
				// signature needs.
				// ⭐⭐ **THE GENERIC-INSTANCE FORM'S RIGHT-HAND SIDE IS KEPT NOW (W61)** — the arm below used to
				// fall into the `ranged to tupleAlias` range and be discarded with them, and discarding it is
				// what made `function absorb(value ElementArray)` unsatisfiable: the requirement renders the
				// unresolved name `Holder.ElementArray` while every conformer's own alias renders a resolved
				// `Array_…`, so the two were compared as different strings and EVERY conformer was refused
				// (measured: `stdlib/Set.maxon` conforms today only because it happens to spell its own alias
				// with the same member name, which the reference compilers rely on and shv2 deliberately no
				// longer does — see `ProgramSignatures.interfaceAliases`).
				//
				// The other two per-instance forms are still discarded, and correctly: a RANGED inner alias
				// erases to `integer` and a TUPLE one resolves straight through to the interned tuple's own
				// `structRef`, so in both cases the requirement's rendered type is already the type, with
				// nothing left for a right-hand side to say.
				match try self.readNestedTypeAlias(try self.consumeOptionalVisibility(), recordFunctionSignature: false, tupleOwner: TupleAliasOwner.unpublished) 'nested'
					ranged then break 'nested'
					genericInstance(entry) then self.noteInterfaceAlias(entry)
					tupleAlias then break 'nested'
					functionAlias then throw ParseError.unsupported("a function typealias inside an `interface` body is a later slice — the declaration sweep does not read an interface's members, so the alias would name a type only its own file could resolve; declare it at file scope", line: aliasTok.line, column: aliasTok.column)
				end 'nested'

				continue
			end 'associatedTypeAlias'

			methods.push(try self.parseInterfaceMethod(nameTok.value, declaredSoFar: methods))
		end 'members'

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.closeTypeParamScope()
		return IrInterface.create(nameTok.value, methods: methods, extendsInterfaces: extendsInterfaces, associatedTypeNames: associatedTypeNames)
	end 'readInterfaceDeclaration'

	// The optional `extends P1, P2` and `uses A, B` clauses of an interface header, in either order. A
	// parent interface's methods a conforming type must ALSO supply (`checkConformance` projects them at
	// decl order); `uses` names associated types (kept for slice 2 — the enabled slice-1 corpus declares
	// none). Stops at the first token that opens neither clause (a newline into the body).
	function parseInterfaceHeaderClauses(extendsInterfaces ByteArrayArray, associatedTypeNames ByteArrayArray) throws ParseError
		while true 'clauses'
			if self.at(TokenKind.extends) 'extendsClause'
				try self.consume(TokenKind.extends)
				try self.parseCommaSeparatedNames(extendsInterfaces)
				continue
			end 'extendsClause'

			if self.at(TokenKind.uses) 'usesClause'
				try self.consume(TokenKind.uses)
				try self.parseCommaSeparatedNames(associatedTypeNames)
				continue
			end 'usesClause'

			break
		end 'clauses'
	end 'parseInterfaceHeaderClauses'

	// A comma-separated list of identifiers (`A, B, C`) into `out` — the shared reader behind an
	// interface's `extends`/`uses` lists and a `type`'s `implements` list.
	function parseCommaSeparatedNames(out ByteArrayArray) throws ParseError
		out.push((try self.consume(TokenKind.identifier)).value)
		while self.at(TokenKind.comma) 'more'
			try self.consume(TokenKind.comma)
			out.push((try self.consume(TokenKind.identifier)).value)
		end 'more'
	end 'parseCommaSeparatedNames'

	// One `[static] function name(params) [returns Type] [throws E]` interface method SIGNATURE (no body).
	// Its param/return types are rendered to SOURCE strings (see IrInterface) via `renderInterfaceTypeName`
	// — `Self` for the enclosing interface, the alias name for a `named` type, `void` for no return.
	// `declaredSoFar` is what the enclosing interface has already read, for the duplicate-name refusal below:
	// that check needs the NAME TOKEN's position, which exists only here.
	function parseInterfaceMethod(interfaceName ByteArray, declaredSoFar InterfaceMethodSigArray) returns InterfaceMethodSig throws ParseError
		let isStatic = self.at(TokenKind.static)
		if isStatic 'staticMethod'
			self.advance()
		end 'staticMethod'

		try self.consume(TokenKind.function)
		// An interface method's name is a DECLARED name exactly as `parseFunction`'s is, so it admits a keyword
		// too (D8) — a conforming type may declare `function to()`, and a requirement it could not spell would
		// be a requirement no type could satisfy.
		let nameTok = try self.consumeNameToken(NamePosition.declaration)
		try requireUnclaimedInterfaceRequirementName(nameTok, interfaceName: interfaceName, declaredSoFar: declaredSoFar)

		var paramNames = ByteArrayArray.create()
		var paramTypes = MaxonTypeArray.create()
		var paramRanges = SourceRangeArray.create()
		// An interface REQUIREMENT binds no value — it declares a signature and has no body — so the
		// declared-buffer-alias column (A2j) and the declared-type-position column (W57) are filled and
		// dropped here. Neither is omitted from the call, because `parseFunctionParameters` fills every column
		// in lockstep and a caller that could opt out would be a second way for the columns to come apart.
		var paramSurfaces = DeclaredSurfaceArray.create()
		var paramTypeStarts = TokenIndexColumn.create()
		try self.consume(TokenKind.leftParen)
		try self.parseFunctionParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges, paramSurfaces: paramSurfaces, paramTypeStarts: paramTypeStarts, owner: ParamDefaultOwner.interfaceRequirement, paramTypeHint: ClosureParamTypeHint.none)
		try self.consume(TokenKind.rightParen)
		// NOTED, not thrown — see `requireNoUnstorableRequirementType` for why this reader may not refuse.
		if let existential = try firstExistentialParam(paramTypes, paramRanges: paramRanges) 'existentialParam'
			self.noteUnstorableRequirementType(existential.declaredType, position: DeclaredStoragePosition.interfaceRequirementParameter, line: existential.anchor.line, column: existential.anchor.column)
		end 'existentialParam'

		let returnTok = self.tokenAt(self.pos)
		let returnType = try self.parseOptionalReturnType()
		// The RETURN half, noted the same way and refused through the SAME `returnType` arm a declared
		// function's return uses. Unguarded, an `interface Maker function make() returns Shape end` compiled
		// and LINKED, and the first dispatch on the result reported `a member access on a 'int' value` — the
		// declared type having quietly degraded to the machine word.
		match returnType 'declaredReturn'
			void then break 'declaredReturn'
			value(inner) then self.noteUnstorableRequirementType(inner, position: DeclaredStoragePosition.interfaceRequirementReturnType, line: returnTok.line, column: returnTok.column)
		end 'declaredReturn'
		// ⭐ **THE `throws E` CLAUSE IS RECORDED, NOT DISCARDED (P1.7a slice 2b-v).** It decides which ABI a
		// witness dispatch of this method uses — the dual-register `witnessTryCall` or the single-register
		// `witnessCall` — and it is the ONLY place that fact exists: a witness method has no callee name for
		// `ProgramSignatures.throwsOf` to answer about. Discarded (slice 1), a throwing interface method
		// dispatched through a witness silently DROPPED its error flag: the caller's `otherwise` never ran and
		// the impl's throw-path primary (0) came back as a real answer.
		let throwsClause = try self.parseOptionalThrowsClause()

		return InterfaceMethodSig.create(nameTok.value, paramNames: paramNames, paramTypeNames: self.renderInterfaceParamTypes(paramTypes, interfaceName: interfaceName), returnTypeName: self.renderInterfaceReturnType(returnType, interfaceName: interfaceName), isStatic: isStatic, throwsClause: throwsClause, paramIsBuffer: interfaceParamBufferSpellings(paramSurfaces))
	end 'parseInterfaceMethod'

	// Render each of an interface method's parameter types to its source string, parallel to `paramTypes`.
	// ⭐ **THE `__ManagedMemory` SPELLING, LIFTED OUT OF THE SURFACE COLUMN BEFORE IT IS DROPPED.** Bit 0 of
	// a position's root node is `SurfaceBitIsBuffer` — set when the source wrote the buffer's own name
	// rather than `ByteArray` or an `Array` alias. `parseInterfaceMethod` computes this column for every
	// requirement already (`parseFunctionParameters` fills every column in lockstep) and, until now, threw
	// it away; `InterfaceMethodSig.paramIsBuffer` says why it must survive.
	//
	// A position whose surface tree is the shared EMPTY one is plainly declared, which is every parameter in
	// the corpus but the two `BuiltinDictionaryLiteral` writes — so the common path reads one count and
	// pushes `false`.
	function interfaceParamBufferSpellings(paramSurfaces DeclaredSurfaceArray) returns BoolArray
		var out = BoolArray.create()
		for i in 0 upto paramSurfaces.count() 'each'
			let surface = try paramSurfaces.get(i) otherwise panic("interfaceParamBufferSpellings: paramSurfaces.get OOB at {i} of {paramSurfaces.count()} — parseFunctionParameters fills this column in lockstep with the names")
			out.push(surfaceIsBuffer(surface))
		end 'each'
		return out
	end 'interfaceParamBufferSpellings'

	function renderInterfaceParamTypes(paramTypes MaxonTypeArray, interfaceName ByteArray) returns ByteArrayArray
		var out = ByteArrayArray.create()
		for i in 0 upto paramTypes.count() 'each'
			out.push(self.renderInterfaceTypeName(try paramTypes.get(i) otherwise panic("renderInterfaceParamTypes: paramTypes.get OOB at {i}"), interfaceName: interfaceName))
		end 'each'
		return out
	end 'renderInterfaceParamTypes'

	// Render an interface method's RETURN to its source string — `void` for no `returns`, else the type.
	function renderInterfaceReturnType(returnType MaxonReturnType, interfaceName ByteArray) returns ByteArray
		return match returnType 'r'
			void gives InterfaceVoidTypeName
			value(inner) gives self.renderInterfaceTypeName(inner, interfaceName: interfaceName)
		end 'r'
	end 'renderInterfaceReturnType'

	// Render a parsed interface-signature `MaxonType` to the SOURCE string the conformance check compares
	// and prints. `Self` (a `structRef` whose id is the interface's own name) renders as `Self`; every
	// other type defers to the SHARED `renderDeclaredTypeName` — read off the LOCAL interner, but the STRING
	// is interner-independent, so it matches the impl side rendered off the project interner (the same
	// property `paramAggregateNames` relies on). Rendered at parse time, so `mergeArtifact` folds an
	// interface with no id to remap.
	//
	// ⚠ The `Self` arm is the WHOLE of what this adds, and it is deliberately NOT in the shared renderer: a
	// `Self` written in a conformance ARGUMENT means the conforming type's own name, not the string `Self`.
	function renderInterfaceTypeName(t MaxonType, interfaceName ByteArray) returns ByteArray
		let tag = maxonTypeTag(t)
		if tag == ValueTypeTag.structRef 'structRefType'
			let refName = self.localTypeName(t, asker: "renderInterfaceTypeName")
			if refName.equals(interfaceName) 'selfRef'
				return InterfaceSelfTypeName
			end 'selfRef'
		end 'structRefType'

		// Every other type goes through the ONE shared renderer (`IrInterface.renderDeclaredTypeName`) — the
		// same function the IMPL side of the conformance uses, so an associated type, a type PARAMETER and a
		// generic INSTANCE cannot be spelled one way here and another way there. `enclosingTypeParams` is the
		// interface's own `uses` list inside an interface body, which is what a `typeParameter(token)` in one of
		// its signatures indexes.
		return renderDeclaredTypeName(t, declarationName: interfaceName, typeParamNames: self.enclosingTypeParams, typeNames: self.artifact.typeNames, signatures: self.signatures)
	end 'renderInterfaceTypeName'

	// The `implements I1, I2 [with …]` conformance clause of a `type` declaration (P1.7a slice 1). Records
	// a ConformanceDecl anchored on the type NAME token, or does nothing when there is no clause. Each
	// interface carries its own `with` bindings (R5), which `checkConformance` substitutes into that
	// interface's requirements before it compares them.
	function parseTypeImplementsClause(nameTok Token) throws ParseError
		let interfaces = try self.readImplementsList()
		if interfaces.isEmpty() 'noImplements'
			return
		end 'noImplements'

		self.artifact.recordConformance(ConformanceDecl.create(nameTok.value, interfaces: interfaces, nameLine: nameTok.line, nameColumn: nameTok.column, filePath: self.filePath))
	end 'parseTypeImplementsClause'

	// The conformance an `extension <T> implements …` declares on behalf of ONE conformer the `where` clause
	// admits. Anchored on the extension's own name token, so a requirement the body fails to satisfy is
	// blamed at the `extension` line the author wrote rather than at the type's distant declaration.
	//
	// A plain `extension X` records nothing, which is the empty-list fast path and the whole corpus bar two
	// files.
	function recordExtensionConformance(header ExtensionHeader, conformer ByteArray)
		if header.interfaces.isEmpty() 'addsNoConformance'
			return
		end 'addsNoConformance'

		self.artifact.recordConformance(ConformanceDecl.create(conformer, interfaces: header.interfaces, nameLine: header.nameTok.line, nameColumn: header.nameTok.column, filePath: self.filePath))
	end 'recordExtensionConformance'

	// ⭐ **THE `implements I1, I2 [with …]` LIST ITSELF, WITHOUT DECIDING WHO CONFORMS.** Two headers carry
	// this clause — a `type` declaration's and an `extension`'s — and they differ only in what they do with
	// the answer: a type records the conformance against its own name unconditionally, while an extension
	// records it per CONFORMER and only where the `where` clause is satisfied. Reading it in one place is
	// what keeps `implements Iterable with (Element, Iter)` one grammar rather than two that agree by hand.
	//
	// An absent clause answers the SHARED EMPTY rather than a fresh list, so the whole corpus of plain
	// `extension X` and conformance-free `type X` allocates nothing — the `sharedEmptyWhereConstraints`
	// rule, and safe for the same reason: the array is never mutated in place, only replaced.
	function readImplementsList() returns InterfaceConformanceArray throws ParseError
		if not self.at(TokenKind.implements) 'noImplements'
			return sharedEmptyInterfaceConformances
		end 'noImplements'
		try self.consume(TokenKind.implements)

		var interfaces = InterfaceConformanceArray.create()
		interfaces.push(try self.parseOneConformance())
		while self.at(TokenKind.comma) 'moreInterfaces'
			try self.consume(TokenKind.comma)
			interfaces.push(try self.parseOneConformance())
		end 'moreInterfaces'

		return interfaces
	end 'readImplementsList'

	// One `I [with …]` entry of an `implements` list (R5) — the interface name and the arguments bound to
	// its `uses` names, which are only meaningful as a pair (`InterfaceConformance`).
	function parseOneConformance() returns InterfaceConformance throws ParseError
		let ifaceTok = try self.consume(TokenKind.identifier)
		if not self.at(TokenKind.with) 'bindsNothing'
			return InterfaceConformance.withoutBindings(ifaceTok.value)
		end 'bindsNothing'

		try self.consume(TokenKind.with)
		return InterfaceConformance.create(ifaceTok.value, withArgs: try self.parseConformanceWithArgs(ifaceTok.value, spelling: ConformanceArgSpelling.identity))
	end 'parseOneConformance'

	// ⭐ **THE `with <TypeArg>` / `with (<TypeArgs>)` ASSOCIATED-TYPE BINDING, IN BOTH SPELLINGS (R5).**
	// Every argument is READ as a type reference and RENDERED to the source string `checkConformance`
	// substitutes into a requirement's signature — the conformance's whole contribution.
	//
	// ⚠ **HOW MANY ARGUMENTS THE UNPARENTHESIZED FORM TAKES IS THE INTERFACE'S `uses` ARITY, and reading
	// exactly one was a wrong answer.** `implements Pair with Integer, Float` against `interface Pair uses
	// First, Second` left `, Float` to `parseTypeImplementsClause`'s comma loop, which pushed `Float` as a
	// second INTERFACE and produced a spurious `E3015 … implements unknown interface 'Float'` on a program
	// both reference compilers accept. Both fix it the same way and with the same loop shape — bootstrap
	// `ParseWithTypeArgs(GetAssociatedTypeCount(iface))` (`2-Parser.cs:2912-2940`), v1's `moreSingle` over
	// `lookupInterfaceUsesParamCount` (`Parser.maxon:2007-2018`) — so the arity is consulted here rather
	// than becoming a parser fix of its own.
	//
	// The arity is asked ONLY after a first argument is followed by a comma, so no program that parses
	// today pays the lookup at all.
	//
	// ⚠ **THE PARENTHESIZED ARM USED TO SKIP BALANCED TOKENS, WHICH MADE IT A TYPE POSITION THE E3062
	// USE CHECK COULD NOT SEE** (P1.9 review). `parseTypeReference` is where a written type name is
	// recorded as USED (`recordTypeNameUse`), so a file whose only mention of an alias was
	// `implements Container with (Score)` had that alias reported UNUSED — a legal program refused, and
	// refused in only ONE of the two spellings, since the single-argument arm already went through the
	// reference parser. Measured before that fix: `error E3062 … unused typealias: 'Score'` on a program
	// naming it, with the same program clean the moment the parentheses came off. The two arms are one
	// rule, so a use cannot be visible in one spelling of it and invisible in the other.
	//
	// It reads a LEAF reference per argument rather than reaching for `parseGenericArgNodes`: that
	// reader also VALIDATES what it reads (`checkGenericInstance` / `checkGenericArgType`), and a
	// conformance argument is checked whole-program by `checkConformance` instead, which is the only
	// place the interface it binds against is reachable.
	//
	// ⚖ **THE PARENTHESIZED ARM IS ALSO WHERE A SURPLUS ARGUMENT IS REFUSED (R6), AND ONLY THERE** —
	// see `checkParenthesizedConformanceArgs` for the rule and `ConformanceUsesArity` for the false
	// reject it must not commit. The asymmetry with the unparenthesized arm below is deliberate and it
	// is why the check lives HERE rather than in `ConformanceCheck`: whether the list was written in
	// parentheses is a fact only the token stream holds. `InterfaceConformance` carries a
	// `ByteArrayArray` and nothing else, so the two spellings are already indistinguishable one line
	// later — recording a flag on it purely so a later pass could re-derive what this function is
	// looking straight at would be plumbing a parse fact through the whole tier for no gain.
	//
	// ⚠⚠ **`spelling` IS WHAT THE TWO CALLERS DO NOT SHARE, AND IT IS NOT COSMETIC** — see
	// `ConformanceArgSpelling`. It reaches the tuple arm as well as the argument reader, because collapsing
	// `with (A, B)` into one interned tuple produces a name only the identity spelling can carry.
	function parseConformanceWithArgs(interfaceName ByteArray, spelling ConformanceArgSpelling) returns ByteArrayArray throws ParseError
		var args = ByteArrayArray.create()
		if self.at(TokenKind.leftParen) and spelling == ConformanceArgSpelling.identity and self.parenthesizedWithBindsOneTuple(interfaceName) 'oneTupleArgument'
			// ONE argument, read by the ordinary reference reader — `parseTypeReference` meets the `(` and
			// routes to `parseTupleTypeReference`, which is what mints and interns the tuple's layout. So the
			// binding this records is character-for-character the name `WithIterIterator.current`'s declared
			// `returns (Source, Element)` renders to, which is the whole point: `ConformanceCheck` compares
			// the two as strings.
			args.push(try self.readConformanceWithArg(spelling))
			return args
		end 'oneTupleArgument'

		if self.at(TokenKind.leftParen) 'parenthesized'
			// The `(` is the anchor for a surplus: it is the token that opens the list whose LENGTH is
			// the assertion being refused, and it is on the `implements` line the author must edit.
			let openTok = self.current()
			try self.consume(TokenKind.leftParen)
			while true 'eachArg'
				args.push(try self.readConformanceWithArg(spelling))
				if not self.at(TokenKind.comma) 'lastArg'
					break
				end 'lastArg'
				try self.consume(TokenKind.comma)
			end 'eachArg'
			try self.consume(TokenKind.rightParen)
			self.checkParenthesizedConformanceArgs(interfaceName, written: args.count(), openTok: openTok)
			return args
		end 'parenthesized'

		args.push(try self.readConformanceWithArg(spelling))
		if not self.at(TokenKind.comma) 'singleArg'
			return args
		end 'singleArg'

		let arity = self.interfaceUsesArity(interfaceName)
		while args.count() < arity and self.at(TokenKind.comma) 'moreArgs'
			try self.consume(TokenKind.comma)
			args.push(try self.readConformanceWithArg(spelling))
		end 'moreArgs'
		return args
	end 'parseConformanceWithArgs'

	// One conformance argument: read as a type reference (so it records the alias USE) and rendered to the
	// source string the substitution carries. Spelled once because both arms above read an argument the same
	// way, and a second spelling would be free to record the use in only one of them — which is exactly the
	// bug the parenthesized arm already had.
	//
	// It renders through the SHARED renderer and NOT through `renderInterfaceTypeName`, which is the one
	// difference between the two conformance-argument positions: a written `Self` here has already resolved
	// to the enclosing type's own `structRef` (`enclosingSelfType`), and the conforming type's NAME is
	// precisely what the binding must carry. `enclosingTypeParams` is the CONFORMING type's own `uses` list,
	// which is what makes `type Box uses T implements Holder with T` bind `Element := T`.
	//
	// ⚠ **THE READ IS ONE READ IN BOTH SPELLINGS, AND THAT IS THE POINT.** `parseTypeReference` runs either
	// way — it is what moves the cursor, records the alias USE (E3062) and interns a tuple — so the two
	// spellings differ only in which of two facts about the SAME argument is handed back. See
	// `ConformanceArgSpelling`.
	function readConformanceWithArg(spelling ConformanceArgSpelling) returns ByteArray throws ParseError
		// Taken before the reader moves, because that is the only moment the WRITTEN form is in hand.
		let firstTok = self.current()
		let start = self.pos
		let identity = renderDeclaredTypeName(try self.parseTypeReference(), declarationName: self.enclosingType, typeParamNames: self.enclosingTypeParams, typeNames: self.artifact.typeNames, signatures: self.signatures)

		if spelling == ConformanceArgSpelling.identity 'theComparableIdentity'
			return identity
		end 'theComparableIdentity'

		// ⚠ **A SINGLE IDENTIFIER IS THE ONLY ARGUMENT THAT HAS AN AUTHOR'S NAME, so it is the only one this
		// answers with.** `Self`, a dotted chain and a tuple are each more than the one token a substitution
		// could put back — for those the identity is not merely the better answer, it is the only spelling
		// that exists, and it is exactly what the per-file sweep produced for them before this split.
		if self.pos != (start + 1) as TokenIndex or firstTok.kind != TokenKind.identifier 'theAuthorWroteNoSingleName'
			return identity
		end 'theAuthorWroteNoSingleName'

		return firstTok.value
	end 'readConformanceWithArg'

	// ⭐⭐ **`with (A, B)` AGAINST A ONE-ASSOCIATED-TYPE INTERFACE IS ONE TUPLE ARGUMENT, NOT TWO BINDINGS
	// (W43), AND THAT IS BOTH REFERENCES' RULE.** The bootstrap discriminates on the arity outright —
	// *"when expecting a single type arg, let ParseTypeRef handle it — (A, B) is a tuple type, not two
	// separate type arguments"* (`2-Parser.cs:3129-3137`) — and v1 records `parenForm` on each `Conformance`
	// so `TypeResolution` can *"collapse a parenthesized multi-arg list against a single-`uses` interface into
	// one `__TupleN` generic-instance"* (`Parser.maxon:1944-1949`). shv2's R6 settled on a pure LIST reading
	// with `((A, B))` as the tuple spelling, and R6's own spec text named the day this would collide:
	// *"It is also the spelling `stdlib/helpers/itertools/withIterator.maxon` needs the day it is loadable"*.
	// That file writes `implements Iterator with (Source, Element)` against a one-`uses` `Iterator` and
	// declares `current() returns (Source, Element)`, so NO list reading can make it conform — the LIST
	// reading is not a stricter shv2 rule here, it is a rejection of a program the corpus writes and both
	// references compile. The corpus is the reference, so the arity discrimination is.
	//
	// ⚠ **A COMMA IS REQUIRED, WHICH IS WHAT KEEPS THE TWO SPELLINGS R6 PINNED ALIVE.** `with (T)` holds no
	// top-level comma and stays ONE ordinary binding — `parseTupleTypeReference` would refuse it as a
	// one-element tuple, which is exactly the rejection the bootstrap gives that spelling (`E2003`) and which
	// shv2 deliberately does not. `with ((A, B))` holds its comma one level DOWN, so it too stays one
	// binding, whose single item is the tuple. Only `with (A, B)` moves, and only at arity one.
	//
	// ⚠ **IT ANSWERS `false` FOR THE WHOLE DECLARATION SWEEP, BECAUSE THE ARITY IS NOT KNOWN THERE** —
	// `Queries.foldInterfaceDeclarations` runs after the last file is folded, so `conformanceUsesArity` reads
	// `unresolvable` for every interface while the sweep is walking. The sweep therefore records the ITEM
	// LIST where the real parse records one tuple, and the two disagreeing is contained rather than tolerated:
	// `conformerAssociatedBindings` refuses to pair a bindings list against an associated-type list of a
	// different LENGTH, so the consequence is a conditional extension WITHHELD from that conformer and a body
	// parsed with no substitution — `readOptionalImplementsClause`'s own standard, *"bounded, and a missing
	// extension, never a wrong one"*. It cannot be fixed by asking earlier: the binding a tuple carries is the
	// INTERNED tuple layout's name, whose elements are canonicalized through `mangleTypeArg` (a type
	// parameter's is a W14 digest), so it cannot be reconstructed later from the argument SPELLINGS.
	function parenthesizedWithBindsOneTuple(interfaceName ByteArray) returns bool
		match self.conformanceUsesArity(interfaceName) 'arity'
			declared(count) then return count == SingleAssociatedType and self.parenGroupHoldsTopLevelComma(self.pos)
			unresolvable then return false
		end 'arity'
	end 'parenthesizedWithBindsOneTuple'

	// Does the balanced `( … )` opening at `index` hold a comma at ITS OWN level? Nested groups are stepped
	// over through `matchingRightParenOf` — the one balanced-extent door — rather than by a second depth
	// counter, so "which `)` closes this `(`" has one answer in this file. An UNBALANCED group answers false
	// and leaves the real parse to report it with a position, exactly as `skipBalancedParens` does.
	function parenGroupHoldsTopLevelComma(index TokenIndex) returns bool
		let closeIndex = self.matchingRightParenOf(index)
		if self.kindAt(closeIndex) != TokenKind.rightParen 'unbalanced'
			return false
		end 'unbalanced'

		var i = (index + 1) as TokenIndex
		while i < closeIndex 'scan'
			if self.kindAt(i) == TokenKind.comma 'topLevelComma'
				return true
			end 'topLevelComma'
			if self.kindAt(i) == TokenKind.leftParen 'nestedGroup'
				i = self.matchingRightParenOf(i) + 1
				continue
			end 'nestedGroup'
			i = i + 1
		end 'scan'
		return false
	end 'parenGroupHoldsTopLevelComma'

	// ⚖ **A PARENTHESIZED `with (…)` LIST MAY NOT BE LONGER THAN THE INTERFACE'S `uses` ARITY (R6).**
	// Before this, `implements One with (Integer, Float)` against `interface One uses A` bound
	// `A := Integer`, dropped `Float` and compiled clean (measured, exit 42) — a typo nothing reported.
	//
	// ⚖ **THE UNPARENTHESIZED SPELLING KEEPS IGNORING ITS SURPLUS, AND THAT IS THE RULE RATHER THAN AN
	// EXEMPTION FROM IT.** The two spellings are not the same claim. Parentheses make the list explicit,
	// so its LENGTH is something the author ASSERTED and can be wrong about; without them the length is
	// decided by the interface's own arity and a trailing comma legitimately belongs to the outer
	// `implements` list — which is exactly why both references consume precisely `arity` items there
	// (bootstrap `ParseWithTypeArgs(GetAssociatedTypeCount(iface))`, v1's `moreSingle`) and why
	// `associated-types.md`'s `surplus-conformance-argument-is-ignored` pins that half. Refusing here
	// therefore diverges from nothing the unparenthesized rule pinned.
	//
	// ⚠ **A DEFICIT IS NOT THIS DIAGNOSTIC AND MUST NOT BECOME ONE.** Too FEW arguments is already
	// reported whole-program, by NAME rather than by count — `ConformanceCheck.checkOneInterfaceConformance`
	// says which associated type is left unbound (E3016), which is the sentence the author can act on in
	// one edit. Adding a count-shaped complaint beside it would be two wordings for one mistake.
	//
	// ⚠ **AND IT DOES NOT FIRE ON AN INTERFACE THAT RESOLVES TO NOTHING.** A name no file declares has no
	// arity to be surplus OF, so the `unresolvable` arm is silent: the program's real error is the
	// whole-program `E3015 … implements unknown interface`, which names the fault precisely, and an arity
	// sentence about an interface the compiler never found would blame the wrong thing. That case is carried
	// by `ConformanceUsesArity` rather than by the count-shaped default the unparenthesized arm takes, which
	// is the whole reason the two arms do not share one number.
	//
	// ⚠ **IT RUNS ONLY ON THE FAR SIDE OF THE DECLARATION FOLD**, the same gate `checkGenericInstance`
	// and `requireFieldDefaultType` sit behind: during the sweep this index is still being BUILT, so an
	// interface declared in a not-yet-swept file reads as unresolvable, and a diagnostic built there is
	// allocation spent on a verdict the throwaway artifact discards.
	function checkParenthesizedConformanceArgs(interfaceName ByteArray, written ElementCount, openTok Token)
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		match self.conformanceUsesArity(interfaceName) 'arity'
			declared(count) then self.checkConformanceArgsAgainstArity(interfaceName, declared: count, written: written, openTok: openTok)
			unresolvable then break 'arity'
		end 'arity'
	end 'checkParenthesizedConformanceArgs'

	// The comparison and the sentence, once. It names BOTH counts because a reader fixing this needs to
	// know which one to change, and the interface, because the arity is the interface's fact and not the
	// conformance's — the `uses` clause the author has to look at may be in another file entirely.
	function checkConformanceArgsAgainstArity(interfaceName ByteArray, declared ElementCount, written ElementCount, openTok Token)
		if written <= declared 'withinArity'
			return
		end 'withinArity'

		self.recordArtifactDiagnostic(ErrorCode.conformanceWithArgSurplus, message: "interface '{String.from(interfaceName)}' declares {declared} associated type(s), but this parenthesized 'with' clause binds {written}", range: SourceRange.ofToken(openTok))
	end 'checkConformanceArgsAgainstArity'

	// ⭐ **THE ONE PLACE THE NUMBER COMES FROM (R6)** — how many associated types conforming to
	// `interfaceName` binds, off the ONE interface-lookup rule (`IrInterface.lookupInterface`, asked of this
	// phase's store — `signatures.interfaceMap()`). Its two
	// readers ask the same question and need different things from the miss, so the miss is a CASE and
	// not a default: see `ConformanceUsesArity` for why folding them into one count is precisely the
	// shape that hides a false reject.
	//
	// ⚠ **IT COUNTS THE INTERFACE'S OWN `uses` NAMES AND NOT ITS `extends`-INHERITED ONES — a SCOPE
	// statement, and no longer an incrementality one (R10c).** It used to be both: the count RIDES the
	// signature index's hash (`recordInterfaceDeclaration`), which keys every parse memo, and
	// `extendsInterfaces` did not ride it — so walking the chain here would have made a parse's answer
	// depend on an unhashed fact, and adding `extends Base` to an interface would change what another
	// file's conformance is told while that file never re-parsed. **`extendsInterfaces` rides the hash
	// now** (R10c needed it for the witness slot list), so that objection is discharged and what remains
	// is only that shv2 does not inherit associated-type BINDINGS at all — see below. Widening the count
	// without also inheriting the binding would accept an argument nothing then substitutes.
	//
	// The consequence today is bounded and is a MESSAGE change, never an accept becoming a reject:
	// `interface Sub extends Base` (where `Base uses Element`) leaves `Sub` with an empty own list, so
	// `implements Sub with (Integer)` is refused here — a program shv2 ALREADY rejects, with E3016's
	// wrong-signature sentence, because shv2 does not inherit the binding either
	// (`ConformanceCheck.checkOneInterfaceConformance`). The day inherited bindings land, this count and
	// that hash move together.
	function conformanceUsesArity(interfaceName ByteArray) returns ConformanceUsesArity
		match lookupInterface(self.signatures.interfaceMap(), name: interfaceName) 'lookup'
			found(iface) then return ConformanceUsesArity.declared(iface.associatedTypeNames.count())
			notFound then return ConformanceUsesArity.unresolvable
		end 'lookup'
	end 'conformanceUsesArity'

	// ⭐ **HOW MANY ARGUMENTS AN UNPARENTHESIZED `with` CLAUSE AFTER `interfaceName` TAKES (R5)** — the count of
	// that interface's `uses` names, off the ONE arity door (`conformanceUsesArity`, which asks the ONE
	// parse-time interface door). It is not a separate lookup and after R8 it is not a separate STORE either:
	// the arity IS `associatedTypeNames.count()` on the declaration that door hands back, so the number cannot
	// disagree with the interface a witness dispatch resolves under the same name — nor, after R6, with the
	// count the parenthesized arm refuses a surplus against.
	//
	// ⭐ **WHOLE-PROGRAM, AND NOT THIS FILE'S `artifact.interfaces` (R7).** That array is filled by
	// `recordInterface` as the linear parse REACHES each declaration, so it answered for an interface declared
	// above the conformance and for no other — an interface written lower in the same file, or in any other
	// file, silently took the default of 1 and `implements Duo with Score, Weight` truncated after `Score`.
	// MEASURED before R7, in both shapes: `E3016 … type 'Both' does not define required associated type 'Q'
	// from interface 'Duo'` AND `E3015 … type 'Both' implements unknown interface 'Weight'`, on a program the
	// bootstrap compiles and runs (exit 42) — the whole-program conformance check reporting the CONSEQUENCE of
	// a truncated parse, where the parse itself could not see the cause. `specs-shv2/associated-types.md`
	// carries all four cases.
	//
	// ⚠ **AN INTERFACE NO FILE DECLARES DEFAULTS TO ONE, AND THAT DEFAULT IS COPIED DELIBERATELY** —
	// bootstrap `GetAssociatedTypeCount` (`2-Parser.cs:2939`) and v1 `lookupInterfaceUsesParamCount`
	// (`Parser.maxon:1959`) both do it, rather than refusing a name they cannot resolve. That set is the TYPOS
	// plus the interfaces `foldInterfaceDeclarations` COULD NOT READ, and nothing else: it visits every
	// `interface` in every source path of the program, stdlib included, before any file is parsed, and it is
	// TOLERANT — a malformed declaration records nothing, which is the one non-typo way to land here and is a
	// program the real parse rejects on its own line anyway. Refusing instead would turn a misspelled interface
	// into a parse error where the whole-program `E3015 … implements unknown interface` already names it
	// precisely.
	function interfaceUsesArity(interfaceName ByteArray) returns ElementCount
		match self.conformanceUsesArity(interfaceName) 'arity'
			declared(count) then return count
			unresolvable then return UnresolvableInterfaceUsesArity
		end 'arity'
	end 'interfaceUsesArity'

	// Parse an `enum`/`union` declaration (P1.1b wave B):
	//
	//     enum Color
	//         red
	//         green = 5
	//         blue
	//     end 'Color'
	//
	// ⭐ **THE DECLARATION EMITS NOTHING** — like a `type`, its whole effect is the `EnumLayout`
	// recorded below, which `Color.red` reads a case's TAG out of and an enum `match` reads the case
	// SET out of. `union` and `enum` share this routine entirely: only the diagnostic wording later
	// differs, carried by `layout.isUnion`.
	//
	// A CASE MAY CARRY A PAYLOAD (`value(n Integer)`, P1.3 slice 1 — see `readEnumCaseInto`), and its raw
	// value may be an int, a float, a string or a character, in the explicit (`North = 'n'`) and the implicit
	// (`"North"` standing where the name goes) spellings alike. A STRUCT or FUNCTION backing is what still
	// names a later rung.
	//
	// ⭐ **A MEMBER MAY BE AN INSTANCE METHOD (D1)**, and it is built by the very same `parseFunction` a
	// struct's method is: the receiver is `__self` at parameter 0, the method is declared under
	// `Direction.isNorth` (`declaredMethodName`), and a call is an ordinary direct call with the receiver
	// prepended. What differs from a `type` is only the RECEIVER'S TYPE — `named`, not `structRef`
	// (`enclosingSelfType`) — and that there are no FIELDS, hence no self-field aliases. A `static
	// function` stays refused (`parseEnumMethod`).
	function parseEnumDeclaration(isUnion bool, visibility Visibility) throws ParseError
		try self.consume(TokenKind.union if isUnion else TokenKind.enum)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try self.requireTypeNameNotCompilerOwned(nameTok, declares: DeclaredTypeMeaning.nominalIdentity)
		let conformsTo = (try self.readOptionalImplementsClause()).names
		self.enterTypeScope(nameTok.value, isEnum: true)

		var layout = EnumLayout.create(nameTok.value, isUnion: isUnion, conformsTo: conformsTo, visibility: visibility, declFilePath: self.filePath, backing: EnumBacking.unresolved)
		var counter = EnumTagCounter.create()

		// The cursor sits at the enum body start; remember it so the lazy sibling-receiver walk (#65) can
		// begin here once a method body's bare call needs it — exactly as `parseTypeDeclaration` does. It is
		// not optional bookkeeping: left at the PREVIOUS declaration's body, a bare `isStop()` inside an enum
		// method would resolve against another type's method list.
		self.enclosingTypeBodyStart = self.pos

		while true 'members'
			self.skipNewlines()
			if self.enumBodyEndsAt(self.pos) 'closes'
				break
			end 'closes'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'

			// A method — `[export] function <name>(`. `function` ALONE is a legal CASE name, so only
			// `atEnumMethodStart`'s full shape is a method; everything else is a case.
			if self.atEnumMethodStart() 'method'
				try self.parseEnumMethod(layout)
				continue
			end 'method'

			// The member's first token is the case's NAME token, which is where the reference anchors every
			// per-case diagnostic. Read before the case rather than after, because reading it moves the cursor.
			let caseTok = self.current()
			try self.readEnumCaseInto(layout, counter: counter)
			try self.checkFunctionBackedCase(layout, caseTok: caseTok)
			try self.checkStructBackedCase(layout, caseTok: caseTok)
		end 'members'

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.recordEnumType(layout)
		self.closeTypeParamScope()
	end 'parseEnumDeclaration'

	// ⛔ **ONE MEMBER METHOD OF AN `enum`/`union`, AND THE ONE THING IT REFUSES (D1).** The cursor sits on
	// the optional `export`. An INSTANCE method goes straight to the shared `parseFunction`, which is the
	// whole implementation: a method IS a function, plus a receiver at parameter 0.
	//
	// ⭐ **A `static function` STAYS REFUSED, AND SHV2 IS RIGHT WHERE THE ORACLE IS NOT.** Measured on the
	// bootstrap: an `enum` static is a parse error there, while a `union` static is ACCEPTED and then
	// misread — the modifier is silently dropped, so the call dies at `E3036 missing argument for parameter
	// 'self'`, blaming the call site for a declaration the compiler mis-parsed. A positioned refusal at the
	// declaration is strictly better, and it costs nothing: no `union`/`enum` in `stdlib/` declares one.
	//
	// It is not `parseTypeMember` widened, because an enum body's grammar is genuinely a different one: it
	// has no FIELDS and no nested `typealias` (the two other members that routine reads), and `static` is
	// an error here rather than the receiver switch it is there.
	function parseEnumMethod(layout EnumLayout) throws ParseError
		let visibility = try self.consumeOptionalVisibility()

		if self.at(TokenKind.static) 'staticMethod'
			let tok = self.current()
			throw ParseError.unsupported("a `static function` on `{layout.kindWord()} {String.from(layout.name)}` (an INSTANCE method is supported — a static one has no receiver to name the enum through, and no `enum`/`union` in the corpus declares one)", line: tok.line, column: tok.column)
		end 'staticMethod'

		try self.parseFunction(visibility, takesReceiver: true)
	end 'parseEnumMethod'

	// Is the token at `index` the `end` that CLOSES an enum/union body — as opposed to a case NAMED `end`?
	//
	// ⚠ **`end` IS A LEGAL CASE NAME** (`keyword-as-case-name.md` declares one), so the terminator
	// cannot be recognized by the `end` keyword alone. The rule, mirrored byte-for-byte from the
	// bootstrap (`IsEndOfBlock`, 2-Parser.cs:3173): a terminating `end` is followed by the block
	// LABEL (a character literal) or by end-of-file; an `end` followed by anything else — a newline,
	// another case — is the case named `end`. Every corpus enum closes with a labelled `end 'Name'`,
	// which this recognizes; a bare unlabelled `end` mid-body would be read as a case, exactly as the
	// bootstrap reads it.
	//
	// ⚠ It takes an INDEX rather than reading the cursor because THREE walks ask it and only two of them
	// are cursor-driven: the real parse and the tolerant sweep sit ON the token, while the sibling-receiver
	// scan (`ensureSiblingReceivers`) walks an index of its own. Written twice, the third walk would read a
	// case named `end` as the body's terminator — measured, before this took an index: a bare sibling call
	// to a method declared after such a case reported `E3004 call to undefined function`.
	function enumBodyEndsAt(index TokenIndex) returns bool
		if self.kindAt(index) != TokenKind.end 'notEnd'
			return false
		end 'notEnd'
		let next = self.kindAt(index + 1)
		return next == TokenKind.charLiteral or next == TokenKind.eof
	end 'enumBodyEndsAt'

	// Does the cursor open a METHOD inside an enum/union body — `[export] [static] function <name>(`?
	//
	// ⚠ **`function` IS ALSO A LEGAL CASE NAME** (`keyword-as-case-name.md` declares one), so a bare
	// `function` keyword does NOT open a method: a method is `function` followed by a NAME and a `(`
	// — the shared `functionDeclarationAt`, which the declaration sweep reads for the same reason.
	// Mirrors the bootstrap's `IsEnumMethodStart` (2-Parser.cs:3155). All this adds is the modifiers an
	// enum body may carry before the keyword, and it spans BOTH of them in order (`parseTypeMember`
	// accepts `export static` on a struct, so `export static` inside an enum must reach the refusal in
	// `parseEnumMethod` rather than fall through to `readEnumCaseInto` and be blamed as a malformed case).
	//
	// ⚠ It is the shape gate for BOTH readers of an enum body — the real parse and the tolerant sweep — so
	// the two cannot disagree about which members are cases, which is what a case's TAG depends on.
	function atEnumMethodStart() returns bool
		return self.functionDeclarationAt(self.enumMethodKeywordIndex(self.pos))
	end 'atEnumMethodStart'

	// The index the enum member starting at `index` declares its `function` keyword at, having stepped over
	// the optional visibility and `static` modifiers. THE one spelling of that modifier list, read by the
	// peek-only predicate above AND by the sweep's cursor step (`recordScannedEnum`) — taught to one and not
	// the other, the sweep would count a modifier token as the method's block opener and mis-close the enum.
	//
	// ⛔ **IT SPELLED `TokenKind.export` DIRECTLY AND SO NEVER STEPPED OVER `module`**, which is the defect
	// the "one spelling" sentence above exists to prevent — the paragraph was right about the risk and the
	// code was a second answer anyway. `module function` on an enum was already reachable; `public function`
	// would have been the second body to trip it. It asks `pastVisibilityModifier` now, so the modifier SET
	// is the parser's one copy.
	function enumMethodKeywordIndex(index TokenIndex) returns TokenIndex
		var p = self.pastVisibilityModifier(index)
		if self.kindAt(p) == TokenKind.static 'static'
			p = p + 1
		end 'static'
		return p
	end 'enumMethodKeywordIndex'

	// Read ONE enum/union case into `layout`, threading the auto-increment tag through `counter` and
	// fixing the layout's BACKING. Reports the three declaration diagnostics: E3030 (duplicate case
	// name), E3031 (duplicate raw value), E3032 (raw value type mismatch). SHARED by the real parse and
	// the tolerant sweep (`recordScannedEnum`), which wraps it in `otherwise` — so the two cannot drift
	// on how a tag is assigned OR on how it is to be READ, the two facts they MUST agree on (the sweep's
	// layout is what the parser reads both from at a use site).
	function readEnumCaseInto(layout EnumLayout, counter EnumTagCounter) throws ParseError
		let nameTok = try self.readEnumCaseNameToken()
		let caseName = try self.enumCaseNameOf(nameTok)

		// A `__`-prefixed case is reserved. Checked before the duplicate/backing rules so the
		// reservation is reported at the name, and — as with the field reader — the tolerant sweep
		// (`recordScannedEnum`) swallows the throw and leaves the diagnostic to the real parse.
		//
		// ⚠ It is asked about `caseName` — the DECODED name, the one this case is actually declared under
		// everywhere else in this function — and not about the token's text. This is THE site that makes those
		// two different things (`"\x5f\x5fx"` declares `__x`); see `requireUnreservedName`.
		// ⚠ `bindsInto` is stated HERE and nowhere else: a case name is reachable only as `Marker.self`, so it
		// is the one declaration in the language that cannot shadow the implicit receiver. See
		// `DeclaredNameNamespace` — the default is the refusing side, so a new binding site added tomorrow
		// gets the reservation without having to remember it.
		try self.requireUnreservedName(nameTok, declaredName: caseName, bindsInto: DeclaredNameNamespace.qualifiedByItsType)

		// E3030 — checked at the second declaration, as the bootstrap positions it.
		if layout.hasCase(caseName) 'duplicateCase'
			throw ParseError.enumDuplicateCase(String.from(caseName), line: nameTok.line, column: nameTok.column)
		end 'duplicateCase'

		// ⭐ **AN IMPLICITLY BACKED CASE — the literal stood where the NAME goes, so it is both.** `"North"`
		// declares the case `North` with the raw value `"North"`, and `'N'` declares `N` with the raw value
		// `'N'`. Asked before everything below because such a case has no payload list to read (a literal is
		// not a callable head) and never writes an `=`: its raw value is already in hand, and an `=` after it
		// would be a second raw value for one case.
		if tokenKindIsEnumLiteralBacking(nameTok.kind) 'implicitBacking'
			try self.appendLiteralBackedEnumCase(layout, caseName: caseName, literalTok: nameTok, counter: counter, caseTok: nameTok, payloads: PayloadFieldArray.create())
			return
		end 'implicitBacking'

		// ⭐⭐ **A CASE'S PAYLOAD LIST AND ITS RAW VALUE ARE INDEPENDENT, AND THAT IS WHY THIS IS READ HERE
		// RATHER THAN IN AN ARM THAT RETURNS.** `add(dest ID, src ID) = OpMeta.create(1)` writes BOTH — a
		// runtime payload and compile-time metadata (`/specs/union-struct-backing.md`) — and for one edit a
		// payload list ENDED the case, so every one of those died at the `=` as *"Expected 'an enum case name'"*.
		// Both references read it in exactly this position and say so: v1's `parseCaseBacking` documents its
		// entry as *"right after the case name (enum) or after the optional payload list (union), i.e. at the
		// optional `=`"*, and the bootstrap COMPILES the full grammar there (MEASURED: `add(dest ID, src ID) =
		// 5` beside `nop = 7` prints `op.rawValue` 5 and `op.ordinal` 0).
		//
		// ⇒ so every append site below takes the payload list, and no arm may re-mint an empty one: which
		// raw value a case wrote cannot change which payload slots it declared.
		//
		// The managed/float REJECTION is NOT in the reader — it would `throw` in the tolerant sweep
		// (`recordScannedEnum`'s `otherwise break`), truncating the layout and misassigning every later case's
		// tag. The construct and extract sites resolve each field type and reject the ones P1.3 slice 1 cannot
		// lower, exactly as a struct's `structRef` field is refused at its USE site (`requireStructBase`).
		let payloads = try self.readOptionalPayloadFields()

		if not self.at(TokenKind.equals) 'noRawValue'
			// A bare or payload-only case takes the auto-increment tag and requires integer backing.
			try self.appendAutoTaggedEnumCase(layout, caseName: caseName, counter: counter, caseTok: nameTok, payloads: payloads)
			return
		end 'noRawValue'

		try self.consume(TokenKind.equals)

		// A FLOAT raw value, positive or NEGATED (`= 1.1`, `= -2.2`): its tag is the IEEE-754 BIT PATTERN
		// (matched by an i64 compare, exactly as an int tag is), and its display is the float's source
		// text. A leading `-` folds into the sign bit via `negatedFloatBits` — the same spelling
		// `parseNegatedNumericLiteral` uses in expression position — because a negated float is still a
		// FLOAT, not the int path `readEnumIntRawValue` would send it down (where the float literal after
		// the minus is a type mismatch, not the negation the source wrote).
		let floatNegated = self.at(TokenKind.minus) and self.peekKind() == TokenKind.floatLiteral
		if floatNegated or self.at(TokenKind.floatLiteral) 'floatValue'
			if floatNegated 'consumeMinus'
				try self.consume(TokenKind.minus)
			end 'consumeMinus'
			let floatTok = try self.consume(TokenKind.floatLiteral)
			let magnitude = try self.floatLiteralBits(floatTok)
			let bits = negatedFloatBits(magnitude) if floatNegated else magnitude
			let rawDisplay = "-{String.from(floatTok.value)}" if floatNegated else String.from(floatTok.value)
			try self.requireEnumBacking(layout, kind: EnumBacking.float, structName: EmptySourceText, caseTok: nameTok)
			try self.appendEnumCase(layout, caseName: caseName, tag: bits, rawValue: rawDisplay, declaresRawValue: true, caseTok: nameTok, payloads: payloads, backingFields: sharedEmptyEnumBackingFields)
			return
		end 'floatValue'

		// An EXPLICIT string or character raw value (`json = "application/json"`, `North = 'n'`) — the same
		// two backings the implicit form above fixes, and the same body reads them.
		if tokenKindIsEnumLiteralBacking(self.current().kind) 'literalRawValue'
			let literalTok = self.current()
			self.advance()
			try self.appendLiteralBackedEnumCase(layout, caseName: caseName, literalTok: literalTok, counter: counter, caseTok: nameTok, payloads: payloads)
			return
		end 'literalRawValue'

		// A STRUCT raw value (`add = Meta{value: 1}`, `add = Meta.create(1)`) — the case is backed by a
		// compile-time constant struct, and `op.rawValue.value` selects one of its fields. Asked BEFORE the
		// function arm because both open with a bare identifier; the two lookaheads are complementary, so the
		// order is a reading convenience rather than a precedence.
		if self.atEnumStructRawValue() 'structValue'
			try self.appendStructBackedEnumCase(layout, caseName: caseName, counter: counter, caseTok: nameTok, payloads: payloads)
			return
		end 'structValue'

		// A FUNCTION raw value (`doubleOp = doubleFn`) — the case is backed by a reference to a declared
		// function, and `Op.doubleOp.rawValue` hands that function back as a callable value.
		if self.atEnumFunctionRawValue() 'functionValue'
			try self.appendFunctionBackedEnumCase(layout, caseName: caseName, counter: counter, caseTok: nameTok, payloads: payloads)
			return
		end 'functionValue'

		// An INTEGER raw value (possibly negated). It resets the auto-increment counter to value + 1,
		// which is what makes `enum E { a = 5  b }` give `b` the tag 6.
		let intValue = try self.readEnumIntRawValue()
		try self.requireEnumBacking(layout, kind: EnumBacking.integer, structName: EmptySourceText, caseTok: nameTok)
		counter.nextTag = intValue + 1
		try self.appendEnumCase(layout, caseName: caseName, tag: intValue, rawValue: "{intValue}", declaresRawValue: true, caseTok: nameTok, payloads: payloads, backingFields: sharedEmptyEnumBackingFields)
	end 'readEnumCaseInto'

	// The payload list a case opens with (`circle(radius Real)`), or an empty one where it writes none.
	// Written as its own reader because "does this case declare payload slots" is now a question ASKED
	// rather than a route TAKEN — see `readEnumCaseInto`, where the answer no longer decides whether a raw
	// value may follow.
	function readOptionalPayloadFields() returns PayloadFieldArray throws ParseError
		if not self.at(TokenKind.leftParen) 'noPayloadList'
			return PayloadFieldArray.create()
		end 'noPayloadList'

		return try self.readPayloadFieldsInto()
	end 'readOptionalPayloadFields'

	// The auto-increment half of a case that writes no raw value of its own — a bare case (`green`) and a
	// payload case (`circle(r Real)`), which differ only in the payload list they carry. ONE body, because
	// the two arms had one between them: the tag rule and the backing it fixes written twice is a tag rule
	// free to drift, and a case's tag is the fact every `Color.red` and every `match` arm reads back.
	function appendAutoTaggedEnumCase(layout EnumLayout, caseName ByteArray, counter EnumTagCounter, caseTok Token, payloads PayloadFieldArray) throws ParseError
		try self.requireEnumBacking(layout, kind: EnumBacking.integer, structName: EmptySourceText, caseTok: caseTok)
		let tag = self.nextAutoEnumTag(counter)
		try self.appendEnumCase(layout, caseName: caseName, tag: tag, rawValue: "{tag}", declaresRawValue: false, caseTok: caseTok, payloads: payloads, backingFields: sharedEmptyEnumBackingFields)
	end 'appendAutoTaggedEnumCase'

	// Take the counter's next tag and step it — the tag every case gets that does not write a NUMBER of its
	// own: a bare case, a payload case, and a STRING-backed one, whose raw value is not a number and so
	// cannot be its tag.
	function nextAutoEnumTag(counter EnumTagCounter) returns ParsedInt
		let tag = counter.nextTag
		counter.nextTag = counter.nextTag + 1
		return tag
	end 'nextAutoEnumTag'

	// ⭐⭐ **A STRING- OR CHARACTER-BACKED CASE, IN EITHER OF THE TWO SPELLINGS THAT REACH IT** — the literal
	// standing in the NAME position (`"North"`, `'N'`) or written after an `=` (`json = "application/json"`,
	// `North = 'n'`). One body, because the two differ only in WHERE the literal was written: the backing it
	// fixes, the tag it takes and the raw value it records are identical, and `/specs/enum-full.md` declares
	// both spellings of both backings.
	//
	// ⭐ **THE TWO BACKINGS TAG DIFFERENTLY, AND THAT IS THE WHOLE OF WHAT SEPARATES THEM.** A character raw
	// value IS a number — its Unicode codepoint — so the codepoint IS the tag, and every tag-keyed rule
	// (E3031, `.ordinal`, a `match`'s i64 compare) reads it unchanged. A STRING raw value is not a number, so
	// the case takes the ordinary auto-increment tag and its bytes ride `EnumLayout.caseRawValues`, which is
	// what E3031 compares for that backing.
	//
	// ⚠ **THE CHARACTER ARM DELIBERATELY DOES NOT TOUCH `counter`, UNLIKE THE INT RAW-VALUE ARM.** An int
	// raw value resets it because a BARE case may legally follow one (`a = 5  b` gives `b` the tag 6); no
	// case of any kind may follow a character one without agreeing on the backing, and every kind that could
	// continue the count — bare, payload, int — fixes `integer` and so raises E3032 at
	// `requireEnumBacking` first. A reset here would therefore be a store nothing can read, and the bootstrap
	// does not write one either (its char arms are a plain `ordinal++`, `2-Parser.cs:4324`, `:4418`).
	function appendLiteralBackedEnumCase(layout EnumLayout, caseName ByteArray, literalTok Token, counter EnumTagCounter, caseTok Token, payloads PayloadFieldArray) throws ParseError
		if literalTok.kind == TokenKind.charLiteral 'characterBacking'
			let codepoint = try self.enumCharacterRawValue(literalTok)
			try self.requireEnumBacking(layout, kind: EnumBacking.character, structName: EmptySourceText, caseTok: caseTok)
			try self.appendEnumCase(layout, caseName: caseName, tag: codepoint, rawValue: String.from(try self.charLiteralBytes(literalTok)), declaresRawValue: true, caseTok: caseTok, payloads: payloads, backingFields: sharedEmptyEnumBackingFields)
			return
		end 'characterBacking'

		let bytes = try self.decodedStringLiteralBytes(literalTok)
		try self.requireEnumBacking(layout, kind: EnumBacking.string, structName: EmptySourceText, caseTok: caseTok)
		let tag = self.nextAutoEnumTag(counter)
		try self.appendEnumCase(layout, caseName: caseName, tag: tag, rawValue: String.from(bytes), declaresRawValue: true, caseTok: caseTok, payloads: payloads, backingFields: sharedEmptyEnumBackingFields)
	end 'appendLiteralBackedEnumCase'

	// ⭐ **IS THE CURSOR ON A FUNCTION RAW VALUE — `= doubleFn` — RATHER THAN ON A STRUCT ONE?** Both are
	// written as a bare identifier after the `=`, and the ONE token behind it is what separates them: a
	// struct backing continues into a construction (`Point{…}`) or a static call (`Point.create(…)`), a
	// function reference stops at the name. This is the same one-token lookahead the reference disambiguates
	// them with (`maxon-selfhosted/Compiler/Parser.maxon:5484-5495`), so the two readers partition the
	// identifier-headed raw values between them and neither can claim the other's.
	//
	// ⚠ **STATED POSITIVELY — WHAT MAY FOLLOW — AND NOT AS A BLACKLIST OF `{` AND `.`.** A function raw value
	// IS the whole raw value, so the next token must end the case: the newline before the next member, or the
	// `end` that closes the body. Written as "anything but `{` or `.`", `= someFn(3)` was admitted, the name
	// taken as the backing, and the leftover `(3)` surfaced from the members loop as a malformed CASE NAME —
	// a diagnostic at the wrong token saying nothing about raw values. A blacklist also has to be re-audited
	// by every construct that ever puts a new token after a name; this cannot be widened wrongly.
	function atEnumFunctionRawValue() returns bool
		if not self.at(TokenKind.identifier) 'notAName'
			return false
		end 'notAName'

		return self.statementEndsAt(self.pos + 1)
	end 'atEnumFunctionRawValue'

	// ⭐⭐ **A FUNCTION-BACKED CASE (`doubleOp = doubleFn`) — the DECLARATION half, which records a NAME and
	// nothing else.** The address is not knowable here and deliberately is not looked for: the function may
	// be declared later in the file or in another file entirely (`function-backing.forward-reference`,
	// `.cross-file`), and this same reader runs inside the tolerant declaration SWEEP, which has no
	// whole-program index to ask. So the case carries the function's NAME on `caseRawValues` and the
	// callable value is materialized per read (`Parser.emitEnumCaseConstant`), which is also what makes the
	// binding whole-program rather than file-ordered.
	//
	// ⭐ **THE TAG IS THE AUTO-INCREMENT DECLARATION INDEX**, for the STRING backing's reason exactly: a
	// function reference is not a number, so it cannot be one. E3031 then compares the recorded NAMES
	// (`EnumLayout.rawValueCollidesAt` past `tagCarriesRawValue`), which is what refuses `a = f  b = f` —
	// the reference keys its duplicate check on the same column.
	function appendFunctionBackedEnumCase(layout EnumLayout, caseName ByteArray, counter EnumTagCounter, caseTok Token, payloads PayloadFieldArray) throws ParseError
		let functionTok = try self.consume(TokenKind.identifier)
		try self.requireEnumBacking(layout, kind: EnumBacking.functionRef, structName: EmptySourceText, caseTok: caseTok)
		let tag = self.nextAutoEnumTag(counter)
		try self.appendEnumCase(layout, caseName: caseName, tag: tag, rawValue: String.from(functionTok.value), declaresRawValue: true, caseTok: caseTok, payloads: payloads, backingFields: sharedEmptyEnumBackingFields)
	end 'appendFunctionBackedEnumCase'

	// ⭐⭐ **THE NAME OF CASE `index`'S BACKING FUNCTION — the ONE reader of the convention that, for this
	// backing, `caseRawValues` holds a function's name.** Four sites want it (the declaration check's two
	// sides, the token minted below, and `enumFunctionBackingGoverningName`), and it was spelled out at each;
	// a convention restated four times is one nobody can change.
	//
	// ⚠ **`FirstCaseIndex` IS A LEGAL ARGUMENT FOR ANY FUNCTION-BACKED LAYOUT, and that is a property of the
	// backing rather than of the caller.** The backing is fixed BY a case (`requireEnumBacking` runs from
	// inside the case reader), so `EnumBacking.functionRef` implies at least one case exists — which is what
	// lets `enumFunctionBackingGoverningName` index case 0 without asking, and what the panic below says if
	// the implication is ever broken.
	function enumCaseFunctionName(layout EnumLayout, index CaseIndex) returns ByteArray
		if index >= layout.caseCount() 'noSuchCase'
			panic("Parser.enumCaseFunctionName: `{layout.kindWord()} {String.from(layout.name)}` is function-backed but has no case {index} — a backing is fixed BY a case, so a function-backed layout has at least one and `FirstCaseIndex` is always in range")
		end 'noSuchCase'

		return layout.rawValueAt(index).toByteArray()
	end 'enumCaseFunctionName'

	// ⭐ **THAT NAME AS A TOKEN**, positioned at `anchor` — what the two gates that take one need, since a
	// function-backed case records a name and no token (the declaration is read by the tolerant sweep too,
	// whose tokens are gone by the time anything asks).
	function enumCaseFunctionToken(layout EnumLayout, index CaseIndex, anchor Token) returns Token
		return Token.create(TokenKind.identifier, line: anchor.line, column: anchor.column, value: self.enumCaseFunctionName(layout, index: index))
	end 'enumCaseFunctionToken'

	// ⭐⭐ **THE TWO THINGS A FUNCTION-BACKED CASE OWES, ASKED AT THE DECLARATION — where every one of them is
	// asked exactly once, whether or not any program ever reads the enum.**
	//
	//   1. **The name must stand as a function VALUE at all** — declared, non-throwing, and returning
	//      something a single result register can carry. Asked through `requireNameIsUsableAsFunctionValue`,
	//      the very gate `emitFunctionRef` applies to `let f = doubleFn`, because it is the same claim: the
	//      case IS a function reference, written in a declaration instead of an expression.
	//   2. **Its signature must be the one the enum already fixed.** `/specs/enum-function-backing.md` states
	//      it — *"All cases must share the same function signature"* — and shv2 additionally DEPENDS on it:
	//      `.rawValue` hands back ONE value whose governing name is the FIRST case's function, so a second
	//      case with a different shape would be called through a promise it does not keep. The parser cannot
	//      decide it (a shape lives in the whole-program `funcSignatures` and is compared RESOLVED), so it is
	//      recorded as a `PendingFunctionTypeDoor` like every other function-shape question and
	//      `SemanticCheck.checkFunctionTypeDoors` answers it.
	//
	// ⚠ **REAL PARSE ONLY, and that is why it is HERE and not in `readEnumCaseInto`.** The tolerant sweep
	// shares that reader and swallows its throws, which truncates the layout and misassigns every later
	// case's tag (see there) — and it runs before the whole-program index this asks even exists.
	function checkFunctionBackedCase(layout EnumLayout, caseTok Token) throws ParseError
		if layout.backing != EnumBacking.functionRef 'notFunctionBacked'
			return
		end 'notFunctionBacked'

		let index = layout.caseCount() - 1
		try self.requireNameIsUsableAsFunctionValue(self.enumCaseFunctionToken(layout, index: index, anchor: caseTok))

		// The FIRST case fixes the signature, so it has nothing to be compared against.
		if index == FirstCaseIndex 'fixesTheSignature'
			return
		end 'fixesTheSignature'

		self.recordFunctionTypeDoorByName(self.enumCaseFunctionName(layout, index: FirstCaseIndex), gotName: self.enumCaseFunctionName(layout, index: index), door: FunctionTypeDoor.enumCaseBacking, placeName: layout.caseNameAt(index), anchor: caseTok)
	end 'checkFunctionBackedCase'

	// ⭐⭐ **EVERYTHING A STRUCT-BACKED CASE OWES, ASKED AT THE DECLARATION — once per case, whether or not any
	// program ever reads a field of it.** `checkFunctionBackedCase`'s twin, called from the same per-case loop
	// for the same reason, and REAL PARSE ONLY for the same reason: the tolerant sweep shares the case reader
	// and swallows its throws, which would truncate the layout and misassign every later case's tag.
	//
	// ⭐ **WHY IT CAN ASK WHAT THE READER COULD NOT: the whole-program signature index is COMPLETE by the
	// time any file is parsed.** So `structOf` answers here, where inside the sweep it could not — which is
	// what lets the four rules below be facts about the DECLARATION rather than about whichever field some
	// expression happened to read. That is the whole point of the position: **a field nobody reads was never
	// validated at all** while these lived at the read site.
	//
	// ⛔⛔ **THE TYPE RULE IS THE ONE THAT WAS A COMPILER PANIC AND A WILD POINTER.** Before it,
	// `readEnumBackingFieldValue` admitted any of its four value forms into any field: a `Real` field written
	// `1.5` panicked the x64 emitter (*"a register-to-register move from rax to xmm0 crosses register
	// files"*) and a `String` field written `1` compiled clean and ACCESS-VIOLATED at run time, dereferencing
	// a String record address of 1. Both are MEASURED; see `EnumBackingFieldValue.literal`.
	//
	// ⭐⭐ **AND IT ASKS ALL FOUR AT EVERY DEPTH, BECAUSE IT RECURSES INTO THE NESTED GROUPS**
	// (`/specs/enum-nested-struct-backing.md`). `OpMeta.create(4, isMemory: true)` short of `isCall` is the
	// same defect one level down as `X64OpMeta.create(…)` short of `setsFlags`, and a rule that stopped at
	// the outermost group would be a door with a hole exactly the shape of the feature this rung added.
	function checkStructBackedCase(layout EnumLayout, caseTok Token) throws ParseError
		if layout.backing != EnumBacking.structRecord 'notStructBacked'
			return
		end 'notStructBacked'

		let index = layout.caseCount() - 1

		try self.checkEnumBackingGroup(try self.requireEnumBackingStruct(layout, anchor: caseTok), entries: layout.backingFieldsAt(index), group: RootBackingGroup, layout: layout, index: index, caseTok: caseTok)
	end 'checkStructBackedCase'

	// ⭐⭐ **THE FOUR RULES, ASKED OF ONE GROUP** — the entries filling one constant struct, which is the
	// case's own backing at `RootBackingGroup` and a nested constant at every deeper call. Every rule below
	// is about ONE struct and the entries that fill it, so recursing is the whole of what nesting costs.
	//
	// ⚠ **THE RECURSION IS DRIVEN BY WHAT WAS *WRITTEN*, NOT BY THE TYPE GRAPH, AND THAT IS WHY IT
	// TERMINATES WITHOUT A DEPTH GUARD.** It descends only into an entry that wrote a nested constant, and
	// the source text holding those entries is finite. It could NOT rest on types being acyclic: E4014 is
	// checked by `TypeCycleCheck` after every file is parsed (`Compiler.maxon`), so a `type A  export let a
	// as A end` reaches this door FIRST — and here it is simply a case that fails the missing-field rule at
	// whatever depth the author stopped writing.
	function checkEnumBackingGroup(struct StructLayout, entries EnumBackingFieldArray, group EnumBackingGroupId, layout EnumLayout, index CaseIndex, caseTok Token) throws ParseError
		var filled = BoolArray.create()
		for _ in 0 upto struct.fieldCount() 'seedFilledColumn'
			filled.push(false)
		end 'seedFilledColumn'

		for entry in 0 upto entries.count() 'eachWrittenField'
			let recorded = enumBackingEntryAt(entries, entry: entry)
			if recorded.group != group 'fillsAnotherStruct'
				continue
			end 'fillsAnotherStruct'

			let field = try self.requireEnumBackingFieldPosition(struct, entries: entries, recorded: recorded, caseTok: caseTok)

			// ⚠ **A DUPLICATE IS CAUGHT BY THE FILLED COLUMN, WHICH IS WHY THERE IS ONE.** `Meta{value: 1,
			// value: 2}` used to keep the FIRST and silently drop the second, because the resolution scan in
			// `enumBackingFieldConstant` returns on its first hit and nothing ever visited the rest.
			//
			// It reports through the LITERAL's own voice rather than a second sentence for one defect: such a
			// literal is "initialized twice" wherever it is written, and a factory call in this position IS
			// that literal (see `readEnumBackingFields`). Anchored at the CASE, the token every per-case
			// declaration diagnostic names and the position the oracle uses.
			let alreadyFilled = try filled.get(field) otherwise panic("checkEnumBackingGroup: filled.get OOB at {field} below count {filled.count()}")
			if alreadyFilled 'writtenTwice'
				throw ParseError.duplicateFieldInitializer(String.from(struct.name), fieldName: String.from(struct.fieldNameAt(field)), line: caseTok.line, column: caseTok.column)
			end 'writtenTwice'
			try filled.set(field, value: true) otherwise panic("checkEnumBackingGroup: filled.set OOB at {field} below count {filled.count()}")

			// The type rule ANSWERS with the domain it decided on, so the descent below reads the one
			// classification this field was admitted under rather than asking a second time — the shape that
			// keeps "what the door admitted" and "where the door recurses" from ever being two answers.
			let domain = try self.requireEnumBackingFieldValueSuitsField(struct, field: field, value: recorded.value, caseTok: caseTok)
			if not domainIsEnumBackingNestedRecord(domain) 'aScalarLeaf'
				continue
			end 'aScalarLeaf'

			try self.checkEnumBackingGroup(self.enumBackingNestedStruct(struct, field: field), entries: entries, group: nestedBackingGroupOf(entry), layout: layout, index: index, caseTok: caseTok)
		end 'eachWrittenField'

		// ⛔⛔ EVERY DECLARED FIELD MUST BE WRITTEN, AND A DEFAULT DOES NOT EXCUSE ONE — MEASURED on the C#
		// bootstrap, which answers `E3018: missing field 'value' in struct raw value for 'Meta'` at the case
		// for BOTH `Meta{}` on a one-field struct AND a struct whose omitted field declares `= 9`. Asked here
		// rather than at the read for this door's whole reason: the read only ever visits the field some
		// expression named, so a case short of a field nobody reads was admitted silently.
		for field in 0 upto struct.fieldCount() 'eachDeclaredField'
			let wasWritten = try filled.get(field) otherwise panic("checkEnumBackingGroup: filled.get OOB at {field} below count {filled.count()}")
			if not wasWritten 'neverWritten'
				throw self.enumBackingMissingFieldError(struct.name, fieldName: struct.fieldNameAt(field), layout: layout, index: index, anchor: caseTok)
			end 'neverWritten'
		end 'eachDeclaredField'
	end 'checkEnumBackingGroup'

	// ⭐ THE ONE SENTENCE FOR "this case supplies no constant for that field", rendered here because it has
	// TWO throwers and must not become two rules: this door (which asks it of every declared field, at the
	// declaration) and `enumBackingFieldConstant` (which meets it at a read).
	//
	// ⚠ **THE READ'S COPY IS NOT DEAD, AND THAT IS WHY IT IS A DIAGNOSTIC RATHER THAN A PANIC.** The door
	// runs during the DECLARING file's real parse, and a file that READS the enum may be parsed first — so a
	// read can reach the gap before the door has reported it. A panic there would beat a diagnostic to the
	// user for a program that has a perfectly good one waiting.
	//
	// It is deliberately NOT `fieldNotInitialized`, whose sentence ends "and it has no default value": the
	// rule here is stricter than a literal's, since a defaulted field is refused too, so that clause would be
	// false exactly where this differs from a literal.
	function enumBackingMissingFieldError(structName ByteArray, fieldName ByteArray, layout EnumLayout, index CaseIndex, anchor Token) returns ParseError
		return ParseError.unsupported("field '{String.from(fieldName)}' of the `{String.from(structName)}` backing, which case '{String.from(layout.caseNameAt(index))}' of `{layout.kindWord()} {String.from(layout.name)}` writes no value for — a struct backing supplies one constant PER CASE for every field, defaults included, because reading one field selects it from every case", line: anchor.line, column: anchor.column)
	end 'enumBackingMissingFieldError'

	// WHICH declared field an entry fills — its LABEL's field, or the field at its own POSITION. Both ways of
	// being wrong are reported here: a label naming no declared field, and a positional entry past the last
	// one (`Meta.create(1, 2, 3)` on a one-field struct, whose surplus entries nothing ever visited).
	//
	// ⚠ **THIS IS THE INVERSE OF `enumBackingEntryFills`, AND THE MATCHING CLAUSES ARE ITS.** The door needs
	// ENTRY→FIELD (only that direction can name the field a surplus positional claims) where the read needs
	// FIELD→ENTRY, so the two cannot be one function — but the RULE they share is written once, there.
	//
	// ⚠ **THE COUNT IN THE SENTENCE IS THE GROUP'S, NOT THIS ENTRY'S POSITION.** It read
	// `recorded.position + 1`, which is where the FIRST offender sits: `Meta.create(1, 2, 3)` on a one-field
	// struct announced *"2 argument(s)"* about a three-argument call. A diagnostic that states a wrong number
	// is worse than one that states none, and this one was golden-pinned while saying it.
	function requireEnumBackingFieldPosition(struct StructLayout, entries EnumBackingFieldArray, recorded EnumBackingField, caseTok Token) returns FieldIndex throws ParseError
		if recorded.name.isEmpty() 'positional'
			if recorded.position >= struct.fieldCount() 'pastTheLastField'
				throw ParseError.unsupported("{enumBackingGroupEntryCount(entries, group: recorded.group)} argument(s) to the `{String.from(struct.name)}` constant, which declares {struct.fieldCount()} field(s) — a factory call in this position is read as the struct LITERAL its arguments fill, so an argument past the last field names nothing", line: caseTok.line, column: caseTok.column)
			end 'pastTheLastField'

			return recorded.position
		end 'positional'

		return try self.requireFieldIndex(struct, name: recorded.name, anchor: caseTok)
	end 'requireEnumBackingFieldPosition'

	// ⭐ **THE FIELD `name` DENOTES, OR E3018 — one door for the two askers**, because a name the DOOR
	// admits and one the READ admits must be the same set and nothing else made them: the declaration's label
	// check (`requireEnumBackingFieldPosition`) and `emitEnumBackingFieldSelect` were the identical
	// `declaresField`-then-`indexOfField` pair under the identical constructor, which is also two linear scans
	// of one column where one answers both.
	function requireFieldIndex(struct StructLayout, name ByteArray, anchor Token) returns FieldIndex throws ParseError
		let index = struct.indexOfField(name)
		if index >= struct.fieldCount() 'noSuchField'
			throw ParseError.unknownField(String.from(struct.name), fieldName: String.from(name), line: anchor.line, column: anchor.column)
		end 'noSuchField'

		return index
	end 'requireFieldIndex'

	// ⭐⭐ **DOES THE WRITTEN CONSTANT SUIT THE FIELD'S DECLARED TYPE?** — the rule whose absence was the
	// panic and the wild pointer. It is asked against `enumBackingFieldDomainOf`, the SAME classifier the
	// read's decode is exhaustive over, so the door admits exactly what the read can produce a value for.
	//
	// ⭐ **IT HANDS BACK THE DOMAIN IT DECIDED ON**, which is what the door's descent into a nested constant
	// reads. Re-asking the classifier there would be the same question answered twice, free to disagree the
	// day either half changes — and "the field this recursed into is the field the rule admitted" is the
	// property that keeps a nested group being checked against the struct it actually fills.
	function requireEnumBackingFieldValueSuitsField(struct StructLayout, field FieldIndex, value EnumBackingFieldValue, caseTok Token) returns EnumBackingFieldDomain throws ParseError
		let fieldType = self.signatures.fieldTypeOf(struct, index: field, into: self.artifact.typeNames)
		let fieldName = String.from(struct.fieldNameAt(field))
		let domain = self.enumBackingFieldDomainOf(fieldType)

		// The FIELD's type and the CONSTANT written into it are two different faults, and they get two
		// sentences. This one is shared with the READ (see `enumBackingUnsupportedFieldError`).
		try self.requireEnumBackingFieldTypeIsSupported(struct.name, fieldName: struct.fieldNameAt(field), fieldType: fieldType, domain: domain, anchor: caseTok)

		if enumBackingValueSuitsDomain(value, domain: domain, declaredName: self.enumBackingFieldTypeIdentity(fieldType, domain: domain)) 'suits'
			return domain
		end 'suits'

		throw ParseError.unsupported("the constant written for field '{fieldName}' of the `{String.from(struct.name)}` backing, which is declared `{maxonTypeName(fieldType, typeNames: self.artifact.typeNames)}` — a backing field takes an INT literal for an integer field, a `true`/`false` for a `bool` field, an int or float literal for a float field, `<ThatEnum>.<case>` of THAT enum for a field of a declared enum, and a nested constant of THAT type (a literal or a factory call) for a field of a declared `type`", line: caseTok.line, column: caseTok.column)
	end 'requireEnumBackingFieldValueSuitsField'

	// The domain gate, spelled as a `throws` so both askers can use it — the door below (once per declared
	// case) and the READ (`emitEnumBackingFieldSelect`).
	function requireEnumBackingFieldTypeIsSupported(structName ByteArray, fieldName ByteArray, fieldType MaxonType, domain EnumBackingFieldDomain, anchor Token) throws ParseError
		if not domainIsEnumBackingUnsupported(domain) 'holdable'
			return
		end 'holdable'

		throw self.enumBackingUnsupportedFieldError(structName, fieldName: fieldName, fieldType: fieldType, anchor: anchor)
	end 'requireEnumBackingFieldTypeIsSupported'

	// ⭐ **THE ONE SENTENCE FOR "that field's declared type has no constant this column can hold"** —
	// `enumBackingMissingFieldError`'s twin, and it has two throwers for the identical reason, which THIS DIFF
	// established by reading the pipeline rather than by assuming: `queryProgramSignatures` sweeps every file
	// before any real parse, but `parseModule` is one flat source-order loop and `parseFunction` parses and
	// lowers bodies inline — so a read in a function declared ABOVE the `enum` in the same file reaches the
	// read's gate before the declaration door ever runs, and across files `Queries.maxon` walks
	// `project.db.sourcePaths` with nothing sorting it. A panic on that path would beat a perfectly good
	// diagnostic to the user.
	//
	// ⚠ It names the FIELD's type, never the constant written into it: a `String`-typed backing field is
	// wrong whatever is written there, and the author's fix is the field's type or the backing's shape.
	function enumBackingUnsupportedFieldError(structName ByteArray, fieldName ByteArray, fieldType MaxonType, anchor Token) returns ParseError
		return ParseError.unsupported("field '{String.from(fieldName)}' of the `{String.from(structName)}` backing is declared `{maxonTypeName(fieldType, typeNames: self.artifact.typeNames)}`, which has no constant a struct backing can hold — a backing field is an integer, a `bool`, a float, a PAYLOAD-FREE enum, or a declared `type` whose own fields are again those, because the select that reads one field produces a single i64 per case and a nested record is DESCENDED INTO rather than selected. A `{String.from(StringConformerName)}`, a `{String.from(CharacterConformerName)}`, an array, an interface, a function, or a payload-bearing union is a heap value that i64 would only be an address of", line: anchor.line, column: anchor.column)
	end 'enumBackingUnsupportedFieldError'

	// The TYPE a field of one of the two NAMED domains denotes — the identity a written `<Type>.<member>`
	// must match, so `Config{mode: Priority.low}` on a `Mode`-typed field is refused and so is
	// `X64OpMeta.create(Other.create(1), …)` on an `OpMeta`-typed one. Empty for every other domain, where no
	// value naming a type is admitted at all and the name is never compared.
	function enumBackingFieldTypeIdentity(fieldType MaxonType, domain EnumBackingFieldDomain) returns ByteArray
		match domain 'd'
			enumWord then return self.internedName(typeNameIdOf(fieldType))
			nestedRecord then return self.internedName(typeNameIdOf(fieldType))
			integerWord then return EmptySourceText
			booleanWord then return EmptySourceText
			floatBits then return EmptySourceText
			unsupported then return EmptySourceText
		end 'd'
	end 'enumBackingFieldTypeIdentity'

	// ⭐ **THE STRUCT A `nestedRecord` FIELD NAMES — the group's own declaration**, asked by the door as it
	// recurses and by the read as it descends, so both check a nested group against the same layout.
	//
	// ⚠ **THE PANIC'S GUARD IS `enumBackingRecordFieldDomain`, WHICH PROBED THIS EXACT NAME.** A field is
	// classified `nestedRecord` only because `structOf` answered `declared` for it, so an `undeclared` here
	// means one name was read two ways — not a program the author could write.
	function enumBackingNestedStruct(struct StructLayout, field FieldIndex) returns StructLayout
		let fieldName = self.internedName(typeNameIdOf(self.signatures.fieldTypeOf(struct, index: field, into: self.artifact.typeNames)))
		match self.signatures.structOf(fieldName) 'declaring'
			declared(nested) then return nested
			undeclared then panic("enumBackingNestedStruct: field '{String.from(struct.fieldNameAt(field))}' of `type {String.from(struct.name)}` is declared `{String.from(fieldName)}`, which was classified a NESTED RECORD and yet no file declares a `type` of that name — `enumBackingRecordFieldDomain` reaches that classification only through `structOf` answering `declared` for this very name")
		end 'declaring'
	end 'enumBackingNestedStruct'

	// ⭐⭐ **WHAT A FIELD'S DECLARED TYPE DOES TO THE i64 THE SELECT PRODUCES — THE ONE CLASSIFIER**, read by
	// the door above and by `emitEnumBackingFieldSelect`'s decode. See `EnumBackingFieldDomain`.
	//
	// ⚠ **THE NAME IS RESOLVED, NOT APPROXIMATED, AND `rangedAliasResolvedTag` IS WHY.** A field declared
	// `Latency` (a ranged INT alias) and one declared `Ratio` (a ranged FLOAT alias) are both `named`, and
	// `tagIsIntegral` answers true for BOTH — which is exactly the approximation that function's own header
	// warns produces "a compiler crash on a legal-looking program". A `named` that reduces to no primitive is
	// a declared ENUM (or an undeclared name, which is being rejected for the missing type anyway), whose
	// value IS its i64 tag — including a FLOAT-backed enum, whose tag is a bit pattern in a GPR.
	function enumBackingFieldDomainOf(fieldType MaxonType) returns EnumBackingFieldDomain
		let resolved = self.rangedAliasResolvedTag(maxonTypeTag(fieldType), nameId: typeNameIdOf(fieldType))
		if resolved == ValueTypeTag.float 'floatDomain'
			return EnumBackingFieldDomain.floatBits
		end 'floatDomain'
		if resolved == ValueTypeTag.boolean 'boolDomain'
			return EnumBackingFieldDomain.booleanWord
		end 'boolDomain'
		if tagIsPlainInteger(resolved) 'integerDomain'
			return EnumBackingFieldDomain.integerWord
		end 'integerDomain'
		if resolved == ValueTypeTag.named 'aNamedType'
			return self.enumBackingNamedFieldDomain(self.internedName(typeNameIdOf(fieldType)))
		end 'aNamedType'
		// ⭐ A DECLARED `type` is `structRef` and never `named` — the tag has its own arm precisely so the
		// rules that read `named` cannot absorb a record (`MaxonType.structRef`). It is the one tag this rung
		// added a domain for, and it is asked of the REGISTRY rather than assumed from the tag: a name no
		// file declares is refused rather than descended into.
		if resolved == ValueTypeTag.structRef 'aDeclaredRecord'
			return self.enumBackingRecordFieldDomain(self.internedName(typeNameIdOf(fieldType)))
		end 'aDeclaredRecord'

		return EnumBackingFieldDomain.unsupported
	end 'enumBackingFieldDomainOf'

	// ⛔⛔ **A `named` FIELD IS A WORD ONLY IF ITS DECLARATION IS UNBOXED — AND `enumOf` HOLDS UNIONS TOO.**
	// `ProgramSignatures.enumTypes` is one registry for `enum` and `union` alike (`isUnion` is a bit on the
	// layout), and a PAYLOAD-BEARING union is heap-boxed with EVERY case taking the boxed form, payload-free
	// ones included (`EnumLayout.isBoxed`, and `parseEnumLiteral` says so outright). So its value is a BOX
	// POINTER and never a tag.
	//
	// ⛔ **MEASURED, AND IT IS THIS RUNG'S OWN DEFECT CLASS ONE TYPE OVER.** `union Shape circle(r Num)
	// blank end` + `type Meta export let s as Shape end` + `a = Meta{s: Shape.blank}` COMPILED CLEAN and
	// exited `0xC0000005`: the constant column stored `blank`'s tag, this classifier called it `enumWord`, the
	// select claimed the raw i64 was a `Shape`, and the `match` loaded through it as a box pointer at address
	// 1. That is the *"a String record address of 1"* failure `EnumBackingFieldValue.literal` records, reached
	// through the one arm whose header had asserted *"the i64 is that enum's TAG, which is what an enum value
	// IS"* — true for an enum and for a payload-free union, false for a boxed one.
	function enumBackingNamedFieldDomain(name ByteArray) returns EnumBackingFieldDomain
		let declared = self.signatures.enumOf(name)
		if not enumMatchIsDeclared(declared) 'notADeclaredEnum'
			return EnumBackingFieldDomain.unsupported
		end 'notADeclaredEnum'
		if requireEnumLayout(declared).isBoxed() 'boxedUnion'
			return EnumBackingFieldDomain.unsupported
		end 'boxedUnion'

		return EnumBackingFieldDomain.enumWord
	end 'enumBackingNamedFieldDomain'

	// ⭐⭐ **A FIELD DECLARED AS ANOTHER `type` IS A NESTED RECORD** — the domain this rung added
	// (`/specs/enum-nested-struct-backing.md`), and it is admitted on a DIFFERENT premise from the three word
	// domains, which is the whole reason it is its own arm: **nothing is ever SELECTED at this domain.** A
	// record IS a box pointer at run time — the trap `enumBackingNamedFieldDomain` records, one type over —
	// so a select that produced one would be the same wild pointer. Instead the read keeps descending
	// (`resolveEnumBackingLeaf` never returns this domain, and refuses a chain that stops on it) and the door
	// recurses (`checkEnumBackingGroup`), until a SCALAR LEAF is reached, which is a word like any other.
	//
	// ⚠ Every leaf of such a record is classified by `enumBackingFieldDomainOf` itself, so a `String`, an
	// array or a boxed union INSIDE a nested record is refused exactly as one at the top level is.
	function enumBackingRecordFieldDomain(name ByteArray) returns EnumBackingFieldDomain
		match self.signatures.structOf(name) 'declaring'
			declared then return EnumBackingFieldDomain.nestedRecord
			undeclared then return EnumBackingFieldDomain.unsupported
		end 'declaring'
	end 'enumBackingRecordFieldDomain'

	// The read's gate on the remaining domains — an exhaustive match, so a domain added to
	// `EnumBackingFieldDomain` cannot silently take the word route here.
	//
	// ⚠⚠ **ONE ARM ASSERTS AND ONE THROWS, AND THE DIFFERENCE IS WHETHER THE GUARD IS LOCAL.**
	// `floatBits` is genuinely impossible: the caller returns on `domainIsEnumBackingFloatBits` one branch
	// above, in this same function, so reaching it means one classifier read two ways. `unsupported` is a
	// different claim entirely — it rests on the DECLARATION DOOR having already run, which is an ORDERING
	// premise and a false one (see `enumBackingUnsupportedFieldError` for the pipeline reading that disproves
	// it). It was a panic for one edit, which is the same mistake `enumBackingMissingFieldError` was split in
	// two to avoid, made one rule over.
	function requireEnumBackingFieldDomainIsAWord(step EnumBackingFieldStep, fieldType MaxonType, domain EnumBackingFieldDomain, anchor Token) throws ParseError
		match domain 'd'
			integerWord then return
			booleanWord then return
			enumWord then return
			floatBits then panic("requireEnumBackingFieldDomainIsAWord: field '{String.from(step.fieldName)}' of `type {String.from(step.ownerName)}` is float-domained and reached the word route — the caller returns on `domainIsEnumBackingFloatBits` one branch above, so the two readings of one classifier have come apart")
			// A NESTED RECORD is the domain that is never an answer: `resolveEnumBackingLeaf` either descends
			// through it or refuses the read outright, so the leaf it hands this gate cannot be one — a local
			// guard, in the same descent, which is what makes this an assertion rather than a diagnostic.
			nestedRecord then panic("requireEnumBackingFieldDomainIsAWord: field '{String.from(step.fieldName)}' of `type {String.from(step.ownerName)}` is a NESTED RECORD and reached the word route — `resolveEnumBackingLeaf` loops while `domainIsEnumBackingNestedRecord` holds and refuses a chain that stops on one, so no leaf it returns can carry this domain")
			unsupported then throw self.enumBackingUnsupportedFieldError(step.ownerName, fieldName: step.fieldName, fieldType: fieldType, anchor: anchor)
		end 'd'
	end 'requireEnumBackingFieldDomainIsAWord'

	// ⭐ **IS THE CURSOR ON A STRUCT RAW VALUE — `= Meta{value: 1}` or `= Meta.create(1)`?** The twin of
	// `atEnumFunctionRawValue`, and it must be POSITIVE ABOUT THE WHOLE FORM for that function's exact reason.
	//
	// ⛔⛔ **A BARE `identifier .` IS NOT ENOUGH, AND CLAIMING IT MISROUTES A DIAGNOSTIC ONE CONSTRUCT OVER.**
	// It read `leftBrace or dot` for one edit, so `= Priority.low` — an author reaching for an enum member —
	// was claimed as a struct raw value: the reader ate `Priority`, `.`, `low`, then demanded the factory's
	// `(` and reported **E2010 `Expected '(' but got 'newline'`**, the wrong token, saying nothing about raw
	// values. MEASURED. That is verbatim the failure `atEnumFunctionRawValue`'s header was written to prevent
	// (*"a blacklist also has to be re-audited by every construct that ever puts a new token after a name"*),
	// reintroduced beside it.
	//
	// ⇒ the factory arm names all four of its tokens, so anything that is not a whole `<Type>.<member>(`
	// falls through to `readEnumIntRawValue`, whose refusal now enumerates the six legal raw values at the
	// token the author actually wrote.
	function atEnumStructRawValue() returns bool
		if not self.at(TokenKind.identifier) 'notATypeName'
			return false
		end 'notATypeName'
		if self.peekKind() == TokenKind.leftBrace 'structLiteral'
			return true
		end 'structLiteral'

		return self.peekKind() == TokenKind.dot and tokenCanBeAName(self.tokenAt(self.pos + 2)) and self.kindAt(self.pos + 3) == TokenKind.leftParen
	end 'atEnumStructRawValue'

	// ⭐⭐ **A STRUCT-BACKED CASE (`add = Meta{value: 1}`, `add = Meta.create(1)`) — the DECLARATION half,
	// which records the struct's NAME and the fields' CONSTANTS and resolves neither.**
	//
	// ⭐ **THE TAG IS THE AUTO-INCREMENT DECLARATION INDEX**, for the STRING and FUNCTION backings' reason
	// exactly: a struct value is not a number, so it cannot be one. What is different is E3031 — those two
	// backings compare their recorded column and this one compares NOTHING, because two cases may legally
	// carry equal struct backings (`EnumRawValueIdentity.incomparable`, which carries the measurement).
	//
	// ⚠ **WHY NOTHING IS RESOLVED HERE: this reader runs inside the tolerant declaration SWEEP**, the pass
	// that builds the whole-program index — so `structOf` (which field is position 0?) and `enumOf` (what tag
	// is `Priority.low`?) have no answer yet. Both are asked at the USE (`emitEnumBackingFieldSelect`). See
	// `EnumBackingField`.
	function appendStructBackedEnumCase(layout EnumLayout, caseName ByteArray, counter EnumTagCounter, caseTok Token, payloads PayloadFieldArray) throws ParseError
		let typeTok = try self.consume(TokenKind.identifier)
		try self.requireEnumBacking(layout, kind: EnumBacking.structRecord, structName: typeTok.value, caseTok: caseTok)
		let fields = try self.readEnumBackingFields(typeTok)
		let tag = self.nextAutoEnumTag(counter)

		// The struct's own name is what `caseRawValues` can carry of a value that is not one — the column's
		// "how the raw value was written" for a backing whose fields ride a column of their own. Nothing reads
		// it back: E3031 and the decl hash both route through `rawValueIdentity`, which answers `incomparable`.
		try self.appendEnumCase(layout, caseName: caseName, tag: tag, rawValue: String.from(typeTok.value), declaresRawValue: true, caseTok: caseTok, payloads: payloads, backingFields: fields)
	end 'appendStructBackedEnumCase'

	// ⭐⭐ **THE TWO SPELLINGS OF A CONSTANT STRUCT, AND THEY PRODUCE THE IDENTICAL FIELD LIST.** The cursor
	// sits just past the type name, on `{` or on `.`.
	//
	// ⭐⭐⭐ **A FACTORY CALL IS PURE SYNTAX HERE — THE CALLEE IS NEVER RESOLVED AND ITS BODY IS NEVER READ —
	// AND THAT IS THE LANGUAGE'S RULE, MEASURED, NOT AN ASSUMPTION THIS COMPILER MAKES.** Three runs against
	// the C# bootstrap on `enum TestOp  add = Meta.create(1)  mul = Meta.create(3) end`:
	//
	//   1. a `create` whose body is `return Self{value: other + 20}` — with the PARAMETER named `other`, not
	//      `value` — still answers `op.rawValue.value == 3`, so the body is not consulted;
	//   2. the same written `Meta.make(1)` answers 3, so the member's spelling is not `create`;
	//   3. the same with **no such static declared at all** answers 3, so nothing is looked up.
	//
	//   v1 agrees on (1) and (3) and states it outright — *"The struct's `.create` signature is assumed to
	//   mirror its field order"* (`maxon-selfhosted/Compiler/Parser.maxon:4311-4316`) — differing only in that
	//   it hard-refuses any member but `create` (`:4283`). ⇒ **shv2 follows the RUNNABLE oracle and admits any
	//   member name**, because restricting to `create` would refuse `Meta.make(1)`, which the oracle compiles
	//   and which is the spelling `specs-shv2/function-overloads.md`'s own struct writes.
	//
	// ⇒ What an argument means is its POSITION (or its label), and nothing else: `Meta.create(1)` IS
	// `Meta{<field 0>: 1}`. That is why the two forms share one `EnumBackingFieldArray` and one reader.
	function readEnumBackingFields(typeTok Token) returns EnumBackingFieldArray throws ParseError
		var fields = EnumBackingFieldArray.create()
		try self.readEnumBackingGroupInto(fields, typeTok: typeTok, group: RootBackingGroup)

		return fields
	end 'readEnumBackingFields'

	// ⭐⭐ **ONE DELIMITED LIST READER FOR BOTH SPELLINGS.** `{ name: v, name2: v2 }` and `( v, label: v2 )`
	// are the same loop — open, empty check, `push(label, value)`, `,`, close — and they were written out
	// TWICE for one edit, differing in the opener/closer pair, the label reader, and (accidentally) in what
	// an EMPTY list meant. That divergence is the whole argument for folding them: the factory form refused
	// `Meta.create()` with a paragraph while the brace form silently admitted `Meta{}` on a struct with
	// fields — one condition, two verdicts — and every rule this reader gains from here on would otherwise
	// have to be written into both, where a clause added to one reads as correct at both sites.
	//
	// ⚠ **THE EMPTY LIST IS NOW ONE VERDICT: ADMITTED, and adjudicated by the door.** `Meta{}` and
	// `Meta.create()` both record no fields, and `checkStructBackedCase` — which is the only thing that can
	// see how many fields `Meta` actually declares — reports the arity there, once, for both spellings.
	//
	// ⚠ **`labelled` PICKS THE LABEL READER AND NOTHING ELSE.** A brace literal REQUIRES `<name> :` on every
	// entry (the only struct-literal spelling the language has, and what `parseStructLiteral` reads); a
	// factory argument's label is optional, and an unlabelled one means the field at its own POSITION
	// (`EnumBackingField.name`).
	//
	// ⭐⭐ **AND IT IS THE SAME READER AT EVERY DEPTH — THE ONE CALL THAT MAKES NESTING WORK**
	// (`/specs/enum-nested-struct-backing.md`). `OpMeta.create(1)` written as an ARGUMENT is the identical
	// construct written as a CASE's backing, so it is read by the identical function; what a nested group
	// adds is only where its entries say they belong. Both spellings mix freely at every level, because the
	// brace/factory question is asked per group rather than once for the case.
	//
	// ⚠ **THE CURSOR SITS JUST PAST THE TYPE NAME**, on `{` or on `.`, exactly as `readEnumBackingFields`
	// finds it — which is what lets the caller be either `appendStructBackedEnumCase` or this function's own
	// nested-entry arm.
	function readEnumBackingGroupInto(fields EnumBackingFieldArray, typeTok Token, group EnumBackingGroupId) throws ParseError
		let labelled = self.at(TokenKind.leftBrace)
		if not labelled 'factoryCall'
			try self.consume(TokenKind.dot)
			// The member's spelling decides nothing (see `readEnumBackingFields`' header), so it is consumed
			// and dropped rather than bound to a name nothing reads.
			//
			// ⚠ **THROUGH THE SAME DOOR `atEnumStructRawValue` ADMITTED IT.** That predicate claims the form on
			// `tokenCanBeAName`, which admits a KEYWORD-spelled member — so a strict `consume(identifier)` here
			// claimed `Meta.default(1)` and then refused it with a token-level *"Expected identifier"*, a
			// predicate and its consumer disagreeing about one token. That is verbatim the defect
			// `readEnumBackingFieldLabel`'s header records fixing for a field's LABEL, left standing one line
			// away for the member name — and this rung made it reachable at every nesting depth.
			_ = try self.consumeMemberNameToken()
		end 'factoryCall'

		let closer = TokenKind.rightBrace if labelled else TokenKind.rightParen
		self.advance()
		if self.at(closer) 'noFields'
			try self.consume(closer)
			return
		end 'noFields'

		var position = 0 as FieldIndex
		while true 'fieldLoop'
			let label = try self.readEnumBackingFieldLabel(labelled)
			try self.readEnumBackingEntryInto(fields, typeTok: typeTok, group: group, label: label, position: position)
			position = position + 1

			if not self.at(TokenKind.comma) 'endFields'
				break
			end 'endFields'
			try self.consume(TokenKind.comma)
		end 'fieldLoop'

		try self.consume(closer)
	end 'readEnumBackingGroupInto'

	// ⭐⭐ **ONE ENTRY: A SCALAR CONSTANT, OR A NESTED STRUCT WHOSE OWN ENTRIES FOLLOW IT.** The shape test is
	// `atEnumStructRawValue` — the very predicate that decided the CASE was struct-backed — so "what a
	// constant struct looks like" is one rule rather than one at the case and a second inside it. Anything
	// else (`1`, `true`, `-1.5`, `Priority.low`) is a leaf and goes to `readEnumBackingFieldValue`, whose
	// refusal names the token the author wrote.
	//
	// ⚠ **THE OWNER'S INDEX IS TAKEN AFTER ITS OWN PUSH AND BEFORE THE RECURSION**, which is the whole of
	// the bookkeeping: the nested entries are appended to the SAME array (`EnumBackingField`'s header for
	// why the tree cannot hold them) and say which entry they fill a field of.
	function readEnumBackingEntryInto(fields EnumBackingFieldArray, typeTok Token, group EnumBackingGroupId, label ByteArray, position FieldIndex) throws ParseError
		if not self.atEnumStructRawValue() 'scalarConstant'
			let scalar = EnumBackingField.create(label, position: position, group: group, value: try self.readEnumBackingFieldValue(typeTok))
			fields.push(scalar)
			return
		end 'scalarConstant'

		let nestedTok = try self.consume(TokenKind.identifier)
		let owning = EnumBackingField.create(label, position: position, group: group, value: EnumBackingFieldValue.nestedStruct(nestedTok.value))
		fields.push(owning)
		let owner = fields.count() - 1
		let nestedGroup = nestedBackingGroupOf(owner)

		try self.readEnumBackingGroupInto(fields, typeTok: nestedTok, group: nestedGroup)
	end 'readEnumBackingEntryInto'

	// The field an entry NAMES, or `EmptySourceText` for a positional factory argument.
	//
	// ⭐ **BOTH SPELLINGS ADMIT A KEYWORD-SPELLED LABEL, AND THAT IS ONE RULE RATHER THAN TWO.** The brace
	// form went through `consumeMemberNameToken` (keywords admitted) and the factory form through
	// `consumeConstArgumentLabel` (strict identifier), so `Meta{bool: 1}` parsed and `Meta.create(bool: 1)`
	// did not — a difference in a *label reader* deciding what a *field* may be called, in a spec whose own
	// `struct-backing-keyword-enum-case-field` case exists because keyword-spelled members are real here.
	// `tokenCanBeAName` is the same admission `consumeMemberNameToken` applies.
	function readEnumBackingFieldLabel(labelled bool) returns ByteArray throws ParseError
		if labelled 'everyEntryNamesItsField'
			let nameTok = try self.consumeMemberNameToken()
			try self.consume(TokenKind.colon)
			return nameTok.value
		end 'everyEntryNamesItsField'

		if not (tokenCanBeAName(self.current()) and self.peekKind() == TokenKind.colon) 'positional'
			return EmptySourceText
		end 'positional'

		let labelTok = self.current()
		self.advance()
		try self.consume(TokenKind.colon)
		return labelTok.value
	end 'readEnumBackingFieldLabel'

	// ⭐ **ONE *LEAF* FIELD'S VALUE, AND THE ADMITTED SET IS THE SPEC'S OWN.** `/specs/enum-struct-backing.md`
	// bounds it — *"compile-time integer, float, or boolean constants, or nested struct literals"* — and its
	// cases add the enum-member reference (`Priority.low`, `Mode.fast`, `Cat.bool`).
	//
	// ⚠ **THE NESTED STRUCT IS NOT ONE OF THEM AND NEVER REACHES HERE**: it is not a leaf, so
	// `readEnumBackingEntryInto` claims it one branch up and this reader only ever sees the constants at the
	// bottom of the tree. What is refused below is a token that is neither.
	//
	// ⚠ **A NAMED TOP-LEVEL CONSTANT IS REFUSED**, though `MAX` reads like a constant: resolving one is
	// `ProgramSignatures.evaluateNamed`, whole-program, and this reader runs inside the sweep that builds
	// that index. It would have to ride the column unresolved like the enum-case arm does; no case asks.
	function readEnumBackingFieldValue(typeTok Token) returns EnumBackingFieldValue throws ParseError
		// A sign belongs to a numeric LITERAL and to nothing else, so it is claimed only when one follows —
		// a lone `-` then falls to the refusal below, positioned at the `-` the author actually wrote.
		let negated = self.at(TokenKind.minus) and (self.peekKind() == TokenKind.intLiteral or self.peekKind() == TokenKind.floatLiteral)
		if negated 'consumeSign'
			try self.consume(TokenKind.minus)
		end 'consumeSign'

		// A float rides as its IEEE-754 BIT PATTERN, the one spelling every float in this compiler travels in
		// — and a leading `-` is a SIGN FLIP into the literal (`negatedFloatBits`), never `0.0 - x`, which is
		// how `-0.0` keeps its sign (see the float raw value's own arm in `readEnumCaseInto`).
		if self.at(TokenKind.floatLiteral) 'floatValue'
			let floatTok = try self.consume(TokenKind.floatLiteral)
			let magnitude = try self.floatLiteralBits(floatTok)
			return EnumBackingFieldValue.literal(negatedFloatBits(magnitude) if negated else magnitude, kind: EnumBackingLiteralKind.floatLiteral)
		end 'floatValue'

		if self.at(TokenKind.intLiteral) 'intValue'
			let intTok = try self.consume(TokenKind.intLiteral)
			return EnumBackingFieldValue.literal(try self.intLiteralValue(intTok, negated: negated), kind: EnumBackingLiteralKind.integerLiteral)
		end 'intValue'

		// A bool's payload IS 0 or 1 (`TypeRules.BoolTrueValue`), which is what lets it share the `literal`
		// arm's `ParsedInt` with an int rather than needing a truth column of its own — the same identity the
		// constant folder rests on (`foldConstBinOp`'s `and`/`or` note). WHICH literal it was still rides
		// beside the bits, because that is what the door type-checks against the field.
		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolValue'
			let isTrue = self.at(TokenKind.true)
			self.advance()
			return EnumBackingFieldValue.literal(BoolTrueValue if isTrue else BoolFalseValue, kind: EnumBackingLiteralKind.booleanLiteral)
		end 'boolValue'

		// ⭐ `Priority.low` — and the case name is read by `consumeNameToken(NamePosition.enumCase)`, the very
		// reader the DECLARATION of a case goes through, so a KEYWORD-spelled case (`Cat.bool`, `Cat.int`)
		// resolves here exactly as it declares. A strict `identifier` here is the mis-parse the spec's
		// `struct-backing-keyword-enum-case-field` case exists to catch, and the shape shv2's own `StdType`
		// enum would write (`CastCategory.bool`).
		if self.at(TokenKind.identifier) and self.peekKind() == TokenKind.dot 'enumCaseValue'
			let enumTok = try self.consume(TokenKind.identifier)
			try self.consume(TokenKind.dot)
			let memberTok = try self.consumeNameToken(NamePosition.enumCase)
			return EnumBackingFieldValue.enumCase(enumTok.value, caseName: memberTok.value)
		end 'enumCaseValue'

		let tok = self.current()
		throw ParseError.unsupported("`{tokenDisplayText(tok)}` as a field value of the `{String.from(typeTok.value)}` backing — a case's backing is a COMPILE-TIME constant, so each field is an integer, float or boolean literal, a `<Enum>.<case>` reference, or a nested constant of the field's own `type` written as a literal or a factory call. A named top-level constant cannot be reached at all: this runs inside the declaration sweep that builds the index one would be resolved through", line: tok.line, column: tok.column)
	end 'readEnumBackingFieldValue'

	// The codepoint a CHARACTER raw value denotes.
	//
	// ⛔ A multi-codepoint grapheme cluster (a ZWJ family emoji, a flag) is a `Character` and nothing else —
	// it has no integer reading (`CharLiteralCodepoint.cluster`) — so it cannot be an enum tag. Refused here
	// rather than silently stored as its first codepoint, which would make two different clusters one case.
	function enumCharacterRawValue(literalTok Token) returns ParsedInt throws ParseError
		match try self.charLiteralCodepoint(literalTok) 'decoded'
			codepoint(value) then return value
			cluster then throw ParseError.unsupported("a character raw value that is a multi-codepoint grapheme cluster ('{String.from(literalTok.value)}') — an enum case's tag is one integer, and a cluster has no integer reading", line: literalTok.line, column: literalTok.column)
		end 'decoded'
	end 'enumCharacterRawValue'

	// Parse a payload field list `(name Type, name2 Type2)` for a `union`/`enum` case, into a
	// `PayloadField` array in slot order. Shared by the real parse and the tolerant sweep, so it
	// captures types WITHOUT rejecting the managed/float ones — see `readEnumCaseInto`'s payload arm
	// for why a rejection here would corrupt the sweep. `parseTypeReference` is the same type reader
	// a struct field and a parameter use, so a payload's type is spelled by one grammar.
	function readPayloadFieldsInto() returns PayloadFieldArray throws ParseError
		try self.consume(TokenKind.leftParen)
		var fields = PayloadFieldArray.create()

		while true 'fieldLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			// A `__`-prefixed field is reserved, at the name, exactly as a struct field's is
			// (`readStructFieldInto`). The tolerant sweep swallows the throw and leaves the diagnostic
			// to the real parse.
			try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
			let typeTok = self.current()
			// ⭐ **THE PAYLOAD's PRE-ERASURE SPELLING (BATCH22)** — asked at the cursor, which sits on the
			// type's first token, for the reason a struct field asks it there: `parseTypeReference` on the
			// next line folds `__ManagedMemory` into the very `genericInstance` a `ByteArray` payload
			// resolves to. Captured in this ONE shared reader, so the tolerant sweep's layout — the
			// whole-program one every read door consults — and the real parse's carry the identical word.
			//
			// ⚠ A tuple SLOT's element bit is held clear (`slotElementsFromAliases: false`) for
			// `readStructFieldInto`'s reason: the SWEEP fills this column while the alias table is still
			// being built, so a slot's element bit read there answers *how far the sweep had got*. The
			// ROOT keeps asking, because `ProgramSignatures.payloadSurfaceOf` ORs in the complementary
			// derivation; see `declaredSurfaceAt`.
			let declaredSurface = self.declaredSurfaceAt(self.pos, slotElementsFromAliases: false)
			let fieldType = try self.parseTypeReference()
			try self.requireStorableDeclaredType(fieldType, position: DeclaredStoragePosition.unionPayload, line: typeTok.line, column: typeTok.column)
			fields.push(PayloadField.create(nameTok.value, declaredType: fieldType, declaredSurface: declaredSurface))

			if not self.at(TokenKind.comma) 'endFields'
				break
			end 'endFields'
			try self.consume(TokenKind.comma)
		end 'fieldLoop'

		try self.consume(TokenKind.rightParen)
		return fields
	end 'readPayloadFieldsInto'

	// Read the token that NAMES a case — an identifier, a keyword used as one, or the string/char
	// LITERAL of an implicitly-backed case (`"North"`, `'N'`), which names the case through the value it
	// carries. The literal is returned as it stands and the name derived from it by `enumCaseNameOf`,
	// because the caller needs BOTH halves of it: the name it declares and the raw value it fixes.
	function readEnumCaseNameToken() returns Token throws ParseError
		if tokenKindIsEnumLiteralBacking(self.current().kind) 'implicitlyBacked'
			let tok = self.current()
			self.advance()
			return tok
		end 'implicitlyBacked'

		return try self.consumeNameToken(NamePosition.enumCase)
	end 'readEnumCaseNameToken'

	// ⭐ **THE NAME A CASE'S HEAD TOKEN DECLARES.** An identifier (or a keyword used as one) declares
	// itself; a string/char literal in that position declares the case named by its DECODED CONTENT, so
	// `"North"` is the case `StringBacked.North` and `'N'` is `CharBacked.N`. The decode is the same one
	// the value paths use, so an escape means here exactly what it means in an expression.
	function enumCaseNameOf(nameTok Token) returns ByteArray throws ParseError
		if nameTok.kind == TokenKind.stringLiteral 'stringBacked'
			return try self.decodedStringLiteralBytes(nameTok)
		end 'stringBacked'

		if nameTok.kind == TokenKind.charLiteral 'charBacked'
			return try self.charLiteralBytes(nameTok)
		end 'charBacked'

		return nameTok.value
	end 'enumCaseNameOf'

	// Parse an INTEGER raw value (`= 200`, `= -1`) — the same literal reading `parseRangeBound` does,
	// minus the type-qualified bounds a raw value cannot be. Every other backing is claimed before this is
	// reached — the string and char ones by `appendLiteralBackedEnumCase`, a struct by
	// `appendStructBackedEnumCase`, a function reference by `appendFunctionBackedEnumCase` — so what arrives
	// here is a token no raw value may open with at all.
	function readEnumIntRawValue() returns ParsedInt throws ParseError
		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: true)
		end 'negative'

		if self.at(TokenKind.intLiteral) 'literal'
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: false)
		end 'literal'

		let tok = self.current()
		throw ParseError.unsupported("a raw value of kind '{tok.kind.rawValue}' (a raw value is an integer, a float, a string, a character, a function reference, or a constant struct)", line: tok.line, column: tok.column)
	end 'readEnumIntRawValue'

	// ⭐ **FIX THE LAYOUT'S BACKING TO `kind`, OR RAISE E3032 IF A DIFFERENT ONE WAS ALREADY FIXED.** The
	// backing is settled by the FIRST case and every later one must agree with it, so the rule is one
	// comparison and the message is `expected <established>, got <incoming>` — the bootstrap's phrasing
	// (`2-Parser.cs:4365-4412`), rendered from `enumBackingNoun` so the four backings cannot be worded
	// differently at different doors. `caseTok` positions the diagnostic: the bootstrap anchors a mismatch
	// at the offending case, not at its raw value.
	//
	// ⚠ It replaced a `requireIntBacking`/`requireFloatBacking` PAIR whose two hard-coded sentences were the
	// same fact written twice — which at four backings would have been twelve.
	//
	// ⭐⭐ **A STRUCT BACKING IS FIXED BY *TWO* FACTS, AND BOTH ARE SETTLED HERE.** `= Meta{…}` fixes the kind
	// AND the struct type; a later `= Other{…}` agrees on the kind and disagrees on the type, which is the
	// same E3032 in the same words (*"expected Meta, got Other"* — the reference spells that sentence at a
	// site of its own, `maxon-selfhosted/Compiler/Parser.maxon:5505`, and this is the same one comparison).
	// `structName` is `EmptySourceText` for every other backing, which is exactly what the layout already
	// holds, so the assignment below writes both fields in one act for every kind of case.
	function requireEnumBacking(layout EnumLayout, kind EnumBacking, structName ByteArray, caseTok Token) throws ParseError
		let kindDisagrees = layout.backing != EnumBacking.unresolved and layout.backing != kind
		let structDisagrees = layout.backing == kind and not layout.backingStructName.equals(structName)
		if kindDisagrees or structDisagrees 'mismatch'
			throw ParseError.enumRawValueTypeMismatch("expected {enumBackingNoun(layout.backing, structName: layout.backingStructName)}, got {enumBackingNoun(kind, structName: structName)}", line: caseTok.line, column: caseTok.column)
		end 'mismatch'

		layout.backing = kind
		layout.backingStructName = structName
	end 'requireEnumBacking'

	// Append a case after checking E3031 (duplicate raw value) — a linear scan of the cases recorded so
	// far, positioned at the offending case. `rawValue` is how the value is written (the int, the float's
	// source text, the string's or character's decoded content), which is what the message prints and what
	// the layout records for a string backing (see `EnumLayout.rawValueCollidesAt`, which owns the compare).
	// ⭐ `declaresRawValue` is spelled by every caller rather than derived here, and `appendAutoTaggedEnumCase`
	// is the ONE that says `false` — it is the only reader that consumes no literal. Deriving it from
	// `rawValue` is not open: an auto-tagged case records `"{tag}"`, which is byte-identical to what
	// `red = 0` records. See `EnumLayout.declaresRawValues` for what the bit decides.
	function appendEnumCase(layout EnumLayout, caseName ByteArray, tag ParsedInt, rawValue String, declaresRawValue bool, caseTok Token, payloads PayloadFieldArray, backingFields EnumBackingFieldArray) throws ParseError
		for i in 0 upto layout.caseCount() 'eachExisting'
			if layout.rawValueCollidesAt(i, tag: tag, rawValue: rawValue) 'duplicateRawValue'
				throw ParseError.enumDuplicateRawValue(rawValue, line: caseTok.line, column: caseTok.column)
			end 'duplicateRawValue'
		end 'eachExisting'
		layout.addCase(caseName, tag: tag, rawValue: rawValue, declaresRawValue: declaresRawValue, payloads: payloads, backingFields: backingFields)
	end 'appendEnumCase'

	// One member of a type body that is not a field: `[export] [static] function …`.
	//
	// ⭐ **`static` IS THE WHOLE DIFFERENCE, AND IT IS ONE BOOLEAN.** A `static function create()`
	// is a free function with a qualified name; a `function area()` is the same thing plus a
	// RECEIVER — `__self` at parameter 0, and every field of the enclosing type bound by name so a
	// bare `width` inside it means `self.width`. Both are built by the same `parseFunction`,
	// because a method IS a function: there is no method table and nothing for a call to dispatch
	// through. `enclosingType` supplies the qualification and is already set.
	//
	// The receiver is passed down as a flag and NOT recorded as one: `parseFunction` turns it into
	// a parameter named `SelfParamName` at position 0, and every later reader asks
	// `FuncSignature.takesReceiver`, which reads that name back. See there — one fact, one home.
	//
	// ⭐ **`static` ALSO PREFIXES A `let`/`var`, WHICH DECLARES MODULE STORAGE RATHER THAN A MEMBER (W65)** —
	// see the `staticBinding` arm below. `memberList` is what tells the two bodies that reach this reader
	// apart: a `type` body may declare it, an `extension` body may not.
	function parseTypeMember(memberList MemberList) throws ParseError
		let visibility = try self.consumeOptionalVisibility()

		let isStatic = self.at(TokenKind.static)
		if isStatic 'staticMember'
			self.advance()
		end 'staticMember'

		// ⭐⭐ **`static var count = 0` / `static let MAX = 100` — A TYPE-QUALIFIED TOP-LEVEL BINDING (W65).**
		// It is not a field and takes no slot in the instance layout (`atStructFieldKeyword` never sees it —
		// that predicate looks past a VISIBILITY modifier, not past `static`); it is one copy for the TYPE,
		// which is exactly what a top-level binding already is. So it is READ by the top-level binding reader
		// and REPORTED by the top-level binding's own failure door, under the name `Counter.count` — the whole
		// mechanism, and the reason nothing downstream of the parser learned that static members exist.
		//
		// ⚠ The cursor sits on `let`/`var` here — `static` is consumed above — which is precisely where
		// `readTopLevelBinding` expects to begin, so the sweep's arm and this one enter it identically.
		if self.atTopLevelBindingKeyword() 'staticBinding'
			try self.requireMemberListDeclaresStorage(memberList)
			try self.raiseBindingFailure(try self.readTopLevelBinding(visibility, qualifier: self.enclosingType))
			return
		end 'staticBinding'

		// A NESTED (inner) typealias (P1.6-C) — `export typealias Idx = int(0 to u64.max)`. The
		// `export` (visibility) is already consumed above; a nested typealias takes no `static`. Its
		// visibility is inert for the per-instance forms at this rung (an inner alias erases to `integer`, so
		// it names no cross-file value).
		if self.at(TokenKind.typealias) 'nestedTypeAlias'
			if isStatic 'staticInnerAlias'
				let tok = self.current()
				throw ParseError.unsupported("a nested typealias cannot be `static` — it is a per-type declaration, not a member function", line: tok.line, column: tok.column)
			end 'staticInnerAlias'

			// The three PER-INSTANCE forms are keyed whole-program by the sweep (`innerAliases`/`genericAliases`
			// /`tupleAliases`) and the real parse needs only the local `enclosingInnerAliases` population
			// `readNestedTypeAlias` performs — so their shapes are discarded here, and the TUPLE form's owner is
			// `unpublished` for the same reason (the sweep already keyed it, from the same tokens). A FUNCTION
			// alias's declared SIGNATURE lives only in the real parse's artifact (`readFunctionTypeAlias`'s
			// `recordSignature` note), so it is filed here in the array a top-level `typealias Fn = function(…)`
			// files into — under BOTH of the names it declares, exactly as the sweep files it
			// (`publishNestedFunctionAlias`). This is the copy every consumer of a PARAMETER type reads, so a
			// qualified key filed by the sweep alone would carry the return type and an empty parameter list.
			match try self.readNestedTypeAlias(visibility, recordFunctionSignature: true, tupleOwner: TupleAliasOwner.unpublished) 'nested'
				ranged to tupleAlias then return
				functionAlias(alias) then self.publishNestedFunctionAlias(alias, into: self.artifact.functionTypeAliases)
			end 'nested'
			return
		end 'nestedTypeAlias'

		if not self.at(TokenKind.function) 'notFunction'
			let tok = self.current()
			throw ParseError.unexpectedToken(TokenKind.function.rawValue, got: tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'notFunction'

		try self.parseFunction(visibility, takesReceiver: not isStatic)
	end 'parseTypeMember'

	// ⭐ **ONLY A `type` BODY MAY DECLARE STORAGE (W65).** An `extension` adds BEHAVIOUR to types other
	// declarations named — its members are re-parsed once per conformer — so a binding written there has no
	// declaration to belong to and no single file that owns its slot. This is the refusal the member-list
	// header already promised back when the reader simply had no `let`/`var` arm to reach; opening that arm
	// for a `type` body is what makes it a rule that has to be stated.
	//
	// ⚠ **AND IT MUST STAY A REFUSAL RATHER THAN BECOMING A FEATURE HERE, because the SWEEP cannot record
	// it.** `recordScannedExtension` consumes an extension declaration whole and cannot know its conformer
	// list (the conformance index is what that sweep is building), so a binding admitted here would be one
	// the sweep never filed — and `declaredOutcome`'s drift guard PANICS on exactly that, on a program with
	// no error in it. Neither reference declares storage in an extension either.
	//
	// ⚠ **A BARE `let`/`var` (no `static`) REACHES THIS TOO, AND ONLY FROM AN EXTENSION.** In a `type` body
	// `atStructFieldKeyword` claims it as a FIELD one door up, so a member list reaching the `staticBinding`
	// arm at all is either an extension's or carries the `static` the arm is named for. The message names
	// the keyword the author wrote, so both spellings read as the mistake they are.
	function requireMemberListDeclaresStorage(memberList MemberList) throws ParseError
		if memberList == MemberList.typeBody 'aTypeBody'
			return
		end 'aTypeBody'

		let tok = self.current()
		throw ParseError.unsupported("a `{tok.kind.rawValue}` declaration in an `extension` body — an extension adds methods to types other declarations named and declares no storage of its own, so there is no type for this binding to belong to; declare it in the `type` body as a `static {tok.kind.rawValue}`", line: tok.line, column: tok.column)
	end 'requireMemberListDeclaresStorage'

	// Parse a function: `[static] function <name>(<params>) [returns <Type>] <body> end
	// [label]`. M5 adds parameters (`name type`, comma-separated); there is still no
	// `main` qualification (single-file build), so the declared name is used verbatim
	// for registry keys — `main` stays `main`. P1.0r adds the ONE qualification there is:
	// a function declared inside a `type` body is `Point.create` (`declaredMethodName`).
	//
	// `takesReceiver` is set by the two doors that read a MEMBER declaration — `parseTypeMember` for a
	// member with no `static`, and `parseEnumMethod` unconditionally (D1: an `enum`/`union` refuses a
	// `static`, so its every method is an instance one). It adds ONE thing — a leading parameter — and
	// everything else about an instance method follows from that, through machinery that already existed:
	// the call is an ordinary direct call, the receiver is an ordinary argument, `slotCallArgs` slots it at
	// position 0 because it is positional, and the register ABI hands it to the callee in argument
	// register 0.
	function parseFunction(visibility Visibility, takesReceiver bool) throws ParseError
		try self.consume(TokenKind.function)
		// ⭐ A KEYWORD MAY BE THE DECLARED NAME (D8) — `export static function from (path String)` is
		// `stdlib/FilePath.maxon:34`. Nothing but a name may stand here, so a keyword written here is one;
		// see `consumeNameToken`. The token scans that re-derive block structure learn the same fact through
		// `keywordIsAName`'s declaration-name shape, or a `function while(…)` would read as a block nothing
		// closes.
		let nameTok = try self.consumeNameToken(NamePosition.declaration)
		// The BARE name only — a method's `Type.` qualification is applied below by
		// `declaredMethodName`, so `Point.create` is checked as `create` and the reserved test never
		// sees the type prefix (`Self` is fine; a `__method` name is not).
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		// `Point.create` inside `type Point`, the bare token at file scope. The SAME derivation the
		// declaration sweep records the signature under, so the key an `IrFunction` carries and the
		// key `mintCallResult` types a call from are one name — for the FIRST declaration of it. A later
		// OVERLOAD of the same name registers under a mangled variant of this one (`overloadRegistrationName`
		// below), while the sweep keeps publishing the BARE name; the two are reconciled at the call site by
		// `SemanticCheck.resolveOverloadedCalls`.
		//
		// ⚠ **"THE SWEEP CANNOT SEE PARAMETER TYPES" WAS THE SENTENCE HERE AND IT IS NO LONGER TRUE.** It
		// publishes each declaration's parameter types beside its return type
		// (`ProgramSignatures.overloadedDeclsOf`), which is what lets a call read the return type of the
		// overload it MEANS. What it still keys by the bare name is the return type ITSELF and the four
		// ownership/ABI facts `requireOverloadableName` refuses on — so the registration name a declaration
		// takes is still the parser's, and the sweep's tables are still one entry per key.
		let sourceName = self.declaredMethodName(nameTok)

		// Parameters are parsed into parallel name/type lists BEFORE the scope reset:
		// binding them needs the fresh per-function scope + value numbering, which is
		// re-seeded at the resulting paramCount just below. Parsing itself only
		// consumes tokens, so it needs no scope.
		var paramNames = ByteArrayArray.create()
		var paramTypes = MaxonTypeArray.create()
		// Parallel to `paramNames`: each parameter's name-token span, so `bindParameters` can
		// record a ValueOrigin at the DECLARATION for parameter `i` — the source site the
		// E5001 diagnostic points at when a parameter is in a register-pressure blocking set.
		var paramRanges = SourceRangeArray.create()
		// Parallel to `paramNames` too: whether the parameter's DECLARED TYPE spelled `__ManagedMemory`
		// (A2j) — the fact `parseTypeReference` is about to erase, read by `bindParameters` below.
		var paramSurfaces = DeclaredSurfaceArray.create()
		// And parallel again: the INDEX of each parameter's declared-type first token (W57) — the position the
		// `with` arguments of a parameterized-interface type are still readable at, erased by the same call and
		// read by the same `bindParameters`.
		var paramTypeStarts = TokenIndexColumn.create()

		// ⭐ **THE RECEIVER IS AN ORDINARY PARAMETER, PUSHED FIRST.** That is the entire mechanism:
		// it occupies position 0, so it is ValueId 0 by the same Std-ABI seeding every parameter
		// gets, and no part of the call path, the lowering or the backend learns that methods
		// exist. It is pushed BEFORE `parseFunctionParameters` so the user's own parameters land
		// after it — which also means the receiver is inside the ABI count `requireAbiParamCount`
		// judges, correctly: it occupies an argument slot exactly like a declared parameter.
		//
		// It is typed by `enclosingSelfType` — the same `Self` means here, through the same routine that
		// resolves the `Self` keyword, so a receiver and a `returns Self` cannot come to disagree about
		// which type encloses them, NOR about whether that type is a struct or an enum (D1): a struct's
		// receiver is a `structRef` and an enum's is a `named`, which is what routes each to its own
		// dispatch at the call site.
		//
		// Its span is the METHOD NAME, because no source token declares it. That is the choice
		// `closeFunctionBody` makes for its synthetic `retVoid` and for E3013, and for the same
		// reason: the name is where a reader looks when something about the function's own shape is
		// at fault.
		if takesReceiver 'receiverParam'
			paramNames.push(SelfParamName)
			paramTypes.push(try self.enclosingSelfType(nameTok))
			paramRanges.push(SourceRange.ofToken(nameTok))
			// The receiver is typed by `enclosingSelfType`, never by a source spelling, so it can never be
			// the buffer alias — but it occupies position 0 and every column here is indexed by position.
			paramSurfaces.push(sharedEmptyDeclaredSurface)
			// Nor is it declared at a type any token spells (W57), and its slot must therefore hold an index that
			// names no type BY TOKEN KIND rather than by a claim about what some name means. The cursor has not
			// moved past the signature's `(` yet, so `self.pos` is that `(` — and `declaredExistentialInstanceAt`
			// declines anything but an identifier. (The method NAME would have been the natural choice, matching
			// this parameter's `paramRanges` span, and it is the wrong one: a method named the same as a generic
			// alias would resolve, and an `extension <interface>` receiver IS existential-tagged, so the slot is
			// not unreachable.)
			paramTypeStarts.push(self.pos)
		end 'receiverParam'

		try self.consume(TokenKind.leftParen)
		// The height BEFORE the list is read, so `claimDefaultHelpersForRegistrationName` below can tell this
		// declaration's own captures from every earlier one's — see there, and `DefaultHelperOwner`.
		let firstPendingDefault = self.pendingDefaultHelpers.count()
		// ⭐⭐ **THE OWNER IS THE KEY THE SWEEP FILED THIS DECLARATION'S DEFAULTS UNDER, NOT THE NAME THE
		// SOURCE WROTE (W75).** They differ for exactly one shape — a `static` member whose name an instance
		// member of its type also wears — and there the two members are two keys, `m` and `m#__static`, with a
		// set of defaults each. Asked under the source name, the static's own drain would read the INSTANCE's
		// shape out of the by-name registry. `memberRegistrationKey` is the one composition of that contest,
		// so this is a lookup rather than a second derivation.
		let sweptOwnerName = self.signatures.memberRegistrationKey(sourceName, takesReceiver: takesReceiver)
		try self.parseFunctionParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges, paramSurfaces: paramSurfaces, paramTypeStarts: paramTypeStarts, owner: ParamDefaultOwner.declaredFunction(sweptOwnerName), paramTypeHint: ClosureParamTypeHint.none)
		try self.consume(TokenKind.rightParen)

		// ⭐ **A STRUCT PARAMETER OR RETURN TYPE IS RE-TAGGED `structRef` HERE**, in the real parse where
		// the whole-program struct registry is complete — the step `parseTypeReference` could not take in
		// the tolerant sweep (see `resolveNamedStruct`). Both lists are rewritten BEFORE anything reads
		// them: the value-tag seeding below, `bindParameters`, `func.maxonParamTypes`, the recorded
		// signature, and `parseReturnStatement`'s declared-type check all then see a struct as a struct.
		paramTypes = self.resolveNamedStructAll(paramTypes)
		// The return type's pre-erasure spelling (A2j), read through the same one reader the SWEEP reads it
		// through, so the two passes cannot form two opinions of what `returns __ManagedMemory` means — the
		// property `parseOptionalReturnType` is shared for. This copy reaches `project.funcReturnTypes`.
		let declaredReturnSurface = self.returnDeclaredSurface()
		// Captured BEFORE the clause is consumed, for `paramTypeStarts`' reason one column over (W57/W58): the
		// resolved type is exactly where the `with` arguments stop existing, so the token is what survives.
		let returnTypeStart = self.returnTypeTokenIndex()
		let returnType = self.resolveNamedStructReturn(try self.parseOptionalReturnType())
		// The `throws E` clause (P1.4b) — stamped onto the function so the body parse (`throw`/propagate)
		// and the lowering (`ret` → `errorReturn` inside a throwing function) can read it off `func`.
		let throwsClause = try self.parseOptionalThrowsClause()

		try self.requireSignatureLineEnd()

		// ⭐ **THE NAME EVERY REGISTRY BELOW IS KEYED BY** — the source name for the first declaration of it,
		// a mangled variant for a later overload (D7). Decided HERE: the parameter list is complete and
		// struct-resolved, and nothing has yet been recorded under a name.
		let name = try self.overloadRegistrationNameFor(sourceName, paramTypes: paramTypes, paramNames: paramNames, takesReceiver: takesReceiver, nameTok: nameTok)
		// ⭐ **AN OVERLOAD MEMBER'S DEFAULTS FOLLOW ITS REGISTRATION NAME (W74)** — the sweep published one
		// helper name for the whole set, and each member has to emit a helper of its own.
		self.claimDefaultHelpersForRegistrationName(firstPendingDefault, sourceName: sweptOwnerName, registrationName: name)

		// Fresh per-function value numbering, seeded at the function's paramCount so
		// parameter ids occupy 0..paramCount-1 by Std-ABI convention (a body value
		// then starts at paramCount — see IrValueId's ValueIdRef contract). The value-TYPE
		// column is seeded in lockstep, with the parameters' declared types, so
		// `valueTypes[i]` is parameter `i`'s type from the very first lookup.
		//
		// ⭐ **THE UNIFORM ABI APPENDS A COMPANION ENVIRONMENT PARAMETER PER FUNCTION-TYPED PARAMETER
		// (P1.5-A2b-2).** A value passed DOWN to a `function`-typed parameter carries an environment (a
		// capturing closure's block, or null); this function's own `f(x)` call threads it, so the environment
		// must arrive as a parameter. The companions are appended AFTER the user parameters — so every user
		// parameter keeps its own ABI position and the call machinery needs no source-slot→ABI-slot remap — and
		// the full count reserves their ValueIds here so the body numbers after them. `maxonParamTypes` and the
		// recorded signature keep the USER parameters only (an env companion is a lowering detail, never a
		// source argument); `LowerMaxonToStd.transferFuncs` grows the Std parameter list to match `paramCount`.
		let userParamCount = paramNames.count()
		// ⭐ **A GENERIC METHOD THAT READS `sizeof(T)` NEEDS A HIDDEN LAYOUT-DESCRIPTOR PARAMETER**
		// (P1.6-B1, the dictionary). It is reserved HERE — before value numbering — as ONE extra trailing
		// slot, so its ValueId lands in `[0, paramCount)` and the backend's param-capture clobber guard
		// (`ParamCrossForbid`, which only protects `vid < paramCount`) covers it exactly like a user
		// parameter; a fresh id past the dense space would be left unprotected and could be clobbered by a
		// sibling capture. The need is the TRANSITIVE fixpoint `Queries.foldDescriptorNeeds` solved for the whole
		// program (direct `sizeof(T)` OR a self-call to a sibling that needs one), keyed by the qualified method
		// name — decided BEFORE the body is parsed, because the slot must be reserved before any
		// body value is numbered. `LowerMaxonToStd` detects the reserved slot by param count, so a caller
		// appends the descriptor argument for exactly the methods that carry the param.
		// ⭐⭐ **THE WHOLE-PROGRAM ANSWER, NOT A PER-TYPE-BODY ONE (W23c).** The gate used to be
		// `enclosingTypeParams` non-empty, and that field is deliberately EMPTY inside an INTERFACE
		// extension's body (`openExtensionBodyScope` argues why), so the question could not even be asked for
		// the methods that most needed it. `anyFunctionNeedsLayoutDescriptor` opens it because the qualified
		// name has to be BUILT to ask, and a program with no generic type — the whole scale corpus — must not
		// pay an allocation per method declaration to learn `false`.
		var needsLayoutParam = false
		if self.signatures.anyFunctionNeedsLayoutDescriptor() and not self.enclosingType.isEmpty() 'aMethodOfSomeType'
			needsLayoutParam = self.signatures.functionNeedsLayoutDescriptor(qualifiedMethodName(self.enclosingType, methodName: nameTok.value))
		end 'aMethodOfSomeType'
		// ⭐⭐ **THE FIXED-ELEMENT-COUNT SLOT (W190)** — reserved on exactly the terms above, off the same
		// whole-program fixpoint under the same qualified name, and INDEPENDENTLY of the descriptor: a method
		// that reads only `countof(Self)` needs no dictionary word at all, so making the count imply a
		// descriptor would demand one from every frame that calls it — including the frames that have none.
		// MEASURED: `Holder.size()` calling `capacity()` on its `Vector with 4 Element` field aborts the
		// compiler when the callee reserves a descriptor, because no edge gives `Holder.size` one to forward.
		var needsCountParam = false
		if self.signatures.anyFunctionReadsFixedElementCount() and not self.enclosingType.isEmpty() 'aMethodOfSomeTypeReadsACount'
			needsCountParam = self.signatures.functionReadsFixedElementCount(qualifiedMethodName(self.enclosingType, methodName: nameTok.value))
		end 'aMethodOfSomeTypeReadsACount'

		// ⛔ **A RECEIVERLESS (static) LAYOUT-NEEDING function must RETURN `Self` (P1.7 slice 3b-i).** A `static`
		// has no `self` to carry the type parameter's layout descriptor; a caller sources it instead from the
		// call's RESULT, which is the concrete instance ONLY when the static returns the enclosing type
		// (`create() returns Self`, retyped by `retypeGenericAliasConstructorResult`). A static that constructs an
		// opaque `Array` (or reads `sizeof(T)`) but returns some other type leaves the caller no descriptor
		// source, so `materializeStaticConstructorLayout` would panic on the non-instance result — reject it here
		// cleanly, the way a receiverless `sizeof(T)` body is. An instance method sources it from `self`, so this
		// is gated on `not takesReceiver`.
		// ⭐⭐ **AN INTERFACE RETURN TYPE IS THE SECOND WRITER OF THE ONE SECONDARY RETURN REGISTER (P1.7a
		// slice 2, the return ABI).** A non-throwing function hands the witness half back in exactly the
		// register a throwing one spends on the error flag — same register convention, same op shape
		// (`StdOp.errorReturn` / `StdOp.tryCall`), which is `functionUsesSecondaryReturnSlot`'s whole content.
		// There is ONE such register, so a function that is BOTH is refused here: no third slot exists, and
		// the alternative is v1's, which SILENTLY SKIPS its return-witness path and hands back a bare pointer.
		if throwsClauseIsThrowing(throwsClause) 'theErrorFlagAlreadyOwnsTheSecondRegister'
			match returnType 'declaredReturn'
				void then break 'declaredReturn'
				value(inner) then try self.requireStorableDeclaredType(inner, position: DeclaredStoragePosition.throwingReturnType, line: nameTok.line, column: nameTok.column)
			end 'declaredReturn'
		end 'theErrorFlagAlreadyOwnsTheSecondRegister'

		// ⚠ **THE COUNT SLOT IS SOURCED THE SAME WAY AND SO CARRIES THE SAME REFUSAL (W190).** A static has no
		// receiver whose instance states the count; the only instance a caller can read one off is the static's
		// own RESULT, and that is a concrete instance only when the static returns `Self`. ONE refusal for both
		// slots, because it is one rule about where a receiverless callee's dictionary comes from — and
		// `countof(Self)` in a static is exactly the shape this rung exists to serve (`Vector.create()`), so
		// this arm must ADMIT it rather than refusing it the way `parseSizeof` refuses a receiverless
		// `sizeof(T)`. That is the one place `countof`'s door deliberately differs from `sizeof`'s: `sizeof`
		// asks whether `__self` is in scope, which no static can answer yes to, while this asks whether the
		// call site has anything to source the answer FROM — and a `returns Self` static does.
		if (needsLayoutParam or needsCountParam) and not takesReceiver and not self.returnsEnclosingType(returnType) 'staticLayoutNeedsSelfReturn'
			throw ParseError.unsupported("a `static function` that needs the enclosing instance's dictionary — it constructs an opaque type-parameter `Array` (`ElementArray.create()`), reads `sizeof` of the type parameter, or reads `countof` of the sized container's own `Self` — must return `Self` so the caller can source it from the instance the static builds; a static returning any other type has no source (build the array, read the size or read the count through an instance method on `self`, or return `Self`). Threading a dictionary from a static call site's alias is a later slice", line: nameTok.line, column: nameTok.column)
		end 'staticLayoutNeedsSelfReturn'

		// The reservation the body's opaque drops will be checked against (W10) — recorded here, where the
		// decision is made, and re-armed per function so a previous method's answer cannot stand in for this one.
		self.functionCarriesLayoutParam = needsLayoutParam
		self.functionCarriesFixedElementCountParam = needsCountParam
		self.functionDroppedOpaqueWithoutDescriptor = false
		self.functionStoredOpaqueWithoutDescriptor = false

		let layoutParamCount = 1 if needsLayoutParam else 0
		// ⭐ The count slot sits BETWEEN the layout descriptor and the witnesses:
		// `[user][env][existentialWitness][layout][count][witness_0..k]`. After the descriptor because it is the
		// newer slot and appending moves nothing; before the witnesses because `bindImplicitParams` and
		// `appendWitnessArgs` both address the witness block from the END of the list.
		let countParamCount = 1 if needsCountParam else 0
		// ⭐ **A HIDDEN WITNESS PARAMETER PER `where` CONSTRAINT (P1.7a slice 2a, the dictionary's dispatch
		// half).** An INSTANCE method of a constrained generic type carries one witness pointer per constraint,
		// TRAILING after every other hidden block: `[user][env][existentialWitness][layout][count][witness_0..k]`, index-aligned to
		// `enclosingWhereConstraints`. The reservation is UNCONDITIONAL on instance methods (not gated on
		// whether this method actually dispatches), so the type's instance-method ABI is uniform and every
		// caller passes the witnesses; a `static function` carries none (it has no `self` to source a witness
		// from, and a static that dispatches is a later slice). `LowerMaxonToStd` splits layout from witness by
		// this same rule (the enclosing type's constraint count + `takesReceiver`), so the count is derivable
		// whole-program without a per-function field.
