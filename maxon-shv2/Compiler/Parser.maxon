			self.recordValueType(MaxonType.integer)
			self.artifact.recordParamOrigin(layoutDescriptorSlotValueId(paramCount, witnessParamCount: witnessParamCount, fixedElementCountSlots: countParamCount), range: SourceRange.ofToken(nameTok))
		end 'seedLayoutParam'

