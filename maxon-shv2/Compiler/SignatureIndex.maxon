//
// ⚠ The `__` prefix is what keeps this name out of user source (`requireUnreservedName`, E2051) — the same
// reason the file/directory/memory families wear it, and the reason `ArrayError` (which cannot, because the
// corpus spells it) needed a place in `isCompilerOwnedTypeName` instead.
export let DivisionByZeroErrorTypeName = b"__DivisionByZeroError"

// The single case name. Its ordinal is 0 because it is the enum's first (and only) case, which the layout
// DERIVES from declaration position (`addBuiltinEnumCase`) and `verifyDivisionByZeroOrdinals` holds the
// lowering's transcription to.
export let DivisionByZeroCaseName = b"divisionByZero"

// Its one field, per the spec's "Type Structure". Unexported and immutable: the corpus never reads or writes
// it — `__ManagedDirectory{_block: 0}` is E3072 (`managed-directory.error-direct-construction`) precisely so
// the block pointer cannot be forged — and the runtime reaches it through `ManagedDirectoryBlockOffset`.
export let ManagedDirectoryBlockFieldName = b"_block"
export let ManagedDirectoryBlockFieldIndex = 0 as FieldIndex

// The builtin alias for a `CharacterSet`'s member set — the reference's own `typealias CharSet =
// Set with Character` (`stdlib/CharacterSet.maxon:19`), which `CharacterSet.from` takes and the corpus
// spells (`specs/unicode-category.md:121`). Registered by `registerCharacterSetType`.
export let CharacterMemberSetAliasName = b"CharSet"

// Its two fields, in the reference's own declaration ORDER — which IS the layout, since
// `StructLayout.offsetOfField` derives an offset from the index (`stdlib/CharacterSet.maxon:23-24`). Both
// are `let` and unexported there, and nothing reads them through a field access here: the front end never
// loads either, and the runtime writes them through `CharacterSetRuntime`'s own constants. The layout
// exists to give the type a NOMINAL identity and a size that the drift check below holds to the box.
let CharacterSetCharsFieldName = b"chars"
let CharacterSetMaskFieldName = b"categoryMask"
export let CharacterSetCharsFieldIndex = 0 as FieldIndex
export let CharacterSetMaskFieldIndex = 1 as FieldIndex

// The one-element `[integer]` argument list of the `Array with integer` literal instance — built fresh
// per call (a `MaxonTypeArray` is owned by the instance it is interned into).
function singletonInteger() returns MaxonTypeArray
	var args = MaxonTypeArray.create()
	args.push(MaxonType.integer)
	return args
end 'singletonInteger'

// ⭐⭐ **A TUPLE IS A SYNTHESIZED STRUCT, NOT A STRUCTURAL TYPE VARIANT (P1.10).** `(10, 32)` mints a
// `StructLayout` under a reserved, MANGLED name and the value is typed with the existing
// `MaxonType.structRef(TypeNameId)` — so a tuple adds no `MaxonType.tuple` / `ValueTypeTag.tuple` arm, and
// none of the ~25 exhaustive `match` sites over those two unions grows a case. Every tuple mechanism then
// falls out of machinery that already exists and is already debugged: the box is `emitStructLiteral`'s
// `__mm_alloc` plus one `storeIndirect` per element, `t.0` is `emitFieldLoad` at `offsetOfField(0)`, and a
// tuple holding a `String` gets its whole drop cascade from `installStructDestructors`, which synthesizes one
// for any layout in `project.structTypes` that owns a managed field.
//
// The bootstrap does exactly this (`IrStructType … isTuple: true`, positional fields `_0`/`_1`, mangled
// `__Tuple_<elem>_<elem>` — `maxon-sharp/Compiler/MLIR/Core/MlirType.cs:282-295`). v1 instead mints a
// `__TupleN` BASE struct plus a `genericInstance` over the element types (`Parser.maxon:17127`), and shv2
// takes the bootstrap's MONOMORPHIC form for two reasons: `StructLayoutMap` is name-keyed and `structRef`
// already resolves id → name → layout, so a mangled name drops straight in; and a generic instance's RANGED
// argument is part of its identity (e4146cf8e), which would make `(Integer, Integer)` and `(int, int)` two
// different tuple types — the very thing `specs-shv2/tuples.md`'s `tuple-as-param` requires them not to be.
export let TupleTypeNamePrefix = b"__Tuple"

// ⚠ **THE ARITY RIDES IN FRONT AND THE ELEMENTS JOIN WITH A CHARACTER NO ELEMENT NAME CAN HOLD** — the
// injectivity rule the Architecture states for `witnessTableLabel`, spent here. An `_` join is NOT injective
// (`_` is inside the identifier alphabet), so `(A_B, C)` and `(A, B_C)` would both spell `__Tuple_A_B_C` and
// the second would silently BECOME the first: one layout, two element lists, and a drop cascade taken from
// whichever registered last. `.` is outside the alphabet the lexer admits inside an identifier, and the
// ARITY is what keeps a NESTED tuple decodable — without it the flattened element list is prefix notation
// with variable arity, where `((i,i),i,i)` and `((i,i,i),i)` collide.
//
// ⚠ Deliberately its own constant rather than `IrInterface`'s `WitnessLabelSeparator` or the parser's
// `MethodNameSeparator`, for the reason the first of those states at length: three joins whose admissible
// sets differ are three facts, and one constant would couple them so a change to any moved the others.
export let TupleElementSeparator = "."

// The positional field name of tuple element `indexDigits` — `_0`, `_1`, … THE one speller, shared by the
// layout builder here and the parser's `.N` → field-name rewrite (`Parser.consumeMemberNameToken`), so the
// slot a literal fills and the slot `t.0` reads cannot come to disagree. It is also the name the SOURCE may
// spell directly (`p._0`, which `specs-shv2/tuples.md` writes in five cases): a tuple's fields are ordinary
// struct fields, so the positional sugar and the bare name resolve through one `indexOfField`.
//
// ⚠ **IT TAKES THE INDEX AS ITS DIGITS, and that is what makes it genuinely the ONE speller.** The parser
// holds exactly that — the `intLiteral` token's own text — so a `FieldIndex` parameter would leave it
// re-rendering `_`+digits for itself (the shape this comment used to CLAIM was shared while the parser
// spelled its own), and decoding the text to a number first would turn `t.<huge>` from the "no field named
// '_<huge>'" it reports today into a ranged-cast panic.
export function tupleFieldName(indexDigits ByteArray) returns ByteArray
	return "_{String.from(indexDigits)}".toByteArray()
end 'tupleFieldName'

// Is `name` a synthesized tuple type's name? The prefix is inside the `__` reserved space `E2051` bars every
// declaration from (`Parser.requireUnreservedName`), so a user `type` can never contest one and this test can
// never answer yes for a declared name.
export function isTupleTypeName(name ByteArray) returns bool
	return bytesStartWith(name, prefix: TupleTypeNamePrefix)
end 'isTupleTypeName'

// The layout of a tuple whose elements are `elements`, ALREADY canonical and already interned against the
// table the caller wants the layout to live in. Fields are positional (`_0`, `_1`, …) in element order — which
// IS the layout, since `StructLayout.offsetOfField` derives an offset from the index — and every one is
// `export var`: a tuple has no encapsulation to enforce (`requireFieldAccessible` must let `t.0` through from
// anywhere) and `t.0 = 20` is legal on a `var` binding.
//
// The ONE builder, called once per interner: `ProgramSignatures` builds its own copy against its own table and
// the parser builds the artifact's against the file's, because `remapArtifact` REWRITES an artifact layout's
// field types in place and a shared object would corrupt the index's copy.
//
// ⚠⚠ **EVERY ELEMENT'S DECLARED SURFACE IS PLAIN HERE, AND IT MUST STAY THAT WAY (A2m).**
// `(__ManagedMemory, Int)` and `(ByteArray, Int)` CANONICALIZE TO ONE NAME and therefore to THIS ONE
// LAYOUT — the spelling is already gone from `elements`, which holds the resolved types. Writing a buffer
// surface into this column would hand the buffer's roster to both spellings, decided by whichever interned
// first: a wrong ACCEPTANCE, which no diagnostic reports. A tuple slot's surface rides the VALUE instead
// (`Parser.bufferSurfaceSlots`), and `error.a-tuple-of-byte-arrays-keeps-the-array-surface` is what holds
// this shut.
export function tupleStructLayout(name ByteArray, elements MaxonTypeArray) returns StructLayout
	var layout = StructLayout.create(name)
	for i in 0 upto elements.count() 'eachElement'
		layout.addField(tupleFieldName("{i}".toByteArray()), declaredType: try elements.get(i) otherwise panic("tupleStructLayout: elements.get OOB at {i} below count {elements.count()}"), mutable: true, exported: true, defaultValue: FieldDefault.none, declaredSurface: sharedEmptyDeclaredSurface)
	end 'eachElement'
	return layout
end 'tupleStructLayout'

// ⚠ **A TUPLE HAS AT LEAST TWO ELEMENTS, AND `(a)` STAYS GROUPING FOREVER.** `(2 + 3) * 4` means 20 because
// the parentheses group; a one-element tuple would make that spelling ambiguous with nothing to disambiguate
// it, so v1 rejects a 1-tuple at four separate sites and shv2 rejects it at the one place a tuple is minted.
export let MinTupleArity = 2 as FieldIndex

// Why a type cannot be a tuple ELEMENT — raised by `ProgramSignatures.internTupleType` and turned into a
// positioned `E2015` by the parser, which is the only party holding a token to anchor it on.
//
// It is a THROW rather than a `panic` because every case is reachable from source: a `(T, int)` inside a
// generic body, and a tuple built out of a value whose type the front end never resolved.
export union TupleElementRejection
	// The element's type tag has no place in a tuple's identity — a `typeParameter` (the shared body has no
	// concrete type to key the layout on, and the drop cascade would be built against a borrow), an
	// `unresolved` (nothing to mangle), or a `void` (no value at all). See `requireTupleElementType`.
	unsupportedTag(position FieldIndex, tagName String)
	// The element's canonical name holds the element SEPARATOR, so the join that spells the tuple's name
	// would stop being injective (see `TupleElementSeparator`). Exactly one name form in the language can do
	// this — a PER-INSTANCE qualified alias, `StrWrapper.Idx` — since the BASE-TEMPLATE form collapses to its
	// underlying primitive in `canonicalTupleElement` and every other spelling is a bare identifier.
	separatorInElementName(position FieldIndex, elementName String)
end 'TupleElementRejection'

// The name id `id` denotes in the interner it was MINTED against — `ProgramSignatures.nameOfId`'s twin for the
// direction that reads a FOREIGN table (`adoptTypeFrom`). A miss is an invariant break, not a case: every id
// handed to that door was minted by the caller's own `parseTypeReference` against exactly this table.
function foreignNameOf(typeNames TypeNameInterner, id TypeNameId) returns ByteArray
	return try typeNames.nameOf(id) otherwise panic("foreignNameOf: type-name id {id} is not in the interner it was passed with — a type crossing INTO the signature index must carry ids minted against the interner named alongside it")
end 'foreignNameOf'

// Is `element` a type a tuple can be keyed on? A `typeParameter` is not: the shared generic body has no
// concrete type to build a layout or a drop cascade against, and `mangleTypeArg` would spell it by POSITION,
// so two instantiations would silently share one layout. An `unresolved` is not: there is nothing to mangle.
// A `void` is not: it is no value at all. All three are reachable from source, so each is a positioned
// rejection rather than a panic.
function requireTupleElementType(element MaxonType, position FieldIndex) throws TupleElementRejection
	let tag = maxonTypeTag(element)
	if tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.unresolved or tag == ValueTypeTag.void 'unsupported'
		throw TupleElementRejection.unsupportedTag(position, tagName: typeTagName(tag))
	end 'unsupported'
end 'requireTupleElementType'

// The composite-key index a `GenericInstanceRegistry` interns through, and the alias-name map that
// resolves `IntBox` to its interned instance. Keyed on `ByteArray` — a cheap string key built from
// the base id and the arg (tag, id) pairs — so interning is O(1) amortized (NOT v1's linear
// structural scan over every prior entry, `Project.maxon:2002-2014`).
export typealias GenericInstanceIndexMap = Map with (ByteArray, GenericInstanceId)
export typealias GenericAliasMap = Map with (ByteArray, GenericInstanceId)

// Base type-name id ⇒ the instances interned for THAT base — the second index on the instance registry,
// beside the payload⇒id one above. It exists for the per-instantiation GATES
// (`genericTypeFieldHas{Managed,CoOwnedTrivial,Uncopyable}Instantiation`), which ask "does any instance OF
// THIS BASE classify its argument at `position` as …?" and used to answer it by walking the whole registry
// and `.equals`-ing every base name — O(call sites × TOTAL instances), a cost that allocates nothing and so
// is invisible to `scale-test`'s memory columns. Keyed by base ID rather than base name because the
// registry interns by id and holds no interner of its own: the one writer is `intern`, so the buckets
// cannot drift from the columns they index.
export typealias GenericInstanceIdArray = Array with GenericInstanceId
export typealias GenericInstancesByBaseMap = Map with (TypeNameId, GenericInstanceIdArray)

// ⭐⭐ **gid ⇒ ITS COMPILED NAME, DERIVED ONCE.** A generic instance's mangling is a pure function of its
// base name and its args, both FIXED at intern time and neither ever revised — so it is derivable once
// and asked many times. It was derived many times: EIGHT call sites ask — `mangleTypeArg`'s own nested
// arm, the drop-callee router, the descriptor label, four `MmRuntime` cascade passes and the E3006
// compiled-name check — and each ask REBUILT the whole string.
//
// ⚠ **THAT REBUILD IS RECURSIVE, WHICH MADE IT QUADRATIC.** `mangleTypeArg`'s nested arm re-enters
// `mangleGenericInstance`, so deriving `Wrap with (Wrap with (… Small))` at depth d re-derived all d
// enclosing names — Θ(d) per ask, Θ(Σd) = Θ(N²) over the program, at every one of those sites.
// MEASURED on a hand-written chain of N inline-nested instantiations (a ~5 KB source file): allocations
// inside `mangleGenericInstance` were 9,897 / 39,797 / 159,597 at N = 50 / 100 / 200 — **x4.02 and x4.01
// per doubling, a textbook quadratic** — and 87% of every allocation the compile made. Compile time was
// 51 / 109 / 344 / 1,360 / 5,922 ms at N = 100…1,600 (x4.0-4.4 per doubling), and 97% of it was
// UNATTRIBUTED in the per-phase table, because the passes that ask sit between phase brackets.
//
// With the memo each name is built ONCE, from its argument's ALREADY-BUILT name: O(1) map probe per ask,
// O(arity) appends per distinct instance. Total allocations become O(instances); total BYTES stay Θ(N²)
// for a nested chain and that half is irreducible — name `i` genuinely IS `i` levels long.
//
// Keyed by gid rather than positional, so it does not care that instances are interned in two waves
// (the signatures sweep, then `Array`/`Set` literals during parse) — a gid is append-only and its
// mangling is settled the moment it exists.
export typealias CompiledInstanceNameMap = Map with (GenericInstanceId, ByteArray)

// The CANONICAL (comparison) name of each instance — see `canonicalInstanceName`. A SECOND map, deliberately
// separate from `CompiledInstanceNameMap`: that one names EMITTED symbols (`__destruct_…`, `__layout_…`) and
// must not move, while this one exists only to answer "are these two values the same type?".
export typealias CanonicalInstanceNameMap = Map with (GenericInstanceId, ByteArray)

// ⭐ A tuple name ⇒ its CANONICAL tuple name (P1.10). Keyed by name rather than by an id because a tuple has
// no id: it IS its name (`ProgramSignatures.tupleCanonicalNames`).
export typealias TupleCanonicalNameMap = Map with (ByteArray, ByteArray)

// The NAMES every top-level MANAGED binding in the program is declared under — `let` and `var` alike
// (P1.7a / P1.7 slice 2a) — the filter `Parser.managedTopLevelReceiverAt` asks before it will build a
// file-scoped key. See `ProgramSignatures.managedTopLevelNames` for why the answer has to be a name and
// not a bool.
typealias ManagedTopLevelNameSet = Set with ByteArray

// Function name ⇒ the pre-erasure `__ManagedMemory` SPELLING of its declared return type (A2j / A2m) — the
// door `Parser.emitCall` asks before it marks a call's result. See `ProgramSignatures.declaredReturnSurfaces`
// for why only a NON-PLAIN surface gets an entry.
typealias DeclaredReturnSurfaceMap = Map with (ByteArray, DeclaredSurface)

// The NAMES of every generic-instance typealias whose FIRST type argument was SPELLED `__ManagedMemory`
// (A2m) — `typealias BufArray = Array with __ManagedMemory`. For an `Array`/`Set` instance argument 0 IS the
// element, so this is the door "does a value of this alias hold BUFFERS?" is answered through. It has to be
// keyed on the ALIAS NAME and can never be keyed on the `GenericInstanceId`: `Array with __ManagedMemory` and
// `Array with ByteArray` intern to the SAME instance, which is the whole reason the question survives.
typealias BufferElementAliasNameSet = Set with ByteArray

// The `<declaring file>|<type name>` keys of every type name a top-level constant initializer casts to
// (P1.9). Scoped rather than bare because the question it answers — "was this alias used in its OWN
// file?" — is a file's. See `ProgramSignatures.constCastTargets`.
typealias ConstCastTargetSet = Set with ByteArray

// The type names one PROVENANCE declares (A1s wave 2) — ONE alias for both halves of the shadow contest,
// `ProgramSignatures.userDeclaredTypeNames` and `stdlibDeclaredTypeNames`. They hold the same KIND of fact
// about two different sets of files, and a second alias over `Set with ByteArray` would only invite the two
// to be described as different things.
typealias DeclaredTypeNameSet = Set with ByteArray

// ⭐⭐ **THE SHADOW RENAME TABLE — bare name ⇒ the reserved name a LISTED STDLIB module's declaration of
// that name is moved to (A1s wave 2).**
//
// ⚠ **THE RULE IT IMPLEMENTS IS THE ORACLE'S, MEASURED, AND IT IS A SCOPING RULE RATHER THAN A TIE-BREAK.**
// Against `maxon-sharp`, a user `enum ParseError` and a call to `int.fromString("41")` COEXIST in one
// program (exit 42) — the user's declaration answers user code while `stdlib/Builtins.maxon`'s own body
// goes on throwing its own `ParseError.invalidFormat`. The bootstrap gets that from parse ORDER: it binds
// every reference inside `stdlib/` before the user file overwrites the registry entry. shv2 cannot, and
// that is its thesis working as designed — `queryProgramSignatures` folds EVERY file's declarations before
// any file is parsed, so there is no "already bound" state and no file order produces one.
//
// ⚠ **AND A PLAIN "the user's declaration displaces the stdlib one" RULE IS A WRONG ANSWER, MEASURED.**
// Built that way, `type`/`union`/`interface`/ranged-`typealias` shadowing all worked, and a user
// `enum ParseError { Invalid = 1 }` produced **`E3034: stdlib/Builtins.maxon:222:11: unknown enum case:
// 'invalidFormat'`** — a diagnostic inside a file the author never opened, because that module REFERENCES
// the name it declares. Two declarations of one name have to coexist, and shv2 identifies aggregates by
// NAME all the way down (`structRef(name)`, `aggregateNameFor`, `__destruct_<name>`, `__layout_<name>`), so
// coexisting means one of them is RENAMED.
//
// ⇒ The stdlib one moves, into the space `E2051` already reserves — the identical trade
// `ProgramSignatures.reservedIfDeclared` makes for a contested COMPILED name, one namespace over, and for
// the identical reason: `__` is a prefix no declaration may take, so the moved name cannot contest anything
// and no user program can reach it. Re-probed rather than prefixed once, and ON CONTEST ONLY — a program
// that shadows nothing renames nothing and compiles to the bytes it did before this existed.
typealias StdlibShadowRenameMap = Map with (ByteArray, ByteArray)

// ⭐ **THE GENERIC-INSTANCE INTERNER (P1.6-A)** — `Box with Integer` ⇒ a `GenericInstanceId`, with the
// `(baseId, argTypes)` payload held OUT OF LINE (inlining args into `MaxonType` would make the union
// recursively aggregate — E4014). Two instances with the same base and structurally equal args share
// an id, so a downstream identity check is an integer compare.
//
// ⚠ **INTERNED THROUGH A MAP INDEX, NOT A LINEAR SCAN.** v1's `GenericInstanceRegistry.intern`
// (`maxon-selfhosted/Compiler/Project.maxon:2002-2014`) walks every prior entry doing a full
// structural arg-array compare — O(n²) over a self-compile. Here a cheap composite key (`instanceKey`)
// keys `index`, so interning is O(1) amortized. The parallel `baseIds`/`argLists` columns are the id
// ⇒ payload direction; `index` is the payload ⇒ id direction.
export type GenericInstanceRegistry
	var baseIds as TypeNameIdArray
	var argLists as MaxonTypeArrayArray
	var index as GenericInstanceIndexMap
	// Base id ⇒ its instances, in intern order. The SECOND payload⇒id index (see
	// `GenericInstancesByBaseMap`), written only by `intern` alongside the columns it indexes.
	var byBase as GenericInstancesByBaseMap

	export static function create() returns GenericInstanceRegistry
		return Self{baseIds: TypeNameIdArray.create(), argLists: MaxonTypeArrayArray.create(), index: GenericInstanceIndexMap.create(), byBase: GenericInstancesByBaseMap.create()}
	end 'create'

	// The cheap composite key that makes interning O(1): the base id and each arg's (tag, id) pair,
	// joined. Two structurally equal instances build the SAME key — the arg TAG plus its name/registry
	// id is the whole of a slice-A type's identity (a trivial arg is a primitive, a struct name id, or
	// a nested-instance giid), so equal keys mean equal instances.
	function instanceKey(baseId TypeNameId, args MaxonTypeArray) returns ByteArray
		var key = "{baseId}"
		for arg in args 'eachArg'
			key.append("|{maxonTypeTag(arg).rawValue}:{typeNameIdOf(arg)}")
		end 'eachArg'
		return key.toByteArray()
	end 'instanceKey'

	// Intern `(baseId, args)`, returning an existing id for a structural repeat. O(1) amortized via
	// `index`.
	export function intern(baseId TypeNameId, args MaxonTypeArray) returns GenericInstanceId
		let key = self.instanceKey(baseId, args: args)
		if let existing = try self.index.get(key) 'hit'
			return existing
		end 'hit'
		let id = self.baseIds.count()
		self.baseIds.push(baseId)
		self.argLists.push(args)
		self.index.upsert(key, value: id)
		self.recordBase(baseId, id: id)
		return id
	end 'intern'

	// File the new instance under its base. Appended, never re-sorted, so a base's bucket is in intern
	// order — the same order the gates' old whole-registry walk visited them in.
	function recordBase(baseId TypeNameId, id GenericInstanceId)
		if var siblings = try self.byBase.get(baseId) 'seenBase'
			siblings.push(id)
			self.byBase.upsert(baseId, value: siblings)
			return
		end 'seenBase'

		var first = GenericInstanceIdArray.create()
		first.push(id)
		self.byBase.upsert(baseId, value: first)
	end 'recordBase'

	// The instances interned for base `baseId`. Throws for a base with none — which is an ANSWER (no
	// instantiation of that type exists), not a failure, and is why the gates ask through `if let`.
	export function instancesOfBase(baseId TypeNameId) returns GenericInstanceIdArray throws MapError
		return try self.byBase.get(baseId)
	end 'instancesOfBase'

	export function instanceBaseId(id GenericInstanceId) returns TypeNameId
		return try self.baseIds.get(id) otherwise panic("GenericInstanceRegistry.instanceBaseId: invalid GenericInstanceId {id}")
	end 'instanceBaseId'

	export function instanceArgs(id GenericInstanceId) returns MaxonTypeArray
		return try self.argLists.get(id) otherwise panic("GenericInstanceRegistry.instanceArgs: argLists desync at GenericInstanceId {id}")
	end 'instanceArgs'

	// The number of interned instances — the iteration bound the B2 destructor-synthesis and needs-closure
	// passes walk (`0 upto count()` enumerates every gid).
	export function count() returns GenericInstanceId
		return self.baseIds.count()
	end 'count'
end 'GenericInstanceRegistry'

// ⭐ **ONE NODE OF A `Base with Args` ARGUMENT TREE, PRE-ORDER FLATTENED (P1.6-A/B2)** — a LEAF is an
// ordinary type reference (a primitive, a struct name, a ranged alias) whose `MaxonType` the parser already
// produced; a NESTED instance (`Box with (Box with Integer)`) is an `instanceHeader(baseName, argCount)`
// followed IN THE LIST by its `argCount` args' nodes (recursively). The tree is FLATTENED rather than
// self-referential because a directly recursive union is rejected (E4014); the gid is not known at parse
// time anyway — interning lives in `recordGenericAlias`, which walks the flat list DEPTH-FIRST (the inner
// instance interned before the outer, so the outer's arg is a real `genericInstance(innerGid)`), exactly
// what the composite key's "nested-instance giid" and `mangleTypeArg`'s nested arm already anticipated.
export union GenericArgNode
	leaf(argType MaxonType)
	instanceHeader(baseName ByteArray, argCount FieldIndex)
end 'GenericArgNode'

export typealias GenericArgNodeArray = Array with GenericArgNode

// A mutable read cursor over a flat `GenericArgNodeArray` — `resolveGenericArgs` walks the pre-order tree by
// advancing it (Maxon lacks tuples, so the recursion threads position through this shared reference).
export type ArgCursor
	export var pos as FieldIndex

	export static function create() returns ArgCursor
		return Self{pos: 0}
	end 'create'
end 'ArgCursor'

// One generic-instance TYPEALIAS the sweep found (P1.6-A): `typealias IntBox = Box with Integer` ⇒
// `(IntBox, Box, argCount 1, [leaf(Integer)])`. `argCount` is the number of TOP-LEVEL arguments (the flat
// `args` list also holds nested instances' nodes); a leaf's `MaxonType` is minted against the SCANNING
// file's interner, which `foldFile` remaps into the index's (and interns nested instances) before interning
// the instance. It travels by NAME (alias name + base name), the way every whole-program registry entry does.
export type GenericAliasEntry
	export var aliasName as ByteArray
	export var baseName as ByteArray
	export var argCount as FieldIndex
	export var args as GenericArgNodeArray
	// ⭐ **WAS ARGUMENT 0 SPELLED `__ManagedMemory` (A2m)?** Read off the TOKEN in `Parser.parseGenericArgNode`,
	// because the very next line destroys it: `parseTypeReference`'s generic-alias arm folds the spelling into
	// `genericInstance(Array with Byte)`, which is bit-for-bit what a `ByteArray` argument resolves to. For an
	// `Array` instance argument 0 is the ELEMENT, so this is what makes `Array with __ManagedMemory` an array of
	// BUFFERS while `Array with ByteArray` — the same `GenericInstanceId` — stays an array of arrays.
	export var elementIsBuffer as bool
	// The instantiation-site anchor (P1.7a slice 2a) — where `typealias X = Base with Args` is declared, so the
	// where-constraint check (E3017) can land its diagnostic ON the offending instantiation. Zero for a
	// synthesized alias (e.g. an inner generic alias); the check skips a zero anchor.
	export var nameLine as LineNumber
	export var nameColumn as ColumnNumber
	export var filePath as FilePath

	export static function create(aliasName ByteArray, baseName ByteArray, argCount FieldIndex, args GenericArgNodeArray, elementIsBuffer bool = false, nameLine LineNumber = 0, nameColumn ColumnNumber = 0, filePath FilePath = FilePath from "") returns GenericAliasEntry
		return Self{aliasName: aliasName, baseName: baseName, argCount: argCount, args: args, elementIsBuffer: elementIsBuffer, nameLine: nameLine, nameColumn: nameColumn, filePath: filePath}
	end 'create'
end 'GenericAliasEntry'

export typealias GenericAliasEntryArray = Array with GenericAliasEntry

// Which generic-alias DECLARATION closes a type cycle (P1.7, E3091), or that none does. A union rather
// than an index-plus-sentinel because declaration 0 is a real alias. Asked once per compile, so the one
// heap box it costs is not on any hot path.
export union AliasCycleResult
	at(index FieldIndex)
	none
end 'AliasCycleResult'

// ⭐ **ONE `Base with Args` INSTANTIATION SITE (P1.7a slice 2a)** — an interned instance paired with the
// source anchor of the `typealias X = Base with Args` that names it, for the where-constraint check (E3017)
// to land its diagnostic on. Collected by `recordGenericAlias` for every alias with a real (non-zero) anchor.
export type GenericInstantiationSite
	export let gid as GenericInstanceId
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber
	export let filePath as FilePath

	export static function create(gid GenericInstanceId, nameLine LineNumber, nameColumn ColumnNumber, filePath FilePath) returns GenericInstantiationSite
		return Self{gid: gid, nameLine: nameLine, nameColumn: nameColumn, filePath: filePath}
	end 'create'
end 'GenericInstantiationSite'

export typealias GenericInstantiationSiteArray = Array with GenericInstantiationSite

// One RANGED typealias declared INSIDE a generic type (P1.6-C): `type Wrapper uses T` with
// `export typealias Idx = int(0 to u64.max)` ⇒ `(Wrapper, Idx=int(0..u64.max))`. The sweep
// (`recordScannedType`) collects one per nested ranged alias; `foldFile` keys it by `base.member`
// ("Wrapper.Idx") into `innerAliases`. It carries NO type-name ids — a ranged alias's underlying is
// the `int`/`float` KEYWORD — so it travels by name like `RangedTypeAlias` and needs no remap.
export type InnerAliasEntry
	export var baseName as ByteArray
	export var alias as RangedTypeAlias

	export static function create(baseName ByteArray, alias RangedTypeAlias) returns InnerAliasEntry
		return Self{baseName: baseName, alias: alias}
	end 'create'
end 'InnerAliasEntry'

export typealias InnerAliasEntryArray = Array with InnerAliasEntry

// The inner-alias PARAMETER shape of one method/factory (P1.6-C) — its SOURCE parameter names, and per
// source position the bare inner-alias MEMBER (`Idx`) or `EmptySourceText` for a non-inner-alias
// parameter. The two arrays move in lockstep (one entry per source parameter). Recorded per method that
// has at least one inner-alias parameter, so the parser's per-instance argument check can re-qualify the
// parameter with the concrete receiver's instance alias at the call site.
export type InnerAliasParamInfo
	export var paramNames as ByteArrayArray
	export var members as ByteArrayArray

	export static function create(paramNames ByteArrayArray, members ByteArrayArray) returns InnerAliasParamInfo
		return Self{paramNames: paramNames, members: members}
	end 'create'

	// The number of source parameters this info describes — the lockstep length of both columns.
	export function paramCount() returns ParamCount
		return self.paramNames.count()
	end 'paramCount'

	// Does any source parameter carry a bare inner-alias member? The gate that decides whether a method earns
	// an index entry (a method with none is the common case and costs nothing).
	export function hasInnerAliasMember() returns bool
		for member in self.members 'eachMember'
			if not member.isEmpty() 'found'
				return true
			end 'found'
		end 'eachMember'
		return false
	end 'hasInnerAliasMember'

	// The bare inner-alias member at source position `index` (`Idx`), or `EmptySourceText` for a
	// non-inner-alias parameter. Out-of-range reads empty (a slotted argument past the recorded columns is
	// not an inner-alias parameter — the arity error is SemanticCheck's to report).
	export function memberAt(index ParamCount) returns ByteArray
		return try self.members.get(index) otherwise EmptySourceText
	end 'memberAt'
end 'InnerAliasParamInfo'

export typealias InnerAliasParamInfoMap = Map with (ByteArray, InnerAliasParamInfo)

// What the index knows about a method's inner-alias parameters (P1.6-C) — `DeclaredAlias`'s twin, a union
// for the same reason: "this method has no inner-alias parameter" is an ANSWER (the common case), not a
// failure, and the parser's per-instance argument check simply does nothing for it.
export union InnerAliasParamLookup
	found(info InnerAliasParamInfo)
	noInnerAliasParams
end 'InnerAliasParamLookup'

// One method's inner-alias parameter info, as the sweep found it (P1.6-C) — the qualified method name
// (`Wrapper.setTag`) and its `InnerAliasParamInfo`. `foldFile` keys it into `methodInnerAliasParams`.
// It travels by name (no ids), the way every whole-program registry entry does.
export type MethodInnerAliasParamEntry
	export var methodName as ByteArray
	export var info as InnerAliasParamInfo

	export static function create(methodName ByteArray, info InnerAliasParamInfo) returns MethodInnerAliasParamEntry
		return Self{methodName: methodName, info: info}
	end 'create'
end 'MethodInnerAliasParamEntry'

export typealias MethodInnerAliasParamEntryArray = Array with MethodInnerAliasParamEntry

// ⭐ **WHERE ONE `interface` DECLARATION SITS IN ITS FILE'S TOKEN STREAM (R8)** — the file, and the index of
// its `interface` keyword. Recorded by the tolerant declaration sweep, which is the one phase that walks every
// file's tokens and already decides what a top-level declaration IS; read by `foldInterfaceDeclarations`,
// which jumps straight to each site instead of walking the program a second time. So "is this token an
// interface declaration?" stays ONE decision made in one place, and the second pass costs O(interfaces)
// rather than O(tokens).
//
// ⚠ **A SITE AND NOT THE DECLARATION ITSELF, AND THE REASON IS THE ONE HAZARD OF HAVING A PRE-SCAN AT ALL.**
// An interface method's parameter types are stored as RENDERED SOURCE STRINGS, and
// `IrInterface.renderDeclaredTypeName` spells a `genericInstance` as `ProgramSignatures.canonicalInstanceName`
// — an answer only the COMPLETE index can give. Read during the per-file sweep, `IntArray`'s alias is not yet
// in `genericAliases`, so the same type would render as the raw alias name from the sweep and as the canonical
// instance name from the real parse: two spellings of one type, which is a false ACCEPT on the conformance
// (the R5 review's finding) and a wrong `paramTypeNames` at every witness dispatch. Recording a POSITION here
// and reading the declaration only once `allFilesFolded` is true makes that divergence unrepresentable rather
// than merely unlikely — the renderer sees exactly the index the real parse will.
export type InterfaceDeclSite
	export var path as FilePath
	export var tokenPos as TokenIndex
	// The DECLARED name, read by the sweep off the token after the keyword (A1s wave 2). The declaration
	// itself is not read until `foldInterfaceDeclarations`, which runs after the whole sweep — and the
	// stdlib/user shadow contest is settled BEFORE that, so the name has to travel with the site or an
	// `interface` would be the one declaration kind the contest could not see.
	export var name as ByteArray

	export static function create(path FilePath, tokenPos TokenIndex, name ByteArray) returns InterfaceDeclSite
		return Self{path: path, tokenPos: tokenPos, name: name}
	end 'create'
end 'InterfaceDeclSite'

export typealias InterfaceDeclSiteArray = Array with InterfaceDeclSite

// ⭐ **THE ONE PLACE A `throws` CLAUSE ENTERS A CONTENT HASH.** Both arms are marked, because both are
// possible in the positions this is asked from and a hash that mixed nothing for `none` would let a
// requirement LOSE its `throws` without any reader's memo moving — and the ABI a witness dispatch picks is
// exactly that fact (`WitnessDispatchTarget.throwsClause`).
function mixThrowsClause(state ContentHash, clause ThrowsClause) returns ContentHash
	return match clause 'k'
		none gives mix(state, value: ThrowsShapeNone)
		throwing(throwsName) gives mixBytes(mix(state, value: ThrowsShapeThrowing), bytes: throwsName.toByteArray())
	end 'k'
end 'mixThrowsClause'

// The rendered FORMALS of one interface requirement, in declaration order (R8). BOTH columns ride and they
// are parallel: a witness dispatch slots its call's arguments against the NAMES (`WitnessDispatchTarget`'s
// authoritative label vocabulary — the interface's names, never a conformer's) and rejects a concrete value
// against the TYPES, so renaming a formal in file A changes what `f(x, other: y)` means in file B. The COUNT
// leads because arity alone decides E3036 at every dispatch; per-slot markers are unnecessary because
// `mixBytes` already carries a length tag, which is what keeps `("ab","c")` apart from `("a","bc")`.
function mixInterfaceFormals(state ContentHash, names ByteArrayArray, types ByteArrayArray) returns ContentHash
	var out = mix(state, value: names.count())
	for i in 0 upto names.count() 'eachFormal'
		let name = try names.get(i) otherwise panic("mixInterfaceFormals: names.get OOB at {i} below count {names.count()}")
		let typeName = try types.get(i) otherwise panic("mixInterfaceFormals: types.get OOB at {i} — an InterfaceMethodSig's paramNames and paramTypeNames are parallel by construction ({names.count()} names, {types.count()} types)")
		out = mixBytes(mixBytes(out, bytes: name), bytes: typeName)
	end 'eachFormal'
	return out
end 'mixInterfaceFormals'

// The "." that joins a per-instance / inner alias's parts (P1.6-C). Its own constant so the JOIN and the
// SPLIT below cannot spell the qualifier two ways; it is also what `Parser.parseTypeReference` reads an
// `Instance.Member` type reference off, so all three agree by construction.
let QualifiedAliasSeparator = "."

// The BYTE value of `QualifiedAliasSeparator` (ASCII '.'), for the allocation-free pre-check
// `containsQualifier`. Named so the byte and the string form of the separator cannot drift.
let QualifiedAliasSeparatorByte = 46

// ⭐ Does `name` contain the qualifier byte at all? The cheap, ALLOCATION-FREE guard that keeps the
// per-instance machinery off the plain-alias hot path (P1.6-C): a plain name (`Score`) has no ".", so this
// scans its bytes and returns false WITHOUT the `String.from(...).split(...)` that `splitQualifiedName`
// would otherwise allocate on every named-type resolution and every aggregate coercion. Every qualified
// per-instance/inner name contains exactly one ".".
export function containsQualifier(name ByteArray) returns bool
	// An INDEX loop over a byte range, not `for b in name`: this is a per-named-value-coercion hot path, and an
	// index range allocates no iterator object where the collection form might.
	for i in 0 upto name.count() 'scan'
		if (try name.get(i) otherwise panic("containsQualifier: get OOB despite i < count()")) == QualifiedAliasSeparatorByte 'found'
			return true
		end 'found'
	end 'scan'
	return false
end 'containsQualifier'

// `prefix.member` — the base-qualified name of an inner alias ("Wrapper.Idx") and the qualified name of a
// per-instance alias ("IntWrapper.Idx"), built the ONE way so the value column, the registries and the
// checks cannot disagree. `prefix`/`member` are identifiers and carry no ".", so `splitQualifiedName`
// inverts it exactly.
export function joinQualifiedName(prefix ByteArray, member ByteArray) returns ByteArray
	return "{String.from(prefix)}{QualifiedAliasSeparator}{String.from(member)}".toByteArray()
end 'joinQualifiedName'

// The TYPE half of a `Type.method` callee, or the callee itself when it names a free function. Written
// through `splitQualifiedName` rather than as a second scan for the separator, so the one inverse of
// `joinQualifiedName` stays the only place the split is spelled.
export function qualifiedCalleeHead(callee ByteArray) returns ByteArray
	return match splitQualifiedName(callee) 'shape'
		parts(prefix, _) gives prefix
		notQualified gives callee
	end 'shape'
end 'qualifiedCalleeHead'

// The (prefix, member) of a `prefix.member` name, or `notQualified`. An identifier carries no ".", so a
// two-segment split is EXACT: a plain alias (`Score`) or a name that never was qualified yields
// `notQualified`, and a genuine per-instance/inner name yields its two parts.
export union QualifiedNameParts
	parts(prefix ByteArray, member ByteArray)
	notQualified
end 'QualifiedNameParts'

export function splitQualifiedName(name ByteArray) returns QualifiedNameParts
	// The allocation-free short-circuit: a name with no "." is not qualified, so it never reaches the
	// `String.from(...).split(...)` allocation — the plain-alias hot path pays only the byte scan.
	if not containsQualifier(name) 'notQualified'
		return QualifiedNameParts.notQualified
	end 'notQualified'
	let segments = String.from(name).split(QualifiedAliasSeparator)
	if segments.count() != 2 'notTwoSegments'
		return QualifiedNameParts.notQualified
	end 'notTwoSegments'
	let prefix = try segments.get(0) otherwise panic("splitQualifiedName: segment count is 2 but get(0) failed")
	let member = try segments.get(1) otherwise panic("splitQualifiedName: segment count is 2 but get(1) failed")
	return QualifiedNameParts.parts(prefix.toByteArray(), member: member.toByteArray())
end 'splitQualifiedName'

export type ProgramSignatures
	// Function name -> its declared return type. Last-wins on a duplicate name, exactly as the
	// project's own `funcReturnTypes` registry is; the duplicate itself is reported by
	// `commitFuncSignatures` (E3006), which fails the build, so the overwrite is never observed.
	var returnTypes as FuncReturnTypeMap
	// Typealias name -> its declaration, with the RANGE the shift rule needs. It carries no
	// type-name IDS — a ranged alias's underlying type is always the `int` KEYWORD, never a name —
	// so unlike `returnTypes` it needs no interner and no remap: it travels by name and arrives by
	// name.
	var typeAliases as RangedAliasRegistry
	// FUNCTION typealias name -> its declaration (P1.5-A1). Like `typeAliases` it carries NO type-name
	// ids — a function alias's return type is stored interner-free as a (tag, name-ByteArray) pair (see
	// FunctionTypeAlias) — so it travels by name and arrives by name, needing no interner and no remap.
	// THE door `Parser.parseTypeReference` asks "is this name a function alias?" through, and the one an
	// indirect call recovers the callee's return type from.
	var functionTypeAliases as FunctionTypeAliasMap
	// ⭐ Struct-type name -> its declaration, with the FIELD ORDER the parser needs. THE door `p.x`
	// asks through, and the reason it must be here rather than in `Project`: a field's offset is
	// needed at PARSE time, and `type Point` may be declared BELOW the function that reads a
	// `Point` or in another file entirely. The same argument the header makes for a callee's return
	// type, about a different declaration.
	//
	// ⚠ **UNLIKE `typeAliases`, IT CARRIES IDS** — a field's declared type is a `MaxonType`, and
	// `named(Integer)` is meaningless outside the interner that minted it. So it obeys the header's
	// ID PROBLEM: `foldFile` remaps each file's ids into `typeNames` on the way in, and
	// `fieldTypeOf` re-interns on the way out. It is the second table to need that treatment, and
	// it needs it for exactly `returnTypes`' reason.
	var structTypes as StructLayoutMap
	// ⭐ Enum/union name -> its declaration, with the CASE ORDER and TAGS the parser needs. THE door
	// an enum `match` asks through — is `c` an enum? what tag is `red`? which cases does `low to
	// high` cover? — and here for `structTypes`' reason: the answer is needed at PARSE time and the
	// `enum` may be declared below its use or in another file.
	//
	// ⚠ **LIKE `structTypes`, IT CARRIES IDS** — a case NAME and a tag INT carry none, but a
	// PAYLOAD field's declared type is a `MaxonType`, and `holds(inner BoxA)`'s `named(BoxA)` is
	// meaningless outside the interner that minted it. So a payload-bearing union obeys the header's
	// ID PROBLEM exactly as `structTypes` does: `foldFile` remaps each file's payload ids into
	// `typeNames` on the way in (`remapEnumLayoutPayloadTypes`, the enum twin of
	// `remapStructLayoutFieldTypes`), and the parser re-interns on the way out (`adoptType`, the
	// same door `fieldTypeOf` uses). A payload-FREE enum carries no ids and travels by name alone.
	//
	// ⭐ **SEEDED, NOT EMPTY** (P1.7a slice 2b-ii): `createEnumRegistry` builds it holding the
	// compiler-known `Ordering`, so the parser resolves `Ordering.lessThan`, `match <compare result>` and a
	// `o Ordering` parameter through the ordinary enum doors. The seed deliberately does NOT ride
	// `self.hash` (which `recordEnum` folds a DECLARED enum into): the hash exists to invalidate a parse
	// memo when a declaration a reader COPIED FROM changes, and this declaration is byte-identical in every
	// program — mixing a constant would move every program's hash and invalidate nothing.
	var enumTypes as EnumLayoutMap
	// ⭐ The generic-alias DECLARATIONS, in record order (P1.7) — the deterministic list `firstCyclicAliasDecl`
	// walks. `genericAliases` is keyed by NAME and is a Map, so it can answer "which instance?" but never
	// "which alias was declared first?"; the E3091 blame must be a property of the program, not of a map's
	// iteration, so the order is kept explicitly here.
	var genericAliasDecls as GenericAliasEntryArray
	// ⭐ Generic-instance interner (P1.6-A) — `Box with Integer` ⇒ a `GenericInstanceId`, id ⇒
	// `(baseId, argTypes)`. LIKE `structTypes` IT CARRIES IDS (an arg is a `MaxonType`), so `foldFile`
	// remaps each entry's args into `typeNames` before interning. Read by the parser to resolve a
	// generic-alias call base and to check a generic instance's arity / managed args.
	var genericInstances as GenericInstanceRegistry
	// Each interned instance's COMPILED name, derived on first ask and kept — see `CompiledInstanceNameMap`
	// for the quadratic this removes. Empty for a program that instantiates no generic.
	var compiledInstanceNames as CompiledInstanceNameMap
	var canonicalInstanceNames as CanonicalInstanceNameMap
	// ⭐ Every tuple name this index has seen ⇒ its CANONICAL one (P1.10). A name the DECLARATION SWEEP minted
	// spells its elements the way the source wrote them (`__Tuple2.Integer.Integer`), because the alias
	// registry that says what `Integer` means is still being built when the sweep runs; `adoptType` rewrites
	// it to the canonical form (`__Tuple2.int.int`) at every read, and this memo is what makes that rewrite a
	// map hit rather than a re-derivation. A canonical name maps to itself, so one probe answers both
	// directions. Empty for a program with no tuples.
	var tupleCanonicalNames as TupleCanonicalNameMap
	// ⭐ A TUPLE typealias name ⇒ the tuple type it names (P1.10) — `Pair` ⇒ `__Tuple2.int.int`. The tuple
	// twin of `genericAliases`, and it exists for the same reason: a tuple type has no source-spellable name,
	// so `typealias Pair = (Num, Num)` is the only way to write one in a place that takes a bare identifier
	// (`Array with Pair`). Like a RANGED alias and unlike a function/generic one it mints NO nominal identity
	// — a `Pair` reference resolves straight through to the tuple's own `structRef` — so nothing downstream
	// ever sees the alias name. Read through `tupleAliasTarget`, which canonicalizes: the sweep writes the
	// spelling it saw and the real parse the canonical one, exactly as every other tuple name does.
	var tupleAliases as TupleCanonicalNameMap
	// ⭐ **DOES ANY FILE IN THE PROGRAM MATERIALIZE A `[<identifier>…]` ARRAY LITERAL?** (P1.7 slice 3.) Set
	// by the sweep, read ONCE by `queryProgramSignatures` after the last file folds, which is what makes
	// `internArrayLiteralAggregateInstances` a single whole-program walk instead of a per-file one. A bool
	// and not a count: the over-interning is over every declared type, so one such file asks for exactly
	// what a thousand do.
	var sawAggregateArrayLiteral as bool
	// ⭐ Generic-instance TYPEALIAS name ⇒ its interned instance (P1.6-A) — `IntBox` ⇒ the giid for
	// `Box with Integer`. THE door `Parser.parseQualifiedCall` resolves `IntBox.create` to `Box.create`
	// through, and the one the instantiation checks read the base + args from. It carries no ids of its
	// own (the giid indexes `genericInstances`), so it travels by name.
	var genericAliases as GenericAliasMap
	// ⭐ Every `typealias X = Base with Args` INSTANTIATION SITE (P1.7a slice 2a), with its source anchor — the
	// list the where-constraint check (E3017) walks to validate each concrete argument conforms to the
	// interface its type parameter is constrained to. A LIST, not a map: an instance may be named by several
	// aliases, each a distinct site to check + anchor; a `Box with Foo` with no `where` constraint contributes
	// entries the check skips in O(1) (empty constraint list). Empty for a program with no generic aliases.
	var genericAliasSites as GenericInstantiationSiteArray
	// ⭐ INNER ranged typealias registry (P1.6-C) — a RANGED `typealias Idx` declared INSIDE a generic
	// type, keyed by its BASE-QUALIFIED name ("Wrapper.Idx"). It is what makes a per-instance alias
	// (`IntWrapper.Idx`) nominal: `isPerInstanceAlias` composes an instance alias's base with this
	// registry to decide whether `Instance.Member` names one. Like `typeAliases` it carries no ids and
	// travels by name. The stored `RangedTypeAlias.name` is the BARE member ("Idx") — the piece the
	// method-return retype re-qualifies with a concrete receiver's alias.
	var innerAliases as RangedTypeAliasMap
	// ⭐ Per-method INNER-ALIAS PARAMETER info (P1.6-C) — for a method/factory that declares a parameter
	// whose type is a bare inner alias of the enclosing generic type (`setTag(t Idx)`), the source
	// parameter NAMES and, per source position, the inner-alias MEMBER (`Idx`) or empty. Keyed by the
	// method's qualified name (`Wrapper.setTag`). THE door the parser's per-instance argument check asks
	// through at a concrete call site: the shared method signature is opaque to the receiver's instance,
	// so the check needs the parameter's inner-alias member here (params are SKIPPED by the sweep's
	// return-type read, so nothing else records them at this phase). Only methods that HAVE such a
	// parameter get an entry — absence is "no inner-alias parameter", the common case.
	var methodInnerAliasParams as InnerAliasParamInfoMap
	// ⭐⭐ **INTERFACE NAME -> ITS WHOLE DECLARATION (R8)** — the one whole-program answer to *"which interface
	// does this name denote?"* at PARSE time, and here for `structTypes`' reason exactly: the answer is needed
	// while a file is being parsed and the `interface` may be declared BELOW its use or in another file.
	// Two parse-time doors read it, and both used to answer at their own scope:
	//   • `Parser.interfaceUsesArity` — `associatedTypeNames.count()`, how many arguments an unparenthesized
	//     `implements Duo with A, B` binds (R7 moved this one and stopped there);
	//   • `Parser.requireInterfaceForParse` — the METHOD SIGNATURES a witness dispatch resolves against
	//     (`findWitnessDispatchCandidates` reads a method's name, return type, formal types, formal names and `throws`).
	//     It scanned the PARSING FILE's `artifact.interfaces`, which fills as the linear parse reaches each
	//     declaration — so `type Box uses T where T is Digest` with `interface Digest` written below it was
	//     `E2015 … not declared before its constrained use` on a program that compiles with the two lines
	//     swapped, and every cross-file spelling was the same reject.
	//
	// ⚠ **THE WHOLE `IrInterface`, NOT THE FIVE FIELDS THE DISPATCH READS, AND THAT IS THE LESS DUPLICATIVE
	// CHOICE.** A bespoke record holding exactly what `findWitnessDispatchCandidates` consumes would need its own
	// builder, and a SECOND builder of an interface signature is precisely what drifts from the real parse's —
	// the standing hazard of having a pre-scan at all. `foldInterfaceDeclarations` runs the parser's OWN
	// `readInterfaceDeclaration`, the same function `parseInterfaceDeclaration` calls, so what lands here is
	// the declaration the real parse would build, field for field. What is deliberately narrow is the HASH:
	// only the fields a PARSE copies ride it (see `recordInterfaceDeclaration`).
	var interfaces as IrInterfaceMap
	// ⭐ Where each `interface` declaration sits, as the tolerant sweep passed it (R8) — see
	// `InterfaceDeclSite` for why a POSITION and not the declaration. Read once, by
	// `foldInterfaceDeclarations`, after the last file folds.
	export var interfaceDeclSites as InterfaceDeclSiteArray
	// The interner every `named` id in `returnTypes` belongs to. PRIVATE, and it has to be: an id
	// may not leave this type. `returnTypeOf` re-interns it into the caller's own table.
	var typeNames as TypeNameInterner
	// THE TOP-LEVEL CONSTANT ARENA — every `let` declared at module scope in any file, in
	// DECLARATION order (source-path order, then in-file order).
	//
	// An ARRAY is the driver and a map is only the index into it, which is the opposite of the two
	// tables above and is deliberate: the E2012 cycle message names its members in the order the DFS
	// met them, so the evaluation order is part of what the compiler PRINTS. Driving from a map would
	// make it depend on hash order — v1 drives from a map and has to sort the names back into
	// declaration order to undo exactly that (`sortTopLevelNamesByPosition`,
	// TypeResolution.maxon:8268-8304). Here there is nothing to sort: the sweep builds the array in
	// the order the message needs.
	var decls as TopLevelDeclArray
	// Storage key -> its index in `decls`. FIRST-WINS on a duplicate key (see `recordDecl`).
	var declIndex as TopLevelDeclIndexMap
	// ⭐ Function name -> its per-parameter CONSUME bits (P1.4a wave 2). `paramIsConsumed(callee, i)` is
	// the door a call site asks "does the callee take ownership of my argument at position i?". Filled by
	// `recordParamConsume` from each file's `scanParamConsumes`; last-wins on a duplicate name (a duplicate
	// function is E3006, reported elsewhere, so the overwrite is never observed), exactly as `returnTypes` is.
	var funcParamConsumes as ParamConsumeMap
	// ⭐ Function name -> its `throws E` clause (P1.4b). `throwsOf(callee)` is the door a call site asks
	// "does this callee throw, and what error type?". Filled by `recordThrows` from each file's scanned
	// signatures; last-wins on a duplicate name (E3006 reported elsewhere), exactly as `returnTypes` is.
	// Only THROWING functions are recorded — a callee with no entry is non-throwing, the safe default that
	// makes recording only the throwing ones correct (the same "absence is the answer" `funcParamConsumes`
	// rests on).
	var funcThrows as FuncThrowsMap
	// ⭐ Function name -> its per-parameter DEFAULTS (BATCH2 slice 4). `defaultsOf(callee)` is the door
	// `Parser.emitCall` asks before deciding an under-supplied call is an arity error. Filled by
	// `recordParamDefaults` from each file's scanned signatures; last-wins on a duplicate name (E3006
	// reported elsewhere), exactly as `funcParamConsumes` is. Only functions that declare AT LEAST ONE
	// default are recorded — a callee with no entry has no defaults, the "absence is the answer" default
	// `funcParamConsumes` rests on — so the overwhelming majority of programs carry an empty map.
	var funcParamDefaults as ParamDefaultMap
	// The names `funcParamDefaults` had to overwrite with a DIFFERENT declaration's defaults — see
	// `CollidingParamDefaultNameSet`. Empty for every program that declares each function once.
	var collidingParamDefaults as CollidingParamDefaultNameSet
	// ⭐ **EVERY FUNCTION WHOSE DECLARED RETURN TYPE NAMED `__ManagedMemory` ANYWHERE, AND WHERE (A2j / A2m).**
	// `declaredReturnSurface(callee)` is the door `Parser.emitCall` asks "does this call's result denote the
	// BUFFER, or a tuple with a buffer in it, or the `Array` around it?" — a question no `MaxonReturnType` can
	// answer, because the alias resolves to `Array with Byte` and the spelling is gone (see
	// `registerManagedFileType`).
	//
	// ONLY A NON-PLAIN SURFACE GETS AN ENTRY, for `managedTopLevelNames`'s measured reason: the reader is on the
	// hot path (every direct, method and static call in the program), and a program that never writes the alias
	// must not pay per call for an answer that is always no. Written by `record`, in BOTH directions, so it can
	// never outlive the return type it describes.
	var declaredReturnSurfaces as DeclaredReturnSurfaceMap
	// ⭐ **EVERY GENERIC-INSTANCE ALIAS WHOSE ELEMENT WAS SPELLED `__ManagedMemory` (A2m)** — written by
	// `recordGenericAlias`, read by `aliasElementIsBufferSurface`. See `BufferElementAliasNameSet` for why the
	// key is the alias NAME and can never be the instance.
	var bufferElementAliases as BufferElementAliasNameSet
	// The content hash OF THE DECLARATIONS — not of the source they were read from. This is the
	// second half of a parse memo's key (`QueryEngine.parseMemoKey`), and hashing the folded
	// ENTRIES rather than the FILES is the whole point of it:
	//   • edit a function's BODY  ⇒ that file's content hash moves (it re-parses); this hash does
	//     NOT (no other file re-parses). Incrementality is preserved.
	//   • edit a RETURN TYPE      ⇒ this hash moves, and every file re-parses. Which is exactly
	//     right: every call to that function, in any file, may have changed meaning.
	// Keying the parse memo on the composite SOURCE hash instead would be sound and would throw
	// away the first property — one file's edit would re-parse the whole program.
	//
	// ⚠ A TOP-LEVEL CONSTANT PUTS ITS **VALUE** IN HERE, NOT JUST ITS NAME, AND THAT IS LOAD-BEARING
	// (`mixConstant`). A constant is the one declaration whose value is COPIED INTO its readers — a
	// use inlines it as a literal — so editing `export let MAGIC = 42` to `43` changes what every
	// other file COMPILES TO while leaving those files' own bytes, and so their own content hashes,
	// untouched. Only this hash can carry that. Measured, not assumed: with the warm-rebuild gate's
	// declaration probe pointed at a constant, a 7 → 8 edit re-parses every file in the project; the
	// gate's `invalidation` property is what keeps it that way.
	export var hash as ContentHash
	// ⭐ **THE NAMES OF EVERY MANAGED TOP-LEVEL BINDING IN THE PROGRAM** — `let` AND `var` (P1.7a / P1.7
	// slice 2a) — written once per managed binding by `settleManagedValue`, read once per probe by
	// `Parser.managedTopLevelReceiverAt`. It covers both kinds because the evaluator settles both the same
	// way and the probe behind it has to consider both: `msg.append("!")` on a managed `var` receiver has
	// the identical token shape `Live.count()` on a managed `let` does.
	//
	// It exists because the reader is on a HOT path: `methodCallsAt` runs at every dotted-call shape in
	// the program, and the probe behind it builds a file-scoped STRING key (~4 allocations —
	// `fileScopedDeclKey`) before it knows whether the name is a constant at all.
	//
	// ⚠ **A BOOL IS NOT ENOUGH, AND THE DIFFERENCE IS A WHOLE-PROGRAM CLIFF.** This was first written as
	// `anyManagedConstant as bool`, which spares a program that declares NO managed constant — but the
	// moment ONE exists anywhere, a bool is permanently true and every *static* dotted call in the whole
	// program (`Widget.create(…)`, `String.from(…)` — a base that is neither a local nor a capture) pays
	// the full scoped probe to be told "not a constant". **MEASURED at ~5 allocations per static
	// dotted-call site, linear in call sites** (+390/+710/+1,350/+2,630/+5,190 over a 64→1,024 ladder).
	// A NAME set answers the same question for the same one bool's worth of work in the empty case, and
	// keeps answering it cheaply once the set is non-empty: a base whose spelling matches no managed
	// constant costs ONE hash of bytes it already holds and allocates nothing.
	//
	// It is a FILTER, never the answer: a hit still goes through `constantValueOf`, which is what applies
	// file-private scoping and `let`-vs-`var`. So a false positive (this file cannot see that other
	// file's constant) costs one wasted probe and resolves correctly, and there is no second copy of the
	// resolution rule to drift.
	var managedTopLevelNames as ManagedTopLevelNameSet
	// ⭐ **HOW MANY DECLARATIONS HAVE A `.data` SLOT** (P1.7 slice 3) — written by `assignDataLabels`,
	// which is already the one walk that visits exactly them, and read once per compile by
	// `DeadGlobalElimination.liveGlobalLabels` to decide whether its module walk has anything to look
	// for. Zero for the whole existing corpus and for every rung of the scale ladder, which is what
	// keeps a dead-global pass free for a program that has no global.
	//
	// A COUNT rather than a bool because it is what the walk that produces it naturally has, and
	// because "how many slots does this program declare?" is the honest fact; the caller's question
	// ("any at all?") is one comparison away and does not need its own field.
	export var storedGlobalCount as StoredGlobalCount
	// ⭐ **HAS EVERY FILE BEEN FOLDED IN YET?** False while `queryProgramSignatures` is still sweeping
	// files into this index, true from the moment the last one lands. It is the index's own answer to
	// "can an absence be trusted?" — during the sweep a name that is genuinely declared reads as
	// undeclared simply because its file has not been folded yet (and a file's OWN declarations are
	// folded only after its whole token walk), so a `not declared` verdict there is a fact about the
	// sweep's progress, not about the program.
	//
	// It lives HERE and not on the `Parser` because it is a property of the INDEX, not of the reader:
	// three parsers read this index (the sweeper, the real parse, the constant evaluator) and only the
	// index knows which side of the fold each of them is on. A flag threaded through `Parser.create`
	// would be the same fact written down at three call sites, free to be passed wrongly at any of them.
	export var allFilesFolded as bool
	// ⭐ **IS THE PROJECT ROOT ITSELF UNDER `stdlib/` (BATCH2 slice 1)?** A per-COMPILE fact, probed once by
	// `Queries.queryProgramSignatures` and read at every `Parser.create` to derive that parser's
	// `livesUnderStdlibDirectory` — see `Queries.livesUnderStdlibDirectory` for the derivation, its proof and
	// the ladder measurement that rejected asking it per FILE instead.
	//
	// ⚠ It lives HERE rather than on `Project` because this index is the one thing already built once per
	// compile AND threaded to every `Parser.create` site, which is exactly the shape the fact has. It is set
	// before any file is swept, so no reader can see the seeded `false`.
	export var rootIsUnderStdlibDirectory as bool
	// ⭐ **THE TYPE NAMES TOP-LEVEL CONSTANT INITIALIZERS CAST TO, scoped by declaring file** (P1.9) —
	// the one `use` the E3062 check cannot get from the parser. Written by `recordConstCastTarget` from
	// inside the constant evaluator, read by `Parser.reportUnusedTypeAliases`; both doors carry the
	// argument. Empty for every program with no top-level `let X = … as T`, which is nearly all of them.
	var constCastTargets as ConstCastTargetSet
	// ⭐ **THE `Array with Byte` INSTANCE, DERIVED ONCE PER PROGRAM.** `internArrayByteInstance` is asked on
	// HOT parser paths — every byte-string literal, every `.toByteArray()`, and since R4.2 every array
	// METHOD dispatch (`dispatchArrayMethod`'s `isManagedMemory`) — and each ask built a one-element
	// `MaxonTypeArray` to key the registry with, which is a heap ALLOCATION per array method call. The
	// answer cannot change: `GenericInstanceRegistry` only ever grows and interning is idempotent, so the
	// id the first ask mints is the id for the life of this index (which is one compile —
	// `queryProgramSignatures` builds a fresh one per signatures miss).
	//
	// A `computed` flag beside the value rather than a sentinel id, following `TokenMemo`/`ParseMemo`:
	// **0 IS A REAL `GenericInstanceId`**, so there is no spare value to mean "not yet".
	var arrayByteInstance as GenericInstanceId
	var arrayByteInstanceComputed as bool
	// ⭐⭐ **WHICH TYPE NAMES A *USER* FILE DECLARES (A1s wave 2)** — one half of the shadow contest. Filled
	// by `foldFile` for every non-stdlib file, and read only while deciding which of a LISTED STDLIB
	// module's declarations a user program has taken the name of. See `StdlibShadowRenameMap`.
	//
	// ⚠ **IT HOLDS EVERY NAME A USER DECLARATION WRITES, INCLUDING THE ILLEGAL ONES, AND THE LEGALITY
	// FILTER LIVES AT THE DECISION INSTEAD (A1s wave 2 review).** The set answers two questions and they want
	// opposite treatments of a `__` name: "may a user declaration TAKE this name from the stdlib?" (no — the
	// declaration is E2051) and "is this candidate reserved name already SPOKEN FOR?" (yes — the user wrote
	// it, legally or not). Filtering on the way IN answered the first and silently got the second wrong; the
	// filter is now `contestStdlibTypeName`'s, which is the only reader that wants it.
	var userDeclaredTypeNames as DeclaredTypeNameSet
	// The other half: every type name a LISTED STDLIB module declares, collected by the contest's own token
	// walk (`Queries.contestStdlibDeclarationsAgainstUserNames`) before any name is contested. Read only by
	// `shadowRenameIsTaken` — a mint must not land on a name the stdlib ALREADY declares, which is the third
	// claimant on the reserved space and the one no re-probe of the other two would ever notice.
	var stdlibDeclaredTypeNames as DeclaredTypeNameSet
	// The contest's ANSWER: bare name ⇒ the reserved name the stdlib declaration is moved to. EMPTY for
	// every program that shadows nothing, which is the whole existing corpus — and that emptiness is what
	// makes this mechanism byte-neutral rather than merely cheap (see `Parser.shadowRenamedTokens`).
	var stdlibShadowRenames as StdlibShadowRenameMap

	export static function create() returns ProgramSignatures
		return Self{returnTypes: FuncReturnTypeMap.create(), typeAliases: RangedAliasRegistry.create(), functionTypeAliases: FunctionTypeAliasMap.create(), structTypes: StructLayoutMap.create(), enumTypes: createEnumRegistry(), genericAliasDecls: GenericAliasEntryArray.create(), genericInstances: GenericInstanceRegistry.create(), compiledInstanceNames: CompiledInstanceNameMap.create(), canonicalInstanceNames: CanonicalInstanceNameMap.create(), tupleCanonicalNames: TupleCanonicalNameMap.create(), tupleAliases: TupleCanonicalNameMap.create(), sawAggregateArrayLiteral: false, genericAliases: GenericAliasMap.create(), genericAliasSites: GenericInstantiationSiteArray.create(), innerAliases: RangedTypeAliasMap.create(), methodInnerAliasParams: InnerAliasParamInfoMap.create(), interfaces: IrInterfaceMap.create(), interfaceDeclSites: InterfaceDeclSiteArray.create(), typeNames: TypeNameInterner.create(), decls: TopLevelDeclArray.create(), declIndex: TopLevelDeclIndexMap.create(), funcParamConsumes: ParamConsumeMap.create(), funcThrows: FuncThrowsMap.create(), funcParamDefaults: ParamDefaultMap.create(), collidingParamDefaults: CollidingParamDefaultNameSet.create(), declaredReturnSurfaces: DeclaredReturnSurfaceMap.create(), bufferElementAliases: BufferElementAliasNameSet.create(), hash: fnvOffsetBasis(), managedTopLevelNames: ManagedTopLevelNameSet.create(), storedGlobalCount: 0, allFilesFolded: false, rootIsUnderStdlibDirectory: false, constCastTargets: ConstCastTargetSet.create(), arrayByteInstance: 0, arrayByteInstanceComputed: false, userDeclaredTypeNames: DeclaredTypeNameSet.create(), stdlibDeclaredTypeNames: DeclaredTypeNameSet.create(), stdlibShadowRenames: StdlibShadowRenameMap.create()}
	end 'create'

	// --- The stdlib/user SHADOW CONTEST (A1s wave 2). See `StdlibShadowRenameMap`. ---

	// Every type name ONE user file declares, over the arrays `foldFile` was handed — the SAME declaration
	// arrays the registries are built from, so "what the user declared" and "what the index holds" are one
	// walk and cannot come to disagree. An `interface` comes through its SITE rather than through an
	// `IrInterface`, because the declaration itself is not read until `foldInterfaceDeclarations` — which
	// runs AFTER the contest is settled. See `InterfaceDeclSite.name`.
	//
	// Unfiltered on purpose; the field's own header says which reader owns the legality question and why.
	function noteUserDeclaredTypeNames(aliases RangedTypeAliasArray, functionAliases FunctionTypeAliasArray, structs StructLayoutArray, enums EnumLayoutArray, genericAliasEntries GenericAliasEntryArray, interfaceSites InterfaceDeclSiteArray)
		for alias in aliases 'eachAlias'
			self.userDeclaredTypeNames.insert(alias.name)
		end 'eachAlias'
		for functionAlias in functionAliases 'eachFunctionAlias'
			self.userDeclaredTypeNames.insert(functionAlias.name)
		end 'eachFunctionAlias'
		for layout in structs 'eachStruct'
			self.userDeclaredTypeNames.insert(layout.name)
		end 'eachStruct'
		for enumLayout in enums 'eachEnum'
			self.userDeclaredTypeNames.insert(enumLayout.name)
		end 'eachEnum'
		for genericAlias in genericAliasEntries 'eachGenericAlias'
			self.userDeclaredTypeNames.insert(genericAlias.aliasName)
		end 'eachGenericAlias'
		for site in interfaceSites 'eachInterface'
			self.userDeclaredTypeNames.insert(site.name)
		end 'eachInterface'
	end 'noteUserDeclaredTypeNames'

	// Every type name a LISTED STDLIB module declares, in the order the contest's token walk found them.
	// Recorded BEFORE any of them is contested, because `shadowRenameIsTaken` has to be able to ask about a
	// module the walk has not reached yet — see `stdlibDeclaredTypeNames`.
	export function noteStdlibDeclaredTypeNames(names ByteArrayArray)
		for name in names 'each'
			self.stdlibDeclaredTypeNames.insert(name)
		end 'each'
	end 'noteStdlibDeclaredTypeNames'

	// ⭐ **DECIDE THE CONTEST FOR ONE NAME A LISTED STDLIB MODULE DECLARES.** A no-op unless a USER file
	// declares it too; otherwise it mints the reserved name the stdlib declaration will be keyed under and
	// files it. Called once per stdlib-declared name, between the two sweep phases — see
	// `Queries.contestStdlibDeclarationsAgainstUserNames`.
	//
	// ⚠⚠ **A NAME NO USER DECLARATION MAY LEGALLY HOLD IS NOT A CONTEST, AND THE SWEEP CANNOT TELL —
	// SO THIS DOOR DOES.** The declaration sweep is deliberately TOLERANT (`Parser.recordScannedType`): it
	// folds a declaration in before the real parse gets to refuse it, so `userDeclaredTypeNames` holds names
	// the program is about to be rejected for writing. MEASURED: a user `enum __ManagedDirectoryError` —
	// which `requireUnreservedName` refuses with E2051 — contested `stdlib/Builtins.maxon`'s own declaration
	// of that name, renamed it out from under the runtime, and added a second, bogus **E4016** beside the
	// E2051 that `managed-directory.error-enum-name-is-reserved` pins. Both refusals are re-stated here
	// rather than deferred to the parse, because the contest is decided BEFORE any file is parsed.
	//
	// ⚠ **RE-PROBED, NOT PREFIXED ONCE, and against ALL THREE CLAIMANTS on the reserved space** — a user
	// declaration (E2051 forbids it, so only ever in a program already being refused), an earlier contest's
	// mint, and a stdlib declaration that spells the candidate itself. The loop terminates because each pass
	// makes the candidate strictly longer while all three sets are finite and already complete. It is
	// `reservedIfDeclared`'s loop, one namespace over.
	export function contestStdlibTypeName(name ByteArray)
		if not self.userDeclaredTypeNames.contains(name) 'uncontested'
			return
		end 'uncontested'

		if bytesStartWith(name, prefix: ReservedTypeNamePrefix) 'reservedSpace'
			return
		end 'reservedSpace'

		if isCompilerOwnedTypeName(name) 'compilerOwned'
			return
		end 'compilerOwned'

		if self.stdlibShadowRenames.contains(name) 'alreadyContested'
			return
		end 'alreadyContested'

		var renamed = "{String.from(ReservedTypeNamePrefix)}{String.from(name)}".toByteArray()
		while self.shadowRenameIsTaken(renamed) 'stillTaken'
			renamed = "{String.from(ReservedTypeNamePrefix)}{String.from(renamed)}".toByteArray()
		end 'stillTaken'
		self.stdlibShadowRenames.upsert(name, value: renamed)
	end 'contestStdlibTypeName'

	// Is this candidate reserved name already spoken for? THREE claimants, and all three matter — two names
	// must not land on ONE reserved name, which is the collision `reservedIfDeclared`'s own header warns a
	// non-reserved prefix would make silent.
	//
	// ⚠ **THE STDLIB HALF IS THE ONE NOTHING ELSE WOULD CATCH (A1s wave 2 review).** `stdlib/Builtins.maxon`
	// already declares `__`-prefixed types of its own, so a listed module declaring `X` while any listed
	// module declares `__X` would have had the mint for a shadowed `X` land ON that declaration — an E3006
	// raised inside `stdlib/`, or worse a last-wins upsert of two layouts under one key. It is unreachable
	// with today's four listed modules and is checked rather than argued, because the thing that would make
	// it reachable is ADDING A WHITELIST ENTRY, which is a one-line change made by someone reading
	// `StdlibLoader`'s collision rule and not this function.
	function shadowRenameIsTaken(candidate ByteArray) returns bool
		if self.userDeclaredTypeNames.contains(candidate) 'aUserDeclarationHoldsIt'
			return true
		end 'aUserDeclarationHoldsIt'

		if self.stdlibDeclaredTypeNames.contains(candidate) 'aStdlibDeclarationHoldsIt'
			return true
		end 'aStdlibDeclarationHoldsIt'

		return self.isMintedStdlibShadowName(candidate)
	end 'shadowRenameIsTaken'

	// Does this compile have any contest at all? The ONE gate every cost of this mechanism sits behind: for
	// the whole existing corpus it answers false, the token rewrite never runs, and the emitted bytes are
	// what they were before the mechanism existed.
	export function hasStdlibShadowRenames() returns bool
		return self.stdlibShadowRenames.count() > 0
	end 'hasStdlibShadowRenames'

	// ⭐ **IS THIS A NAME *THIS COMPILE* MINTED FOR A CONTESTED STDLIB DECLARATION?** Asked by
	// `Parser.requireUnreservedName`, which would otherwise refuse the compiler's own mint as a user's
	// reserved-prefix declaration. A linear scan of the table, which is the right shape: it is asked only
	// while a contest exists (never, for the whole existing corpus), the table holds one entry per contested
	// name, and a second index keyed the other way would be the same fact stored twice.
	export function isMintedStdlibShadowName(name ByteArray) returns bool
		for (_, minted) in self.stdlibShadowRenames 'eachMinted'
			if minted.equals(name) 'thisMint'
				return true
			end 'thisMint'
		end 'eachMinted'
		return false
	end 'isMintedStdlibShadowName'

	// ⭐ **IS THIS CALLEE ONE OF THIS COMPILE'S OWN MINTS, or a METHOD OF ONE?** `__Clock.nowMs` is what
	// `stdlib/Clock.maxon`'s own `Clock.nowMs` becomes when a user program declares `type Clock`, and the
	// reserved-CALL door (A1r) would otherwise refuse it as a user reaching for a compiler intrinsic. The
	// HEAD is what carries the mint, so the test splits the callee rather than matching a prefix — a prefix
	// test would admit `__Clockwork.tick`.
	export function isMintedStdlibShadowCallee(callee ByteArray) returns bool
		return self.isMintedStdlibShadowName(qualifiedCalleeHead(callee))
	end 'isMintedStdlibShadowCallee'

	// The name a STDLIB file must spell this identifier under — the renamed one if the name is contested,
	// and the name itself otherwise. THE one reader of the table, so a caller cannot half-apply the rename.
	export function stdlibShadowRenameOf(name ByteArray) returns ByteArray
		return try self.stdlibShadowRenames.get(name) otherwise name
	end 'stdlibShadowRenameOf'

	// Could `name` denote a top-level MANAGED binding — `let` or `var` — anywhere in this program? A
	// `false` is final; a `true` still has to be resolved by `constantValueOf`/`globalDeclFor`, which is
	// what applies file-private scoping and tells the two kinds apart. See `managedTopLevelNames`.
	export function namesManagedTopLevel(name ByteArray) returns bool
		return self.managedTopLevelNames.contains(name)
	end 'namesManagedTopLevel'

	// Fold ONE file's scanned declarations into the index. Called in SOURCE-PATH order, so the
	// index — and its hash — are a deterministic function of the program, not of the order the
	// files happened to be visited in.
	//
	// `fileTypeNames` is the interner the scan interned into (a `Parser`'s own artifact-local
	// table), so its ids are file-local. They are folded in and remapped through exactly the
	// machinery `mergeArtifact` uses for the identical job — `TypeNameInterner.foldInto` +
	// `remapMaxonReturnType`. One mechanism, two callers: a second copy of "reconcile a file's ids
	// into a bigger table" would be free to disagree with this one about what an id means.
	export function foldFile(scanned FuncReturnTypeEntryArray, aliases RangedTypeAliasArray, functionAliases FunctionTypeAliasArray, structs StructLayoutArray, enums EnumLayoutArray, genericAliasEntries GenericAliasEntryArray, innerAliasEntries InnerAliasEntryArray, methodInnerAliasParamEntries MethodInnerAliasParamEntryArray, interfaceSites InterfaceDeclSiteArray, bindings TopLevelDeclArray, paramConsumes ParamConsumeEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, fileTypeNames TypeNameInterner, isStdlibSource bool)
		// ⭐ **THE USER HALF OF THE SHADOW CONTEST (A1s wave 2)** — recorded from the SAME declaration arrays
		// the registries below are built from, so "what the user declared" and "what the index holds" are one
		// walk. Every KIND is noted, not just the four nominal ones: the contest is asymmetric on purpose (see
		// `Queries.contestStdlibDeclarationsAgainstUserNames`), because a user's ranged `typealias ParseError`
		// takes the name from a stdlib `enum ParseError` exactly as a user `type` would.
		if not isStdlibSource 'theUsersOwnFile'
			self.noteUserDeclaredTypeNames(aliases, functionAliases: functionAliases, structs: structs, enums: enums, genericAliasEntries: genericAliasEntries, interfaceSites: interfaceSites)
		end 'theUsersOwnFile'

		for alias in aliases 'eachAlias'
			self.recordAlias(alias)
		end 'eachAlias'

		// Inner ranged typealiases (P1.6-C) travel by NAME (a ranged alias's underlying is the `int`/
		// `float` keyword — no ids), so they fold alongside the ranged aliases, before the interner
		// reconciliation. Keyed by base-qualified name so `Wrapper.Idx` and a same-named inner alias of
		// another generic type stay distinct.
		for innerAlias in innerAliasEntries 'eachInnerAlias'
			self.recordInnerAlias(innerAlias.baseName, alias: innerAlias.alias)
		end 'eachInnerAlias'

		// Per-method inner-alias parameter info (P1.6-C) travels by NAME (member strings, no ids), so it
		// folds here too. Last-wins on a duplicate method name (a duplicate function is E3006, reported
		// elsewhere), exactly as `returnTypes` is.
		for methodEntry in methodInnerAliasParamEntries 'eachMethodInnerAlias'
			self.methodInnerAliasParams.upsert(methodEntry.methodName, value: methodEntry.info)
		end 'eachMethodInnerAlias'

		// Function aliases travel by NAME and carry no interner ids (their return type is stored as a
		// tag + a name ByteArray), so they fold here alongside the ranged aliases, before the interner
		// reconciliation below — nothing about them needs remapping (like `paramConsumes`/`throwsEntries`).
		for functionAlias in functionAliases 'eachFunctionAlias'
			self.recordFunctionTypeAlias(functionAlias)
		end 'eachFunctionAlias'

		// Consume facts travel by NAME and carry no ids, so they fold before the interner reconciliation
		// below — nothing about them needs remapping (like `enumTypes`).
		for entry in paramConsumes 'eachConsume'
			self.recordParamConsume(entry.name, info: entry.info)
		end 'eachConsume'

		// Default facts carry names and helper names and no ids either, so they fold here beside the consume
		// facts, ahead of the interner reconciliation.
		for entry in paramDefaults 'eachParamDefault'
			self.recordParamDefaults(entry.name, info: entry.info)
		end 'eachParamDefault'

		// Throws clauses travel by NAME and carry no ids either (the throws type is a bare enum name),
		// so they fold here alongside the consume facts, before the interner reconciliation.
		for entry in throwsEntries 'eachThrows'
			self.recordThrows(entry.name, clause: entry.clause)
		end 'eachThrows'

		// Interface declaration SITES (R8) carry no ids at all — a file path and a token index — so they fold
		// here with the consume facts and the throws clauses, ahead of the interner reconciliation and ahead of
		// the identity-remap early return below, which no by-name fold may sit after. They are only
		// ACCUMULATED: the declarations behind them are read once the last file has folded, because a
		// requirement's rendered type depends on the whole program (see `InterfaceDeclSite`) — the same
		// "noted here, performed later" split `noteAggregateArrayLiteral` uses.
		for site in interfaceSites 'eachInterfaceSite'
			self.interfaceDeclSites.push(site)
		end 'eachInterfaceSite'

		// Bindings — `let` and `var` alike — are RECORDED here and EVALUATED later
		// (`evaluateInitializers`), and the gap between the two is the whole reason a forward
		// reference works — see that function.
		for binding in bindings 'eachBinding'
			self.recordDecl(binding)
		end 'eachBinding'

		let remap = self.typeNames.foldInto(fileTypeNames)

		// A declared struct's field types are reconciled IN PLACE, before the record loop below, so
		// there is ONE recording path rather than a mapped and an unmapped one. That is the opposite
		// shape from the signatures below, and the difference is what each fold owns: a
		// `MaxonReturnType` is a union VALUE, so remapping it can only mean constructing a new one
		// (hence the two loops, and the identity fast path that skips an allocation per declared
		// function); a `StructLayout` is a heap `type` this sweep just built and still owns, so its
		// field list is simply rewritten. `remapStructLayoutFieldTypes` is the single mechanism
		// `mergeArtifact` folds the same records with.
		// A declared type's id-bearing member types — a struct's field types and a union/enum's
		// PAYLOAD field types (`walk(dir Direction)`) — are reconciled IN PLACE before the record
		// loops below, so there is ONE recording path rather than a mapped and an unmapped one. A
		// payload-free enum carries no ids, so its loop body rewrites nothing; the record loop still
		// runs unconditionally (the ids are irrelevant to WHETHER a type is declared, only to what its
		// members mean).
		if not remap.isIdentity 'typeMemberIdsMoved'
			for layout in structs 'eachMovedStruct'
				remapStructLayoutFieldTypes(layout, remap: remap)
			end 'eachMovedStruct'
			for enumLayout in enums 'eachMovedEnum'
				remapEnumLayoutPayloadTypes(enumLayout, remap: remap)
			end 'eachMovedEnum'
		end 'typeMemberIdsMoved'

		for layout in structs 'eachStruct'
			self.recordStruct(layout)
		end 'eachStruct'

		for enumLayout in enums 'eachEnum'
			self.recordEnum(enumLayout)
		end 'eachEnum'

		// Generic-instance typealiases (P1.6-A). Folded BEFORE the return-type split below (which returns
		// early on the identity fast path), so they are recorded whether or not ids moved. Each entry's
		// args are minted against the file's interner, so `recordGenericAlias` remaps them into this
		// index's interner (`remap`) before interning the instance — exactly as struct field types above.
		for genericAlias in genericAliasEntries 'eachGenericAlias'
			self.recordGenericAlias(genericAlias, remap: remap)
		end 'eachGenericAlias'

		// The remap is loop-INVARIANT, so the identity test is hoisted OUT of the per-declaration
		// loop rather than asked once per function — the same shape `mergeArtifact` uses for the same
		// fold. And the identity case is not merely a shortcut, it avoids an ALLOCATION per declared
		// function in the program: `remapMaxonReturnType` CONSTRUCTS a `MaxonReturnType`, and a Maxon
		// union value is a heap object (every case), so remapping ids that did not move would allocate
		// a fresh copy of the object it was handed, for nothing.
		//
		// ⚠ Written as two loops over one `record`, NOT as `x if remap.isIdentity else remap(x)`. The
		// ternary form LEAKS under the C# bootstrap — its arms mix a BORROWED field read with a
		// freshly-OWNED value, and the conditional does not reconcile the two ownerships (measured:
		// `MM leak: 7 allocation(s) remain` on every build, exit 101). Recorded in OPEN.md.
		if remap.isIdentity 'idsUnchanged'
			for entry in scanned 'eachUnmapped'
				self.record(entry.name, returnType: entry.returnType, declaredSurface: entry.declaredSurface)
			end 'eachUnmapped'
			return
		end 'idsUnchanged'

		for entry in scanned 'eachRemapped'
			self.record(entry.name, returnType: remapMaxonReturnType(entry.returnType, remap: remap), declaredSurface: entry.declaredSurface)
		end 'eachRemapped'
	end 'foldFile'

	// Add one declaration to the index AND fold it into the hash. The one write, so the table and the
	// hash that keys every parse memo on it can never disagree about what the index contains.
	//
	// ⭐⭐ **THE BUFFER-SPELLING WORD IS WRITTEN HERE, WITH THE RETURN TYPE IT DESCRIBES (A2j / A2m)** — one
	// line, so the table and the claim beside it are written from one place about one declaration.
	//
	// ⚠⚠ **A DECLARATION'S SURFACE IS OR-ED IN AND NEVER OVERWRITTEN, AND THAT ASYMMETRY IS LOAD-BEARING
	// RATHER THAN A SAVING.** It makes the table answer "does ANY declaration of this name name the buffer,
	// and where?", which is what `Parser.requireOverloadableName` needs to refuse an overload set the sweep
	// cannot answer for — the same "absence is the answer" shape `recordThrows` and `recordParamConsume` rest
	// on, and for their reason. MEASURED before the refusal existed, with the mark written in both directions
	// instead: an overload set `make() returns __ManagedMemory` beside `make(n Int) returns ByteArray` took the
	// LAST declaration's answer for BOTH members, so one order refused `make().length()` (the member that does
	// return the buffer) and the other refused `make(1).count()` (the member that does not). A wrong SURFACE
	// either way, and one no later pass can repair: `resolveOverloadedCalls` rebinds the callee long after the
	// parser has decided which roster the result carries. ⇒ record the positive, and refuse the contested name.
	//
	// So `declaredReturnSurface` is exact for every name that reaches a call: a name with no entry names the
	// buffer in no declaration anywhere, and a name with one is either unique or already refused.
	function record(name ByteArray, returnType MaxonReturnType, declaredSurface DeclaredSurface)
		self.returnTypes.upsert(name, value: returnType)
		if not surfaceIsPlain(declaredSurface) 'namesTheBufferAlias'
			self.declaredReturnSurfaces.upsert(name, value: declaredSurface)
		end 'namesTheBufferAlias'

		self.hash = self.mixDeclaration(self.hash, name: name, returnType: returnType, declaredSurface: declaredSurface)
	end 'record'

	// The surface already recorded for `name`, or the plain one. Split out because `Map.get` is a `try` and a
	// name with no entry is the common case rather than an error.
	function storedReturnSurface(name ByteArray) returns DeclaredSurface
		return try self.declaredReturnSurfaces.get(name) otherwise sharedEmptyDeclaredSurface
	end 'storedReturnSurface'

	// ⭐ **WHERE DOES A CALL TO `callee` NAME THE `__ManagedMemory` BUFFER (A2j / A2m)?** The door
	// `Parser.emitCall` asks of every direct, method and static call, so a result whose callee DECLARED the
	// alias — outright, or at a tuple slot, or as an array element — is marked at the one site that mints it.
	// It must be whole-program: the callee may be declared in another file, and the SPELLING is gone from
	// every type by the time the call is parsed.
	//
	// ⚠ **THE ELEMENT BIT IS DERIVED HERE AND IS NEVER STORED**, because the SWEEP that captured this
	// declaration ran while the alias registry was still being built — `returns BufArray` cannot be asked
	// "is `BufArray` an array of buffers?" at the moment it is read. What the sweep DOES preserve is the
	// alias NAME, inside the recorded return type, and by the time anything asks this question every file is
	// folded. See `declaredElementIsBufferSurface`.
	//
	// A callee with no entry and a non-alias return type costs one `Map.contains` on an empty map plus a tag
	// test per call — the safe default `funcThrows`/`funcParamConsumes` rest on. It is also the question
	// `Parser.requireOverloadableName` asks to refuse an overload set this index cannot answer for.
	export function declaredReturnSurface(callee ByteArray) returns DeclaredSurface
		let stored = self.storedReturnSurface(callee)
		if self.returnElementIsBufferSurface(callee) 'returnsAnArrayOfBuffers'
			return surfaceWithElementBuffer(stored)
		end 'returnsAnArrayOfBuffers'

		return stored
	end 'declaredReturnSurface'

	// Does `callee`'s recorded return type NAME a generic alias whose element is a buffer? The `value` arm of
	// the recorded `MaxonReturnType`, asked through the one derivation every declared slot uses.
	function returnElementIsBufferSurface(callee ByteArray) returns bool
		if let declared = try self.returnTypes.get(callee) 'declaresAReturnType'
			return match declared 'r'
				void gives false
				value(inner) gives self.declaredElementIsBufferSurface(inner)
			end 'r'
		end 'declaresAReturnType'

		return false
	end 'returnElementIsBufferSurface'

	// ⭐ **WAS THIS DECLARED SLOT'S TYPE A GENERIC ALIAS WHOSE ELEMENT IS A BUFFER (A2m)?** THE one derivation,
	// shared by the struct-FIELD door (`fieldSurfaceOf`) and the RETURN door above, so the two cannot come to
	// disagree about what `var bufs as BufArray` and `returns BufArray` mean.
	//
	// It reads the `named` the SWEEP recorded and not a resolved type, and that is the whole mechanism: the
	// sweep runs before any alias is interned, so an alias-typed slot arrives as a bare `named` carrying the
	// name (this is the very property `declaredSlotType`'s re-tags exist to undo). A slot that is
	// already a `genericInstance` was written with a spelling that is not an alias name at all, and there is
	// nothing left in it to ask — which is correct, because `Array with __ManagedMemory` and
	// `Array with ByteArray` ARE that one instance.
	export function declaredElementIsBufferSurface(declared MaxonType) returns bool
		if maxonTypeTag(declared) != ValueTypeTag.named 'notANamedAlias'
			return false
		end 'notANamedAlias'

		return self.aliasElementIsBufferSurface(self.nameOfId(typeNameIdOf(declared)))
	end 'declaredElementIsBufferSurface'

	// Does the generic-instance alias `name` hold BUFFERS — was it declared `Array with __ManagedMemory`
	// (A2m)? The read side of `bufferElementAliases`; `Set.contains` on the shared empty set returns before it
	// hashes, so a program that never writes the alias does not pay to ask.
	export function aliasElementIsBufferSurface(name ByteArray) returns bool
		return self.bufferElementAliases.contains(name)
	end 'aliasElementIsBufferSurface'

	// Add one function's consume bits to the index AND fold them into the hash. The one write, for
	// `record`'s reason: the table and the hash that keys every parse memo on it cannot disagree about what
	// the index contains. A function with NO consumed parameter is not recorded (its default answer is "not
	// consumed"), so the common function costs no map entry and no hash movement — the same "absence is the
	// answer" the sweep's over-approximation rests on.
	function recordParamConsume(name ByteArray, info ParamConsumeInfo)
		self.funcParamConsumes.upsert(name, value: info)
		var state = mixBytes(mix(self.hash, value: DeclShapeParamConsume), bytes: name)
		// The param NAMES ride too: a rename changes which labelled argument a caller slots to a consumed
		// position, so a caller's memo must move when they do (`transferConsumedArgs` slots against them
		// through `argSlotPosition`).
		for i in 0 upto info.paramNames.count() 'eachName'
			let paramName = try info.paramNames.get(i) otherwise panic("recordParamConsume: paramNames.get OOB at {i} despite i < count")
			let bit = info.isConsumed(i)
			state = mix(mixBytes(state, bytes: paramName), value: ConsumeBitSet if bit else ConsumeBitClear)
		end 'eachName'
		// The TYPE-PARAMETER FEEDS ride too (P1.6-B2): which position a parameter feeds decides whether a
		// caller consumes a managed argument there, so a change to it must move the caller's parse memo. Only a
		// generic constructor HAS a feed list (a non-generic function's `feeds` is EMPTY, so this loop does not
		// run and adds nothing — matching that such a function can never feed a type parameter). The STORED
		// feeds are read directly, never through `typeParamFeedOf`, whose out-of-range `none` would box a union
		// value per parameter on every consuming function in the program.
		for i in 0 upto info.feeds.count() 'eachFeed'
			state = self.mixTypeParamFeed(state, feed: try info.feeds.get(i) otherwise panic("recordParamConsume: feeds.get OOB at {i} despite i < count"))
		end 'eachFeed'
		self.hash = state
	end 'recordParamConsume'

	// Fold one parameter's type-parameter feed into the hash — `feeds(position)` mixes its position, `none`
	// its own discriminator (so a parameter that GAINED a feed hashes distinctly from one that never had one).
	function mixTypeParamFeed(state ContentHash, feed TypeParamFeed) returns ContentHash
		return match feed 'f'
			feeds(position) gives mix(mix(state, value: FeedShapeFeeds), value: position)
			none gives mix(state, value: FeedShapeNone)
		end 'f'
	end 'mixTypeParamFeed'

	// ⭐ **DOES `callee` CONSUME (take ownership of) ITS ARGUMENT AT POSITION `index`?** THE door the
	// callee-side enrollment asks per parameter. A callee with no recorded entry, or an index past its
	// recorded bits, is a BORROW (false) — the safe default, and what makes recording only the consuming
	// functions correct.
	export function paramIsConsumed(callee ByteArray, index ParamCount) returns bool
		return match self.consumeOf(callee) 'c'
			consumes(info) gives info.isConsumed(index)
			borrowsAll gives false
		end 'c'
	end 'paramIsConsumed'

	// ⭐ **THE TYPE-PARAMETER FEED of `callee`'s parameter at position `index`, or `none`** (P1.7 slice 3b-v).
	// The callee-entry twin of `paramIsConsumed`: an opaque-`T` FEED parameter (`push(item Element)` whose
	// `item` moves into `self.items`, or a sibling forwarder the transitive fixpoint marked) is enrolled OWNED
	// in the shared body so a double / conditional move is move-tracked and dropped once. A callee with no
	// recorded entry, or an index past its recorded feeds, is `none` — the same borrow-default `paramIsConsumed`
	// answers false for.
	export function paramFeedOf(callee ByteArray, index ParamCount) returns TypeParamFeed
		return match self.consumeOf(callee) 'c'
			consumes(info) gives info.typeParamFeedOf(index)
			borrowsAll gives TypeParamFeed.none
		end 'c'
	end 'paramFeedOf'

	// ⭐ **DOES `callee` FEED ANY parameter into a type parameter?** (P1.7 slice 3b-v) — the descriptor-need
	// seed reads this: a method that enrols an opaque feed parameter owned may DROP it on a path that does not
	// move it (a conditional `push`/forward), and that drop reads the enclosing instance's layout descriptor
	// `destroyFunc@40` at run time, so the method must carry the descriptor parameter. A borrow-only callee (no
	// entry) feeds nothing.
	export function functionFeedsTypeParam(callee ByteArray) returns bool
		return match self.consumeOf(callee) 'c'
			consumes(info) gives info.feedsAnyTypeParam()
			borrowsAll gives false
		end 'c'
	end 'functionFeedsTypeParam'

	// ⭐ **THE CALLEE'S CONSUME FACTS, or `borrowsAll`** — the door a CALL SITE asks once, then slots each
	// argument against `info.paramNames` to decide which ones are moved. `borrowsAll` (no recorded entry) is
	// every runtime callee, every borrow-only user function, and the overwhelming common case — so the call
	// site's fast path is a single `match` with nothing to slot.
	export function consumeOf(callee ByteArray) returns CalleeConsume
		let info = try self.funcParamConsumes.get(callee) otherwise return CalleeConsume.borrowsAll
		return CalleeConsume.consumes(info)
	end 'consumeOf'

	// Record one function's per-parameter DEFAULTS AND fold them into the hash — the one write, for
	// `recordParamConsume`'s reason. A function with NO default is not recorded (its default answer is
	// "every parameter is required"), so the common function costs no map entry and no hash movement.
	function recordParamDefaults(name ByteArray, info ParamDefaultInfo)
		// ⚠ **THE OVERWRITE IS NOTED, BECAUSE THE KEY IS NOT UNIQUE.** Two files may each declare
		// `function f` with defaults; the map keeps one, and the other file's own parse would then look up
		// a position the winner holds no helper at. MEMBERSHIP IS THE WHOLE TEST — a name reaches here once
		// per DECLARATION that defaults something, so a second arrival IS a second declaration, and the two
		// need not be compared. (A program that declares one name twice is E3006 either way; all that is
		// decided here is whether it is refused with a position or with the drain's panic.)
		if self.funcParamDefaults.contains(name) 'twoDeclarationsOfOneName'
			self.collidingParamDefaults.insert(name)
		end 'twoDeclarationsOfOneName'

		self.funcParamDefaults.upsert(name, value: info)
		var state = mixBytes(mix(self.hash, value: DeclShapeParamDefault), bytes: name)
		// The param NAMES ride for `recordParamConsume`'s reason — a rename changes which labelled argument
		// slots to a defaulted position — and the per-position presence bit rides because it is what decides
		// whether a caller's short call is legal at all.
		//
		// ⚠ **THE DEFAULT'S EXPRESSION DELIBERATELY DOES NOT RIDE**, and that is ARCHITECTURE.md's "mix what
		// a reader COPIES" rule, not an omission. A reader copies NOTHING out of the expression: it emits
		// `call __paramDefault#f#0`, byte-identical whether the default is `"World"` or `"Maxon"`, and the
		// expression reaches only the DECLARING file's own helper body — which re-parses on that file's own
		// content hash. What a reader does depend on is the helper's RETURN TYPE, and that rides already,
		// through the ordinary `FuncReturnTypeEntry` the same sweep publishes for it. Mixing the expression
		// would be sound and WRONG: every keystroke inside any default would re-parse the whole program,
		// which is the `var`-payload mistake one registry over.
		for i in 0 upto info.paramNames.count() 'eachName'
			let paramName = try info.paramNames.get(i) otherwise panic("recordParamDefaults: paramNames.get OOB at {i} despite i < count")
			let hasDefault = not info.helperFor(i).isEmpty()
			state = mix(mixBytes(state, bytes: paramName), value: DefaultBitSet if hasDefault else DefaultBitClear)
		end 'eachName'
		self.hash = state
	end 'recordParamDefaults'

	// ⭐ **THE CALLEE'S DEFAULT FACTS, or `allRequired`** — the door a CALL SITE asks once, and only when it
	// supplied fewer arguments than it might have. `allRequired` (no recorded entry) is every runtime callee
	// and every function that declares no default, which is the overwhelming common case — so the call
	// site's fast path is a single map miss and nothing to slot.
	export function defaultsOf(callee ByteArray) returns CalleeParamDefaults
		let info = try self.funcParamDefaults.get(callee) otherwise return CalleeParamDefaults.allRequired
		return CalleeParamDefaults.defaults(info)
	end 'defaultsOf'

	// ⚡ **DOES `callee` DECLARE A DEFAULT ON ANY PARAMETER? — the presence-only half of `defaultsOf`, and
	// the one a HOT PATH may ask.** Membership IS the answer, because only a function that declares a default
	// is recorded, so this is a `contains` and not a `get otherwise` — whose fallback would mint a
	// payload-free `allRequired` union case (still a heap object) at every one of the program's calls that
	// is not to a defaulting callee, i.e. almost all of them. The same accounting `throwsMap.contains` is
	// written for one registry over.
	//
	// Two askers: `Parser.fillOmittedArgDefaults`' gate, and `Parser.overloadRegistrationNameFor`'s refusal
	// to overload a name whose defaults the by-name sweep could not tell apart.
	export function declaresParamDefaults(callee ByteArray) returns bool
		return self.funcParamDefaults.contains(callee)
	end 'declaresParamDefaults'

	// Did TWO declarations of `name` each publish parameter defaults, so that the registry holds one and
	// the other cannot find itself? See `CollidingParamDefaultNameSet`.
	export function paramDefaultsCollide(name ByteArray) returns bool
		return self.collidingParamDefaults.contains(name)
	end 'paramDefaultsCollide'

	// Record one function's `throws E` clause AND fold it into the hash — the one write, for `record`'s
	// reason. A NON-throwing function is not recorded (its default answer is "does not throw"), so the
	// common function costs no map entry and no hash movement, exactly as `recordParamConsume` treats a
	// borrow-only one.
	function recordThrows(name ByteArray, clause ThrowsClause)
		if not throwsClauseIsThrowing(clause) 'nonThrowing'
			return
		end 'nonThrowing'

		self.funcThrows.upsert(name, value: clause)
		// The THROWS TYPE NAME rides too — a callee that changes which error it throws changes what type a
		// caller's `(e)` binding recovers — and it rides through the SHARED `mixThrowsClause`, so a function's
		// clause and an interface requirement's clause enter the hash the one way.
		self.hash = mixThrowsClause(mixBytes(mix(self.hash, value: DeclShapeThrows), bytes: name), clause: clause)
	end 'recordThrows'

	// ⭐ **THE CALLEE'S `throws` CLAUSE, or `none`** — the door a call site asks: does this callee throw,
	// and what error type does it throw? `none` (no recorded entry) is every non-throwing function and the
	// common case. Read by the parser (to type an `(e)` binding) and by SemanticCheck (E3055/E3057).
	export function throwsOf(callee ByteArray) returns ThrowsClause
		// ⭐ **A COMPILER-INTERNAL RUNTIME CALLEE IS NOT IN `funcThrows`, AND CANNOT BE (R4.1).** That map is
		// filled by the declaration sweep from DECLARED functions; `__mf_open_read` is minted at lowering and
		// no file declares it, so the map will never hold it however the sweep is extended.
		//
		// ⚠ **Until this arm existed the consequence was invisible and specific:** `try … otherwise (e)` bound
		// `e` with NO type, so `match e` fell to the scalar path and reported "enum-case patterns arrive in a
		// later wave" — a message about a missing FEATURE, for a program whose feature is present. MEASURED
		// against the control: the identical `match` over a USER enum's error compiles and runs, so the gap
		// was the binding's type, not the match.
		//
		// ⚠ WHICH families answer is `runtimeThrowsClause`'s to say, not this function's — see it for why a
		// family answering `none` is a scoped statement rather than an oversight. It is asked ONCE here so a
		// family added there is typed at every `(e)` binding without this door growing a second `match`.
		// (R4.2's `__ManagedMemory` members were the second family, and they were added in review: the rung
		// declared an eight-case error enum that nothing could discriminate.)
		let runtimeClause = runtimeThrowsClause(callee)
		if throwsClauseIsThrowing(runtimeClause) 'runtimeCallee'
			return runtimeClause
		end 'runtimeCallee'

		return try self.funcThrows.get(callee) otherwise ThrowsClause.none
	end 'throwsOf'

	// ⭐⭐ **ADD ONE DECLARED INTERFACE TO THE INDEX AND FOLD IT INTO THE HASH (R8)** — the one write, for
	// `record`'s reason. Last-wins on a duplicate interface name (a duplicate declaration is the real parse's
	// to report, with a position), exactly as `returnTypes` is.
	//
	// ⚠ **WHAT RIDES THE HASH IS WHAT A *PARSE* COPIES OUT OF THIS DECLARATION, AND THAT IS LESS THAN THE
	// RECORD HOLDS.** This hash keys every parse memo, so the rule is the one stated at `ProgramSignatures.hash`
	// and sharpened at "MIX WHAT A READER COPIES": a fact rides iff changing it changes what ANOTHER file
	// compiles to while that file's own bytes stay put.
	//
	//   • The `uses` ARITY rides (R7's fact, unchanged): it decides whether the comma in `implements Duo with
	//     A, B` opens a second ARGUMENT or a second INTERFACE, so it changes what a conformance in any file
	//     PARSES — a reader that did not re-parse would go on binding the old count.
	//   • Each method's NAME, RETURN TYPE, FORMAL TYPES, FORMAL NAMES and `throws` ride: a witness dispatch in
	//     any file picks its table SLOT, its result type, its `Self`-formal rejection, its `name:` label
	//     vocabulary and its calling ABI off exactly those five (`Parser.findWitnessDispatchCandidates`), and every one
	//     of them is baked into that file's emitted code. A dispatch compiled against the previous `throws`
	//     reads a flag register the callee never writes.
	//   • **`extendsInterfaces` RIDES, and it did NOT until R10c — which is a fact about the PARSE changing, not
	//     a correction.** The claim it used to carry ("nothing in a PARSE reads it") was true while a witness
	//     dispatch resolved against `iface.methods` alone. It stopped being true the moment the dispatch began
	//     numbering its slot against the interface's TRANSITIVE requirement list: adding `extends Base` to an
	//     interface now moves every slot index a `where T is Derived` dispatch compiles into ANOTHER file,
	//     while that file's own bytes stay put — the exact test this rule states. Only the parent NAMES ride;
	//     the parents' own methods reach the hash through their own entries, since one hash is folded over
	//     every declaration in the program.
	//   • **`isStatic` RIDES, and it did NOT until the A2w review — `extendsInterfaces`' story exactly, one
	//     rung later.** The claim it used to carry ("nothing in a PARSE reads it; `ConformanceCheck` does, but
	//     off `project.interfaces`") was true while a witness dispatch bound whatever requirement the name
	//     search reached. A2w made a PARSE read it: `Parser.requireWitnessDispatchCandidates` REFUSES a
	//     dispatch whose requirements are all `static` (E3116), and `IrInterface.witnessTargetIsProtocol`
	//     refuses a `static` look-alike as `Equatable`/`Comparable` (E3005). So `function origin()` becoming
	//     `static function origin()` here decides whether a `where T is Origin` body in ANOTHER file compiles
	//     at all, while that file's own bytes stay put — the exact test this rule states. It is NOT the
	//     "sound, and useless" key: a receiver kind is not a payload nobody outside the file can observe, and
	//     the edit that moves it is rare.
	//     MEASURED before the fix (`verify-warm-rebuild`, 2-file project + stdlib): a `static`-flag edit
	//     re-parsed **1** file where the property demands **8**. `VerifyWarmRebuild.ReceiverKindEditBefore`
	//     is the probe, and it is the only one here that can see this — the other four move a NAME or a
	//     VALUE, and a key mixing those moves on all of them.
	export function recordInterfaceDeclaration(iface IrInterface)
		self.interfaces.upsert(iface.name, value: iface)

		self.hash = mix(mixBytes(mix(self.hash, value: DeclShapeInterface), bytes: iface.name), value: iface.associatedTypeNames.count())
		for parentName in iface.extendsInterfaces 'eachParent'
			self.hash = mixBytes(mix(self.hash, value: DeclShapeInterfaceParent), bytes: parentName)
		end 'eachParent'
		for method in iface.methods 'eachMethod'
			self.hash = mixBytes(mixBytes(mix(self.hash, value: DeclShapeInterfaceMethod), bytes: method.name), bytes: method.returnTypeName)
			self.hash = mixInterfaceFormals(self.hash, names: method.paramNames, types: method.paramTypeNames)
			self.hash = mixThrowsClause(self.hash, clause: method.throwsClause)
			self.hash = mix(self.hash, value: MethodShapeStatic if method.isStatic else MethodShapeInstance)
		end 'eachMethod'
	end 'recordInterfaceDeclaration'

	// ⭐⭐ **THE DECLARED-INTERFACE STORE A *PARSE* MAY ASK, HANDED OUT WHOLE (R8; widened to the map by
	// R10c)** — the whole-program half of the parse-time answer, `structOf`'s twin. `project.interfaces` is not
	// merged until every file has parsed, so this map is the only interface store that exists mid-parse.
	//
	// ⚠ **IT REPLACED AN `interfaceOf(name)` LOOKUP, AND THE REASON IS THIS RUNG'S OWN THESIS.** That
	// accessor answered for ONE name, so its caller (`Parser.lookupInterfaceForParse`) had to spell the
	// "synthesized protocol FIRST, then the store" rule for itself — a second spelling of
	// `IrInterface.lookupInterface`, which the header of the one it collapsed forbids in so many words:
	// *"what may NOT stand is two readers in the SAME phase"*. R10c made that live rather than latent: a
	// witness dispatch resolves its CONSTRAINT's interface through the parser's spelling and every `extends`
	// PARENT through `lookupInterface`, one call apart. Two rules that agree today and would diverge silently
	// — a parent that resolves for the slot walk but not for the constraint is a wrong slot COUNT, with no
	// diagnostic. Handing out the store instead of an answer leaves exactly one statement of the rule.
	export function interfaceMap() returns IrInterfaceMap
		return self.interfaces
	end 'interfaceMap'

	// Add one declared struct type to the index AND fold it into the hash. The one write, for
	// `record`'s reason: the table and the hash that keys every parse memo on it cannot disagree
	// about what the index contains.
	//
	// ⚠ **THE HASH CARRIES THE FIELD LIST, NOT MERELY THE NAME**, and that is `recordAlias`'s
	// argument about ranges applied to a layout. Every reader of `type Point` COPIES its layout into
	// its own code — `p.y` becomes `loadIndirect … offset 8`, and `Point.create` becomes an
	// `__mm_alloc` of 16 — while the reading file's own bytes never move. So reordering Point's
	// fields, renaming one, or adding a third changes what every other file COMPILES TO, and only
	// this hash can carry it. Without it, adding a field would leave every reader inlining the old
	// offsets against a box that is now a different shape: a silent out-of-bounds read.
	//
	// ⚠ **EVERY FACT A FIELD CARRIES RIDES THIS HASH, AND `mixField` IS THE ONE PLACE THEY DO.** The
	// two P1.1a-wave-2 facts are here for the reason the field list is, one each way:
	//   • a DEFAULT changes CODEGEN — `export var value = 0` → `= 1` moves the `literal` op every
	//     other file's `Self{}` emits, while that file's own bytes never move;
	//   • MUTABILITY changes ACCEPTANCE — `var count` → `let count` must turn every other file's
	//     `c.count = 5` into E2013, and a reader that did not re-parse would go on compiling it.
	//
	// v1 is the cautionary tale, and its bug is live: `StdlibCache.maxon:1494-1506` serializes 6 of
	// `StructField`'s 7 payload fields — `isMutable` survives, `hasDefault` was never written — so
	// every cached stdlib field arrives claiming it has no default. A hand-listed copy of a record's
	// fields is a copy that can be short by one, silently. Keep the list in ONE function.
	function recordStruct(layout StructLayout)
		// ⭐⭐ **A DECLARED `type` UNDER A COMPILER-OWNED NAME IS NOT REGISTERED — `upsertDeclaredEnum`'s
		// rule, one registry over (P1.8 Slice E).** The parse-time reject
		// (`Parser.requireTypeNameNotCompilerOwned`, E2015) is what the AUTHOR sees, but it cannot be what
		// keeps the registry honest: the declaration SWEEP is deliberately not a validator, so it folds the
		// declaration in before the real parse gets to refuse it, and every reader that resolves the name
		// through this registry then follows the user's declaration while `denotedNamedType` erases the name
		// to the builtin's own type.
		//
		// ⚠ MEASURED, on `type Codepoint … end` with `stdlib/helpers/string/utf16.maxon` whitelisted: the
		// E2015 was reported correctly AND `utf16Width`'s `codepoint < 65536` became
		// **`E3005 cannot compare struct with int`, TWICE, positioned inside a stdlib file the author never
		// opened** — the user's struct having captured the parameter type of a module they did not write.
		// Dropping the declaration at the single write makes the collision unrepresentable rather than merely
		// diagnosed, which is the property the enum registry already has and for the same stated reason.
		if isCompilerOwnedTypeName(layout.name) 'compilerOwned'
			return
		end 'compilerOwned'

		self.structTypes.upsert(layout.name, value: layout)

		var state = mixBytes(mix(self.hash, value: DeclShapeStruct), bytes: layout.name)
		// The type PARAMETERS ride the hash (P1.6-A): a change to `uses T` — a rename, or a change in
		// COUNT — changes which `Box with …` instantiations are the right arity in any file, so a reader's
		// parse memo must move with it. Mixed BEFORE the fields (a field's `typeParameter(pos)` is only
		// meaningful against this list).
		for i in 0 upto layout.typeParamCount() 'eachTypeParam'
			let paramName = try layout.typeParamNames.get(i) otherwise panic("ProgramSignatures.recordStruct: typeParamNames.get OOB at {i}")
			state = mixBytes(mix(state, value: DeclShapeTypeParam), bytes: paramName)
		end 'eachTypeParam'
		// The `where` constraints ride the hash (P1.7a slice 2a): a change to `where T is Digest` changes
		// which `Box with …` are legal (E3017) and which witness table a dispatch reads in any file, so a
		// reader's parse memo must move with it. Each entry's constrained-param INDEX and interface NAME are
		// mixed, in list order — the witness-slot order depends on that order too.
		for i in 0 upto layout.whereConstraintCount() 'eachConstraint'
			let constraint = try layout.whereConstraints.get(i) otherwise panic("ProgramSignatures.recordStruct: whereConstraints.get OOB at {i}")
			state = mixBytes(mix(mix(state, value: DeclShapeWhereConstraint), value: constraint.typeParamIndex), bytes: constraint.interfaceName)
		end 'eachConstraint'
		for i in 0 upto layout.fieldCount() 'eachField'
			state = self.mixField(state, layout: layout, index: i)
		end 'eachField'
		self.hash = state
	end 'recordStruct'

	// Add one declared enum/union to the index AND fold it into the hash — `recordStruct`'s twin.
	//
	// ⚠ **THE HASH CARRIES THE CASE LIST AND THE TAGS, NOT MERELY THE NAME**, for `recordStruct`'s
	// reason applied to an enum. Every reader of `enum Color` COPIES its facts into its own code:
	// `Color.red` becomes an i64 `literal` of the tag, and a `match` over it becomes a chain of
	// compares against the tags plus an exhaustiveness check over the case NAMES. So changing a tag
	// (`red = 5`), reordering the cases (which moves a range arm's coverage), renaming one, or adding
	// a case changes what every other file COMPILES TO — while the reading file's own bytes never
	// move. Only this hash can carry it. The `isUnion` bit rides too: `enum` → `union` changes the
	// word a non-exhaustive-match diagnostic prints, and a reader that met that diagnostic must
	// re-parse to reprint it.
	function recordEnum(layout EnumLayout)
		upsertDeclaredEnum(self.enumTypes, layout: layout)

		var state = mix(mixBytes(mix(self.hash, value: DeclShapeEnum), bytes: layout.name), value: EnumKindUnion if layout.isUnion else EnumKindEnum)
		// The `implements` list rides for the field list's reason (A1s wave 2): whether `enum E implements
		// Error` says so decides whether ANOTHER file's `type X implements Parsable` with `throws E` is
		// ACCEPTED (`ConformanceCheck.requireImplErrorConformsToRequirement`) — so adding or removing the
		// clause changes what that file compiles to while its own bytes never move, which is exactly the
		// rule stated at `recordStruct`.
		for name in layout.conformsTo 'eachConformance'
			state = mixBytes(mix(state, value: DeclShapeEnumConformance), bytes: name)
		end 'eachConformance'
		for i in 0 upto layout.caseCount() 'eachCase'
			state = self.mixEnumCase(state, layout: layout, index: i)
		end 'eachCase'
		self.hash = state
	end 'recordEnum'

	// Add one generic-instance typealias to the index AND fold it into the hash (P1.6-A) —
	// `recordStruct`'s twin. The base NAME is interned into this index's own interner, the args are
	// REMAPPED into it (they were minted against the scanning file's interner), the instance is
	// interned to a `GenericInstanceId`, and the alias name is mapped to it. Last-wins on a duplicate
	// alias (a duplicate typealias is reported elsewhere), exactly as `recordAlias` is.
	function recordGenericAlias(entry GenericAliasEntry, remap TypeNameRemap)
		let baseId = self.typeNames.intern(entry.baseName)
		let args = self.resolveGenericArgs(entry, remap: remap)
		let giid = self.genericInstances.intern(baseId, args: args)
		self.genericAliases.upsert(entry.aliasName, value: giid)
		self.genericAliasDecls.push(entry)

		// ⭐ The ELEMENT SPELLING (A2m) — the one fact `giid` structurally cannot carry, since
		// `Array with __ManagedMemory` and `Array with ByteArray` intern to the identical instance. Recorded
		// beside the instance it belongs to, so an alias cannot end up in one table and not the other.
		if entry.elementIsBuffer 'elementNamesTheBuffer'
			self.bufferElementAliases.insert(entry.aliasName)
		end 'elementNamesTheBuffer'

		// Record the instantiation SITE (P1.7a slice 2a) for the E3017 where-constraint check — only when the
		// alias carries a real source anchor (a top-level `typealias X = Base with Args`; a synthesized alias
		// has none). The `giid` + anchor is all the check needs: the base's constraints and the substituted args
		// are read off `giid`.
		if entry.nameLine != 0 'hasAnchor'
			self.genericAliasSites.push(GenericInstantiationSite.create(giid, nameLine: entry.nameLine, nameColumn: entry.nameColumn, filePath: entry.filePath))
		end 'hasAnchor'

		// The alias name, its base name, its ELEMENT SPELLING and each arg's SHAPE ride the hash — a change to
		// any of them changes what a `IntBox.create(…)` in another file resolves and type-checks against, and
		// the spelling is the one `mixType` cannot carry (both arguments fold to one `genericInstance`).
		let elementSpelling = SurfaceBitElementIsBuffer if entry.elementIsBuffer else 0 as DeclaredSurfaceNode
		var state = mix(mixBytes(mixBytes(mix(self.hash, value: DeclShapeGenericAlias), bytes: entry.aliasName), bytes: entry.baseName), value: elementSpelling)
		for arg in args 'eachHash'
			state = self.mixType(state, t: arg)
		end 'eachHash'
		self.hash = state
	end 'recordGenericAlias'

	// Resolve an alias entry's flat pre-order arg tree to concrete `MaxonType`s in THIS index's interner
	// (P1.6-B2) — interning nested instances DEPTH-FIRST. A leaf remaps its file-interner type through
	// `remap`; a nested instance header resolves its own args (advancing the shared cursor), interns the
	// instance, and yields `genericInstance(gid)`. The top-level list starts a FRESH cursor; a nested
	// instance shares its parent's, so both walk the flat tree through the one `resolveArgList` loop.
	function resolveGenericArgs(entry GenericAliasEntry, remap TypeNameRemap) returns MaxonTypeArray
		var cursor = ArgCursor.create()
		return self.resolveArgList(entry.args, count: entry.argCount, cursor: cursor, remap: remap)
	end 'resolveGenericArgs'

	// Resolve `count` consecutive pre-order arg nodes from `nodes` at `cursor`, advancing it past each — the
	// ONE loop the top-level alias args and a nested instance's args share (they differ only in whether the
	// cursor is fresh or their parent's). A nested instance is interned before the outer arg that holds it.
	function resolveArgList(nodes GenericArgNodeArray, count FieldIndex, cursor ArgCursor, remap TypeNameRemap) returns MaxonTypeArray
		var out = MaxonTypeArray.create()
		for _ in 0 upto count 'each'
			out.push(self.resolveArgNode(nodes, cursor: cursor, remap: remap))
		end 'each'
		return out
	end 'resolveArgList'

	function resolveArgNode(nodes GenericArgNodeArray, cursor ArgCursor, remap TypeNameRemap) returns MaxonType
		let node = try nodes.get(cursor.pos) otherwise panic("ProgramSignatures.resolveArgNode: cursor {cursor.pos} out of range for a {nodes.count()}-node arg tree — the pre-order flattening and its counts disagree")
		cursor.pos = cursor.pos + 1
		return match node 'k'
			leaf(argType) gives remapMaxonType(argType, remap: remap)
			instanceHeader(baseName, argCount) gives self.internNestedNode(baseName, argCount: argCount, nodes: nodes, cursor: cursor, remap: remap)
		end 'k'
	end 'resolveArgNode'

	function internNestedNode(baseName ByteArray, argCount FieldIndex, nodes GenericArgNodeArray, cursor ArgCursor, remap TypeNameRemap) returns MaxonType
		let baseId = self.typeNames.intern(baseName)
		let args = self.resolveArgList(nodes, count: argCount, cursor: cursor, remap: remap)
		return MaxonType.genericInstance(self.genericInstances.intern(baseId, args: args))
	end 'internNestedNode'

	// Fold one case's NAME and TAG into the enum's hash. Split out so the SIGNED tag (`ParsedInt`)
	// crosses to the UNSIGNED hash domain through a local — `recordAlias`/`mixDefaultPayload` have
	// the same two lines for the same reason (the bootstrap rejects the cast as unneeded, E3010, when
	// it is written inline as a nested `mix` argument).
	function mixEnumCase(state ContentHash, layout EnumLayout, index CaseIndex) returns ContentHash
		let named = mixBytes(state, bytes: layout.caseNameAt(index))
		let tagBits = layout.tagOfIndex(index) as ContentHash
		return mix(named, value: tagBits)
	end 'mixEnumCase'

	// Fold EVERYTHING the compiler reads off field `index` into the index's hash. See `recordStruct`
	// for why each fact must ride, and why they must all ride from one place.
	function mixField(state ContentHash, layout StructLayout, index FieldIndex) returns ContentHash
		let fieldName = try layout.fieldNames.get(index) otherwise panic("ProgramSignatures.mixField: fieldNames.get OOB at {index}")
		let fieldType = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.mixField: fieldTypes.get OOB at {index} — the field columns fell out of lockstep")

		let named = self.mixType(mixBytes(state, bytes: fieldName), t: fieldType)
		let withMutability = mix(named, value: FieldShapeMutable if layout.fieldIsMutable(index) else FieldShapeImmutable)
		// The declared SPELLING (A2j / A2m) — the one fact here `mixType` structurally cannot carry, since
		// `__ManagedMemory` and `ByteArray` fold to the identical `genericInstance`. See `FieldShapeSurface`.
		let withSpelling = mixSurface(mix(withMutability, value: FieldShapeSurface), surface: layout.fieldDeclaredSurface(index))
		return self.mixFieldDefault(withSpelling, defaultValue: layout.fieldDefault(index))
	end 'mixField'

	// The DEFAULT half of `mixField`. `none` mixes its own shape rather than nothing: a field that
	// gained a default must hash differently from one that never had it, and `= 0` on a field whose
	// payload would otherwise fold to the same 0 is exactly the collision that would hide it.
	function mixFieldDefault(state ContentHash, defaultValue FieldDefault) returns ContentHash
		return match defaultValue 'shape'
			none gives mix(state, value: FieldShapeNoDefault)
			literal(payload, tag) gives self.mixDefaultLiteral(state, payload: payload, tag: tag)
		end 'shape'
	end 'mixFieldDefault'

	// The literal half of a defaulted field's hash. Split from `mixFieldDefault` so the payload
	// arrives as a bound PARAMETER: it is SIGNED (`ParsedInt` — and a float default's is a bit
	// pattern that routinely has its top bit set) while the hash domain is unsigned, so it crosses
	// by an explicit cast, and that cast needs a local. `recordAlias` has the same two lines for the
	// same reason: written inline as an argument to a nested `mix`, the bootstrap misreads it as
	// already-hashed and rejects the cast as unneeded (E3010) — a false positive that costs nothing
	// to route around.
	//
	// ⚠ **THE TAG RIDES, AND THE PAYLOAD ALONE WOULD NOT CARRY IT.** A default is stored as the source
	// wrote it and widened only when it fills a slot (`Parser.fillFieldDefault`), so the tag is a real
	// input to what a reader compiles to — and it is the one input the payload cannot stand in for:
	// `= 0` and `= 0.0` have the SAME `ParsedInt` (zero is the one fixed point of int→f64 bits) and
	// differ only here. Hashing the pair keeps a memo from surviving an edit between them.
	//
	// It rides through `mixValueTag`, the door a top-level constant's tag already uses, and NOT through
	// the enum's ordinal — see the shape constants' own header: an ordinal is not a value in Maxon, and a
	// hash that moved when `ValueTypeTag`'s arms were REORDERED would invalidate every parse memo in the
	// project for a change that means nothing.
	function mixDefaultLiteral(state ContentHash, payload ParsedInt, tag ValueTypeTag) returns ContentHash
		let payloadBits = payload as ContentHash
		return mix(self.mixValueTag(mix(state, value: FieldShapeDefaulted), tag: tag), value: payloadBits)
	end 'mixDefaultLiteral'

	// Add one ranged typealias to the index AND fold it into the hash. The hash carries the RANGE
	// and not merely the name, and that is load-bearing: widening `int(0 to 100)` to
	// `int(0 to u64.max)` makes the type UNSIGNED, which changes what every `shr` on it MEANS. Every
	// file must re-parse on that edit, and this is what makes it happen.
	function recordAlias(alias RangedTypeAlias)
		// The collision outcome is DISCARDED here on purpose: E3061 and E3105 are each raised once, at
		// the merge (`commitTypeAliases`), which is the whole-program drain that owns
		// `project.diagnostics`. Reporting from the pre-parse sweep as well would double every
		// diagnostic — the sweep and the merge both see every declaration. The sweep still calls
		// `record` rather than a plain upsert so that THIS registry and the project's are built by one
		// function: a sweep that filed declarations differently would resolve a contested name
		// differently from the merge, which is the divergence file scoping exists to remove.
		_ = self.typeAliases.record(alias)

		// The bounds are SIGNED (`ParsedInt`) and the hash domain is UNSIGNED, so each crosses by an
		// explicit cast. Bound to locals rather than written inline: as arguments to a nested `mix`
		// the bootstrap misreads them as already-hashed and rejects the casts as unneeded (E3010) —
		// a false positive, and one that costs nothing to route around.
		let low = alias.low as ContentHash
		let high = alias.high as ContentHash

		// ⭐ **VISIBILITY RIDES FOR THE RANGE'S OWN REASON, now that P1.9 made it load-bearing** (review):
		// widening a range changes what a `shr` on a value of the alias means, and adding or removing
		// `export` changes what ANOTHER file's `as` cast to the name means (E2003, `visibleFrom`) and
		// whether this file's own declaration can be reported unused (E3062, `recordTypeName`). Both are
		// decisions a memoized parse of a DIFFERENT file bakes in, so both must move its memo key.
		//
		// ONE BIT, not the three-valued enum: every reader asks only `!= Visibility.file`, and `global` is
		// a property of which directory the file was loaded from rather than of anything its text says —
		// so a hash that distinguished `module` from `global` would be keying on a fact no edit can change.
		let exported = (1 as ContentHash) if alias.visibility != Visibility.file else (0 as ContentHash)

		let named = mixBytes(mix(self.hash, value: DeclShapeAlias), bytes: alias.name)
		self.hash = mix(mix(mix(named, value: low), value: high), value: exported)
	end 'recordAlias'

	// Add one INNER ranged typealias (P1.6-C) under its BASE-QUALIFIED name AND fold it into the hash —
	// `recordAlias`'s twin. The RANGE rides for `recordAlias`'s reason (widening changes what a `shr` on a
	// value of the alias means), and the qualified name rides so that a rename or a new inner alias moves
	// every reader's parse memo — `Instance.Idx` resolves and type-checks against this in any file. The
	// stored `RangedTypeAlias.name` stays the BARE member (`Idx`); the key is `base.member`.
	function recordInnerAlias(baseName ByteArray, alias RangedTypeAlias)
		let qualified = joinQualifiedName(baseName, member: alias.name)
		self.innerAliases.upsert(qualified, value: alias)

		// Bound to locals for `recordAlias`'s reason (the bootstrap's E3010 false positive on an inline cast).
		let low = alias.low as ContentHash
		let high = alias.high as ContentHash

		let named = mixBytes(mix(self.hash, value: DeclShapeInnerAlias), bytes: qualified)
		self.hash = mix(mix(named, value: low), value: high)
	end 'recordInnerAlias'

	// Add one FUNCTION typealias to the index AND fold it into the hash — the one write, for
	// `recordAlias`'s reason. The RETURN type rides the hash (its tag, then its name): a caller that
	// binds a function value of this alias and calls it recovers the result type FROM this return type,
	// so a change to it changes what that caller compiles to and its parse memo must move with it.
	function recordFunctionTypeAlias(alias FunctionTypeAlias)
		self.functionTypeAliases.upsert(alias.name, value: alias)
		let named = mixBytes(mix(self.hash, value: DeclShapeFunctionAlias), bytes: alias.name)
		self.hash = mixBytes(mix(named, value: alias.returnTag.rawValue as ContentHash), bytes: alias.returnTypeName)
	end 'recordFunctionTypeAlias'

	// Add one top-level DECLARATION (a `let` or a `var`) to the arena. No value yet:
	// `evaluateInitializers` supplies that once every file has been folded in.
	//
	// FIRST-WINS on a duplicate storage key, matching the bootstrap's `decls.FirstOrDefault(d =>
	// d.Name == name)` (2-Parser.cs:4950). A file that declares the same name twice — `let A = 1` then
	// `let A = 2`, or a `let`/`var` collision — keeps the FIRST here and is diagnosed E3006 by the real
	// parse (`isRedeclaredBinding` → `Parser.raiseBindingFailure`), the top-level twin of the positioned
	// duplicate-FUNCTION check `commitFuncSignatures` makes. It is NOT the cross-file same-name case,
	// which is legal and which `topLevelStorageKey` handles by giving the two decls different keys.
	function recordDecl(decl TopLevelDecl)
		if self.declIndex.contains(decl.storageKey) 'duplicate'
			return
		end 'duplicate'

		self.declIndex.upsert(decl.storageKey, value: self.decls.count())
		self.decls.push(decl)
	end 'recordDecl'

	// ⭐ EVALUATE EVERY TOP-LEVEL CONSTANT IN THE PROGRAM, and fold each answer into the index's hash.
	// Called once, by `queryProgramSignatures`, AFTER every file's declarations have been folded in.
	//
	// **THAT ORDERING IS THE FEATURE.** A forward reference — `let TOTAL = FIRST + SECOND` written
	// above `let FIRST = 30` — resolves precisely because nothing is evaluated until every declaration
	// is KNOWN. A single forward pass cannot do it, and neither reference compiler tries: v1 defers
	// the whole job to TypeResolution, and the bootstrap pre-scans the entire token stream before it
	// parses a line (`CollectAndEvaluateTopLevelDecls`, 2-Parser.cs:1680-1784).
	//
	// Driving over the ARENA in declaration order is what makes the cycle message deterministic — see
	// the `decls` field.
	export function evaluateInitializers()
		for i in 0 upto self.decls.count() 'eachDecl'
			let decl = self.declAt(i)
			match decl.outcome 'state'
				// Already settled by an earlier decl's DFS — it referenced this one. A managed constant is
				// settled too; it is simply not reachable BY a reference (see `evaluateDecl`).
				value to poisoned then break 'state'
				managedValue to arrayValue then break 'state'
				evaluating then panic("ProgramSignatures.evaluateInitializers: '{String.from(decl.name)}' is still marked `evaluating` between two top-level walks — every DFS pops what it pushes")
				pending then self.startDecl(i)
			end 'state'
		end 'eachDecl'

		self.assignDataLabels()

		// The hash covers the ANSWERS, folded in arena order once they all exist. It cannot be done
		// inside the loop above: a decl's outcome is not final until every DFS that could reach it has
		// run (a cycle rewrites its members' outcomes from the inside).
		for j in 0 upto self.decls.count() 'eachOutcome'
			let decl = self.declAt(j)
			self.hash = self.mixConstant(self.hash, decl: decl)
		end 'eachOutcome'
	end 'evaluateInitializers'

	// ⭐ **GIVE EVERY TOP-LEVEL `var` ITS `.data` LABEL — the second half of the key/label split**
	// (see `topLevelStorageKey`). The KEY answers "which declaration is this?" and is scoped by file;
	// the LABEL answers "which slot does the IR name?" and must not be, because a label carrying a
	// path would land in every golden fragment and in the emitted binary.
	//
	// **BARE NAME, SUFFIXED ONLY ON COLLISION.** Two file-private `counter`s have DIFFERENT keys and
	// would want the SAME label; the second one to be reached takes `__data_counter$1`. So:
	//   • the ordinary program — every global uniquely named — gets stable, readable, path-free
	//     labels, and its goldens never mention a temp directory;
	//   • the pathological one is CORRECT rather than aliased, which is exactly what the bootstrap
	//     is not (`global-file-private-same-name.md`: it returns 212, aliasing `bumpA` onto featB's
	//     slot, where 118 is correct).
	//
	// Walked in ARENA ORDER, which is source-path order then in-file order — so which of two colliding
	// decls gets the bare name is a deterministic function of the program, not of a hash iteration.
	// That is the same property `decls` is an array for.
	//
	// ⚠ **IT RUNS AFTER THE EVALUATION LOOP, AND THAT ORDER IS NOW LOAD-BEARING** (P1.7 slice 2b): which
	// decls have a slot is `TopLevelDecl.hasStorage`, and `settleArrayValue` is what sets it for an immutable
	// ARRAY binding. Hoisted above the loop it would label the `var`s and silently skip every array `let`.
	//
	// ⚠ **A LABEL IS MINTED FOR EVERY STORED DECL, LIVE OR NOT, AND THAT ORDER IS LOAD-BEARING TOO**
	// (P1.7 slice 3). Dead-global elimination reads liveness off the `globalAddr` ops the parser emitted,
	// which CARRY these labels — so labelling has to precede it, and a dead global keeps its claim on the
	// bare name it took here. That is the correct outcome rather than a leftover: renumbering the `$1`
	// disambiguator once a neighbour is dropped would rename a SURVIVING global whose ops already spell
	// the old label.
	//
	// It also counts them, into `storedGlobalCount` — this walk visits exactly the decls that have a slot,
	// so the count is a by-product of the labelling rather than a second arena pass to keep in step.
	function assignDataLabels()
		var minted = DataLabelCountMap.create()
		var stored = 0 as StoredGlobalCount
		for i in 0 upto self.decls.count() 'each'
			var decl = self.declAt(i)
			if not decl.hasStorage 'inlinedHasNoSlot'
				continue
			end 'inlinedHasNoSlot'
			decl.dataLabel = uniqueDataLabel(decl.name, minted: minted)
			stored = stored + 1
		end 'each'
		self.storedGlobalCount = stored
	end 'assignDataLabels'

	// Open a fresh DFS at arena index `index`. The stack is per-ROOT rather than shared across the
	// whole loop, which costs one empty array per unevaluated root and buys the invariant the panic
	// above checks: a walk that ends leaves nothing marked `evaluating`.
	function startDecl(index TopLevelDeclIndex)
		var stack = TopLevelDeclIndexArray.create()
		_ = self.evaluateDecl(index, stack: stack)
	end 'startDecl'

	// Evaluate the constant at arena index `index` — MEMOIZED, and with CYCLE DETECTION.
	//
	// The answer is recorded ON THE DECL and only summarized in the return: a failure's diagnostic
	// belongs to the declaration that caused it, and is raised (once) by the real parse when it
	// reaches that line. Callers get `failed` — an instruction to stop, not an error to report.
	//
	// ⭐ **A MANAGED CONSTANT ANSWERS `notFound` HERE, AND THAT IS THE SLICE'S HARD BOUNDARY** (P1.7a).
	// The only caller that reads this answer for a NAME is `evaluateNamed`, i.e. a reference from inside
	// another initializer — and a managed constant is not a number, so there is nothing an arithmetic
	// fold could do with it. `notFound` makes `let A = "x"` / `let B = A` report **E2004 `Undefined
	// constant 'A'`**, which is MEASURED to be exactly what the runnable oracle does, in BOTH declaration
	// orders (its bare literal goes to the managed bucket while its bare identifier goes to the scalar
	// folder, and the scalar folder never sees managed declarations). So there is no managed-to-managed
	// dependency to order and no managed cycle to detect: the arena's DFS never reaches one.
	function evaluateDecl(index TopLevelDeclIndex, stack TopLevelDeclIndexArray) returns ConstEvalOutcome
		var decl = self.declAt(index)

		match decl.outcome 'state'
			value(payload, tag) then return ConstEvalOutcome.value(payload, tag: tag)
			failed to poisoned then return ConstEvalOutcome.failed
			// An ARRAY binding answers `notFound` for a managed literal's reason (P1.7 slice 2b): the only
			// caller reading this for a NAME is a reference from inside another initializer, and there is
			// nothing an arithmetic fold could do with a heap record. MEASURED against the runnable oracle —
			// `let A = [1, 2]` / `let B = A` is E2004 `Undefined constant 'A'` in BOTH declaration orders.
			managedValue to arrayValue then return ConstEvalOutcome.notFound
			// Reached a decl already on this walk's stack: the reference chain has closed on itself.
			evaluating then return self.recordCycle(index, stack: stack)
			pending then break 'state'
		end 'state'

		decl.outcome = TopLevelConstant.evaluating
		stack.push(index)
		let outcome = self.walkConstInitializer(decl, stack: stack)
		_ = try stack.pop() otherwise panic("ProgramSignatures.evaluateDecl: stack.pop failed for '{String.from(decl.name)}' — every push is matched here")

		return outcome
	end 'evaluateDecl'

	// Walk one initializer's tokens and settle its decl's outcome.
	//
	// A transient `Parser` is what walks them, and that is the point: the evaluator needs a token
	// cursor, integer-literal decoding, `u16.max` bound resolution, character-literal decoding, and
	// the operator precedence table — every one of which a `Parser` already has and single-sources.
	// Re-spelling any of them here would be a second reading of the grammar, which is the duplication
	// this compiler pays for hardest (see TypeRules' header). The parser it builds emits NO ops: a
	// constant's initializer produces a NUMBER, not code.
	//
	// It is created per DECL, not per file, and per decl is per-constant-in-the-program — this runs
	// once per declaration, never per reference (the memo above sees to that). Programs with no
	// top-level constant build no parser here at all.
	function walkConstInitializer(decl TopLevelDecl, stack TopLevelDeclIndexArray) returns ConstEvalOutcome
		// `isStdlibSource: false` is exact rather than a default: this walk reads an INITIALIZER, and the
		// only thing the flag governs is a `typealias` DECLARATION, which an initializer cannot contain.
		// `declaresCompilerInternalNames: false` is exact for the same reason and its own: an initializer
		// declares no NAME at all, so the reserved-prefix rule this walk would exempt has no site to fire
		// at — and the decl whose initializer this is has already been through the real parse's check.
		// `livesUnderStdlibDirectory: false` is exact for the third variant of that reason: it gates the
		// two `module`-visible `String` METHODS, and a constant initializer is const-EVALUATED — it reaches
		// no method dispatch at all, so the gate has no site to fire at either. This walk never asks the
		// project for a path, and giving it a reason to would put a `Directory.currentPath()` probe on the
		// per-declaration path to answer a question nothing here can pose.
		var parser = Parser.create(decl.tokens, filePath: decl.declFilePath, namespace: "", signatures: self, isStdlibSource: false, declaresCompilerInternalNames: false, livesUnderStdlibDirectory: false)
		let folded = try parser.evalConstInitializer(decl, stack: stack) otherwise (err) 'noValue'
			return self.recordFailure(decl, error: err)
		end 'noValue'

		match folded 'kind'
			scalar(value) then return self.settleScalarValue(decl, value: value)
			managed(bytes, managedKind) then return self.settleManagedValue(decl, bytes: bytes, kind: managedKind)
			arrayLiteral(elements, element) then return self.settleArrayValue(decl, elements: elements, element: element)
		end 'kind'
	end 'walkConstInitializer'

	// Settle a decl whose initializer folded to a NUMBER — the arm this arena has always had.
	function settleScalarValue(decl TopLevelDecl, value ConstValue) returns ConstEvalOutcome
		decl.outcome = TopLevelConstant.value(value.payload, tag: value.tag)
		return ConstEvalOutcome.value(value.payload, tag: value.tag)
	end 'settleScalarValue'

	// Settle a decl whose initializer folded to a MANAGED literal (P1.7a). It answers `notFound` for
	// `evaluateDecl`'s reason — a managed constant is invisible to the scalar folder — while the decl
	// itself carries the bytes every USE site re-materializes (`resolvedValueOf`).
	function settleManagedValue(decl TopLevelDecl, bytes ByteArray, kind ManagedConstKind) returns ConstEvalOutcome
		decl.outcome = TopLevelConstant.managedValue(bytes, kind: kind)
		self.managedTopLevelNames.insert(decl.name)
		return ConstEvalOutcome.notFound
	end 'settleManagedValue'

	// Settle a decl whose initializer folded to an ARRAY LITERAL (P1.7 slice 2b). It joins
	// `managedTopLevelNames` for `settleManagedValue`'s reason — the name is a METHOD RECEIVER
	// (`counters.get(0)`), and that set is the allocation-free filter in front of every receiver probe — and
	// answers `notFound` for the same reason a managed literal does.
	function settleArrayValue(decl TopLevelDecl, elements ConstArrayElementArray, element ConstArrayElementKind) returns ConstEvalOutcome
		decl.outcome = TopLevelConstant.arrayValue(elements, element: element)
		// An array binding is STORED whichever keyword declared it — written HERE, beside the outcome it is
		// derived from, so the two are one decision (see `TopLevelDecl.hasStorage`).
		decl.hasStorage = true
		self.managedTopLevelNames.insert(decl.name)
		return ConstEvalOutcome.notFound
	end 'settleArrayValue'

	// Settle a decl that produced no value: it either OWNS the defect or merely inherited one.
	function recordFailure(decl TopLevelDecl, error ConstEvalError) returns ConstEvalOutcome
		match error 'kind'
			defective(parseError) then decl.outcome = TopLevelConstant.failed(parseError)
			dependencyFailed then self.poisonIfUndecided(decl)
		end 'kind'

		return ConstEvalOutcome.failed
	end 'recordFailure'

	// Mark a decl as a casualty of someone else's defect — UNLESS a verdict was already handed to it.
	// `recordCycle` settles every member of a cycle from the inside, and those decls then unwind
	// through here carrying `dependencyFailed`; overwriting would blank the one diagnostic the cycle
	// produced.
	function poisonIfUndecided(decl TopLevelDecl)
		match decl.outcome 'state'
			// `recordCycle` already ruled on this decl.
			failed to poisoned then break 'state'
			evaluating then decl.outcome = TopLevelConstant.poisoned
			value then panic("ProgramSignatures.poisonIfUndecided: '{String.from(decl.name)}' holds a scalar value AND failed to evaluate — an initializer produces one or the other")
			managedValue to arrayValue then panic("ProgramSignatures.poisonIfUndecided: '{String.from(decl.name)}' holds a managed value AND failed to evaluate — an initializer produces one or the other")
			pending then panic("ProgramSignatures.poisonIfUndecided: '{String.from(decl.name)}' is `pending` while unwinding its own evaluation — `evaluateDecl` marks it `evaluating` before the walk")
		end 'state'
	end 'poisonIfUndecided'

	// **THE CYCLE.** `index` is already on `stack`, so the arc from its first appearance to the top is
	// a closed reference chain in which no member can ever be evaluated. Settle all of them here,
	// from the inside, and give exactly ONE the diagnostic.
	//
	// WHICH ONE: the LAST-DECLARED member. `stack` holds arena indices and the arena is in declaration
	// order, so that is simply the largest index in the arc — no source positions to compare. The
	// bootstrap picks the same declaration (`decls.Last(d => evaluating.Contains(d.Name))`,
	// 2-Parser.cs:4954) and anchors on its NAME token, which is what `specs/top-level-let.md`'s
	// `circular-dependency-error` gates byte-for-byte (`3:5` — the `B` of `let B = A + 1`). Every
	// other member is POISONED, so the program reports one E2012 and not one per member.
	//
	// ⚠ DIVERGENCE FROM THE BOOTSTRAP, and it is deliberate. It names the whole in-progress set
	// (`string.Join(", ", evaluating)`), which for `X -> A -> B -> A` prints "X, A, B" — but `X` is
	// not circular, it merely LEADS to a cycle, and a message that says it is is simply wrong. shv2
	// names the ARC (`A, B`). The two agree on every cycle whose root is a member — which is every
	// cycle the corpus has, including the spec's — and disagree only where the bootstrap is
	// misreporting.
	function recordCycle(index TopLevelDeclIndex, stack TopLevelDeclIndexArray) returns ConstEvalOutcome
		let arcStart = self.stackPositionOf(index, stack: stack)

		var names = ""
		var owner = index
		for i in arcStart upto stack.count() 'eachMember'
			let member = try stack.get(i) otherwise panic("ProgramSignatures.recordCycle: stack.get OOB at {i}")
			if i > arcStart 'separator'
				names = "{names}, "
			end 'separator'
			let memberDecl = self.declAt(member)
			names = "{names}{String.from(memberDecl.name)}"
			if member > owner 'laterDeclaration'
				owner = member
			end 'laterDeclaration'
		end 'eachMember'

		var ownerDecl = self.declAt(owner)
		ownerDecl.outcome = TopLevelConstant.failed(ParseError.circularConstants(names, line: ownerDecl.nameLine, column: ownerDecl.nameColumn))

		for j in arcStart upto stack.count() 'eachVictim'
			let member = try stack.get(j) otherwise panic("ProgramSignatures.recordCycle: stack.get OOB at {j}")
			if member == owner 'ownsTheDiagnostic'
				continue
			end 'ownsTheDiagnostic'
			var victim = self.declAt(member)
			victim.outcome = TopLevelConstant.poisoned
		end 'eachVictim'

		return ConstEvalOutcome.failed
	end 'recordCycle'

	// Where `index` sits on the DFS stack. Its presence is a precondition — `recordCycle` is reached
	// only from the `evaluating` arm, which means this decl is on the current walk — so a miss is an
	// invariant break and not a case to handle.
	function stackPositionOf(index TopLevelDeclIndex, stack TopLevelDeclIndexArray) returns TopLevelDeclIndex
		for i in 0 upto stack.count() 'each'
			let member = try stack.get(i) otherwise panic("ProgramSignatures.stackPositionOf: stack.get OOB at {i}")
			if member == index 'found'
				return i
			end 'found'
		end 'each'

		let target = self.declAt(index)
		panic("ProgramSignatures.stackPositionOf: '{String.from(target.name)}' is marked `evaluating` but is not on the DFS stack — the mark and the stack fell out of lockstep")
	end 'stackPositionOf'

	// Resolve `name` from `readerFilePath` and evaluate what it denotes — the door `Parser`'s
	// constant evaluator asks a NAME REFERENCE through, and the recursion that makes a forward
	// reference (and a cross-file one) work.
	//
	// ⚠ **A `var` IS INVISIBLE HERE, AND THE SPEC PINS IT.** `var b = a + 1` where `a` is itself a
	// top-level `var` is `E2004: Undefined constant 'a'` in the reference compiler — MEASURED, not
	// inferred. And it must be: a constant initializer is folded at COMPILE TIME into bytes in the
	// `.data` image, while a var's value is whatever the program last STORED there. Reading one from
	// the other would bake a snapshot of a mutable location into the image and call it a constant.
	// So `mutableIsInvisible` filters the lookup, and the reader gets the same `notFound` it would
	// get for a name nobody declared — which is exactly the diagnostic the reference produces.
	export function evaluateNamed(name ByteArray, readerFilePath FilePath, stack TopLevelDeclIndexArray) returns ConstEvalOutcome
		match self.constantDeclFor(name, readerFilePath: readerFilePath) 'lookup'
			found(index) then return self.evaluateDecl(index, stack: stack)
			notFound then return ConstEvalOutcome.notFound
		end 'lookup'
	end 'evaluateNamed'

	// The value `name` denotes when read from `readerFilePath` — the door a USE SITE asks through
	// (`Parser.topLevelConstantReference`), after every constant has been evaluated.
	//
	// A constant that FAILED reads as `notFound`, so its reader reports a plain undefined-name error
	// rather than inlining a value that does not exist. v1 does exactly this, and says why: it drops
	// the cycle's victims from its registry "so readers get a plain 'Undefined name'"
	// (TypeResolution.maxon:8332-8338). The declaration's own diagnostic has already failed the build,
	// so nothing is lost by the reader being vague about it.
	//
	// A `var` reads as `notFound` here too — not because it is undefined, but because it is not a
	// CONSTANT and this door only answers for constants. Its reader (`Parser.parseVariableReference`)
	// asks `globalDeclFor` next, and emits a LOAD.
	export function constantValueOf(name ByteArray, readerFilePath FilePath) returns TopLevelConstantLookup
		match self.constantDeclFor(name, readerFilePath: readerFilePath) 'lookup'
			found(index) then return self.resolvedValueOf(index)
			notFound then return TopLevelConstantLookup.notFound
		end 'lookup'
	end 'constantValueOf'

	// ⭐ **THE STORED-BINDING DOOR** — what `name` denotes as a top-level global with a `.data` slot, read
	// from `readerFilePath`. The twin of `constantValueOf`, and the reason the two are separate: an inlined
	// binding's use MATERIALIZES its value and a stored one's LOADS from a slot, so a caller that could not
	// tell them apart would have to guess which code to emit. It is every `var` plus an array `let`
	// (P1.7 slice 2b) — see `TopLevelDecl.hasStorage` — and the answer carries which of those it found.
	//
	// It resolves through the IDENTICAL scoped-then-bare probe (`declFor`), which is the whole point
	// of extending the storage key to vars: this is what makes featA's `counter` and featB's
	// `counter` two slots instead of one.
	export function globalDeclFor(name ByteArray, readerFilePath FilePath) returns TopLevelGlobalLookup
		match self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.stored) 'lookup'
			found(index) then return self.resolvedGlobalOf(index)
			notFound then return TopLevelGlobalLookup.notFound
		end 'lookup'
	end 'globalDeclFor'

	// The `.data` label and TYPE of the global at `index` — everything a load or a store needs to
	// name it. A var whose initializer failed reads as `notFound` for `resolvedValueOf`'s reason: the
	// declaration's own diagnostic has already failed the build, and a slot with no value is a slot
	// with no bytes to emit.
	function resolvedGlobalOf(index TopLevelDeclIndex) returns TopLevelGlobalLookup
		let decl = self.declAt(index)
		match decl.outcome 'state'
			value(_, tag) then return TopLevelGlobalLookup.found(self.dataLabelOf(decl), valueType: constantValueType(tag), mutable: decl.mutable)
			failed to poisoned then return TopLevelGlobalLookup.notFound
			// ⭐ A MANAGED `var` (P1.7 slice 2a) reads exactly as a scalar one does — the slot is real, it
			// is just a POINTER rather than a value. Its type is the literal's own, so a read of the name
			// and a use of the literal it was initialized from are the same type by construction.
			managedValue(_, kind) then return TopLevelGlobalLookup.found(self.dataLabelOf(decl), valueType: self.managedConstValueType(kind), mutable: decl.mutable)
			// ⭐ AN ARRAY BINDING (P1.7 slice 2b) reads as a managed `var` does — a POINTER slot holding the
			// heap record `__module_init` built. It is the one arm `mutable` can arrive `false` from, and that
			// bit is the whole of what makes `Live.push(1)` an E3019 and `Live = […]` an E2013.
			arrayValue(_, element) then return TopLevelGlobalLookup.found(self.dataLabelOf(decl), valueType: self.constArrayValueType(element), mutable: decl.mutable)
			pending to evaluating then panic("ProgramSignatures.resolvedGlobalOf: '{String.from(decl.name)}' is unevaluated at a use site — `evaluateInitializers` runs to completion before any file is parsed")
		end 'state'
	end 'resolvedGlobalOf'

	// ⭐ **THE `MaxonType` A MANAGED TOP-LEVEL BINDING OF `kind` DENOTES** — the SAME type its literal gives
	// a value in expression position (`Parser.emitStringLiteral` / `emitByteStringLiteralValue`), stated once
	// so a `let`'s inlined literal, a `var`'s slot, the module-init store and the cleanup's drop cannot
	// disagree about what the binding IS.
	//
	// A METHOD rather than a free function because a byte string's type is the CONCRETE `Array with Byte`
	// instance, and an instance is a gid only the interner can mint — the very `internArrayByteInstance` the
	// literal path uses, so `b"…"` has ONE type however it is reached.
	export function managedConstValueType(kind ManagedConstKind) returns MaxonType
		return match kind 'k'
			string gives MaxonType.string
			byteArray gives MaxonType.genericInstance(self.internArrayByteInstance())
		end 'k'
	end 'managedConstValueType'

	// ⭐ **THE `Array with T` INSTANCE A TOP-LEVEL ARRAY LITERAL DENOTES** (P1.7 slice 2b) — the
	// `managedConstValueType` twin, and a METHOD for its reason: an instance is a gid only the interner can
	// mint, and these are the VERY instances a `[…]` literal in a function body resolves to
	// (`Parser.arrayLiteralInstanceFor`), so a global's slot and a body's literal of the same elements are
	// the same type by construction.
	//
	// Both are a pure LOOKUP here: the declaration sweep interns them whenever a file's tokens contain a `[`
	// (plus a following string literal for the String one), which every array initializer does by definition
	// — the same sweep-writes/parser-reads discipline `internBuiltinIntegerInstance` states.
	export function constArrayValueType(element ConstArrayElementKind) returns MaxonType
		return match element 'e'
			integer gives MaxonType.genericInstance(self.internBuiltinIntegerInstance(ArrayBuiltinBaseName))
			string gives MaxonType.genericInstance(self.arrayInstanceForString())
		end 'e'
	end 'constArrayValueType'

	// The `.data` label of a STORED decl. Having storage is a precondition, not a case: an inlined binding
	// has no slot, and every caller reached this through a `stored`-filtered lookup or the same
	// `hasStorage` filter the arena walks use.
	//
	// ⚠ **IT TAKES THE DECL, NOT ITS ARENA INDEX** (P1.7 slice 3 review). Every caller already holds the
	// decl — each one fetched it to read `outcome` or `name` — so an index parameter would be a SECOND way
	// to say which declaration is meant, with nothing forcing the two to agree: a caller that paired
	// `declAt(j)` with index `i` would be answered about `i`'s label under `j`'s storage bit, which is a
	// wrong answer rather than a compile error. One parameter cannot desynchronize from itself, and it
	// drops the re-fetch this made every caller pay.
	function dataLabelOf(decl TopLevelDecl) returns ByteArray
		if not decl.hasStorage 'inlined'
			panic("ProgramSignatures.dataLabelOf: '{String.from(decl.name)}' is an inlined top-level constant and has no .data slot — a constant materializes its value at every read")
		end 'inlined'
		if decl.dataLabel.count() == 0 'unlabelled'
			panic("ProgramSignatures.dataLabelOf: top-level '{String.from(decl.name)}' has no .data label — `assignDataLabels` labels every STORED decl in the arena, and it runs inside `evaluateInitializers`")
		end 'unlabelled'
		return decl.dataLabel
	end 'dataLabelOf'

	// ⭐⭐ **DOES THIS DECLARATION STILL CONTRIBUTE STORAGE?** — the ONE filter both arena walks below
	// apply, and the whole of what makes a dead global's THREE PIECES drop TOGETHER (P1.7 slice 3).
	// The `.data` slot `declaredGlobals` reserves, the `__module_init` store `managedGlobals` causes and
	// the `__maxon_global_cleanup` drop it causes are all downstream of this single answer, so they cannot
	// disagree — and every way they COULD disagree is broken: a slot with no initializer holds null where
	// a record must be, an initializer with no slot stores into an address the image never laid down, and
	// a cleanup drop with no slot decrefs one.
	//
	// TWO independent reasons a declaration contributes nothing, in the order that makes the second one
	// askable: an INLINED binding has no slot at all (a `let` scalar materializes its value at every read,
	// and `dataLabelOf` panics rather than inventing a label for one), and a STORED binding whose label no
	// `globalAddr` in the program names is dead.
	function contributesStorage(decl TopLevelDecl, live LiveGlobalLabelSet) returns bool
		if not decl.hasStorage 'inlinedHasNoSlot'
			return false
		end 'inlinedHasNoSlot'

		return live.contains(self.dataLabelOf(decl))
	end 'contributesStorage'

	// EVERY LIVE top-level global in the program, in ARENA (declaration) order, with the label and value
	// its `.data` slot carries — the door the backend's data-section layout asks through.
	//
	// It is asked ONCE per compile (`Compiler.declaredGlobals`), never per file: it is O(globals),
	// and a whole-program query under a per-file one is asked once per FILE, which is how a linear
	// walk becomes quadratic (see the ARCHITECTURE's warning on this exact query).
	//
	// A var whose initializer FAILED contributes no slot: the build has already failed on its
	// diagnostic, and there is no value to lay down.
	export function declaredGlobals(live LiveGlobalLabelSet) returns DataSectionEntryArray
		var entries = DataSectionEntryArray.create()
		for i in 0 upto self.decls.count() 'each'
			let decl = self.declAt(i)
			if not self.contributesStorage(decl, live: live) 'noReachableSlot'
				continue
			end 'noReachableSlot'
			match decl.outcome 'state'
				value(payload, tag) then entries.push(DataSectionEntry.create(String.from(self.dataLabelOf(decl)), valueType: globalStdType(tag, name: decl.name), value: payload))
				failed to poisoned then continue
				// ⭐ A MANAGED `var` (P1.7 slice 2a) reserves a POINTER slot holding NULL. The record it will
				// point at cannot be baked into a constant image — a data→data pointer has no compile-time VA
				// under ASLR (`specs/static-variables.md:729-730`) — so the bytes are zero here and
				// `__module_init` writes the address before `main` runs.
				managedValue(_, kind) then entries.push(DataSectionEntry.create(String.from(self.dataLabelOf(decl)), valueType: globalStdType(maxonTypeTag(self.managedConstValueType(kind)), name: decl.name), value: ManagedGlobalInitialSlot))
				// ⭐ AN ARRAY BINDING (P1.7 slice 2b) reserves the SAME null POINTER slot, for the same reason
				// and now for a `let` too — its record is built, so there is even less to bake than a String's.
				arrayValue(_, element) then entries.push(DataSectionEntry.create(String.from(self.dataLabelOf(decl)), valueType: globalStdType(maxonTypeTag(self.constArrayValueType(element)), name: decl.name), value: ManagedGlobalInitialSlot))
				pending to evaluating then panic("ProgramSignatures.declaredGlobals: '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` runs to completion inside `queryProgramSignatures`")
			end 'state'
		end 'each'
		return entries
	end 'declaredGlobals'

	// ⭐ **EVERY LIVE MANAGED TOP-LEVEL GLOBAL IN THE PROGRAM, in ARENA (declaration) order** — the door
	// `installManagedGlobalInit` asks through, and the ONLY enumeration of them.
	//
	// It is the `declaredGlobals` twin and deliberately a SECOND walk rather than a widened first: that one
	// answers "what does the `.data` image hold?" (a label, a width, some bytes) and this one answers "what
	// must run before and after `main`?" (a label, the literal's bytes, its type). Fusing them would hand
	// the layout a payload it has no use for and the synthesis a `StdType` it cannot build a record from.
	//
	// Asked ONCE per compile (`Compiler.compileToCodeResult`), never per file — it is O(declarations), and a
	// whole-program query under a per-file one is asked once per FILE, which is how a linear walk becomes
	// quadratic (see the ARCHITECTURE's warning on this query).
	//
	// A var whose initializer FAILED contributes nothing: the build has already failed on its diagnostic.
	export function managedGlobals(live LiveGlobalLabelSet) returns ManagedGlobalArray
		var entries = ManagedGlobalArray.create()
		for i in 0 upto self.decls.count() 'each'
			let decl = self.declAt(i)
			if not self.contributesStorage(decl, live: live) 'noReachableSlot'
				continue
			end 'noReachableSlot'
			match decl.outcome 'state'
				value to poisoned then continue
				managedValue(bytes, kind) then entries.push(self.managedGlobalEntry(decl, initializer: managedLiteralInitializer(bytes, kind: kind), valueType: self.managedConstValueType(kind)))
				// ⭐ AN ARRAY BINDING (P1.7 slice 2b) is a managed global whichever keyword declared it — its
				// record is built before `main` and released after, and `let` refuses only the WRITE.
				arrayValue(elements, element) then entries.push(self.managedGlobalEntry(decl, initializer: self.arrayRecordInitializer(elements, element: element), valueType: self.constArrayValueType(element)))
				pending to evaluating then panic("ProgramSignatures.managedGlobals: '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` runs to completion inside `queryProgramSignatures`")
			end 'state'
		end 'each'
		return entries
	end 'managedGlobals'

	// One managed global's full description. Split out so each `match` arm above stays one line, and it takes
	// the TYPE its arm already built rather than re-deriving one: the drop callee is routed off that same
	// type, so the record the init builds and the drop the cleanup emits cannot name two different types.
	function managedGlobalEntry(decl TopLevelDecl, initializer ManagedGlobalInitializer, valueType MaxonType) returns ManagedGlobal
		return ManagedGlobal.create(self.dataLabelOf(decl), initializer: initializer, valueType: valueType, dropCallee: managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: valueType), range: declInitializerRange(decl))
	end 'managedGlobalEntry'

	// The record construction an ARRAY literal global asks for: `__arr_create` with the stamps this instance
	// fixes, then one push per element. Both stamps come from the SAME instance the global is typed by
	// (`constArrayValueType`), so the strides the record is born with and the type every use loads through
	// are one answer rather than two.
	function arrayRecordInitializer(elements ConstArrayElementArray, element ConstArrayElementKind) returns ManagedGlobalInitializer
		let giid = typeNameIdOf(self.constArrayValueType(element))
		return ManagedGlobalInitializer.arrayRecord(elements, elementSize: self.arrayElementSize(giid), elementDestroy: self.arrayElementDestroy(giid))
	end 'arrayRecordInitializer'

	// The recorded arena entry a top-level `decl` resolves to, keyed on the decl's OWN storage key
	// rather than on a bare name (a declaration resolves to ITSELF, never through the scoped-then-bare
	// probe a USE goes through). The single get-or-panic that `declaredOutcome` and `isRedeclaredBinding`
	// share, so the drift guard below reads exactly one way at both.
	//
	// **THE DRIFT GUARD LIVES HERE.** The sweep decides what is top level by counting block depth over
	// tokens (`Parser.foldDeclaredSignaturesInto`); the real parse decides it by actually parsing.
	// Those are two readings of one question, and a miss means they disagreed — after which the
	// declaration is absent from the index, every use of it reports "undefined variable", and a correct
	// program is rejected for a reason that names nothing the user wrote. It panics instead, naming
	// the drift, in the discipline `mergeArtifact`'s span-lockstep assert follows.
	function recordedDeclFor(decl TopLevelDecl) returns TopLevelDecl
		let index = try self.declIndex.get(decl.storageKey) otherwise panic("ProgramSignatures.recordedDeclFor: the declaration sweep never recorded top-level '{String.from(decl.name)}' of {decl.declFilePath.toString()}, which the parser is dispatching at top level — the sweep's block-depth gate and the parser's structure disagree about what is top level")
		return self.declAt(index)
	end 'recordedDeclFor'

	// What the DECLARATION the real parse just read came to — the door `Parser.raiseBindingFailure`
	// asks through.
	export function declaredOutcome(decl TopLevelDecl) returns TopLevelConstant
		return self.recordedDeclFor(decl).outcome
	end 'declaredOutcome'

	// ⭐ **IS `decl` A REDECLARATION — a top-level name the sweep already recorded under the same storage
	// key from a DIFFERENT source position?** `recordDecl` is first-wins, so the winner is the earliest
	// declaration and every later `let`/`var` of that name is a duplicate. The real parse asks this for
	// each top-level binding statement (`raiseBindingFailure`) and reports E3006 at the later one — the
	// top-level twin of the duplicate-FUNCTION check `commitFuncSignatures` makes, positioned the same
	// way (at the offending later declaration).
	//
	// ⚠ SCOPED TO ONE FILE, and — for an EXPORTED name — BOUNDED BY THE GLOBAL WINNER. Same storage key
	// means same name; for a FILE-PRIVATE name the key includes the path, so the winner is THIS file's
	// first declaration and same-file detection is complete. For an EXPORTED name the key is the bare
	// name (`topLevelStorageKey`), so the winner is the globally-first `export let A` across ALL files:
	// when it lives in another file the `crossFileExported` guard returns false — correctly for the pure
	// cross-file collision (which belongs to cross-file name resolution, see `commitStructTypes`), but it
	// ALSO misses a genuine SAME-FILE exported duplicate whenever another file's export wins the key
	// (order-dependent on file sort). That completeness rides with the same deferred cross-file rung; it
	// never falsely rejects a legal program and adds no wrong runtime answer. Re-deriving each side's
	// file-qualified key makes the guard a pure FILE comparison (equal names). Two distinct declarations
	// in one file cannot share a source position, so a differing `(line, column)` is exactly a
	// redeclaration.
	export function isRedeclaredBinding(decl TopLevelDecl) returns bool
		let winner = self.recordedDeclFor(decl)

		let winnerFileKey = fileScopedDeclKey(winner.name, declFilePath: winner.declFilePath)
		let declFileKey = fileScopedDeclKey(decl.name, declFilePath: decl.declFilePath)
		if not winnerFileKey.equals(declFileKey) 'crossFileExported'
			return false
		end 'crossFileExported'

		return winner.nameLine != decl.nameLine or winner.nameColumn != decl.nameColumn
	end 'isRedeclaredBinding'

	function resolvedValueOf(index TopLevelDeclIndex) returns TopLevelConstantLookup
		let decl = self.declAt(index)
		match decl.outcome 'state'
			value(payload, tag) then return TopLevelConstantLookup.found(payload, tag: tag)
			managedValue(bytes, kind) then return TopLevelConstantLookup.foundManaged(bytes, kind: kind)
			failed to poisoned then return TopLevelConstantLookup.notFound
			// ⭐ **AN ARRAY BINDING IS NOT A CONSTANT A USE CAN INLINE** (P1.7 slice 2b): its value is a heap
			// record with a `.data` slot, so a read is a LOAD and the caller's NEXT probe (`globalDeclFor`)
			// is the one that answers. That makes `notFound` the right answer here rather than merely a
			// defensive one — it is the same "no CONSTANT of that name is visible" a `var` has always given.
			arrayValue then return TopLevelConstantLookup.notFound
			pending to evaluating then panic("ProgramSignatures.resolvedValueOf: '{String.from(decl.name)}' is unevaluated at a use site — `evaluateInitializers` runs to completion before any file is parsed")
		end 'state'
	end 'resolvedValueOf'

	// **THE RESOLUTION RULE for a bare name that might be a top-level declaration** — and the reason
	// two files may each declare `let SHARED`, or `var counter`, with a different value.
	//
	// SCOPED FIRST, BARE SECOND. A file-private declaration is filed under a key carrying its declaring
	// file's path, so this file's own `SHARED` is found before anyone's exported one of that name.
	// Ported from v1's `lookupTopLevelConst` (TypeResolution.maxon:2857-2868), which orders the two
	// probes identically and for the identical reason.
	//
	// ⭐ **ONE PROBE FOR BOTH KINDS, FILTERED BY `wanted`.** The scoped-then-bare order is the
	// resolution RULE, and it is the same rule for a `let` and a `var` — so it is written once. What
	// differs is only which kind the caller can use, and a caller asking for the wrong kind gets
	// `notFound`, which is the truth: no CONSTANT of that name is visible here, even though a var is.
	// A second copy of this walk for vars would be free to drift on the probe order, and the failure
	// mode of that drift is silent — featA's `counter` resolving to featB's slot.
	function declFor(name ByteArray, readerFilePath FilePath, wanted DeclKind) returns TopLevelDeclLookup
		if let scoped = try self.declIndex.get(fileScopedDeclKey(name, declFilePath: readerFilePath)) 'filePrivate'
			return self.lookupIfKind(scoped, wanted: wanted)
		end 'filePrivate'

		// The BARE key holds only EXPORTED declarations (`topLevelStorageKey`), so a hit here is
		// visible BY CONSTRUCTION and there is no second visibility test to get wrong. v1 needs one
		// (`isVisibleFrom`) because it files module- and global-visible constants under the bare key
		// and must tell them apart; shv2 has a single exported visibility until namespaces land, and
		// gains that test on the day it gains the distinction.
		if let exported = try self.declIndex.get(name) 'exported'
			return self.lookupIfKind(exported, wanted: wanted)
		end 'exported'

		return TopLevelDeclLookup.notFound
	end 'declFor'

	// `index`, but only if the decl there is the KIND the caller can use.
	//
	// ⚠ IT DOES NOT FALL THROUGH TO THE NEXT PROBE. A file-private `var counter` SHADOWS an exported
	// `let counter` for a constant reader too — the reader gets `notFound`, not the exported constant.
	// That is the same shadowing every scope in the language has (a local `let` shadows a top-level
	// one — see `Parser.parseVariableReference`), and the alternative would be worse than wrong: a
	// constant initializer would silently reach PAST this file's own declaration of the name to
	// somebody else's, and inline a number the author never wrote.
	function lookupIfKind(index TopLevelDeclIndex, wanted DeclKind) returns TopLevelDeclLookup
		let hasStorage = self.declAt(index).hasStorage
		let isWanted = match wanted 'k'
			inlined gives not hasStorage
			stored gives hasStorage
		end 'k'
		return TopLevelDeclLookup.found(index) if isWanted else TopLevelDeclLookup.notFound
	end 'lookupIfKind'

	// `declFor` restricted to the INLINED kind — the probe both constant doors share, named once so the two
	// cannot drift on which kind they meant.
	function constantDeclFor(name ByteArray, readerFilePath FilePath) returns TopLevelDeclLookup
		return self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.inlined)
	end 'constantDeclFor'

	function declAt(index TopLevelDeclIndex) returns TopLevelDecl
		return try self.decls.get(index) otherwise panic("ProgramSignatures.declAt: decls.get OOB at {index} — every index handed out is one this arena minted")
	end 'declAt'

	// Mix one top-level constant's ANSWER into the running hash: the key it is filed under, then its
	// VALUE.
	//
	// ⚠ **THE VALUE, AND NOT MERELY THE NAME.** This is the half a READER's parse memo depends on, and
	// the easy half to leave out. A use INLINES the constant — it becomes a `literal` op carrying the
	// number — so a file that merely reads `MAGIC` compiles differently when `MAGIC` changes, while
	// its OWN bytes, and therefore its own content hash, do not move at all. Without this, editing
	// `export let MAGIC = 42` to `43` would re-parse the declaring file and hand every reader a memo
	// with 42 still baked into it. (`QueryEngine.parseMemoKey` is the other half — see the `hash`
	// field.)
	function mixConstant(state ContentHash, decl TopLevelDecl) returns ContentHash
		let keyed = mixBytes(self.mixMutability(state, mutable: decl.mutable), bytes: decl.storageKey)
		match decl.outcome 'o'
			value(payload, tag) then return self.mixDeclAnswer(keyed, decl: decl, payload: payload, tag: tag)
			// ⭐ **THE BYTES RIDE, for `mixDeclAnswer`'s reason applied to a managed constant.** A use
			// re-materializes the literal from exactly these bytes, so `export let G = "a"` → `"b"` changes
			// what every OTHER file compiles to while their own bytes never move. The KIND rides too: the
			// same bytes as a `String` and as a `b"…"` produce different records and different types.
			managedValue(bytes, kind) then return mixBytes(self.mixManagedKind(mix(keyed, value: ConstShapeManagedValue), kind: kind), bytes: bytes)
			// ⭐ **AN ARRAY BINDING MIXES ITS ELEMENT KIND AND ITS LABEL, AND NOT ITS ELEMENTS** (P1.7 slice
			// 2b) — `mixDeclAnswer`'s `var` branch, for the identical reason and now for a `let` too. An array
			// binding is STORED whichever keyword declared it, so every reader emits `globalAddr <label>` +
			// `loadIndirect` and that is byte-identical whether the literal said `[1, 2]` or `[9, 9, 9]`: the
			// elements reach only `__module_init`, which is rebuilt from this arena whenever this query
			// misses. What a reader DOES depend on is the element KIND — it fixes the `Array with T` instance
			// the load is typed with, and `[1]` becoming `["a"]` retypes every use — and the LABEL, which is
			// the slot the emitted `globalAddr` names. Mixing the elements too would be SOUND and WRONG: the
			// "sound, and useless" key that re-parses the program on every keystroke in any initializer.
			arrayValue(_, element) then return mixBytes(self.mixArrayElementKind(mix(keyed, value: ConstShapeArrayValue), element: element), bytes: decl.dataLabel)
			// A constant with no value bakes no number into a reader, so every failure hashes alike —
			// but it must still hash differently from every VALUE, or `let X = compute()` becoming
			// `let X = 0` would leave a reader's memo valid. The failure's DETAILS are deliberately not
			// mixed: the build fails either way, and no reader's code depends on which diagnostic it
			// failed with.
			failed to poisoned then return mix(keyed, value: ConstShapeNoValue)
			pending to evaluating then panic("ProgramSignatures.mixConstant: '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` folds the hash only after every walk has finished")
		end 'o'
	end 'mixConstant'

	// ⚠ **MUTABILITY RIDES THE HASH, and it is the half a `var` adds.** `let X = 5` and `var X = 5`
	// carry the same key and the same value and compile to COMPLETELY different code in every reader:
	// a constant becomes a `literal` op, a var becomes `globalAddr` + `loadIndirect`. A reader's own
	// bytes do not move when `let` becomes `var`, so — exactly as for the constant's VALUE — only this
	// hash can carry it, and without it every reader would keep a memo that inlines a number the
	// declaration no longer promises. (`ProgramSignatures.hash`'s field comment is the whole argument;
	// this is the second fact it applies to.)
	function mixMutability(state ContentHash, mutable bool) returns ContentHash
		return mix(state, value: DeclShapeMutable if mutable else DeclShapeConstant)
	end 'mixMutability'

	// Mix a managed constant's KIND (P1.7a). Its own discriminator per kind, so `let G = "ab"` and a
	// hypothetical byte-string of the same bytes hash apart — they materialize different records and
	// give the reader a different TYPE, which is exactly the acceptance a stale memo would keep.
	function mixManagedKind(state ContentHash, kind ManagedConstKind) returns ContentHash
		return match kind 'k'
			string gives mix(state, value: ManagedShapeString)
			byteArray gives mix(state, value: ManagedShapeByteArray)
		end 'k'
	end 'mixManagedKind'

	// Mix an array binding's ELEMENT kind (P1.7 slice 2b) — `mixManagedKind`'s twin, and its own
	// discriminator per kind for the same reason: `Array with Integer` and `Array with String` are different
	// types, so every reader's load is typed differently and a memo that did not move would keep the old one.
	function mixArrayElementKind(state ContentHash, element ConstArrayElementKind) returns ContentHash
		return match element 'e'
			integer gives mix(state, value: ArrayElementShapeInteger)
			string gives mix(state, value: ArrayElementShapeString)
		end 'e'
	end 'mixArrayElementKind'

	// ⭐⭐ **MIX WHAT A READER COPIES — AND A `var` DOES NOT COPY ITS VALUE.**
	//
	// This is the one place a `let` and a `var` genuinely diverge, and getting it backwards costs
	// incrementality rather than correctness, which is exactly why it is worth being exact about.
	//
	//   • A `let`'s VALUE is COPIED INTO every reader — a use becomes a `literal` op carrying the
	//     number — so `let X = 7` → `8` changes what other files COMPILE TO while their own bytes
	//     never move. Only this hash can carry that. (`verify-warm-rebuild` property 3(c).)
	//
	//   • A `var`'s value is copied into NOTHING. A reader emits `globalAddr __data_X` +
	//     `loadIndirect` and that is byte-identical whether the initializer said 7 or 8 — the number
	//     reaches only the `.data` IMAGE, which is rebuilt from the arena whenever this query misses.
	//     Verified, not assumed: `globalDeclFor` hands a use site `(label, tag)` and no payload
	//     (`TopLevelGlobalLookup`), and `emitGlobalLoad` deliberately does NOT `recordConst` — a
	//     mutable location's value is not a constant the folder may use.
	//
	// So a var mixes its TAG and its LABEL and stops there:
	//   - the TAG because it decides the load's WIDTH (`i1` moves one byte, `i64` eight), so
	//     `var flag = false` → `var flag = 0` really does change every reader's code;
	//   - the LABEL because it IS the reader's IR identity — the slot the emitted `globalAddr` names.
	//
	// ⚠ Mixing the PAYLOAD too would be SOUND and WRONG: it would re-parse every file in the program
	// whenever any global's initial value moved, which is precisely the "sound, and useless"
	// failure `verify-warm-rebuild`'s property (b) exists to reject — the composite-source-hash key
	// wearing a different hat. `globalValueEditIsLocal` is the probe that keeps this honest.
	function mixDeclAnswer(state ContentHash, decl TopLevelDecl, payload ParsedInt, tag ValueTypeTag) returns ContentHash
		if not decl.mutable 'constantInlinesItsValue'
			return self.mixConstantValue(state, payload: payload, tag: tag)
		end 'constantInlinesItsValue'

		return mixBytes(self.mixValueTag(mix(state, value: ConstShapeValue), tag: tag), bytes: decl.dataLabel)
	end 'mixDeclAnswer'

	// The TAG rides the hash beside the payload: a `boolean` 1 and an `integer` 1 are the same number
	// and different values, and they compile to different code (an i1 versus an i64).
	//
	// Exhaustive over `ValueTypeTag`, and the four unreachable arms panic rather than hashing: the
	// evaluator produces `integer` and `boolean` and nothing else (its literals are ints, chars and
	// bools; `foldIntCompare` yields a bool; `binOpResultTag` yields one of the two given two of the
	// two). Hashing them "just in case" would be inventing a key for a value that cannot exist, and
	// the day one can, this is where it must be decided rather than defaulted.
	function mixConstantValue(state ContentHash, payload ParsedInt, tag ValueTypeTag) returns ContentHash
		return mix(self.mixValueTag(mix(state, value: ConstShapeValue), tag: tag), value: payload as ContentHash)
	end 'mixConstantValue'

	// Mix a FOLDED LITERAL's TAG. Shared by both arms of `mixDeclAnswer`, so a `let` and a `var`
	// cannot come to disagree about what distinguishes a bool from an int — the difference between
	// them is which EXTRA facts ride along (a constant's payload; a var's label), never this one.
	//
	// ⭐ **AND SHARED WITH THE STRUCT FIELD DEFAULT** (`mixDefaultLiteral`), which is the same question
	// about the same three tags: a `boolean` 1 and an `integer` 1 are the same number and different
	// values. A second tag→shape mapping would be one lattice hashed from three directions instead of
	// two, and a tag that hashed differently depending on which door it came through is a cache that
	// answers a stale parse for a changed file — the very failure the `TypeShapeFloat` reuse below was
	// introduced to prevent.
	//
	// Exhaustive over `ValueTypeTag`, and the unreachable arms panic rather than hashing. Both producers
	// bottom out in the same three tags, by different routes: the constant EVALUATOR produces `integer`,
	// `boolean` and `float` and nothing else (its literals are ints, chars, bools and floats;
	// `foldIntCompare` yields a bool; `binOpResultTag` yields one of them given two of them), and a field
	// DEFAULT is a TOKEN-KIND lookup over exactly three literal kinds (`Parser.readFieldDefaultLiteral`;
	// anything else is `rejectNonLiteralFieldDefault`). So each arm's argument below is stated for the
	// evaluator — the producer that can reach furthest — and holds a fortiori for the field default,
	// whose reader admits three token kinds and no expression at all. Hashing the rest "just in case"
	// would be inventing a key for a value that cannot exist, and the day one can, this is where it must
	// be decided rather than defaulted.
	//
	// P1.0d.4 takes the invitation the old `float to named` arm left ("a float needs P1.0d.4"):
	// `let PI = 3.14` and `var ratio = 2.5` are constants now, so a float tag is REACHABLE and gets
	// the one thing a content hash owes it — a distinct key. It reuses `TypeShapeFloat`, the shape
	// `mixType` already gives a float from the `MaxonType` side: the two functions hash one lattice
	// from two directions, and a float that hashed differently depending on which door it came
	// through is a cache that answers a stale parse for a changed file.
	function mixValueTag(state ContentHash, tag ValueTypeTag) returns ContentHash
		match tag 'k'
			integer then return mix(state, value: TypeShapeInteger)
			boolean then return mix(state, value: TypeShapeBoolean)
			float then return mix(state, value: TypeShapeFloat)
			// `named` stays out: a constant's initializer is a bare expression and shv2 infers
			// `int`/`bool`/`float` from it, never an alias — that needs an `as` cast (P1.9).
			named then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a constant's type is inferred from a bare initializer, so it is never a ranged alias (that needs an `as` cast, P1.9)")
			exitCode to void then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — the evaluator folds integers, bools and floats only")
			// A struct is unreachable here for `globalStdType`'s reason and one more: the only way to
			// build one is `T.create(…)`, and a CALL in a top-level initializer is E2045 in every
			// compiler in the tree. It stays out of the hash rather than being given a key "just in
			// case" — inventing one for a value that cannot exist is what `mixValueTag` has refused to
			// do since it was written, and the day a struct constant is legal the question is which of
			// its FIELDS a reader copies, which is a decision, not a default.
			structRef then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a struct constant would have to be folded from a `T.create(…)` call, and a call in a constant initializer is E2045")
			// A String top-level binding never reaches here, and P1.7's two managed slices did not change
			// that: a managed literal folds to `TopLevelConstant.managedValue`, whose hash is
			// `mixConstant`'s own arm (the BYTES and the KIND ride there), so it never comes through
			// `mixDeclAnswer` to this tag-only door at all.
			string then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a managed binding hashes through `mixConstant`'s `managedValue` arm, never through this one")
			// A FUNCTION top-level binding never reaches here (P1.5-A1): a function reference is not a
			// constant initializer, so the const evaluator never folds one to a `function`-tagged value.
			function then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a function value is not a constant initializer, so it is never folded to a top-level constant")
			// A TYPE-PARAMETER / GENERIC-INSTANCE top-level binding is unreachable (P1.6-A) for
			// `structRef`'s reason: neither is a folded scalar constant, so the const evaluator never
			// produces one at module scope. A `b"…"` global IS a generic instance, but it hashes through
			// `mixConstant`'s `managedValue` arm and never reaches this tag-only door.
			typeParameter then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a type parameter names no value at module scope")
			genericInstance then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a `b\"…\"` global hashes through `mixConstant`'s `managedValue` arm, never through this one")
			// A CHARACTER top-level binding is unreachable for `string`'s reason: the const evaluator folds
			// no character literal, so none is ever a top-level constant to hash.
			character then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a character literal is not folded to a top-level constant")
		end 'k'
	end 'mixValueTag'

	// The ranged typealias `name` denotes when read FROM `readerFilePath` — the reader's OWN file's
	// declaration first, then one the reader may actually NAME, and only then anyone else's
	// (`RangedAliasRegistry.lookup`, which carries the whole rule and its E3063 boundary). THE door the
	// shift rule asks through — see `Parser.valueIsUnsigned` — and the reason a file's `int(0 to 500)`
	// governs the casts written in it even where another file declares that name more widely.
	export function aliasOf(name ByteArray, readerFilePath FilePath) returns DeclaredAlias
		return self.typeAliases.lookup(name, readerFilePath: readerFilePath)
	end 'aliasOf'

	// Is SOME declaration of `name` nameable from any file? The all-declarations question the door
	// above cannot answer, asked only where `aliasOf`'s single answer is hidden — see
	// `RangedAliasRegistry.nameableFromAnyFile`, which carries the whole argument.
	export function aliasNameableFromAnyFile(name ByteArray) returns bool
		return self.typeAliases.nameableFromAnyFile(name)
	end 'aliasNameableFromAnyFile'

	// ⭐ **THE TYPE NAMES A FILE'S TOP-LEVEL CONSTANT INITIALIZERS CAST TO (P1.9) — a `use` the real
	// parse structurally cannot see.**
	//
	// `let SENTINEL = 5 as Slot` is the only mention of `Slot` in many real files, and the E3062 check
	// would call the alias unused. It cannot see the cast because the real parse SKIPS a top-level
	// initializer's tokens wholesale (`readTopLevelBinding`) — the initializer is folded once, before
	// any file is parsed, by the const evaluator (`evaluateInitializers`), whose `Parser` is transient
	// and whose artifact is discarded.
	//
	// So the use is recorded HERE, on the index that evaluator is building and that every parse then
	// reads. That is the same "record a use where the name is RESOLVED" rule the two parser hooks
	// follow (`Parser.recordTypeNameUse`); this is simply the door for the one reader that is not the
	// parser. It is keyed per DECLARING FILE, because "used in its OWN file" is the whole question.
	//
	// ⚠ It records the target of EVERY constant cast, including `as int` and `as ExitCode`. Filtering
	// to alias names would mean asking the alias registry mid-sweep, when it is still being built and
	// an absence means only "not swept yet"; and a name that is not a declared alias matches no
	// candidate, so the extra entries answer nothing and cost one set insert each.
	export function recordConstCastTarget(name ByteArray, declFilePath FilePath)
		self.constCastTargets.insert(fileScopedDeclKey(name, declFilePath: declFilePath))
	end 'recordConstCastTarget'

	// Did a top-level constant declared in `declFilePath` cast to `name`? The read half of the above.
	// It pays `fileScopedDeclKey`'s ~4 allocations, and pays them once per FILE-PRIVATE TYPEALIAS
	// DECLARED — not per use and not per name reference — which is why the composite key is affordable
	// here where `RangedAliasRegistry` refuses it.
	export function isConstCastTarget(name ByteArray, declFilePath FilePath) returns bool
		return self.constCastTargets.contains(fileScopedDeclKey(name, declFilePath: declFilePath))
	end 'isConstCastTarget'

	// The bare-name door, for the readers that have no file to ask from — see
	// `RangedAliasRegistry.underlyingInAnyFile`, which is where the (narrow) residual is written down
	// and why it hands back the primitive rather than the alias.
	export function aliasUnderlyingInAnyFile(name ByteArray) returns MaxonType throws MapError
		return try self.typeAliases.underlyingInAnyFile(name)
	end 'aliasUnderlyingInAnyFile'

	// Is `name` a ranged FLOAT typealias (`typealias Weight = float(f64.min to f64.max)`)? The `bool` half
	// of `aliasUnderlyingInAnyFile`, and the sibling of `isFunctionAlias`/`isGenericAlias` — the three
	// questions `fieldTypeOf` asks of a field declared with a bare NAME, whose meaning the declaration
	// SWEEP that recorded the layout could not yet know.
	//
	// ⚠ An INT alias is deliberately NOT re-tagged by any of them: `named` already reads as an integer
	// everywhere (`tagIsIntegral`), and its NAME is what carries the range and the signedness that
	// `valueIsUnsigned` and the range checks read off it. A FLOAT alias is the one `named` type whose
	// VALUE lives in a different register file, so it is the one that cannot be left overloaded.
	//
	// Bare-name, exactly as `isFunctionAlias`/`isGenericAlias` are and for `classifyUnionPayload`'s
	// reason: a `StructLayout` does not record the file its fields were declared in, so there is no
	// reader file to resolve from.
	export function isFloatAlias(name ByteArray) returns bool
		if let underlying = try self.aliasUnderlyingInAnyFile(name) 'rangedAlias'
			return tagIsFloat(maxonTypeTag(underlying))
		end 'rangedAlias'

		return false
	end 'isFloatAlias'

	// --- Inner + per-instance ranged aliases (P1.6-C) ---

	// Is `name` a BASE-TEMPLATE inner alias ("Wrapper.Idx") — the shared-body form a generic method's bare
	// `Idx` return/parameter resolves to? Membership in `innerAliases`.
	export function isInnerAlias(name ByteArray) returns bool
		return self.innerAliases.contains(name)
	end 'isInnerAlias'

	// The inner alias `name` names ("Wrapper.Idx"), or `undeclared`. Its stored `.name` is the BARE member
	// (`Idx`) the method-return retype re-qualifies with a concrete receiver's instance alias.
	export function innerAliasOf(name ByteArray) returns DeclaredAlias
		let alias = try self.innerAliases.get(name) otherwise return DeclaredAlias.undeclared
		return DeclaredAlias.declared(alias)
	end 'innerAliasOf'

	// The BARE member of the base-qualified inner alias `name` (`Wrapper.Idx` ⇒ `Idx`), or `EmptySourceText`
	// when `name` is not an inner alias. What the method-return retype re-qualifies (`{receiverAlias}.{member}`).
	export function innerAliasMember(name ByteArray) returns ByteArray
		return match self.innerAliasOf(name) 'm'
			declared(alias) gives alias.name
			undeclared gives EmptySourceText
		end 'm'
	end 'innerAliasMember'

	// ⭐ **IS `name` A REGISTERED PER-INSTANCE ALIAS ("IntWrapper.Idx")?** — the nominal-identity gate the
	// aggregate check reads. Its prefix must be a generic-instance ALIAS whose base declares the inner alias
	// named by its member. Keyed on the INSTANCE-ALIAS NAME, not the gid: `WrapperA` and `WrapperB` share one
	// gid yet are distinct aliases, so `WrapperA.Idx ≠ WrapperB.Idx` — the whole point of the rung.
	export function isPerInstanceAlias(name ByteArray) returns bool
		return match self.perInstanceAliasOf(name) 'p'
			declared gives true
			undeclared gives false
		end 'p'
	end 'isPerInstanceAlias'

	// The inner alias a per-instance `name` resolves to (its RANGE + bare member), or `undeclared`. The one
	// door `isPerInstanceAlias` and the erasure both read, so "is it per-instance?" and "what does it erase
	// to?" answer from one place.
	export function perInstanceAliasOf(name ByteArray) returns DeclaredAlias
		return match splitQualifiedName(name) 'split'
			notQualified gives DeclaredAlias.undeclared
			parts(prefix, member) gives self.perInstanceAliasFromParts(prefix, member: member)
		end 'split'
	end 'perInstanceAliasOf'

	// The inner alias a per-instance name's (prefix, member) resolves to — `undeclared` unless `prefix` is a
	// generic-instance alias whose base declares an inner alias `member`.
	function perInstanceAliasFromParts(prefix ByteArray, member ByteArray) returns DeclaredAlias
		if not self.isGenericAlias(prefix) 'notInstanceAlias'
			return DeclaredAlias.undeclared
		end 'notInstanceAlias'
		let base = self.genericInstanceBaseName(self.genericAliasInstance(prefix))
		return self.innerAliasOf(joinQualifiedName(base, member: member))
	end 'perInstanceAliasFromParts'

	// ⭐ **THE PER-INSTANCE-AWARE AGGREGATE CONFLICT RULE (P1.6-C)** — the ONE authority every symmetric
	// coercion site (return, reassignment, `otherwise`, match arm, union-payload / struct-literal store)
	// shares, so they cannot come to disagree about when a per-instance value decays.
	//
	// A per-instance `Idx` is a NOMINAL wrapper over a SCALAR int, so it DECAYS to plain int wherever a
	// value with NO nominal identity of its own is expected — exactly as a per-instance argument into a
	// plain-numeric parameter decays. `expected.isEmpty()` IS that condition: an empty aggregate name is this
	// file's one spelling of "carries no nominal identity" (`aggregateNameOf`, `aggregateNameFor` and
	// `instanceArgAggregateName` all answer it for a scalar, a `String` and a ranged alias). There is nothing
	// for an `Idx` to decay INTO when the target is a struct, a boxed union/enum or a generic instance, so
	// against a NAMED target the conflict stands and `namedAggregatesConflict` reports it.
	//
	// ⚠ **THE DECAY USED TO BE SPELLED "the target is not ITSELF a per-instance alias", AND THAT WAS A
	// REACHABLE WILD FREE.** It let an `Idx` — an int — decay into every named aggregate as well as into a
	// scalar. The safety argument written here was that "a struct value into a plain-numeric target is caught
	// by the TAG check that runs BEFORE every one of these sites", and that premise is a SECOND fact, held at
	// six call sites, that nothing made agree with this one. It is FALSE at the sixth:
	// `SemanticCheck.checkTypeParameterArgsAt` compares against `substitutedInstanceArg`, which returns the
	// type argument AS INTERNED — a struct spelled by name is a `named` LEAF, never `structRef` — so its tag
	// check is `checkDeclaredType(named, named)`, which AGREES. `Wrapper with Integer`'s `Idx` therefore
	// passed into a `Box with Leaf`'s `T` formal, was stored in the box's `T` field, and was freed by
	// `__destruct_Box_Leaf` as a `Leaf`: a wild free on the integer's value (MEASURED: exit 0xC0000005).
	// Deciding it from `expected` alone needs no premise held anywhere else.
	export function aggregatesConflict(expected ByteArray, got ByteArray) returns bool
		// `not self.isPerInstanceAlias(expected)` is not spelled: an EMPTY name can never be one
		// (`splitQualifiedName` answers `notQualified`), and a redundant clause is a fact stated twice.
		if expected.isEmpty() and not got.isEmpty() and self.isPerInstanceAlias(got) 'perInstanceDecays'
			return false
		end 'perInstanceDecays'
		return namedAggregatesConflict(expected, got: got)
	end 'aggregatesConflict'

	// The underlying primitive of a qualified alias (base-template OR per-instance) — TypeResolution's
	// erasure door: both collapse to their `int`/`float` underlying before lowering, exactly as a plain
	// ranged alias does; only the per-instance one ALSO carries nominal identity (kept in the value column).
	export function qualifiedAliasOf(name ByteArray) returns DeclaredAlias
		match self.innerAliasOf(name) 'inner'
			declared(alias) then return DeclaredAlias.declared(alias)
			undeclared then break 'inner'
		end 'inner'
		return self.perInstanceAliasOf(name)
	end 'qualifiedAliasOf'

	// Does ANY method in the whole program declare a bare inner-alias parameter (P1.6-C)? The
	// allocation-free bool gate the per-instance argument check reads BEFORE `methodInnerAliasParamsOf` —
	// which mints an `InnerAliasParamLookup` union (a heap box in the bootstrap) on every call. When this
	// answers false — every generics-free program, and any program with no per-instance method parameter —
	// no callee could ever be found, so the check returns without the per-call box. Mirrors the parser's
	// own `enclosingInnerAliases.count() != 0` gate and `aggregateNameFor`'s `containsQualifier` gate.
	export function hasInnerAliasParams() returns bool
		return self.methodInnerAliasParams.count() != 0
	end 'hasInnerAliasParams'

	// The inner-alias parameter info of `methodName` (`Wrapper.setTag`), or `noInnerAliasParams` when the
	// method declares no bare-inner-alias parameter — the common case, which costs no map entry. THE door the
	// parser's per-instance argument check asks through at a concrete call site.
	export function methodInnerAliasParamsOf(methodName ByteArray) returns InnerAliasParamLookup
		let info = try self.methodInnerAliasParams.get(methodName) otherwise return InnerAliasParamLookup.noInnerAliasParams
		return InnerAliasParamLookup.found(info)
	end 'methodInnerAliasParamsOf'

	// ⭐ **IS `name` A FUNCTION TYPEALIAS, AND WHAT DOES IT RETURN?** (P1.5-A1). THE door
	// `Parser.parseTypeReference` re-tags a `named` reference `MaxonType.function` through, and the one an
	// indirect call recovers the callee's return type from. `undeclared` is the common answer (most names
	// are not function aliases), spelled as a union arm rather than a sentinel for `DeclaredAlias`'s reason.
	// It carries no interner ids (the return type is a tag + a name ByteArray), so it needs no `into`.
	export function functionAliasOf(name ByteArray) returns DeclaredFunctionAlias
		let alias = try self.functionTypeAliases.get(name) otherwise return DeclaredFunctionAlias.undeclared
		return DeclaredFunctionAlias.declared(alias)
	end 'functionAliasOf'

	// Is `name` a declared FUNCTION typealias — the `bool` half of `functionAliasOf`, and a HOT-PATH
	// allocation guard, exactly like `containsStruct`/`containsEnum` are for their `*Of` twins. Asked of
	// EVERY `named` type REFERENCE (`parseTypeReference`), field READ (`fieldTypeOf`) and call RESULT
	// (`resolveNamedAlias`) — most of them ranged int aliases, none of them function aliases — so it
	// must not pay `functionAliasOf`'s `DeclaredFunctionAlias` box (a Maxon union value is a heap object
	// EVERY case, `undeclared` included) just to throw it away. A `Map.contains` allocates nothing. Only
	// the cold indirect-call return-type recovery, which needs the alias itself, calls `functionAliasOf`.
	export function isFunctionAlias(name ByteArray) returns bool
		return self.functionTypeAliases.contains(name)
	end 'isFunctionAlias'

	// The struct type `name` denotes, declared in ANY file — `aliasOf`'s twin, and the door the
	// PARSER asks every struct question through: is this name a `type`? how big is its box? which
	// slot is `x`?
	//
	// ⚠ **THE LAYOUT IT HANDS BACK CARRIES THIS INDEX'S IDS, so a caller may read its NAMES, its
	// COUNT and its OFFSETS but never its field TYPES.** Those are `MaxonType`s minted against
	// `self.typeNames`, which is private and stays private (the header's ID PROBLEM). `fieldTypeOf`
	// is the one door a field's type comes out of, and it re-interns on the way. The split is not
	// a nicety: `indexOfField`/`offsetOfField`/`sizeBytes` are pure arithmetic over the name column
	// and need no interner at all, so making every caller adopt a whole layout to ask "which slot?"
	// would allocate a copy per field access to answer a question about integers.
	export function structOf(name ByteArray) returns DeclaredStruct
		let layout = try self.structTypes.get(name) otherwise return DeclaredStruct.undeclared
		return DeclaredStruct.declared(layout)
	end 'structOf'

	// The `where` constraints declared on `typeName` (P1.7a slice 2a), in source order — the witness-slot
	// order. Empty for a non-generic, unconstrained, or undeclared type. Read by the E3017 instantiation
	// check (does each concrete argument conform?) and the witness lowering (which interface / concrete type
	// each hidden witness parameter carries).
	export function structWhereConstraints(typeName ByteArray) returns WhereConstraintArray
		let layout = try self.structTypes.get(typeName) otherwise return WhereConstraintArray.create()
		return layout.whereConstraints
	end 'structWhereConstraints'

	// The number of `where` constraints on `typeName` (P1.7a slice 2a) — the number of hidden witness
	// parameters an instance method of the type carries under dictionary-passing. 0 for an unconstrained or
	// undeclared type. A `Map.contains`-cheap arithmetic answer, so it is safe on the per-call-site path
	// that decides whether to append witness arguments.
	export function structWhereConstraintCount(typeName ByteArray) returns FieldIndex
		let layout = try self.structTypes.get(typeName) otherwise return 0
		return layout.whereConstraintCount()
	end 'structWhereConstraintCount'

	// Every `Base with Args` instantiation site with its source anchor (P1.7a slice 2a) — the list the E3017
	// where-constraint check walks. A constraint-free base's sites are cheaply skipped (its `whereConstraints`
	// is empty), so this is the whole instantiation set, not a pre-filtered one.
	export function instantiationSites() returns GenericInstantiationSiteArray
		return self.genericAliasSites
	end 'instantiationSites'

	// The concrete type NAME of instance `gid`'s type argument at `position` (P1.7a slice 2a) — the struct/name
	// a witness table is keyed by, and the type the E3017 check verifies conforms. `mangleTypeArg` renders a
	// struct/named arg to its bare name; a nested instance to its mangled form (which conforms to nothing at
	// this slice, so the check reports it as non-conforming — correct).
	export function instanceArgTypeName(gid GenericInstanceId, position TypeParamId) returns ByteArray
		return self.mangleTypeArg(self.substitutedInstanceArg(gid, position: position)).toByteArray()
	end 'instanceArgTypeName'

	// How many type arguments instance `gid` carries — `Box with String` ⇒ 1, `Pair with (A, B)` ⇒ 2.
	// The BOUND on `instanceArgTypeName`/`substitutedInstanceArg`'s `position`, for a reader that walks
	// an instance's whole argument list rather than one constrained parameter of it
	// (`renderInstantiation`, which spells a colliding instantiation back out in source form).
	//
	// ⚠ It is NOT `genericInstanceFieldCount`, which is the BASE STRUCT's field count: the two agree for
	// a plain generic struct and disagree for the builtin bases, where `Array with Integer` has one type
	// argument and no base struct at all (`genericInstanceFieldCount` panics on it).
	export function genericInstanceArgCount(gid GenericInstanceId) returns TypeParamId
		return self.genericInstances.instanceArgs(gid).count()
	end 'genericInstanceArgCount'

	// Is `name` a declared `type` — the `bool` half of `structOf`, and a HOT-PATH allocation guard, the
	// twin of `containsEnum`. `structOf` returns a `DeclaredStruct`, a Maxon union VALUE that boxes on
	// its `undeclared` case as much as any other, so a caller that only needs "is it a struct?" for the
	// COMMON no answer (`Parser.resolveNamedStruct` asks it of every `named` parameter/return type,
	// most of them ranged int aliases) must not pay that box just to throw it away. A `Map.contains`
	// allocates nothing.
	export function containsStruct(name ByteArray) returns bool
		return self.structTypes.contains(name)
	end 'containsStruct'

	// ⭐ **REGISTER THE COMPILER-OWNED `StringIndex` TYPE (P1.8 slice B2).** Called by the declaration
	// SWEEP when a file's tokens name one of the four methods that PRODUCE a `StringIndex`
	// (`Parser.atStringIndexProducer`) — the same shape `internArrayByteInstance` and
	// `internBuiltinIntegerInstance` are reached in, and for the same reason: the type has no declaration
	// to register from, and a program that never takes a String index must not carry the entry. Idempotent,
	// so the sweep is the WRITE and every parser read is a pure read; a per-file parse is therefore never
	// the first to mutate the shared registry.
	export function registerStringIndexType()
		if self.structTypes.contains(StringIndexTypeName) 'alreadyRegistered'
			return
		end 'alreadyRegistered'
		self.structTypes.upsert(StringIndexTypeName, value: stringIndexLayout())
	end 'registerStringIndexType'

	// The compiler-owned `StringIndex` layout, for the parser's field reads. It PANICS rather than
	// answering when the type is unregistered, because every caller reaches it through a value the parser
	// itself minted with the `structRef` tag — which the sweep must already have registered the layout for.
	export function stringIndexLayoutOrPanic() returns StructLayout
		return try self.structTypes.get(StringIndexTypeName) otherwise panic("ProgramSignatures.stringIndexLayoutOrPanic: `{String.from(StringIndexTypeName)}` is not registered — every StringIndex value is minted by a method the sweep's `atStringIndexProducer` scan sees, and that scan is what calls `registerStringIndexType`")
	end 'stringIndexLayoutOrPanic'

	// ⭐ **REGISTER THE COMPILER-OWNED `CharacterSet` TYPE (P1.8 Slice D)** — the `StringIndex` twin, called
	// by the declaration SWEEP when a file's tokens name a producer (`Parser.fileNamesCharacterSetProducer`).
	// Idempotent, so the sweep is the WRITE and every parser read is a pure read.
	//
	// It also interns `Set with Character`, because the layout's first field IS that instance: a
	// `CharacterSet` owns its member set, and the field's declared type is what routes the box's drop.
	export function registerCharacterSetType()
		let charsInstance = self.setInstanceForCharacter()
		// ⭐ **`CharSet` IS A BUILTIN GENERIC-INSTANCE ALIAS, exactly as the reference declares it**
		// (`typealias CharSet = Set with Character`, `stdlib/CharacterSet.maxon:19`) — it is the type
		// `CharacterSet.from` takes, and shv2 reads no stdlib to get it from. Registered through the SAME
		// `genericAliases` map a user `typealias` folds into, so `CharSet.create()` and `CharSet from […]`
		// reach the ordinary `Set` alias paths with nothing special-cased at either.
		// ⚠ It therefore RESERVES the name program-wide for a file that names a `CharacterSet` producer,
		// exactly as listing a stdlib module reserves its type names (`StdlibLoader`'s collision rule). The
		// reference reserves it too, being an exported alias of a module every program loads.
		self.genericAliases.upsert(CharacterMemberSetAliasName, value: charsInstance)
		if self.structTypes.contains(CharacterSetTypeName) 'alreadyRegistered'
			return
		end 'alreadyRegistered'
		self.structTypes.upsert(CharacterSetTypeName, value: characterSetLayout(charsInstance))
	end 'registerCharacterSetType'

	// ⭐ **THE LAYOUT, AND THE CHECK THAT IT MATCHES THE BOX THE RUNTIME BUILDS** — `stringIndexLayout`'s
	// discipline, for the same reason: the front end states this type's shape here and `__cs_make` writes it
	// through `CharacterSetRuntime`'s constants, and two readers of one shape is the pair that drifts.
	function characterSetLayout(charsInstance GenericInstanceId) returns StructLayout
		var layout = StructLayout.create(CharacterSetTypeName)
		layout.addField(CharacterSetCharsFieldName, declaredType: MaxonType.genericInstance(charsInstance), mutable: false, exported: false, defaultValue: FieldDefault.none, declaredSurface: sharedEmptyDeclaredSurface)
		layout.addField(CharacterSetMaskFieldName, declaredType: MaxonType.integer, mutable: false, exported: false, defaultValue: FieldDefault.none, declaredSurface: sharedEmptyDeclaredSurface)

		if layout.offsetOfField(CharacterSetCharsFieldIndex) != CharSetCharsOffset or layout.offsetOfField(CharacterSetMaskFieldIndex) != CharSetMaskOffset 'offsetDrift'
			panic("characterSetLayout: the struct layout puts `chars`/`categoryMask` at {layout.offsetOfField(CharacterSetCharsFieldIndex)}/{layout.offsetOfField(CharacterSetMaskFieldIndex)} but `__cs_make` writes them at {CharSetCharsOffset}/{CharSetMaskOffset} — the front end's shape and the runtime's field writes have drifted")
		end 'offsetDrift'
		if layout.sizeBytes() as ParsedInt != CharSetBoxBytes 'sizeDrift'
			panic("characterSetLayout: the struct layout is {layout.sizeBytes()} bytes but `__cs_make` allocates {CharSetBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'
		return layout
	end 'characterSetLayout'

	// ⭐ **REGISTER THE COMPILER-OWNED `__ManagedFile` TYPE (R4.1)** — the `CharacterSet` twin, called by the
	// declaration SWEEP when a file's tokens name a producer (`Parser.fileNamesManagedFileProducer`).
	// Idempotent, so the sweep is the WRITE and every parser read is a pure read.
	//
	// ⚠ It registers under the name the SOURCE SPELLS (`__ManagedFile`), where `CharacterSet` and
	// `StringIndex` register under a reserved name distinct from their user-facing one. See
	// `ManagedFileTypeName` for why that difference is the point rather than an inconsistency: this type
	// MUST be namable in a parameter and a field, and the corpus requires it.
	export function registerManagedFileType()
		// `__ManagedMemory` is an ALIAS, not a layout — see `ManagedMemoryTypeName`. Registered through the
		// SAME `genericAliases` map a user `typealias` folds into, exactly as `CharSet` is, so a
		// `__ManagedMemory` annotation reaches the ordinary `Array` paths with nothing special-cased.
		//
		// ⚠⚠ **"NOTHING SPECIAL-CASED" STOPS SHORT OF THE BUFFER SURFACE, AND A2j IS WHY.** The surface is
		// decided by PROVENANCE on a `ValueId` (`Parser.valueIsBufferSurface`), and this alias folds the
		// SPELLING away — so a value bound by a parameter, a struct field or a return type written
		// `__ManagedMemory` was indistinguishable from a `ByteArray` and took the `Array` surface. Measured
		// 2026-07-31: `function f(m __ManagedMemory)` with `m.push(7)`/`m.count()` compiled, linked and RAN,
		// while `m.length()` was refused as an unknown `Array` method — the roster exactly inverted.
		// ⇒ Each of those three declaration sites now carries the pre-erasure spelling to the site that binds
		// the value (`Parser.declaredSurfaceAt` / `markDeclaredSurface`); the return half's
		// column is `declaredReturnSurfaces` in THIS index, since a callee may be in another file. Type
		// resolution is untouched: `__ManagedMemory` still resolves to `Array with Byte`, which is what keeps
		// a `ByteArray` argument assignable to a `__ManagedMemory` parameter.
		// Upserted before the early return below because the two registrations are independent: the alias
		// must exist even on a second call that finds the layout already there.
		self.genericAliases.upsert(ManagedMemoryTypeName, value: self.internArrayByteInstance())

		// ⭐ **BOTH `__ManagedMemory` ELEMENT INSTANCES ARE INTERNED HERE, BY THE SWEEP (R4.4)** — the
		// machine-word one alongside the byte one, because `__ManagedMemory.create(n, elementSize: 8)` picks
		// it (`managedMemoryInstanceForElementSize`) and the parser may only READ the registry, never be the
		// first to write it. It is OVER-interned exactly as this whole probe is (a file merely NAMING
		// `__ManagedMemory` registers the layout), which is the sweep's standing discipline: over-register
		// rather than miss.
		_ = self.internBuiltinIntegerInstance(ArrayBuiltinBaseName)

		if self.structTypes.contains(ManagedFileTypeName) 'alreadyRegistered'
			return
		end 'alreadyRegistered'
		self.structTypes.upsert(ManagedFileTypeName, value: managedFileLayout())
	end 'registerManagedFileType'

	// The `__ManagedFile` layout, held to the runtime's own constants by the same drift check
	// `characterSetLayout` uses and for the same reason — the front end states the shape here, the runtime
	// writes the handle through `ManagedFileHandleOffset`, and two readers of one shape is the pair that
	// drifts. ⚠ Both references register an 8-byte handle struct whose runtime block is a DIFFERENT size,
	// with nothing tying the two; this check is what keeps that from being repeated here.
	function managedFileLayout() returns StructLayout
		var layout = StructLayout.create(ManagedFileTypeName)
		layout.addField(ManagedFileHandleFieldName, declaredType: MaxonType.integer, mutable: true, exported: false, defaultValue: FieldDefault.none, declaredSurface: sharedEmptyDeclaredSurface)

		if layout.offsetOfField(ManagedFileHandleFieldIndex) != ManagedFileHandleOffset 'offsetDrift'
			panic("managedFileLayout: the struct layout puts `_handle` at {layout.offsetOfField(ManagedFileHandleFieldIndex)} but the runtime reads it at {ManagedFileHandleOffset} — the front end's shape and the runtime's field access have drifted")
		end 'offsetDrift'
		if layout.sizeBytes() as ParsedInt != ManagedFileBoxBytes 'sizeDrift'
			panic("managedFileLayout: the struct layout is {layout.sizeBytes()} bytes but the runtime allocates {ManagedFileBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'
		return layout
	end 'managedFileLayout'

	// ⭐ **REGISTER THE COMPILER-OWNED `__ManagedDirectory` TYPE (R4.3)** — `registerManagedFileType`'s twin,
	// called by the declaration SWEEP when a file's tokens name it (`Parser.atManagedDirectoryProducer`).
	// Idempotent, so the sweep is the WRITE and every parser read is a pure read.
	//
	// ⚠⚠ **IT INTERNS `Array with Byte`, AND THAT IS NOT REDUNDANT WITH THE FILE FAMILY'S UPSERT.**
	// `filename()` and `currentPath()` PRODUCE a `__ManagedMemory` without the program ever naming one:
	// `let cwd = try __ManagedDirectory.currentPath()` writes no `__ManagedMemory` token, no `b"…"` literal
	// and (until the next line) no `.toByteArray()`, so none of the sweep's existing byte-instance triggers
	// fires and the parser — which may only READ the registry — would have no instance to tag the result
	// with. Over-interned rather than missed, which is this sweep's standing discipline.
	// ⚠ The `__ManagedMemory` ALIAS itself is `registerManagedFileType`'s to upsert and is not repeated here:
	// a file that annotates one has written the name, which is what that probe matches on.
	export function registerManagedDirectoryType()
		_ = self.internArrayByteInstance()

		if self.structTypes.contains(ManagedDirectoryTypeName) 'alreadyRegistered'
			return
		end 'alreadyRegistered'
		self.structTypes.upsert(ManagedDirectoryTypeName, value: managedDirectoryLayout())
	end 'registerManagedDirectoryType'

	// The `__ManagedDirectory` layout, held to the runtime's own constants by the same drift check
	// `managedFileLayout` uses and for the same reason. ⚠ The check earns more here than there: BOTH
	// references declare an 8-byte one-field struct while v1's runtime block is 40 bytes and the bootstrap's
	// is 336, with nothing tying any of the three together. This is the pair that keeps shv2's front-end
	// shape and its `__mm_alloc` from becoming a fourth combination.
	function managedDirectoryLayout() returns StructLayout
		var layout = StructLayout.create(ManagedDirectoryTypeName)
		layout.addField(ManagedDirectoryBlockFieldName, declaredType: MaxonType.integer, mutable: true, exported: false, defaultValue: FieldDefault.none, declaredSurface: sharedEmptyDeclaredSurface)

		if layout.offsetOfField(ManagedDirectoryBlockFieldIndex) != ManagedDirectoryBlockOffset 'offsetDrift'
			panic("managedDirectoryLayout: the struct layout puts `_block` at {layout.offsetOfField(ManagedDirectoryBlockFieldIndex)} but the runtime reads it at {ManagedDirectoryBlockOffset} — the front end's shape and the runtime's field access have drifted")
		end 'offsetDrift'
		if layout.sizeBytes() as ParsedInt != ManagedDirectoryBoxBytes 'sizeDrift'
			panic("managedDirectoryLayout: the struct layout is {layout.sizeBytes()} bytes but the runtime allocates {ManagedDirectoryBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'
		return layout
	end 'managedDirectoryLayout'

	// ⚠ **THERE IS DELIBERATELY NO `characterSetLayoutOrPanic`**, where `StringIndex` has one. An index is
	// READ through its layout (`charIndex()`/`bytePos()` are field loads, `stringIndexLayoutOrPanic` serves
	// them); a `CharacterSet` has no field access at all — the front end never loads either field and the
	// runtime writes both through `CharacterSetRuntime`'s own constants. So the layout registered above is
	// read by nothing, and an accessor for it would be an exported function with one caller: its own panic.
	// What the registration buys is the DRIFT CHECK inside `characterSetLayout` and the nominal identity
	// `containsStruct` answers for; if a later slice adds a field read, add the accessor with it.

	// The `Set with Character` instance a `CharacterSet`'s explicit members live in, and the instance a
	// `CharSet from [...]` constructs (P1.8 Slice D) — the `setInstanceForString` twin. Keyed as
	// `MaxonType.character`, the SAME arg a `typealias CharSet = Set with Character` interns, so a
	// compiler-built member set and a user-declared one share ONE gid and are type-identical. Idempotent.
	export function setInstanceForCharacter() returns GenericInstanceId
		var args = MaxonTypeArray.create()
		args.push(MaxonType.character)
		return self.genericInstances.intern(self.typeNames.intern(SetBuiltinBaseName), args: args)
	end 'setInstanceForCharacter'

	// --- Synthesized TUPLE types (P1.10) ---
	//
	// ⭐ **THE PARSER IS THE ONLY PRODUCER, AND IT REGISTERS INTO THIS INDEX DIRECTLY.** Every other
	// compiler-owned layout (`__StringIndex`, `__CharacterSet`) is registered by the declaration SWEEP,
	// because a TOKEN scan can see the method that produces one. A tuple's identity is its ELEMENT TYPES, and
	// those are known only where the expression is parsed — `let t = (10, 32)` is two `integer`s and a token
	// scan cannot say so — so the sweep cannot pre-register the set. The registration is nevertheless safe on
	// exactly the terms that make the sweep-then-read discipline work elsewhere: the layout is a PURE FUNCTION
	// of the name (which is a pure function of the element types), and the write is idempotent, so no ordering
	// between files, and no interleaving of a parallel fan-out, can produce two different answers.
	//
	// The parser records the SAME layout into its `FileParseArtifact` as well, so `mergeArtifact` commits it
	// to `project.structTypes` — the registry `installStructDestructors` walks. Two registries, exactly as a
	// DECLARED `type` lives in both and for the reason `StructLayout`'s header states.
	//
	// ⚠ **THE STANDING OBLIGATION THAT COMES WITH THAT, FOR WHOEVER BUILDS THE INCREMENTAL DRIVER.** The two
	// registries are rebuilt on DIFFERENT triggers — `project.structTypes` at every merge (from artifacts
	// that may be cache HITS), this index whenever any file's bytes change — and a tuple minted only inside a
	// function BODY is registered here by the PARSE. So a rebuild in which a body-only edit to one file
	// leaves another file's parse memoized would hand `installStructDestructors` a layout this index has
	// never seen, and its `structHasManagedField(name)` would panic. A DECLARED tuple is never missing: the
	// sweep re-runs `parseTypeReference` over every declaration on every rebuild.
	//
	// It is UNREACHABLE today and was measured so, not assumed: nothing runs the full pipeline twice on one
	// `Project` — `build` and each spec-test worker construct a fresh one, and `verify-warm-rebuild` drives
	// `queryAllModule` alone for its cache and invalidation probes (`compileColdOnce` takes its own
	// `Project`). The fix when that changes is to derive the destructor installer's per-field questions from
	// the layout it ALREADY HOLDS instead of re-asking this index by name; a restoration pass that no code
	// path can exercise would be the unread-index shape the query spine's header warns about.

	// ⭐ **INTERN THE TUPLE TYPE OF `elements`, and answer with its MANGLED NAME.** The one door a tuple type
	// is minted through — a `(a, b)` literal, a `(T, U)` type annotation, a `typealias Pair = (…)` — so every
	// spelling of one tuple type lands on ONE layout.
	//
	// ⭐⭐ **IT CANONICALIZES, AND ONLY ONCE THE WHOLE PROGRAM IS FOLDED.** A ranged alias collapses to its
	// underlying primitive, which is what makes `sum(t (Integer, Integer))` accept the `(10, 32)` a caller
	// built — the identity rule the bootstrap gets from `IrType.Resolve` (`MlirType.cs:292`). It cannot be
	// done during the SWEEP: `Integer`'s own declaration may be below the function, or in a file not yet
	// folded, so the alias registry has no answer yet. A sweep-minted name is therefore the SOURCE spelling
	// (`__Tuple2.Integer.Integer`), and `adoptType` — the ONE door this index's types cross out of — rewrites
	// it to the canonical one at every read. That is the identical arrangement `declaredSlotType`'s three
	// re-tags already live under, and for the identical reason.
	// ⚠ **THE ELEMENT REJECTIONS FIRE ONLY IN THE REAL PARSE, and that is the standing sweep discipline
	// rather than a hole.** During the sweep a generic-instance / function / inner alias is still a bare
	// `named` (its registry is being built), so the canonical form the rejections are asked about does not
	// exist yet — a sweep-time verdict would be decided by file order. The sweep therefore records whatever
	// spelling it sees, the real parse asks the question with the whole program in hand, and a program that
	// fails it is rejected before anything downstream reads the tuple. The sweep's spelling is registered but
	// never referenced, exactly like the instances `internArrayLiteralAggregateInstances` over-interns.
	export function internTupleType(elements MaxonTypeArray, from TypeNameInterner) returns ByteArray throws TupleElementRejection
		var interned = MaxonTypeArray.create()
		for i in 0 upto elements.count() 'eachElement'
			let adopted = self.adoptTypeFrom(try elements.get(i) otherwise panic("internTupleType: elements.get OOB at {i} below count {elements.count()}"), from: from)
			if not self.allFilesFolded 'tolerantSweep'
				interned.push(adopted)
				continue
			end 'tolerantSweep'

			try requireTupleElementType(adopted, position: i)
			let canonical = self.canonicalTupleElement(adopted)
			try self.requireSeparatorFreeElementName(canonical, position: i)
			interned.push(canonical)
		end 'eachElement'

		return self.registerTupleLayout(interned)
	end 'internTupleType'

	// ⭐ **THE INJECTIVITY ARGUMENT, ENFORCED AT THE JOIN THAT RELIES ON IT** — `witnessTableLabel`'s
	// discipline, asked where it is spent rather than argued above it. A canonical element renders to a bare
	// identifier for every tag but one, and the exception is the point: a NESTED tuple's own name holds the
	// separator, and is exempt because the ARITY in front of it makes it self-delimiting (see
	// `TupleElementSeparator`). Everything else holding a `.` would make two distinct element lists spell one
	// name, so it is refused.
	function requireSeparatorFreeElementName(element MaxonType, position FieldIndex) throws TupleElementRejection
		if tagIsStructRef(maxonTypeTag(element)) and isTupleTypeName(self.nameOfId(typeNameIdOf(element))) 'nestedTuple'
			return
		end 'nestedTuple'

		let rendered = self.tupleElementName(element)
		if rendered.contains(TupleElementSeparator) 'separatorInName'
			throw TupleElementRejection.separatorInElementName(position, elementName: rendered)
		end 'separatorInName'
	end 'requireSeparatorFreeElementName'

	// Register the layout for an already-interned, already-canonical element list and answer its name.
	// Idempotent — a second mint of the same tuple type is a `contains` hit that builds nothing.
	function registerTupleLayout(elements MaxonTypeArray) returns ByteArray
		let name = self.tupleTypeNameOf(elements)
		if self.structTypes.contains(name) 'alreadyRegistered'
			return name
		end 'alreadyRegistered'

		self.structTypes.upsert(name, value: tupleStructLayout(name, elements: elements))
		return name
	end 'registerTupleLayout'

	// `__Tuple<N>.<e0>.<e1>…` — the mangled name of a tuple over `elements`. See `TupleElementSeparator` for
	// why the arity leads and why the join is `.`.
	function tupleTypeNameOf(elements MaxonTypeArray) returns ByteArray
		var out = "{String.from(TupleTypeNamePrefix)}{elements.count()}"
		for element in elements 'eachElement'
			out.append(TupleElementSeparator)
			out.append(self.tupleElementName(element))
		end 'eachElement'
		return out.toByteArray()
	end 'tupleTypeNameOf'

	// The mangled spelling of ONE canonical element. `mangleTypeArg` — the index's structural, build-stable
	// renderer — answers every tag but one.
	//
	// ⚠ **A `function`-TYPED ELEMENT IS THE EXCEPTION, because `mangleTypeArg` renders every function type as
	// the bare tag name `function`.** That is correct for a descriptor label (a code pointer is a code pointer)
	// and WRONG for an identity: `(UnaryOp, int)` and `(BinaryOp, int)` would spell one name, and a value of
	// one would then be accepted where the other is declared. A function type carries its governing alias
	// NAME, so that is what rides here.
	function tupleElementName(element MaxonType) returns String
		if maxonTypeTag(element) == ValueTypeTag.function 'functionAlias'
			return String.from(self.nameOfId(typeNameIdOf(element)))
		end 'functionAlias'
		return self.mangleTypeArg(element)
	end 'tupleElementName'

	// ⭐ **THE CANONICAL FORM OF ONE TUPLE ELEMENT — what a tuple's IDENTITY is keyed on.**
	//
	// It routes through `declaredSlotType`, the SAME door a struct FIELD's declared type comes out of, so a
	// tuple element and a field of the same declared type can never be classified differently — a function
	// alias becomes `function`, a generic-instance alias becomes `genericInstance`, a ranged float alias
	// becomes `float`. Then a ranged INT alias collapses through `canonicalizeRangedAlias` (which
	// `declaredSlotType` deliberately leaves alone, because a `named` int alias carries its range and
	// signedness for the shift rule), and an INNER ranged alias (`Wrapper.Idx`) collapses the same way — the
	// only name form in the language that can hold the element separator, so resolving it is what keeps the
	// join injective rather than merely usually-injective.
	//
	// A `named` denoting a declared `type` is re-tagged `structRef` by `declaredSlotType` itself, so the
	// tuple's field type routes to the struct's own drop — and, unlike the copy of that rule that used to
	// stand at the bottom of this function, it then reaches `canonicalTupleStructRef` and a NESTED-tuple
	// element spelled by name canonicalizes like every other `structRef`. A `named` denoting an enum/union
	// stays `named`, which is the tag a union value carries.
	function canonicalTupleElement(element MaxonType) returns MaxonType
		let resolved = self.canonicalizeRangedAlias(self.declaredSlotType(element, into: self.typeNames))
		if maxonTypeTag(resolved) != ValueTypeTag.named 'notNamed'
			return self.canonicalTupleStructRef(resolved)
		end 'notNamed'

		let name = self.nameOfId(typeNameIdOf(resolved))
		if self.isInnerAlias(name) 'innerRangedAlias'
			match self.innerAliasOf(name) 'inner'
				declared(alias) then return alias.underlying
				undeclared then panic("canonicalTupleElement: `isInnerAlias('{String.from(name)}')` is true but `innerAliasOf` answered undeclared — the two read one registry")
			end 'inner'
		end 'innerRangedAlias'
		return resolved
	end 'canonicalTupleElement'

	// ⭐ **THE `MaxonType`-LEVEL TWIN OF `canonicalNameOfStruct`: a tuple `structRef` under a SWEEP spelling
	// answered as the canonical one, everything else itself.** One derivation, two readers — a NESTED tuple
	// ELEMENT (`canonicalTupleElement`, whose recursion this terminates: each step strips one nesting level
	// off a type written in finite source) and a generic instance's stored ARGUMENT (`arrayElementType`).
	// Both ask the same question about the same tag, and the `allFilesFolded` gate that says whether a
	// canonical form exists yet lives once, in `canonicalNameOfStruct`, rather than at each asker.
	function canonicalTupleStructRef(element MaxonType) returns MaxonType
		if not tagIsStructRef(maxonTypeTag(element)) 'notStruct'
			return element
		end 'notStruct'

		let name = self.nameOfId(typeNameIdOf(element))
		let canonical = self.canonicalNameOfStruct(name)
		if canonical.equals(name) 'alreadyCanonical'
			return element
		end 'alreadyCanonical'
		return MaxonType.structRef(self.typeNames.intern(canonical))
	end 'canonicalTupleStructRef'

	// ⭐ **THE CANONICAL TUPLE NAME FOR A NAME THE SWEEP MINTED.** Re-canonicalizes the registered layout's
	// element list now that every declaration is folded, registers the canonical layout if it is new, and
	// MEMOIZES — so the rewrite `adoptType` performs at every read costs one map hit after the first.
	// A name that is already canonical maps to itself, which is what makes the memo cover both directions.
	export function canonicalTupleName(name ByteArray) returns ByteArray
		if let memoized = try self.tupleCanonicalNames.get(name) 'alreadyDerived'
			return memoized
		end 'alreadyDerived'

		// ⚠⚠ **SEEDED WITH ITSELF BEFORE THE WALK — THE MEMO IS ALSO THIS WALK'S RE-ENTRY MARKER (A3e).**
		// Every other element this walk descends into strips one nesting level off a type written in finite
		// source, which is the argument `canonicalTupleStructRef` terminates on. A tuple-ALIAS element does
		// not: `declaredSlotType` resolves it to its target, and an alias NAME can name the very tuple being
		// canonicalized — `typealias P = (P, Int)` registers `__Tuple2.P.int`, whose element 0 is `named("P")`,
		// whose target is `__Tuple2.P.int`. Re-entry therefore resolves that element to the SWEEP spelling it
		// already carries, which is the answer it had before the element door could follow an alias at all, and
		// the infinite type is refused downstream by the return check instead of by the stack running out. The
		// real answer replaces the seed below, and a walk that never re-enters never reads it.
		self.tupleCanonicalNames.upsert(name, value: name)

		let layout = try self.structTypes.get(name) otherwise panic("ProgramSignatures.canonicalTupleName: `{String.from(name)}` is not registered — every tuple `structRef` in the compiler was minted by `internTupleType`, which registers the layout before it hands the name back")
		var canonical = MaxonTypeArray.create()
		for element in layout.fieldTypes 'eachElement'
			canonical.push(self.canonicalTupleElement(element))
		end 'eachElement'

		let canonicalName = self.registerTupleLayout(canonical)
		self.tupleCanonicalNames.upsert(name, value: canonicalName)
		return canonicalName
	end 'canonicalTupleName'

	// Record `typealias <name> = (<elements>)` (P1.10). Written by BOTH the declaration sweep and the real
	// parse from the same reader, exactly as every other alias registry is; the value is whichever spelling
	// the writing pass could produce, and `tupleAliasTarget` canonicalizes on the way out.
	export function recordTupleAlias(name ByteArray, tupleName ByteArray)
		self.tupleAliases.upsert(name, value: tupleName)
	end 'recordTupleAlias'

	// Is `name` a TUPLE typealias? THE hot-path guard `parseTypeReference` asks of every bare type name, so
	// it must allocate nothing (`Map.contains`) — the `isGenericAlias` twin.
	export function isTupleAlias(name ByteArray) returns bool
		return self.tupleAliases.contains(name)
	end 'isTupleAlias'

	// ⭐⭐ **THE NAME A DECLARED POSITION'S `named` TYPE ACTUALLY DENOTES — a tuple typealias answered as the
	// tuple's own canonical name, every other name as itself (A3e). THE one home of that resolution.**
	//
	// A tuple alias mints no identity, so `Pair` is not a registered anything: `containsStruct` says no,
	// `enumOf` says no, and every classifier that reads a RAW layout field type (`typeIsManaged`, the drop
	// callee, the clone strategy, the deep-clone gate) reached its `undeclared` arm on it. It arrives under
	// the alias spelling exactly when the declaration SWEEP recorded the position before the alias's own file
	// was walked — which is a fact about the filesystem's walk order and not about the program.
	//
	// ⚠ It is written ONCE and asked at each classifier rather than resolved into the layout, because those
	// classifiers are deliberately allocation-free over the index's own interner (see `structFieldIsManaged`)
	// and a rewritten layout would be a second copy of the declaration that could drift from the first.
	export function denotedAggregateName(name ByteArray) returns ByteArray
		return self.tupleAliasTarget(name) if self.isTupleAlias(name) else name
	end 'denotedAggregateName'

	// The tuple type `name` aliases, CANONICAL. Precondition: `isTupleAlias(name)`.
	export function tupleAliasTarget(name ByteArray) returns ByteArray
		return self.canonicalNameOfStruct(try self.tupleAliases.get(name) otherwise panic("ProgramSignatures.tupleAliasTarget: '{String.from(name)}' is not a tuple typealias — every caller asks `isTupleAlias` first"))
	end 'tupleAliasTarget'

	// A tuple's field type ADOPTED into `into` — `fieldTypeOf`'s answer for every element at once, which is
	// what the parser needs to build the artifact's own copy of the layout (`remapArtifact` rewrites an
	// artifact layout's field types in place, so the index's copy may never be shared with it).
	export function adoptTupleLayout(name ByteArray, into TypeNameInterner) returns StructLayout
		let layout = try self.structTypes.get(name) otherwise panic("ProgramSignatures.adoptTupleLayout: `{String.from(name)}` is not registered — every caller reached here with a name `internTupleType` handed back")
		var adopted = MaxonTypeArray.create()
		for element in layout.fieldTypes 'eachElement'
			adopted.push(self.adoptType(element, into: into))
		end 'eachElement'
		return tupleStructLayout(name, elements: adopted)
	end 'adoptTupleLayout'

	// ⭐ **THE MIRROR OF `adoptType`: re-intern an id-bearing type INTO this index's own table.** `adoptType`
	// is the door this index's ids leave by; this is the one they arrive by, and the parser is its only caller
	// (a tuple's element types are minted against the FILE's interner and the layout registered here must not
	// carry a foreign id — the ID PROBLEM in this file's header). By NAME, never by raw id, exactly as its
	// mirror is.
	function adoptTypeFrom(t MaxonType, from TypeNameInterner) returns MaxonType
		return match t 'r'
			named(id) gives MaxonType.named(self.typeNames.intern(foreignNameOf(from, id: id)))
			structRef(id) gives MaxonType.structRef(self.typeNames.intern(foreignNameOf(from, id: id)))
			function(id) gives MaxonType.function(self.typeNames.intern(foreignNameOf(from, id: id)))
			// Everything else carries no per-file interner id — a primitive, a `String`/`Character` (no name
			// at all), a type-parameter POSITION and a whole-program `GenericInstanceId` — so it crosses
			// unchanged, exactly as `adoptType`'s own arms state.
			boolean to float gives t
			exitCode to unresolved gives t
			string gives t
			typeParameter gives t
			genericInstance gives t
			character gives t
		end 'r'
	end 'adoptTypeFrom'

	// --- Generic-instance queries (P1.6-A) ---

	// Is `name` a declared generic-instance TYPEALIAS (`IntBox`)? THE hot-path guard the parser asks of
	// every type reference and every qualified-call base, so it must allocate nothing (`Map.contains`).
	export function isGenericAlias(name ByteArray) returns bool
		return self.genericAliases.contains(name)
	end 'isGenericAlias'

	// The `GenericInstanceId` a generic-instance alias names. Precondition: `isGenericAlias(name)`.
	export function genericAliasInstance(name ByteArray) returns GenericInstanceId
		return try self.genericAliases.get(name) otherwise panic("ProgramSignatures.genericAliasInstance: '{String.from(name)}' is not a generic-instance alias — every caller asks isGenericAlias first")
	end 'genericAliasInstance'

	// The base STRUCT name a generic-instance id refers to (`Box` for `Box with Integer`) — what
	// `Parser.parseQualifiedCall` rewrites `IntBox.create` to `Box.create` through. The instance's
	// ARGUMENT types are not exposed: at this trivial slice a member type is never SUBSTITUTED (a `T`
	// stays opaque), so nothing reads them out — the checks that need them (arity, managed) read them
	// straight off the parser-local `MaxonType` list at the instantiation site.
	export function genericInstanceBaseName(id GenericInstanceId) returns ByteArray
		return self.nameOfId(self.genericInstances.instanceBaseId(id))
	end 'genericInstanceBaseName'

	// --- The `Array` builtin generic (P1.7 slice 1) ---
	//
	// `Array` is a BUILTIN generic type with one type parameter `Element` — there is no `type Array uses
	// Element` declaration (shv2 does not read stdlib; the array runtime is synthesized like String's). So
	// its instances (`Array with Integer`) intern like any other, but they have no base `StructLayout`, and
	// every `genericInstance*` method that would read one (`baseLayoutOf`, box size, per-instance drop) must
	// special-case them. The box is a FIXED 48-byte record (`ArrRecordBytes`, see ArrayRuntime), not
	// `fieldCount·8`. The one home of "is this instance an `Array`?" so no site respells the base name.

	// Is `name` the builtin `Array` type — the base of every array instance.
	export function isArrayBaseName(name ByteArray) returns bool
		return name.equals(ArrayBuiltinBaseName)
	end 'isArrayBaseName'

	// Is generic instance `id` an `Array with T`? (Reads the base NAME, which needs no base struct.)
	export function isArrayInstance(id GenericInstanceId) returns bool
		return self.isArrayBaseName(self.genericInstanceBaseName(id))
	end 'isArrayInstance'

	// The element TYPE of `Array with T` — its sole type argument, in this index's own interner.
	//
	// ⭐⭐ **A TUPLE ARGUMENT IS CANONICALIZED ON THE WAY OUT (P1.10), and a generic instance's stored ARG is
	// the SECOND door this index's types leave by.** `adoptType` performs the same rewrite for every type
	// that crosses into a FILE's interner; an instance argument crosses no such door — it is read in place —
	// so without the rewrite here the two doors answer differently about one type. MEASURED, not argued:
	// `typealias Tagged = (Num, String)` is folded by the SWEEP, which spells its elements the way the source
	// did, so `typealias TaggedArray = Array with Tagged` stored `structRef(__Tuple2.Num.String)` — while
	// every VALUE the array holds carries the canonical `__Tuple2.int.String`, and only THAT layout reaches
	// `installStructDestructors` (an artifact records only what the real parse minted). The `element_destroy@40`
	// stamp therefore named `__destruct___Tuple2.Num.String` and the x64 backend died on the unresolved
	// symbol — `panic … resolveCallFixups: call to unknown function` (P1.10 review). Every semantic fact the
	// array derives from its element — managed-ness, the drop callee, the clone strategy, the element size —
	// now reads the layout the elements ACTUALLY carry.
	//
	// ⚠ **THE INSTANCE'S OWN COMPILED NAME IS DELIBERATELY NOT CANONICALIZED**: `mangleGenericInstance` reads
	// `instanceArgs` directly. Rewriting it there would give a sweep-spelled instance and a canonically-spelled
	// one the SAME symbol while they remain two gids — the `E3006 duplicate definition` shape
	// `arrayInstanceForNamedElement` documents. That the two stay two TYPES is this rung's named residual:
	// `Array with Tagged` and an `Array` of the same tuple minted from a literal do not unify, reported as an
	// honest argument-type mismatch naming both spellings. Unifying them means MERGING two gids in the
	// registry, which is a change to instance identity itself and not something a read door may make.
	export function arrayElementType(id GenericInstanceId) returns MaxonType
		let args = self.genericInstances.instanceArgs(id)
		return self.canonicalTupleStructRef(try args.get(0) otherwise panic("ProgramSignatures.arrayElementType: `Array` instance {id} has no type argument — arity (1) was checked at instantiation"))
	end 'arrayElementType'

	// --- The `Set` builtin generic (P1.7b slice A) ---
	//
	// The hash-table twin of the `Array` section above: `Set` is a BUILTIN generic with one type parameter
	// `Element`, synthesized rather than declared, so its instances (`Set with Int`) intern like any other but
	// have no base `StructLayout`. The same three query doors an `Array` instance special-cases — box size,
	// per-instance drop, the managed-field gate — special-case a `Set` instance here (its box is the fixed
	// `SetRecordBytes` fused record, and it drops through `__set_decref`).

	// Is `name` the builtin `Set` type — the base of every set instance.
	export function isSetBaseName(name ByteArray) returns bool
		return name.equals(SetBuiltinBaseName)
	end 'isSetBaseName'

	// Is generic instance `id` a `Set with T`? (Reads the base NAME, which needs no base struct.)
	export function isSetInstance(id GenericInstanceId) returns bool
		return self.isSetBaseName(self.genericInstanceBaseName(id))
	end 'isSetInstance'

	// The KEY type of `Set with T` — its sole type argument, in this index's own interner. The `Set` twin of
	// `arrayElementType`.
	export function setKeyType(id GenericInstanceId) returns MaxonType
		let args = self.genericInstances.instanceArgs(id)
		return try args.get(0) otherwise panic("ProgramSignatures.setKeyType: `Set` instance {id} has no type argument — arity (1) was checked at instantiation")
	end 'setKeyType'

	// Is `Set with T`'s key itself managed (String at this slice) — the boundary a managed-key set needs the
	// per-key destroy walk for (P1.7b). A trivial key (int / ranged-int) is stored inline and owns nothing. The
	// `Set` twin of `arrayElementIsManaged`, reading the SAME `typeIsManaged` boundary the drop cascade decides on.
	export function setKeyIsManaged(id GenericInstanceId) returns bool
		return self.typeIsManaged(self.setKeyType(id), from: self.typeNames)
	end 'setKeyIsManaged'

	// The key DESTRUCTOR callee for a managed-key `Set with T` (P1.7b) — the runtime entry the set's teardown /
	// dup-drop / remove-drop calls on each vacated key: a String → `__str_decref`. Routed through the SHARED
	// `managedFieldDropCallee` over the key type, so the stamped key destructor equals the drop callee a managed
	// FIELD of the same type gets — the moved-in key and the dropped key agree by construction. The `Set` twin of
	// `arrayElementDropCallee`. Precondition: `setKeyIsManaged`.
	export function setKeyDropCallee(id GenericInstanceId) returns ByteArray
		return managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: self.setKeyType(id))
	end 'setKeyDropCallee'

	// Is `Array with T`'s element itself managed (String / struct / boxed union / nested array) — the
	// slice-1 boundary: a managed-element array needs the element-destroy walk (P1.7 slice 3) and is
	// rejected with a clean E2015 until then. A trivial element (int / Byte / ranged-int / bool) is stored
	// inline and owns nothing.
	export function arrayElementIsManaged(id GenericInstanceId) returns bool
		return self.typeIsManaged(self.arrayElementType(id), from: self.typeNames)
	end 'arrayElementIsManaged'

	// Is `Array with T`'s element an OPAQUE TYPE PARAMETER — a `T` from an enclosing generic type's shared body
	// (`type W uses T { var xs as Array with T }`), NOT a concrete type (P1.7 slice 3a). A concrete managed
	// element knows its destructor at the construction site (the `funcAddr` stamp into `element_destroy@40`); an
	// opaque `T` does not — its element destructor lives in the layout descriptor's `destroyFunc@40`, reached
	// through the rdata reloc path, which is slice 3b. Rejected with a positioned E2015 until then.
	export function arrayElementIsOpaque(id GenericInstanceId) returns bool
		return maxonTypeTag(self.arrayElementType(id)) == ValueTypeTag.typeParameter
	end 'arrayElementIsOpaque'

	// The element type's name AS A DIAGNOSTIC PRINTS IT (`Slot`, `String`) — for the one message that has to
	// say WHICH element type it is refusing (E3106, `Parser.requireArrayResizeHasZeroElement`). It lives here
	// because `typeNames` is this index's own interner and is not the parser's to reach into; the parser holds
	// a per-FILE interner, and an element type id from `arrayElementType` belongs to this one.
	export function arrayElementDisplayName(id GenericInstanceId) returns String
		return maxonTypeName(self.arrayElementType(id), typeNames: self.typeNames)
	end 'arrayElementDisplayName'

	// ⭐ **THE SOLE PRODUCER OF `element_size@24`** — the number every `__arr_create` is stamped with, every
	// array helper strides by at run time, and every same-shape check compares. A MANAGED element (String /
	// struct / union / instance / nested Array) is a heap box stored as an 8-byte POINTER
	// (`ManagedArrayElementBytes`), so its slot is the pointer, NOT the element's full logical size — the
	// drop walk destroys the pointer, the accessors load/store it. A TRIVIAL element is stored inline, at
	// the width `trivialElementStorageBytes` gives it.
	//
	// ⚠ **IT IS NOT THE SOURCE `sizeof`, AND NO LONGER ROUTES THROUGH THE LOGICAL-SIZE DOOR.** Both of the
	// storage rules above diverge from `sizeof`: a `String` element's slot is 8 where its `sizeof` is the
	// 48-byte record, and a `Byte` element's slot is 1 where `sizeof(Byte)` is a machine word. Sharing one
	// door forced one answer on two questions — see `typeLogicalByteSize`, which is the other.
	export function arrayElementSize(id GenericInstanceId) returns ByteOffset
		if self.arrayElementIsManaged(id) 'managed'
			return ManagedArrayElementBytes
		end 'managed'

		return self.trivialElementStorageBytes(self.arrayElementType(id))
	end 'arrayElementSize'

	// ⭐ **THE ONE PLACE A RANGED ALIAS'S DECLARED BOUNDS BECOME A STORAGE WIDTH.** A trivial element is
	// stored INLINE, so its slot is as wide as its values need and no wider: a `named` element is a ranged-
	// int alias sized by the width that holds every file's declaration of the name
	// (`RangedAliasRegistry.storageBytesInEveryFile`), and every other trivial tag is its
	// `primitiveTypeByteSize` (`integer`/`float` 8, `boolean` 1, `ExitCode` 4).
	//
	// A trivial element is never a struct or a generic instance — every aggregate is a managed box, caught
	// by the `arrayElementIsManaged` arm above — so this has no aggregate arms to carry and needs no
	// interner walk past the element's own name.
	//
	// ⚠ A `named` element that the registry MISSES is not one case but two, and they do not share an answer
	// — `undeclaredNamedElementStorageBytes` is where that split is written down. An enum keeps the machine
	// word; the byte-string literal's own `Array with Byte` is one byte.
	function trivialElementStorageBytes(t MaxonType) returns ByteOffset
		let tag = maxonTypeTag(t)
		if tag != ValueTypeTag.named 'notAName'
			return primitiveTypeByteSize(tag)
		end 'notAName'

		let name = self.nameOfId(typeNameIdOf(t))
		return try self.typeAliases.storageBytesInEveryFile(name) otherwise undeclaredNamedElementStorageBytes(name)
	end 'trivialElementStorageBytes'

	// The element DESTRUCTOR callee for a managed-element `Array with T` (P1.7 slice 3) — the runtime entry the
	// drop walk calls on each live slot: a String → `__str_decref`, a struct/union that owns managed heap → its
	// `__destruct_<T>` (a scalar-only struct/union box → the trivial `__mm_decref`), a nested Array → `__arr_decref`.
	// Routed through the SHARED `managedFieldDropCallee` over the element type, so the stamped element destructor
	// equals the drop callee any managed FIELD of the same type gets — the moved-in set and the dropped set agree
	// by construction. Precondition: `arrayElementIsManaged`.
	export function arrayElementDropCallee(id GenericInstanceId) returns ByteArray
		return managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: self.arrayElementType(id))
	end 'arrayElementDropCallee'

	// ⭐ **WHAT `element_destroy@40` IS STAMPED WITH for `Array with T`, as a DESCRIPTION** — what a top-level
	// array global's record carries to `ModuleInit`, which has no `ProgramSignatures` to ask (P1.7 slice 2b).
	// It composes the same two accessors `Parser.arrayElementDestroyValue` does, off the same
	// `arrayElementIsManaged` decision, so the destructor a global's record is stamped with equals the one a
	// body's literal of the same instance gets. It is asked ONCE PER MANAGED GLOBAL, which is why it may box
	// a union where the parser's per-SITE emitter deliberately does not.
	function arrayElementDestroy(id GenericInstanceId) returns ArrayElementDestroy
		if self.arrayElementIsManaged(id) 'managed'
			return ArrayElementDestroy.drop(self.arrayElementDropCallee(id))
		end 'managed'

		return ArrayElementDestroy.trivial
	end 'arrayElementDestroy'

	// The element CLONE strategy for a managed-element `Array with T` (P1.7 slice 3b-vi-b) — the DUAL of
	// `arrayElementDropCallee`. The front end stamps `funcAddr(<the direct callee>)` into the `_managed`
	// array-copy call, exactly as it stamps `funcAddr(<the drop callee>)` into `element_destroy@40`. Routed
	// through the SAME `managedFieldCloneStrategy` a managed FIELD of the element's type uses, so the element's
	// clone matches its own field-clone by construction. Precondition: `arrayElementSupportsDeepClone`, which
	// guarantees the result is `direct` (an element cloner is invoked through `callIndirect`, a `(box) -> box`
	// shape a `managedArray`/`unsupported` strategy cannot satisfy).
	export function arrayElementCloneStrategy(id GenericInstanceId) returns ManagedCloneStrategy
		return managedFieldCloneStrategy(self, typeNames: self.typeNames, fieldType: self.arrayElementType(id))
	end 'arrayElementCloneStrategy'

	// ⭐ **THE `<Base> with integer` INSTANCE FOR AN INFERRED-INT LITERAL CONSTRUCTION.** A bare `[…]` int-array
	// literal (`baseName` = `Array`, P1.7 slice 1) and a `Set from [ints]` construction (`baseName` = `Set`,
	// P1.7b slice B) both infer their `integer` element from the literal, so neither has a typealias to intern
	// its instance from. The SWEEP interns the one well-known instance for its base whenever a file's tokens
	// contain the construct (`Parser.foldDeclaredSignaturesInto`: a `[` for the array, a `Set from` for the set),
	// and the parser reads the same giid back at construction time. Interning is IDEMPOTENT — `TypeNameInterner.intern`
	// and `GenericInstanceRegistry.intern` both return the existing entry without mutating when present — so the
	// sweep's call is the WRITE and every parser call is a pure READ (the instance is always interned before any
	// file is parsed, which keeps a per-file parse from being the first to mutate the shared registry). At this
	// slice the elements are all integer (a non-integer element is a later slice, rejected E2015), so one instance
	// per base suffices. The `integer` element canonicalizes to the `int` conformer (`conformerTypeArgName`), so
	// the witnesses are `__witness_int.*`. It is deliberately NOT folded into the content hash: a file gaining the
	// construct re-parses on its OWN bytes, and no OTHER file's meaning depends on this shared, deterministic instance.
	export function internBuiltinIntegerInstance(baseName ByteArray) returns GenericInstanceId
		return self.genericInstances.intern(self.typeNames.intern(baseName), args: singletonInteger())
	end 'internBuiltinIntegerInstance'

	// ⭐ **THE `Array with Byte` INSTANCE FOR A `b"…"` BYTE-STRING LITERAL (P1.7 slice 2).** A byte-string
	// literal has no typealias to intern from (`b"hi"` names no type), so — like the `[…]` int-array literal
	// above — the SWEEP interns this ONE well-known instance whenever a file's tokens contain a byte-string
	// literal (`Parser.foldDeclaredSignaturesInto`), and the parser reads the giid back at literal time.
	// Interning is IDEMPOTENT, so the sweep is the WRITE and every parser call a pure READ. The element is
	// `named("Byte")` — the SAME reference a user `typealias ByteArray = Array with Byte` interns, so a
	// byte-string and a `ByteArray`-typed value share one gid and are type-identical.
	// ⚠ MEMOIZED — see `arrayByteInstance` for why the answer is stable and why the flag is a flag rather
	// than a sentinel. The first ask is still the WRITE that mints the instance, so the registry contents
	// (and every id derived from them) are exactly what they were before the memo existed.
	export function internArrayByteInstance() returns GenericInstanceId
		if self.arrayByteInstanceComputed 'alreadyMinted'
			return self.arrayByteInstance
		end 'alreadyMinted'

		var args = MaxonTypeArray.create()
		args.push(MaxonType.named(self.typeNames.intern(ByteElementTypeName)))
		self.arrayByteInstance = self.genericInstances.intern(self.typeNames.intern(ArrayBuiltinBaseName), args: args)
		self.arrayByteInstanceComputed = true
		return self.arrayByteInstance
	end 'internArrayByteInstance'

	// ⭐ **THE `__ManagedMemory` INSTANCE A STRING'S BYTE VIEW WEARS (BATCH2 slice 1).**
	// `internArrayByteInstance`'s twin, differing only in its element — see `StringByteViewElementName` for
	// why a compiler-owned element rather than `Byte`, and for the measurement that chose it. Not memoized
	// like its twin: this one is asked once per `addressableBytes()` in stdlib source (four sites in the
	// whole corpus), never on a hot parser path.
	export function internStringByteViewInstance() returns GenericInstanceId
		var args = MaxonTypeArray.create()
		args.push(MaxonType.named(self.typeNames.intern(StringByteViewElementName)))
		return self.genericInstances.intern(self.typeNames.intern(ArrayBuiltinBaseName), args: args)
	end 'internStringByteViewInstance'

	// ⭐⭐ **WHICH `Array` INSTANCE A `__ManagedMemory.create(count, elementSize)` YIELDS (R4.4)** — the one
	// place the raw `elementSize` the source writes becomes a STATIC element type, and the reason it has to:
	// `mm.get(0)` and `mm.set(0, value: 300)` are typed off the instance's element, so `300` fits at element
	// size 8 and does not at 1 (`specs/managed-memory-builtin.md:setlength-then-get` writes exactly that).
	// Under R4.2's byte-only binding that program was WRONGLY REJECTED.
	//
	// ⚠ **THE SPLIT IS `1 ⇒ Byte, ANYTHING ELSE ⇒ WORD`, WHICH IS v1's RULE VERBATIM** — its own layout comment
	// says so of the field this size lands in: *"element_size i64 (sizeof(Element); 1 for Byte, 8 otherwise)"*
	// (`Compiler/Runtime/runtime.std:4262`). It is the same two-way answer `trivialElementStorageBytes` already
	// gives for every element type shv2 has: byte-PACKED, or a machine WORD (which is also every managed
	// element's pointer, `ManagedArrayElementBytes`).
	//
	// ⚠ **IT DELIBERATELY REFUSES NOTHING, INCLUDING A NON-POSITIVE SIZE.** `managed-memory-methods`'s
	// `managed-memory-error-variants` requires `__ManagedMemory.create(4, 0)` to COMPILE and report
	// `invalidAllocation` at RUN TIME — the buffer's own guard (`__arr_mem_create`) is where a size the
	// allocator cannot use is caught, and hoisting that into a parse-time refusal would turn a case the corpus
	// pins as a caught throw into a compile error. Which instance a doomed `create` was typed as is unobservable.
	//
	// ⚠⚠ **PRECONDITION: `managedMemoryElementSizeIsTypeable`.** It has no arm for a width shv2 has no element
	// type of, because there is no honest one — see that predicate for the wrong answer the missing `else`
	// used to give.
	export function managedMemoryInstanceForElementSize(elementSize ParsedInt) returns GenericInstanceId
		if elementSize == ByteStringElementSize 'bytePacked'
			return self.internArrayByteInstance()
		end 'bytePacked'

		return self.internBuiltinIntegerInstance(ArrayBuiltinBaseName)
	end 'managedMemoryInstanceForElementSize'

	// ⭐⭐ **CAN shv2 GIVE A BUFFER OF THIS ELEMENT WIDTH A TYPE AT ALL? (R4.4 review.)** The gate the answer
	// above needs in front of it, reading the same two constants so the ACCEPTED set and the MAPPED set cannot
	// come to differ.
	//
	// ⚠ **A WIDTH WITH NO ELEMENT TYPE IS A SILENT WRONG ANSWER, NOT A ROUNDING, AND IT WAS MEASURED.** The
	// front end types `get`/`set` off the INSTANCE while the runtime strides by the record's `element_size@24`,
	// so a `create(4, elementSize: 4)` — typed as the machine-WORD instance, because that was the whole `else`
	// — accepted `mm.set(0, value: 5000000000)` against `int`'s range and stored four bytes of it:
	// `mm.get(0)` read back **705032704**. The two facts about one buffer disagreed, quietly, at run time.
	// R4.2 had no such hole only because it typed every buffer as bytes, so that program was refused by the
	// element's range.
	// ⇒ shv2 has exactly TWO trivial element widths (`trivialElementStorageBytes`: byte-PACKED or a machine
	// WORD), so those are the two a source `elementSize` may name. The reference can carry others because its
	// `__ManagedMemory with Element` names a real 2- or 4-byte type shv2 does not have — the gap is an element
	// TYPE, and a diagnostic saying so is the honest answer until one exists.
	//
	// ⚠ A NON-POSITIVE size is admitted, for the reason above: `create(4, 0)` must compile and throw
	// `invalidAllocation` at run time, and which instance a doomed `create` wore is unobservable.
	export function managedMemoryElementSizeIsTypeable(elementSize ParsedInt) returns bool
		return elementSize <= ByteStringElementSize or elementSize == ManagedMemoryWordElementSize
	end 'managedMemoryElementSizeIsTypeable'

	// ⭐ **THE `Array with String` / `Array with <aggregate>` INSTANCES FOR A MANAGED-ELEMENT LITERAL (P1.7
	// slice 3).** A bare `["a","b"]` / `[p1,p2]` has no typealias to intern from, and — unlike the int/Byte
	// literals above — its element type is not fixed by the token, so the SWEEP over-interns the possible
	// element instances (`internArrayLiteralAggregateInstances`) and the parser looks up whichever the first
	// element resolves to. Both are keyed the way a `typealias Array with T` interns its arg (a String as
	// `MaxonType.string`, a struct/union by `named(<name>)`), so a literal and a typealias-backed value of the
	// same element type share ONE gid. Idempotent, so the sweep is the WRITE and the parser a pure READ.
	export function arrayInstanceForString() returns GenericInstanceId
		var args = MaxonTypeArray.create()
		args.push(MaxonType.string)
		return self.genericInstances.intern(self.typeNames.intern(ArrayBuiltinBaseName), args: args)
	end 'arrayInstanceForString'

	// The `Set with String` instance for a `Set from ["…"]` construction (P1.7b) — the `Set` twin of
	// `arrayInstanceForString`. A `Set from [strings]` has no typealias to intern from and its key type is not
	// fixed by a token, so the SWEEP over-interns it (alongside `Set with integer`) and the parser reads back
	// whichever the source array's element resolves to. Keyed as `MaxonType.string` — the SAME arg a
	// `typealias Set with String` interns and a `["…"]` literal shares — so a from-built set and a `.create()`d
	// one of the same key type share ONE gid. Idempotent, so the sweep is the WRITE and the parser a pure READ.
	export function setInstanceForString() returns GenericInstanceId
		var args = MaxonTypeArray.create()
		args.push(MaxonType.string)
		return self.genericInstances.intern(self.typeNames.intern(SetBuiltinBaseName), args: args)
	end 'setInstanceForString'

	// ⭐⭐ **THE ELEMENT ARG MUST CARRY THE TAG A TYPE REFERENCE TO THAT NAME CARRIES**, because the
	// instance registry keys on `(tag, id)` while `mangleGenericInstance` reads only the NAME. Two tags for
	// one type therefore intern as TWO instances that compile to ONE symbol — which
	// `checkTypeSymbolNamespace` reports as `E3006 duplicate definition of 'Array_<T>'`, naming a
	// `typealias` the author wrote exactly once.
	//
	// A declared struct/union is `named` — that is what `Array with Item`'s alias arg is, which is why a
	// `[<Item>…]` literal and `ItemArray` have always been one type. A synthesized TUPLE is `structRef`:
	// `Parser.parseTypeReference` mints a tuple type that way at every spelling (`(Num, Num)`, and a tuple
	// `typealias` through `tupleAliasTarget`), so `named` here would be a SECOND spelling of one type with
	// nothing to make the two agree. MEASURED: `typealias PairArray = Array with Pair` plus any
	// `[<identifier>…]` literal in the program was rejected with that spurious E3006 (P1.10 review).
	export function arrayInstanceForNamedElement(name ByteArray) returns GenericInstanceId
		let elementId = self.typeNames.intern(name)
		var args = MaxonTypeArray.create()
		args.push(MaxonType.structRef(elementId) if isTupleTypeName(name) else MaxonType.named(elementId))
		return self.genericInstances.intern(self.typeNames.intern(ArrayBuiltinBaseName), args: args)
	end 'arrayInstanceForNamedElement'

	// Over-intern `Array with <T>` for the possible element types of a `[<identifier>…]` array literal (P1.7
	// slice 3): a local identifier's type is unknowable from the sweep's tokens, so `Array with String` and one
	// instance per declared struct/union are interned, and the parser looks up whichever the first element
	// resolves to. An UNREFERENCED instance gets no descriptor or destructor synthesized (both gate on usage),
	// so this is bounded registry entries — not codegen — and it leaves int-only-array programs' goldens untouched.
	// ⚠ **CALLED ONCE, AFTER THE LAST FILE FOLDS — NOT PER FILE, and that is a MEASURED asymptotic and not a
	// tidy-up.** The struct/union tables ACCUMULATE across the sweep, so a walk placed at each
	// `[<identifier>…]`-bearing file re-walks every type folded so far, at every such file: **O(files × types)**.
	// A dedup set used to sit inside the walk, which made the *interning* O(types) — but not the WALK, whose
	// per-entry cost (a `MapIterator` entry tuple, a set probe) is paid whether or not the name is new. The
	// early-out that guarded it was a count-equality that any freshly folded type defeats, so the common shape
	// — every file declaring a type AND using an array literal — defeated it at every file.
	//
	// ⇒ MEASURED, on 64→1024 files each declaring one `type S<k>` and holding one `[<identifier>…]` literal:
	//   `phase signatures` allocations went **×2.16, ×2.38, ×2.68, ×3.03** per DOUBLING (exact column, so this
	//   is not noise), against ×1.99 flat for the same files with no declared type. Hoisted here it reads
	//   ×1.99 flat. The tuple rung (P1.10) did not introduce this — it added a SECOND producer of registered
	//   types, since a tuple layout is registered under a mangled name — but it is what the ladder found it with.
	//
	// ⚠ **THE HOIST IS SAFE, BUT IT IS NOT AN IDENTITY — IT CHANGES TWO THINGS, AND EACH HAS ITS OWN REASON
	// FOR BEING HARMLESS** (audited P1.10 review; the claim here previously read "interns the identical SET",
	// which is the one thing it does NOT do):
	//
	//   • **THE SET GROWS.** Placed inside the sweep, the walk could only see the types folded SO FAR, so a
	//     struct/union declared in a file AFTER the last `[<identifier>…]`-bearing one was never over-interned
	//     at all. One final walk sees the whole program. The extra rows are registry entries and nothing more —
	//     a descriptor and a destructor are both synthesized on USAGE, and an over-interned instance nobody
	//     names has none — so the growth is bounded bookkeeping and reaches no emitted byte.
	//   • **THE GIDS MOVE.** A gid is intern ORDER, and these interns now all happen after the last file folds
	//     instead of interleaved with it, so every over-interned instance's gid shifts. Nothing DERIVES from a
	//     gid's numeric value — `mangleGenericInstance` is structural (base name + arg manglings) precisely so
	//     that a symbol is stable across cold and warm builds — and the one reader that walks the registry in
	//     gid order (`ParseStaging.checkTypeSymbolNamespace`) uses it only to decide which of a COLLIDING pair
	//     is blamed as the newcomer. VERIFIED rather than argued: the full suite regenerates every
	//     `specs-shv2/fragments/` golden and not one of the 2,372 pre-existing ones moved a byte.
	//
	// What the hoist does rest on is that nothing between the sweep's last fold and this call READS a generic
	// instance — the sweep only records — so no reader can observe the difference between "interned early" and
	// "interned here".
	export function internArrayLiteralAggregateInstances()
		if not self.sawAggregateArrayLiteral 'noAggregateLiteralAnywhere'
			return
		end 'noAggregateLiteralAnywhere'

		_ = self.arrayInstanceForString()
		for (name, _) in self.structTypes 'eachStruct'
			_ = self.arrayInstanceForNamedElement(name)
		end 'eachStruct'
		for (name, _) in self.enumTypes 'eachUnion'
			_ = self.arrayInstanceForNamedElement(name)
		end 'eachUnion'
	end 'internArrayLiteralAggregateInstances'

	// This file materializes a `[<identifier>…]` array literal, whose element type the sweep's tokens cannot
	// name. All the sweep does is remember that SOMETHING asked; the over-interning itself waits for the whole
	// program (see `internArrayLiteralAggregateInstances`).
	export function noteAggregateArrayLiteral()
		self.sawAggregateArrayLiteral = true
	end 'noteAggregateArrayLiteral'

	// --- Layout-descriptor sizing (P1.6-B1) ---
	//
	// The box byteSize of a concrete generic instance — its BASE struct's own layout (`Box with Integer`
	// has `Box`'s box), or the fixed 48-byte record for an `Array` (which has no base struct). At this slice
	// a `T` field is an opaque 8-byte slot like any other, so no argument is substituted into the layout and
	// the base struct's `sizeBytes` IS the instance's box size. This is the descriptor's `size@0` field, and
	// the interner-owning door lowering computes it through.
	export function genericInstanceBoxSize(id GenericInstanceId) returns ByteOffset
		if self.isArrayInstance(id) 'array'
			return ArrRecordBytes as ByteOffset
		end 'array'
		// A `Set` instance's box is the fixed fused hash-table record (P1.7b slice A), no base struct — the
		// `Array` twin above.
		if self.isSetInstance(id) 'set'
			return SetRecordBytes as ByteOffset
		end 'set'
		match self.structOf(self.genericInstanceBaseName(id)) 'base'
			declared(layout) then return layout.sizeBytes()
			undeclared then panic("genericInstanceBoxSize: generic instance {id}'s base '{String.from(self.genericInstanceBaseName(id))}' is neither a builtin nor a declared struct, so it has no box — every caller opens with genericInstanceBaseIsKnown")
		end 'base'
	end 'genericInstanceBoxSize'

	// The full source-level `sizeof` of a single-type-parameter instance's ONE type argument — the
	// descriptor's `elementLogicalSize@56`, which `sizeof(T)` reads. `Sizer with bool` ⇒ 1; `Sizer with
	// Pair` (Pair is two Integers) ⇒ 16.
	//
	// ⚠ **SINGLE type argument only** (B1). A multi-parameter generic needs per-argument logical sizes,
	// which a single-slot descriptor cannot carry — `parseSizeof` rejects `sizeof` of a multi-parameter
	// generic's type parameter (a clean E2015), so a call site never asks this of one.
	export function genericInstanceSoleArgLogicalSize(id GenericInstanceId) returns ByteOffset
		let args = self.genericInstances.instanceArgs(id)
		if args.count() != 1 'notSingle'
			panic("genericInstanceSoleArgLogicalSize: instance {id} has {args.count()} type arguments — the B1 layout descriptor carries a single element size; parseSizeof rejects sizeof(T) on a multi-parameter generic before a descriptor is asked for")
		end 'notSingle'
		return self.typeLogicalByteSize(try args.get(0) otherwise panic("genericInstanceSoleArgLogicalSize: instanceArgs.get(0) failed despite count == 1"))
	end 'genericInstanceSoleArgLogicalSize'

	// The full source-level byte size of a type argument, resolved against THIS index's own interner. A
	// declared struct (stored `named` by the sweep, which does not resolve `structRef`) is its full box; a
	// nested generic instance is its base box; a `named` that is not a struct is a ranged alias (a machine
	// word); every other type is its `primitiveTypeByteSize`.
	//
	// ⚠ **THIS IS THE LOGICAL SIZE — `elementLogicalSize@56`, what `sizeof(T)` reads inside a shared
	// generic body — and it is NOT the array element STRIDE.** A ranged alias is a machine word here even
	// where `arrayElementSize` strides it in one byte, because the two answer different questions and the
	// descriptor header says so (`elementSize@16` vs `elementLogicalSize@56`, "DISTINCT and must stay so").
	// It must keep agreeing with the parser's concrete fold, `Parser.concreteSizeofBytes`, which sizes an
	// already-RESOLVED type and so cannot see an alias's bounds at all: narrowing here and not there made
	// `sizeof(T)` for `Sizer with Byte` answer 1 while `sizeof(Byte)` in the same program answered 8.
	function typeLogicalByteSize(t MaxonType) returns ByteOffset
		let tag = maxonTypeTag(t)
		if tag == ValueTypeTag.named or tag == ValueTypeTag.structRef 'namedOrStruct'
			match self.structOf(self.nameOfId(typeNameIdOf(t))) 'lookup'
				declared(layout) then return layout.sizeBytes()
				undeclared then return primitiveTypeByteSize(tag)
			end 'lookup'
		end 'namedOrStruct'
		if tag == ValueTypeTag.genericInstance 'nested'
			return self.genericInstanceBoxSize(typeNameIdOf(t))
		end 'nested'
		return primitiveTypeByteSize(tag)
	end 'typeLogicalByteSize'

	// A structural, BUILD-STABLE mangling of a type argument for a descriptor's `.rdata` label —
	// `bool` ⇒ "bool", a declared `Pair` ⇒ "Pair", a nested `Box with Integer` ⇒ "Box_Integer". It is
	// derived from the argument's STRUCTURE (base name + args), never from a gid number, so the label is
	// identical across cold and warm builds (a gid's numeric value is a build-order artifact).
	export function mangleTypeArg(t MaxonType) returns String
		let tag = maxonTypeTag(t)
		if tag == ValueTypeTag.named or tag == ValueTypeTag.structRef 'namedOrStruct'
			return String.from(self.nameOfId(typeNameIdOf(t)))
		end 'namedOrStruct'
		if tag == ValueTypeTag.genericInstance 'nested'
			return String.from(self.mangleGenericInstance(typeNameIdOf(t)))
		end 'nested'
		// An OPAQUE type-parameter argument (`Array with T` inside a generic body, P1.7 slice 3b-i) — its
		// instance `Array with typeParameter(pos)` is interned like any other, so its structural mangling names
		// the parameter by POSITION (`T0`), stable across cold and warm builds (a position is source-derived).
		// It is only ever a LOOKUP key (the opaque array never gets a synthesized `__destruct_<mangled>` nor its
		// own descriptor — it drops through `__arr_decref` and reads the enclosing instance's descriptor), so
		// this spelling need only be distinct and stable; unlike a concrete arg it names no emitted symbol.
		if tag == ValueTypeTag.typeParameter 'opaqueParam'
			return "T{typeNameIdOf(t)}"
		end 'opaqueParam'
		return primitiveTypeTagName(tag)
	end 'mangleTypeArg'

	// ⭐ **THE CANONICAL CONFORMER NAME OF A TYPE ARGUMENT (P1.7a slice 2b).** A ranged int/float alias
	// (`Integer` = `int(0 to u32.max)`) collapses to its underlying primitive name (`int`) — the name its
	// INTRINSIC conformance (`int` implements `Hashable`/`Equatable`) and its witness table (`__witness_int.*`
	// → the synthesized `int.hash`/`int.equals` impls) are keyed by; a struct/String keeps its own name. The
	// ONE reducer shared by the E3017 where-constraint check (`typeConformsTo`) and witness-table
	// materialization (`materializeWitnessArg`), so the conformance lookup, the table label, and the impl
	// symbol cannot disagree on whether a `Box with Integer` conforms via `int`. Distinct from
	// `instanceArgTypeName`, which keeps the SOURCE spelling (`Integer`) for the E3017 MESSAGE — this
	// canonicalizes only the identity the comparison rests on, exactly as `ConformanceCheck.canonicalTypeName`
	// does for a method-signature type name.
	export function conformerTypeArgName(gid GenericInstanceId, position TypeParamId) returns String
		return self.mangleTypeArg(self.canonicalizeRangedAlias(self.substitutedInstanceArg(gid, position: position)))
	end 'conformerTypeArgName'

	// A ranged numeric alias resolves to its underlying primitive `MaxonType` (`int(0 to u32.max)` -> `integer`),
	// exactly as `resolveNamedType` does (`alias.underlying`, range dropped); every other type passes through.
	// The one step that lets `conformerTypeArgName` name a primitive-bound argument by its primitive.
	//
	// ⚠ Bare-name for `classifyUnionPayload`'s reason: the file that governs a generic INSTANCE's type
	// argument is the one that wrote the instantiation, and a `GenericInstanceId` does not carry it.
	// Only `underlying` is reachable through that door, never the range.
	function canonicalizeRangedAlias(t MaxonType) returns MaxonType
		if maxonTypeTag(t) == ValueTypeTag.named 'named'
			if let underlying = try self.aliasUnderlyingInAnyFile(self.nameOfId(typeNameIdOf(t))) 'rangedAlias'
				return underlying
			end 'rangedAlias'
		end 'named'
		return t
	end 'canonicalizeRangedAlias'

	// The structural mangling of a generic instance itself — `Box_Integer` for `Box with Integer` — the
	// base name joined to each argument's mangling. Shared by `mangleTypeArg` (a nested-instance argument)
	// and lowering's descriptor-label builder.
	//
	// ⚠ **DERIVED ONCE PER INSTANCE, AND THAT IS NOT A CONSTANT-FACTOR TIDY-UP** — the derivation is
	// RECURSIVE through `mangleTypeArg`'s nested arm, so re-deriving on every ask was quadratic in
	// nesting depth. `CompiledInstanceNameMap` carries the measurement.
	//
	// Returns the `ByteArray` six of the eight callers want (a symbol name is bytes, and each of those six
	// used to convert on the spot); the two that want a `String` say so. It hands back the memo's own
	// handle, so an ask costs a retain rather than a rebuild — safe because every consumer either READS it
	// (a map key, a `Set.contains` probe) or builds a NEW string around it (`destructorSymbol`,
	// `String.from`), and none writes through it.
	//
	// ⭐⭐ **AND IT IS WHERE A CONTESTED NAME IS MOVED INTO THE RESERVED SPACE — AT THE SOLE PRODUCER, NOT
	// AT A LATER CHECK.** See `reservedIfDeclared`. Deriving the final name HERE is what lets every
	// consumer be a pure read: the PARSER is one of them (`decrefCalleeFor` bakes
	// `__destruct_<mangled>` into an emitted drop call), so a name revised after the parse would leave
	// `main` calling a symbol the destructor synthesis no longer emits.
	export function mangleGenericInstance(id GenericInstanceId) returns ByteArray
		if let derived = try self.compiledInstanceNames.get(id) 'alreadyDerived'
			return derived
		end 'alreadyDerived'

		var out = String.from(self.genericInstanceBaseName(id))
		for arg in self.genericInstances.instanceArgs(id) 'eachArg'
			out.append("_")
			out.append(self.mangleTypeArg(arg))
		end 'eachArg'

		let name = self.reservedIfDeclared(out.toByteArray())
		self.compiledInstanceNames.upsert(id, value: name)
		return name
	end 'mangleGenericInstance'

	// ⭐⭐ **RESERVED-SPACE DISJOINTNESS: A COMPILED INSTANCE NAME A DECLARATION ALSO CLAIMS IS MINTED
	// BEHIND `__` INSTEAD (P1.7).**
	//
	// An instantiation has no source name, so the compiler builds one, and every per-type symbol the
	// backend emits is derived from that string — `__destruct_<name>`, `__layout_<name>`. A declared
	// `type Box_String` derives ITS symbols from the identical string, so `Box with String` and
	// `type Box_String` minted one `__destruct_Box_String` twice and the later install won: a LEAK when
	// the loser owned a field the winner does not drop, a SILENT SUCCESS when the two layouts happened to
	// agree. That was reported as E3006 — which made a program the language permits (a legal type name,
	// plus an instantiation the author may never have written: a bare `[Foo…]` literal interns
	// `Array with Foo`) fail to compile, naming an instantiation that appears nowhere in the source.
	//
	// `__` is ALREADY reserved — `E2051` refuses to DECLARE a name that starts with it — so a compiled
	// name minted behind it is one no declaration can hold, and the two halves of the namespace are
	// disjoint BY CONSTRUCTION rather than by a check. That is how the bootstrap has always spelled a
	// synthesized instance name (`__Array_Foo`, `maxon-sharp/Compiler/2-Parser.cs`), and why it needs no
	// declaration-vs-instance check at all.
	//
	// ⚠ **AND IT IS WHY NOTHING HERE PROBES THE INSTANCE SET.** A minted name has to be disjoint from
	// every OTHER instance's compiled name too, and that falls out of the same reservation instead of a
	// second probe: `mangleGenericInstance` joins BASE-FIRST, no base may start with `__`, so no BARE
	// compiled name ever does — and two minted names are equal only when the bare names behind them are,
	// which is the pair collision `checkTypeSymbolNamespace` already reports over the FINAL names. See
	// `ReservedTypeNamePrefix` for why a non-reserved prefix would break exactly this, and
	// `nested-contest-mints-onto-a-second-contested-name` for the case that pins it.
	//
	// ⚠ **ON CONTEST ONLY, WHICH IS A COST DECISION.** Prefixing unconditionally would move the mangled
	// symbol in 108 committed goldens across four targets, 45 of them on hosts that cannot be regenerated
	// here. Renaming only what was previously an ERROR moves no name that ever compiled, so every golden
	// stays byte-identical.
	//
	// ⚠ **RE-PROBED, NOT PREFIXED ONCE.** `__Box_String` could itself be declared, and the loop
	// TERMINATES because each pass makes the candidate strictly longer while the declaration set is
	// finite and fixed (the sweep is complete before any name is derived).
	//
	// Two instantiations that compile to ONE name are NOT cured by this and are not meant to be — `_` is a
	// legal name character, so the join is not injective (`Box with A_B` and `Box_A with B` both give
	// `Box_A_B`) and there is no declaration to move out of the way. That stays E3006, in
	// `checkTypeSymbolNamespace`.
	function reservedIfDeclared(bare ByteArray) returns ByteArray
		var name = bare
		while self.claimsCompiledTypeName(name) 'contested'
			name = "{String.from(ReservedTypeNamePrefix)}{String.from(name)}".toByteArray()
		end 'contested'
		return name
	end 'reservedIfDeclared'

	// ⭐ **DOES A DECLARATION ALREADY CLAIM THE COMPILED TYPE NAME `name`?** The declared half of the
	// compiled-name namespace, asked in ONE place: a `type` and an `enum`/`union` each mint
	// `__destruct_<name>` from their bare name (`installStructDestructors` / `installUnionDestructors`),
	// which is the identical string an instance's `__destruct_<mangled>` / `__layout_<mangled>` are built
	// from.
	//
	// ⚠ **AN `interface` AND A `typealias` ARE ABSENT, AND NEITHER IS AN OVERSIGHT.** Neither mints a
	// per-type symbol, so neither can collide with an instance and neither may displace one. An alias
	// mints nothing at all — an instance's methods are emitted under its BASE's name, which is why
	// `typealias Box_Integer = Box with Integer` is legal. An interface's only emitted artifact is
	// `__witness_<conformer>.<interface>`, whose head is the CONFORMER, so an `interface Box_String`
	// beside a `Box with String` shares no symbol with it (measured against the bootstrap oracle: it
	// builds and runs; shv2 used to refuse it with E3006).
	//
	// ⚠ **THE HEAD ARGUMENT ONLY EVER COVERED THE DECLARED HALF, WHICH IS THIS FUNCTION'S HALF, AND IT
	// STILL DOES.** It says nothing about one witness label against ANOTHER — and that half WAS broken,
	// silently: `_`-joined, `(A_B, C)` and `(A, B_C)` spelled one table. The cure is not a check here (a
	// witness table is minted during lowering, long after this sweep, and there is no declaration to move
	// aside) but the SEPARATOR — see `IrInterface.witnessTableLabel`. It also strengthens the claim above
	// by a second, independent route: a `.` occurs in no source identifier, hence in none of the `_`-joined
	// compiled instance names this function guards, so no witness label is spellable from the instance side
	// at all.
	// It reads THIS index's own registries and not `project.typeNameDecls`, because it is asked during
	// the signature sweep — before any file is parsed, which is the whole point (see
	// `mangleGenericInstance`). The two agree by construction for the kinds above: both are folded from
	// the same declarations, and a program whose sweep and parse disagree has a parse diagnostic and
	// fails the build regardless.
	function claimsCompiledTypeName(name ByteArray) returns bool
		return self.containsStruct(name) or self.containsEnum(name)
	end 'claimsCompiledTypeName'

	// ⭐⭐ **THE ONE CANONICAL TYPE IDENTITY OF A GENERIC INSTANCE (P1.7).** `mangleGenericInstance` names
	// the instance as it was INTERNED, and one type can be interned twice — `Box with N0` and
	// `Box with (Box with S0)` are the same type spelled two ways, and they compile to `Box_N0` and
	// `Box_Box_S0`. That duplicate is pre-existing and is its own rung; what must not be pre-existing is two
	// answers to "are these the same TYPE?", so every comparison site asks THIS, which resolves an
	// alias-named argument through the alias table and therefore gives both spellings ONE string.
	//
	// ⚠ **COMPARISON ONLY — it names nothing that is emitted.** The symbol names (`__destruct_<name>`,
	// `__layout_<name>`) and the E3006 compiled-name space keep asking `mangleGenericInstance`, so no
	// emitted byte moves. That separation is the whole reason this is a second function and a second memo
	// rather than a change to the first.
	// The EMPTY-path entry: the walk below memoizes every instance it names, so this only has to say that a
	// fresh ask starts with nothing open.
	export function canonicalInstanceName(id GenericInstanceId) returns ByteArray
		var path = GenericInstanceIdArray.create()
		return self.canonicalNameWithin(id, path: path)
	end 'canonicalInstanceName'

	// The recursive half, carrying the instances already open on this walk.
	//
	// ⚠ **THE PATH GUARD IS LOAD-BEARING, because this runs in the PARSER** — `aggregateNameOf` asks it, and
	// the parse completes before `checkGenericAliasCycles` (E3091) refuses a cyclic alias. Resolving alias
	// arguments is exactly what makes `typealias A = Box with A` a cycle here, where `mangleTypeArg` never
	// followed one. On revisit it falls back to the INTERNED name, which terminates and is deterministic;
	// the program is refused moments later by E3091 regardless, so the fallback's only job is to get there.
	//
	// ⚠⚠ **IT MEMOIZES AT EVERY LEVEL, AND THAT IS A CUBIC — NOT A TIDY-UP.** The first version consulted the
	// memo only at the outermost ask and recursed raw beneath it, so naming instance `i` of an alias CHAIN
	// re-walked the whole chain and appended a name of length O(i) at each level — O(i²) for one name, O(N³)
	// to name them all. MEASURED, A/B on a chain of N aliases each used to build a value: `semanticCheck` ran
	// 0.4 / 0.7 / 1.3 / 2.9 ms at N = 100/200/400/800 before the canonical namer existed (LINEAR) against
	// 12.3 / 53.5 / 303.8 / 1826.1 ms with it (x4.4, x5.7, x6.0 per doubling — rising), a 630x regression at
	// N=800 that widened with N. Memoizing here restores it: the chain is walked ONCE.
	//
	// A memo hit is the true canonical name whenever it matters. In an ACYCLIC graph the answer does not
	// depend on `path` at all, so a name derived under one walk is correct under every other. In a cyclic one
	// the guard can make a name path-dependent — but that program is refused by E3091 and emits nothing, and
	// `deriveInstanceNames` warms every instance in ascending id order before any check asks, so which walk
	// got there first is a property of the program rather than of the asking site.
	function canonicalNameWithin(id GenericInstanceId, path GenericInstanceIdArray) returns ByteArray
		for open in path 'eachOpen'
			if open == id 'cyclic'
				return self.mangleGenericInstance(id)
			end 'cyclic'
		end 'eachOpen'

		if let derived = try self.canonicalInstanceNames.get(id) 'alreadyDerived'
			return derived
		end 'alreadyDerived'

		path.push(id)
		var out = String.from(self.genericInstanceBaseName(id))
		for arg in self.genericInstances.instanceArgs(id) 'eachArg'
			out.append("_")
			out.append(self.canonicalTypeArgName(arg, path: path))
		end 'eachArg'
		_ = try path.pop() otherwise panic("canonicalNameWithin: path.pop on a path this call pushed to")

		let name = out.toByteArray()
		self.canonicalInstanceNames.upsert(id, value: name)
		return name
	end 'canonicalNameWithin'

	// One type argument in canonical form — `mangleTypeArg`'s comparison twin. It differs in exactly one arm:
	// a `named` leaf that names a generic-instance ALIAS becomes THAT instance's canonical name instead of
	// the alias's bare spelling, which is what collapses the two spellings of one type.
	function canonicalTypeArgName(t MaxonType, path GenericInstanceIdArray) returns String
		let tag = maxonTypeTag(t)
		if tag == ValueTypeTag.genericInstance 'nested'
			return String.from(self.canonicalNameWithin(typeNameIdOf(t), path: path))
		end 'nested'

		if tag == ValueTypeTag.named 'namedLeaf'
			let name = self.nameOfId(typeNameIdOf(t))
			if let aliased = try self.genericAliases.get(name) 'namesAnInstance'
				return String.from(self.canonicalNameWithin(aliased, path: path))
			end 'namesAnInstance'
			return String.from(name)
		end 'namedLeaf'

		return self.mangleTypeArg(t)
	end 'canonicalTypeArgName'

	// ⭐ **DERIVE EVERY SWEPT INSTANCE'S NAMES NOW, SO THE PARSE ONLY EVER READS THEM (P1.7).**
	//
	// `mangleGenericInstance` memoizes by WRITING into `compiledInstanceNames`, and the real parse became a
	// caller when a generic instance gained its nominal identity (`Parser.aggregateNameOf`). Every other
	// caller — ParseStaging's E3006 sweep, lowering's descriptor labels, the destructor cascade — runs after
	// parsing, single-threaded; the parser does NOT, and a per-file fan-out writing one shared memo is the
	// race the "a file's parse is a pure function of its inputs" invariant exists to prevent. Deriving the
	// whole set here, at the one point the sweep is complete, leaves the index READ-ONLY for the parse.
	//
	// ⚠ **BOTH NAMES, because there are two memos and the parse reads BOTH.** `canonicalInstanceName` arrived
	// with its own map and its own lazy write, and `aggregateNameOf` asks it on the same parse path — so
	// warming only the compiled name left exactly the hole this function exists to close, in silence, one
	// commit after it was closed. A memo the parse can write is the hazard; naming it in the comment above
	// while a second one sat un-warmed beside it is how one fact became two.
	//
	// ⚠ It warms the instances the SWEEP interned, which is exactly the set a parse can name. The builtin
	// instances minted later (`internArrayByteInstance`, `arrayInstanceForString`, …) still derive lazily on
	// first ask — they are interned during lowering, long after the last parse, so they are never contended.
	export function deriveInstanceNames()
		for id in 0 upto self.genericInstances.count() 'eachInstance'
			_ = self.mangleGenericInstance(id)
			_ = self.canonicalInstanceName(id)
		end 'eachInstance'
	end 'deriveInstanceNames'

	// ⭐ **THE NOMINAL IDENTITY OF INSTANCE `gid`'s TYPE ARGUMENT AT `position` (P1.7)** — what a parameter
	// declared with the bare type parameter `T` actually demands at a call made through this instance. It is
	// the third source of the aggregate name `namedAggregatesConflict` compares, beside the parser's
	// `aggregateNameOf` and SemanticCheck's `aggregateNameFor`, and it exists for the reason those two are
	// twins rather than one function: the name is resolved against a DIFFERENT interner — an instance's
	// argument types are interned HERE, not in the merged `project.typeNames`. The comparison RULE is still
	// the single shared one; only the extraction is local.
	//
	// `EmptySourceText` for a scalar, a `String`, a ranged alias or an opaque `typeParameter` argument: those
	// carry no nominal identity and meet their argument by TAG (`checkDeclaredType`), so a `Box with Integer`
	// keeps accepting a plain `int` literal.
	// ⚠ **EVERY TAG STATES ITS OWN ANSWER.** This used to end in a bare `return EmptySourceText`, and that
	// was a silent default landing on the ONE rule that reads empty as a positive claim:
	// `namedAggregatesConflict` treats exactly-one-empty as "an aggregate meeting a SCALAR", so an
	// unhandled kind did not abstain — it asserted `scalar` and REJECTED a legal program. A tag appended to
	// `ValueTypeTag` must now fail to compile here rather than inherit a wrong answer.
	export function instanceArgAggregateName(gid GenericInstanceId, position TypeParamId) returns ByteArray
		let arg = self.substitutedInstanceArg(gid, position: position)
		match maxonTypeTag(arg) 'k'
			// No nominal identity: a scalar, a `String`, an opaque `T` and a function value all coerce by
			// TAG (`checkDeclaredType`), so `Box with Integer` keeps accepting a plain `42`.
			boolean then return EmptySourceText
			integer then return EmptySourceText
			float then return EmptySourceText
			named then return self.namedTypeArgIdentity(arg)
			exitCode then return EmptySourceText
			unresolved then return EmptySourceText
			void then panic("instanceArgAggregateName: instance {gid}'s type argument at {position} is `void` — a type argument is a TYPE, and the parser accepts no void one")
			// A struct argument is named by itself and a nested instance by its compiled name — the same two
			// spellings `mangleTypeArg` produces, which is why it is asked rather than re-derived.
			structRef then return self.instanceArgTypeName(gid, position: position)
			string then return EmptySourceText
			function then return EmptySourceText
			typeParameter then return EmptySourceText
			// CANONICAL, not `instanceArgTypeName`: a nested instance's identity must match what the two
			// value-side extractors produce for the same type, whichever way it was spelled.
			genericInstance then return self.canonicalInstanceName(typeNameIdOf(self.substitutedInstanceArg(gid, position: position)))
			// A Character argument carries no name — the builtin's identity is its tag, `string`'s answer.
			character then return EmptySourceText
		end 'k'
	end 'instanceArgAggregateName'

	// ⭐⭐ **READ-TIME RESOLUTION OF A TYPE ARGUMENT SPELLED AS A GENERIC-INSTANCE ALIAS (P1.7).**
	//
	// `typealias N1 = Box with N0` records its argument as a plain `named(N0)` LEAF: only a syntactic
	// `Base with (…)` header becomes `genericInstance` at intern time, and the sweep records a file's
	// aliases at its END, so an alias named before it is interned cannot be seen there at all. Resolving it
	// HERE is what makes the two spellings agree — this runs from `semanticCheck`, long after the whole
	// sweep is folded, so the alias table is COMPLETE and the answer cannot depend on declaration or file
	// order. (`Box with N0` and `Box with (Box with S0)` still intern as two instances with two compiled
	// names; that duplicate is pre-existing and is its own rung. What matters for the comparison is the
	// TYPE ARGUMENT's identity, and both spellings yield `N0`'s instance — the same `Box_S0`.)
	//
	// ⚠ It cannot hang on a cyclic alias: `mangleGenericInstance` recurses only through `genericInstance`
	// args (`mangleTypeArg` returns a `named` arg's bare NAME without resolving it), and those nest
	// syntactically, so the recursion is bounded by source nesting depth. A cycle is refused earlier
	// anyway, by `firstCyclicAliasDecl` (E3091), which runs before the pipeline.
	function namedTypeArgIdentity(arg MaxonType) returns ByteArray
		let name = self.nameOfId(typeNameIdOf(arg))
		if let aliased = try self.genericAliases.get(name) 'namesAnInstance'
			return self.canonicalInstanceName(aliased)
		end 'namesAnInstance'

		// `named` is OVERLOADED — a declared union/enum VALUE (a boxed aggregate) and a ranged numeric alias
		// share it — so only a registered aggregate carries identity, exactly as both twins decide it.
		if self.containsStruct(name) or self.containsEnum(name) 'registeredAggregate'
			return name
		end 'registeredAggregate'

		// A RANGED numeric alias (`Integer`), which is a nominal wrapper over a scalar and decays. This is
		// the enumerated last kind a `named` can be, not a fallthrough: the three are alias / aggregate /
		// ranged, and the tag match above has already excluded everything that is not `named`.
		return EmptySourceText
	end 'namedTypeArgIdentity'

	// ⭐ **THE FIRST GENERIC ALIAS WHOSE TYPE ARGUMENTS LEAD BACK TO IT (P1.7, E3091).** `typealias A = Box
	// with A` and the mutual `A = Box with B` / `B = Box with A` describe INFINITE types — no finite layout,
	// no finite compiled name — and both compiled clean and SEGFAULTED at run time before this check.
	//
	// Asked once per compile over the FINISHED table, so it needs none of the sweep's ordering: an alias
	// reaches itself or it does not, whatever order the files were swept in. The BLAME is read in
	// declaration-record order so the alias reported is a property of the program, not of a map's iteration.
	//
	// ⚠ **THE CYCLE SET IS COMPUTED ONCE FOR THE WHOLE GRAPH, NOT ONCE PER ALIAS — AND THAT IS A CUBIC
	// REMOVED, NOT A TIDY-UP.** This first shipped as a per-alias reachability sweep: every alias walked the
	// instances its arguments reach, with a LINEAR scan of a `visited` array at every pop. On a chain of N
	// aliases (`N0 = Box with S0`, `N1 = Box with N0`, …) alias i reaches i instances and scans i entries per
	// pop, so the pass cost N x N x N. MEASURED, A/B in this worktree at dc0e1127c against the same tree with
	// only this check suppressed: the check alone cost 31 / 268 / 1,751 / 12,298 ms at N = 400 / 800 / 1,600 /
	// 3,200 — x8.6, x6.5, x7.0 per doubling, i.e. CUBIC, on programs that COMPILE (the rest of the compile
	// stayed flat at 139…197 ms across the same span). `nodesOnACycle` answers the same question for every
	// instance at once in O(instances + arguments): the same ladder now compiles in 149 / 197 / 307 ms at
	// N = 1,600 / 3,200 / 6,400 against a check-suppressed 143 / 194 / 295 ms, so the check costs 6 / 3 / 12 ms
	// and no longer grows out of the noise floor.
	//
	// A program with no generic alias cannot have a cycle at all — only an alias edge can close one, since a
	// nested `Base with (Base with …)` argument nests syntactically and therefore finitely — so the whole
	// pass, graph included, is skipped rather than merely cheap.
	export function firstCyclicAliasDecl() returns AliasCycleResult
		if self.genericAliasDecls.count() == 0 'noAliasCanCloseACycle'
			return AliasCycleResult.none
		end 'noAliasCanCloseACycle'

		let onCycle = nodesOnACycle(self.buildInstanceArgGraph())
		for i in 0 upto self.genericAliasDecls.count() 'eachDecl'
			let entry = try self.genericAliasDecls.get(i) otherwise panic("firstCyclicAliasDecl: genericAliasDecls.get OOB at {i}")
			if let gid = try self.genericAliases.get(entry.aliasName) 'recorded'
				if (try onCycle.get(gid) otherwise panic("firstCyclicAliasDecl: alias '{String.from(entry.aliasName)}' names instance {gid}, outside the interner's own instance space")) 'cyclic'
					return AliasCycleResult.at(i)
				end 'cyclic'
			end 'recorded'
		end 'eachDecl'

		return AliasCycleResult.none
	end 'firstCyclicAliasDecl'

	// The "instance ⇒ the instances its type arguments denote" graph, over the dense `GenericInstanceId`
	// space — a nested `genericInstance` argument directly, and a `named` leaf through the alias table (the
	// very edge `namedTypeArgIdentity` follows, so the cycle check and the identity read traverse ONE graph
	// rather than two views of it).
	//
	// Built through the shared counting sort (`buildCsr`) like every other adjacency in this compiler, and
	// for the reason its header gives: a per-node array would be one refcounted heap object per instance.
	function buildInstanceArgGraph() returns CsrGraph
		var argOf = CsrColumn.create()
		var denotes = CsrColumn.create()

		for gid in 0 upto self.genericInstances.count() 'eachInstance'
			for position in 0 upto self.genericInstanceArgCount(gid) 'eachArg'
				let arg = self.substitutedInstanceArg(gid, position: position)
				let tag = maxonTypeTag(arg)
				if tag == ValueTypeTag.genericInstance 'nested'
					argOf.push(gid)
					denotes.push(typeNameIdOf(arg))
				end 'nested'
				if tag == ValueTypeTag.named 'maybeAlias'
					if let aliased = try self.genericAliases.get(self.nameOfId(typeNameIdOf(arg))) 'namesAnInstance'
						argOf.push(gid)
						denotes.push(aliased)
					end 'namesAnInstance'
				end 'maybeAlias'
			end 'eachArg'
		end 'eachInstance'

		return buildCsr(argOf, to: denotes, nodeCount: self.genericInstances.count())
	end 'buildInstanceArgGraph'

	// The declaration record of alias `index`, for the E3091 diagnostic's name and anchor.
	export function genericAliasDeclAt(index FieldIndex) returns GenericAliasEntry
		return try self.genericAliasDecls.get(index) otherwise panic("genericAliasDeclAt: genericAliasDecls.get OOB at {index}")
	end 'genericAliasDeclAt'

	// --- Bases without a `StructLayout`: the ONE predicate, and the ONE reason there are two of them ---
	//
	// ⭐⭐ **"IS THIS BASE SYNTHESIZED?" AND "IS THERE A LAYOUT TO WALK?" ARE DIFFERENT QUESTIONS, AND
	// CONFLATING THEM IS WHAT CRASHED THE COMPILER.** A generic instance's base has no `StructLayout` for
	// exactly two reasons, and they are not the same reason:
	//
	//   • **SYNTHESIZED** — `Array` / `Set`. shv2 reads no stdlib and emits their runtime records itself, so
	//     no `type Array uses Element` declaration exists to carry a layout. The type is LEGAL and the
	//     program is fine; it simply has no fields.
	//   • **UNDECLARED** — `Map with (K, V)`, `Foo with Int`, `Int with Int`. Nothing declares the base at
	//     all. The program is MALFORMED, and `Parser.checkGenericInstance` has already recorded E2055
	//     against the `with` that wrote it.
	//
	// Every walk over an instance's fields must stop for BOTH, because in both cases there are no fields to
	// read. Four such walks spelled the stop condition as `isArrayInstance(id) or isSetInstance(id)` — the
	// SYNTHESIZED half, four times over, each blind to the UNDECLARED half — so an undeclared base fell
	// through into `baseLayoutOf` and the compiler died with a stack trace on a program whose real
	// diagnostic was already written and never printed (measured on `typealias IntMap = Map with (Int, Int)`
	// and on a bare `Foo with Int`: `panic ProgramSignatures.baseLayoutOf`, exit 1, no `error E….`).
	//
	// So the stop condition is `not genericInstanceHasBaseLayout(id)`, written once, and it is exactly
	// `baseLayoutOf`'s precondition. The synthesized half keeps its own name because two callers genuinely
	// need to tell the reasons apart rather than merely stop: `Parser.structLayoutOfType`, whose
	// diagnostic must say "a builtin with no fields YET" for one and "no such type" for the other, and the
	// per-builtin routers below (`genericInstanceBoxSize`, `genericInstanceBoxDropCallee`), which do not stop
	// at all — they answer `Array` and `Set` differently from each other.

	// Is `name` a BUILTIN generic base — one shv2 synthesizes rather than reads a declaration for, so no
	// `StructLayout` exists for it and none is missing. The one home of the `Array`-or-`Set` disjunction.
	export function isBuiltinGenericBaseName(name ByteArray) returns bool
		return self.isArrayBaseName(name) or self.isSetBaseName(name)
	end 'isBuiltinGenericBaseName'

	// Does instance `id`'s base struct have a declared `StructLayout` to read fields out of — the exact
	// precondition of `baseLayoutOf`, and the gate every instance FIELD WALK opens with. False for a
	// synthesized builtin (no declaration to carry one) and for an undeclared base (E2055 already reported).
	export function genericInstanceHasBaseLayout(id GenericInstanceId) returns bool
		let baseName = self.genericInstanceBaseName(id)
		return not self.isBuiltinGenericBaseName(baseName) and self.containsStruct(baseName)
	end 'genericInstanceHasBaseLayout'

	// Is instance `id`'s base one this compiler KNOWS AT ALL — a builtin it synthesizes, or a `type` some
	// file declares. The UNDECLARED third of the split above, on its own.
	//
	// ⚠ **THIS IS NOT `genericInstanceHasBaseLayout` AND MUST NOT BE COLLAPSED INTO IT: THE TWO DISAGREE ON A
	// BUILTIN, WHICH IS KNOWN AND HAS NO FIELDS.** They are the preconditions of two different queries, and
	// each query needs its own:
	//
	//   • a FIELD WALK needs a layout, so `Array` stops it — `genericInstanceHasBaseLayout`.
	//   • `genericInstanceBoxSize` answers for a builtin (the fixed record) AND for a declared base (its
	//     box), and has nothing to say only for NEITHER — this one.
	//
	// Measured on the door that needed it: `sizeof(IntMap)` for `typealias IntMap = Map with (Int, Int)` died
	// inside `genericInstanceBoxSize` with a stack trace and no `error E….`, because `sizeof` folds at PARSE
	// time and the E2055 `checkGenericInstance` had already recorded is drained whole-program, later.
	export function genericInstanceBaseIsKnown(id GenericInstanceId) returns bool
		let baseName = self.genericInstanceBaseName(id)
		return self.isBuiltinGenericBaseName(baseName) or self.containsStruct(baseName)
	end 'genericInstanceBaseIsKnown'

	// --- Generic-instance managed drop (P1.6-B2) ---
	//
	// A generic instance is a monomorphized base struct: its box is `Box`'s box, and a managed type
	// argument is MOVED into it (consumed at the concrete call site), so the box OWNS that content and
	// `__destruct_<mangled-instance>` drops it exactly once. These queries substitute the instance's args
	// for the base struct's type parameters and answer the drop cascade's three questions — is a field
	// managed, what drops it, at what offset — over THIS index's own interner (the args and the base
	// layout's field types both live in `self.typeNames`), so a caller never has to choose the interner.

	// The `StructLayout` of instance `id`'s base struct. Precondition: `genericInstanceHasBaseLayout(id)` —
	// an instance is interned for ANY base a `with` names, declared or not, so the caller opens the walk with
	// that gate. See its header for the two ways a base has no layout and why they are one stop condition.
	function baseLayoutOf(id GenericInstanceId) returns StructLayout
		let baseName = self.genericInstanceBaseName(id)
		return try self.structTypes.get(baseName) otherwise panic("ProgramSignatures.baseLayoutOf: generic instance {id}'s base struct '{String.from(baseName)}' has no declared layout — every field walk opens with genericInstanceHasBaseLayout")
	end 'baseLayoutOf'

	// The base struct's field `index` type with the instance's args substituted for the type parameters —
	// a `typeParameter(pos)` field becomes `args[pos]` (the concrete arg), every other field stays. This is
	// what turns `Box`'s opaque `value as T` into `String` for a `Box with String`, so the cascade can
	// classify and drop it. `typeNameIdOf(typeParameter(pos))` is the parameter POSITION; arity was checked
	// at instantiation (E2056), so the position indexes the args in range.
	function substituteInstanceFieldType(id GenericInstanceId, index FieldIndex) returns MaxonType
		let fieldType = try self.baseLayoutOf(id).fieldTypes.get(index) otherwise panic("ProgramSignatures.substituteInstanceFieldType: field {index} out of range for instance {id}'s base struct")
		if maxonTypeTag(fieldType) != ValueTypeTag.typeParameter 'notTypeParam'
			return fieldType
		end 'notTypeParam'
		return self.substitutedInstanceArg(id, position: typeNameIdOf(fieldType))
	end 'substituteInstanceFieldType'

	// Instance `id`'s concrete type argument at type-parameter `position` (P1.6-B2) — what a `T`-typed field
	// read on a concrete receiver retypes to. `adoptType` re-interns it into the caller's interner. Arity was
	// checked at instantiation (E2056), so a `typeParameter(position)` field indexes the args in range.
	export function substitutedInstanceArg(id GenericInstanceId, position TypeParamId) returns MaxonType
		let args = self.genericInstances.instanceArgs(id)
		return try args.get(position) otherwise panic("ProgramSignatures.substitutedInstanceArg: type-parameter position {position} out of range for instance {id}'s {args.count()} argument(s) — arity was checked at instantiation (E2056)")
	end 'substitutedInstanceArg'

	// ⭐ **IS INSTANCE `id`'s ARGUMENT AT `position` A MANAGED TYPE?** — asked here rather than by the caller,
	// for the reason T1 exists: `substitutedInstanceArg` returns a type in THIS INDEX's interner, so the only
	// table that can resolve its `named` id is `self.typeNames`, and that table is private. A caller doing the
	// two steps itself must either be handed the interner or adopt the type into its own first — and adopting
	// it is precisely the mistake, because the id then means whatever name happens to sit at that number in
	// the OTHER table. Keeping both steps inside makes the pairing structural instead of conventional, which
	// is the same move `instanceArgAggregateName` above already makes.
	export function instanceArgIsManaged(id GenericInstanceId, position TypeParamId) returns bool
		return self.typeIsManaged(self.substitutedInstanceArg(id, position: position), from: self.typeNames)
	end 'instanceArgIsManaged'

	// The number of fields instance `id` carries — its base struct's field count.
	export function genericInstanceFieldCount(id GenericInstanceId) returns FieldIndex
		return self.baseLayoutOf(id).fieldCount()
	end 'genericInstanceFieldCount'

	// The byte offset of instance field `index` in the box — its base struct's own field offset.
	export function genericInstanceFieldOffset(id GenericInstanceId, index FieldIndex) returns ByteOffset
		return self.baseLayoutOf(id).offsetOfField(index)
	end 'genericInstanceFieldOffset'

	// ⭐ **DOES A TYPE ARGUMENT REQUIRE A CALL-SITE CONSUME (a MOVE into the box)?** — the CONSUME boundary,
	// DELIBERATELY NARROWER than both `typeIsManaged` and the box's own field DROP. A TRIVIAL type argument (a
	// scalar, or an all-scalar struct/instance like `Point`/`IntBox`) is NOT consumed: the caller keeps it
	// usable (`PointBox.create(p); … p.getX()`, `generic-trivial-struct-arg`). B2 flips this ONLY for an
	// argument that itself owns managed heap — a `String`, a struct WITH a managed field, a boxed union, or a
	// nested instance that owns managed heap — which the box MOVES in and the caller may not reuse.
	//
	// ⚠ **THIS IS NO LONGER THE DROP BOUNDARY.** Before the retain-escaping rung a trivial `T` argument was a
	// pure BORROW — not consumed AND not dropped — which dangled when the container OUTLIVED the borrowed
	// source (`var b = …; { let pInner = Point.create(…); b = PointBox.create(pInner) }; b.itemDigest()` freed
	// `pInner` at the inner scope while `b` still pointed at it — a use-after-free the witness dispatch first
	// made reachable). The user ruling (2026-07-23) fixes it by RETAIN, generalizing OPEN #40's `__mm_retain`
	// co-ownership: a trivial struct/instance stored into a generic field is `__mm_retain`'d at the constructor
	// feed (`Parser.handleEscapingBorrowFeed`), so the box holds a REAL second reference — CO-OWNED, not
	// borrowed. The DROP boundary therefore moved to `typeIsManaged` (`genericInstanceFieldIsManaged`), which
	// releases that reference at the box's destruction, while THIS consume boundary stays put so the caller's
	// own `p` is still live and dropped once. So the three questions now split three ways on a trivial struct:
	// NOT consumed (borrowed-and-kept), YES dropped (co-owned via retain), and the retain fills the gap between
	// them — freed exactly once on every path. A managed argument is BOTH consumed and dropped (unchanged); a
	// scalar is neither. (The one construct co-ownership cannot yet balance — a SHARED-body reassignment of a
	// co-owned trivial field — is rejected at `emitOpaqueFieldReassign` rather than leaked; the true E3070 NLL
	// borrow-liveness pass, `arr.get(0); arr.push(x)`, is a SEPARATE future rung this did not build.)
	export function typeArgIsOwned(t MaxonType) returns bool
		let tag = maxonTypeTag(t)
		// `tagIsByteRecord`: a Character argument is an owned record exactly as a String one is.
		if tagIsByteRecord(tag) 'byteRecord'
			return true
		end 'byteRecord'
		if tag == ValueTypeTag.genericInstance 'instance'
			return self.genericInstanceHasManagedField(typeNameIdOf(t))
		end 'instance'
		if tag != ValueTypeTag.named and not tagIsStructRef(tag) 'notNamedStruct'
			return false
		end 'notNamedStruct'
		let name = self.nameOfId(typeNameIdOf(t))
		if self.structTypes.contains(name) 'struct'
			return self.structHasManagedField(name)
		end 'struct'
		if not self.enumTypes.contains(name) 'notEnum'
			return false
		end 'notEnum'
		return (try self.enumTypes.get(name) otherwise panic("ProgramSignatures.typeArgIsOwned: enumTypes.contains({String.from(name)}) is true but get failed")).isBoxed()
	end 'typeArgIsOwned'

	// Does ANY interned instance of generic type `baseName` classify its type argument at `position` as
	// `kind`? The ONE instance-registry read the three type-parameter-instantiation gates
	// (`genericTypeFieldHas{Managed,CoOwnedTrivial,Uncopyable}Instantiation`) delegate to — so the lookup and
	// the `position < args.count()` bound are written once for all three and cannot drift between them. The
	// per-kind predicate is the only thing that varies, in `typeArgHasKind`.
	//
	// ⭐ **THROUGH THE BY-BASE INDEX, NOT A WHOLE-REGISTRY WALK (P1.7 Workstream O).** It used to run
	// `0 upto genericInstances.count()` comparing every instance's base NAME, making the three gates
	// O(call sites × TOTAL instances) — a term that allocates nothing (`nameOf` borrows, `.equals` copies
	// nothing), so no memory instrument could ever show it. `byBase` is filed by the same `intern` that
	// assigns the ids, so this visits only THIS base's instances and the gates become O(instances of the
	// base). A base with no instantiation has no bucket, and that is the answer: nothing instantiates it,
	// so no instantiation classifies anything as `kind`.
	function anyInstanceTypeArgHasKind(baseName ByteArray, position TypeParamId, kind TypeArgInstantiationKind) returns bool
		if let baseId = try self.typeNames.idOf(baseName) 'namedType'
			if let siblings = try self.genericInstances.instancesOfBase(baseId) 'instantiated'
				for id in siblings 'eachInstance'
					let args = self.genericInstances.instanceArgs(id)
					if position < args.count() and self.typeArgHasKind(try args.get(position) otherwise panic("ProgramSignatures.anyInstanceTypeArgHasKind: instanceArgs.get OOB at {position} despite the range guard"), kind: kind) 'match'
						return true
					end 'match'
				end 'eachInstance'
			end 'instantiated'
		end 'namedType'

		return false
	end 'anyInstanceTypeArgHasKind'

	// The per-kind argument predicate the instance-scan gates read (see `anyInstanceTypeArgHasKind`). Each arm
	// reads off the SAME `typeArgIsOwned` / `typeArgIsCoOwnedTrivial` / `typeSupportsDeepClone` boundary the
	// corresponding drop, consume or copy site decides on, so a gate and the emission it guards cannot disagree.
	function typeArgHasKind(t MaxonType, kind TypeArgInstantiationKind) returns bool
		match kind 'kind'
			consumeMoved then return self.typeArgIsOwned(t)
			coOwnedTrivial then return self.typeArgIsCoOwnedTrivial(t)
			uncopyableElement then return not self.typeSupportsDeepClone(t, asElement: true, visited: ClonerSet.create())
		end 'kind'
	end 'typeArgHasKind'

	// ⭐ **DOES ANY INTERNED INSTANCE OF GENERIC TYPE `baseName` MAKE ITS TYPE PARAMETER AT `position`
	// MANAGED (P1.7 slice 3b-vii)?** A shared generic body reassigns a bare `T` field opaquely; the OLD value's
	// descriptor-gated drop (`__drop_type_param`) is needed ONLY when some instantiation makes that field
	// managed (`Box with String`), and is a sound scalar plain store — no drop — when every instantiation is
	// trivial (`Box with SmallInt`). This is the exact gate that tells a crash-prone managed reassignment (the
	// old value would be leaked and a borrow double-freed by the box's destructor: `0xC0000005` — rejected until
	// the single-value drop runtime is installable off the array floor) from an all-trivial one (left to the
	// unchanged plain store). HOW the instances are found is `anyInstanceTypeArgHasKind`'s business and is
	// described there once; what this gate adds is the KIND — each instance's argument at `position` read
	// through the SAME `typeArgIsOwned` boundary the box's own per-field drop gate
	// (`genericInstanceFieldIsManaged`) uses, so the reject and the destructor agree on what "managed" means.
	export function genericTypeFieldHasManagedInstantiation(baseName ByteArray, position TypeParamId) returns bool
		return self.anyInstanceTypeArgHasKind(baseName, position: position, kind: TypeArgInstantiationKind.consumeMoved)
	end 'genericTypeFieldHasManagedInstantiation'

	// ⭐ **DOES ANY INTERNED INSTANCE OF GENERIC TYPE `baseName` MAKE ITS TYPE PARAMETER AT `position` A
	// CO-OWNED TRIVIAL STRUCT (the retain-escaping rung)?** A trivial struct/instance argument (`Box with
	// Point`) is BORROWED at the call site (`typeArgIsOwned` false — the caller keeps it) yet CO-OWNED by the
	// box (`typeIsManaged` true — `genericInstanceFieldIsManaged` drops it, balanced by the constructor-feed
	// `__mm_retain`). That co-ownership is sound for a field set ONCE at construction, but a SHARED-body
	// REASSIGNMENT of it (`self.saved = next`) has no way to drop the field's OLD co-owned value: the opaque
	// body cannot emit a trivial struct's `__mm_decref` directly, and the descriptor-gated `__drop_type_param`
	// is inert for a trivial instantiation (its `destroyFunc@40` is 0). So a reassignment would LEAK the old
	// value. This gate lets `emitOpaqueFieldReassign` REJECT that combination up front rather than ship the
	// leak — read off the SAME `typeIsManaged`/`typeArgIsOwned` boundaries the drop and the consume decide on,
	// so the reject fires on exactly the fields the destructor co-owns but the reassign cannot re-balance. A
	// managed instantiation (`Box with String`, both true) reassigns through the descriptor as before; a scalar
	// (both false) is inert; only the borrowed-and-dropped trivial struct — the co-ownership gap — is rejected.
	export function genericTypeFieldHasCoOwnedTrivialInstantiation(baseName ByteArray, position TypeParamId) returns bool
		return self.anyInstanceTypeArgHasKind(baseName, position: position, kind: TypeArgInstantiationKind.coOwnedTrivial)
	end 'genericTypeFieldHasCoOwnedTrivialInstantiation'

	// Is `t` a CO-OWNED TRIVIAL type argument — a heap aggregate the box drops (`typeIsManaged`) but that the
	// call site borrows rather than consumes (`typeArgIsOwned` false)? The one-type predicate the co-ownership
	// gates read: the constructor-feed retain fires for exactly this class of argument (a trivial struct or
	// trivial instance), and the reassign reject refuses it. A String/owning aggregate (`typeArgIsOwned` true)
	// is consumed, not co-owned-by-retain, and a scalar owns no heap — both answer false.
	export function typeArgIsCoOwnedTrivial(t MaxonType) returns bool
		return self.typeIsManaged(t, from: self.typeNames) and not self.typeArgIsOwned(t)
	end 'typeArgIsCoOwnedTrivial'

	// ⭐ **DOES ANY INTERNED INSTANCE OF GENERIC TYPE `baseName` MAKE ITS OPAQUE ARRAY ELEMENT AT `position`
	// UNCOPYABLE (P1.7 slice 3b-vi-b-β)?** The FRONT-END gate for an opaque `slice`/`clone`/`append`: the shared
	// body copies each element through the descriptor's single `copyFunc@32`, which can hold a cloner only for a
	// `direct`-clonable element (String / struct / boxed union / trivial-element array — a byte-blit copies a
	// TRIVIAL element correctly with no cloner at all). An instantiation whose argument is a MANAGED type this
	// rung cannot deep-clone as a single-function element — a managed-element array (`Array with (Array with
	// String)`) or a non-Array generic instance (`Box with String`, a later slice) — has no single `copyFunc`,
	// so a copy of it would byte-blit a managed pointer and double-free it; such an instantiation is rejected
	// with a positioned E2015 at the copy site rather than crash at descriptor emit. HOW the instances are found
	// is `anyInstanceTypeArgHasKind`'s business and is described there once; what this gate adds is the KIND —
	// each instance's argument at `position` read through the SAME
	// `typeSupportsDeepClone(asElement: true)` the concrete element-copy gate (`arrayElementSupportsDeepClone`)
	// uses, so the opaque reject and the concrete reject agree on what "deep-cloneable as an element" means. A
	// TRIVIAL argument is copyable (a byte blit), so it never triggers the reject.
	export function genericTypeFieldHasUncopyableInstantiation(baseName ByteArray, position TypeParamId) returns bool
		return self.anyInstanceTypeArgHasKind(baseName, position: position, kind: TypeArgInstantiationKind.uncopyableElement)
	end 'genericTypeFieldHasUncopyableInstantiation'

	// ⭐ **IS `fieldName` OF `structName` A BARE OPAQUE TYPE-PARAMETER field whose element is MANAGED for some
	// instantiation (P1.7 Finding A)** — a `typeParameter`-tagged field (`export var saved as Element` on
	// `type Box uses Element`) that at least one interned instance makes owned (`Box with String`). This is the
	// ONE fact the descriptor-need scan reserves a reassigning method's layout descriptor by: only such a
	// reassignment DROPS the field's old opaque value through the descriptor-gated `__drop_type_param`, so only
	// it needs the descriptor. Read off the SAME raw `fieldTypes` column and the SAME `typeArgIsOwned` managed
	// boundary the emitted drop (`emitOpaqueFieldReassign`) and the box's own destructor branch on, so the
	// reserved slot and the emitted drop decide off ONE fact. False for a non-generic type, an unknown field, a
	// concrete/direct field, or an all-trivial instantiation (`Box with SmallInt` — inert, no drop, no descriptor).
	export function isManagedOpaqueTypeParamField(structName ByteArray, fieldName ByteArray) returns bool
		if not self.structTypes.contains(structName) 'notStruct'
			return false
		end 'notStruct'
		let layout = try self.structTypes.get(structName) otherwise panic("ProgramSignatures.isManagedOpaqueTypeParamField: structTypes.contains({String.from(structName)}) is true but get failed")
		let index = layout.indexOfField(fieldName)
		if index >= layout.fieldCount() 'noField'
			return false
		end 'noField'
		let fieldType = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.isManagedOpaqueTypeParamField: fieldTypes.get OOB at {index} despite index < fieldCount")
		if maxonTypeTag(fieldType) != ValueTypeTag.typeParameter 'notOpaque'
			return false
		end 'notOpaque'
		return self.genericTypeFieldHasManagedInstantiation(structName, position: typeNameIdOf(fieldType))
	end 'isManagedOpaqueTypeParamField'

	// Is instance field `index` DROPPED by the box once its args are substituted — the per-field drop gate.
	// A type-PARAMETER field is dropped iff its substituted argument is a HEAP AGGREGATE (`typeIsManaged`), the
	// SAME gate a DIRECT field uses. That is DELIBERATELY BROADER than the CONSUME boundary (`typeArgIsOwned`):
	// a trivial `Box with Point` is CO-OWNED, not consumed — its `Point` is `__mm_retain`'d at the constructor
	// feed (`Parser.handleEscapingBorrowFeed`), so the box holds a real second reference the caller keeps
	// usable (`generic-trivial-struct-arg`), and this decref RELEASES that reference at the box's destruction.
	// The retain and this drop are the two ends of one co-ownership (OPEN #40's `__mm_retain` thesis applied to
	// the generic-field escape — the RED `PointBox.create(pInner)` outliving `pInner`'s scope). The two
	// classifiers therefore differ exactly on a trivial struct/instance: consumed = borrowed-and-kept, dropped =
	// co-owned. A managed argument (`String`, an owning struct) is BOTH consumed and dropped, unchanged; a
	// scalar is neither. A shared-body reassignment of a co-owned trivial field would break this balance (the
	// old value cannot be decref'd through the descriptor-gated `__drop_type_param` without a trivial-struct
	// descriptor), so it is REJECTED at the reassign site (`emitOpaqueFieldReassign`) — leaving every field this
	// drop fires on either construct-only (co-owned once) or managed/scalar (the pre-existing model).
	export function genericInstanceFieldIsManaged(id GenericInstanceId, index FieldIndex) returns bool
		let baseFieldType = try self.baseLayoutOf(id).fieldTypes.get(index) otherwise panic("ProgramSignatures.genericInstanceFieldIsManaged: field {index} out of range for instance {id}'s base struct")
		if maxonTypeTag(baseFieldType) == ValueTypeTag.typeParameter 'typeParamField'
			return self.typeIsManaged(self.substituteInstanceFieldType(id, index: index), from: self.typeNames)
		end 'typeParamField'
		return self.typeIsManaged(baseFieldType, from: self.typeNames)
	end 'genericInstanceFieldIsManaged'

	// The drop callee for managed instance field `index` — routed through the shared `managedFieldDropCallee`
	// over the SUBSTITUTED concrete type (a String → `__str_decref`, a struct/boxed-union → its
	// `__destruct_<T>`, a nested instance → its instance destructor). Precondition: the field is managed.
	export function genericInstanceFieldDropCallee(id GenericInstanceId, index FieldIndex) returns ByteArray
		return managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: self.substituteInstanceFieldType(id, index: index))
	end 'genericInstanceFieldDropCallee'

	// Does instance `id` own ANY managed field once substituted — the gate deciding whether it needs a
	// `__destruct_<instance>` cascade at all (else its box drop is the trivial `__mm_decref`).
	export function genericInstanceHasManagedField(id GenericInstanceId) returns bool
		// A base-layout-less instance owns no field this cascade could drop. An `Array`/`Set` instance is
		// dropped through its own box-drop callee (`__arr_decref` / `__set_decref`, routed by
		// `genericInstanceBoxDropCallee`), NOT a synthesized per-instance `__destruct_<mangled>`, so `false`
		// is the ANSWER and not a dodge; an UNDECLARED base has no fields at all. Either way the walk below
		// would read a layout that does not exist — see `genericInstanceHasBaseLayout`.
		if not self.genericInstanceHasBaseLayout(id) 'noFields'
			return false
		end 'noFields'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			if self.genericInstanceFieldIsManaged(id, index: i) 'managed'
				return true
			end 'managed'
		end 'eachField'
		return false
	end 'genericInstanceHasManagedField'

	// Does instance `id` DIRECTLY own a String field once substituted — the `usesStrDecref` gate for its
	// destructor. A String inside a nested struct/instance field is dropped by that nested destructor, not
	// this one, so only a directly-substituted String counts (the struct/union `structHasStringField` twin).
	export function genericInstanceHasStringField(id GenericInstanceId) returns bool
		// ⚠ **THE SAME NO-LAYOUT EARLY-OUT `genericInstanceHasManagedField` MAKES, AND FOR THE SAME REASON.**
		// These two are read as a pair by the destructor passes, and only one of them had the guard — so the
		// pair agreed exactly until something asked this one on its own. `noteDestructorUsage` does: it
		// reaches this for any instance whose `__destruct_<mangled>` is in the needed set, and an instance
		// walked into the field loop below reads a base struct that does not exist. Measured, on the
		// compiler that had the guard on only one of the pair: `panic ProgramSignatures.baseLayoutOf: generic
		// instance 3's base struct 'Array' is not declared` — a stack trace with no diagnostic at all.
		//
		// ⚠ The ROUTE that reached it is closed as of P1.7's reserved-space disjointness, and the guard stays
		// anyway. It used to be a NAME collision: the needed set is keyed by symbol, so a declared
		// `type Array_Foo` owning a String put `__destruct_Array_Foo` there and pulled the base-less
		// `Array with Foo` instance in behind it. That instance is `__Array_Foo` now (`reservedIfDeclared`),
		// so the two names cannot meet — but the guard is this walk's STRUCTURAL precondition, not a patch on
		// that one route, and `declared-type-owning-a-string-named-like-an-array-instance` is the case that
		// re-measures it.
		//
		// `false` is the ANSWER, not a dodge: an `Array`/`Set` instance owns no substituted String field. Its
		// elements are released by `__arr_decref`/`__set_decref` walking the record, never by a synthesized
		// per-instance cascade — which is exactly why it has no `__destruct_<mangled>` to gate.
		if not self.genericInstanceHasBaseLayout(id) 'noFields'
			return false
		end 'noFields'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			if tagIsByteRecord(maxonTypeTag(self.substituteInstanceFieldType(id, index: i))) 'byteRecord'
				return true
			end 'byteRecord'
		end 'eachField'
		return false
	end 'genericInstanceHasStringField'

	// ⭐ **THE DROP CALLEE FOR AN OWNED INSTANCE BOX** — its own `__destruct_<mangled>` cascade when it owns
	// managed heap, else the trivial `__mm_decref`. The generic-instance twin of `unionBoxDropCallee`, and
	// the door `decrefCalleeFor` (a scope-exit drop) and a nested-instance field drop route through — over
	// this index's own interner, so a caller never misresolves the instance's substituted-field ids.
	export function genericInstanceBoxDropCallee(id GenericInstanceId) returns ByteArray
		// An `Array` drops through `__arr_decref` — which frees its external element buffer (the one thing a
		// generic `__mm_decref` cannot reach) and then the record, mirroring how a String drops through
		// `__str_decref`. Its elements are trivial at this slice, so there is no element walk.
		if self.isArrayInstance(id) 'array'
			return ArrDecrefName
		end 'array'
		// A `Set` drops through `__set_decref` — the hash-table twin of `__arr_decref`: it frees the three
		// external buffers (elements/states/hashes, none of which a generic `__mm_decref` can reach) and then
		// the record. Its keys are scalar this slice, so there is no per-element walk.
		if self.isSetInstance(id) 'set'
			return SetDecrefName
		end 'set'
		if self.genericInstanceHasManagedField(id) 'managed'
			return destructorSymbol(self.mangleGenericInstance(id))
		end 'managed'
		return MmDecrefName
	end 'genericInstanceBoxDropCallee'

	// Does instance `id`'s type argument at `position` OWN managed heap — the CALL-SITE CONSUME gate (P1.6-B2).
	// An owning argument is MOVED into the box (the box drops it, so the caller must not); a trivial argument
	// is BORROWED (the P1.6-A behaviour, unchanged — `PointBox.create(p)` keeps `p` usable). It reads exactly
	// the `typeArgIsOwned` boundary the destructor drops on, so the consumed set equals the dropped set by
	// construction — no double-free, no leak.
	export function genericInstanceArgIsOwned(id GenericInstanceId, position TypeParamId) returns bool
		let args = self.genericInstances.instanceArgs(id)
		if position >= args.count() 'oob'
			return false
		end 'oob'
		return self.typeArgIsOwned(try args.get(position) otherwise panic("ProgramSignatures.genericInstanceArgIsOwned: instanceArgs.get out of range at {position} despite position < count"))
	end 'genericInstanceArgIsOwned'

	// The number of interned generic instances — the iteration bound the B2 destructor-synthesis and
	// needs-closure passes walk (`0 upto genericInstanceCount()` enumerates every gid).
	export function genericInstanceCount() returns GenericInstanceId
		return self.genericInstances.count()
	end 'genericInstanceCount'

	// The enum/union `name` denotes, declared in ANY file — `structOf`'s twin, and the door the
	// PARSER asks every enum question through: is this scrutinee an enum? what tag is a case? which
	// cases does a range arm cover? The layout it hands back carries plain NAMES and INTS (no ids),
	// so every one of those questions is answered with no interner at all.
	export function enumOf(name ByteArray) returns DeclaredEnum
		let layout = try self.enumTypes.get(name) otherwise return DeclaredEnum.undeclared
		return DeclaredEnum.declared(layout)
	end 'enumOf'

	// Is `name` a declared enum/union — the `bool` half of `enumOf`, and a HOT-PATH allocation guard.
	// `enumOf` returns a `DeclaredEnum`, a Maxon union VALUE that allocates a heap box on its
	// `undeclared` case as much as any other, so a caller that only needs "is it an enum?" for the
	// COMMON no answer (`parseDottedPrimary` asks it of every `Point.create(…)` static call) must not
	// pay `enumOf`'s box just to throw it away. A `Map.contains` allocates nothing.
	export function containsEnum(name ByteArray) returns bool
		return self.enumTypes.contains(name)
	end 'containsEnum'

	// ⭐ **THE ONE RUNTIME ENTRY THAT DROPS AN OWNED BOX OF UNION `unionName`** — `__destruct_<U>` for a
	// managed-payload union (its own tag-conditional cascade), the trivial `__mm_decref` for a scalar-only
	// one. BOTH doors that ask it come here: `decrefCalleeFor`'s scope-exit drop of a boxed union, and
	// `managedNameDropCallee`'s union arm for a boxed-union FIELD.
	//
	// ⚠ **IT TAKES A NAME, NOT A LAYOUT AND AN INTERNER, AND THAT IS THE WHOLE POINT.** The payload types
	// are resolved against `self.typeNames` — the interner they were minted against (a signatures layout's
	// payload ids live here, remapped in by `remapEnumLayoutPayloadTypes`) — and the interner is NOT the
	// caller's to choose. It went wrong TWICE, in the two doors, and each was fixed alone:
	//   • `decrefCalleeFor` passed its own ARTIFACT interner, which misread a managed payload whenever a
	//     ranged alias perturbed the interning order — `__mm_decref` for a managed-payload union (a LEAK) or
	//     a wrong `__destruct_<T>` (a wild-free). OPEN #52.
	//   • `managedNameDropCallee`'s union arm passed the caller's `project.typeNames` against a SIGNATURES
	//     layout, which cross-file read a ranged-alias payload as MANAGED and demanded a `__destruct_<U>`
	//     that `installUnionDestructors` — asking over the correctly-paired PROJECT layout — never
	//     synthesized: `bl to unknown function '__destruct_Payloaded'`, a compiler panic on a valid
	//     two-file program. Found in T1's review; see `unionHasManagedPayload`.
	// One fact was spelled twice and only one copy was ever repaired. Taking the NAME leaves nothing for a
	// caller to get wrong, so the second copy cannot come back.
	//
	// The union is a precondition, not a case: both callers reached here through an `enumOf` that answered
	// `declared`.
	export function unionBoxDropCallee(unionName ByteArray) returns ByteArray
		return destructorSymbol(unionName) if self.unionHasManagedPayload(unionName) else MmDecrefName
	end 'unionBoxDropCallee'

	// The DECLARED type of field `index` of struct `structName`, ADOPTED into `into` — the calling
	// file's own artifact interner. `returnTypeOf`'s exact shape and exact reason: a `named` type
	// crosses by NAME and is re-interned on arrival, so the id the parser stores is one its own
	// file's merge will resolve.
	//
	// ⚠ **IT TAKES THE LAYOUT AND NOT THE STRUCT NAME — see `fieldSurfaceOf` below for the measurement.**
	// EVERY caller reached this door holding the layout already (it is `emitFieldLoad`'s own parameter, and a
	// `FieldChainStep` carries one), so passing the NAME asked `structTypes` — a NAME-KEYED map — to hash a
	// string per field access to find a record the caller had in hand. For a TUPLE, whose canonical name grows
	// with its arity, that made a W-slot tuple read W times cost O(W²) bytes hashed.
	//
	// The index is a precondition, not a case: `index` is one `indexOfField` handed out.
	export function fieldTypeOf(layout StructLayout, index FieldIndex, into TypeNameInterner) returns MaxonType
		let declared = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.fieldTypeOf: field {index} is out of range for `type {String.from(layout.name)}`, which declares {layout.fieldCount()} — every index handed out came from `indexOfField`")

		return self.declaredSlotType(declared, into: into)
	end 'fieldTypeOf'

	// ⭐ **THE PRE-ERASURE `__ManagedMemory` SPELLING OF FIELD `index` (A2j / A2m)** — `fieldTypeOf`'s twin
	// for the half a `MaxonType` cannot hold, and the door `Parser.emitFieldLoad` asks at the one site a
	// field read mints its value.
	//
	// ⚠ **TWO OF THE THREE BITS ARE STORED AND THE THIRD IS DERIVED, AND THE SPLIT IS FORCED.** The
	// outright spelling and the tuple-slot mask are TOKEN facts, so the declaration SWEEP that built this
	// layout could answer them and wrote them into the column. The element bit is not: `var bufs as
	// BufArray` asks whether `BufArray` holds buffers, and at sweep time that alias may not be interned yet
	// — an answer that would depend on how far the sweep had got. So it is derived HERE, where every file is
	// folded, from the alias NAME the swept `named` type still carries. See `declaredElementIsBufferSurface`.
	//
	// ⚠ **IT TAKES THE LAYOUT AND NOT THE STRUCT NAME, WHICH IS A COST AND NOT A STYLE.** `structTypes` is
	// keyed by NAME, so re-resolving the layout here HASHES that name — and a TUPLE's canonical name grows with
	// its arity, so a W-slot tuple read W times costs O(W²) bytes hashed for a layout `emitFieldLoad` already
	// holds in hand. It was written the name-taking way first and MEASURED: a wide-tuple probe (a W-slot tuple
	// parameter naming no buffer at all, every slot read once), parse CPU ticks minus this compile's ~6.0M
	// floor, interleaved min-of-3 against the merge-base binary —
	//
	//   W        100      200      400      800
	//   base    1.13M    3.25M   10.55M   38.24M     (`fieldTypeOf` alone, hashing the same name)
	//   +this   1.43M    4.28M   15.15M   52.29M     (+0.35M / +1.08M / +4.65M / +14.11M, x3.0 per DOUBLING)
	//   layout  0.89M    2.40M    7.32M   25.01M     (both doors handed the layout: -35% BELOW base)
	//
	// The name was never the caller's fact to give, and `fieldTypeOf`'s identical preamble went with it.
	//
	// The index is a precondition, not a case, exactly as it is for `fieldTypeOf`.
	export function fieldSurfaceOf(layout StructLayout, index FieldIndex) returns DeclaredSurface
		let declared = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.fieldSurfaceOf: field {index} is out of range for `type {String.from(layout.name)}`, which declares {layout.fieldCount()} — every index handed out came from `indexOfField`")

		let stored = layout.fieldDeclaredSurface(index)
		if self.declaredElementIsBufferSurface(declared) 'holdsAnArrayOfBuffers'
			return surfaceWithElementBuffer(stored)
		end 'holdsAnArrayOfBuffers'

		return stored
	end 'fieldSurfaceOf'

	// ⭐ **WHAT A SLOT'S DECLARED TYPE MEANS ONCE THE ALIAS REGISTRIES ARE KNOWN** — the door a struct
	// FIELD and an `Array` ELEMENT both come out of, ADOPTED into `into` (the calling file's own artifact
	// interner) exactly as `returnTypeOf` does.
	//
	// Every re-tag below exists for the same reason: the DECLARATION SWEEP that recorded
	// the slot ran before any alias was interned, so an alias-typed slot arrives as a bare `named` and the
	// registries are the only thing that can say what it is. Leaving one unresolved is not a cosmetic loss
	// — `named` reads as an INTEGER (`tagIsIntegral`), so a function slot admits an int, a generic-instance
	// slot loses its `count()`, and a float slot is stored as raw i64 bits.
	//
	// ⚠ **IT IS ONE FUNCTION BECAUSE THE ELEMENT DOOR HAD A PARTIAL COPY OF IT, AND THE PART THE COPY
	// DROPPED WAS REACHABLE.** `Parser.arrayElementValueType` spelled out the generic-alias re-tag and
	// neither of the other two, so an `Array with <function alias>` element stayed `named` — an INT. It
	// went unnoticed while nothing compared an element against its type; the moment the element-argument
	// check (`Parser.requireArrayElementType`) did, that `named` would have read a pushed function VALUE as
	// a function meeting an int slot and refused a program both compilers accept. A rule with two homes
	// drifts, and only the newer home's obligations reveal which half the older one was missing.
	export function declaredSlotType(declared MaxonType, into TypeNameInterner) returns MaxonType
		// A FUNCTION-typed slot (`export var op as UnaryOp`) arrives as a `named` — the SWEEP that
		// recorded its declaration ran before the function alias was known — so it is re-tagged `function`
		// HERE, over this index's own function-alias registry (P1.5-A1). One place, so every reader (a
		// field READ, a `Self{op: op}` construction check, the store-width query) sees a function VALUE
		// and not an int. Re-interned into `into` by NAME exactly as `adoptType`'s `named` arm is.
		if maxonTypeTag(declared) == ValueTypeTag.named 'maybeAlias'
			let name = self.nameOfId(typeNameIdOf(declared))
			if self.isFunctionAlias(name) 'functionAlias'
				return MaxonType.function(into.intern(name))
			end 'functionAlias'
			// A GENERIC-INSTANCE-typed slot (`export var ops as IntArray`, an `Array` instance) arrives as a
			// `named` for the same reason a function alias does — the SWEEP recorded the declaration before the
			// generic alias was interned — so it is re-tagged `genericInstance` here, over this index's own
			// generic-alias registry (P1.7). One place, so every reader (a field READ, a `Self{ops: ops}`
			// construction check, the array method dispatch, the drop cascade) sees the instance and not an
			// `int`. The gid is this index's own, needing no interner remap.
			if self.isGenericAlias(name) 'genericAlias'
				return MaxonType.genericInstance(self.genericAliasInstance(name))
			end 'genericAlias'
			// ⭐ A TUPLE-ALIAS-typed slot (`export var p as Pair`, `typealias Pair = (Int, Int)`) arrives as a
			// `named` for the reason the arms around it do, and is re-tagged to the tuple's own `structRef`
			// here — the read-side twin of `parseTypeReference`'s tuple-alias arm. A tuple alias mints NO
			// identity of its own, so the tag carries the CANONICAL tuple name and a `Pair`-typed slot and a
			// `(Int, Int)`-typed one are ONE type, which is the whole rule the alias form has.
			//
			// ⚠ **MEASURED, A3e** — without it, three of this door's readers answered by the filesystem's walk
			// order: `var p as Pair` was `E3005 cannot assign 'struct' to variable 'p' of type 'int'`, a tuple
			// SLOT spelled `(Pair, Int)` canonicalized to `__Tuple2.Pair.int` and read its own element as an
			// int, and `Array with Pair` refused the `push` of a matching literal — each on a program the other
			// walk order compiled and ran.
			if self.isTupleAlias(name) 'tupleAlias'
				return MaxonType.structRef(into.intern(self.tupleAliasTarget(name)))
			end 'tupleAlias'
			// ⭐ A RANGED FLOAT-ALIAS-typed slot (`export var mass as Weight`) arrives as a `named` for the
			// same reason the two above do — the SWEEP recorded the declaration before any alias was known — and
			// it is the one `named` whose VALUE is a genuine f64. Left overloaded it reads as an INTEGER
			// (`tagIsIntegral`), which made `Self{mass: 2.5}` a false E3009 on legal code while `Self{mass: 3}`
			// was admitted unconverted into a slot the store then wrote as an i64. Re-tagged here, in the ONE
			// door a field's type comes out of, so the construction check, the field READ, the field WRITE and
			// the store-width query all see the float and cannot disagree about it.
			//
			// It returns the bare primitive and interns nothing: a `float` carries no name (`typeNameIdOf` is
			// `UnnamedTypeId`), so there is nothing for `into` to adopt. The RANGE is dropped exactly as
			// `TypeResolution.resolveNamedType` drops it — a float alias has no range check today.
			if self.isFloatAlias(name) 'floatAlias'
				return MaxonType.float
			end 'floatAlias'
			// ⭐⭐ **A STRUCT-TYPED SLOT (`export var leaf as Leaf`) arrives as a `named` for the reason the
			// three above do** — the SWEEP recorded the declaration before anything could say what the name
			// denoted — and it is the re-tag that was MISSING, with exactly the consequence this header warns
			// of: `named` reads as an INTEGER. MEASURED before this line, against the runnable oracle:
			//   • `return self.leaf` from a `returns Leaf` method was `E3005 Cannot return 'int' from function
			//     declared to return 'struct'` — a false reject of a program the oracle runs;
			//   • `fieldStorageType` fell through to its undeclared-name recovery and typed the field's
			//     `loadIndirect` `integer` (the same machine word, so no emitted byte moved — which is why it
			//     went unnoticed);
			//   • `emitFieldLoad` recorded the read as a BOXED-UNION candidate, a slot its own header says a
			//     struct field never touches.
			// Every other reader already resolved the name for itself — `classifyUnionPayload` re-tags it
			// `structRef` for the construct/drop path, `structLayoutOfField` calls `resolveNamedStruct` for the
			// chain walk — so the field's VALUE was the one place the answer was never given. Re-interned into
			// `into` by NAME exactly as the function-alias arm is.
			if self.structTypes.contains(name) 'structType'
				return MaxonType.structRef(into.intern(name))
			end 'structType'
		end 'maybeAlias'

		return self.adoptType(declared, into: into)
	end 'declaredSlotType'

	// Does field `index` of struct `structName` own DROPPABLE HEAP — a String, a struct, or a
	// payload-bearing (boxed) union? Drives the struct's `__destruct_<T>` drop CASCADE: every field this
	// answers `true` for is freed (through its own destructor / decref) when the struct box is torn down.
	// P1.4b wave 2c folded the boxed-union field into that cascade — earlier waves refused such a field
	// because the drop did not yet reach it. It is answered ENTIRELY INSIDE this index — over `self.typeNames`, the
	// interner the layout's types were minted against — so it neither re-interns the field type (no
	// `adoptType`, unlike `fieldTypeOf`) nor boxes a `DeclaredEnum`/`DeclaredStruct` to decide struct- or
	// enum-hood: the `contains` guards answer allocation-free, which matters because a scalar field (the
	// overwhelming majority) must reach the `false` return without allocating. A ranged int alias and a
	// payload-free enum are scalars; a `float`/`int`/`bool` is a scalar.
	//
	// The struct and index are preconditions, not cases — every caller reached here through a `structOf`
	// that answered `declared`, and `index` is one `indexOfField` handed out.
	export function structFieldIsManaged(structName ByteArray, index FieldIndex) returns bool
		let layout = try self.structTypes.get(structName) otherwise panic("ProgramSignatures.structFieldIsManaged: no `type {String.from(structName)}` is declared — every caller asks `structOf` first")
		let fieldType = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.structFieldIsManaged: field {index} is out of range for `type {String.from(structName)}`, which declares {layout.fieldCount()} — every index handed out came from `indexOfField`")
		return self.typeIsManaged(fieldType, from: self.typeNames)
	end 'structFieldIsManaged'

	// Does struct `structName` DIRECTLY own an `Array` field — the `usesArray` gate for its destructor (P1.7).
	// The struct's `__destruct_<Struct>` drops such a field through `__arr_decref`, which the module scan
	// cannot see (it lives in the synthesized body), so this is what turns the array runtime on. An array
	// inside a nested struct field is dropped by that nested struct's destructor, not this one, so only a
	// DIRECT array field counts — the `structHasStringField` twin. A field arrives as a `named` generic
	// alias (the sweep recorded it before interning), so the alias is resolved to its instance and tested.
	export function structHasArrayField(structName ByteArray) returns bool
		let layout = try self.structTypes.get(structName) otherwise panic("ProgramSignatures.structHasArrayField: no `type {String.from(structName)}` is declared — every caller asks `structOf` first")
		for i in 0 upto layout.fieldCount() 'eachField'
			let fieldType = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.structHasArrayField: fieldTypes.get OOB at {i}")
			if self.fieldTypeIsArray(fieldType) 'array'
				return true
			end 'array'
		end 'eachField'
		return false
	end 'structHasArrayField'

	// Is a (possibly `named`-generic-alias) field type an `Array` instance — the shared "is this an array?"
	// test over a RAW layout field type, resolving a `named` generic alias to its instance first.
	function fieldTypeIsArray(fieldType MaxonType) returns bool
		let tag = maxonTypeTag(fieldType)
		if tag == ValueTypeTag.genericInstance 'instance'
			return self.isArrayInstance(typeNameIdOf(fieldType))
		end 'instance'
		if tag != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'
		let name = self.nameOfId(typeNameIdOf(fieldType))
		return self.genericAliases.contains(name) and self.isArrayInstance(self.genericAliasInstance(name))
	end 'fieldTypeIsArray'

	// The `Array` instance a field type denotes — a directly-tagged `genericInstance`, or a `named`
	// generic-alias field (the sweep recorded the layout before interning) resolved to its instance.
	// Precondition: `fieldTypeIsArray(fieldType)`, so exactly these two shapes reach here.
	function arrayInstanceOfFieldType(fieldType MaxonType) returns GenericInstanceId
		if maxonTypeTag(fieldType) == ValueTypeTag.genericInstance 'instance'
			return typeNameIdOf(fieldType)
		end 'instance'
		return self.genericAliasInstance(self.nameOfId(typeNameIdOf(fieldType)))
	end 'arrayInstanceOfFieldType'

	// ⭐ **DOES A CONCRETE INSTANCE HOLD AN OPAQUE-`T` `Array` FIELD WHOSE ELEMENT IS MANAGED (P1.7 slice
	// 3b)?** — `Container with String`'s `items as Array with typeParameter(0)` field, where the substituted
	// argument (`String`) owns managed heap. Such a field's array needs its `element_destroy@40` stamped with
	// the element's destructor, which the shared opaque `__arr_create` reads at run time from the enclosing
	// instance's descriptor `destroyFunc@40` — a slot filled by the `funcAbs64InRdata` relocation
	// `ensureLayoutDescriptor` records when this answers true (P1.7 slice 3b-ii). A TRIVIAL argument answers
	// false (its `destroyFunc@40` stays 0, no walk). An `Array` instance has no base struct and is never the
	// subject. The reloc CONDITION and the reloc's DESTRUCTOR (`managedOpaqueArrayElementDropCallee`) read the
	// same walk (`managedOpaqueArrayElementOf`), so "is there such a field?" and "what destructor?" cannot
	// disagree about which field they mean.
	export function genericInstanceHasManagedOpaqueArrayField(id GenericInstanceId) returns bool
		match self.managedOpaqueArrayElementOf(id) 'has'
			present then return true
			absent then return false
		end 'has'
	end 'genericInstanceHasManagedOpaqueArrayField'

	// ⭐ **THE `.text` DESTRUCTOR to bake into a managed-opaque-array-holding instance's descriptor
	// `destroyFunc@40` (P1.7 slice 3b-ii)** — the drop callee of the array's SUBSTITUTED element (a String →
	// `__str_decref`, a managed struct/union → its `__destruct_<T>`, a nested Array → `__arr_decref`), which
	// the shared opaque `__arr_create` reads back to stamp its record's `element_destroy@40`. Routed through
	// the SAME `managedFieldDropCallee` a concrete `Array with String` element uses (`arrayElementDropCallee`),
	// so the opaque stamp and the concrete stamp name the identical destructor. Precondition:
	// `genericInstanceHasManagedOpaqueArrayField(id)`.
	export function managedOpaqueArrayElementDropCallee(id GenericInstanceId) returns ByteArray
		match self.managedOpaqueArrayElementOf(id) 'element'
			present(element) then return managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: element)
			absent then panic("ProgramSignatures.managedOpaqueArrayElementDropCallee: instance {id} holds no managed opaque-`T` `Array` field — every caller gates on genericInstanceHasManagedOpaqueArrayField")
		end 'element'
	end 'managedOpaqueArrayElementDropCallee'

	// ⭐ **DOES A MANAGED-OPAQUE-ARRAY-HOLDING INSTANCE HAVE A DEEP-CLONEABLE ELEMENT (P1.7 slice 3b-vi-b-β)?**
	// The GATE on the descriptor `copyFunc@32` stamp AND on the cloner DCE-root (`rootManagedOpaqueArrayElementClones`)
	// — the CLONE dual of the reloc-need predicate `genericInstanceHasManagedOpaqueArrayField`. `copyFunc@32` is
	// stamped, and the element's `__clone_<T>` SYNTHESIZED, only when the element is deep-cloneable by this rung's
	// single-`(box) -> newBox` mechanism: a String / boxed-union / struct / trivial-element-array element WHOSE WHOLE
	// reachable type graph is itself clonable. It MUST read the SAME full-graph classifier the front-end reject
	// (`genericTypeFieldHasUncopyableInstantiation`) and the concrete gate (`arrayElementSupportsDeepClone`) use —
	// `typeSupportsDeepClone(asElement: true)` — NOT merely the element's TOP-LEVEL clone strategy. The reason is the
	// stamp+root synthesizes the cloner UNCONDITIONALLY for every copyable-opaque instance, INCLUDING in a program
	// that never copies (drop-only) and so never reaches the copy-site reject: a struct/union element that is
	// `direct` at the top but owns a non-clonable field (`Array with (Array with String)`, a `Box with String`)
	// would then root a `__clone_<T>` the cloner synthesizer cannot build and PANIC on a valid drop-only program
	// (`noteFieldCloneNeeds`). Reading the full-graph classifier keeps the stamp/root envelope and the reject
	// envelope IDENTICAL, so neither can admit a cloner the other forbids. A non-clonable element's `copyFunc@32`
	// stays 0 — and such an instance is NEVER copied (a base that copies its opaque array with such an
	// instantiation is rejected at the front end off this identical classifier), so the 0 slot is never read. A
	// DROP-only instance of a non-clonable shape (`Container with (Array with String)`, dropped but never copied)
	// thus stamps `destroyFunc@40` but not `copyFunc@32`, exactly right — its element still DROPs through
	// `__arr_decref`, which needs no single-function-pointer form. Reads the SAME `managedOpaqueArrayElementOf`
	// walk as the drop stamp, so the two agree on which element they mean.
	export function genericInstanceOpaqueArrayElementIsCopyable(id GenericInstanceId) returns bool
		var visited = ClonerSet.create()
		match self.managedOpaqueArrayElementOf(id) 'element'
			present(element) then return self.typeSupportsDeepClone(element, asElement: true, visited: visited)
			absent then return false
		end 'element'
	end 'genericInstanceOpaqueArrayElementIsCopyable'

	// ⭐ **THE `.text` ELEMENT CLONER to bake into a managed-opaque-array-holding instance's descriptor
	// `copyFunc@32` (P1.7 slice 3b-vi-b-β)** — the exact CLONE dual of `managedOpaqueArrayElementDropCallee`. The
	// direct `(box) -> newBox` clone callee of the array's SUBSTITUTED element (a String → `__str_clone`, a
	// managed struct/union → its `__clone_<T>`, a trivial-element nested Array → `__arr_clone`), which the shared
	// opaque-copy wrapper reads back and `callIndirect`s per element. Routed through the SAME
	// `managedFieldCloneStrategy` a concrete `Array with String` element uses (`arrayElementCloneStrategy`), so
	// the opaque stamp and the concrete stamp name the identical cloner. Precondition:
	// `genericInstanceOpaqueArrayElementIsCopyable(id)` — a `managedArray`/`unsupported` element panics as an
	// invariant break, exactly as `Parser.arrayElementCloneValue` does for the concrete top-level element.
	export function managedOpaqueArrayElementCloneCallee(id GenericInstanceId) returns ByteArray
		match self.managedOpaqueArrayElementOf(id) 'element'
			present(element) then return directCloneCalleeOf(managedFieldCloneStrategy(self, typeNames: self.typeNames, fieldType: element))
			absent then panic("ProgramSignatures.managedOpaqueArrayElementCloneCallee: instance {id} holds no managed opaque-`T` `Array` field — every caller gates on genericInstanceOpaqueArrayElementIsCopyable")
		end 'element'
	end 'managedOpaqueArrayElementCloneCallee'

	// The SUBSTITUTED type whose destructor a managed opaque type-parameter instance bakes into its descriptor
	// `destroyFunc@40` — the ONE walk both the reloc-need predicate (`genericInstanceHasManagedOpaqueArrayField`)
	// and the reloc's destructor (`managedOpaqueArrayElementDropCallee`) read, so neither can drift to a
	// different field. The descriptor carries a SINGLE `destroyFunc@40` slot (one type parameter), and the shared
	// body drops the sole substituted argument through it in TWO field shapes, both resolved here so ONE stamp
	// serves both: an opaque `Array with T` ELEMENT — dropped on `.pop()`/scope-exit (P1.7 slice 3b-ii) — and a
	// BARE opaque `T` field — dropped on reassignment (`self.saved = next`, P1.7 Finding A). Both carry the sole
	// type parameter, so the first managed opaque field of either shape is the destructor the slot needs. (The
	// public predicates keep their "Array" names for their out-of-tree call sites; the mechanism now spans array
	// elements AND bare fields.)
	function managedOpaqueArrayElementOf(id GenericInstanceId) returns ManagedOpaqueArrayElement
		// ⚠ **THIS IS THE SITE THE UNDECLARED HALF OF THE GATE WAS MEASURED ON.**
		// `noteDestructorUsage`'s `rootManagedOpaqueArrayElementDrops` calls this over EVERY interned
		// instance, so it meets whatever a `with` named: a `Set with Int` (synthesized — no base struct to
		// iterate) and equally a `Map with (Int, Int)` or a misspelled `Foo with Int` (undeclared — E2055
		// already recorded, the build already doomed). Both hold no managed opaque `T` field, and both used
		// to reach `baseLayoutOf` below; the second killed the compiler with a stack trace instead of
		// printing the diagnostic it had already written. See `genericInstanceHasBaseLayout`.
		if not self.genericInstanceHasBaseLayout(id) 'noFields'
			return ManagedOpaqueArrayElement.absent
		end 'noFields'
		let layout = self.baseLayoutOf(id)
		for i in 0 upto layout.fieldCount() 'eachField'
			let fieldType = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.managedOpaqueArrayElementOf: fieldTypes.get OOB at {i}")
			// An opaque `Array with T` field: the descriptor drops each ELEMENT (P1.7 slice 3b-ii).
			if self.fieldTypeIsArray(fieldType) 'arrayField'
				let element = self.arrayElementType(self.arrayInstanceOfFieldType(fieldType))
				if maxonTypeTag(element) == ValueTypeTag.typeParameter and self.genericInstanceArgIsOwned(id, position: typeNameIdOf(element)) 'managedArrayElement'
					return ManagedOpaqueArrayElement.present(self.substitutedInstanceArg(id, position: typeNameIdOf(element)))
				end 'managedArrayElement'
				continue
			end 'arrayField'
			// A BARE opaque `T` field (`saved as Element`): a reassignment drops the field ITSELF through the SAME
			// descriptor `destroyFunc@40` (P1.7 Finding A) — the sole type argument's destructor, exactly as above.
			if maxonTypeTag(fieldType) == ValueTypeTag.typeParameter and self.genericInstanceArgIsOwned(id, position: typeNameIdOf(fieldType)) 'managedBareField'
				return ManagedOpaqueArrayElement.present(self.substitutedInstanceArg(id, position: typeNameIdOf(fieldType)))
			end 'managedBareField'
		end 'eachField'
		return ManagedOpaqueArrayElement.absent
	end 'managedOpaqueArrayElementOf'

	// ⭐ **THE ONE "does this type own droppable heap?" CLASSIFIER.** A String (`__str_decref`), a struct
	// box (a struct is always a heap box, dropped through its `__destruct_<T>` or the trivial
	// `__mm_decref`), a boxed union, and a GENERIC INSTANCE (a base-struct box, P1.6-B2, dropped through
	// its own instance destructor or `__mm_decref`) are managed; a scalar (int/bool/float/ExitCode, a
	// ranged alias, a payload-free enum), a function code pointer, and an opaque type PARAMETER (a borrow
	// at this rung) are not. `structFieldIsManaged` (a struct field), `classifyUnionPayload` (a union
	// payload) and the generic-instance field classification all delegate here, so "managed" means ONE
	// thing across struct, union and instance — the dropped set, the moved-in set and the usage gates
	// agree by construction.
	//
	// ⚠⚠ **`from` IS THE INTERNER `fieldType`'s `named` ID WAS MINTED AGAINST, AND IT IS A PARAMETER
	// BECAUSE THE ANSWER IS OTHERWISE DECIDED BY INTERNING ORDER.** A `named` type is only a NUMBER; the
	// name — and with it struct-hood, union-hood and alias-hood — comes out of the table that assigned it.
	// This index's own callers pass `self.typeNames`; a caller holding a type that has been ADOPTED into a
	// file-local artifact interner (`fieldTypeOf(…, into:)`) passes THAT one. It is the same discipline
	// `classifyUnionPayload`, `managedFieldDropCallee` and `foreignNameOf` already state — a type crossing
	// into this index carries the interner named alongside it — and this was the ONE type-taking query
	// that did not, which is exactly how it went wrong:
	//
	// **MEASURED (T1), a cross-file directory project, both directions and both silent.** The parser's
	// field-read guard resolved an artifact-interned id against `self.typeNames`, so the classification
	// followed whatever name held that NUMBER in the program-wide table:
	//   • a scalar `int(0 to 1000)`-alias field (and a payload-free `enum` field) read MANAGED, and a legal
	//     `Gate.twice(21).n` was refused `E2015` — while the byte-identical single-file program ran 42,
	//     because a single file's two tables are folded in the same order and every id coincides;
	//   • a boxed-UNION field read SCALAR, so `requireFieldOutlivesItsRead` ADMITTED the borrow out of a
	//     temporary that D2 exists to refuse — the program compiled and HUNG on the freed box. The verdict
	//     flipped at the FOURTH unrelated `typealias` in the reading file.
	// Both are pinned by `specs-shv2/cross-file-field-classification.md`.
	//
	// It is answered allocation-free for the overwhelming scalar-field majority (a tag test, then a
	// `Map.contains`), exactly as the code it replaced was — which matters because a scalar field must reach
	// the `false` return without boxing a `DeclaredStruct`/`DeclaredEnum`.
	export function typeIsManaged(fieldType MaxonType, from TypeNameInterner) returns bool
		let tag = maxonTypeTag(fieldType)
		// `tagIsByteRecord`: "does this own heap?" is a question about the REPRESENTATION, and a Character
		// owns exactly the record a String does. This is the root every other managed classifier delegates
		// to, so answering "no" here would leak a Character field, element and payload at once.
		if tagIsByteRecord(tag) or tagIsStructRef(tag) or tag == ValueTypeTag.genericInstance 'byteRecordStructOrInstance'
			return true
		end 'byteRecordStructOrInstance'
		if tag != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		// The three lookups below are keyed by the NAME, so they are interner-independent once it is in hand
		// — `classifyUnionPayload`'s arrangement, for its reason.
		// ⭐ A TUPLE-ALIAS field (`export var p as Pair`, A3e) resolves to the tuple's own name here, so the
		// struct arm below answers it — a tuple IS a struct box, and left unresolved it read as a scalar, the
		// field was dropped by nobody and the program exited 101 on the leak gate. See `denotedAggregateName`.
		let name = self.denotedAggregateName(foreignNameOf(from, id: typeNameIdOf(fieldType)))
		if self.structTypes.contains(name) 'namedStruct'
			return true
		end 'namedStruct'
		if not self.enumTypes.contains(name) 'notEnum'
			// A GENERIC-INSTANCE-alias field arrives as a `named` (the SWEEP recorded the layout before the
			// alias was interned) — a generic instance is a heap box (an `Array`'s record + buffer, a `Box`'s
			// box), so it is managed and dropped by the struct's cascade. Any other `named` (a ranged int/float
			// alias) is a scalar and not managed.
			return self.isGenericAlias(name)
		end 'notEnum'

		let enumLayout = try self.enumTypes.get(name) otherwise panic("ProgramSignatures.typeIsManaged: enumTypes.contains({String.from(name)}) is true but get failed")
		return enumLayout.isBoxed()
	end 'typeIsManaged'

	// Does struct `structName` own droppable heap in ANY field — the union-side `unionHasManagedField`
	// generalised to a struct, and the gate that decides whether the struct needs a `__destruct_<Struct>`
	// cascade at all (a scalar-only struct's drop is the trivial `__mm_decref`). Answered over the index's
	// own interner, allocation-free per scalar field, exactly as `structFieldIsManaged` is — it is the loop
	// around that per-field predicate, kept ONE function so the destructor synthesis, its usage gate and the
	// caller-side drop routing agree on what "managed" means by construction.
	//
	// The struct is a precondition, not a case: every caller reached here through a `structOf` that answered
	// `declared`.
	export function structHasManagedField(structName ByteArray) returns bool
		let layout = try self.structTypes.get(structName) otherwise panic("ProgramSignatures.structHasManagedField: no `type {String.from(structName)}` is declared — every caller asks `structOf` first")
		for i in 0 upto layout.fieldCount() 'eachField'
			if self.structFieldIsManaged(structName, index: i) 'managed'
				return true
			end 'managed'
		end 'eachField'
		return false
	end 'structHasManagedField'

	// ⭐ **THE UNION TWIN OF `structHasManagedField`, AND BY NAME FOR THE IDENTICAL REASON**: the layout comes
	// out of THIS index's own `enumTypes` and is read over THIS index's own interner, so a caller cannot pair
	// a layout from one registry with an interner from another. The free `unionHasManagedField` still takes
	// both, because its other callers legitimately hold a PROJECT layout and pass `project.typeNames` — a
	// correctly-matched pair. This is the entry for a caller that holds only a NAME.
	//
	// ⚠⚠ **THE PAIRING THIS REPLACES WAS A REACHABLE COMPILER PANIC ON A VALID PROGRAM, MEASURED (T1 review).**
	// `managedNameDropCallee`'s STRUCT arm already asked by name (`structHasManagedField`); its UNION arm
	// fetched `enumOf(name)`'s layout — a SIGNATURES layout — and resolved that layout's payload ids against
	// the CALLER's `project.typeNames`. In ONE file the two tables fold in the same order and every id
	// coincides; ACROSS files they diverge, so a `some(v Num)` payload whose `Num` is a ranged alias
	// misresolved and the union read MANAGED, demanding a `__destruct_<U>` — while `installUnionDestructors`
	// asked the SAME question over the correctly-paired PROJECT layout, read SCALAR, and synthesized nothing.
	// The two answers then linked against each other:
	//   `panic at Arm64Backend: arm64ResolveCallFixups: bl to unknown function '__destruct_Payloaded'`
	// on a two-file program containing no error at all. It is OPEN #56's mismatch — the one
	// `managedStructFieldDropCallee` closed for the struct arm — surviving in the arm nobody closed it for,
	// and it is the same "an id is only a number without its table" defect T1 fixed one door along. Asking by
	// NAME makes the mispairing UNREPRESENTABLE rather than correct-by-convention.
	//
	// The union is a precondition, not a case: the sole caller reached here through an `enumOf` that answered
	// `declared`.
	export function unionHasManagedPayload(unionName ByteArray) returns bool
		let layout = try self.enumTypes.get(unionName) otherwise panic("ProgramSignatures.unionHasManagedPayload: no `union {String.from(unionName)}` is declared — the caller asks `enumOf` first")
		return unionHasManagedField(self, typeNames: self.typeNames, layout: layout, wantStringOnly: false)
	end 'unionHasManagedPayload'

	// ⭐ **CAN A MANAGED-ELEMENT `Array with T` BE DEEP-CLONED by this rung's mechanism (P1.7 slice 3b-vi-b)?**
	// The FRONT-END gate for a managed `slice`/`clone`/`append`, and the exact envelope the cloner synthesis
	// handles — the two agree so the synthesizer never meets an `unsupported` field on a program the front end
	// accepted (else it would panic, a compiler crash on valid input). The element is invoked through
	// `callIndirect` (`asElement: true`), so it must be `direct`-cloneable (String / struct / union / trivial-
	// element array), and its whole reachable type graph must be clonable too. Precondition:
	// `arrayElementIsManaged` (a trivial-element array never needs this — its copy is a byte blit).
	export function arrayElementSupportsDeepClone(id GenericInstanceId) returns bool
		return self.typeSupportsDeepClone(self.arrayElementType(id), asElement: true, visited: ClonerSet.create())
	end 'arrayElementSupportsDeepClone'

	// Recursively: can a value of `type` be deep-cloned? A scalar owns no heap (nothing to clone); a String is a
	// `direct` leaf; a struct/union is clonable iff every managed field/payload is; a trivial-element Array is a
	// `direct` leaf; a managed-element Array is clonable iff its element is itself `direct`-clonable AND clonable
	// (an array-of-managed-arrays is not, this rung); a non-Array generic instance (`Box with String`) is not (a
	// later slice). `asElement` is true when `type` is reached as an ARRAY ELEMENT (invoked through
	// `callIndirect`), which a `managedArray`-strategy type — a managed-element array — cannot satisfy. `visited`
	// (struct/union NAMES) breaks a recursive type (`type Node { var next as Node }`): a name already in flight
	// is assumed clonable, so the walk terminates, and the synthesized cloner recurses at RUN time through the
	// same field, which is correct.
	export function typeSupportsDeepClone(type MaxonType, asElement bool, visited ClonerSet) returns bool
		let tag = maxonTypeTag(type)
		if not self.typeIsManaged(type, from: self.typeNames) 'trivialLeaf'
			return true
		end 'trivialLeaf'
		if tagIsByteRecord(tag) 'byteRecord'
			return true
		end 'byteRecord'
		if tag == ValueTypeTag.genericInstance 'instance'
			return self.instanceSupportsDeepClone(typeNameIdOf(type), asElement: asElement, visited: visited)
		end 'instance'
		if not (tagIsStructRef(tag) or tag == ValueTypeTag.named) 'notManagedRef'
			return false
		end 'notManagedRef'
		// Resolved through `denotedAggregateName`, the same door the clone strategy this gate admits reads
		// (`managedFieldCloneStrategy`) — a name the gate and the strategy disagreed about would admit a clone
		// nobody can emit.
		let name = self.denotedAggregateName(try self.typeNames.nameOf(typeNameIdOf(type)) otherwise panic("ProgramSignatures.typeSupportsDeepClone: a managed type's id is not in this index's interner"))
		if self.isGenericAlias(name) 'genericAlias'
			return self.instanceSupportsDeepClone(self.genericAliasInstance(name), asElement: asElement, visited: visited)
		end 'genericAlias'
		if visited.contains(name) 'cycle'
			return true
		end 'cycle'
		visited.insert(name)
		if self.containsStruct(name) 'struct'
			return self.structFieldsSupportDeepClone(name, visited: visited)
		end 'struct'
		match self.enumOf(name) 'union'
			declared(layout) then return self.unionPayloadsSupportDeepClone(layout, visited: visited)
			undeclared then return false
		end 'union'
	end 'typeSupportsDeepClone'

	// An `Array` instance recurses into its element (a trivial one is a clonable leaf; a managed one must be a
	// `direct`-clonable element via `asElement: true`); any other instance (`Box with String`) is a later slice.
	function instanceSupportsDeepClone(id GenericInstanceId, asElement bool, visited ClonerSet) returns bool
		if not self.isArrayInstance(id) 'notArray'
			return false
		end 'notArray'
		if not self.arrayElementIsManaged(id) 'trivialElement'
			return true
		end 'trivialElement'
		// A managed-element array clones its elements through `__arr_clone_managed(field, funcAddr(elementClone))`
		// — a 2-arg call, so it cannot itself be an outer array element (invoked through `callIndirect`).
		if asElement 'nestedManagedArrayElement'
			return false
		end 'nestedManagedArrayElement'
		return self.typeSupportsDeepClone(self.arrayElementType(id), asElement: true, visited: visited)
	end 'instanceSupportsDeepClone'

	function structFieldsSupportDeepClone(structName ByteArray, visited ClonerSet) returns bool
		let layout = try self.structTypes.get(structName) otherwise panic("ProgramSignatures.structFieldsSupportDeepClone: no `type {String.from(structName)}` is declared — the caller reached here through a declared struct name")
		for i in 0 upto layout.fieldCount() 'eachField'
			if not self.structFieldIsManaged(structName, index: i) 'scalar'
				continue
			end 'scalar'
			let fieldType = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.structFieldsSupportDeepClone: fieldTypes.get OOB at {i}")
			if not self.typeSupportsDeepClone(fieldType, asElement: false, visited: visited) 'unsupportedField'
				return false
			end 'unsupportedField'
		end 'eachField'
		return true
	end 'structFieldsSupportDeepClone'

	function unionPayloadsSupportDeepClone(layout EnumLayout, visited ClonerSet) returns bool
		for ci in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(ci)
			for fi in 0 upto payloads.count() 'eachField'
				let field = try payloads.get(fi) otherwise panic("ProgramSignatures.unionPayloadsSupportDeepClone: payloadsAt count disagrees with get at {fi}")
				if not payloadClassIsManaged(classifyUnionPayload(self, typeNames: self.typeNames, fieldType: field.declaredType)) 'scalar'
					continue
				end 'scalar'
				if not self.typeSupportsDeepClone(field.declaredType, asElement: false, visited: visited) 'unsupportedPayload'
					return false
				end 'unsupportedPayload'
			end 'eachField'
		end 'eachCase'
		return true
	end 'unionPayloadsSupportDeepClone'

	// The declared return type of `callee`, ADOPTED into `into` — the calling file's own artifact
	// interner. THE one door out of this index (see the header): a `named` type crosses by NAME and
	// is re-interned on arrival, so the id the parser stores is one its own file's merge will
	// resolve.
	export function returnTypeOf(callee ByteArray, into TypeNameInterner) returns CalleeReturn
		let declared = try self.returnTypes.get(callee) otherwise return CalleeReturn.undeclared
		return CalleeReturn.declared(self.adoptReturnType(declared, into: into))
	end 'returnTypeOf'

	// Does ANY file declare a function under `callee` — the `bool` half of `returnTypeOf`, and its twin
	// in the sense `containsEnum` is `enumOf`'s: a caller that only needs "does this name resolve to a
	// call at all?" must not pay the answer's cost to throw it away. `returnTypeOf` ADOPTS the return
	// type into the asker's interner, which allocates for every id-bearing arm and needs an interner the
	// asker may not even have in hand; a `Map.contains` allocates nothing and needs none.
	//
	// ⚠ **IT IS ASKED OF A MANGLED name (`Widget.byteLength`), never a bare one**, because that is the
	// key the index files a method under (`declaredMethodName`) — see `Parser.staticCallClaimsBase` for why a
	// static call's existence has to be decidable before the call is parsed.
	//
	// Its other two askers are the reserved-callee door and the `try` target's throws check
	// (`Parser.requireCalleeIsNotReservedName`, `Parser.requireThrowingNamedTryTarget`), both of which need
	// exactly this — "is there a declaration behind this name?" — on a per-call path, and neither of which
	// has an interner to adopt into or a use for what would be adopted.
	export function declaresCallee(callee ByteArray) returns bool
		return self.returnTypes.contains(callee)
	end 'declaresCallee'

	function adoptReturnType(rt MaxonReturnType, into TypeNameInterner) returns MaxonReturnType
		return match rt 'r'
			void gives rt
			value(inner) gives self.adoptValueReturn(rt, inner: inner, into: into)
		end 'r'
	end 'adoptReturnType'

	// Only the ID-BEARING arms are rebuilt. Every other return type is already interner-free, and
	// the STORED union is handed straight back — which is what keeps the per-call path from
	// allocating a fresh `MaxonReturnType` for every `returns bool` in the program (a Maxon union
	// value is a heap object, every case — see MaxonDialect's ValueTypeTag header).
	//
	// ⚠ It cannot simply delegate to `adoptType` and re-wrap unconditionally: that would CONSTRUCT a
	// `MaxonReturnType.value(...)` for every callee in the program, id-bearing or not, which is the
	// allocation the `rt` pass-through exists to avoid. So the id-free arms answer with `rt` here,
	// and `adoptType` answers with `t` there — two functions, one rule, each returning the union it
	// was actually handed.
	//
	// ⚠ The two id-bearing arms are written out, NOT collapsed to a `named to structRef` range:
	// `exitCode` and `unresolved` sit BETWEEN them in `MaxonType`, so that range would silently
	// swallow both and re-wrap them into a freshly allocated union — the band-append invariant,
	// costing an allocation rather than a wrong answer this time.
	function adoptValueReturn(rt MaxonReturnType, inner MaxonType, into TypeNameInterner) returns MaxonReturnType
		return match inner 'r'
			named gives MaxonReturnType.value(self.adoptType(inner, into: into))
			structRef gives MaxonReturnType.value(self.adoptType(inner, into: into))
			boolean to float gives rt
			exitCode to unresolved gives rt
			// A `String` return type carries no interned name (it is a builtin, like a primitive), so
			// crossing files needs no re-interning — it passes through unchanged.
			string gives rt
			// A FUNCTION return type carries its governing name id (P1.5-A1), so it re-interns like `named`.
			function gives MaxonReturnType.value(self.adoptType(inner, into: into))
			// A TYPE-PARAMETER / GENERIC-INSTANCE return type (P1.6-A) — `get() returns T`. Neither carries a
			// per-file interner id (a POSITION / a whole-program giid), so like a primitive it crosses files
			// unchanged. `adoptType` handles both identically; routing through it keeps the one crossing door.
			typeParameter gives MaxonReturnType.value(self.adoptType(inner, into: into))
			genericInstance gives MaxonReturnType.value(self.adoptType(inner, into: into))
			// A `Character` return type carries no interned name either — it crosses files unchanged.
			character gives rt
		end 'r'
	end 'adoptValueReturn'

	// Re-intern the name an id-bearing `MaxonType` carries into `into`, so the type is
	// indistinguishable from one the calling file had parsed itself. THE one place this index's ids
	// cross out of it (see the header's ID PROBLEM); its callers — `fieldTypeOf`, `adoptValueReturn`
	// (for `returnTypeOf`), and the parser's union-payload sites — re-intern a member/return/payload
	// type by NAME, and none re-derives it. It re-interns by NAME, never leaking a raw id, so the
	// returned type's id belongs to `into` and the "an id may not leave this type" invariant holds.
	//
	// Exported for the union-payload sites: unlike a struct field or a return type, a union payload's
	// `declaredType` is already in the caller's hand (it fetched the layout and walked `payloadsAt`),
	// so it needs this bare crossing rather than a name+index fetch door like `fieldTypeOf`. Routing
	// those sites through here is what stopped a signatures-interner payload id being classified /
	// minted against the parser's own interner (OPEN #52).
	export function adoptType(t MaxonType, into TypeNameInterner) returns MaxonType
		return match t 'r'
			named(id) gives MaxonType.named(into.intern(self.nameOfId(id)))
			// ⭐ **A TUPLE `structRef` IS CANONICALIZED ON THE WAY OUT (P1.10), and this door is where it has
			// to be.** A tuple minted by the DECLARATION SWEEP names its elements the way the source spelled
			// them, because the registries that say what those spellings MEAN are still being built when the
			// sweep runs (see `internTupleType`). Every sweep-recorded type reaches a reader through here — a
			// call RESULT via `adoptValueReturn`, a struct FIELD via `declaredSlotType` — so rewriting it once,
			// here, is what makes `let t = makePair(…)` and a locally-built `(10, 32)` the same type. It is the
			// same arrangement `declaredSlotType`'s re-tags live under, one tier down.
			structRef(id) gives MaxonType.structRef(into.intern(self.canonicalNameOfStruct(self.nameOfId(id))))
			boolean to float gives t
			exitCode to unresolved gives t
			// A `String` carries no name id, so like a primitive it passes through unchanged.
			string gives t
			// A FUNCTION value carries its governing name id (P1.5-A1), re-interned by NAME like `named`.
			function(id) gives MaxonType.function(into.intern(self.nameOfId(id)))
			// A type-parameter reference and a generic instance (P1.6-A) carry GLOBAL ids — a param
			// POSITION and a `GenericInstanceId` keyed on THIS index's own registry — not per-file
			// interner ids, so there is nothing to remap: they pass through unchanged, like a primitive.
			typeParameter gives t
			genericInstance gives t
			// A `Character` carries no name id, so like a primitive it passes through unchanged.
			character gives t
		end 'r'
	end 'adoptType'

	// Mix one declaration into the running hash: the function's NAME, then its return type's SHAPE,
	// then — for a named type — that TYPE's name. Names, never ids: an id depends on the order the
	// index happened to intern in, so hashing one would let a new declaration in an unrelated file
	// shift every later id and invalidate every parse memo in the project for nothing.
	//
	// ⚠ **THE BUFFER SPELLING MUST RIDE, AND IT IS THE ONE FACT HERE THE RETURN TYPE CANNOT CARRY (A2j).**
	// `returns __ManagedMemory` and `returns ByteArray` resolve to the SAME `genericInstance`, so
	// `mixReturnType` folds them identically — an edit from one to the other would move no hash, and every
	// caller's parse memo would stay valid while what its calls MEAN had changed. Its own discriminator pair,
	// for `DeclShapeAlias`'s reason.
	function mixDeclaration(state ContentHash, name ByteArray, returnType MaxonReturnType, declaredSurface DeclaredSurface) returns ContentHash
		let named = self.mixReturnType(mixBytes(state, bytes: name), returnType: returnType)
		return mixSurface(mix(named, value: ReturnShapeSurface), surface: declaredSurface)
	end 'mixDeclaration'

	function mixReturnType(state ContentHash, returnType MaxonReturnType) returns ContentHash
		return match returnType 'r'
			void gives mix(state, value: ReturnShapeVoid)
			value(inner) gives self.mixType(mix(state, value: ReturnShapeValue), t: inner)
		end 'r'
	end 'mixReturnType'

	function mixType(state ContentHash, t MaxonType) returns ContentHash
		return match t 'r'
			boolean gives mix(state, value: TypeShapeBoolean)
			integer gives mix(state, value: TypeShapeInteger)
			float gives mix(state, value: TypeShapeFloat)
			named(id) gives mixBytes(mix(state, value: TypeShapeNamed), bytes: self.nameOfId(id))
			exitCode gives mix(state, value: TypeShapeExitCode)
			// `Parser.parseTypeReference` produces only `named` and the three primitive keywords, so
			// a SCANNED signature can never carry `unresolved` — TypeResolution is what mints those,
			// and it runs long after this. The arm exists because the match is exhaustive, and it
			// hashes rather than panicking so that a future producer of `unresolved` signatures is a
			// cache-key question, not a crash.
			unresolved gives mix(state, value: TypeShapeUnresolved)
			// A struct reference, which a scanned signature very much CAN carry: `static function
			// create(…) returns Self` inside `type Point` is recorded as `structRef(Point)` by
			// `Parser.parseTypeReference`, so every declared factory in the program hashes through
			// here. Its own shape (see `TypeShapeStructRef`) and then its NAME — never its id, for
			// `mixDeclaration`'s reason.
			structRef(id) gives mixBytes(mix(state, value: TypeShapeStructRef), bytes: self.nameOfId(id))
			// A `String` (P1.2 wave A) — its own shape, and no name to mix (a builtin carries none). A
			// signature declaring `returns String` hashes distinctly from every other return type.
			string gives mix(state, value: TypeShapeString)
			// A FUNCTION value (P1.5-A1) — its own shape, then its governing NAME (never its id, for
			// `mixDeclaration`'s reason).
			function(id) gives mixBytes(mix(state, value: TypeShapeFunction), bytes: self.nameOfId(id))
			// A TYPE-PARAMETER reference (P1.6-A) — its own shape, then its POSITION. The position is a
			// stable identity (declaration order), NOT a global id, so hashing it does not over-invalidate:
			// `uses A, B`'s `returns A` (position 0) and `returns B` (position 1) hash apart.
			typeParameter(id) gives mix(mix(state, value: TypeShapeTypeParameter), value: id)
			// A GENERIC INSTANCE (P1.6-A) — its own shape, then its base NAME (never its id) and each ARG's
			// shape (recursed), so `Box with Integer` and `Box with Bool` hash apart. `mixGenericInstance`
			// reads the `(baseId, args)` payload out of THIS index's own registry.
			genericInstance(id) gives self.mixGenericInstance(mix(state, value: TypeShapeGenericInstance), id: id)
			// A `Character` (P1.8 slice B) — its own shape, and no name to mix. It hashes DISTINCTLY from
			// `string`: the two share a record but not a type (see `TypeShapeCharacter`).
			character gives mix(state, value: TypeShapeCharacter)
		end 'r'
	end 'mixType'

	// Fold a generic instance's base name and args into the hash — the recursive half of `mixType`'s
	// `genericInstance` arm, split out because it decodes the registry and folds a list.
	function mixGenericInstance(state ContentHash, id GenericInstanceId) returns ContentHash
		var out = mixBytes(state, bytes: self.nameOfId(self.genericInstances.instanceBaseId(id)))
		for arg in self.genericInstances.instanceArgs(id) 'eachArg'
			out = self.mixType(out, t: arg)
		end 'eachArg'
		return out
	end 'mixGenericInstance'

	// A struct name as a READER outside this index must see it: a TUPLE name is canonicalized (P1.10), every
	// other name is itself. Split out of `adoptType`'s arm so the `__Tuple` prefix test — which every
	// `structRef` crossing pays — is one `bytesStartWith` and states why it is there.
	//
	// The `allFilesFolded` gate is the same one every whole-program answer is behind: before it, a tuple's
	// canonical form is not yet computable and the sweep's own reads must see the spelling the sweep minted.
	function canonicalNameOfStruct(name ByteArray) returns ByteArray
		if not self.allFilesFolded or not isTupleTypeName(name) 'notACanonicalizableTuple'
			return name
		end 'notACanonicalizableTuple'
		return self.canonicalTupleName(name)
	end 'canonicalNameOfStruct'

	function nameOfId(id TypeNameId) returns ByteArray
		return try self.typeNames.nameOf(id) otherwise panic("ProgramSignatures: type-name id {id} is not in this index's own interner — every id it stores was minted by foldFile's fold into that table")
	end 'nameOfId'
end 'ProgramSignatures'
