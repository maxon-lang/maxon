export let ManagedMemoryFieldName = b"managed"

// ⭐ **THE ONE PLACE THAT ANSWERS "is this a compiler builtin MANAGED type?"** — read by
// `Parser.requireConstructible` to raise E3072, and the list a later slice extends when
// `__ManagedMemory` and `__ManagedDirectory` arrive (E3072's own registry doc already names all three).
//
// ⚠ **DELIBERATELY NOT FOLDED INTO `isCompilerOwnedTypeName`, and the distinction is load-bearing rather
// than tidy.** That predicate answers "does the compiler RESERVE this name?" — it gates D4's
// undeclared-name verdict and `requireTypeNameNotCompilerOwned`'s refusal of a user declaration binding
// one of its six. This one answers "is this an opaque OS-handle type a struct literal may never build?".
// The two sets are disjoint today (none of those six is managed, and this type is not reserved under a
// bare alias) and they are asked at different doors for different reasons; merging them would give one
// predicate two meanings and make the next `CharacterSet`-shaped misreport inevitable.
export function isBuiltinManagedTypeName(name ByteArray) returns bool
	return name.equals(ManagedFileTypeName) or name.equals(ManagedDirectoryTypeName)
end 'isBuiltinManagedTypeName'

// Its one field, per the spec's "Type Structure". Unexported and immutable: the corpus never reads or
// writes it — `__ManagedFile{_handle: 0}` is E3072 (`managed-file.error-direct-construction`) precisely
// so the handle cannot be forged — and the runtime reaches it through `ManagedFileHandleOffset`.
export let ManagedFileHandleFieldName = b"_handle"
export let ManagedFileHandleFieldIndex = 0 as FieldIndex

// ⭐ **THE COMPILER-OWNED `__ManagedDirectory` TYPE (R4.3)** — an 8-byte box holding one pointer to a
// separately allocated FIND BLOCK (the search handle, the `WIN32_FIND_DATAA` the OS refills, and the
// advance-first pending flag), with a runtime-owned destructor that closes the search on drop.
// `specs/managed-directory.md`'s "Type Structure" states the single `_block` field and the RAII contract;
// `ManagedDirectoryRuntime`'s header states why the record is two-level and why the two references disagree
// about it.
//
// ⚠ Like `__ManagedFile` and unlike `__StringIndex`/`__CharacterSet`, the registry name and the user-facing
// name are the SAME bytes — which is what lets the type cross a function boundary, and the corpus requires
// exactly that: `specs/managed-directory.md`'s `search-and-list` declares `export var dir as
// __ManagedDirectory` and returns a `TestDir` built from one.
export let ManagedDirectoryTypeName = b"__ManagedDirectory"

