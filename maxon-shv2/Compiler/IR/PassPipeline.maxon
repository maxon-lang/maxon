// PassPipeline — the stateful driver for a compilation. It owns the evolving IR
// modules (one per tier), the scheduled pass list, and a `dispatch` that runs each
// pass by reading one module field and writing the next. Callers build a
// PassPipeline, push the passes they want via `addPass`/`addPasses`, and call
// `run()`.
//
// Pipeline phases (3-level IR: Maxon → Std → Target):
//   Phase 2  Maxon-level  : resolveTypes, semanticCheck  (operate on maxonModule)
//   Phase 3  Maxon → Std  : lowerMaxonToStd              (maxonModule → stdModule)
//   Phase 7  Std → Target : handled directly by the backend (not pipeline passes)
//
// PHI RESOLUTION moved OUT of the pipeline at M5: the register allocator consumes
// `blockArgs`/`branchEdges` DIRECTLY and does SSA destruction after coloring, so
// the M4b `eliminatePhis` Std pass is retired (it eagerly inserted edge copies and
// cleared the phi model before the backend, which the biased colorer needs intact).
//
// There is NO MIR tier — see StdDialect's header. v1's `lowerStdToMir` pass and
// `mirModule` field are gone, and everything v1 ran ON the MIR tier (instruction
// scheduling, coalescing, and the desugaring that becomes `lowerToMachineForm`)
// becomes a Std-tier pass scheduled here.
//
// THIN for maxon-shv2 M1: only the passes the `return 42` slice needs are
// scheduled, and only `lowerMaxonToStd` does real work. resolveTypes /
// semanticCheck are SCHEDULED PLACEHOLDERS whose bodies are a Chunk C deliverable
// (TypeResolution + SemanticCheck) — present now so the pipeline SHAPE is stable
// and Chunk C fills in bodies rather than rewiring the pipeline. The Std-tier
// optimization passes (mem2reg/canonicalize/cse/…), the Own-tier passes, and
// `lowerToMachineForm` GROW in at their milestones (M3+ / M6). Error gating
// (`hasErrors` → throw) and per-pass IR-compaction/dump grow in with the Project +
// diagnostics (Chunk C).

// One arm per scheduled pass. Payload-free today; kept a `union` (not an enum)
// to match v1 and leave room for passes that carry configuration payloads.
export union PassKind
	// Phase 2: Maxon-level. Chunk C bodies (placeholders in M1).
	resolveTypes
	semanticCheck
	// Phase 3: Maxon → Std.
	lowerMaxonToStd
	// Phase 3.5: Std → Std machine-form rewrites. `foldConstOperands` moves a const
	// operand into an immediate so the literal needs no register — the first of the
	// Std-tier passes the design schedules after lowering (before the backend).
	foldConstOperands
end 'PassKind'

export typealias PassKindArray = Array with PassKind

// Whether a pass runs over the whole module at once or can fan out per function.
// `perFunction` passes are intra-function only (no pass reaches into another
// function's blocks); they will run through the per-function fan-out driver
// added at M5. `wholeModule` passes need call-graph / cross-function visibility.
export enum PassClassification
	wholeModule
	perFunction
end 'PassClassification'

// Map a pass to its fan-out classification. resolveTypes / semanticCheck are
// whole-module (they need the full declaration set); the lowering is
// intra-function and becomes the first fan-out target at M5. NOTE: M1's `run()`
// runs EVERY pass whole-module regardless — this classification is recorded for
// the M5 fan-out driver, not yet acted on (per PLAN.md: classification present
// but trivial at M1).
export function classifyPass(pass PassKind) returns PassClassification
	return match pass 'classify'
		resolveTypes gives PassClassification.wholeModule
		semanticCheck gives PassClassification.wholeModule
		lowerMaxonToStd gives PassClassification.perFunction
		foldConstOperands gives PassClassification.perFunction
	end 'classify'
end 'classifyPass'

// Human-readable pass name for logging (union has no `.name`, unlike an enum).
export function passKindToString(pass PassKind) returns String
	return match pass 'name'
		resolveTypes gives "resolveTypes"
		semanticCheck gives "semanticCheck"
		lowerMaxonToStd gives "lowerMaxonToStd"
		foldConstOperands gives "foldConstOperands"
	end 'name'
end 'passKindToString'

// The full pipeline (phases 2-3): the Maxon-level passes plus the Maxon→Std
// lowering. This is the schedule the driver runs to take a parsed MaxonModule
// down to a StdModule, which it then hands to the backend.
//
// The Std-tier passes GROW in HERE, appended after `lowerMaxonToStd`: the
// optimizations (mem2reg/canonicalize/cse/… at M3+), the Own-tier refcount passes
// (M6), and `lowerToMachineForm` (M6) — which in v1 would have been a separate
// "backend pipeline" over the MIR tier. Phase 7 (target lowering / regalloc /
// prologue-epilogue) stays backend-direct: it produces a CodeResult, which is not
// an IR module and so does not fit the module-field dispatch model.
//
// (v1 threads `project` here for `coverageEnabled`; M1's passes do not need it.)
export function buildDefaultPipeline() returns PassKindArray
	var passes = PassKindArray.create()
	passes.push(PassKind.resolveTypes)
	passes.push(PassKind.semanticCheck)
	passes.push(PassKind.lowerMaxonToStd)
	passes.push(PassKind.foldConstOperands)
	return passes
end 'buildDefaultPipeline'

// The pipeline owns the IR modules across their successive phases. It starts with
// `maxonModule` populated by the parser (Chunk C); the lowering pass reads one
// field and populates the next. Unpopulated fields hold empty modules so a read
// never traps. Pass methods read/write `self`'s fields directly — new
// cross-cutting state becomes a new field, not a signature change.
//
// It owns NO target module: the pipeline's last tier is Std, and the backend is
// driven backend-direct (`buildBackend` returns a CodeResult, which is not an IR
// module). A `targetModule` field here would be write-once-read-never — the same
// vestigial-tier residue the `mirModule` field was.
export type PassPipeline
	// The project owns the shared state the Maxon-tier passes read/write
	// (interner, registries, diagnostics). resolveTypes/semanticCheck need it;
	// the lowering does not, but every pass dispatches uniformly through `self`.
	export var project as Project
	export var maxonModule as MaxonModule
	export var stdModule as StdModule
	export var passes as PassKindArray

	export static function create(project Project, maxonModule MaxonModule) returns PassPipeline
		return Self{
			project: project,
			maxonModule: maxonModule,
			stdModule: StdModule.create(),
			passes: PassKindArray.create()
		}
	end 'create'

	export function addPass(pass PassKind)
		self.passes.push(pass)
	end 'addPass'

	export function addPasses(more PassKindArray)
		self.passes.append(more)
	end 'addPasses'

	// Run each scheduled pass in order, gating on diagnostics after each: once a
	// pass reports an error (semanticCheck's E3001/E3002), the pipeline throws
	// rather than lower an invalid module (e.g. one with no `main` for the entry
	// stub to call). The driver catches this, prints the diagnostics, and exits
	// non-zero. Per-pass IR compaction/dump grows in with the backend cache.
	export function run() throws CompileError
		for pass in self.passes 'eachPass'
			logDebug(LogCategory.ir, message: function() gives "=== Running pass: {passKindToString(pass)} ===")
			self.dispatch(pass)
			if projectHasErrors(self.project) 'errorGate'
				throw CompileError.compileError
			end 'errorGate'
		end 'eachPass'
	end 'run'

	// One arm per PassKind. Each reads the incoming module off `self`, runs the
	// standalone pass algorithm, and writes the result back. The pass algorithms
	// stay free functions (reusable outside the pipeline); dispatch just wires
	// them up. resolveTypes/semanticCheck operate on the Maxon module + project;
	// lowerMaxonToStd produces the next tier's module.
	function dispatch(pass PassKind)
		match pass 'dispatch'
			resolveTypes then resolveTypes(self.project, module: self.maxonModule)
			semanticCheck then semanticCheck(self.project)
			lowerMaxonToStd then self.stdModule = lowerMaxonToStd(self.maxonModule)
			foldConstOperands then foldConstOperands(self.stdModule)
		end 'dispatch'
	end 'dispatch'
end 'PassPipeline'
