// PassPipeline — the stateful driver for a compilation. It owns the four
// evolving IR modules (one per tier), the scheduled pass list, and a `dispatch`
// that runs each pass by reading one module field and writing the next. Callers
// build a PassPipeline, push the passes they want via `addPass`/`addPasses`, and
// call `run()`.
//
// Pipeline phases (4-level IR: Maxon → Std → MIR → Target):
//   Phase 2  Maxon-level : resolveTypes, semanticCheck  (operate on maxonModule)
//   Phase 3  Maxon → Std : lowerMaxonToStd              (maxonModule → stdModule)
//   Phase 5  Std → MIR   : lowerStdToMir                (stdModule → mirModule)
//   Phase 7  MIR → Target: handled directly by B2's backend (not pipeline passes)
//
// THIN for maxon-shv2 M1: only the passes the `return 42` slice needs are
// scheduled, and only the two lowerings (lowerMaxonToStd, lowerStdToMir) do real
// work. resolveTypes / semanticCheck are SCHEDULED PLACEHOLDERS whose bodies are
// a Chunk C deliverable (TypeResolution + SemanticCheck) — present now so the
// pipeline SHAPE is stable and Chunk C fills in bodies rather than rewiring the
// pipeline. The Std-tier optimization passes (mem2reg/canonicalize/cse/…), the
// Own-tier passes, `augmentWithRuntime`, and the MIR-tier passes GROW in at
// their milestones (B2 / M3+ / M6). Error gating (`hasErrors` → throw) and
// per-pass IR-compaction/dump grow in with the Project + diagnostics (Chunk C).

// One arm per scheduled pass. Payload-free today; kept a `union` (not an enum)
// to match v1 and leave room for passes that carry configuration payloads.
export union PassKind
	// Phase 2: Maxon-level. Chunk C bodies (placeholders in M1).
	resolveTypes
	semanticCheck
	// Phase 3: Maxon → Std.
	lowerMaxonToStd
	// Phase 5: Std → MIR.
	lowerStdToMir
end 'PassKind'

export typealias PassKindArray = Array with PassKind

export enum PipelinePhase
	maxon
	std
	mir
	target
end 'PipelinePhase'

// The tier a pass reads/writes. `lowerMaxonToStd` and `lowerStdToMir` are the
// boundary passes — classified by the module they PRODUCE (std / mir), so a
// post-pass summary reflects the freshly-populated module. Grows one arm per
// pass added.
export function classifyPhase(pass PassKind) returns PipelinePhase
	return match pass 'phase'
		resolveTypes gives PipelinePhase.maxon
		semanticCheck gives PipelinePhase.maxon
		lowerMaxonToStd gives PipelinePhase.std
		lowerStdToMir gives PipelinePhase.mir
	end 'phase'
end 'classifyPhase'

// Whether a pass runs over the whole module at once or can fan out per function.
// `perFunction` passes are intra-function only (no pass reaches into another
// function's blocks); they will run through the per-function fan-out driver
// added at M5. `wholeModule` passes need call-graph / cross-function visibility.
export enum PassClassification
	wholeModule
	perFunction
end 'PassClassification'

// Map a pass to its fan-out classification. resolveTypes / semanticCheck are
// whole-module (they need the full declaration set); the two lowerings are
// intra-function and become the first fan-out targets at M5. NOTE: M1's `run()`
// runs EVERY pass whole-module regardless — this classification is recorded for
// the M5 fan-out driver, not yet acted on (per PLAN.md: classification present
// but trivial at M1).
export function classifyPass(pass PassKind) returns PassClassification
	return match pass 'classify'
		resolveTypes gives PassClassification.wholeModule
		semanticCheck gives PassClassification.wholeModule
		lowerMaxonToStd gives PassClassification.perFunction
		lowerStdToMir gives PassClassification.perFunction
	end 'classify'
end 'classifyPass'

// Human-readable pass name for logging (union has no `.name`, unlike an enum).
export function passKindToString(pass PassKind) returns String
	return match pass 'name'
		resolveTypes gives "resolveTypes"
		semanticCheck gives "semanticCheck"
		lowerMaxonToStd gives "lowerMaxonToStd"
		lowerStdToMir gives "lowerStdToMir"
	end 'name'
end 'passKindToString'

// The mid-level pipeline (phases 2-3): the Maxon-level passes plus the
// Maxon→Std lowering. Grows the Std-tier optimization + Own-tier passes as they
// land. (v1 threads `project` here for `coverageEnabled`; M1 has no Project yet.)
export function buildMidPipeline() returns PassKindArray
	var passes = PassKindArray.create()
	passes.push(PassKind.resolveTypes)
	passes.push(PassKind.semanticCheck)
	passes.push(PassKind.lowerMaxonToStd)
	return passes
end 'buildMidPipeline'

// The backend pipeline (phase 5): the Std→MIR lowering. B2 grows this with
// `augmentWithRuntime` (supplies the entry point) and the MIR-tier passes;
// phase 7 (target lowering / regalloc / prologue-epilogue) is driven directly
// by the backend, not as pipeline passes.
export function buildBackendPipeline() returns PassKindArray
	var passes = PassKindArray.create()
	passes.push(PassKind.lowerStdToMir)
	return passes
end 'buildBackendPipeline'

// The full pipeline: mid + backend. This is the schedule Chunk C's driver runs
// to take a parsed MaxonModule down to a MirModule (and, once B2 lands, to a
// TargetModule + CodeResult).
export function buildDefaultPipeline() returns PassKindArray
	var passes = buildMidPipeline()
	passes.append(buildBackendPipeline())
	return passes
end 'buildDefaultPipeline'

// The pipeline owns the four IR modules across their successive phases. It
// starts with `maxonModule` populated by the parser (Chunk C); each lowering
// pass reads one field and populates the next. Unpopulated fields hold empty
// modules so a read never traps. Pass methods read/write `self`'s fields
// directly — new cross-cutting state becomes a new field, not a signature change.
export type PassPipeline
	export var maxonModule as MaxonModule
	export var stdModule as StdModule
	export var mirModule as MirModule
	export var targetModule as TargetModule
	export var passes as PassKindArray

	export static function create(maxonModule MaxonModule) returns PassPipeline
		return Self{
			maxonModule: maxonModule,
			stdModule: StdModule.create(),
			mirModule: MirModule.create(),
			targetModule: TargetModule.create(),
			passes: PassKindArray.create()
		}
	end 'create'

	export function addPass(pass PassKind)
		self.passes.push(pass)
	end 'addPass'

	export function addPasses(more PassKindArray)
		self.passes.append(more)
	end 'addPasses'

	// Run each scheduled pass in order. M1 has no error gating (there is no
	// Project / diagnostics sink yet) and no per-pass IR compaction; Chunk C
	// adds the `hasErrors → throw CompileError` gate and B2 the compaction.
	export function run()
		for pass in self.passes 'eachPass'
			logDebug(LogCategory.ir, message: function() gives "=== Running pass: {passKindToString(pass)} ===")
			self.dispatch(pass)
		end 'eachPass'
	end 'run'

	// One arm per PassKind. Each reads the incoming module off `self`, runs the
	// standalone pass algorithm, and writes the result back. resolveTypes /
	// semanticCheck are Chunk C placeholders: they no-op today (their bodies are
	// TypeResolution + SemanticCheck, not yet built) but are dispatched so the
	// pipeline shape is fixed. Keeping the pass algorithms as free functions
	// preserves their reuse outside the pipeline; dispatch just wires them up.
	function dispatch(pass PassKind)
		match pass 'dispatch'
			resolveTypes then break 'dispatch'
			semanticCheck then break 'dispatch'
			lowerMaxonToStd then self.stdModule = lowerMaxonToStd(self.maxonModule)
			lowerStdToMir then self.mirModule = lowerStdToMir(self.stdModule)
		end 'dispatch'
	end 'dispatch'
end 'PassPipeline'
