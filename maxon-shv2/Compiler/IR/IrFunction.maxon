// IrFunction: a named function shared across all IR phases (Maxon, Std,
// Target). Carries both Maxon-phase types (populated by the parser) and
// Std-phase types (populated by LowerMaxonToStd); phase-specific backend fields
// (varSlotCount, stackSize, …) are zero-initialized and filled by the relevant
// pass.
//
// THIN for maxon-shv2 M1 — deliberately NOT a verbatim copy of v1's field-richest
// type. Two field families from v1 are intentionally omitted here because shv2's
// architecture supersedes them; each grows back at its milestone:
//
//   • The per-ValueId refcount side-tables (valueOwnership/valueManaged/
//     valueTypeParam/relaySlot/borrowSlot/valueInlinedArg/…) and v1's 6-way
//     `OwnershipClass` enum are NOT ported. They are exactly the late,
//     liveness-driven refcount machinery shv2 replaces with the static Own tier
//     (M6): ownership lives on values/bindings/signatures + explicit `own.*` ops
//     (see OwnershipKind in MaxonDialect.maxon), NOT in per-function sidetables.
//   • The generics / ABI-companion fields (implicitWitnessConstraints →
//     WhereClause, paramReservations, scopeSlotToAbiParamIndex,
//     contentHash, slotMaxonTypes, calleeSaved regs) are omitted until their
//     milestones (M5 ABI, M14 generics, backend/query chunks) add
//     them. Keeping them out now avoids dragging the whole generics/backend cone
//     into the M1 type layer. (The per-function closure counter is present as of
//     P1.5-A2a — see `closureSubCounter` — because non-capturing closure literals
//     lift to top-level functions and need a source-deterministic name.)
//
// What remains is the stable cross-phase container the `return 42` slice needs:
// identity + signature (Maxon + Std shapes) + the per-function `Scope` + the
// backend frame-size scalars.

// ⭐ **WHERE A FUNCTION'S NAME WAS WRITTEN — or the explicit statement that nobody wrote it.** The three
// fields travel together because they are ONE fact, and `IrFunction.create` takes it as one argument so a
// caller cannot supply a path and forget the line (which would position a diagnostic at `file:0:0`) or,
// worse, forget the path and have a PARSED function read as compiler-synthesized. See `create`'s header for
// the two readers that decide behaviour on the empty/non-empty split, and why neither can rest on a
// convention.
export type SourcePosition
	export let filePath as FilePath
	export let line as LineNumber
	export let column as ColumnNumber

	// A function the PARSER built, positioned at the token the author has to change to move it.
	export static function declaredAt(filePath FilePath, nameTok Token) returns SourcePosition
		return Self{filePath: filePath, line: nameTok.line, column: nameTok.column}
	end 'declaredAt'

	// A function the COMPILER built. The empty path is the discriminator the two readers above turn on, so
	// this is a positive statement of provenance and not a default that fell through: a caller reaches it by
	// naming it, and a reader grepping `synthesized` finds every site that claims it.
	export static function synthesized() returns SourcePosition
		return Self{filePath: FilePath from "", line: 0, column: 0}
	end 'synthesized'
end 'SourcePosition'

// Sum-typed encoding of an optional `throws E` clause. `none` = non-throwing;
// `throwing(name)` carries the bare error-enum name. Replaces a `""`-sentinel
// String field so the absent state is structurally distinct.
export union ThrowsClause
	none
	throwing(name String)
end 'ThrowsClause'

// Raised by `throwsClauseName` when the clause is `none`.
export enum ThrowsClauseNameError implements Error
	noThrowsClause
end 'ThrowsClauseNameError'

// Extract the throws-type name; throws for `none` so callers that only need the
// name avoid repeating the match/break boilerplate.
export function throwsClauseName(clause ThrowsClause) returns String throws ThrowsClauseNameError
	match clause 'k'
		none then throw ThrowsClauseNameError.noThrowsClause
		throwing(name) then return name
	end 'k'
end 'throwsClauseName'

// True when the clause carries an error type. One shared classifier for the
// throws/non-throws decision across the semantic + lowering layers.
export function throwsClauseIsThrowing(clause ThrowsClause) returns bool
	return match clause 'k'
		none gives false
		throwing gives true
	end 'k'
end 'throwsClauseIsThrowing'

export typealias ThrowsClauseArray = Array with ThrowsClause

// The per-function counter that names lifted NON-CAPTURING closure literals (P1.5-A2a). A count with
// no meaningful upper bound (a function may hold arbitrarily many closures), so the range is wide by
// the ranged-type convention rather than pinned to a false ceiling.
export typealias ClosureSubIndex = int(0 to u64.max)

// ⭐ **WHICH PARAMETERS A FUNCTION WRITES — one bit per parameter position, 0 for the overwhelming
// majority that write none** (the E3019 call-site rule, `SemanticCheck.buildParamMutationSummary`).
//
// A BITMASK and not a `BoolArray`, for the reason `ArgFloatMask` is one: this field is on EVERY
// `IrFunction` in the program, and a per-function array would be one live heap object each for a fact
// that is a single machine word — with `0` (no parameter is written) being both the common case and the
// literal truth rather than a sentinel. Its width is `MaxAbiArgs`, the same ceiling `ArgFloatMask`
// states and `Parser.requireAbiParamCount` diagnoses, so `1 shl param` always lands inside the word.
export typealias MutatedParamMask = int(0 to u64.max)

// One mask per function of the module, indexed by function INDEX — the working state of the
// parameter-mutation fixpoint (`SemanticCheck.buildParamMutationSummary`), before it is published as the
// name-keyed summary a call site reads.
export typealias MutatedParamMaskArray = Array with MutatedParamMask

// Does `mask` say parameter `param` is written? The ONE reader of the bit order — the parser sets bits
// and SemanticCheck's fixpoint both propagates and tests them, and a second spelling of the shift is a
// second chance for the two ends to disagree about which bit is which.
export function paramIsMutated(mask MutatedParamMask, param ParamCount) returns bool
	return ((mask shr param) and 1) != 0
end 'paramIsMutated'

// `mask` with parameter `param`'s bit set — the ONE writer, paired with the reader above.
export function withMutatedParam(mask MutatedParamMask, param ParamCount) returns MutatedParamMask
	return mask or (1 shl param)
end 'withMutatedParam'

export type IrFunction
	// --- Common fields (all phases) ---
	// A zero-copy slice of the source, straight off the declaring token. It stays bytes all
	// the way to the COFF symbol table, which writes it as bytes anyway.
	export var name as ByteArray
	// Source-file namespace this function was parsed in (e.g. "stdlib",
	// "Compiler.Parser"). Consumed by LowerMaxonToStd to resolve bare callees —
	// `name` can be bare for entrypoints like `main`, so it is not reliable.
	export var namespace as String
	// Visibility tier from the declaring source. Stamped by the parser.
	export var visibility as Visibility
	// Absolute / virtual path of the declaring file — the visibility anchor for
	// cross-file callers. Empty for synthesized functions.
	export var sourceFilePath as FilePath
	export var paramCount as ParamCount
	export var blockRefs as BlockRefArray
	export var nextBlockId as BlockId
	export var returnLine as LineNumber
	// Line and column of the function-name token; zero for synthesized functions.
	export var nameLine as LineNumber
	export var nameColumn as ColumnNumber

	// --- Maxon-phase types (populated by parser, consumed by LowerMaxonToStd) ---
	export var maxonReturnType as MaxonReturnType
	export var maxonParamTypes as MaxonTypeArray
	// THE MAXON TIER'S PER-VALUE TYPE ORACLE: the source-level type of every SSA value this
	// function's ops define, DENSE by ValueId (parameter `i` owns id `i`, so `valueTags[i]` is
	// parameter `i`'s declared type from the very first lookup).
	//
	// The parser builds it — it MUST, because the word operators are type-directed and a bool
	// `and` is control flow, so the type decision cannot be deferred (see Parser.valueTags) —
	// and it is PUBLISHED here rather than dropped at the end of the parse, because one type
	// rule genuinely cannot run in the parser: a call ARGUMENT must agree with its parameter,
	// and the callee may be in another file. SemanticCheck is the pass with the whole-program
	// signatures, and this is what gives it the other half of the question. Without it,
	// SemanticCheck would have to RE-DERIVE every value's type by walking the ops — a second
	// type oracle, free to disagree with the parser's, which is the exact duplication
	// TypeRules.maxon exists to prevent.
	//
	// TAGS, not `MaxonType`s: a Maxon union value is a heap object, so a `MaxonTypeArray` here
	// would put one live allocation on every SSA value in the program (MaxonDialect's
	// ValueTypeTag header has the measurement).
	//
	// Empty on a Std-phase function (`createFromStd`) — the tier that reads it is upstream of
	// those.
	export var valueTags as ValueTypeTagArray
	// THE PARALLEL NAME COLUMN: the interned `TypeNameId` behind each SSA value's type, DENSE by
	// ValueId in lockstep with `valueTags` (a scalar's slot holds the `UnnamedTypeId` filler). A
	// `named`/`structRef` value carries a real id here; every other tag's is filler and is never
	// read (the tag gates it — see MaxonDialect's `typeNameIdOf`).
	//
	// It IS published, for the reason `valueTags` is: the ONE call-argument identity rule that cannot
	// live in the parser (the callee may be in another file) now needs an argument's aggregate NAME,
	// not just its class. Two DIFFERENT structs share the `structRef` tag, so `checkArgTypes` cannot
	// tell a `BoxA` argument from a `BoxB` one off `valueTags` alone — a wrong-struct argument would
	// pass and, at a consuming position, be dropped under the parameter's destructor: a wild free
	// (OPEN #54 Slice B). SemanticCheck reads THIS column, resolved against `project.typeNames`
	// (`mergeArtifact` remaps it project-global), to reject the mismatch.
	//
	// Empty on a Std-phase function (`createFromStd`), exactly like `valueTags`.
	export var valueNameIds as TypeNameIdArray
	// ⭐ **THE PER-VALUE CLOSURE-ENVIRONMENT COLUMN (P1.5-A2b-2), DENSE by ValueId in lockstep with
	// `valueTags`.** The environment a function VALUE carries, or 0 when it carries none. A real environment
	// is always a minted value id (`>= 1` — a heap env block, a companion-env parameter, or a const-0 op is
	// never id 0, the first parameter), so a stored 0 unambiguously means "no environment". PUBLISHED here
	// (like `valueTags`/`valueNameIds`), and for the same reason a call-argument rule cannot live wholly in the
	// parser: threading a function-value ARGUMENT's environment to a callee is done at LOWERING
	// (`LowerMaxonToStd.appendCalleeEnvArgs`), the first tier that holds the callee's ALIAS-RESOLVED parameter
	// types (a function-typed parameter may be declared in another file). The parser cannot know there which
	// arguments land at function-typed parameters, so it publishes each value's environment here and the
	// lowering reads it. Empty on a Std-phase function (`createFromStd`).
	export var valueClosureEnv as ValueIdArray
	// ⭐ **THE CAPTURING-CLOSURE-LITERAL MARK (P1.5-A2b-2), DENSE by ValueId in lockstep with `valueTags`.**
	// True iff a value is a capturing closure LITERAL born in this function (its env is this frame's — see
	// `Parser.markCapturingClosure`). PUBLISHED (like `valueClosureEnv`) because the INTERPROCEDURAL escape
	// check runs at SemanticCheck (`buildEscapeSummary`/`checkArgTypes`), the first whole-program point that
	// holds every callee's body: a capturing closure passed to a callee that PERSISTS the parameter (stores or
	// returns it) would keep only the fn-ptr, so its captured env dangles once the frame dies — refused there.
	// It marks the LITERAL, not a function-typed parameter (which also carries an env): a param passed onward is
	// not refused, because the refusal lands at the site that passes the literal. Empty on a Std-phase function.
	export var valueIsCapturingClosure as BoolArray
	// `throws E` clause from the declaration; `ThrowsClause.none` for non-throwing.
	export var throwsTypeName as ThrowsClause
	// Persistent per-function symbol table, handed off by the parser. Std-phase
	// functions leave this empty.
	export var scope as Scope

	// --- Std/Target-phase types (populated by LowerMaxonToStd) ---
	export var returnType as StdReturnType
	export var paramTypes as StdTypeArray

	// --- Backend frame-size scalars (zero until the relevant pass runs) ---
	// Total number of slot-addressed variables used by ISel; spill slots sit
	// below the variable area.
	export var varSlotCount as VarSlot
	// Running tally of bytes the function needs on the stack (locals + spills +
	// callee-save area); the cold-spill splitter sets it to its spill-slot bytes,
	// and the prologue/epilogue pass aligns and emits `sub rsp, N`.
	export var stackSize as StackSize
	// Bytes reserved at the bottom of the frame for outgoing call args that
	// overflow the register file.
	export var outgoingArgSize as StackSize

	// Function purity (no side effects / global or param mutation, transitively
	// pure call graph). Computed by SemanticCheck; read by the discarded-result
	// lint. Defaults true; the analysis lowers it on impure constructs.
	export var isPure as bool

	// ⭐ **THE PER-FUNCTION CLOSURE COUNTER (P1.5-A2a).** The k-th non-capturing closure literal in this
	// function's body lifts to a top-level function named `<name>$closure_<k>`; `parseClosureExpression`
	// reads this value for `k` and post-increments it. Source-deterministic — the same source mints the
	// same closure names regardless of how many sibling functions parsed before it. Zero for a function
	// with no closures. A closure body threads its OWN lifted `IrFunction` as the enclosing function, so a
	// closure nested inside a closure uses THAT function's counter (`<outer>$closure_0$closure_0`).
	export var closureSubCounter as ClosureSubIndex

	// ⭐⭐ **TWO MASKS OVER THE SAME BIT SPACE ASK TWO DIFFERENT QUESTIONS, AND shv2 ANSWERS THEM
	// DIFFERENTLY. READ BOTH HEADERS BEFORE TOUCHING EITHER.**
	//
	// | question | mask |
	// |---|---|
	// | "does passing an immutable binding HERE make it an error?" | `writtenParamMask` (E3019) |
	// | "does this body write the storage this parameter points at?" | `storageWrittenParamMask` (E3070) |
	//
	// ⚠ **NEITHER MASK CONTAINS THE OTHER. THEY DIVERGE IN FOUR PLACES, IN BOTH DIRECTIONS** — this list is
	// exhaustive, and it is exhaustive on purpose, because "a superset" is the plausible summary and it is
	// FALSE (measured: `function tagIt(s String) s.append("!") end` raises E3019 on a `let` argument while
	// its storage bit is deliberately clear):
	//
	// | the write | `writtenParamMask` | `storageWrittenParamMask` | why |
	// |---|---|---|---|
	// | self-field alias (`items.clear()`) or self-field store (`items = …`) | no | **yes** | the ruling below |
	// | field-chain array whose base is a parameter (`bag.items.clear()`) | no | **yes** | E3019 records no field write, by the same ruling |
	// | `String` receiver that is a parameter | **yes** | no | a String write frees no ARRAY element |
	// | `Set` receiver that is a parameter | **yes** | no | likewise |
	//
	// The last two are E3070's SCOPE and not an omission: an array element is the only borrow it tracks, so
	// recording a `String`/`Set` write would refuse `b.wipe()` while `b.items` is borrowed for a `wipe` that
	// only appends to `b.name`. ⚠ **Do not "simplify" E3019's call-site check to read the storage column** —
	// it would silently stop diagnosing those two rows, with no compile error anywhere.
	//
	// They look alike and are not, and the divergence is a RULING the corpus pins. E3070 needs the opposite
	// answer about the very same call, because `b.wipe()` clearing `self.items` frees an element a caller
	// borrowed out of `b.items` (measured: the oracle prints 44, shv2 read freed memory and printed
	// 4557430888798830399).
	//
	// ⚠ **ONE MASK CANNOT CARRY BOTH, AND EACH OF THE TWO DOORS HAS ITS OWN PINNED GUARD — SEEN RED, not
	// assumed.** Feeding E3019's column from either door turns a committed case red, and they are DIFFERENT
	// cases, because the two doors reach E3019 by different routes:
	//
	//   • the SELF-FIELD STORE (`Parser.emitCheckedSelfFieldStore`, `total = total + v`) is guarded by
	//     `specs-shv2/self-keyword.md:self-with-params` — `let acc = Accumulator.create(0)` then
	//     `acc.add(10)` must compile and return **42**. Sabotaged: three E3019s at `acc.add`/`acc.addTwice`.
	//   • the SELF-FIELD ALIAS receiver (`Parser.receiverOwnerMask`, `items.clear()`) is guarded by
	//     `parameter-mutation:let-struct-with-array-field-to-mutating-method-ok` and
	//     `for-iterated-self-field:self-field-writable-after-the-loop`. Sabotaged: E3019 on both, and
	//     `self-with-params` stays GREEN — it does not cover this door.
	//
	// So there are two columns, each named for its question, each pointing here.
	//
	// ⭐ **THE PARAMETERS THIS BODY ITSELF WRITES (E3019, the call-site half)** — bit `i` set iff a
	// receiver-writing container method was called on parameter `i`'s record, or a field of `self` was
	// assigned. Seeded by the PARSER, at the one site that already decides whether a receiver may be
	// written (`Parser.noteReceiverWrite`) and at the one self-field store, so "which methods write their
	// receiver" is answered exactly once in the program and never re-derived from lowered runtime callee
	// names. SemanticCheck then closes it under the call graph (`buildParamMutationSummary`) — a callee
	// that writes what it was handed makes its caller write what IT was handed — and the closure is what
	// the call-site check reads. Zero for a Std-phase function: the tier that reads it is upstream.
	export var writtenParamMask as MutatedParamMask

	// ⭐ **THE PARAMETERS WHOSE ARRAY STORAGE THIS BODY WRITES (E3070's half)** — bit `i` set iff the body
	// writes an ARRAY reachable through parameter `i`, a field of its own receiver included. It is NOT a
	// superset of `writtenParamMask` above and not a subset either; the table there enumerates all four
	// divergences and why each one is the answer it is.
	//
	// Seeded by the PARSER at the same two doors — `Parser.noteReceiverWrite`, which already decides whether
	// a receiver may be written at all, and `Parser.emitCheckedSelfFieldStore`, the one self-field store —
	// and closed under the call graph by the SAME least fixpoint over the SAME edges
	// (`buildParamMutationSummary`), so `wipe()` calling a `reset()` that clears the field inherits the bit.
	// Read only by `BorrowCheck.mutationSiteWrites`, to answer "does handing this borrowed array — as an
	// argument or as a RECEIVER — reach a write of it?". Zero for a Std-phase function.
	export var storageWrittenParamMask as MutatedParamMask

	// ⭐ **THE E3070 BORROW FACTS THIS BODY RECORDED (`BorrowCheck`)** — which storages it borrowed an
	// element out of, which binding took each borrow, and every write it saw go through one. It rides
	// here for the reason `writtenParamMask` above does, and it is the SAME reason: the fact is the
	// PARSER's (a binding exists nowhere else in shv2 — `let` mints no op), while the pass that must
	// read it needs the whole program (the free-call half asks `ParamMutationSummary` whether the
	// callee writes the parameter the array filled).
	//
	// ⚠ Points at `sharedEmptyBorrowFacts` until the body takes its first borrow, so a function that
	// borrows nothing — which is nearly every function — costs one shared reference and no allocation.
	// `Parser.borrowFactsOf` is the copy-on-write. Empty for a Std-phase function: the tier that reads
	// it is upstream.
	export var borrowFacts as BorrowFacts

	// Create an IrFunction at the Maxon phase. Maxon-phase type fields are
	// populated; Std-phase fields default. Visibility defaults to `file` so the
	// parser must positively widen it — synthesized functions stay file-private.
	//
	// `valueTags` and `valueNameIds` are taken, not created: the parser has already seeded both with
	// the parameter types before it gets here, and it goes on pushing into them — BY REFERENCE, in
	// lockstep — as the body's values are minted. Constructing empty ones here and having the parser
	// overwrite them at the end of the body would leave dead arrays per function on the heap
	// (`scale-test` charged that exactly: +48 allocations on the smallest rung, doubling with the corpus).
	//
	// ⭐⭐ **`declaredAt` IS REQUIRED, AND THAT IS WHAT MAKES PROVENANCE A CONSTRUCTED FACT RATHER THAN A
	// CONVENTION.** Two readers decide behaviour on whether `sourceFilePath` is empty — `TargetPrinter.
	// isRuntimeFunction` withholds the green-thread stack guard from the runtime's own scaffolding, and
	// `DeadFunctionElimination.refuseDuplicateFunctionName` tells an author's declaration (E4015) apart from
	// an installer that ran twice (a panic). Neither can be satisfied by a caller's good intentions: this
	// used to hardcode an empty path and leave every caller to overwrite it a few lines later, so a caller
	// that forgot would have made a PARSED function read as synthesized at both readers — silently, as a
	// wrong answer rather than a compile error, and the stack-guard one is the SIGSEGV the A1r review
	// measured. Passing the position in means a caller cannot forget it; it can only decide it, and
	// `SourcePosition.synthesized` is how a synthesizing caller says so out loud.
	export static function create(name ByteArray, maxonReturnType MaxonReturnType, paramCount ParamCount, maxonParamTypes MaxonTypeArray, valueTags ValueTypeTagArray, valueNameIds TypeNameIdArray, valueClosureEnv ValueIdArray, valueIsCapturingClosure BoolArray, returnLine LineNumber, declaredAt SourcePosition, throwsTypeName ThrowsClause = ThrowsClause.none) returns IrFunction
		return Self{
			name: name,
			namespace: "",
			visibility: Visibility.file,
			sourceFilePath: declaredAt.filePath,
			paramCount: paramCount,
			blockRefs: BlockRefArray.create(),
			nextBlockId: 0,
			returnLine: returnLine,
			nameLine: declaredAt.line,
			nameColumn: declaredAt.column,
			maxonReturnType: maxonReturnType,
			maxonParamTypes: maxonParamTypes,
			valueTags: valueTags,
			valueNameIds: valueNameIds,
			valueClosureEnv: valueClosureEnv,
			valueIsCapturingClosure: valueIsCapturingClosure,
			throwsTypeName: throwsTypeName,
			scope: Scope.create(),
			returnType: StdReturnType.void,
			paramTypes: StdTypeArray.create(),
			varSlotCount: 0,
			stackSize: 0,
			outgoingArgSize: 0,
			isPure: true,
			closureSubCounter: 0,
			writtenParamMask: 0,
			storageWrittenParamMask: 0,
			borrowFacts: sharedEmptyBorrowFacts
		}
	end 'create'

	// Create an IrFunction at the Std phase or later. Std-phase type fields are
	// populated; Maxon-phase fields default. Used by the runtime installers and the entry stubs — every
	// caller synthesizes a helper and wants it callable from anywhere, so visibility defaults to `global`.
	//
	// ⚠ **NO PARSED FUNCTION COMES THROUGH THIS DOOR, and that is load-bearing rather than incidental**:
	// the position is `SourcePosition.synthesized()`, and A1t's `refuseDuplicateFunctionName` reads exactly
	// that to tell an author's declaration apart from a symbol the compiler emitted (as `TargetPrinter.
	// isRuntimeFunction` reads it for the GT stack-guard exemption). Unlike `create`, this door takes no
	// position argument, because there is no caller it could come from: every one of them synthesizes. ⚠ This
	// header used to name *"stdlib-cache restore"* as a caller — shv2 has no such restore, and the phantom
	// answered "yes" to the one question both readers turn on: *can a function parsed from source reach the
	// Std module with empty provenance?* It cannot.
	export static function createFromStd(name ByteArray, returnType StdReturnType, paramCount ParamCount, paramTypes StdTypeArray, returnLine LineNumber, throwsTypeName ThrowsClause = ThrowsClause.none) returns IrFunction
		let declaredAt = SourcePosition.synthesized()
		return Self{
			name: name,
			namespace: "",
			visibility: Visibility.global,
			sourceFilePath: declaredAt.filePath,
			paramCount: paramCount,
			blockRefs: BlockRefArray.create(),
			nextBlockId: 0,
			returnLine: returnLine,
			nameLine: declaredAt.line,
			nameColumn: declaredAt.column,
			maxonReturnType: MaxonReturnType.void,
			maxonParamTypes: MaxonTypeArray.create(),
			valueTags: ValueTypeTagArray.create(),
			valueNameIds: TypeNameIdArray.create(),
			valueClosureEnv: ValueIdArray.create(),
			valueIsCapturingClosure: BoolArray.create(),
			throwsTypeName: throwsTypeName,
			scope: Scope.create(),
			returnType: returnType,
			paramTypes: paramTypes,
			varSlotCount: 0,
			stackSize: 0,
			outgoingArgSize: 0,
			isPure: true,
			closureSubCounter: 0,
			writtenParamMask: 0,
			storageWrittenParamMask: 0,
			borrowFacts: sharedEmptyBorrowFacts
		}
	end 'createFromStd'

	// A SHALLOW copy of the signature + type info, with a fresh-empty `blockRefs`.
	// Deliberately NOT a clone: `maxonParamTypes`, `paramTypes` and `scope` are
	// SHARED with `src` by reference, because no consumer mutates them in place.
	// Only `blockRefs` is fresh — callers that need the source's block references
	// must carry them over explicitly, and that empty-list contract is what
	// `relocateFunction` (and the backends that rebuild `blockRefs` themselves)
	// rely on. See `relocateFunction` for the variant that preserves them, shifted
	// by a block offset.
	export static function shallowCopy(src IrFunction) returns IrFunction
		return Self{
			name: src.name,
			namespace: src.namespace,
			visibility: src.visibility,
			sourceFilePath: src.sourceFilePath,
			paramCount: src.paramCount,
			blockRefs: BlockRefArray.create(),
			nextBlockId: src.nextBlockId,
			returnLine: src.returnLine,
			nameLine: src.nameLine,
			nameColumn: src.nameColumn,
			maxonReturnType: src.maxonReturnType,
			maxonParamTypes: src.maxonParamTypes,
			valueTags: src.valueTags,
			valueNameIds: src.valueNameIds,
			valueClosureEnv: src.valueClosureEnv,
			valueIsCapturingClosure: src.valueIsCapturingClosure,
			throwsTypeName: src.throwsTypeName,
			scope: src.scope,
			returnType: src.returnType,
			paramTypes: src.paramTypes,
			varSlotCount: src.varSlotCount,
			stackSize: src.stackSize,
			outgoingArgSize: src.outgoingArgSize,
			isPure: src.isPure,
			closureSubCounter: src.closureSubCounter,
			writtenParamMask: src.writtenParamMask,
			storageWrittenParamMask: src.storageWrittenParamMask,
			borrowFacts: src.borrowFacts
		}
	end 'shallowCopy'

	// RELOCATION, not copying: a shallow copy that also carries the source's
	// `blockRefs` across, shifting each by `blockOffset` (0 = verbatim). The shift is
	// the whole point — `IrModule.merge` appends a source module's blocks after the
	// destination's, so every ref into them moves by the destination's prior block
	// count. Offset 0 serves a backend that needs the function to keep pointing at the
	// source's body blocks in place.
	export static function relocateFunction(src IrFunction, blockOffset BlockRef = 0) returns IrFunction
		var relocated = IrFunction.shallowCopy(src)
		for blockRef in src.blockRefs 'eachBlock'
			relocated.blockRefs.push(blockRef + blockOffset)
		end 'eachBlock'
		return relocated
	end 'relocateFunction'

	// Drop the front-end `Scope` symbol table once lowering has snapshotted the
	// per-slot data it needs. No Std/backend pass reads `scope`, so resetting
	// it frees the internal `vars` map + frame stacks while leaving a valid
	// (empty) Scope in place.
	export function releaseScope()
		self.scope.reset()
	end 'releaseScope'
end 'IrFunction'

export typealias IrFunctionArray = Array with IrFunction
