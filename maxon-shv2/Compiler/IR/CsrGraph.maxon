// CsrGraph — compressed-sparse-row adjacency over a dense integer key space, and the
// counting-sort that builds one from a parallel (key, value) edge list.
//
// It lives at the IR level, not inside one tier, because consumers in ALL THREE — front end, Std and
// Target — need exactly this shape, and each had grown its own copy of the same counting sort:
//
//   • the CFG's successor / predecessor lists    (TargetLiveness.FuncTopology.succ/.pred)
//   • which values die at each op of a block     (RegisterAllocator.BlockDeaths)
//   • which values feed each phi                 (PruneDeadBlockArgs, ElimTrivialBlockArgs)
//   • which methods call a method                (Parser: descriptor-need + array-feed fixpoints)
//   • which functions forward a parameter        (SignatureIndex.closeByRefForwarding, PBR-2)
//   • which stdlib functions need the substrate  (StdlibSource.SubstrateFixpoint)
//   • which instances a type argument denotes    (SignatureIndex.buildInstanceArgGraph)
//
// ⚠ That list is the POINT of the file, so keep it true: `buildCsr` is the only counting sort in the
// compiler, and a new adjacency belongs here rather than hand-rolled at its call site.
//
// One flat pair of columns instead of `Array with (a per-node array)`, which in Maxon is one
// heap-boxed, refcounted object per node — the trap `SourceRange.maxon` documents and the
// register allocator's data-representation contract forbids outright.
//
// The key space must be DENSE and 0-based (a block's local index, an op's position in its
// block, a `ValueId`), which every consumer's key already is.

// A dense node key, a neighbour, or a count — one non-negative integer, so one graph type serves
// every key domain (blocks, values, functions); a consumer casts at its own door.
export typealias CsrIndex = int(0 to u64.max)
export typealias CsrColumn = Array with CsrIndex

// `list[start[n] .. start[n+1])` are the values associated with key `n`.
export type CsrGraph
	export var start as CsrColumn
	export var list as CsrColumn

	export static function create(start CsrColumn, list CsrColumn) returns CsrGraph
		return Self{start: start, list: list}
	end 'create'

	// Number of neighbours of node `n`.
	export function degree(n CsrIndex) returns CsrIndex
		let lo = try self.start.get(n) otherwise panic("CsrGraph.degree: node {n} out of range")
		let hi = try self.start.get(n + 1) otherwise panic("CsrGraph.degree: node {n}+1 out of range")
		return hi - lo
	end 'degree'

	// The `k`-th neighbour of node `n`.
	export function neighbour(n CsrIndex, k CsrIndex) returns CsrIndex
		let lo = try self.start.get(n) otherwise panic("CsrGraph.neighbour: node {n} out of range")
		return try self.list.get(lo + k) otherwise panic("CsrGraph.neighbour: neighbour {k} of node {n} out of range")
	end 'neighbour'

	// How many nodes the graph spans — the count it was BUILT over, which `start` already carries as one
	// entry per node plus the end sentinel. Read off the graph rather than passed alongside it, so a
	// consumer cannot hand a walk a node count the adjacency disagrees with.
	export function nodeCount() returns CsrIndex
		return self.start.count() - 1
	end 'nodeCount'
end 'CsrGraph'

// Build a CSR graph from a parallel (from, to) edge list over `nodeCount` keys, in
// O(edges + nodes): degree of each key into `start[key + 1]`, prefix-sum into offsets, then
// place each edge at its key's running fill cursor. No sorting and no hashing.
//
// The (from, to) pairs may arrive in ANY order — the counting sort restores key order — but
// within one key the neighbours keep the order they were pushed, which the death lists and
// the phi-feeder lists both rely on for determinism.
export function buildCsr(from CsrColumn, to CsrColumn, nodeCount CsrIndex) returns CsrGraph
	let edgeCount = from.count()

	var start = CsrColumn.create()
	start.resize(nodeCount + 1)

	for k in 0 upto edgeCount 'countDeg'
		let f = try from.get(k) otherwise panic("buildCsr: from.get OOB")
		let cur = try start.get(f + 1) otherwise panic("buildCsr: key {f} is outside the {nodeCount}-key space")
		try start.set(f + 1, value: cur + 1) otherwise panic("buildCsr: start.set OOB")
	end 'countDeg'
	for n in 0 upto nodeCount 'prefix'
		let a = try start.get(n) otherwise panic("buildCsr: prefix start.get(n) OOB")
		let b = try start.get(n + 1) otherwise panic("buildCsr: prefix start.get(n+1) OOB")
		try start.set(n + 1, value: a + b) otherwise panic("buildCsr: prefix start.set OOB")
	end 'prefix'

	var list = CsrColumn.create()
	list.resize(edgeCount)
	// Running fill cursor per key, seeded from `start[key]`.
	var fill = CsrColumn.create()
	fill.resize(nodeCount)
	for n in 0 upto nodeCount 'seedFill'
		let s = try start.get(n) otherwise panic("buildCsr: seedFill start.get OOB")
		try fill.set(n, value: s) otherwise panic("buildCsr: seedFill set OOB")
	end 'seedFill'
	for k in 0 upto edgeCount 'place'
		let f = try from.get(k) otherwise panic("buildCsr: place from.get OOB")
		let t = try to.get(k) otherwise panic("buildCsr: place to.get OOB")
		let pos = try fill.get(f) otherwise panic("buildCsr: place fill.get OOB")
		try list.set(pos, value: t) otherwise panic("buildCsr: place list.set OOB")
		try fill.set(f, value: pos + 1) otherwise panic("buildCsr: place fill.set OOB")
	end 'place'

	return CsrGraph.create(start, list: list)
end 'buildCsr'

// ⭐ **REVERSE-REACHABILITY BFS over a CSR adjacency** — return the bit per node that is set iff the node is a
// seed OR reaches one over `graph`'s edges. The graph is the REVERSED relation (`buildCsr` with (callee,
// caller) swapped), so a seed's row lists the nodes that point AT it and the BFS propagates the mark BACKWARD.
// Each node enters the worklist at most once (the first time its bit flips on) and each edge is walked once,
// for O(nodes + edges).
//
// ⭐ **THE SHARED ENGINE OF EVERY TRANSITIVE-CLOSURE FIXPOINT IN THE COMPILER**, so they cannot drift on how
// reachability is marked: the descriptor-need fixpoint (`Queries.foldDescriptorNeeds`), the transitive
// array-feed fixpoint (`solveAndPublishTransitiveFeeds`) and PBR-2's by-reference forwarding closure
// (`ProgramSignatures.closeByRefForwarding`). It lives HERE rather than beside the first two for the reason
// `buildCsr` does — see this file's header: a walk over a CSR belongs with the CSR, and the third consumer
// is in a file the other two's home cannot be reached from.
//
// ⚠ **A ROUND-BASED FIXPOINT IS NOT AN ALTERNATIVE SPELLING OF THIS, IT IS A DIFFERENT COMPLEXITY.**
// "Re-scan every node until nothing changes" costs O(depth x (nodes + edges)) and the depth is the source
// program's own — MEASURED on PBR-2's own closure before it asked here: at a CONSTANT 512-function program,
// parse CPU ran 199M ticks at forwarding depth 2 and 452M at depth 512, doubling with the depth while not one
// token of the program changed.
export function reverseReachabilityMark(graph CsrGraph, seeds BoolArray) returns BoolArray
	var marked = BoolArray.create()
	var worklist = CsrColumn.create()
	for i in 0 upto seeds.count() 'seed'
		let isSeed = try seeds.get(i) otherwise panic("reverseReachabilityMark: seeds.get({i}) OOB")
		marked.push(isSeed)
		if isSeed 'root'
			worklist.push(i)
		end 'root'
	end 'seed'

	var head = 0 as CsrIndex
	while head < worklist.count() 'drain'
		let node = try worklist.get(head) otherwise panic("reverseReachabilityMark: worklist.get({head}) OOB")
		head = head + 1
		for k in 0 upto graph.degree(node) 'neighbour'
			let nbr = graph.neighbour(node, k: k)
			if not (try marked.get(nbr) otherwise panic("reverseReachabilityMark: marked.get({nbr}) OOB")) 'newlyMarked'
				try marked.set(nbr, value: true) otherwise panic("reverseReachabilityMark: marked.set({nbr}) OOB")
				worklist.push(nbr)
			end 'newlyMarked'
		end 'neighbour'
	end 'drain'
	return marked
end 'reverseReachabilityMark'

// ⭐ **WHICH NODES OF `graph` LIE ON A CYCLE** — Tarjan's strongly-connected components, in
// O(nodes + edges). A node is on a cycle exactly when its component holds more than one node, or when it
// is its own neighbour; a node alone in its component with no self-edge reaches everything below it and
// never itself.
//
// ⚠ **ONE SWEEP FOR THE WHOLE GRAPH, WHICH IS THE POINT.** The obvious alternative — ask "does node X
// reach itself?" once per node — answers the same question at O(nodes x (nodes + edges)), because what
// one node reaches says nothing about what the next one does and the walk starts over.
// `ProgramSignatures.firstCyclicAliasDecl` shipped exactly that shape and MEASURED CUBIC; its header
// carries the numbers.
//
// The DFS is iterated over an explicit stack rather than recursed: the depth is the graph's own, and a
// chain of N generic aliases would be N native frames.
export function nodesOnACycle(graph CsrGraph) returns BoolArray
	var walk = SccWalk.overNodes(graph.nodeCount())
	// The DFS stack, as parallel columns: the node, and how many of its neighbours it has walked.
	var frameNode = CsrColumn.create()
	var frameEdge = CsrColumn.create()

	for root in 0 upto graph.nodeCount() 'eachRoot'
		if not walk.isUndiscovered(root) 'reachedFromAnEarlierRoot'
			continue
		end 'reachedFromAnEarlierRoot'

		walk.discover(root)
		frameNode.push(root)
		frameEdge.push(0)

		while frameNode.count() > 0 'walkFrames'
			let top = frameNode.count() - 1
			let node = try frameNode.get(top) otherwise panic("nodesOnACycle: frameNode.get({top}) below its own count()")
			let edge = try frameEdge.get(top) otherwise panic("nodesOnACycle: frameEdge.get({top}) below its own count()")

			if edge < graph.degree(node) 'moreNeighbours'
				try frameEdge.set(top, value: edge + 1) otherwise panic("nodesOnACycle: frameEdge.set({top}) below its own count()")
				let next = graph.neighbour(node, k: edge)

				if walk.isUndiscovered(next) 'descend'
					walk.discover(next)
					frameNode.push(next)
					frameEdge.push(0)
					continue
				end 'descend'

				// An edge into a component still OPEN is an edge back into this same walk, so its target's
				// discovery index bounds how far up `node`'s own component can begin. An edge into a CLOSED
				// component leaves the current one and says nothing about it.
				if walk.isOpenComponent(next) 'backIntoThisWalk'
					walk.lowerTo(node, bound: walk.discoveryOf(next))
				end 'backIntoThisWalk'
				continue
			end 'moreNeighbours'

			_ = try frameNode.pop() otherwise panic("nodesOnACycle: pop from a non-empty frameNode")
			_ = try frameEdge.pop() otherwise panic("nodesOnACycle: pop from a non-empty frameEdge")

			// `node` is finished: hand its lowlink up to the parent it returns to, then close its component
			// if nothing beneath it reached higher than itself.
			if frameNode.count() > 0 'returnsToAParent'
				let parent = try frameNode.get(frameNode.count() - 1) otherwise panic("nodesOnACycle: frameNode.get below its own count()")
				walk.lowerTo(parent, bound: walk.lowlinkOf(node))
			end 'returnsToAParent'

			if walk.rootsAComponent(node) 'componentRoot'
				walk.closeComponent(node, namesItself: nodeNamesItself(graph, node: node))
			end 'componentRoot'
		end 'walkFrames'
	end 'eachRoot'

	return walk.onCycle
end 'nodesOnACycle'

// ⭐ **THE SHORTEST CYCLE THROUGH `start`, AS THE NODES ALONG IT WITH `start` FIRST — or EMPTY when `start`
// lies on no cycle.** `nodesOnACycle` answers WHETHER, for every node at once; this answers WHICH NODES, for
// one. They are separate functions because the two questions have separate costs and separate callers: the
// whether is asked on every compile that declares a generic alias, the which only once a diagnostic naming
// the cycle is already being written (`ProgramSignatures.aliasCyclePath`).
//
// Breadth-first, so what comes back is the SHORTEST cycle through `start`. A diagnostic that RENDERS the
// path — `Circular typealias dependency: A -> B -> A` — should show the smallest loop that proves the
// defect, not whichever one a depth-first walk wandered into first. Iterative for `nodesOnACycle`'s reason:
// the depth is the graph's own, and a chain of N nodes would otherwise be N native frames.
export function shortestCycleThrough(graph CsrGraph, start CsrIndex) returns CsrColumn
	// The BFS tree: `reached` is the visited set, `cameFrom` the parent each node was first reached from.
	// Only nodes the search actually reached are ever read back out of `cameFrom`, so its zero fill is never
	// mistaken for an answer.
	var reached = BoolArray.create()
	reached.resize(graph.nodeCount())
	var cameFrom = CsrColumn.create()
	cameFrom.resize(graph.nodeCount())

	var frontier = CsrColumn.create()
	frontier.push(start)
	try reached.set(start, value: true) otherwise panic("shortestCycleThrough: start node {start} is outside the graph's own {graph.nodeCount()} nodes")

	var head = 0 as CsrIndex
	while head < frontier.count() 'eachFrontierNode'
		let node = try frontier.get(head) otherwise panic("shortestCycleThrough: frontier.get({head}) below its own count()")
		head = head + 1

		for k in 0 upto graph.degree(node) 'eachNeighbour'
			let next = graph.neighbour(node, k: k)
			// An edge back to `start` CLOSES the loop, and the BFS tree already holds the way there.
			if next == start 'closesTheCycle'
				return cycleThrough(cameFrom, closedBy: node, start: start)
			end 'closesTheCycle'

			let alreadyReached = try reached.get(next) otherwise panic("shortestCycleThrough: neighbour {next} of node {node} is outside the graph's own {graph.nodeCount()} nodes")
			if alreadyReached 'alreadyOnTheFrontier'
				continue
			end 'alreadyOnTheFrontier'

			try reached.set(next, value: true) otherwise panic("shortestCycleThrough: neighbour {next} of node {node} is outside the graph's own {graph.nodeCount()} nodes")
			try cameFrom.set(next, value: node) otherwise panic("shortestCycleThrough: neighbour {next} of node {node} is outside the graph's own {graph.nodeCount()} nodes")
			frontier.push(next)
		end 'eachNeighbour'
	end 'eachFrontierNode'

	return CsrColumn.create()
end 'shortestCycleThrough'

// The nodes from `start` down to `closedBy` inclusive, read backwards off the BFS tree and handed back in
// walk order. `closedBy == start` is the one-node cycle — a node that is its own neighbour — and falls out
// of the same walk without a case of its own.
function cycleThrough(cameFrom CsrColumn, closedBy CsrIndex, start CsrIndex) returns CsrColumn
	var backwards = CsrColumn.create()
	var at = closedBy
	while at != start 'walkBackUpTheTree'
		backwards.push(at)
		at = try cameFrom.get(at) otherwise panic("cycleThrough: node {at} is on the BFS tree but has no recorded parent")
	end 'walkBackUpTheTree'
	backwards.push(start)

	var path = CsrColumn.create()
	for i in 0 upto backwards.count() 'eachNode'
		let fromTheEnd = backwards.count() - 1 - i
		path.push(try backwards.get(fromTheEnd) otherwise panic("cycleThrough: backwards.get({fromTheEnd}) below its own count()"))
	end 'eachNode'

	return path
end 'cycleThrough'

// Is `node` its own neighbour? The one way a component of ONE node is still a cycle, and the only reason
// a component's size is not the whole test.
function nodeNamesItself(graph CsrGraph, node CsrIndex) returns bool
	for k in 0 upto graph.degree(node) 'eachNeighbour'
		if graph.neighbour(node, k: k) == node 'itself'
			return true
		end 'itself'
	end 'eachNeighbour'

	return false
end 'nodeNamesItself'

// The columns Tarjan's walk carries — one entry per node, plus the stack of components still open. A type
// rather than six locals threaded through every step, for the reason `SubstrateFixpoint` is one: the walk
// is ITERATIVE, so discovering a node, lowering a link and closing a component are separate steps over the
// same columns, and a step that stamped one column and forgot another would corrupt every component root
// after it.
type SccWalk
	// 1-based discovery order, so 0 reads as "not visited yet" and no second column has to say so.
	var discovered as CsrColumn
	// The lowest discovery index reachable from the node's subtree — Tarjan's lowlink.
	var lowlink as CsrColumn
	// Where the node sits on `componentStack`, which turns a component's SIZE into a subtraction.
	var openAt as CsrColumn
	// Is the node still on `componentStack` — is its component still being built?
	var isOpen as BoolArray
	// The answer: does the node lie on a cycle?
	export var onCycle as BoolArray
	// The nodes of every component still open, in discovery order.
	var componentStack as CsrColumn
	var nextDiscovery as CsrIndex

	static function overNodes(nodeCount CsrIndex) returns SccWalk
		var discovered = CsrColumn.create()
		discovered.resize(nodeCount)
		var lowlink = CsrColumn.create()
		lowlink.resize(nodeCount)
		var openAt = CsrColumn.create()
		openAt.resize(nodeCount)
		var isOpen = BoolArray.create()
		isOpen.resize(nodeCount)
		var onCycle = BoolArray.create()
		onCycle.resize(nodeCount)

		return Self{discovered: discovered, lowlink: lowlink, openAt: openAt, isOpen: isOpen, onCycle: onCycle, componentStack: CsrColumn.create(), nextDiscovery: 1}
	end 'overNodes'

	function discoveryOf(node CsrIndex) returns CsrIndex
		return try self.discovered.get(node) otherwise panic("SccWalk.discoveryOf: node {node} outside the walk's node space")
	end 'discoveryOf'

	function lowlinkOf(node CsrIndex) returns CsrIndex
		return try self.lowlink.get(node) otherwise panic("SccWalk.lowlinkOf: node {node} outside the walk's node space")
	end 'lowlinkOf'

	function isUndiscovered(node CsrIndex) returns bool
		return self.discoveryOf(node) == 0
	end 'isUndiscovered'

	function isOpenComponent(node CsrIndex) returns bool
		return try self.isOpen.get(node) otherwise panic("SccWalk.isOpenComponent: node {node} outside the walk's node space")
	end 'isOpenComponent'

	// Stamp `node` with the next discovery index and open its entry on the component stack. The four
	// columns move together or not at all.
	function discover(node CsrIndex)
		try self.discovered.set(node, value: self.nextDiscovery) otherwise panic("SccWalk.discover: node {node} outside the walk's node space")
		try self.lowlink.set(node, value: self.nextDiscovery) otherwise panic("SccWalk.discover: node {node} outside the walk's node space")
		try self.openAt.set(node, value: self.componentStack.count()) otherwise panic("SccWalk.discover: node {node} outside the walk's node space")
		try self.isOpen.set(node, value: true) otherwise panic("SccWalk.discover: node {node} outside the walk's node space")
		self.componentStack.push(node)
		self.nextDiscovery = self.nextDiscovery + 1
	end 'discover'

	// Pull `node`'s lowlink down to `bound` if that is lower — the one monotone update both the back-edge
	// arm and the finished-child arm make.
	function lowerTo(node CsrIndex, bound CsrIndex)
		if bound < self.lowlinkOf(node) 'lower'
			try self.lowlink.set(node, value: bound) otherwise panic("SccWalk.lowerTo: node {node} outside the walk's node space")
		end 'lower'
	end 'lowerTo'

	// Does `node` root a finished component? Nothing beneath it reached further up than itself.
	function rootsAComponent(node CsrIndex) returns bool
		return self.lowlinkOf(node) == self.discoveryOf(node)
	end 'rootsAComponent'

	// Close `root`'s component: every node pushed at or after its own stack position belongs to it. Two or
	// more members IS a cycle; a lone member is one only when it names itself.
	function closeComponent(root CsrIndex, namesItself bool)
		let base = try self.openAt.get(root) otherwise panic("SccWalk.closeComponent: node {root} outside the walk's node space")
		let cyclic = self.componentStack.count() - base > 1 or namesItself

		while self.componentStack.count() > base 'popMember'
			let member = try self.componentStack.pop() otherwise panic("SccWalk.closeComponent: pop from a componentStack already at its base")
			try self.isOpen.set(member, value: false) otherwise panic("SccWalk.closeComponent: node {member} outside the walk's node space")
			if cyclic 'onACycle'
				try self.onCycle.set(member, value: true) otherwise panic("SccWalk.closeComponent: node {member} outside the walk's node space")
			end 'onACycle'
		end 'popMember'
	end 'closeComponent'
end 'SccWalk'
