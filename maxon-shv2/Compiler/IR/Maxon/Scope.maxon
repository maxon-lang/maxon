// Scope: persistent per-function symbol table, with LEXICAL BLOCK SCOPING.
//
// The parser builds this as it emits ops; when a function finishes parsing the
// final `Scope` is handed to the `IrFunction` for downstream consumers (the
// Maxon→Std lowerer and the future LSP name-resolution query).
//
// A block (`if` / `else` / `while` body) opens a FRAME: every declaration inside
// it is torn down at the block's `end`, so `if c 'b' … let x = 1 … end 'b'`
// followed by a reference to `x` is a name-resolution failure, not a live binding
// (specs/block-scoping.md). Frames are MARKS into flat declaration stacks, not a
// stack of per-frame arrays: pushScope pushes the current stack length — O(1),
// and with NO heap object per frame, which matters because a block is the most
// numerous scope in any real program — and popScope drains back to it, still
// O(declarations-in-this-frame). An EMPTY mark stack means function scope:
// declarations there live for the whole function and `reset` tears them down.
//
// SHADOWING IS LEGAL, and it is why a frame records more than names. `vars` is
// keyed by name, so an inner `let x` OVERWRITES the outer `x`'s entry; simply
// REMOVING the key at scope exit would delete the outer binding too, and
// `let x = 1 / if c 'b' let x = 2 end 'b' / return x` would report `x` undefined
// instead of returning 1. So a declaration that DISPLACES an existing binding
// pushes the displaced `VarInfo` onto `shadowedInfos`, and popScope drains the
// frame in REVERSE — putting each displaced binding back — which also unwinds a
// name declared twice within one frame through its own chain.
//
// BINDINGS ARE MUTATED IN PLACE, NOT REPLACED. `VarInfo` is a heap `type`, so
// `vars` stores a reference; `setValue` writes `boundValue` through it. That is
// what lets the parser hold a DIRECT reference to a mutable binding (its loop-phi
// list and its merge snapshots do — see Parser.mutableVars) and still address the
// right binding when a nested block shadows its NAME. A name-keyed rebind cannot:
// it would always resolve to the innermost binding, so a `break` out of a block
// that shadows a loop-carried `var` would carry the SHADOW's value to the loop's
// exit phi — a silent miscompile.
//
// OWNERSHIP SCAFFOLD (M1, inert): the Own tier (M6) places `own.drop`/`own.release`
// at scope exit for every NON-trivial (owned/borrow/shared) binding a frame declared
// — the deterministic static-drop mechanism that replaces v1's late liveness-driven
// refcount reclamation. `popScope` is where that happens, and it needs no side list to
// do it: draining a frame ALREADY resolves each of its declarations back to the
// `VarInfo` being torn down, and that record carries both the `ownership` kind to test
// and the type + slot a drop has to name. A parallel "owned names" array would be a
// strict projection of `vars` kept in lockstep by hand — state that can drift, buying
// nothing. At M1 every binding is `trivial`, so the hook never fires.

export union ScopeLookupError implements Error
	// String, not the raw slice: this arm exists only to be FORMATTED into a diagnostic.
	notFound(name String)
end 'ScopeLookupError'

// Raised by `declare` / `declarePayloadBinding` when the name being bound would
// overwrite a self-field alias registered at instance-method entry (E3006).
// Scope is the only layer that sees both the alias and the colliding
// declaration, so detection lives here.
export union ScopeError implements Error
	// String, not the raw slice: this arm exists only to be FORMATTED into a diagnostic.
	shadowsSelfField(name String)
end 'ScopeError'

// A frame boundary: the height of the declaration stack when the frame was
// opened. Wide range — declaration counts are unbounded.
export typealias ScopeMark = int(0 to u64.max)
typealias ScopeMarkArray = Array with ScopeMark

export type Scope
	var vars as VarInfoMap
	// Every declaration made while a frame was open, in declaration order —
	// innermost frame on top. Drained back to a frame's mark by popScope.
	var declNames as ByteArrayArray
	// Parallel to `declNames`: did this declaration DISPLACE an existing binding of
	// the same name? A dense bool column rather than an optional `VarInfo` per
	// declaration, so the common (non-shadowing) case costs no heap object.
	var declShadowed as BoolArray
	// The displaced bindings, pushed only by the declarations `declShadowed` marks.
	// popScope pops one per marked declaration, in reverse, and re-installs it.
	var shadowedInfos as VarInfoArray
	// One entry per open frame: the `declNames` height at pushScope.
	var frameMarks as ScopeMarkArray
	export var nextSlot as VarSlot

	export static function create() returns Scope
		return Self{
			vars: VarInfoMap.create(),
			declNames: ByteArrayArray.create(),
			declShadowed: BoolArray.create(),
			shadowedInfos: VarInfoArray.create(),
			frameMarks: ScopeMarkArray.create(),
			nextSlot: 0
		}
	end 'create'

	// Reset the scope for a new function parse.
	export function reset()
		vars = VarInfoMap.create()
		declNames = ByteArrayArray.create()
		declShadowed = BoolArray.create()
		shadowedInfos = VarInfoArray.create()
		frameMarks = ScopeMarkArray.create()
		nextSlot = 0
	end 'reset'

	// Declare a variable and return its slot. Throws
	// `ScopeError.shadowsSelfField` when `name` currently maps to a self-field
	// alias (binding a local of the same name would overwrite it — E3006).
	export function declare(name ByteArray, varType MaxonType, mutable bool) returns VarSlot throws ScopeError
		if self.wouldShadowSelfField(name) 'shadow'
			throw ScopeError.shadowsSelfField(String.from(name))
		end 'shadow'
		return self.declareShadowing(name, varType: varType, mutable: mutable)
	end 'declare'

	// True when `name` currently resolves to a self-field alias.
	function wouldShadowSelfField(name ByteArray) returns bool
		let info = try vars.get(name) otherwise return false
		return info.isSelfField
	end 'wouldShadowSelfField'

	// Allocate a slot for `name` without the self-field-shadow guard. The
	// error-recovery path after a caller reported E3006, and the shared
	// slot-allocating core for `declare`.
	export function declareShadowing(name ByteArray, varType MaxonType, mutable bool) returns VarSlot
		let slot = nextSlot
		nextSlot = nextSlot + 1
		self.install(VarInfo.create(name, varType: varType, mutable: mutable, slot: slot))
		return slot
	end 'declareShadowing'

	// Bind `name` to an ALREADY-ALLOCATED slot (no new slot). Aliases a user
	// binding onto a shared compiler slot so a single scope-exit release frees
	// it (a separate slot would double-free).
	export function bindExistingSlot(name ByteArray, slot VarSlot, varType MaxonType, mutable bool)
		self.install(VarInfo.create(name, varType: varType, mutable: mutable, slot: slot))
	end 'bindExistingSlot'

	// Declare a self-field alias. No local backing slot is materialized — reads
	// and writes lower to loadIndirect/storeIndirect through __self. Throws
	// `ScopeError.shadowsSelfField` when `name` is already bound (a parameter
	// shadows this field — the symmetric case to a body local shadowing it).
	export function declareSelfField(name ByteArray, varType MaxonType, offset FieldOffset) returns VarSlot throws ScopeError
		if vars.contains(name) 'paramShadow'
			throw ScopeError.shadowsSelfField(String.from(name))
		end 'paramShadow'
		return self.installSelfField(name, varType: varType, offset: offset)
	end 'declareSelfField'

	// Register a self-field alias unconditionally (no param-shadow guard).
	// Shared core for `declareSelfField`; also the E3006 recovery path.
	export function installSelfField(name ByteArray, varType MaxonType, offset FieldOffset) returns VarSlot
		let slot = nextSlot
		nextSlot = nextSlot + 1
		self.install(VarInfo.createSelfField(name, varType: varType, slot: slot, offset: offset))
		return slot
	end 'installSelfField'

	// Declare a match-arm payload binding. Reads work like a normal local;
	// writes go through a payload store against the scrutinee + field index.
	export function declarePayloadBinding(name ByteArray, varType MaxonType, mutable bool, scrutineeName ByteArray, fieldIndex CaseOrdinal, caseName ByteArray) returns VarSlot throws ScopeError
		if self.wouldShadowSelfField(name) 'shadow'
			throw ScopeError.shadowsSelfField(String.from(name))
		end 'shadow'
		return self.declarePayloadBindingShadowing(name, varType: varType, mutable: mutable, scrutineeName: scrutineeName, fieldIndex: fieldIndex, caseName: caseName)
	end 'declarePayloadBinding'

	// Non-guarded payload-binding declaration: the E3006 recovery path and the
	// shared core for `declarePayloadBinding`.
	export function declarePayloadBindingShadowing(name ByteArray, varType MaxonType, mutable bool, scrutineeName ByteArray, fieldIndex CaseOrdinal, caseName ByteArray) returns VarSlot
		let slot = nextSlot
		nextSlot = nextSlot + 1
		self.install(VarInfo.createPayloadBinding(name, varType: varType, mutable: mutable, slot: slot, scrutineeName: scrutineeName, fieldIndex: fieldIndex, caseName: caseName))
		return slot
	end 'declarePayloadBindingShadowing'

	// Declare a value binding (M2's SSA-substitution model): bind `name` to the SSA
	// value `value`, so a later reference resolves to it via `lookupValue`. No slot
	// is allocated — value bindings need no stack storage (contrast the slot-based
	// `declare*` paths that back the future mutable/mem2reg model). The self-field-
	// shadow guard the slot path carries is unnecessary here: M2 has no instance
	// methods, so no self-field alias can exist to shadow — that guard joins this
	// path when methods land.
	//
	// Returns the `VarInfo` it installed, because a `var` binding is tracked BY
	// REFERENCE (see the header): the parser keeps mutable bindings in its loop-phi
	// list as the objects themselves, so a nested block that shadows the NAME cannot
	// misdirect a phi write to the shadow.
	export function declareValueBinding(name ByteArray, varType MaxonType, mutable bool, value ValueId) returns VarInfo
		var info = VarInfo.createValueBinding(name, varType: varType, mutable: mutable, boundValue: value)
		self.install(info)
		return info
	end 'declareValueBinding'

	// THE single funnel for every declare* path: install the binding in `vars`, and —
	// when a frame is open — record it for O(decls) teardown, capturing the binding it
	// DISPLACES so popScope can put that one back.
	//
	// With NO frame open the declaration is at function scope: it lives for the whole
	// function and is torn down by `reset`, so it needs no frame bookkeeping and can
	// never be shadowed-then-restored (it IS the outermost binding of its name).
	function install(info VarInfo)
		if frameMarks.count() == 0 'functionScope'
			vars.upsert(info.name, value: info)
			return
		end 'functionScope'

		var shadowed = false
		if let displaced = try vars.get(info.name) 'displaces'
			shadowedInfos.push(displaced)
			shadowed = true
		end 'displaces'
		declNames.push(info.name)
		declShadowed.push(shadowed)
		vars.upsert(info.name, value: info)
	end 'install'

	// Rebind an ALREADY-DECLARED name to a new SSA value (M4b's on-the-fly SSA): a
	// `var` reassignment (`x = expr`). Reads (`lookupValue`) resolve to this current
	// value, so a read after a reassignment sees the new value — `boundValue` IS the
	// variable's current SSA version, not the initializer's. Written THROUGH the
	// binding (a heap reference), so every holder of that `VarInfo` — the parser's
	// loop-phi list, a merge snapshot — observes it. Panics on an unknown name: every
	// caller has already established the binding exists (a `var` decl, or a mutability
	// check that fetched the VarInfo).
	//
	// Name-keyed, so it always hits the INNERMOST binding — which is exactly right for
	// a source-level assignment. The parser's phi machinery deliberately does NOT come
	// through here; it writes `boundValue` on the binding it holds (see the header).
	export function setValue(name ByteArray, value ValueId)
		var info = try vars.get(name) otherwise panic("Scope.setValue: '{String.from(name)}' not declared — caller must establish the binding before rebinding it")
		info.boundValue = value
	end 'setValue'

	// Resolve a value binding to the SSA value it aliases. Throws
	// `ScopeLookupError.notFound` for an unbound name; the parser turns that into a
	// positioned diagnostic (an undefined identifier in an expression).
	export function lookupValue(name ByteArray) returns ValueId throws ScopeLookupError
		let info = try self.lookupInfoOrThrow(name)
		return info.boundValue
	end 'lookupValue'

	// Look up a variable by name. Throws ScopeLookupError.notFound if absent.
	export function lookup(name ByteArray) returns VarSlot throws ScopeLookupError
		let info = try self.lookupInfoOrThrow(name)
		return info.slot
	end 'lookup'

	// The throwing VarInfo fetch shared by `lookup`/`lookupValue`: an unbound name
	// is a name-resolution failure (ScopeLookupError.notFound) the parser turns into
	// a positioned diagnostic. `getInfo`/`isSelfField` deliberately keep their own
	// fetch — they recover differently (panic / false), not by throwing this arm.
	function lookupInfoOrThrow(name ByteArray) returns VarInfo throws ScopeLookupError
		return try vars.get(name) otherwise throw ScopeLookupError.notFound(String.from(name))
	end 'lookupInfoOrThrow'

	// Get the VarInfo for a variable, or panic if not found.
	export function getInfo(name ByteArray) returns VarInfo
		return try vars.get(name) otherwise panic("Scope: undefined variable '{String.from(name)}'")
	end 'getInfo'

	// Check if a variable is defined.
	export function contains(name ByteArray) returns bool
		return vars.contains(name)
	end 'contains'

	// Read-only iteration over the per-function symbol table. Returned map is
	// the live backing store — callers MUST treat it as read-only.
	export function allVars() returns VarInfoMap
		return vars
	end 'allVars'

	// True when `name` is a self-field alias inside an instance method. Returns
	// false for unknown names so callers can probe without checking contains().
	export function isSelfField(name ByteArray) returns bool
		let info = try vars.get(name) otherwise return false
		return info.isSelfField
	end 'isSelfField'

	// Get the declared MaxonType for a variable. Callers check `contains(name)`
	// first, so a missing entry is an invariant violation.
	export function getType(name ByteArray) returns MaxonType
		let info = try vars.get(name) otherwise panic("Scope.getType: name '{String.from(name)}' not in scope — callers must check `contains` first")
		return info.varType
	end 'getType'

	// Clone hook: install a VarInfo verbatim, preserving its slot id. Does NOT
	// bump `nextSlot` — the caller sets it explicitly via `setNextSlot`.
	export function installVerbatim(info VarInfo)
		vars.upsert(info.name, value: info)
	end 'installVerbatim'

	// Clone hook: pin `nextSlot` to a chosen value.
	export function setNextSlot(slot VarSlot)
		nextSlot = slot
	end 'setNextSlot'

	// Open a fresh scope frame — O(1), one integer, no heap object.
	export function pushScope()
		frameMarks.push(declNames.count())
	end 'pushScope'

	// Close the current scope frame: drain its declarations out of `vars`, in REVERSE,
	// restoring each binding they displaced (see the header — reverse order is what
	// unwinds a name declared twice in one frame through its own shadow chain).
	// O(declarations-in-this-frame).
	//
	// THE OWNERSHIP HOOK LIVES HERE (M6): each iteration already holds the `VarInfo`
	// being torn down, so `ownedInFrame` classifies it in place and the Own tier emits
	// its `own.drop`/`own.release` at exactly this point. At M1 every binding is
	// `trivial`, so the classifier is always false and nothing is emitted.
	export function popScope()
		let mark = try frameMarks.pop() otherwise panic("Scope.popScope: frameMarks is empty (unmatched popScope)")
		while declNames.count() > mark 'drain'
			let name = try declNames.pop() otherwise panic("Scope.popScope: declNames.pop failed above the frame mark {mark}")
			let shadowed = try declShadowed.pop() otherwise panic("Scope.popScope: declShadowed.pop failed — it must stay parallel to declNames")

			// Drained in reverse, so `name` still resolves to the binding THIS declaration
			// installed — the one leaving scope, and the one a drop would be emitted for.
			let leaving = try vars.get(name) otherwise panic("Scope.popScope: '{String.from(name)}' is in the frame's declaration list but not in `vars` — the two fell out of lockstep")
			if not isTrivialOwnership(leaving.ownership) 'dropAtScopeExit'
				panic("Scope.popScope: binding '{String.from(name)}' leaves scope owning a value, but the Own tier that emits its drop is not built yet (M6) — no binding is non-trivial before then")
			end 'dropAtScopeExit'

			if shadowed 'restoreOuter'
				let outer = try shadowedInfos.pop() otherwise panic("Scope.popScope: shadowedInfos.pop failed — one entry per declaration marked as shadowing")
				vars.upsert(name, value: outer)
			end 'restoreOuter' else 'removeOnly'
				_ = vars.remove(name)
			end 'removeOnly'
		end 'drain'
	end 'popScope'
end 'Scope'
