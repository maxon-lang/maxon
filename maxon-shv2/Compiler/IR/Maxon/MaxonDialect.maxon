// Maxon Dialect — high-level IR, closest to source. The parser emits these ops
// directly; lowerMaxonToStd (Chunk B) lowers them to Std ops.
//
// The Maxon dialect owns MaxonType — a source-level type union with no concept
// of width unification. Width/signedness collapse happens only in
// lowerMaxonToStd.
//
// THIN for maxon-shv2 M1: this carries exactly the shapes the `return 42` slice
// needs — the `literal` and `ret` ops, and a MaxonType with the primitive +
// named + unresolved arms (enough to type `int` and `ExitCode`). Later
// milestones GROW MaxonType (string/character/function/generic/interface arms),
// MaxonOp (variables, arithmetic, calls, control flow, …), and the ownership
// signature modes. v1's proven `MaxonOpMeta{category}` per-variant tagging is
// preserved so a new op cannot be added without declaring its category.

// --- Ownership lattice (the M1 ownership scaffold) ---
//
// The 4-value ownership lattice, born at the Maxon tier (per PLAN.md: ownership
// is a first-class Maxon-dialect concept, resolved before lowerMaxonToStd). It
// has three first-class homes and ZERO sidetables:
//   1. an OwnershipKind attribute on every binding/value (this enum) — carried
//      on `VarInfo.ownership` today; on Std/Own-tier values from M6;
//   2. signature ownership modes in the function type (param consume/borrow/copy,
//      return owned/borrow) — added at M5/M6;
//   3. explicit `own.*` ops in the block stream (the Own dialect) — added at M6.
//
// Kinds:
//   - trivial — scalar / no destructor; never dropped, never refcounted.
//   - owned   — unique heap value; dropped exactly once unless moved.
//   - borrow  — non-owning view; never dropped; carries a lifetime (M7).
//   - shared  — escape-promoted to runtime refcounting (the ONLY place
//               refcounts survive — emitted solely for `shared`, M8).
//
// PRESENT-BUT-INERT AT M1: every binding/value is `trivial`; the Own tier
// (OwnershipInfer / OwnershipCheck / EscapeAnalysis / InsertDrops) that reads
// and mutates this is stubbed until M6. This is what "designed in from the
// first commit" means — M6 activates the scaffold, it is not retrofitted.
export enum OwnershipKind
	trivial
	owned
	borrow
	shared
end 'OwnershipKind'

// True for the M1 default kind (no drop, no refcount). Lifted out so the Own
// tier and Scope's per-frame owned-values gate share one classifier instead of
// re-spelling the `== OwnershipKind.trivial` compare at each site.
export function isTrivialOwnership(kind OwnershipKind) returns bool
	return kind == OwnershipKind.trivial
end 'isTrivialOwnership'

// Identifier for a named type reference interned in the project's type-name
// interner (Chunk C) so identical named references share one backing String and
// structural identity is a single integer compare. Wide range: the interner is
// unbounded (one entry per distinct named reference seen in source).
export typealias TypeNameId = int(0 to u64.max)

// A generic type's type-PARAMETER reference (P1.6-A): `T` in `type Box uses T`. The id is the
// param's POSITION in its declaring type's `uses` list (`T` is 0, the second is 1, …), which is
// all a TRIVIAL type parameter needs — it lowers to an opaque 8-byte value and is never
// substituted at this slice, so the position IS its whole identity and no registry has to intern
// it. Same underlying range as `TypeNameId` deliberately: a `typeParameter` value rides the dense
// `nameId` column exactly as `named`/`structRef` do (`maxonTypeOfTag`), so the two ranges must be
// assignment-compatible.
export typealias TypeParamId = int(0 to u64.max)

// A generic INSTANCE `Base with Args` (P1.6-A): `Box with Integer`. The id keys the
// `GenericInstanceRegistry` (SignatureIndex), which holds the `(baseId, argTypes)` payload OUT OF
// LINE — inlining it into the union would make `MaxonType` recursively aggregate (E4014). Same
// underlying range as `TypeNameId` for the reason `TypeParamId` is.
export typealias GenericInstanceId = int(0 to u64.max)

// --- MaxonType: source-level type system ---
//
// bool is the only standalone primitive a user writes directly; `integer` /
// `float` are unconstrained numeric literals without a named context; `named`
// covers every user-defined or stdlib alias (ExitCode, Character, …) that
// resolves to a concrete width via the typealias registry at Std lowering time.
// Width/signedness lives in that registry, NOT on MaxonType.
//
// `unresolved` is the placeholder the parser emits where it cannot fill a type
// without a cross-declaration lookup; TypeResolution (Chunk C) replaces every
// `unresolved` with a concrete type. Lowering must never see it.
//
// `exitCode` is the RESOLVED form of the `ExitCode` builtin alias — the one
// named alias TypeResolution knows without loading the stdlib (M1 shortcut; see
// TypeResolution.maxon). It is a width-FREE tag exactly like `boolean` /
// `integer`: it carries no width itself, and its width (unsigned 32-bit) is
// assigned only at the Maxon→Std boundary by `maxonTypeToStdType`. So the
// invariant "MaxonType has no concept of width; width collapse happens only in
// lowering" is preserved — `exitCode` is just another primitive tag the parser
// never writes and the resolver produces. More resolved builtin-alias arms (or
// a general `builtinAlias(kind)` arm) grow at M9/M10 when user types + the
// ranged-typealias registry land.
//
// `structRef` is a reference to a DECLARED STRUCT TYPE (`type Point`) — an 8-byte pointer to a
// heap-allocated, refcounted box (P1.0r). It is a SEPARATE ARM FROM `named`, and that separation
// is the whole reason this rung could add structs without breaking six rules at once.
//
// ⭐ **`named` MEANS "A RANGED NUMERIC ALIAS", AND FIVE PLACES READ IT.**
// `TypeRules.typeClassOf` calls a `named` type `numeric`; `tagIsIntegral` calls it integral;
// `typeTagName` prints it as `int`; `notOperatorFor` gives it the BITWISE `not`; and
// `valueTagToStdType` collapses it to i64. As of F1 `Parser.readTypeAliasDeclaration` accepts an
// `int(low to high)` OR a `float(low to high)` alias, so only `typeClassOf` is still a theorem (both
// aliases are numeric); the other four treat a `named` value as an INT — correct for an int alias and
// DELIBERATELY approximate for a float one, because a float alias is tagged `named` only in the
// param/field positions F1 defers to the float ABI (F2), where the int reading yields a type error or
// an x64 ABI panic, never a wrong answer (each of those four says so in its own words and names the
// alias-registry resolution F2 needs). Filing a struct under `named` would instead have made all five
// FALSE at once and silently: `p + 1` would compile to pointer arithmetic, `return p` from an
// `ExitCode` function would hand back the box's address, and `not p` would complement it. The tag is
// what the rules read, so the tag is where the distinction has to live.
//
// Its width IS assigned at the Maxon→Std boundary like every other arm's (`valueTagToStdType` →
// i64), so this arm keeps MaxonType width-free exactly as `exitCode` does — a pointer is a machine
// word, and which word is the Std tier's business.
//
// ⚠ APPENDED AT THE END OF THE UNION, past `unresolved`, per the band-append invariant
// (MaxonDialect's MaxonOp header states it for ops; a type union has the same range arms and the
// same silence). `boolean to float` and `exitCode to unresolved` are the two ranges that name this
// union's arms, and appending past the tail is the only placement the compiler can check.
//
// Void is NOT a MaxonType — a non-value can't be a value-type. Function return
// types use MaxonReturnType (below).
// `string` is the `String` BUILTIN — a POINTER to a fused 48-byte record (P1.2 wave A). It is its
// OWN arm, NEVER `named`, for the identical reason `structRef` is: the five rules that read `named`
// (`typeClassOf`, `tagIsIntegral`, `typeTagName`, `notOperatorFor`, `valueTagToStdType`) all treat it
// as a ranged INT, and filing String under `named` would make `s + t`, `not s` and `return s` from an
// `ExitCode` function all compile as integer/pointer arithmetic. A String is neither numeric nor a
// declared struct: it is `TypeClass.text`, agreeing only with itself, and its only operators are
// `==`/`!=` (a runtime byte compare) and `print`.
//
// Its width is a machine word, assigned at the Maxon→Std boundary (`valueTagToStdType` → i64) exactly
// as every other arm's is, so MaxonType stays width-free. Unlike a Wave-B heap String it carries no
// ownership: a Wave-A literal is immortal rdata (`capacity=-2`, `parent_ptr=0`), never allocated,
// refcounted or dropped.
//
// ⚠ APPENDED AT THE END OF THE UNION, past `structRef`, per the band-append invariant — the same
// range arms (`boolean to float`, `exitCode to unresolved`) that guard `structRef`'s placement guard
// this one, and appending past the tail is the only placement the compiler can check.
export union MaxonType
	boolean
	integer
	float
	named(id TypeNameId)
	exitCode
	unresolved
	structRef(id TypeNameId)
	string
	// A non-capturing FUNCTION VALUE (P1.5-A1) — a bare code pointer, no environment. `id` is the
	// interned name that GOVERNS the value's signature: the FUNCTION's own name for a `functionRef`
	// (`let f = double` → `function(intern("double"))`), or a function-TYPEALIAS name for a declared
	// place (`f UnaryOp` → `function(intern("UnaryOp"))`). An indirect call recovers the return type
	// by that name (`ProgramSignatures.returnTypeOf` / `functionAliasReturnOf`), which is why the id
	// is a real interned NAME and rides the value column's name slot exactly as `named`/`structRef`
	// do — it interns, remaps and hashes by the same machinery.
	//
	// It is its OWN arm, NEVER `named`, for the identical reason `structRef`/`string` are: the five
	// rules that read `named` (`typeClassOf`, `tagIsIntegral`, `typeTagName`, `notOperatorFor`,
	// `valueTagToStdType`) all treat it as a ranged INT, and filing a function under `named` would
	// make `f + 1`, `return f` from an `ExitCode` function and `not f` all compile as integer
	// arithmetic on a code pointer. A function is `TypeClass.function`, agreeing only with another
	// function value (which is what makes a function value assignable to a function-typed place and
	// nothing else — the E3005 discipline).
	//
	// Its width is a machine word (a `.text` address), assigned at the Maxon→Std boundary
	// (`valueTagToStdType` → i64) exactly as every other arm's is, so MaxonType stays width-free. It
	// carries no ownership: a code pointer is never allocated, refcounted or dropped.
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `string`, per the band-append invariant — the same
	// range arms (`boolean to float`, `exitCode to unresolved`) that guard `structRef`/`string`
	// placement guard this one, and appending past the tail is the only placement the compiler checks.
	function(id TypeNameId)
	// A TYPE-PARAMETER reference (P1.6-A) — `T` inside `type Box uses T`. It is OPAQUE: a trivial
	// type parameter lowers to an 8-byte machine word (`valueTagToStdType` → i64) exactly as
	// `structRef`/`string`/`function` do, so a generic type's method bodies compile ONCE against `T`
	// and are byte-identical to the equivalent monomorphic struct. `id` is the param's POSITION in
	// its declaring type's `uses` list (see `TypeParamId`), the whole of its identity at this slice —
	// there is no substitution, so `Box.get() returns T` binds an opaque value the use site compares
	// as an i64. It agrees with any concrete type (`TypeClass.typeParameter`), the deferral that lets
	// a concrete argument meet a `T` parameter and a `T` result meet a concrete comparison.
	//
	// ⚠ APPENDED AT THE END, past `function`, per the band-append invariant — the same range arms
	// (`boolean to float`, `exitCode to unresolved`) that guard `structRef`/`string`/`function`
	// placement guard this one, and appending past the tail is the only placement the compiler checks.
	typeParameter(id TypeParamId)
	// A generic INSTANCE `Base with Args` (P1.6-A) — `Box with Integer`, the resolved form of a
	// generic-instance typealias. It is a POINTER to the base struct's box (a machine word, i64), so
	// a value of an instance type is a struct reference like any other. `id` keys the
	// `GenericInstanceRegistry` for its `(baseId, argTypes)` payload (OUT OF LINE — see
	// `GenericInstanceId`). APPENDED AT THE END, past `typeParameter`, per the band-append invariant.
	genericInstance(id GenericInstanceId)
end 'MaxonType'

export typealias MaxonTypeArray = Array with MaxonType

// A generic instance's argument list is a `MaxonTypeArray`, and the `GenericInstanceRegistry`
// (SignatureIndex) keeps one per interned instance (P1.6-A) — hence an array OF them.
export typealias MaxonTypeArrayArray = Array with MaxonTypeArray

// --- ValueTypeTag: MaxonType's discriminant, WITHOUT its payload ---
//
// The parser needs a source-level type for EVERY SSA value it mints — the word operators
// (`and`/`or`/`xor`/`not`) mean one thing on `bool` and another on `int`, and a bool
// `and`/`or` is CONTROL FLOW, so no later pass can retrofit the decision. It therefore keeps
// a dense per-value type column.
//
// That column may NOT be an `Array with MaxonType`, and the reason is measured, not
// aesthetic. **A Maxon union value is a heap object — every case, not just the ones with a
// payload.** So each `MaxonType.integer` a type rule *constructs* is an allocation, and the
// per-op type plumbing (`what type does this binOp yield?`, `is this operand a bool?`) put
// one on the compiler's single hottest path. `scale-test` charged the first cut of it
// **+4,165 allocations on the smallest rung**, and an A/B that replaced the column with a
// freshly-constructed `MaxonType.integer` at every read made it WORSE (+5,540) — which is
// what proved that CONSTRUCTING a union costs and READING a stored one does not.
//
// An `enum` is a scalar. So the column is a `ValueTypeTag` plus a parallel `TypeNameId`, two
// DENSE INT ARRAYS that allocate nothing per value, and a `MaxonType` is materialized only
// where something genuinely STORES one (a `literal` op's type; a binding's declared type) —
// which is per-declaration, not per-value.
//
// ⚠ `void` IS NOT A MaxonType ARM, AND THAT ASYMMETRY IS THE POINT. Every other tag is the
// discriminant of a `MaxonType`; `void` is the tag of a ValueId that names NO VALUE — the
// result slot of a call to a void function, which `MaxonOp.call` must carry an id for (the op
// shape has one) even though there is nothing in it. It exists because the alternative is a
// SENTINEL, and that sentinel was a real wrong answer: `calleeResultType` used to report a void
// callee as `unresolved` — the "I could not pin this type" tag, which `TypeRules.typeClassOf`
// maps to `unknown`, which AGREES WITH EVERYTHING. So `let x = noop()` then `x + 4` compiled,
// and returned whatever was in RAX. One sentinel, two meanings, and the rules could not tell
// them apart because nothing distinguished them.
//
// A `void`-tagged value is WRITE-ONLY, by construction: the only one minted is the result of a
// call in STATEMENT position (`Parser.parseCall`, `resultUsed: false`), whose ValueId is
// discarded and never enters a scope — and a call in VALUE position to a void callee is
// REJECTED there with a positioned diagnostic. So no rule can ever be asked about a `void` tag,
// and every rule that could be says so with a panic rather than an answer.
//
// `structRef` is the tag of a reference to a declared struct type — see MaxonType's `structRef`
// arm for why it is not `named`. It is APPENDED AT THE END, past `void`, for the same reason every
// other append in this file is: `unresolved to void` and `named to exitCode` are range arms, and a
// range adopts whatever is inserted between its endpoints without a word (`notOperatorFor`'s
// `float` bug is the standing proof). Appending past the tail is the one placement the compiler
// reports on.
export enum ValueTypeTag
	boolean
	integer
	float
	named
	exitCode
	unresolved
	void
	structRef
	// The tag of a `String` value — a pointer to the fused 48-byte record (see MaxonType's `string`
	// arm for why it is not `named`). APPENDED AT THE END, past `structRef`, for the same reason
	// every other append here is: `unresolved to void` and `named to exitCode` are range arms, and a
	// range adopts whatever is inserted between its endpoints without a word.
	string
	// The tag of a non-capturing FUNCTION VALUE — a pointer to a `.text` code address (see MaxonType's
	// `function` arm for why it is not `named`). APPENDED AT THE END, past `string`, for the same
	// reason every other append here is: `unresolved to void` and `named to exitCode` are range arms,
	// and a range adopts whatever is inserted between its endpoints without a word.
	function
	// The tag of a TYPE-PARAMETER value (P1.6-A) — a reference to `T` inside a generic type (see
	// MaxonType's `typeParameter` arm). Opaque: it lowers to an i64 and agrees with any concrete type.
	// APPENDED AT THE END, past `function`, for the same reason every other append here is: the range
	// arms adopt whatever is inserted between their endpoints without a word.
	typeParameter
	// The tag of a generic-INSTANCE value (P1.6-A) — a pointer to the base struct's box (see MaxonType's
	// `genericInstance` arm). APPENDED AT THE END, past `typeParameter`.
	genericInstance
end 'ValueTypeTag'

export typealias ValueTypeTagArray = Array with ValueTypeTag
export typealias TypeNameIdArray = Array with TypeNameId

// The tag of a `MaxonType`. Exhaustive, so a new `MaxonType` arm cannot be added without
// giving it one.
export function maxonTypeTag(t MaxonType) returns ValueTypeTag
	return match t 'k'
		boolean gives ValueTypeTag.boolean
		integer gives ValueTypeTag.integer
		float gives ValueTypeTag.float
		named gives ValueTypeTag.named
		exitCode gives ValueTypeTag.exitCode
		unresolved gives ValueTypeTag.unresolved
		structRef gives ValueTypeTag.structRef
		string gives ValueTypeTag.string
		function gives ValueTypeTag.function
		typeParameter gives ValueTypeTag.typeParameter
		genericInstance gives ValueTypeTag.genericInstance
	end 'k'
end 'maxonTypeTag'

// The interned name a `named` or `structRef` type refers to. Every other arm carries no name, and
// returns `UnnamedTypeId` — which is NOT a sentinel answer: the TAG is the discriminant, and a
// caller only reads this column on the arm where the tag says it means something (exactly as
// the union's own payload is only reachable through its case). It is the union, unpacked.
//
// The two id-bearing arms are NOT collapsed into one range: `exitCode` and `unresolved` sit
// between them, and `named to structRef` would swallow both — the band-append invariant read from
// the other end.
export function typeNameIdOf(t MaxonType) returns TypeNameId
	return match t 'k'
		named(id) gives id
		structRef(id) gives id
		// A function value's `id` is the interned NAME governing its signature (see MaxonType's
		// `function` arm), so it rides the name column exactly as `named`/`structRef` do — which is
		// what lets it intern, remap and hash by the same machinery. It is NOT collapsed into the
		// `named to structRef` range: `exitCode`/`unresolved` and now `string` sit between them.
		function(id) gives id
		// A type-parameter reference and a generic instance both carry an id (a POSITION and a
		// GenericInstanceId respectively, P1.6-A); both ride the name column so a value of that type
		// round-trips through `maxonTypeOfTag`. NOT collapsed into a range: other arms sit between.
		typeParameter(id) gives id
		genericInstance(id) gives id
		boolean to float gives UnnamedTypeId
		exitCode to unresolved gives UnnamedTypeId
		// A String is a builtin with no interned name — its identity is the `string` tag, not a name.
		string gives UnnamedTypeId
	end 'k'
end 'typeNameIdOf'

// The filler the name column carries for a type that has no name.
export let UnnamedTypeId = 0 as TypeNameId

// Rebuild a `MaxonType` from the two columns — the inverse of `maxonTypeTag` +
// `typeNameIdOf`. THIS ALLOCATES (it constructs a union), which is why it is called only
// where a `MaxonType` is genuinely stored: a binding's declared type, a `literal` op's type.
// Never on a per-value or per-op path.
//
// The `void` tag has no `MaxonType` to rebuild — a non-value is not a value-type, which is the
// whole reason void lives on `MaxonReturnType` and not here. Its one caller is `Parser.typeOf`,
// which types a `let`/`var` BINDING, and a binding can never hold a void call's result: that is
// a call in value position, which the parser rejects.
export function maxonTypeOfTag(tag ValueTypeTag, nameId TypeNameId) returns MaxonType
	match tag 'k'
		boolean then return MaxonType.boolean
		integer then return MaxonType.integer
		float then return MaxonType.float
		named then return MaxonType.named(nameId)
		exitCode then return MaxonType.exitCode
		unresolved then return MaxonType.unresolved
		void then panic("maxonTypeOfTag: a `void` tag names no value, so there is no MaxonType to rebuild — a void call's result is only ever a discarded statement result (Parser.parseCall), never a bound value")
		// A struct reference rebuilds from the same name column `named` does — the struct's name id
		// IS what makes `p.x` resolvable, since it is what `Parser.emitFieldLoad` looks the layout up
		// by. `Parser.parseBinding` is the caller that matters: `let p = Point.create(…)` types the
		// binding from this, and the binding's type is the only record of WHICH struct `p` is.
		structRef then return MaxonType.structRef(nameId)
		// A String builtin rebuilds from the tag alone — it carries no name (its `nameId` is
		// `UnnamedTypeId`). `Parser.parseBinding` is the caller that matters: `let s = "hello"` types
		// the binding from this.
		string then return MaxonType.string
		// A function value rebuilds from its governing name id — the FUNCTION's own name (functionRef)
		// or a function-typealias name (declared place). `Parser.parseBinding` is the caller that
		// matters: `let f = double` types the binding from this so `f(21)` can find its return type.
		function then return MaxonType.function(nameId)
		// A type-parameter reference / generic instance rebuilds from the id column exactly as `named`
		// does (P1.6-A) — the id is a param POSITION / a GenericInstanceId (see MaxonType). A binding of
		// a `T`-typed value (`let v = b.get()`) types from this.
		typeParameter then return MaxonType.typeParameter(nameId)
		genericInstance then return MaxonType.genericInstance(nameId)
	end 'k'
end 'maxonTypeOfTag'

// --- MaxonReturnType: function return type slot ---
// A function either returns nothing (void) or a value of some MaxonType. The
// parser produces this for every function's return type; lowerMaxonToStd maps
// it to the corresponding StdReturnType.
export union MaxonReturnType
	void
	value(inner MaxonType)
end 'MaxonReturnType'

export function maxonReturnTypeIsVoid(ref MaxonReturnType) returns bool
	return match ref 'check'
		void gives true
		value gives false
	end 'check'
end 'maxonReturnTypeIsVoid'

// The `ValueTypeTag` of a function's declared return type — what a `return <expr>` must agree
// with (TypeRules' `typesAgree`). Void has NO tag: void is not a type, so there is nothing for
// a value to agree with, and manufacturing a tag for it would be exactly the sentinel this
// codebase forbids. Every caller has already established the function returns a value —
// `maxonReturnTypeIsVoid` is the gate, and a void `return <expr>` is its own diagnostic
// (`ParseError.returnValueFromVoid`) — so the void arm is a caller bug and panics.
export function maxonReturnTypeTag(ref MaxonReturnType) returns ValueTypeTag
	match ref 'k'
		void then panic("maxonReturnTypeTag: a void return type has no value tag — the caller must gate on maxonReturnTypeIsVoid first")
		value(inner) then return maxonTypeTag(inner)
	end 'k'
end 'maxonReturnTypeTag'

// --- MaxonOp ---
//
// **Value operands are `ValueId`s, minted by the PARSER.** Every op's result gets
// a dense, function-local id at emit time; `lowerMaxonToStd` passes them through
// verbatim. Maxon ops are NOT identified by name slices.
//
// This is deliberate, and it is a correction of v1. v1 named Maxon values with
// `ByteArray`s and let `lowerMaxonToStd` assign the "real" SSA ids — but v1's
// result names were themselves synthetic `$tN` strings off a per-function
// counter (`mintSynthName`), and the ids were a second per-function counter. The
// mapping was a bijection between two dense counters, bought with a heap `String`
// + a heap `ByteArray` per value and a byte-sequence-keyed hash map (O(len)
// compares, one insert + one lookup per value). It constructed no SSA: user
// variables are `VarSlot`s, and real SSA construction is `mem2reg`'s job at the
// Std tier. So the names paid for themselves in allocation and bought a counter.
//
// What the front end genuinely needs, it keeps in better homes: SOURCE SPANS live
// on the op (`range`, below) — that is what the LSP's hover/goto-def actually maps
// cursor offsets against, and it never needed names — and NAME RESOLUTION lives in
// `Scope`, the per-function symbol table the parser already threads.
//
// Identifier TEXT that is not a value stays text: a field name, a method name, a
// struct name are `ByteArray`s (they are looked up, not computed). The split is
// "is this operand a VALUE or a NAME?", and it is ~90/10 in favour of values.
//
// **Source spans are NOT a field on the op.** Every Maxon op has one, but it lives
// in the op-parallel `SourceRangeTable` (see SourceRange.maxon), keyed by the op's
// index. `SourceRange` is a `type`, so an inline `range` field is a POINTER to a
// heap-boxed SourceRange — one live heap object per op, on the compiler's most
// numerous object, retained for the module's lifetime. The table stores four dense
// scalar columns instead and materializes a `SourceRange` only when a diagnostic or
// LSP query asks for one (the cold path). Ops are emitted through
// `FileParseArtifact.emitOp`/`emitTerminator`, which append op and span in lockstep.
//
// Each variant is tagged with a static `MaxonOpMeta{category}` — a struct-backed
// enum-payload pattern used for coarse membership tests ("is this any kind of
// call?") without a new `match` arm at every site. The struct backing is REQUIRED,
// so a new MaxonOp variant cannot be added without declaring its category here.

// Coarse category an op belongs to, for membership tests spanning several
// variants. Grows as call/panic/var/await/closure ops land.
export enum OpCategory
	callFree
	callMethod
	panicking
	varAccess
	awaiting
	closureProducer
	// The `own.*` ownership ops (`move` / `borrow` / `drop` / `retain` / `release`,
	// M6). They are a BAND OF `MaxonOp`, not a separate dialect or tier: `IrModule`
	// is generic over exactly ONE op type, so an op living in the Maxon block stream
	// IS a `MaxonOp`. Do NOT introduce a nested `MaxonOp.own(OwnOp)` — Maxon boxes
	// every payload-carrying union case, so nesting would cost a second heap object
	// per op, which is the exact anti-pattern the 3-tier collapse removed from `StdOp`.
	ownership
	plain  // everything else (the op stands alone; matched by variant)
end 'OpCategory'

// Per-variant static metadata backing for MaxonOp (read via `op.rawValue`).
export type MaxonOpMeta
	export let category as OpCategory
end 'MaxonOpMeta'

// The binary operators the Maxon tier represents. M2 landed `add` (`+`); M3 grew
// the non-trapping integer ALU set — `sub` (`-`) and `mul` (`*`) — when the Pratt
// precedence climber replaced M2's `+`-only expression parser. M5.4 grew the
// TRAPPING division family — `div` (`/`) and `mod` — now that x64 `idiv`'s fixed
// RAX/RDX pair has the real register allocator to honor it. `add`/`sub`/`mul` share
// the two-operand `binOp` shape AND lower to a `StdOp.binOp` opcode; `div`/`mod`
// share the `binOp` shape here but lower to their OWN Std variants (`StdOp.div`/`mod`)
// because idiv traps and needs `isPure: false` metadata a shared opcode cannot carry
// — the same reason a comparison splits into `StdOp.cmp`. Appended at the END of the
// enum (band-append) so `add to mul` still names the non-trapping arithmetic set.
//
// P1.0d.2 appends the WORD-OPERATOR band — `and` / `or` / `xor` / `shl` / `shr`
// (specs/bitwise-operators.md). Maxon spells these as KEYWORDS, not as `&`/`|`/`^`/
// `<<`/`>>`, and `and`/`or`/`xor` are CONTEXT-DEPENDENT: bitwise on integers, LOGICAL
// on bools. That duality is resolved entirely in the PARSER (which is the only tier
// that knows an expression's source-level type), so by the time an op lands here it
// means exactly one thing — the bit operation. A bool `and`/`or` never reaches this
// enum at all: it is SHORT-CIRCUIT CONTROL FLOW, lowered to blocks + a merge phi (see
// Parser.emitShortCircuit). A bool `xor` does reach it, as `bitXor`: xor cannot
// short-circuit (no operand value makes the other redundant), and on the 0/1 domain a
// bitwise xor IS the logical one.
//
// Appended at the END of the enum, after the trapping `div`/`mod` band, so the
// existing `add to mul` range arm still names exactly the non-trapping arithmetic set
// (the band-append invariant above).
// `shr` and `shrLogical` are the SAME source operator. Which one the parser emits is decided
// by the LEFT operand's type, and by nothing else (TypeRules' ⭐ THE SHIFT RULE): Go shifts a
// SIGNED left operand arithmetically and an UNSIGNED one logically, and Maxon's unsigned type is
// a ranged alias whose low bound is 0 (`int(0 to u64.max)`). `infixMaxonOp` never yields
// `shrLogical` — only `Parser.emitShift` does, having asked the question.
//
// Two opcodes rather than one opcode plus a flag, because the Std tier they lower into is
// TYPELESS: an i64 there carries no signedness, so a pass that met a single `shr` would have no
// way left to ask which fill was meant. The decision is a FRONT-END fact, and it is written into
// the opcode at the one moment it is still knowable.
export enum MaxonBinOp
	add
	sub
	mul
	div
	mod
	bitAnd
	bitOr
	bitXor
	shl
	shr
	shrLogical
end 'MaxonBinOp'

// The unary (prefix) operators the Maxon tier represents. M3 lands `neg` (the
// prefix `-`) only. A unary op carries ONE operand (unlike MaxonBinOp's two), so
// it rides its own `MaxonOp.unaryOp` variant rather than being folded into `binOp`
// — the operand shapes differ, and a shared variant could not carry both.
//
// P1.0d.2 appends the two readings of the prefix keyword `not`, which — like
// `and`/`or`/`xor` — is context-dependent on its operand's type:
//   • `bitNot`     — INTEGER `not` (`not 5` == -6): flip every bit.
//   • `logicalNot` — BOOL `not` (`not true` == false): flip bit 0 only.
// They are two ENUM ARMS rather than one `not` resolved later because the choice is a
// TYPE decision, and the parser is the only tier that has the type: shv2's Std tier is
// width/ABI-resolved but carries no per-VALUE source type map (v1's lowering had one,
// which is why v1 emits a single `logicalNot` and resolves it in `lowerUnop`). The
// parser must classify `and`/`or` by operand type anyway — a bool one is control flow —
// so classifying `not` in the same place costs nothing and keeps ONE type oracle.
//
// P1.0d.4 appends the CONVERSION PAIR — the two ops that move a value BETWEEN the integer and
// float domains, and the reason a float can be computed with at all. They are unary ops rather
// than a dedicated `MaxonOp.convert` variant because a conversion has a unary op's exact shape
// (one operand in, one result out, non-trapping), and the dialect's rule is that shape decides.
// Both reference compilers agree: v1 lowers them to `StdArithUnaryOpcode.{fpToSiI64, siToFpF64}`,
// the bootstrap mints a `MaxonTruncOp`.
//
// ⭐ THEY ARE THE ONLY UNARY OPS WHOSE RESULT TYPE DIFFERS FROM THEIR OPERAND'S. `neg`/`bitNot`/
// `logicalNot` all answer in the type they were given, which is why `emitUnaryOp` could take the
// operand's own tag as the result tag and nothing ever noticed. These cannot — so their result
// tag is passed EXPLICITLY at the emit site, and the Std tier says the same thing a tier down
// (StdUnaryOpcode: "`operandType` is always the SOURCE, and the OPCODE names the result").
//
//   • `trunc`          — SOURCE-LEVEL, the `trunc(x)` builtin: f64 → int, TRUNCATING TOWARD ZERO
//                        (x64 `cvttsd2si`; the rounding `cvtsd2si` would answer 4 for
//                        `trunc(3.99)`). The one bridge out of the float domain the language has
//                        at this rung, and what nearly every case in specs-shv2/float-type.md
//                        ends on.
//   • `promoteToFloat` — COMPILER-INSERTED, never written by a user: int → f64 (x64 `cvtsi2sd`).
//                        It is what makes `5 + 2.0` mean 7.0, and `TypeRules.arithResultTag`
//                        answering `float` is the promise this op keeps.
//
// P1.0d.4-C appends the FOUR ARITY-1 FLOAT MATH INTRINSICS — `floor`, `ceil`, `round`, `sqrt`
// (specs/{floor,ceil,round,sqrt}.md). They are unary ops for the dialect's own reason: one operand
// in, one result out, non-trapping, so the SHAPE decides. Both reference compilers agree — v1 maps
// its whole math-intrinsic set onto `StdArithUnaryOpcode` (LowerMaxonToStd.maxon:13872), the
// bootstrap onto arity-1 Maxon ops with a `MaxonFloat Result` (MaxonDialect.cs:812-848).
//
// ⭐ THEY ARE f64 → f64, WHICH IS WHAT MAKES `trunc` THE WRONG TEMPLATE FOR THEM. `trunc` leaves
// the float domain; these stay inside it, so they get NO int identity short-circuit (`sqrt(16)` is
// `sqrt` of a PROMOTED 16.0, answering 4.0, not 16) and they are not conversions — `lowerUnaryOp`'s
// `assertConversionCrossesDomain` must never see one. What they share with `trunc` is only that
// their result tag is stated explicitly at the emit site.
//
// ⭐ `round` IS TIES-TO-EVEN, NOT HALF-AWAY-FROM-ZERO. x64 `roundsd imm8=0`, arm64 `frintn` and
// wasm `f64.nearest` are all round-to-nearest/ties-to-even, both references agree, and
// `specs/round.md`'s `round.halfway` case pins it: `round(2.5)` is **2**. The bare hardware
// instruction is already correct on all three targets — there is no correction layer.
export enum MaxonUnaryOp
	neg
	bitNot
	logicalNot
	trunc
	promoteToFloat
	floor
	ceil
	round
	sqrt
end 'MaxonUnaryOp'

// The comparison operators the Maxon tier represents (M4). A comparison SPLITS OUT
// of `MaxonBinOp` — even though it also takes two operands — because it produces a
// boolean (i1) and lowers to Std's separate `cmp` op (which sets the `isCmp`
// metadata the arithmetic `binOp` does not). Keeping it a distinct op family from
// its first commit mirrors the Std tier's `binOp`/`cmp` split, so nothing downstream
// has to re-derive "this two-operand op is a compare, not arithmetic".
export enum MaxonCmpOp
	eq
	ne
	lt
	gt
	le
	ge
end 'MaxonCmpOp'

// Variants are declared in CATEGORY-CONTIGUOUS BANDS, in `OpCategory` order, so a
// pass that treats a whole category uniformly covers it with ONE `match` range arm
// (`firstOwn to lastOwn then …`) instead of one arm per variant.
//
// INVARIANT — **a new variant is APPENDED AT THE END OF ITS BAND, never inserted
// into the middle of one.** A range arm names its endpoints, so it silently
// swallows anything inserted between them: the compiler reports no missing-case
// error, and the new op is misclassified at every range-arm site at once. This is
// the same rule `StdOp` carries, and the same one place the project's "no silent
// unhandled cases" guarantee has no compiler backstop — reviewers enforce it by
// hand. Appending at a band's end is always safe (the range's endpoint moves with
// it, deliberately).
export union MaxonOp
	// --- band: callFree ---
	// A free-function call `callee(args…)` whose result is a freshly-minted ValueId.
	// M5's first call op. Declared in its OWN band, BEFORE the plain band, so it is a
	// genuine new band rather than a mid-`plain` insert (a `plain`-band range arm would
	// silently swallow a variant appended into the middle of it — the band-append
	// invariant). `callFree` is the FIRST `OpCategory`, so this band leads the union.
	//
	// `callee` is identifier TEXT (a name, not a value) — a `ByteArray` slice of the
	// source per the MaxonOp header's value/name split (a name is looked up, not
	// computed). `args` are the argument SSA VALUES in SOURCE order (before label
	// reordering). `argLabels[i]` is arg `i`'s source-level `name:` label, or the empty
	// string for a positional argument (a parameter name can never be empty, so "" is an
	// unambiguous "no label" marker, not a value-masking sentinel); the parser enforces
	// that only the first argument is positional. `argRanges[i]` is arg `i`'s source span,
	// kept ON the op (genuine per-ARGUMENT payload, so not in the op-parallel
	// SourceRangeTable) for per-argument diagnostics. lowerCall reorders the labelled args
	// to the callee's declaration order using the `funcSignatures` registry.
	//
	// ⭐ **`argImmutableNames` — THE NAME AN E3019 WOULD BLAME FOR EACH ARGUMENT, or empty.** The
	// call-site half of the immutable-mutation rule needs to know which arguments name an IMMUTABLE
	// BINDING, and that is a property of the SYNTAX, not of the value: `let a = p` carries the
	// parameter `p`'s own ValueId while being a `let`, so a per-VALUE mark would refuse `f(p)` in any
	// function that also wrote `let a = p` (measured — the oracle refuses `f(a)` and accepts `f(p)`).
	// The parser resolves each argument exactly once and records the answer here, through the same
	// `immutableReceiverNameOf` the receiver half asks.
	//
	// ⚠ **IT IS PARALLEL TO `args` WHEN PRESENT AND EMPTY WHEN THE CALL HAS NO IMMUTABLE-BINDING
	// ARGUMENT** — unlike `argLabels`/`argRanges`, which are parallel unconditionally. Emptiness is the
	// literal answer ("no argument of this call names an immutable binding"), not a shortened column:
	// it is the state of every COMPILER-emitted call — none of which is checkable, their callees being
	// `__`-prefixed and in no signature registry — and of most user calls, so a shared empty array
	// serves them all and the op costs nothing. `immutableArgNameAt` is the one reader and decodes both
	// shapes.
	call(result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray) = MaxonOpMeta{category: OpCategory.callFree}
	// --- band: plain ---
	// Integer literal materialization. `value` is the already-parsed i64 (the
	// parser converts the raw token text via NumberParsing.parseInt at emit
	// time). `valueType` is the literal's source-level type (integer, or a
	// named ranged alias). `result` is the freshly-minted ValueId it defines.
	literal(result ValueId, value ParsedInt, valueType MaxonType) = MaxonOpMeta{category: OpCategory.plain}
	// Value-returning return terminator. Always placed as a block terminator via
	// setTerminator, never as a regular body op. `retVal` is the value to return.
	ret(retVal ValueId) = MaxonOpMeta{category: OpCategory.plain}
	// Void return terminator — `return` with no expression. A DISTINCT variant
	// rather than a `ret` carrying some empty-value sentinel: `ValueId` has no
	// "absent" value, and a sentinel is exactly what the project forbids. (v1
	// passed an empty `ByteArray` here, which only ever "worked" because the
	// void-`main` case is rejected by E3002 before lowering ever runs.)
	retVoid = MaxonOpMeta{category: OpCategory.plain}
	// Binary operation over two already-materialized SSA values:
	// `result = lhs <op> rhs`. M2 emitted this only for `+`; M3 also carries `-`
	// and `*` (MaxonBinOp.add/sub/mul). It stands alone (matched by variant), so
	// category `plain` — appended at the END of the plain band, honoring the
	// band-append invariant above.
	binOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp) = MaxonOpMeta{category: OpCategory.plain}
	// Unary operation over one already-materialized SSA value: `result = <op> operand`.
	// M3 emits this for prefix `-` (MaxonUnaryOp.neg). Like `binOp` it stands alone
	// (matched by variant), so category `plain` — appended at the END of the plain
	// band, after `binOp`, honoring the band-append invariant.
	unaryOp(result ValueId, operand ValueId, op MaxonUnaryOp) = MaxonOpMeta{category: OpCategory.plain}
	// Comparison over two already-materialized SSA values: `result = lhs <op> rhs`,
	// producing a boolean (i1). M4 emits this for `==`/`!=`/`<`/`>`/`<=`/`>=`. Its
	// result feeds an `if`'s `condBranch`; the Std→x64 lowering FUSES the pair into
	// `cmp` + `jcc` rather than materializing the bool. Category `plain` (it stands
	// alone, matched by variant); appended at the END of the plain band after `unaryOp`.
	compare(result ValueId, lhs ValueId, rhs ValueId, op MaxonCmpOp) = MaxonOpMeta{category: OpCategory.plain}
	// Two-way conditional branch terminator: if `cond` (an i1) holds, transfer to
	// `thenBlockId`, else to `elseBlockId`. M4's `if` sets this as a block's
	// terminator (via emitTerminator). `cond` is the SSA value a `compare` defined;
	// the block ids are the function-local BlockIds of the successor blocks. Category
	// `plain`, matching the other terminators `ret`/`retVoid` (the Maxon-tier
	// `OpCategory` classifies call/effect shape, not control flow — that is the Std
	// tier's `control` band); appended at the END of the plain band.
	condBranch(cond ValueId, thenBlockId BlockId, elseBlockId BlockId) = MaxonOpMeta{category: OpCategory.plain}
	// Unconditional branch terminator to `targetBlockId`. Emitted when a then/else
	// block falls through to the merge (continuation) block rather than returning.
	branch(targetBlockId BlockId) = MaxonOpMeta{category: OpCategory.plain}
	// --- band: varAccess (P1.0d.5b — top-level `var`) ---
	//
	// The FIRST occupants of the `varAccess` band, which has been declared and empty since
	// M1. They are the Maxon-tier twins of the Std memory band and lower to it 1:1
	// (`lowerGlobalAddr`/`lowerLoadIndirect`/`lowerStoreIndirect`) — the same THREE-op split
	// (address, then load or store) rather than a fused `globalLoad`, for the reason
	// StdDialect's memory band gives: it is the general pair P1.1's field access and P1.2's
	// heap access already need.
	//
	// ⚠ APPENDED AT THE END OF THE UNION — past `branch`, the old last variant — NOT into
	// the middle of the `varAccess` band's nominal position between `panicking` and
	// `awaiting`. The band ORDER in `OpCategory` is the declaration's intent; the union's
	// variant order is what range arms read, and appending past the tail is the only
	// placement the compiler can check (a mid-union insert is silently swallowed by any
	// `… to branch` range arm). The bands stay category-contiguous because `varAccess` was
	// EMPTY: these three are its whole membership, so they are contiguous wherever they sit.
	//
	// ⭐ SHV2 SKIPS v1's `unresolvedRead`/`unresolvedAssign` INDIRECTION ENTIRELY. v1 emits a
	// placeholder op at parse time and rewrites it in TypeResolution
	// (`rewriteUnresolvedRead`) because its parser cannot know whether a bare name is a
	// local, a constant or a global — the declaration may be in another file it has not read.
	// shv2's `SignatureIndex` HAS that whole-program answer before any file is parsed, so the
	// parser emits the real op directly and there is no placeholder, no rewrite pass, and no
	// second op union to keep in step.
	//
	// The ADDRESS of a data-section global. `label` is identifier TEXT (a NAME, looked up —
	// not a value), per the MaxonOp header's value/name split, and it is the storage label
	// `ProgramSignatures` derived — see `SignatureIndex.dataLabelFor`.
	globalAddr(result ValueId, label ByteArray) = MaxonOpMeta{category: OpCategory.varAccess}
	// Read a `valueType` value from `addr + offset`. `valueType` is the SOURCE-level type
	// (integer/boolean); the width collapse to `StdType` happens only in lowering, per the
	// MaxonType contract.
	loadIndirect(result ValueId, addr ValueId, offset ByteOffset, valueType MaxonType) = MaxonOpMeta{category: OpCategory.varAccess}
	// Write `value` to `addr + offset`. A STATEMENT, not an expression — it defines no
	// result, so unlike its two band-mates it mints no ValueId.
	storeIndirect(addr ValueId, offset ByteOffset, value ValueId, valueType MaxonType) = MaxonOpMeta{category: OpCategory.varAccess}
	// A `String` LITERAL (P1.2 wave A): `result` is a pointer to an IMMORTAL 48-byte rdata record.
	// `bytes` is the literal's DECODED UTF-8 payload — the parser has already resolved every escape
	// (`decodeEscapes`), so what rides here is the exact byte sequence the record's blob will hold.
	//
	// The bytes ride the op inline, exactly as `literal`'s `ParsedInt value` does — a string literal
	// is DATA, not a name to look up, and it is not on any hot path (one op per literal occurrence).
	// A per-artifact string registry (with the id-remap-on-merge machinery `named` types need) would
	// be strictly more moving parts for no benefit: `LowerMaxonToStd` registers the rdata and
	// `GlobalDataTable.registerRdataConstant` already DEDUPES identical blobs, so the record and its
	// blob are shared across every occurrence of the same literal regardless.
	//
	// It carries NO ownership: a literal is never allocated, refcounted or dropped, so category
	// `plain` (it stands alone, matched by variant). ⚠ APPENDED AT THE END OF THE UNION, past
	// `storeIndirect`, per the band-append invariant: `literal to storeIndirect` is a range arm
	// (SemanticCheck, MmRuntime) and appending past the tail is the only placement the compiler
	// reports on.
	stringLiteral(result ValueId, bytes ByteArray) = MaxonOpMeta{category: OpCategory.plain}
	// --- P1.4b: scalar error handling (dual-register `(value, errorFlag)` ABI) ---
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `stringLiteral`, per the band-append invariant: a
	// mid-union insert is silently swallowed by any range arm (`literal to storeIndirect`, the
	// category ranges). Their `OpCategory` is metadata independent of this tail position.
	//
	// A THROWING free call `try callee(args…)`. The Maxon-tier twin of `call`, plus a SECOND def:
	// `result` is the primary value (R8 / x0 on return), `errorFlag` is the dual-register error flag
	// (R10 / x9). `errorFlag` is `0` when the callee returned normally and `ordinal + 1` when it threw
	// a scalar error (the `+1` reserving 0 for "no error in flight"). The compare/branch desugar the
	// PARSER emits (`compare(errorFlag != 0)` + `condBranch`) is what reads the flag; the value is used
	// on the success edge. Category `callFree`, the same band as `call` — it IS `call` plus the flag def.
	// `argImmutableNames` carries the same per-argument blame names a plain `call` does — see there.
	tryCall(result ValueId, errorFlag ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray) = MaxonOpMeta{category: OpCategory.callFree}
	// THROW an error — a `throw E.case` / `throw U.case(x)` or `otherwise (e) throw e`. TERMINATOR (control
	// leaves the function via the error edge). `errorValue` is either the enum ORDINAL (a SCALAR error) or a
	// heap-box POINTER (a payload-bearing/boxed union), and `errorIsBoxed` is which — the ONE bit the
	// re-encode in `lowerMaxonToStd` needs, DERIVED in the parser (which alone holds the enum registry) so
	// lowering carries no classification. A SCALAR error's `ordinal + 1` re-encoding is applied in
	// `lowerMaxonToStd` (the ABI lives in ONE place); a BOXED error's pointer is written to the flag VERBATIM
	// (it is already non-zero, so `flag != 0` still reads "error in flight"). `propagateError` carries an
	// ALREADY-encoded flag, kept DISTINCT so the +1 never doubles up. Category `plain`, like the other terminators.
	throwError(errorValue ValueId, errorIsBoxed bool) = MaxonOpMeta{category: OpCategory.plain}
	// PROPAGATE a caught error flag verbatim — an uncaught `try f()` inside a throwing function
	// re-publishes the callee's flag to its own caller. TERMINATOR. `errorFlag` is ALREADY the
	// `ordinal + 1` encoding (it came out of a `tryCall`), so lowering re-emits it into the error
	// register with NO re-encoding — the whole reason it is distinct from `throwError` (which carries
	// an ordinal and does the +1). Category `plain`.
	propagateError(errorFlag ValueId) = MaxonOpMeta{category: OpCategory.plain}
	// ABORT the process, printing `message` (a `String` value) — the primitive a user `panic("…")` ends
	// on (an `otherwise panic(…)` handler or a match `default panic(…)`). It is a BODY op, not a
	// terminator: the parser emits it followed by a dead return terminator (control never returns, so the
	// return is unreachable but keeps the block well-formed). `lowerMaxonToStd` expands it into
	// `osWriteStdout(buffer, length)` + `osExit(code)` — the first occupant of the `panicking` band, which
	// has been declared and empty since M1.
	panicAbort(message ValueId) = MaxonOpMeta{category: OpCategory.panicking}
	// --- P1.5-A1: non-capturing function values ---
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `panicAbort`, per the band-append invariant: a mid-union
	// insert is silently swallowed by any range arm (`globalAddr to storeIndirect`, `literal to
	// storeIndirect`, `throwError to propagateError`). Their `OpCategory` metadata places each variant
	// logically, independent of this tail position.
	//
	// A named function used as a VALUE — address-of, `let f = double`. `funcName` is identifier TEXT (a
	// NAME, looked up — not a value), per the MaxonOp header's value/name split. It has NO env, NO heap
	// and NO effect: a bare code pointer, allocation-free. It lands in `plain` (matched by variant,
	// standing alone) exactly as `literal`/`stringLiteral` do — NOT in the reserved `closureProducer`
	// band, which is for A2's `closureCreate`, the op that allocates a heap environment block and is what
	// a coarse "does this produce a heap closure?" membership test will want. functionRef allocates
	// nothing, so it is not that.
	functionRef(result ValueId, funcName ByteArray) = MaxonOpMeta{category: OpCategory.plain}
	// A call THROUGH a function VALUE — `f(21)`, `h.op(21)`, `pick()(21)`. `callee` is a `ValueId` holding
	// the code pointer (unlike `call`'s `callee ByteArray` NAME) — the whole reason it is a distinct op. It
	// has full call-barrier semantics like `call`, so category `callFree` (the same band as `call`/`tryCall`).
	//
	// ⚠ **NO `argLabels`/`argRanges` (a DEVIATION from `call`, DELIBERATE).** A1 indirect calls are
	// POSITIONAL — a function TYPE has no parameter names, so there is nothing to label — and this rung does
	// not validate an indirect call's arguments, so per-argument labels and spans would be dead weight:
	// always empty and read by nothing. `args` alone is what an indirect call needs. The Std
	// `callIndirect` it lowers to DOES carry the function value's signature (`resultType`/`argFloatMask`, for
	// the float result/arg register files — P1.5 #78), but `lowerIndirectCall` derives that from the
	// already-typed result and arg VALUES (`stdTypeOf`), so no signature rides this Maxon op either.
	//
	// ⚠ Its `args` (an `Array with ValueId`) must be BOUND in a SMALL match, never destructured by
	// `lowerMaxonToStd.lowerOp`'s big one — see `LowerMaxonToStd.lowerIndirectCall` for the bootstrap
	// miscompile that forces the indirection (a tail-slot `Array` binding in a large match corrupts the
	// scrutinee's decref). A design fact about how this op is CONSUMED, recorded where it is DECLARED.
	indirectCall(result ValueId, callee ValueId, args ValueIdArray) = MaxonOpMeta{category: OpCategory.callFree}
	// --- P1.5-B1a: async / await (green-thread scheduler) ---
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `indirectCall`, per the band-append invariant: a mid-union
	// insert is silently swallowed by any range arm. Their `OpCategory.awaiting` (the band declared and
	// empty since M1) is metadata independent of this tail position.
	//
	// SPAWN a green thread running `callee(args…)` and yield a Promise handle. The Maxon-tier twin of `call`
	// — same (callee NAME, args, `name:` labels, ranges) shape, so lowering slots the labelled args into
	// parameter order exactly as `lowerCall` does — but instead of RUNNING the call it lowers to
	// `__gt_spawn(funcAddr(callee), argBuf)`, spilling the scalar args into `argBuf`. `result` is the i64
	// promise handle (the spawned GT's pointer). The parser rejects a managed/float async arg or result
	// (E2015) before this op is emitted, so every `args` value and the callee's return are GPR scalars.
	// `argImmutableNames` carries the same per-argument blame names a plain `call` does — see there.
	asyncCall(result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray) = MaxonOpMeta{category: OpCategory.awaiting}
	// AWAIT `promise`'s green thread and yield its result. `promise` is the i64 handle `asyncCall` produced;
	// `result` is the awaited scalar. Lowers to `__gt_await(promise)`.
	await(result ValueId, promise ValueId) = MaxonOpMeta{category: OpCategory.awaiting}
	// --- P1.5-B2b: error-carrying `try await` ---
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `await`, per the band-append invariant: a mid-union insert is
	// silently swallowed by any range arm. Its `OpCategory.awaiting` (shared with `await`) is metadata
	// independent of this tail position.
	//
	// A THROWING await `try await promise`. The dual-register twin of `await`, plus a SECOND def: `result` is
	// the awaited primary value (R8 on return), `errorFlag` is the dual-register error flag (R10) the awaited
	// thunk threw — `0` when it returned normally, `ordinal + 1`/box-pointer when it threw. The parser rewrites
	// an `await` target of a `try` into this op (as it rewrites `call` into `tryCall`); it lowers to
	// `__gt_try_await(promise)`, the throwing scheduler driver, and the `try … otherwise …` desugar reads the
	// flag exactly as it does for a `tryCall`. Category `awaiting`, the same band as `await` — it IS `await`
	// plus the flag def.
	tryAwait(result ValueId, errorFlag ValueId, promise ValueId) = MaxonOpMeta{category: OpCategory.awaiting}
	// --- P1.6-B1: `sizeof(Type)` ---
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `tryAwait`, per the band-append invariant: a mid-union
	// insert is silently swallowed by any range arm. Its `OpCategory.plain` (it stands alone, matched by
	// variant — like `literal`) is metadata independent of this tail position.
	//
	// The byte size of `targetType`. A CONCRETE operand (a primitive, a declared struct) is a compile-time
	// constant `lowerMaxonToStd` folds to a `const`; a `typeParameter(pos)` operand — `sizeof(T)` inside a
	// generic body compiled ONCE against an opaque `T` — has no single compile-time answer, so it lowers to a
	// runtime load of the enclosing instance's layout descriptor `elementLogicalSize@56` slot (the
	// dictionary-passing model — see LayoutDescriptor). `result` is the integer it defines.
	sizeofType(result ValueId, targetType MaxonType) = MaxonOpMeta{category: OpCategory.plain}
	// --- P1.7 slice 2: `b"…"` byte-string literals ---
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `sizeofType`, per the band-append invariant: a mid-union
	// insert is silently swallowed by any range arm (`literal to storeIndirect`, the category ranges).
	// Its `OpCategory.plain` (it stands alone, matched by variant — like `stringLiteral`) is metadata
	// independent of this tail position.
	//
	// A `b"…"` literal — an `Array with Byte` whose bytes are a compile-time constant. `bytes` is the
	// DECODED Latin-1 payload (`Parser.decodeByteStringLiteral`: escapes resolved, each source codepoint
	// mapped to one byte, a codepoint above 0xFF already rejected E1004). It lowers to a heap 48-byte
	// Array record (`__mm_alloc`) whose `buffer@0` points at the bytes in immortal `.rdata` and whose
	// `capacity@16` is the rdata sentinel `-2` (the buffer is never freed) — the Array analogue of a
	// String literal's immortal blob, but with an owned heap RECORD so the value is a first-class owned
	// `Array with Byte` the ownership model drops through `__arr_decref` (which skips the rdata buffer on
	// the `capacity < 0` sentinel). `result` is the record pointer. Category `plain` (stands alone).
	byteStringLiteral(result ValueId, bytes ByteArray) = MaxonOpMeta{category: OpCategory.plain}
	// --- P1.1b slice 2: the DENSE-match jump table ---
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `byteStringLiteral`, per the band-append invariant: a
	// mid-union insert is silently swallowed by any range arm (`literal to storeIndirect`, the category
	// ranges). Its `OpCategory.plain` is metadata independent of this tail position — like the other
	// terminators (`ret`/`condBranch`/`branch`), the Maxon-tier `OpCategory` classifies call/effect shape,
	// not control flow, so a terminator lands in `plain` (the Std tier's `control` band is where the
	// switch's control nature is recorded — see StdOp.switch).
	//
	// ⭐ **THE MULTIWAY BRANCH TERMINATOR** the parser emits for a DENSE integer-like `match` — the O(1)
	// indexed jump the density heuristic (`emitDispatchRange`) chooses over the balanced binary search when
	// the covered value span is tight enough to be worth a table. `subject` is the ALREADY ZERO-BIASED index
	// (the parser emits a `subject − min` bias `binOp` before this op, so slot `i` selects the biased value
	// `i`); `denseTargetBlockIds[i]` is the block a subject of biased value `i` transfers to, holes filled
	// with `defaultBlockId`; a value outside `[0, denseTargetBlockIds.count())` (UNSIGNED — a negative bias
	// wraps large) reaches `defaultBlockId`. It has N+1 successors — every distinct target block plus the
	// default. Lowers 1:1 to `StdOp.switch`.
	//
	// ⚠ Its array field `denseTargetBlockIds` is bound in a SMALL match (`lowerSwitch`), never destructured
	// by `lowerMaxonToStd.lowerOp`'s big one — the same tail-slot-Array-corrupts-the-decref trap
	// `indirectCall` documents.
	switch(subject ValueId, denseTargetBlockIds BlockIdArray, defaultBlockId BlockId) = MaxonOpMeta{category: OpCategory.plain}
	// --- P1.7a slice 2a: constrained-type-parameter interface DISPATCH ---
	//
	// ⚠ APPENDED AT THE END OF THE UNION, past `switch`, per the band-append invariant: a mid-union insert is
	// silently swallowed by any range arm. Its `OpCategory.callFree` (shared with `call`/`indirectCall` — it
	// IS a call, with full call-barrier semantics) is metadata independent of this tail position, exactly as
	// `switch`'s `plain` and `asyncCall`'s `awaiting` are.
	//
	// ⭐ **DISPATCH AN INTERFACE METHOD ON A CONSTRAINED TYPE PARAMETER** — `self.item.digest()` where `item`
	// is a value of a type parameter `T` constrained `where T is Digest`. The concrete type is UNKNOWN in the
	// shared generic body (dictionary-passing, NOT monomorphization), so the call goes through a runtime
	// WITNESS: `args[0]` is the receiver (the `T` value), `args[1..]` the user arguments; `constraintIndex` is
	// which of the enclosing type's `where` constraints supplies the witness (index into `whereConstraints` /
	// the hidden witness-parameter list); `methodIndex` is the DECL-ORDER slot of the method within that
	// constraint's interface. `lowerMaxonToStd` resolves the witness address — `rdataAddr(__witness_<T>.<I>)`
	// at a concrete instantiation, or the caller's own forwarded witness parameter in a generic→generic call —
	// and emits the fused `StdOp.witnessCall`. `isVoid` records whether the method returns nothing (no result
	// register to capture). `result` is the value it defines (a `void`-tagged discard when `isVoid`).
	//
	// ⚠ Its `args` (an `Array with ValueId`) is bound only in a SMALL match (`lowerWitnessDispatch`), never
	// destructured by `lowerMaxonToStd.lowerOp`'s big one — the same tail-slot-`Array`-corrupts-the-decref trap
	// `indirectCall`/`switch` document.
	witnessDispatch(result ValueId, args ValueIdArray, constraintIndex WitnessSlotIndex, methodIndex WitnessMethodIndex, isVoid bool) = MaxonOpMeta{category: OpCategory.callFree}
end 'MaxonOp'

// The dual-register error-flag ABI BIAS (P1.4b). The error flag is `0` for "no error in flight" and
// `errorOrdinal + ErrorFlagOrdinalBias` when a scalar error is thrown — the bias is what reserves `0`.
// This is ONE fact read from BOTH sides of a tier boundary and they MUST agree: the Std-tier lowering
// ENCODES a throw (`lowerThrowError`: ordinal + bias) and the Maxon-tier parser DECODES an `(e)` binding
// (`parseOtherwiseBlock`: flag - bias). A divergence here would not fail to compile — it would silently
// bind `match e` to the wrong case — so the two derive from this constant rather than each spelling `1`.
export let ErrorFlagOrdinalBias = 1 as ParsedInt
