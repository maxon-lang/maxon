// LowerMaxonToStd — Maxon → Std lowering. Takes a MaxonModule and produces a
// fresh StdModule.
//
// **What this pass is FOR: the width/ABI collapse and the 1:N desugaring.**
// `MaxonType` is width-free and source-level; `StdType` is width/ABI-resolved.
// That translation (`maxonTypeToStdType`) is this boundary's real content, along
// with the 1:N expansions that GROW here — a `for-in` into an iterator protocol, a
// labelled method call into a dispatch, a string interpolation into a buffer
// build, an `own.drop` into a `__destruct_T` call.
//
// **What this pass is NOT for: value numbering.** ValueIds pass through VERBATIM —
// the parser mints them (see MaxonDialect's MaxonOp header). v1 did the opposite:
// it named Maxon values `$tN` and re-derived ids here through a per-function
// `nameToId` map, which cost a heap String + ByteArray per value and a
// byte-sequence-keyed hash map (O(len) compares, one insert + one lookup per
// value) to convert one dense counter into another. It constructed no SSA — user
// variables are `VarSlot`s, and `mem2reg` does the real SSA work at the Std tier.
// The map, `defineName`, and `resolveName` are all deleted.
//
// Ops that SYNTHESIZE new values (the 1:N desugarings) must not collide with the parser's ids: they
// mint from `nextValueId`, a per-function counter seeded at the parser's dense id count (the next free
// id). P1.4b's error lowering is the first to synthesize — the `+1` flag re-encode, the zero flag of a
// throwing return — and the Std passes downstream grow their dense columns
// to fit, so a monotonic counter is all that is needed (no per-function object).
//
// THIN for maxon-shv2 M1: lowers exactly the `return 42` slice —
//   maxon.literal -> StdOp.const
//   maxon.ret     -> StdOp.ret
// Later milestones GROW `lowerOp`/`lowerTerminator` with the var / arith / call
// / control-flow arms (and the throwing / fat-interface return arms of
// `emitRetOrErrorReturn`) as the Maxon and Std dialects grow.

// Collapse a source-level MaxonType to its width/ABI-resolved StdType. M1
// handles only the primitive arms. `named` and `unresolved` are a
// TypeResolution (Chunk C) responsibility: that pass replaces every
// `named(alias)` with the primitive it resolves to (consulting the typealias
// registry for its width) and eliminates every `unresolved` BEFORE lowering
// runs. Seeing either arm here is a pipeline-ordering bug (TypeResolution did
// not run, or left a residue) — not a user error — so it panics loudly rather
// than silently guessing a width. GROWS at Chunk C to resolve `named` widths
// through the registry once that registry exists.
// An interface's transitive witness-slot list, held per interface for the module being lowered — keyed by
// the declaration-order handle a `witnessDispatch` names its interface by, so the memo is asked with the
// very scalar the op carries and needs no name round-trip. See `MaxonToStdLowering.witnessSlotsOf`.
typealias WitnessSlotListMemo = Map with (InterfaceDeclIndex, CollectedInterfaceMethodArray)

export function maxonTypeToStdType(ref MaxonType) returns StdType
	// The two arms TypeResolution was supposed to eliminate. They are a PIPELINE-ORDERING bug
	// (that pass did not run, or left a residue) rather than a user error, and they are checked
	// HERE rather than in `valueTagToStdType` because the two functions are asked different
	// questions about the same arm — see that function's header on why a `named` TAG is normal
	// while a `named` TYPE at this point is not.
	match ref 'residue'
		named then panic("maxonTypeToStdType: a `named` type must be resolved to a primitive before lowering (TypeResolution did not run)")
		unresolved then panic("maxonTypeToStdType: an `unresolved` type reached lowering (TypeResolution did not run)")
		boolean to float then break 'residue'
		exitCode then break 'residue'
		// A struct reference is NOT a residue — it is what `resolveNamedType` PRODUCES for a
		// declared `type`, and it is already concrete. Its width is a machine word, assigned one
		// line down by the same table every other arm's comes from. (`named` is checked above and
		// this is not, because they are two different questions about one union: a `named` type
		// surviving to here means resolution left work undone; a `structRef` means resolution DID
		// its work.)
		structRef then break 'residue'
		// A String is NOT a residue — `Parser.parseTypeReference` produces `MaxonType.string` for the
		// `String` builtin directly (syntactically, like `Self`), so it is already concrete. Its width
		// is a machine word (a pointer), assigned one line down by the same table every arm's comes from.
		string then break 'residue'
		// A function value is NOT a residue — `Parser.parseTypeReference`/`emitFunctionRef` produce
		// `MaxonType.function` directly, so it is already concrete. Its width is a machine word (a `.text`
		// code pointer), assigned one line down by the same table every arm's comes from.
		function then break 'residue'
		// A type parameter and a generic instance are NOT residues (P1.6-A) — the parser produces them
		// directly and `resolveType` leaves them alone (they are already concrete: an opaque i64 and a
		// struct pointer). Their width is a machine word, assigned one line down by the same table.
		typeParameter then break 'residue'
		genericInstance then break 'residue'
		// A Character is concrete — a record pointer — so it is no more a residue than a String is.
		character then break 'residue'
		// An EXISTENTIAL is concrete: `Parser.parseTypeReference` mints `interfaceRef` directly for a name
		// the whole-program interface registry knows, and `denotedNamedType` mints one for a swept `named`
		// that turns out to be an interface. Its width here is the VALUE half's machine word — the witness
		// half is a SEPARATE value with its own Std type, never a widening of this one.
		interfaceRef then break 'residue'
	end 'residue'

	return valueTagToStdType(maxonTypeTag(ref))
end 'maxonTypeToStdType'

// ⭐ THE WIDTH/ABI COLLAPSE, STATED OVER THE PARSER'S DENSE TAG COLUMN — and the form the
// per-OPERAND path must use. `maxonTypeToStdType` is the same collapse asked of a `MaxonType`,
// and it DELEGATES here rather than restating the lattice: this boundary's whole content is that
// one table, and two copies of it are the drift that would let a `literal`'s width and its
// operand's width come to disagree.
//
// It takes a TAG, and the reason is measured rather than aesthetic: the alternative spelling —
// `maxonTypeToStdType(maxonTypeOfTag(tag, …))` — REBUILDS A `MaxonType`, and **a Maxon union
// value is a heap object** (MaxonDialect's ValueTypeTag header has the measurement: the first cut
// of exactly this shape cost +4,165 allocations on scale-test's smallest rung). `operandType` is
// read for every operand of every arithmetic op in the program — the compiler's hottest path — so
// the answer has to be a scalar computed from a scalar.
//
// ⚠ `named` collapses to `i64` here and PANICS there, and that asymmetry is deliberate. A
// `MaxonType.named` reaching lowering means TypeResolution left a residue; a `named` TAG is
// perfectly ordinary, because `TypeResolution.resolveTypes` rewrites function SIGNATURES and
// never the parser's `valueTags` column — so a parameter declared with a ranged alias still
// carries a `named` tag right here. It collapses to i64 because a `named` value is an INT in every
// position F1 can reach one: as of F1 a `float(low to high)` alias is also legal
// (`Parser.readTypeAliasDeclaration`), but a float alias is tagged `named` only as a param/field, all
// deferred to the float ABI (F2), and the i64 collapse there forces a cross-file move the x64
// allocator PANICS on rather than passing a double in a GPR — never a wrong answer. Classing a float
// alias as f64 needs `named` resolved through the alias registry, which is that F2 work (TypeRules'
// `typeClassOf`/`tagIsIntegral`/`notOperatorFor` all cite the same resolution).
export function valueTagToStdType(tag ValueTypeTag) returns StdType
	match tag 'collapse'
		boolean then return StdType.i1
		integer then return StdType.i64
		float then return StdType.f64
		named then return StdType.i64
		// `exitCode` is the resolved `ExitCode` builtin alias. Its width is
		// assigned HERE (unsigned 32-bit) — this is the sole place ExitCode's
		// width lives, keeping MaxonType itself width-free (see MaxonDialect).
		exitCode then return StdType.u32
		unresolved then panic("valueTagToStdType: an `unresolved` tag reached lowering — it is a call to a function no file in the program declares, which SemanticCheck reports as E3004 and which therefore never reaches codegen")
		void then panic("valueTagToStdType: a `void` tag names no value, so it has no width — a void call's result is a discarded statement result (Parser.parseCall) and can never be an operand")
		// ⭐ A STRUCT IS A POINTER, AND THIS LINE IS THE WHOLE OF THAT DECISION. `type Point` is a
		// heap-allocated refcounted box (`Parser.emitStructLiteral` → `__mm_alloc`), and a value of
		// that type is the box's ADDRESS — one machine word, in a GPR, passed and returned like any
		// other i64. It is why `sizeof(Outer{p Point, n Integer})` is 16 and not 24: a struct FIELD
		// is a pointer too. Nothing above this line knows the width, which is the point — MaxonType
		// stays width-free (see MaxonDialect) and the machine word is named exactly once, here.
		structRef then return StdType.i64
		// ⭐ A STRING IS A POINTER — to the fused 56-byte rdata record. One machine word, in a GPR,
		// passed and returned like any other i64. Nothing above this line knows the width, which is the
		// point: MaxonType stays width-free and the machine word is named exactly once, here.
		string then return StdType.i64
		// ⭐ A FUNCTION VALUE IS A POINTER — a `.text` code address. One machine word, in a GPR, passed
		// and returned like any other i64. Nothing above this line knows the width, which is the point:
		// MaxonType stays width-free and the machine word is named exactly once, here.
		function then return StdType.i64
		// ⭐ A TYPE PARAMETER IS AN OPAQUE MACHINE WORD (P1.6-A). `T` in `type Box uses T` lowers to an
		// i64, which is the WHOLE of what makes a generic type's method bodies compile ONCE and be
		// byte-identical to the equivalent monomorphic struct: a trivial type argument is passed in a
		// GPR and stored in an 8-byte slot like any other scalar. Nothing above this line knows the
		// width — MaxonType stays width-free — and the machine word is named exactly once, here.
		typeParameter then return StdType.i64
		// A GENERIC INSTANCE IS A POINTER to the base struct's box — one machine word, like `structRef`.
		genericInstance then return StdType.i64
		// A CHARACTER IS A POINTER to the fused byte record — the same machine word a String is.
		character then return StdType.i64
		// ⭐ **AN EXISTENTIAL'S *VALUE HALF* IS A POINTER** — one machine word, exactly as `structRef` is.
		// This tag types ONE of the fat pointer's two words and never both: the witness half is a separate
		// value carrying its own (integer) tag, which is what keeps the collapse a scalar-to-scalar table
		// rather than something that would have to answer with a width of 16.
		interfaceRef then return StdType.i64
	end 'collapse'
end 'valueTagToStdType'

// Collapse a function's MaxonReturnType to its StdReturnType. `void` maps
// straight across; a value return collapses its inner type via maxonTypeToStdType.
export function maxonReturnTypeToStdReturnType(ref MaxonReturnType) returns StdReturnType
	match ref 'collapse'
		void then return StdReturnType.void
		value(inner) then return StdReturnType.value(maxonTypeToStdType(inner))
	end 'collapse'
end 'maxonReturnTypeToStdReturnType'

// ⭐⭐ **DOES THIS FUNCTION'S ABI USE THE SECONDARY RETURN SLOT? — THE ONE DEFINITION, AND THERE MUST ONLY
// EVER BE ONE (P1.7a slice 2, the return ABI).**
//
// shv2 returns ONE value in the primary register (R8 / x0 / the wasm result), plus — for some functions — a
// SECOND machine word in a fixed secondary register (R10 / x9 / a second wasm result). `StdOp.errorReturn`
// writes that pair and `StdOp.tryCall` captures it; the slot is the same one whichever fact put it there:
//
//   • the function THROWS, and the second word is the error flag (P1.4b);
//   • the function RETURNS AN INTERFACE, and the second word is the WITNESS half of the fat pointer it
//     hands back. v1 reaches the identical arrangement from the identical constraint —
//     *"the secondary register (RDX/X1) — normally the error flag — carries the witness-table address
//     instead. Same register convention, same op shape"* (`LowerMaxonToStd.maxon:13518-13525`).
//
// **THE TWO ARE MUTUALLY EXCLUSIVE, BY A REFUSAL RATHER THAN BY LUCK**: there is one register and both want
// it, so a declaration that is both is E2015 at its `function` line
// (`DeclaredStoragePosition.throwingReturnType`). That refusal is what lets every reader below treat "uses
// the slot" as a single bit and still know what is IN it.
//
// ⚠ **THREE READERS, AND THEY MUST AGREE OR THE TARGETS DISAGREE ABOUT A FUNCTION'S SHAPE.** The two
// emitters of a return (`emitRetOrErrorReturn`, `emitRetVoidOrErrorReturn`) decide what the callee WRITES;
// the wasm signature builder (`funcSignatureResultValTypes`) declares what its TYPE says. The native
// backends need no third asker — a fixed register is outside the signature — but wasm's is IN it, so a
// disagreement there is a `call_indirect`/`call` functype mismatch and traps at run time, while on x64 it is
// a silently dropped word. Spelling the disjunction a second time anywhere is how that drift starts.
export function functionUsesSecondaryReturnSlot(returnType MaxonReturnType, throws ThrowsClause) returns bool
	if throwsClauseIsThrowing(throws) 'theErrorFlag'
		return true
	end 'theErrorFlag'

	return match returnType 'theWitnessHalf'
		void gives false
		value(inner) gives maxonTypeTag(inner) == ValueTypeTag.interfaceRef
	end 'theWitnessHalf'
end 'functionUsesSecondaryReturnSlot'

// Map a source-level binary operator to its width/ABI-resolved Std `binOp` opcode.
// Every NON-TRAPPING operator maps to a `StdBinOpcode` — the arithmetic set
// (`add`/`sub`/`mul`), the bit set (`bitAnd`/`bitOr`/`bitXor`/`shl`/`shr`), and the FLOAT
// division. `mod` does NOT (it lowers to its own `StdOp.mod` variant because idiv traps —
// see `lowerBinOp`), so it panics here rather than inventing a bogus opcode.
// Exhaustive over MaxonBinOp (every arm is named).
//
// ⚠ `div` IS FLOAT-ONLY, and this function CANNOT enforce that — it sees an operator, not an
// operand type. `lowerDivision` is the one place a `/` picks its Std op, and `appendStdBinOp`
// carries the guard that makes an integer `binOp(div)` unrepresentable rather than merely
// unwritten. Do not call this with `div` from anywhere else.
function maxonBinOpToStdOpcode(op MaxonBinOp) returns StdBinOpcode
	match op 'map'
		add then return StdBinOpcode.add
		sub then return StdBinOpcode.sub
		mul then return StdBinOpcode.mul
		div then return StdBinOpcode.div
		mod then panic("maxonBinOpToStdOpcode: `mod` lowers to StdOp.mod — a trapping op with its own Std variant, not a binOp opcode; lowerBinOp must route it directly")
		bitAnd then return StdBinOpcode.bitAnd
		bitOr then return StdBinOpcode.bitOr
		bitXor then return StdBinOpcode.bitXor
		shl then return StdBinOpcode.shl
		shr then return StdBinOpcode.shr
		shrLogical then return StdBinOpcode.shrLogical
		// The `min`/`max` intrinsics — 1:1 renames like the arithmetic band's. Float-only on both sides
		// of the boundary, and `appendStdBinOp`'s guard is what makes that unrepresentable rather than
		// merely unwritten (`stdBinOpcodeIsFloatOnly`).
		min then return StdBinOpcode.min
		max then return StdBinOpcode.max
		// The UNSIGNED divisions have no `binOp` opcode for the reason `mod` has none, twice over: they
		// trap, so they need `StdOp.div`/`mod`'s `isPure: false`, and they are integer-only, so there is
		// no float `binOp` for them to be. `lowerBinOp` routes both directly.
		divUnsigned to modUnsigned then panic("maxonBinOpToStdOpcode: `{op.rawValue}` lowers to StdOp.div/mod with `IntegerSignedness.unsigned` — a trapping op with its own Std variant, not a binOp opcode; lowerBinOp must route it directly")
	end 'map'
end 'maxonBinOpToStdOpcode'

// Map a source-level unary operator to its Std opcode. A 1:1 rename in every arm —
// the TYPE decision that split `not` into `bitNot`/`logicalNot` was already made in
// the parser (see MaxonUnaryOp), so nothing is re-derived here. Exhaustive by
// construction.
function maxonUnaryOpToStdOpcode(op MaxonUnaryOp) returns StdUnaryOpcode
	match op 'map'
		neg then return StdUnaryOpcode.neg
		bitNot then return StdUnaryOpcode.bitNot
		logicalNot then return StdUnaryOpcode.logicalNot
		// The conversion pair — still a 1:1 rename, and still no decision made here: the parser
		// chose the DIRECTION (it is the tier that knows the operand is a float), and the Std
		// opcode only renames it. `trunc` is the source builtin; `promoteToFloat` is inserted.
		trunc then return StdUnaryOpcode.fpToSi
		promoteToFloat then return StdUnaryOpcode.siToFp
		// The math intrinsics — a 1:1 rename like the rest, and the only reason they are spelled
		// separately from the conversions above is that they are NOT conversions: they stay inside
		// the float domain, so `assertConversionCrossesDomain` must not be asked about them.
		floor then return StdUnaryOpcode.floor
		ceil then return StdUnaryOpcode.ceil
		round then return StdUnaryOpcode.round
		sqrt then return StdUnaryOpcode.sqrt
		abs then return StdUnaryOpcode.abs
		fneg then return StdUnaryOpcode.fneg
		// The reinterpretation — still a 1:1 rename. It is spelled separately from BOTH bands above
		// for the reason `stdUnaryOperandIsFloat` gives it its own arm: it leaves the float domain
		// (so it is not an intrinsic) without converting (so it is not a conversion).
		floatToBits then return StdUnaryOpcode.bitcastF64ToI64
		bitsToFloat then return StdUnaryOpcode.bitcastI64ToF64
		// ⚠ The SIGN-EXTENSION family is the ONE member with no 1:1 rename — it EXPANDS to a shift pair —
		// which is why this map is written as statements rather than as a `gives` expression: the honest
		// answer for that band is a panic, and there is no opcode to hand back. `lowerUnaryOp` routes it to
		// `lowerSignExtend` before ever asking, so reaching here is a routing bug in that function.
		signExtendI8 to signExtendI32 then panic("maxonUnaryOpToStdOpcode: {op.name} has no 1:1 Std opcode — it EXPANDS to a shift pair, and `lowerUnaryOp` routes it to `lowerSignExtend` before reaching this map")
	end 'map'
end 'maxonUnaryOpToStdOpcode'

// **A UNARY OPCODE'S OPERAND DOMAIN IS PART OF THE OPCODE**, and the parser is what has to have
// arranged it. Every arm is unreachable by construction, which is exactly why the check is written:
// it is what stops "unreachable" from quietly becoming "unwritten" the day one of those gates moves.
//
//   • a CONVERSION must CROSS the domain it names — `siToFp` over a float, or `fpToSi` over an
//     integer, converts a type to ITSELF, and there is no instruction for it. `Parser.promoteToFloat`
//     returns early on a value already in the float domain, and `Parser.emitTrunc` answers
//     `trunc(int)` with the operand itself rather than an op.
//   • a MATH INTRINSIC (`floor`/`ceil`/`round`/`sqrt`/`abs`) or the sign flip `fneg` is f64 → f64, so it
//     must be handed a FLOAT — `Parser.emitMathIntrinsic` promotes an integer argument before emitting
//     the op, which is what makes `sqrt(16)` answer 4 rather than reaching an instruction that has no
//     integer form, and `Parser.parseUnary` emits `fneg` only past its `tagIsFloat` test.
//
// It reads `operandType`, which is the SOURCE and — on the conversions — never the result. That is
// the one fact StdUnaryOpcode's header exists to hammer, and the one that would send a value to the
// wrong register file if it were read backwards; `stdUnaryOperandIsFloat` is the single place it is
// written down, shared with both native isels.
function assertUnaryOperandDomain(opcode StdUnaryOpcode, operandType StdType)
	if stdTypeIsFloat(operandType) == stdUnaryOperandIsFloat(opcode) 'agrees'
		return
	end 'agrees'

	let required = "FLOAT" if stdUnaryOperandIsFloat(opcode) else "INTEGER"
	panic("lowerUnaryOp: Std unary opcode {opcode.name} reads a {required} operand and was handed Std type {operandType.name} — the parser owns this precondition (promoteToFloat/emitTrunc/emitMathIntrinsic), so a mismatch here is a front-end bug, not a lowering one")
end 'assertUnaryOperandDomain'

// Map a source-level comparison operator to its Std predicate. M4 is a 1:1 mapping;
// exhaustive by construction (every MaxonCmpOp arm is named). The x64 tier turns the
// predicate into a signed jcc condition when it fuses the compare with its branch.
function maxonCmpOpToStdPred(op MaxonCmpOp) returns StdCmpPred
	return match op 'map'
		eq gives StdCmpPred.eq
		ne gives StdCmpPred.ne
		lt gives StdCmpPred.lt
		gt gives StdCmpPred.gt
		le gives StdCmpPred.le
		ge gives StdCmpPred.ge
	end 'map'
end 'maxonCmpOpToStdPred'

// ⭐⭐ **THE INVERSE OF `maxonBinOpToStdOpcode`, AND THE REASON IT LIVES HERE RATHER THAN IN THE PASS
// THAT NEEDS IT.** `foldConstants` (Std→Std) EVALUATES `const <op> const`, and the arithmetic it must
// produce is the arithmetic THE PARSER'S OWN CONSTANT FOLDER already produces — `TypeRules.foldIntBinOp`
// and `TypeRules.evalShift`, which speak `MaxonBinOp`. Rather than give the Std tier a second evaluator
// (this project's signature bug: ONE FACT WRITTEN DOWN TWICE), a Std opcode is carried BACK to the
// operator it lowered from and the one folder is asked.
//
// ⚠ **A DIVERGENCE FAILS LOUDLY INSTEAD OF SILENTLY, AND THAT IS WHY THIS IS BESIDE THE FORWARD MAP.**
// Every answer is checked by ROUND-TRIPPING it: an editor who changes one direction and not the other
// gets a panic on the first program that folds, rather than a folded constant that disagrees with the
// instruction the other direction emits. A hand-written inverse in another file, with no such check,
// would be exactly the second copy this function exists to avoid.
export function maxonBinOpOfStdOpcode(opcode StdBinOpcode) returns MaxonBinOp
	let op = match opcode 'map'
		add gives MaxonBinOp.add
		sub gives MaxonBinOp.sub
		mul gives MaxonBinOp.mul
		bitAnd gives MaxonBinOp.bitAnd
		bitOr gives MaxonBinOp.bitOr
		bitXor gives MaxonBinOp.bitXor
		shl gives MaxonBinOp.shl
		shr gives MaxonBinOp.shr
		shrLogical gives MaxonBinOp.shrLogical
		// The three FLOAT-ONLY opcodes (`stdBinOpcodeIsFloatOnly`). They have a `MaxonBinOp` twin and it
		// is named here, because the round trip below is only a check when every arm answers: an arm that
		// panicked "float-only" would be this file deciding what a CALLER may fold, which is the caller's
		// own rule (`foldConstants` refuses a float operand type before it ever asks).
		div gives MaxonBinOp.div
		min gives MaxonBinOp.min
		max gives MaxonBinOp.max
		// ⭐ EC18's HIGH MULTIPLY HAS NO `MaxonBinOp` TWIN, and that is a property of the LANGUAGE
		// rather than an omission here: no source operator spells "bits 64..127 of a 128-bit product".
		// It is minted by `StrengthReduceDivision` at the Std tier and lowered to one instruction, so
		// nothing ever needs to carry it BACK to an operator. Unlike the float-only three above there is
		// no answer to name, so this arm panics instead of participating in the round trip — and
		// `foldConstants`, this function's one caller, refuses the opcode before asking (it could not
		// evaluate a 128-bit product into a 64-bit `ParsedInt` anyway).
		mulHighSigned panic("maxonBinOpOfStdOpcode: `mulHighSigned` is a Std-TIER-ONLY opcode — it is minted by `StrengthReduceDivision` and has no source operator to carry back to. Its one would-be caller, `foldConstants.evaluateIntBinOp`, declines it before asking; reaching here means a new caller asked without that guard.")
	end 'map'

	let roundTrip = maxonBinOpToStdOpcode(op)
	if roundTrip != opcode 'notAnInverse'
		panic("maxonBinOpOfStdOpcode: `{opcode.name}` answers `{op.name}`, which lowers back to `{roundTrip.name}` — the two directions of one correspondence have diverged")
	end 'notAnInverse'

	return op
end 'maxonBinOpOfStdOpcode'

// The comparison twin of `maxonBinOpOfStdOpcode`, checked the same way and there for the same reason:
// `TypeRules.foldIntCompare` is the compiler's ONE integer comparison folder, and it speaks `MaxonCmpOp`.
export function maxonCmpOpOfStdPred(pred StdCmpPred) returns MaxonCmpOp
	let op = match pred 'map'
		eq gives MaxonCmpOp.eq
		ne gives MaxonCmpOp.ne
		lt gives MaxonCmpOp.lt
		gt gives MaxonCmpOp.gt
		le gives MaxonCmpOp.le
		ge gives MaxonCmpOp.ge
	end 'map'

	let roundTrip = maxonCmpOpToStdPred(op)
	if roundTrip != pred 'notAnInverse'
		panic("maxonCmpOpOfStdPred: `{pred.name}` answers `{op.name}`, which lowers back to `{roundTrip.name}` — the two directions of one correspondence have diverged")
	end 'notAnInverse'

	return op
end 'maxonCmpOpOfStdPred'

// Does any declared parameter have `float` type — the ONLY thing that can force an int→float
// argument widening (see `MaxonToStdLowering.crossFloatDomainArgs`). A bounded scan (parameters
// are capped at the register-arg ABI count), so it is O(1) per call and allocates nothing; it is what
// lets the overwhelmingly common no-float call return its arguments verbatim rather than build a fresh
// array it would never change.
//
// It takes the PARAMETER TYPES and not a `FuncSignature`, because the widening now serves both call
// shapes and only ONE of them has a signature: a DIRECT call's callee is a name in `funcSignatures`,
// while an INDIRECT call's is a function VALUE whose declared type is a `FunctionShape`. Both lists are
// alias-resolved (TypeResolution re-syncs the signatures and builds the shapes), so `maxonTypeToStdType`
// cannot meet a residual `named` from either.
// Bit k set iff DECLARED parameter k is a float — the per-argument register-file mask an indirect call
// carries, read off the CALLEE's declared types and never off the argument values. Both indirect shapes come
// through here now: a function value hands it the declared `FunctionShape`'s parameters
// (`appendCallIndirect`), a witness call the requirement's declared formals (`witnessFormalTypes`), and the
// second of those used to read the actuals instead — see that function for the wasm trap it cost. The
// trailing uniform-ABI env pointer is an i64 no parameter describes, so the walk over the parameters alone
// leaves its bit clear, which is exactly right; a witness call's RECEIVER is covered the same way, by the
// `integer` its formal list is seeded with.
// ⭐ **THE CALLEE NAME AN INDIRECT CALL HAS NOT GOT** — what `crossFloatDomainArgs` is handed by a function
// value's call and by a witness dispatch. Named rather than passed as a bare empty slice, because the reader
// has to know it is a STATEMENT and not an omission: neither shape can reach a by-reference parameter, since
// a function TYPE and an interface REQUIREMENT both describe their parameters without saying how they are
// passed, and the sweep records by-reference columns per DECLARATION. `paramIsByRef` answers false for it,
// which is the right answer rather than a fallback.
//
// ⚠ **IT IS A SECOND SPELLING OF `EmptySourceText`, AND THE REASON IS A LANGUAGE RESTRICTION RATHER THAN A
// PREFERENCE — MEASURED, because the PBR-2 review tried the alias first.** `let NoNamedCallee =
// EmptySourceText` is `error E2004: Undefined constant 'EmptySourceText'` at this line: a module-level `let`
// initializer cannot name another module's constant, though a function BODY in this same file reads it
// freely (`currentFuncName: EmptySourceText`, in `create`). So the duplicate literal is forced here, and the
// two spellings are of the EMPTY SLICE — a value with no state to drift. Fold this into `EmptySourceText`
// the day a top-level initializer can name one.
let NoNamedCallee = b""

function paramFloatMask(paramTypes MaxonTypeArray) returns ArgFloatMask
	var mask = 0 as ArgFloatMask
	for k in 0 upto paramTypes.count() 'eachParam'
		let paramType = try paramTypes.get(k) otherwise panic("paramFloatMask: paramTypes.get OOB at {k}")
		if stdTypeIsFloat(maxonTypeToStdType(paramType)) 'floatParam'
			mask = mask or (1 shl k)
		end 'floatParam'
	end 'eachParam'
	return mask
end 'paramFloatMask'

// Does any parameter of `sig` have `function` type — the ONLY thing that forces a companion environment
// argument to be threaded at the call (see `MaxonToStdLowering.appendCalleeEnvArgs`). Bounded scan (the same
// shape as `signatureHasFloatParam`), so the overwhelmingly common no-function call returns its slotted
// arguments verbatim rather than building a fresh array.
function signatureHasFunctionParam(sig FuncSignature) returns bool
	for paramType in sig.paramTypes 'eachParam'
		if maxonTypeTag(paramType) == ValueTypeTag.function 'function'
			return true
		end 'function'
	end 'eachParam'
	return false
end 'signatureHasFunctionParam'

// Public entry: lower a whole MaxonModule to a fresh StdModule. Takes the whole `Project`, because the
// lowering now needs three things off it: the `funcSignatures` registry (label→positional argument
// slotting), the `.rdata` table (`globalData`, where string literals and — P1.6-B1 — layout descriptors
// register), and the whole-program `ProgramSignatures` (`queryProgramSignatures`, memoized before the
// pipeline) whose `genericInstances`/`structTypes` size and mangle a generic instance's layout descriptor.
//
// ⚠ **`project` is a P1.6-B1 addition** — the pre-B1 lowering took only `funcSignatures` + `globalData`
// and never touched the project. Dictionary-passing forced it: a `sizeof(T)` call site must materialise
// the receiver instance's descriptor, which needs the whole-program `(baseId, args)` payload that lives
// only on `ProgramSignatures`, and that is reachable only through the project.

// The set of qualified function names whose body reads `sizeof(T)` and therefore carries a hidden
// trailing layout-descriptor parameter (P1.6-B1). Built once per lowering by an op-scan; read at a call
// site to decide whether to append the descriptor argument, and per callee to bind the descriptor param.
export typealias LayoutNeedingFuncSet = Map with (ByteArray, bool)

// The set of witness-table `.rdata` labels already emitted (P1.7a slice 2a) — the blob, its method-slot
// relocations, and the DCE-rooting of each impl are recorded ONCE per `(Type, Interface)`, even though a
// concrete dispatch may reference the table at many call sites. `registerRdataConstantLabeled` is idempotent
// by label on its own, but the relocations and the root are not, so this dedup gate guards them.
//
// ⭐ **KEYED ON THE LABEL, WHICH *IS* THE PAIR** — and that is a property of the label, not an assumption
// here. `witnessTableLabel` joins with a character no name can contain, so the label and the
// `(Type, Interface)` pair are in bijection and this memo is lossless. It was NOT, when the join was `_`:
// `(A_B, C)` and `(A, B_C)` shared a key, so the second pair hit this gate, took the first pair's table and
// never recorded its own relocations — a silent wrong answer that looked exactly like a cache hit. The
// remedy is the separator and NOT a second, pair-keyed memo beside this one: two keys for one fact is the
// shape that drifts, and with an injective label there is nothing the pair knows that the label does not.
export typealias WitnessTableLabelSet = Set with String

// The set of witness-slot ABI adapters already REQUESTED (WASM3) — keyed on the adapter's symbol, which is
// the `(conformer, interface, method)` triple by construction (`witnessSlotAdapterSymbol`). One conformer's
// slot can be reached from several tables — a requirement inherited through `extends` sits in the derived
// interface's table AND in the base's — and each table stamps its own relocation, so the dedup has to be on
// the SLOT rather than on the table.
typealias WitnessAdapterNameSet = Set with ByteArray

// ⭐⭐ **WHICH TABLE A WITNESS MINT IS FOR — the conformer's ONE SHARED table, or the table of ONE CONCRETE
// INSTANCE of it (G19).**
//
// shv2 keys a generic conformer's table by its BASE name, and that reduction is what lets one compiled impl
// and one table serve every instantiation (`ProgramSignatures.conformerNameOfType`). Its premise, stated at
// that door and again on `ErrorCode.semanticSharedConformanceReadsDictionary`, is that the impls are
// INDEPENDENT of the type argument — and an impl that reads the hidden dictionary its generic declaration
// reserves is not. Such a conformance gets a table PER INSTANCE, whose slots point at adapters carrying that
// instance's OWN descriptor, element count and witnesses; every other conformance keeps the one shared table
// it always had, byte for byte, so no program that never needed a dictionary moves.
//
// ⚠ **IT IS A REQUEST, NOT A VERDICT.** A caller states which instance it holds and
// `witnessTableInstanceFor` decides — a conformance whose impls need nothing reduces back to `shared`, and so
// does an instance that is not CONCRETE (an instance over the enclosing body's own parameters has no
// descriptor to name, exactly as `emitInstanceDescriptorAddr` records one mechanism over).
//
// ⚠⚠ **THOSE TWO REDUCTIONS ARE NOT ONE FACT, AND A CALL SITE HAS TO TELL THEM APART (BATCH43).** The first
// is served correctly by the shared table; the second is served by NOTHING, and sending it here anyway is
// what made `stdlib/Interfaces.maxon`'s `extension Iterable.withIterator` refuse with E3128 for a witness
// its callee never reads. The constraint-argument door asks `constraintArgumentHasNoTable` FIRST and passes
// a proved zero instead; see `NullWitnessArgRequest`.
union WitnessTableInstance
	// No instance is in hand — the base-keyed table, and the answer for every non-generic conformer.
	shared
	// This concrete instance's own table.
	perInstance(gid GenericInstanceId)
end 'WitnessTableInstance'

// Which conformances have at least one slot impl carrying a hidden dictionary — asked once per `(conformer,
// interface)` pair and held, because the answer is a pure function of the impls' declared arities and the
// question is asked at every per-instance mint. Keyed by the pair's BASE label, which is injective
// (`witnessTableLabel`'s own header states why).
typealias DictionaryCarryingConformanceMap = Map with (String, bool)

// ⭐ **ONE DEFERRED WITNESS-SLOT ABI ADAPTER — recorded while a table is stamped, built after the function
// walk (WASM3).** A table is stamped from inside a BODY's lowering, and the body walk iterates
// `stdModule.functions`; pushing the adapter there would be appending to the array being iterated. So the
// stamp records what it needs and `installWitnessSlotAdapters` drains the list once the walk is done —
// the same "synthesize after, not during" shape `Runtime/FnRefThunk.installFnRefThunks` uses, one phase
// earlier because an adapter's own dictionary may request further tables (and hence further adapters).
type WitnessAdapterRequest
	// The conforming type, as the table label spells it — carried for the diagnostic
	// `requireWitnessSlotImplIgnoresDictionary` may raise, which has to name the conformance whose shared
	// table cannot supply a dictionary.
	export let conformerType as ByteArray
	// The impl the adapter forwards to — `witnessSlotImpl`'s answer, so the adapter calls exactly the member
	// the conformance accepted.
	export let implName as ByteArray
	// The adapter's own symbol, already stamped into the slot's relocation by the time this is drained.
	export let adapterName as ByteArray
	// How many arguments a `witnessCall` through this slot passes — the adapter's whole parameter list.
	export let slotArity as ParamCount
	// WHICH table stamped this slot, and therefore WHERE the dictionary the adapter passes comes from (G19):
	// `perInstance` names the instance whose descriptor and witnesses the adapter materializes, `shared` is
	// the null dictionary `requireWitnessSlotImplIgnoresDictionary` proves nothing reads.
	export let instance as WitnessTableInstance

	export static function create(conformerType ByteArray, implName ByteArray, adapterName ByteArray, slotArity ParamCount, instance WitnessTableInstance) returns WitnessAdapterRequest
		return Self{conformerType: conformerType, implName: implName, adapterName: adapterName, slotArity: slotArity, instance: instance}
	end 'create'

	// ⚠ **AN INDEPENDENT COPY, FOR THE DRAIN THAT CANNOT HOLD A BORROW.** `installWitnessSlotAdapters`
	// reads a queued request out of `pendingWitnessAdapters` and hands it to a call that APPENDS to that
	// very array — see the loop, which grows by design. A borrowed element may not be held across the
	// write (E3070), and the three name columns are what the copy has to be deep in: they are the request's
	// only managed fields, and the array owns the ones it holds.
	export function clone() returns WitnessAdapterRequest
		return Self{conformerType: self.conformerType.clone(), implName: self.implName.clone(), adapterName: self.adapterName.clone(), slotArity: self.slotArity, instance: self.instance}
	end 'clone'
end 'WitnessAdapterRequest'

typealias WitnessAdapterRequestArray = Array with WitnessAdapterRequest

// ⭐⭐ **ONE CALL THAT PASSED A ZERO WHERE A `where` CONSTRAINT'S WITNESS TABLE BELONGS, RECORDED WHILE THE
// BODY IS LOWERED AND PROVED SOUND AFTER THE WALK (BATCH43).**
//
// A constraint's type argument may be a generic instance written over the CALLING body's own type
// parameters — `stdlib/Interfaces.maxon`'s `extension Iterable.withIterator` builds
// `WithIterIterator with (ArrayIterator with Element, Element)` while `Element` is still opaque — and where
// that instance's conformance carries a hidden dictionary there is NO table to name: a table is `.rdata`,
// its dictionary-carrying slots point at adapters that must supply the instantiation's descriptor, and the
// descriptor is a run-time fact of the enclosing frame (`emitInstanceDescriptorAddr` records the same wall
// one dictionary column over). `witnessTableInstanceFor` reduces such a request to the SHARED table, whose
// adapters then hand the impl a null dictionary — and G19's `requireWitnessSlotImplIgnoresDictionary`
// refuses it with E3128, which is the right answer about the TABLE and the wrong place to ask it: the
// question the ARGUMENT poses is whether the callee reads this witness at all.
//
// ⇒ the call passes a ZERO and this record is the obligation to PROVE nothing reads it — the identical
// discipline `appendNullAdapterDictionary` and `requireWitnessSlotImplIgnoresDictionary` already carry one
// mechanism down, and the reason a zero here is not v1's `materializeInterfaceWitness` soft-fail (which
// emits a null witness and CONCEDES the runtime fault in a comment).
//
// ⚠ **IT IS CHECKED AFTER THE FUNCTION WALK, BECAUSE THE PROOF READS THE CALLEE'S LOWERED BODY.** The
// caller may be lowered before the callee — `stdModule.functions` is in declaration order — so the answer
// does not exist at the moment the zero is emitted. Same "record now, settle after the walk" shape as
// `WitnessAdapterRequest`, one phase later still, since an adapter's own dictionary may request tables.
type NullWitnessArgRequest
	// The function whose body passes the zero — the position a refusal is blamed at, because it is the call
	// site the author must change, and the only one of the two names that is always the user's.
	export let caller as ByteArray
	// The callee whose witness parameter receives it.
	export let callee as ByteArray
	// WHICH of the callee's witness parameters — its position in `witnessConstraintsOfMethod(callee)`, the
	// same list `appendWitnessArgs` walks, so the parameter this names is the parameter the zero landed in.
	export let constraintIndex as WitnessSlotIndex
	// The conformer and interface the missing table would have been keyed by — carried for the diagnostic,
	// which has to name the conformance whose impls make the instance untabulatable.
	export let conformerType as ByteArray
	export let interfaceName as ByteArray

	export static function create(caller ByteArray, callee ByteArray, constraintIndex WitnessSlotIndex, conformerType ByteArray, interfaceName ByteArray) returns NullWitnessArgRequest
		return Self{caller: caller, callee: callee, constraintIndex: constraintIndex, conformerType: conformerType, interfaceName: interfaceName}
	end 'create'
end 'NullWitnessArgRequest'

typealias NullWitnessArgRequestArray = Array with NullWitnessArgRequest

// An index into ONE function's `FunctionRangeChecks.sites`. Distinct from `BlockOpPos` (a position
// WITHIN a block) and from `OpIndex` (a position in the module's flat ops array) — the three are all
// integers and all three appear together in `RangeSiteWalk`.
typealias RangeSiteIndex = int(0 to u64.max)
typealias RangeSiteIndexArray = Array with RangeSiteIndex

// ⭐⭐ **HANDS EACH OF ONE FUNCTION'S RANGE-CHECK SITES THE STD `opRefs` POSITION ITS VALUE COMES TO
// REST AT (P1.9) — the translation only this pass can make.** The parser records a site's position as a
// MAXON ordinal (`RangeCheckSite.maxonOpPos`), because at the Maxon tier a narrowing cast may emit no op
// at all and an ordinal is the only anchor there is. `InsertRangeChecks` runs one pass later, at the Std
// tier, where each of those Maxon ops has become N and the ordinal means nothing. This lowering stands on
// both sides of that desugaring, and the answer costs it nothing: the Std position is the
// `dstBlock.opRefs.count()` its own walk is already standing at.
//
// ⚠ **THE GROUPING IS A COUNTING SORT, NOT A PER-BLOCK SCAN OF THE SITE LIST.** A scan is
// O(sites x blocks), which is precisely the product `Testing/ladders/genrangesites.sh`'s `onefunc` mode
// was written to catch — N sites concentrated in ONE function is the shape that turns it into a
// quadratic, and `InsertRangeChecks.guardSiteAt`'s own header records the last time this rung paid one.
// `runEnd` is counted, then accumulated into one-past-the-end of each block's run; the placement pass
// then walks the sites BACKWARDS, which both keeps each run in ascending source order (a stable sort)
// and leaves `cursor` sitting exactly at its run's START. So the two columns that sorted the sites ARE
// the walk's per-block cursor — no third column, and no copy.
type RangeSiteWalk
	// The CURRENT function's sites — the objects this walk writes `stdOpPos` onto, which IS the
	// publishing: `project.rangeChecks` holds the same array, so `InsertRangeChecks` reads what lands here.
	var sites as RangeCheckSiteArray
	// Site indices grouped by the block that records them, ascending by ordinal within a block.
	var order as RangeSiteIndexArray
	// Per block id: the next unconsumed entry of that block's run in `order`, and one past its last.
	var cursor as RangeSiteIndexArray
	var runEnd as RangeSiteIndexArray

	// ⭐ **ONE WALK PER LOWERING, REFILLED PER FUNCTION — NOT ONE PER FUNCTION.** `beginFunction` is
	// called for every function that records ANY site, which on the scale ladder is most of them (a site is
	// recorded wherever an alias is NAMED, long before `needsRuntimeGuard` discards the full-range ones), so
	// an object-plus-three-arrays per function is a per-function allocation for work the vast majority throw
	// away. The three grouping columns are SCRATCH — cleared and refilled in place, exactly as
	// `SplitScratch` and `HallScratch` are — and the ANSWER lands on the site objects themselves, so the
	// whole mechanism costs FOUR allocations for the entire lowering rather than any per function.
	export static function create() returns RangeSiteWalk
		return Self{sites: RangeCheckSiteArray.create(), order: RangeSiteIndexArray.create(), cursor: RangeSiteIndexArray.create(), runEnd: RangeSiteIndexArray.create()}
	end 'create'

	// Stand down for a function that records no site: an empty `order` is what `recordAt` returns on, so
	// the per-op cost for such a function is one `isEmpty`.
	//
	// ⚠ `sites` is LEFT POINTING AT THE PREVIOUS FUNCTION'S, deliberately: it may not be `clear()`ed,
	// because it is that function's own site list and clearing it would destroy the answer just written
	// into it. Nothing reads it while `order` is empty, and the retention is one array its own
	// `FunctionRangeChecks` owns anyway.
	export function standDown()
		self.order.clear()
	end 'standDown'

	// Group `checks`'s sites by their recording block, and RAISE ITS PRESENCE BIT — the promise that every
	// one of its sites carries a real `stdOpPos` by the time the walk ends, which holds because the block
	// walk that follows covers the whole function. `blockCount` is the function's `nextBlockId` — its
	// block ids are exactly `0 .. blockCount-1`, the same dense id space `buildBlockIdIndex` keys on.
	export function beginFunction(checks FunctionRangeChecks, blockCount BlockId)
		self.sites = checks.sites
		checks.positionsResolved = true

		self.runEnd.clear()
		self.runEnd.growFilled(blockCount, value: 0)
		for site in checks.sites 'countPerBlock'
			let seen = try self.runEnd.get(site.block) otherwise panic("RangeSiteWalk.beginFunction: a site names block id {site.block}, outside the function's id space of {blockCount}")
			try self.runEnd.set(site.block, value: seen + 1) otherwise panic("RangeSiteWalk.beginFunction: runEnd.set OOB at block {site.block}, which was just read in range")
		end 'countPerBlock'

		self.cursor.clear()
		self.cursor.reserve(blockCount)
		var total = 0 as RangeSiteIndex
		for id in 0 upto blockCount 'accumulate'
			total = total + (try self.runEnd.get(id) otherwise panic("RangeSiteWalk.beginFunction: runEnd.get OOB at block {id} despite the upto bound"))
			try self.runEnd.set(id, value: total) otherwise panic("RangeSiteWalk.beginFunction: runEnd.set OOB at block {id} despite the upto bound")
			self.cursor.push(total)
		end 'accumulate'

		self.order.clear()
		self.order.growFilled(checks.sites.count(), value: 0)
		for step in 0 upto checks.sites.count() 'placeBackwards'
			let index = checks.sites.count() - 1 - step
			let site = try checks.sites.get(index) otherwise panic("RangeSiteWalk.beginFunction: sites.get OOB at {index} despite the upto bound")
			let at = (try self.cursor.get(site.block) otherwise panic("RangeSiteWalk.beginFunction: cursor.get OOB at block {site.block}, which the counting pass already read in range")) - 1
			requireSiteOrdinalsAscend(checks.sites, order: self.order, at: at, site: site, runEnd: self.runEnd)
			try self.cursor.set(site.block, value: at) otherwise panic("RangeSiteWalk.beginFunction: cursor.set OOB at block {site.block}, which was just read in range")
			try self.order.set(at, value: index) otherwise panic("RangeSiteWalk.beginFunction: order.set OOB at {at} — the run for block {site.block} was sized by the counting pass")
		end 'placeBackwards'
	end 'beginFunction'

	// Serve every site of block `blockId` whose Maxon ordinal the walk has now reached. `stdOpPos` is
	// where the Std block stands RIGHT NOW — immediately before the ops the Maxon op at `maxonOpPos` is
	// about to lower into — which is exactly where the guard must split so that nothing between the site
	// and the panic executes.
	//
	// Called once per Maxon body op AND once past the last, so a site whose value is spent by the block's
	// TERMINATOR (a cast feeding the `if` that ends the block) is served at the end of the body rather
	// than left unserved.
	function recordAt(blockId BlockId, maxonOpPos BlockOpPos, stdOpPos BlockOpPos)
		if self.order.isEmpty() 'noSitesInThisFunction'
			return
		end 'noSitesInThisFunction'

		var next = try self.cursor.get(blockId) otherwise panic("RangeSiteWalk.recordAt: block id {blockId} is outside the function's block-id space, which `beginFunction` sized the columns to")
		let stop = try self.runEnd.get(blockId) otherwise panic("RangeSiteWalk.recordAt: runEnd has no entry for block id {blockId}, which cursor just answered for")
		while next < stop 'eachReachedSite'
			let index = try self.order.get(next) otherwise panic("RangeSiteWalk.recordAt: order.get OOB at {next}, inside block {blockId}'s own run")
			var site = try self.sites.get(index) otherwise panic("RangeSiteWalk.recordAt: order entry {index} is not a site index")
			if site.maxonOpPos > maxonOpPos 'notReachedYet'
				break
			end 'notReachedYet'

			site.stdOpPos = stdOpPos
			next = next + 1
		end 'eachReachedSite'
		try self.cursor.set(blockId, value: next) otherwise panic("RangeSiteWalk.recordAt: cursor.set OOB at block {blockId}, which was just read in range")
	end 'recordAt'
end 'RangeSiteWalk'

// The site about to be placed at `at` must not have a LATER ordinal than the one already at `at + 1`,
// when that neighbour belongs to the same run. Placement runs backwards through the site array, so the
// neighbour is the site the parser recorded NEXT in this block — and a block's ordinals are
// non-decreasing in parse order only because the parser's on-the-fly SSA never returns to a block it has
// left. `recordAt` consumes a run strictly in order, so a run that is out of order would hand an earlier
// site a LATER position: a guard emitted past the statement it exists to precede, silently, and with the
// suite still green. The premise is enforced here rather than trusted.
function requireSiteOrdinalsAscend(sites RangeCheckSiteArray, order RangeSiteIndexArray, at RangeSiteIndex, site RangeCheckSite, runEnd RangeSiteIndexArray)
	let runStop = try runEnd.get(site.block) otherwise panic("requireSiteOrdinalsAscend: runEnd.get OOB at block {site.block}, which the placement pass already read in range")
	if at + 1 >= runStop 'lastOfItsRun'
		return
	end 'lastOfItsRun'

	let nextIndex = try order.get(at + 1) otherwise panic("requireSiteOrdinalsAscend: order.get OOB at {at + 1}, inside block {site.block}'s own run")
	let next = try sites.get(nextIndex) otherwise panic("requireSiteOrdinalsAscend: order entry {nextIndex} is not a site index")
	if next.maxonOpPos < site.maxonOpPos 'outOfOrder'
		panic("requireSiteOrdinalsAscend: block {site.block} records a range-check site at Maxon op position {site.maxonOpPos} before one at {next.maxonOpPos} — a block's sites must be recorded in source order, because the guard walk consumes each block's run in order and would hand the earlier site the later position")
	end 'outOfOrder'
end 'requireSiteOrdinalsAscend'

export function lowerMaxonToStd(maxonModule MaxonModule, project Project, funcNames FunctionNameIndex) returns StdModule
	registerProgramLiteralBlobs(maxonModule, globalData: project.globalData, unreachableStdlib: project.stdlibFacts.unreachable)
	return MaxonToStdLowering.create(maxonModule, project: project, funcNames: funcNames).lower(project)
end 'lowerMaxonToStd'

// ⭐⭐ **EVERY BLOB THE PROGRAM'S OWN SOURCE NAMES IS REGISTERED BEFORE ANY THE COMPILER COMPOSES — the
// `.rdata` ordering, made a PROPERTY here rather than left to the order the lowering happens to reach
// things in.** A read-only image opens with the payloads a reader can point at in the source, and only
// then carries what the compiler added: panic messages, String records, layout descriptors, witness
// tables, float islands, jump tables.
//
// ⭐ **THAT IS THE REFERENCE'S GUARANTEE, NOT AN INVENTION.** v1's `PassPipeline.maxon` runs
// `constantArrayLiteralRdata` (:85) ahead of `lowerMaxonToStd` (:87) and `insertRangeChecks` (:115) — the
// two passes that mint its `__panic_msg_*` blobs — so in v1 every constant-array blob precedes every panic
// string by construction. `specs/codegen-internals.md` is written against that layout and pins payloads at
// offset 0 accordingly; without this, shv2 put the `panic("…")` blob of a function BODY in front of a
// module-level global's array blob, and the pin read the message instead.
//
// ⭐ **IT COSTS NO SECOND COMPUTATION, ONLY AN ORDER.** `GlobalDataTable.registerRdataConstant` dedupes by
// BYTES, so when `lowerStringLiteral` / `lowerConstArrayLiteral` reach the same literal they are handed the
// label this minted — the identical call, returning the identical answer. Nothing is built twice and no
// second blob-shaping path exists to drift.
//
// ⚠ **WHAT IT DOES COST: one additional traversal of the module's ops, and it was not foldable.** The two
// existing walks at this point in the pipeline cannot carry it — `scanRuntimeUsage` is a pure analysis
// whose whole contract is to compute a usage struct (threading a mutable `.rdata` sink through it would
// make every `record*Usage` helper a potential mutator), and `collectFnRefThunkTargets` harvests function
// names for the env-thunk ABI, which this shares nothing with but the loop shape. It sits inside
// `lowerMaxonToStd` rather than beside them so the ordering is established in the same file that would
// otherwise interleave these registrations, and so it needs no pipeline wiring of its own. Per op it is one
// union match, against a lowering that then does real work on every one of them.
//
// ⚠⚠ **THE RESIDUAL, NAMED: A SECOND PROGRAM LITERAL AHEAD OF THE PINNED ONE STILL DISPLACES IT.** A
// `print("x")` written above a pinned array literal registers first and the pin reads `"x"`. This ordering
// does not fix that and neither does v1's — it is a property of a ```RequiredRdata block being compared as
// a PREFIX FROM BYTE 0 with no label to anchor on, which is the pin's semantics rather than this walk's
// fault. The cure for it is a label-anchored read (`Testing/SpecTestRunner.compareLinkedSection`), which is
// a harness question and not this one.
function registerProgramLiteralBlobs(maxonModule MaxonModule, globalData GlobalDataTable, unreachableStdlib FunctionNameSet)
	for func in maxonModule.functions 'eachFunc'
		// ⭐⭐ **THE THIRD PRE-ELIMINATION DOOR ONTO `nextStringId`, AND IT WAS OPEN (W69).** The two this
		// walk's siblings shut — the body lowering below and `insertRangeChecks` — both skip a stdlib
		// function no path from `main` reaches, and both say why in the same words: DFE prunes FUNCTIONS,
		// never `.rdata`, so a blob registered for a body the back end never receives SURVIVES it, and one
		// shared counter means a surviving blob renumbers every later `__str_blob_`/`__fconst_`/
		// `__jumptable_` label in EVERY program. This walk runs EARLIER THAN EITHER and had no such test, so
		// it registered the blob those two exist to prevent.
		//
		// ⚠ **MEASURED at `stdlib/Json.maxon`'s entry, which is the first listed module to reach it.** A
		// STRING field default is not a `FieldDefault.literal` (that payload is a `ParsedInt`), so
		// `export var stringValue as String = ""` mints the nullary helper `__fieldDefault#JsonNode#stringValue`
		// whose whole body is `return ""` — an ordinary function, in the merged module, that nothing in a
		// `return 7` program can reach. Its 8-byte blob was registered here at id 0 and referenced by
		// nothing: `function main() returns ExitCode / return 7` grew a `.rdata` SECTION it had never had
		// (5,567 ⇒ 6,115 bytes on disk, codeBytes unmoved at 1,592) and **13 committed goldens shifted by
		// exactly one label**.
		//
		// ⛔ **NO COMMITTED CASE WENT RED OVER ANY OF THAT, AND THIS COMMENT CREDITED ONE THAT HAD NOT (W69
		// review).** `stdlib-whitelist.a-listed-modules-literals-are-byte-neutral` sees a displaced payload only
		// through its golden FRAGMENT, and a fragment mismatch is REFERENCE, NOT A GATE — it prints a `note:`
		// and leaves the exit code at 0. MEASURED by neutralising this very gate and rebuilding: that case
		// reported PASS with an orphan blob at `.rdata` byte 0 of every program in the suite. The gate below is
		// held by `stdlib-whitelist.a-listed-modules-literals-cannot-reach-the-rdata-image` instead, whose
		// ```RequiredRdata block pins the LINKED image from byte 0 and fails at byte 6 without this `continue`.
		//
		// ⇒ the gate is the SAME reachability fact stated the same way, never "is this whitelisted", so it
		// outlives the filter. A REACHABLE stdlib function is not in the set and registers exactly as
		// before, and no user function is ever in it — the ordering property this walk exists to establish
		// is untouched for every literal a program can actually name.
		if unreachableStdlib.contains(func.name) 'notInTheProgram'
			continue
		end 'notInTheProgram'

		for blockRef in func.blockRefs 'eachBlock'
			let block = try maxonModule.blocks.get(blockRef) otherwise panic("registerProgramLiteralBlobs: blockRef from func.blockRefs not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				let op = try maxonModule.ops.get(opIdx) otherwise panic("registerProgramLiteralBlobs: opIdx {opIdx} not in module.ops")
				registerIfProgramLiteral(op, globalData: globalData)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
end 'registerProgramLiteralBlobs'

// The two ops that carry a blob the SOURCE wrote. It RANGES over the whole `MaxonOp` union so a
// newly-appended op FAILS TO COMPILE here rather than being silently left out of the ordering — the
// band-append invariant `FnRefThunk.noteIfFunctionRef` states, and the same reason: an op added later that
// carries a program literal must be a decision, not an omission.
//
// Both arms call the very function the lowering calls (`registerStringBlob`, `registerByteArrayLiteralBlob`),
// so the bytes this registers and the bytes the lowering asks for are one shaping, not two.
function registerIfProgramLiteral(op MaxonOp, globalData GlobalDataTable)
	match op 'op'
		call to storeIndirect then break 'op'
		stringLiteral(_, bytes) then _ = registerStringBlob(globalData, bytes: bytes)
		tryCall to sizeofType then break 'op'
		constArrayLiteral(_, _, _, bytes) then _ = registerByteArrayLiteralBlob(globalData, bytes: bytes)
		switch to panicAbortValue then break 'op'
		// The error-flag encode carries no program LITERAL — the only constant it needs is the bias, which the
		// lowering mints for itself rather than reading out of the op.
		errorFlagEncode then break 'op'
		// No service op carries a program literal: a `spawn`'s bytes are a TYPE NAME the lowering turns into
		// two symbols, and a send's and a reply cell's are callee names no `.rdata` blob holds.
		serviceSpawn to serviceReplyCell then break 'op'
	end 'op'
end 'registerIfProgramLiteral'

// The label guard shared by `lowerRuntimeCall` (a plain `call`) and the compiler-internal arm of
// `lowerTryCall` (a throwing `tryCall`): a runtime entry point is declared by nothing, so there is no
// signature to slot a label against — a label would silently fill the position it was WRITTEN in, a wrong
// answer with no diagnostic anywhere. `Parser.emitRuntimeCall` builds an all-empty label column, so a
// label here means someone taught the parser to write one. It panics at the one place that could still
// see it. ONE home so the non-throwing and throwing runtime-call paths cannot drift on this rule.
function requireRuntimeCallPositional(callee ByteArray, argLabels ByteArrayArray)
	for label in argLabels 'eachLabel'
		if not label.isEmpty() 'labelled'
			panic("requireRuntimeCallPositional: the runtime call to '{String.from(callee)}' carries the argument label '{String.from(label)}' — a runtime entry point is declared by nothing, so there is no signature to slot a label against and the argument would silently fill the position it was WRITTEN in. Runtime calls are positional: see Parser.emitRuntimeCall")
		end 'labelled'
	end 'eachLabel'
end 'requireRuntimeCallPositional'

// ⭐⭐ **WHICH DIVISION IS BEING EXPANDED, AND — WHERE THERE IS ONE — THE ERROR-FLAG REGISTER IT WRITES.**
// The flag is the ONE thing that differs between the fallible divisions (A1) and the total remainder
// (A1x), which is why `lowerDivisionExpansion` is one function and not two near-copies of a four-op guard.
//
// ⭐ **THE FLAG RIDES THE VARIANT SO A MISMATCH IS UNREPRESENTABLE, NOT MERELY CHECKED.** The register is
// minted by `lowerTryCall` from the `tryCall`'s second result and a total division has no such register,
// so "which division" and "does it write a flag" would otherwise be two copies of one fact travelling as
// two parameters — and this file's first draft did exactly that, with a `panic` holding them together.
// **DERIVE > CHECK:** there is nothing left to check, because `guardedRemainder` cannot be spelled WITH a
// flag and neither checked arm can be spelled without one. `divisionExpansionKind` reads the kind back
// out, so everything downstream still asks `CheckedDivisionKind` and no second classification exists.
//
// ⚠ It is deliberately NOT a nullable ValueId or a reserved id: an unread flag register spelled `0` is a
// real ValueId (parameter 0's), so a sentinel here would be a wrong answer waiting for a reader.
union DivisionExpansion
	// `__checked_div`: the divisor's zero test IS the flag (see `emitDivisorZeroFlag`), and the divide runs
	// on an OR'd divisor so it never sees the zero it reported. Integer or float.
	checkedQuotient(errorFlag ValueId)
	// `__checked_mod`: the same, plus A1x's overflow guard — a divisor the compiler could not prove
	// non-zero is one it could not prove is not `-1` either.
	checkedRemainder(errorFlag ValueId)
	// `__guarded_mod` (A1x): the divisor is PROVEN non-zero, so there is no flag to write and no divisor to
	// repair — only the overflow guard, which answers `0` and raises nothing.
	guardedRemainder
end 'DivisionExpansion'

// The expansion → its KIND, so the operator choice, the remainder test and the float refusal all keep
// reading the one classification `divisionKindOf` produces from a callee name. A 1:1 rename, and the only
// reason it exists is that the flag had to ride the variant (see above).
function divisionExpansionKind(expansion DivisionExpansion) returns CheckedDivisionKind
	return match expansion 'e'
		checkedQuotient gives CheckedDivisionKind.quotient
		checkedRemainder gives CheckedDivisionKind.remainder
		guardedRemainder gives CheckedDivisionKind.guardedRemainder
	end 'e'
end 'divisionExpansionKind'

type MaxonToStdLowering
	var maxonModule as MaxonModule
	var stdModule as StdModule
	// Whole-program parameter signatures (names + types), for `lowerCall`'s
	// label→positional argument slotting.
	var funcSignatures as FuncSignatureMap
	// What `declaredFunctionShapeOf` answers "what type was this function VALUE declared with?" from — the
	// question `indirectCalleeParamTypes` asks per indirect call, and the same one SemanticCheck asked of the
	// same call before it. Held as the ONE carrier the check holds (`FunctionTypeRegistry`) rather than as
	// its four halves, so the two sites cannot come to hold different ones. Copied out of `Project` at
	// `create` like every other registry here, so the lowering still holds no `Project`.
	var functionTypes as FunctionTypeRegistry
	// The whole-program signature index (`queryProgramSignatures`) — P1.6-B1's source for a generic
	// instance's `(baseId, args)` payload: `ensureLayoutDescriptor` sizes and mangles a descriptor
	// through `genericInstanceBoxSize` / `genericInstanceSoleArgLogicalSize` / `mangleGenericInstance`.
	var signatures as ProgramSignatures
	// PBR-2: the current function's by-reference parameter mask and parameter count — see `stdTypeOf`. Both
	// are re-pointed per function beside `valueTags`, and both are 0 for a function with no by-reference
	// parameter, which is every function in a program that reassigns none.
	var currentByRefParams as ParamPositionMask
	var currentParamCount as ParamCount
	// The Maxon module's CHECKED name index (`FunctionNameIndex`, A2l), built once for the whole pipeline
	// and threaded in. `buildLayoutNeedingFuncs` derives its FILTERED set by walking `funcNames.functions`,
	// so that set's key space is provably the duplicate-free one rather than whatever the module happened to
	// hold — the same argument `SemanticCheck`'s throws map and escape summary now stand on.
	let funcNames as FunctionNameIndex
	// The qualified names of functions that carry a hidden layout-descriptor parameter (P1.6-B1) — built
	// once by `buildLayoutNeedingFuncs` (a PARAMETER-COUNT scan, never an op-scan: see its header for the
	// transitive reservations an op-scan would miss), then read at every call site (append the descriptor
	// argument?) and per callee (bind the descriptor param?).
	var layoutNeedingFuncs as LayoutNeedingFuncSet
	// `GenericInstanceId` ⇒ the `.rdata` label of its emitted descriptor blob (P1.6-B1). Filled lazily by
	// `ensureLayoutDescriptor` — one blob per instance actually used as a `sizeof(T)` receiver — so a
	// program pays for exactly the descriptors it references.
	var layoutDescriptors as LayoutDescriptorRegistry
	// The whole-program user interface registry (P1.7a slice 2a), from `project.interfaces` — resolved (with
	// the synthesized builtins) to read an interface's method LIST when building a witness table blob (one slot
	// per method, in decl order). Fully merged by lowering time, so a cross-file interface resolves here.
	var interfaces as IrInterfaceMap
	// Every `implements` clause in the program, from `project.conformances` — fully merged by lowering time,
	// which is what lets an associated formal resolve to the type its CONFORMERS bind (see `witnessFormalType`).
	// It is the same store `ConformanceCheck` refuses an ABI disagreement from, so the check and the emission
	// cannot come to describe one argument differently.
	var conformances as ConformanceDeclArray
	// The transitive witness-slot list of each interface a dispatch in this module goes through, built on
	// first use — see `witnessSlotsOf` for why it is memoized rather than re-walked per dispatch op.
	var witnessSlotMemo as WitnessSlotListMemo
	// The witness tables already emitted (P1.7a slice 2a) — the dedup gate for the blob's relocations + root.
	var emittedWitnessTables as WitnessTableLabelSet
	// The witness-slot ABI adapters already requested (WASM3) — see `WitnessAdapterNameSet`.
	var emittedWitnessAdapters as WitnessAdapterNameSet
	// The adapters whose bodies are still to be built — see `WitnessAdapterRequest`. Drained ONCE, after the
	// function walk, by `installWitnessSlotAdapters`.
	var pendingWitnessAdapters as WitnessAdapterRequestArray
	// The calls that passed a ZERO for a `where` constraint whose type argument is a PARAMETRIC instance —
	// see `NullWitnessArgRequest`. Drained ONCE, after the function walk, by `installParametricWitnessChecks`.
	var pendingNullWitnessArgs as NullWitnessArgRequestArray
	// Which conformances hold a dictionary-carrying impl — see `DictionaryCarryingConformanceMap`.
	var dictionaryCarryingConformances as DictionaryCarryingConformanceMap
	// Which member `checkConformance` accepted for each witness slot (R10), from `project.witnessSlotImpls` —
	// what `ensureWitnessTable` stamps a slot's relocation FROM, instead of re-deriving the impl symbol by a
	// second un-suffixed join of the same two names. See `witnessSlotImpl`.
	var witnessSlotImpls as WitnessSlotImplMap
	// The backend's `.rdata` table — where `stringLiteral` registers its immortal 56-byte record and
	// its NUL-terminated byte blob (P1.2 wave A). It is the SAME table the backend later resolves the
	// emitted `rdataAddr` label against, and the one that carries the buffer fixups to the PE writer.
	// Threaded here rather than a field on some later pass because this is the FIRST tier that turns a
	// source literal into rdata bytes.
	var globalData as GlobalDataTable
	// ⭐ THE TYPE ORACLE FOR THE FUNCTION CURRENTLY BEING LOWERED — the parser's per-value
	// `ValueTypeTag` column, published on `IrFunction.valueTags` and re-pointed at each function
	// by `lower`. It is what fills the Std arith band's `operandType`.
	//
	// Reading it is ASKING THE ONE ORACLE, not building a second one. The parser decided every
	// value's source-level type (it must — a bool `and` is control flow), and it publishes the
	// column precisely so a later pass need not re-derive one. The alternative — recovering an
	// operand's type by walking back to its defining op — is a SECOND TYPE SYSTEM in the tier
	// furthest from the source, which is the exact thing `operandType` was added to prevent (see
	// StdDialect's `binOp` header).
	//
	// It is a per-function BINDING rather than a parameter threaded through `lowerOp`, because
	// every op in a function shares one column and the walk is already per-function.
	var valueTags as ValueTypeTagArray
	// The per-value closure-environment column of the function CURRENTLY being lowered (P1.5-A2b-2) —
	// re-pointed per function like `valueTags`, from the SAME `IrFunction.valueClosureEnv` the parser
	// published. `appendCalleeEnvArgs` reads it to thread a function-value ARGUMENT's environment to a callee.
	var valueClosureEnv as ValueIdArray
	// The per-value WITNESS-PAIRING column of the function CURRENTLY being lowered
	// (P1.7a-existentials slice 1) — re-pointed per function like `valueTags`, from the SAME
	// `IrFunction.valueWitnessIds` the parser published. `witnessForExistentialValue` reads it to FORWARD an
	// already-existential value's witness half rather than re-resolving a table that does not exist, and
	// `lowerCall` reads it for the WITNESS an interface-returning call defines (the parser reserved that id;
	// this tier is where `StdOp.tryCall` finally defines it).
	var valueWitnessIds as ValueIdArray
	// The per-value NAME column of the function CURRENTLY being lowered — re-pointed per function like
	// `valueTags`, from `IrFunction.valueNameIds`. For a `genericInstance`-tagged receiver at a `sizeof(T)`
	// call site it carries the `GenericInstanceId`, which `materializeLayoutArg` resolves to a descriptor.
	var valueNameIds as TypeNameIdArray
	// ⭐ Whether this build carries the DebugStream producer (`--debugstream`). Read at exactly ONE seam
	// here — the `__mm_alloc` arm below, which appends the allocation's TRACE TAG. This is the only tier
	// that can supply it: the parser writes the call before a type name is interned whole-program, and no
	// later tier can recover the box's type from a pointer.
	let debugStream as bool
	// ⭐ The mm-trace tag of each compiler-minted box that is not any declared type's, keyed by the
	// `__mm_alloc` call's own op index (`project.allocTagSites`). Read by `allocTagIndexOf` and by nothing
	// else — see `Project.allocTagSites` for why a trace label may not ride in the type slot.
	let allocTagSites as AllocTagSiteMap
	// ⭐ The compile-time NAME each `__ds_name_id` marker call interns, keyed by that call's own op index
	// (`project.debugStreamNameSites`). Read by `lowerDebugStreamNameId` and by nothing else. This is the
	// first tier that can NUMBER them: the interner is whole-program and this walk is the one pass that sees
	// the whole merged module — see `Project.debugStreamNameSites`.
	let debugStreamNameSites as DebugStreamNameSiteMap
	// ⭐⭐ **WHERE THIS TIER WRITES DOWN WHAT IT KNOWS ABOUT AN ELEMENT STRIDE (EC15)** — the container stamp
	// of every runtime call whose first argument is a CONCRETE `Array with T`, keyed by the Std op index the
	// call is about to occupy (`project.stdOpElementStrides`). Written by `recordStaticElementStride` and read
	// only by `inlineManagedPrimitives`, which since EC17 is the very next pass but one — `insertRangeChecks`
	// is the only thing in between, and it appends ops rather than renumbering them.
	//
	// ⚠ It is a `let` like its two neighbours and is nonetheless WRITTEN through: a `Map` is a heap object, so
	// the word governs the binding and not the table. The neighbours are read-only because the parser filled
	// them; this one is filled here.
	let stdOpElementStrides as StdOpElementStrideMap
	// The whole-program Maxon op index of the op being lowered. Published by the block walk, exactly as
	// `rangeSites` is and for the same reason: an op's SIDE TABLES are keyed by its index, and the walk is
	// the only thing that knows it.
	var currentMaxonOpIndex as OpIndex
	// The per-value EXISTENTIAL-INSTANCE column of the function CURRENTLY being lowered — re-pointed per
	// function like `valueTags`, from `IrFunction.valueExistentialInstances`. `witnessFormalType` reads the
	// RECEIVER's entry to resolve an associated formal at the SITE that declared it (W59).
	var currentExistentialInstances as ValueExistentialInstanceMap
	// ⭐ The whole-program type-name interner (`project.typeNames`), which `valueNameIds` indexes into and
	// into which `mergeArtifact` remapped every id on a merged signature or op type — copied out at `create`
	// like every other registry here, because this pass holds no `Project`. Two questions need it, and this
	// tier can answer neither from Std types alone: it turns an `interfaceRef`'s id back into the interface
	// NAME a witness label is built from (`interfaceNameOfType`), and an argument's recorded name id back
	// into the declaration `signatures` is keyed by (by here a float-backed enum and an `int` are both `i64`
	// — `argIsFloatBackedEnum`).
	// ⚠ It was DECLARED TWICE, once per question, with the second declaration silently taking the field: one
	// fact written down twice, in the field list of the pass whose header says not to.
	var typeNames as TypeNameInterner
	// The name of the function CURRENTLY being lowered — re-pointed per function, for the diagnostics the
	// dictionary-passing invariant checks raise (`bindImplicitLayoutParam` / `forwardCallerLayout`).
	var currentFuncName as ByteArray
	// The ValueId of the CURRENT function's hidden layout-descriptor parameter (P1.6-B1), or an unused 0
	// when it carries none — `hasImplicitLayout` is the authoritative "does it carry one?" bit, because a
	// zero-user-parameter generic method's descriptor slot is legitimately ValueId 0 (no sentinel).
	var implicitLayoutValueId as ValueId
	// Does the CURRENT function carry a layout-descriptor parameter? The non-sentinel gate on
	// `implicitLayoutValueId` — read by `sizeof(T)` lowering and `forwardCallerLayout`.
	var hasImplicitLayout as bool
	// The ValueId of the CURRENT function's hidden fixed-element-count parameter (W190) — the slot between
	// the layout descriptor and the constraint witnesses. Read only to FORWARD it, by
	// `emitFixedElementCountOf`: `countof(Self)` itself needs nothing here, because the parser resolved its
	// own reservation and the expression simply IS this parameter.
	var implicitCountValueId as ValueId
	// Does the CURRENT function carry that parameter? The non-sentinel gate on the id above — ValueId 0 is a
	// legitimate slot for a nullary method, exactly as it is for the descriptor.
	var hasImplicitFixedElementCount as bool
	// The number of hidden WITNESS parameters the CURRENT function carries (P1.7a slice 2a) — one per `where`
	// constraint of its enclosing type, for an instance method of a constrained generic type (0 otherwise).
	// The witness parameters occupy the FINAL `currentWitnessCount` ValueIds, so witness slot `i` is
	// `witnessParamBase + i`. `bindImplicitParams` sets both from the type's constraint count.
	var currentWitnessCount as ParamCount
	// The ValueId of the CURRENT function's FIRST witness parameter (P1.7a slice 2a) — `paramCount -
	// currentWitnessCount`. Read by `lowerWitnessDispatch` to forward the caller's own witness slot to a
	// dispatch. Meaningless (and unread) when `currentWitnessCount` is 0.
	var witnessParamBase as ValueId
	// The `throws` clause of the function CURRENTLY being lowered (P1.4b) — re-pointed per function like
	// `valueTags`. `emitRetOrErrorReturn` reads it to decide whether a normal `ret`/`retVoid` becomes the
	// dual-register `errorReturn` (a THROWING function writes both the value AND a zero error flag).
	var currentThrows as ThrowsClause
	// The Std RETURN TYPE of the function CURRENTLY being lowered (F3b) — re-pointed per function like
	// `currentThrows`, from the SAME `IrFunction.returnType` the backend reads. A throwing function's
	// throw-edge primary value is a family-default the caller ignores, so only its REGISTER FILE matters;
	// `emitZeroConstOfReturnType` reads this to class that default as the return type's file (an XMM zero
	// for a float return, else a GPR zero) — the identical field `emitReturnValueMove` keys the return
	// register off, so the throw-edge default and the return register cannot come to disagree.
	var currentReturnType as StdReturnType
	// The MAXON return type of the function CURRENTLY being lowered (P1.7a slice 2, the return ABI) —
	// re-pointed per function like `currentThrows`. It is carried BESIDE the collapsed `currentReturnType`
	// and not instead of it, because the two answer different questions and only one of them survives the
	// collapse: `StdReturnType` is `void | value(StdType)`, and an interface collapses to a bare `i64` there
	// (`valueTagToStdType`), so by the Std tier "does this function hand back a fat pointer?" is no longer a
	// question its own return type can answer. `emitRetOrErrorReturn` asks it through
	// `functionUsesSecondaryReturnSlot`, and reads the interface NAME out of it to materialize the witness.
	var currentMaxonReturnType as MaxonReturnType
	// The stdlib functions no path from `main` reaches (`StdlibFacts.unreachable`) — the ONE fact `lower`
	// skips a body on, and the SAME derivation `insertRangeChecks`, `checkCalls` and `scanRuntimeUsage`
	// read. Copied out of `Project` at `create` like every other registry here (this pass holds no
	// `Project`), and named for the FACT rather than for its use, exactly as `scanRuntimeUsage`'s
	// `unreachableStdlib` parameter is.
	var unreachableStdlib as FunctionNameSet
	// The whole-program range-check plan (P1.9), from `project.rangeChecks` — the SAME table
	// `InsertRangeChecks` reads its sites from one pass later, held here so this pass can answer the one
	// question that table cannot ask for itself: which STD op position each site's Maxon ordinal became.
	// See `RangeSiteWalk`.
	var rangeChecks as RangeCheckPlanMap
	// The site walk of the function CURRENTLY being lowered — re-pointed per function like `valueTags`,
	// but REFILLED rather than rebuilt — one walk serves the whole lowering (`RangeSiteWalk.create`).
	var rangeSites as RangeSiteWalk
	// The next fresh ValueId for the CURRENT function — a plain counter (no per-function object) seeded at
	// the parser's dense id count, i.e. the next free id. The ops this pass synthesizes (the flag re-encode
	// of a throw, the zero flag of a normal throwing return) mint
	// from here so their ids collide with none the parser minted; the Std passes downstream grow their dense
	// columns to fit the highest id, so a monotonic counter is all that is required.
	var nextValueId as ValueId

	static function create(maxonModule MaxonModule, project Project, funcNames FunctionNameIndex) returns MaxonToStdLowering
		// `queryProgramSignatures` is memoized and was computed by `compileToCodeResult` before the
		// pipeline runs, so this is an O(1) cache hit; a fresh FAILURE here is impossible (a signature
		// error would already have thrown before lowering was scheduled).
		let signatures = try queryProgramSignatures(project) otherwise panic("MaxonToStdLowering.create: queryProgramSignatures failed inside the lowering pass — it is computed and memoized by compileToCodeResult before the pipeline runs, so it cannot fail fresh here")
		return Self{maxonModule: maxonModule, stdModule: StdModule.create(), funcSignatures: project.funcSignatures, functionTypes: functionTypeRegistryOf(project), signatures: signatures, funcNames: funcNames, layoutNeedingFuncs: LayoutNeedingFuncSet.create(), layoutDescriptors: LayoutDescriptorRegistry.create(), interfaces: project.interfaces, conformances: project.conformances, witnessSlotMemo: WitnessSlotListMemo.create(), emittedWitnessTables: WitnessTableLabelSet.create(), emittedWitnessAdapters: WitnessAdapterNameSet.create(), pendingWitnessAdapters: WitnessAdapterRequestArray.create(), pendingNullWitnessArgs: NullWitnessArgRequestArray.create(), dictionaryCarryingConformances: DictionaryCarryingConformanceMap.create(), witnessSlotImpls: project.witnessSlotImpls, globalData: project.globalData, debugStream: project.debugStream, allocTagSites: project.allocTagSites, debugStreamNameSites: project.debugStreamNameSites, stdOpElementStrides: project.stdOpElementStrides, currentMaxonOpIndex: 0, valueTags: ValueTypeTagArray.create(), currentByRefParams: 0, currentParamCount: 0, valueClosureEnv: ValueIdArray.create(), valueWitnessIds: ValueIdArray.create(), currentExistentialInstances: sharedEmptyExistentialInstanceMap, typeNames: project.typeNames, valueNameIds: TypeNameIdArray.create(), currentFuncName: EmptySourceText, implicitLayoutValueId: 0, hasImplicitLayout: false, implicitCountValueId: 0, hasImplicitFixedElementCount: false, currentWitnessCount: 0, witnessParamBase: 0, currentThrows: ThrowsClause.none, currentReturnType: StdReturnType.void, currentMaxonReturnType: MaxonReturnType.void, unreachableStdlib: project.stdlibFacts.unreachable, rangeChecks: project.rangeChecks, rangeSites: RangeSiteWalk.create(), nextValueId: 0}
	end 'create'

	// The Maxon type TAG a value carries, from the column `lower` pointed at the CURRENT function. The one
	// read+panic for "this value has a recorded tag" — every SSA value is minted through `Parser.mintValue`
	// and the column is dense over every ValueId, so a miss is a lowering bug (a value never minted, or
	// `lower` failing to re-point `valueTags` at the function being walked).
	function valueTagOf(value ValueId) returns ValueTypeTag
		return try self.valueTags.get(value) otherwise panic("valueTagOf: value v{value} has no recorded type — every SSA value must be minted through Parser.mintValue, and `lower` must point `valueTags` at the function being walked")
	end 'valueTagOf'

	// The Std type a VALUE computes in — the truth the arith band's `operandType` carries, and a
	// single indexed read of the column `lower` pointed at this function.
	//
	// ⭐⭐ **EXCEPT FOR A BY-REFERENCE PARAMETER, WHICH IS AN ADDRESS AND SO IS ALWAYS THE MACHINE WORD
	// (PBR-2).** Its DECLARED type is the type of what the cell holds, and every tier above this one wants
	// that type — the argument check judges a forwarded `cur` against `Node`, the accessor gate sees a
	// `named` value, the field base finds a layout. Only the machine representation differs, and this is the
	// one place that answers for it: `valueTags` keeps the declared type and the REPRESENTATION is decided
	// here, where the ABI already lives (`func.reassignedParamMask`, the same mask that types the callee's
	// parameter slot in `transferFuncs`).
	//
	// ⚠ **THE FLOAT CASE IS WHY THIS CANNOT BE LEFT TO THE TAG.** A by-reference `float(f64.min to f64.max)`
	// parameter would compute in `f64`, so the register allocator colors the CELL'S ADDRESS into an XMM
	// register while the callee's parameter slot is a GP one — MEASURED as
	// `a register-to-register move from xmm0 to rcx crosses register files` out of the x64 emitter.
	function stdTypeOf(value ValueId) returns StdType
		if self.valueIsByRefParam(value) 'anAddressRatherThanAValue'
			return StdType.i64
		end 'anAddressRatherThanAValue'

		return valueTagToStdType(self.valueTagOf(value))
	end 'stdTypeOf'

	// Is `value` one of the CURRENT function's by-reference parameters? Parameter `i` owns ValueId `i` (the
	// parser's dense numbering), which is what makes this two scalar reads rather than a lookup.
	function valueIsByRefParam(value ValueId) returns bool
		return value < self.currentParamCount and maskHasParam(self.currentByRefParams, param: value)
	end 'valueIsByRefParam'

	function lower(project Project) returns StdModule
		// Which functions carry a hidden layout-descriptor parameter (P1.6-B1) — computed ONCE, up front,
		// so both directions of the ABI (a callee binding its slot, a caller appending the argument) read
		// one whole-program answer. An op-scan over the Maxon module; O(total ops), linear.
		self.buildLayoutNeedingFuncs()

		// Relocate blocks 1:1 first so blockRef indices stay aligned between the
		// source MaxonModule and the dest StdModule; each dest block starts empty
		// and its ops are appended during the per-function walk below. The
		// per-block source footprint is copied in lock-step so it survives to the
		// coverage-instrumentation pass (a later-milestone consumer).
		for i in 0 upto self.maxonModule.blocks.count() 'relocateBlocks'
			let srcBlock = try self.maxonModule.blocks.get(i) otherwise panic("lowerMaxonToStd: maxonModule.blocks.get OOB at {i}")
			// Fresh block: opRefs/terminator are rebuilt by the per-function walk below.
			// The phi model the parser attached (block-args + the per-edge branchEdges
			// carrying each phi's incoming values) is SHARED with the Maxon block, not
			// copied: the ValueIds it names pass through this lowering verbatim, so the
			// two tiers want the identical data. Sharing is safe because no Std pass
			// mutates it in place — `pruneDeadBlockArgs` rebuilds both lists and
			// field-assigns them onto the Std block, leaving the Maxon block's own
			// arrays untouched. See IrBlock's header for the ownership rules.
			var dstBlock = IrBlock.create(srcBlock.id, label: srcBlock.label)
			dstBlock.blockArgs = srcBlock.blockArgs
			dstBlock.branchEdges = srcBlock.branchEdges
			self.stdModule.blocks.push(dstBlock)
			let srcInfo = try self.maxonModule.blockSourceInfo.get(i) otherwise BlockSourceInfo.empty()
			self.stdModule.blockSourceInfo.push(srcInfo)
		end 'relocateBlocks'

		// Transfer each function, collapsing its Maxon-phase types (return type +
		// param types) to the Std-phase types. blockRefs stay valid because block
		// indices were kept 1:1 above.
		for i in 0 upto self.maxonModule.functions.count() 'transferFuncs'
			var func = try self.maxonModule.functions.get(i) otherwise panic("lowerMaxonToStd: maxonModule.functions.get OOB at {i}")
			var stdParams = StdTypeArray.create()
			for k in 0 upto func.maxonParamTypes.count() 'eachParam'
				// ⭐⭐ **A BY-REFERENCE PARAMETER CARRIES AN ADDRESS, WHATEVER ITS DECLARED TYPE SAYS (PBR-2).**
				// The declared type is the type of the VALUE the cell holds; the parameter itself is the cell's
				// address, which is the machine word. Nothing in `maxonParamTypes` can say so — a
				// `float(f64.min to f64.max)` parameter is spelled exactly the same whether it arrives by value
				// or by reference — so the mask the parser stamped is the only thing that can.
				//
				// ⚠ **THIS IS THE ONE PLACE THE DISTINCTION IS NOT COSMETIC.** `maxonTypeToStdType` would answer
				// `f64` and put the cell's ADDRESS in an XMM register, where the callee's `loadIndirect` expects a
				// GP one — a pointer reinterpreted as a double at the ABI boundary, on every target.
				// `pass-by-reference.mutate-float-ref` is the case that pins it.
				let paramType = try func.maxonParamTypes.get(k) otherwise panic("lowerMaxonToStd: maxonParamTypes.get OOB at {k} inside its own count()")
				stdParams.push(StdType.i64 if maskHasParam(func.reassignedParamMask, param: k) else maxonTypeToStdType(paramType))
			end 'eachParam'
			// The uniform ABI's companion environment parameters (P1.5-A2b-2) sit PAST the user parameters:
			// `paramCount` counts them, `maxonParamTypes` does not (each is an i64 pointer with no source type).
			// Grow the Std parameter list to `paramCount` so `emitParams` materializes every incoming register and
			// the wasm functype covers every slot.
			for _ in func.maxonParamTypes.count() upto func.paramCount 'envParam'
				stdParams.push(StdType.i64)
			end 'envParam'
			func.returnType = maxonReturnTypeToStdReturnType(func.maxonReturnType)
			func.paramTypes = stdParams
			self.stdModule.functions.push(func)
		end 'transferFuncs'

		// Walk each function's blocks and lower their body ops + terminator. Value
		// ids need no per-function reset — the parser already numbered them densely
		// per function, and this pass passes them through untouched.
		// An INDEX loop, not `for … in`: the element is a BORROW of `stdModule`, and the call below is
		// recorded as writing that same storage. ⚖ Ruling of 2026-08-26 — canonical note at
		// `IR/Std/ElimTrivialBlockArgs.elimTrivialBlockArgs`.
		for fnIndex in 0 upto self.stdModule.functions.count() 'eachFunc'
			let srcFunc = try self.stdModule.functions.get(fnIndex) otherwise panic("lowerFunctionBodies: fnIndex {fnIndex} is below self.stdModule.functions.count()")
			// ⭐⭐ **A STDLIB FUNCTION NO PATH FROM `main` REACHES HAS NO BODY LOWERED, AND THE REASON IS THE
			// WHITELIST'S BYTE-NEUTRALITY INVARIANT** (`StdlibLoader`: "adding a module changes NOTHING for a
			// program that does not use it"). This pass is PRE-ELIMINATION, and lowering a body REGISTERS
			// `.rdata`: `lowerStringLiteral` mints a blob + a record, `lowerConstArrayLiteral` mints a blob,
			// and `ensureWitnessTable`/`ensureLayoutDescriptor` mint a labelled payload. Dead-function
			// elimination prunes FUNCTIONS, never `.rdata`, so every one of those SURVIVES its own function —
			// and `GlobalDataTable.nextStringId` is ONE counter shared by every rdata prefix, so a surviving
			// blob renumbers every later `__str_blob_`/`__fconst_`/`__jumptable_` label in the whole program
			// and moves its `.rdata` offset besides.
			//
			// ⚠ MEASURED, and it is the debt `InsertRangeChecks` filed against this exact site (A1s): listing
			// `stdlib/Builtins.maxon` — the first listed module that contains LITERALS — moved **317 committed
			// goldens** (`__fconst` 156, `__str_blob` 132, `__jumptable` 29) for declarations no user program
			// reaches. `insertRangeChecks` had already shut its own door onto the same counter; this is the
			// other one, and the two are stated identically because they rest on one fact.
			//
			// ⚠ **THE FUNCTION IS STILL PUSHED — only its BODY is skipped**, and that is not a detail.
			// `FunctionNameIndex` counts the functions in this module to raise E4015, and DFE's header
			// records the assumption that check rests on: nothing may take one side of a colliding pair OUT of
			// the module before the count sees it. Dropping the function here would do exactly that. The
			// empty body is instead PROVED harmless where the two reachability derivations meet —
			// `requireUnreachableStdlibStayedDead` refuses the compile if DFE ever keeps a function this
			// skipped, so a Maxon-tier walk that missed an edge is a loud panic and never an empty callee.
			if self.unreachableStdlib.contains(srcFunc.name) 'notInTheProgram'
				continue
			end 'notInTheProgram'

			// Point the type oracle at THIS function before any of its ops are lowered — the
			// column is dense per function, so every `stdTypeOf` below reads the right one.
			self.valueTags = srcFunc.valueTags
			// PBR-2: which of THIS function's parameters are cell ADDRESSES rather than values. It travels with
			// the type column because it is a correction TO that column — see `stdTypeOf`.
			self.currentByRefParams = srcFunc.reassignedParamMask
			self.currentParamCount = srcFunc.paramCount
			// The closure-environment column travels with it (P1.5-A2b-2): `appendCalleeEnvArgs` threads a
			// function-value argument's env from here.
			self.valueClosureEnv = srcFunc.valueClosureEnv
			// The witness-pairing column travels with it too (P1.7a-existentials slice 1): an existential
			// argument's witness half is FORWARDED from here rather than re-resolved.
			self.valueWitnessIds = srcFunc.valueWitnessIds
			// The existential-instance column travels with it as well (W59): a dispatch's associated FORMAL is
			// resolved from the RECEIVER's own `with` arguments, which live only here.
			self.currentExistentialInstances = srcFunc.valueExistentialInstances
			// The name column travels with it too (P1.6-B1): `materializeLayoutArg` reads a `genericInstance`
			// receiver's `GenericInstanceId` out of it.
			self.valueNameIds = srcFunc.valueNameIds
			self.currentFuncName = srcFunc.name
			// Bind this function's hidden implicit parameters (P1.6-B1 layout + P1.7a slice 2a witnesses).
			self.bindImplicitParams(srcFunc)
			self.currentThrows = srcFunc.throwsTypeName
			// The Std return type was collapsed onto `srcFunc.returnType` in the `transferFuncs` pass above,
			// so it is final here — read it, don't re-collapse `maxonReturnType`.
			self.currentReturnType = srcFunc.returnType
			// The UNCOLLAPSED return type travels with it (P1.7a slice 2): the collapse above erased whether
			// this function hands back a fat pointer, and `emitRetOrErrorReturn` needs exactly that.
			self.currentMaxonReturnType = srcFunc.maxonReturnType
			// The next free ValueId is the count of the dense per-value column the parser handed over.
			self.nextValueId = srcFunc.valueTags.count()
			// Point the range-check site walk at THIS function, so the block walk below can hand each of its
			// sites the Std position the parser's Maxon ordinal became (P1.9). See `RangeSiteWalk`.
			self.bindRangeSiteWalk(srcFunc)
			self.emitParams(srcFunc)

			for blockRef in srcFunc.blockRefs 'eachBlock'
				// ⚠ **THE SOURCE BLOCK IS READ FOR ITS THREE FACTS AND NOT HELD ACROSS THE OP LOOP.** A block
				// read out of `maxonModule.blocks` is a BORROW of that module, and `lowerOp`/`lowerTerminator`
				// write the lowering's own storage — so the held alias is refused (E3070). It is also the
				// staleness `IrModule.getBlockByIdIn` warns about, one container over: *"use this instead of
				// holding an IrBlock struct alias across other block-creating / block-mutating calls"*. The
				// per-op ref is re-read through `maxonBlockOpRefAt`, which is two indexed loads.
				let srcBlock = try self.maxonModule.blocks.get(blockRef) otherwise panic("lowerMaxonToStd: blockRef from srcFunc.blockRefs not in maxonModule.blocks")
				let srcBlockId = srcBlock.id
				let srcOpCount = srcBlock.opRefs.count()
				let srcTerminator = srcBlock.terminator
				var dstBlock = try self.stdModule.blocks.get(blockRef) otherwise panic("lowerMaxonToStd: stdModule.blocks 1:1 with maxonModule.blocks but get({blockRef}) failed")

				self.retypeBlockArgs(dstBlock)

				for maxonOpPos in 0 upto srcOpCount 'eachOp'
					// BEFORE the op is lowered: a site recorded at this ordinal names the op that SPENDS its
					// value, so its guard must split the Std block where that op's own ops are about to begin.
					self.rangeSites.recordAt(srcBlockId, maxonOpPos: maxonOpPos, stdOpPos: dstBlock.opRefs.count())
					let opIdx = self.maxonBlockOpRefAt(blockRef, pos: maxonOpPos)
					let hlOp = self.maxonOpAt(opIdx)
					// The op's own index, for the SIDE TABLES keyed by it. Set here rather than threaded through
					// `lowerOp`'s callees because the depth is arbitrary — the one reader today
					// (`allocTagIndexOf`) sits four frames down.
					self.currentMaxonOpIndex = opIdx
					self.lowerOp(hlOp, dstBlock: dstBlock)
				end 'eachOp'

				// A site whose value is spent by the block's TERMINATOR sits past the last body op, so the end
				// of the body — before the terminator's own ops — is where its guard belongs.
				self.rangeSites.recordAt(srcBlockId, maxonOpPos: srcOpCount, stdOpPos: dstBlock.opRefs.count())

				if terminatorNamesAnOp(srcTerminator) 'hasTerm'
					let termOp = self.maxonOpAt(terminatorOpIndexOf(srcTerminator))
					self.lowerTerminator(termOp, dstBlock: dstBlock)
				end 'hasTerm' else 'noTermOp'
					// An op-less terminator (`dead` for an unreachable if/else continuation,
					// `fallthrough` if a later pass elides one) carries no op to lower, but
					// its marker must survive so the Std block is still "terminated" — the
					// clone above left every dst block at `unset`.
					carryOplessTerminator(srcTerminator, srcBlockId: srcBlockId, dstBlock: dstBlock)
				end 'noTermOp'
			end 'eachBlock'
		end 'eachFunc'

		// AFTER the walk, never inside it: both of these read a body the walk had to finish first — the
		// parametric-witness proof reads the CALLEE's lowered ops, and an adapter is a new entry in the very
		// array the loop above iterates (see `WitnessAdapterRequest` / `NullWitnessArgRequest`).
		self.installParametricWitnessChecks(project)
		self.installWitnessSlotAdapters(project)

		return self.stdModule
	end 'lower'

	// Point `rangeSites` at THIS function's recorded range-check sites (P1.9). A function with no
	// `rangeChecks` entry — or, far more often, one whose entry records no SITE, because an entry is filed
	// for a function that merely passes a constant argument or constructs a generic instance
	// (`Parser.commitRangeChecks`) — shares the inactive walk and allocates nothing.
	function bindRangeSiteWalk(func IrFunction)
		if not self.rangeChecks.contains(func.name) 'noEntry'
			self.rangeSites.standDown()
			return
		end 'noEntry'

		let checks = try self.rangeChecks.get(func.name) otherwise panic("bindRangeSiteWalk: rangeChecks.contains said yes but get failed for '{String.from(func.name)}'")
		if checks.sites.isEmpty() 'noSites'
			self.rangeSites.standDown()
			return
		end 'noSites'

		self.rangeSites.beginFunction(checks, blockCount: func.nextBlockId)
	end 'bindRangeSiteWalk'

	// Give every phi on this block the Std type its VALUE computes in — from `stdTypeOf`, the same
	// one oracle every operand's `operandType` comes from. A phi and its incoming values are then
	// typed by one fact rather than two that must agree.
	//
	// ⚠ THE PARSER CANNOT DO THIS, which is why it is here and not at the mint site. `Parser.mintPhi`
	// holds the phi's Maxon TAG and looks like the obvious place, but the collapse is only TOTAL
	// once SemanticCheck and TypeResolution have run: at parse time a tag may still be `unresolved`
	// (a call to a function no file declares — that is E3004's job) or `named` (a ranged alias, until
	// TypeResolution rewrites the signature). `valueTagToStdType` panics on the first and would have
	// crashed the compiler on a program with a clean diagnostic already waiting for it. By this pass
	// both residues are gone, and that is exactly what earns `stdTypeOf` the right to panic on them.
	//
	// It MUTATES the block-arg list `relocateBlocks` shares with the Maxon block, and that is this
	// pass's business rather than a violation of the sharing rule: the boundary is where Std facts
	// are established, `argType` IS a Std fact, and no Maxon-tier pass reads it.
	function retypeBlockArgs(block IrBlock)
		for i in 0 upto block.blockArgs.count() 'eachArg'
			var arg = try block.blockArgs.get(i) otherwise panic("retypeBlockArgs: i < count() but blockArgs.get({i}) failed")
			arg.argType = self.stdTypeOf(arg.valueId)
		end 'eachArg'
	end 'retypeBlockArgs'

	// Lower a regular (non-terminator) Maxon body op. A `ret`/`retVoid` reaching
	// here (mid-block) is the rare body-op form (v1 hits it for partially-
	// terminated closure bodies) and lowers the same way as the terminator, just
	// appended rather than set.
	function lowerOp(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'lower'
			call(result, callee, args, argLabels, _, _, argDefaultSlots, _) then self.lowerCall(result, callee: callee, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots, dstBlock: dstBlock)
			literal(result, value, litType) then self.lowerLiteral(result, value: value, litType: litType, dstBlock: dstBlock)
			ret(retVal) then self.emitRetOrErrorReturn(retVal, dstBlock: dstBlock, asTerminator: false)
			retVoid then self.emitRetVoidOrErrorReturn(dstBlock, asTerminator: false)
			binOp(result, lhs, rhs, op) then self.lowerBinOp(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
			unaryOp(result, operand, op) then self.lowerUnaryOp(result, operand: operand, op: op, dstBlock: dstBlock)
			compare(result, lhs, rhs, op, signedness) then self.lowerCompare(result, lhs: lhs, rhs: rhs, op: op, signedness: signedness, dstBlock: dstBlock)
			condBranch then panic("lowerMaxonToStd: a `condBranch` appeared as a body op (parser bug — a branch is always a block terminator)")
			branch then panic("lowerMaxonToStd: a `branch` appeared as a body op (parser bug — a branch is always a block terminator)")
			// The varAccess band lowers 1:1 into the Std memory band — the two are the same three ops
			// at two tiers, and the ONLY thing that happens here is the width collapse the tier
			// boundary exists for (`maxonTypeToStdType`: `boolean` → `i1`, whose `storageBytes` is the
			// 1 the `.data` image lays down). The label and the offset pass through verbatim.
			globalAddr(result, label) then self.stdModule.appendOp(dstBlock, op: StdOp.globalAddr(result, label: label))
			loadIndirect(result, addr, offset, valueType) then self.stdModule.appendOp(dstBlock, op: StdOp.loadIndirect(result, addrId: addr, offset: offset, valueType: maxonTypeToStdType(valueType)))
			storeIndirect(addr, offset, value, valueType) then self.stdModule.appendOp(dstBlock, op: StdOp.storeIndirect(addr, offset: offset, valueId: value, valueType: maxonTypeToStdType(valueType)))
			stringLiteral(result, bytes) then self.lowerStringLiteral(result, bytes: bytes, dstBlock: dstBlock)
			// A throwing call: like `call`, plus the second `errorFlag` result (the Std `tryCall`).
			tryCall(result, errorFlag, callee, args, argLabels, _, _, argDefaultSlots, _) then self.lowerTryCall(result, errorFlag: errorFlag, callee: callee, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots, dstBlock: dstBlock)
			panicAbort(message) then self.lowerPanicAbort(message, dstBlock: dstBlock)
			// A function VALUE — a `.text` code address (P1.5-A1). Lowers to the Std `funcAddr`, the
			// `.text` twin of `globalAddr`; a PLAIN function routes through its `__fnref_` env-thunk so the
			// materialized address has the uniform `(userargs, env) -> R` shape (P1.5-A2b-2).
			functionRef(result, funcName) then self.lowerFunctionRef(result, funcName: funcName, dstBlock: dstBlock)
			// A call THROUGH a function value (P1.5-A1) — lowers to the Std `callIndirect`, the callee value
			// passing through as the register the call goes through. Positional args, no labels to slot.
			indirectCall then self.lowerIndirectCall(hlOp, dstBlock: dstBlock)
			// The error terminators are never body ops.
			throwError to propagateError then panic("lowerMaxonToStd: an error terminator appeared as a body op (parser bug — throwError/propagateError are always block terminators)")
			// P1.5-B1a: `async f(…)` spills its scalar args into a slab argument buffer and spawns a green
			// thread; `await p` drives the scheduler until the promise completes. `args` is safe to bind in
			// this big match because a later field (`argLabels`/`argRanges`) follows it — see lowerIndirectCall.
			asyncCall(result, callee, args, argLabels, _, _, argDefaultSlots) then self.lowerAsyncCall(result, callee: callee, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots, dstBlock: dstBlock)
			await (result, promise) then self.lowerAwait(result, promise: promise, dstBlock: dstBlock)
			tryAwait(result, errorFlag, promise) then self.lowerTryAwait(result, errorFlag: errorFlag, promise: promise, dstBlock: dstBlock)
			// `sizeof(T)` — a runtime read of the enclosing instance's layout descriptor (P1.6-B1). The
			// parser folds every CONCRETE sizeof to a literal, so this op only ever carries a typeParameter.
			sizeofType(result, targetType) then self.lowerSizeofType(result, targetType: targetType, dstBlock: dstBlock)
			// P1.7 slice 2: a `b"…"` literal — an owned heap `Array with Byte` record over an immortal rdata blob.
			constArrayLiteral(result, elementSize, elementCount, bytes) then self.lowerConstArrayLiteral(result, elementSize: elementSize, elementCount: elementCount, bytes: bytes, dstBlock: dstBlock)
			// The dense-match jump table is ALWAYS a block terminator, never a body op — see `lowerTerminator`.
			switch then panic("lowerMaxonToStd: a `switch` op appeared as a body op (parser bug — the jump table is always a block terminator)")
			// A constrained-type-parameter dispatch (P1.7a slice 2a) — materialize/forward the witness address
			// and emit the fused `StdOp.witnessCall`. Routed through a helper that RE-MATCHES the op in a SMALL
			// match rather than binding `args` in this big one — the tail-slot-Array corruption `lowerIndirectCall`
			// documents.
			witnessDispatch then self.lowerWitnessDispatch(hlOp, dstBlock: dstBlock)
			// The THROWING twin (P1.7a slice 2b-v) — the same dispatch plus the second `errorFlag` result, so it
			// goes through its own small re-match for the same tail-slot-`Array` reason.
			witnessTryDispatch then self.lowerWitnessTryDispatch(hlOp, dstBlock: dstBlock)
			// A panic whose message was ASSEMBLED at run time (A3n) — the pointer passes through verbatim.
			panicAbortValue(messagePtr) then self.stdModule.appendOp(dstBlock, op: StdOp.osPanicValue(messagePtr))
			// The error flag a routed bare `throw` carries to its block handler — `throwError`'s encode,
			// as a value rather than as a terminator's side effect.
			errorFlagEncode(result, errorValue, errorIsBoxed) then self.lowerErrorFlagEncode(result, errValue: errorValue, errIsBoxed: errorIsBoxed, dstBlock: dstBlock)
			// The three service ops (SV1 wave 3, SV2). All go through a SMALL re-match for
			// `lowerWitnessDispatch`'s reason — an arm here binds nothing, so a field added to any of them
			// cannot be dropped by this match while another reader keeps it.
			serviceSpawn then self.lowerServiceSpawn(hlOp, dstBlock: dstBlock)
			serviceSend then self.lowerServiceSend(hlOp, dstBlock: dstBlock)
			serviceReplyCell then self.lowerServiceReplyCell(hlOp, dstBlock: dstBlock)
		end 'lower'
	end 'lowerOp'

	// Lower a block terminator. A `literal` here is a parser bug (a literal is
	// never a block terminator).
	function lowerTerminator(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'lower'
			ret(retVal) then self.emitRetOrErrorReturn(retVal, dstBlock: dstBlock, asTerminator: true)
			retVoid then self.emitRetVoidOrErrorReturn(dstBlock, asTerminator: true)
			throwError(errValue, errIsBoxed) then self.lowerThrowError(errValue, errIsBoxed: errIsBoxed, dstBlock: dstBlock)
			propagateError(errorFlag) then self.lowerPropagateError(errorFlag, dstBlock: dstBlock)
			condBranch(cond, thenBlockId, elseBlockId) then self.lowerCondBranch(cond, thenBlockId: thenBlockId, elseBlockId: elseBlockId, dstBlock: dstBlock)
			branch(targetBlockId) then self.lowerBranch(targetBlockId, dstBlock: dstBlock)
			// The dense-match jump table lowers 1:1 to the Std twin. Routed through a helper that RE-MATCHES
			// the op in a SMALL match rather than binding `denseTargetBlockIds` in this big one — the tail-slot
			// Array corruption `lowerIndirectCall` documents (the array is the middle slot here, but the helper
			// keeps the discipline uniform and the natural field order).
			switch then self.lowerSwitch(hlOp, dstBlock: dstBlock)
			literal then panic("lowerMaxonToStd: a `literal` op appeared as a block terminator (parser bug — literal is never a terminator)")
			binOp then panic("lowerMaxonToStd: a `binOp` op appeared as a block terminator (parser bug — a binary op is never a terminator)")
			unaryOp then panic("lowerMaxonToStd: a `unaryOp` op appeared as a block terminator (parser bug — a unary op is never a terminator)")
			compare then panic("lowerMaxonToStd: a `compare` op appeared as a block terminator (parser bug — a comparison is never a terminator)")
			call then panic("lowerMaxonToStd: a `call` op appeared as a block terminator (parser bug — a call is a body op, never a terminator)")
			globalAddr to storeIndirect then panic("lowerMaxonToStd: a varAccess op appeared as a block terminator (parser bug — a global's address, load and store are all body ops, never terminators)")
			stringLiteral then panic("lowerMaxonToStd: a `stringLiteral` op appeared as a block terminator (parser bug — a string literal is a value-producing body op, never a terminator)")
			tryCall then panic("lowerMaxonToStd: a `tryCall` op appeared as a block terminator (parser bug — a throwing call is a value-producing body op, never a terminator)")
			panicAbort then panic("lowerMaxonToStd: a `panicAbort` op appeared as a block terminator (parser bug — panicAbort is a body op followed by a dead return terminator)")
			functionRef then panic("lowerMaxonToStd: a `functionRef` op appeared as a block terminator (parser bug — a function reference is a value-producing body op, never a terminator)")
			indirectCall then panic("lowerMaxonToStd: an `indirectCall` op appeared as a block terminator (parser bug — an indirect call is a value-producing body op, never a terminator)")
			asyncCall to tryAwait then panic("lowerMaxonToStd: an async/await op appeared as a block terminator (parser bug — `async`/`await`/`try await` are value-producing body ops, never terminators)")
			sizeofType then panic("lowerMaxonToStd: a `sizeofType` op appeared as a block terminator (parser bug — sizeof is a value-producing body op, never a terminator)")
			constArrayLiteral then panic("lowerMaxonToStd: a `constArrayLiteral` op appeared as a block terminator (parser bug — a constant array literal is a value-producing body op, never a terminator)")
			witnessDispatch to witnessTryDispatch then panic("lowerMaxonToStd: a `witnessDispatch` op appeared as a block terminator (parser bug — a witness dispatch is a value-producing body op, never a terminator)")
			panicAbortValue then panic("lowerMaxonToStd: a `panicAbortValue` op appeared as a block terminator (parser bug — like `panicAbort` it is a body op followed by a dead return terminator)")
			errorFlagEncode then panic("lowerMaxonToStd: an `errorFlagEncode` op appeared as a block terminator (parser bug — it DEFINES the flag a routed throw's edge carries, so it is a value-producing body op emitted ahead of that edge's branch)")
			serviceSpawn to serviceReplyCell then panic("lowerMaxonToStd: a service op appeared as a block terminator (parser bug — a `spawn` produces a mailbox pointer the next op stores, a send is a statement and a reply cell is a value the send that follows it reads; all three are body ops, never terminators)")
		end 'lower'
	end 'lowerTerminator'

	// Lower an integer/float literal to `StdOp.const`. The literal's collapsed
	// StdType rides along on the op: it carries both the width and the float-ness
	// the backend needs to pick a GP mov-immediate vs an XMM load, so no separate
	// opcode (v1's constI64/constF64) is required. `result` is the parser's
	// ValueId — this pass does not renumber.
	function lowerLiteral(result ValueId, value ParsedInt, litType MaxonType, dstBlock IrBlock)
		let stdType = maxonTypeToStdType(litType)
		self.stdModule.appendOp(dstBlock, op: StdOp.const(result, value: value, valueType: stdType))
	end 'lowerLiteral'

	// ⭐ **A STRING LITERAL BECOMES IMMORTAL RDATA + A `lea`** (P1.2 wave A). Two `.rdata` entries are
	// registered — the NUL-terminated byte blob, and the 56-byte record whose `buffer@0` points at it —
	// and the result is the RIP-relative ADDRESS of the record. `registerRdataConstant` DEDUPES both by
	// bytes, so every occurrence of the same literal shares one blob and one record.
	//
	// The record's `buffer@0` cannot be filled here: it is the blob's ABSOLUTE VA, and no VA exists
	// until the PE writer lays out `.rdata`. So the field is a placeholder and a `(record, blob)` fixup
	// is recorded on the data table for the writer to patch (`GlobalDataTable.recordStringBufferFixup`
	// → `PeWriter`). NOTHING is heap-allocated: no `__mm_alloc`, no MM header, no drop.
	//
	// ⚠ It emits `StdOp.rdataAddr`, NOT `StdOp.globalAddr`: `globalAddr` lowers to a `.data`-section
	// relocation (`dataSectionRipRelDisp32`), and the record lives in read-only `.rdata`
	// (`ripRelDisp32`). The two differ only in the section they measure from — which is exactly what
	// the relocation kind discriminates.
	function lowerStringLiteral(result ValueId, bytes ByteArray, dstBlock IrBlock)
		self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(result, label: registerStringLiteralRecord(self.globalData, bytes: bytes).toByteArray()))
	end 'lowerStringLiteral'

	// ⭐ **A CONSTANT ARRAY LITERAL OVER AN IMMORTAL `.rdata` BLOB** — the Array analogue of
	// `lowerStringLiteral`, and it DIVERGES from it in exactly one place: a String literal is a FULLY rdata
	// record (immortal, never dropped), while this is a first-class OWNED array — so the RECORD is
	// `__mm_alloc`'d (giving it the MM header + refcount the ownership model drops through `__managed_decref`)
	// while only the element BUFFER stays in immortal `.rdata`. `capacity@16` is the negative rdata sentinel
	// `__managed_decref` reads to skip freeing that buffer. `bytes` is pure payload by the time it arrives — a
	// `b"…"` is already Latin-1-decoded (`Parser.decodeByteStringLiteral`) and a packed literal is already
	// bit-packed (`Parser.packConstantElements`) — so this is emission and nothing else.
	//
	// ⭐ **`element_size@24` AND `length@8` ARE THE OP'S, NOT THIS FUNCTION'S**, which is what lets one
	// emission serve both producers: a `b"…"` passes 1 and its byte count, a PACKED literal passes a NEGATIVE
	// bit width and its ELEMENT count — a number that is no longer `bytes.count()`, because four 2-bit
	// elements share one byte. Hardcoding either here is what would fork this into two lowerings.
	//
	// Only the FOUR non-zero fields are stamped: `parent@32` and `element_destroy@40` come pre-zeroed from
	// `__mm_alloc`'s zeroing contract (the same one `__managed_create` relies on to leave them unwritten).
	function lowerConstArrayLiteral(result ValueId, elementSize ParsedInt, elementCount ParsedInt, bytes ByteArray, dstBlock IrBlock)
		let blobLabel = registerByteArrayLiteralBlob(self.globalData, bytes: bytes)

		// result = __mm_alloc(ManagedRecordBytes, 0) — the owned heap 48-byte record (MM header + refcount before it).
		let recordSize = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(recordSize, value: ManagedRecordBytes as ParsedInt, valueType: StdType.i64))
		let recordDtor = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(recordDtor, value: 0, valueType: StdType.i64))
		var allocArgs = ValueIdArray.create()
		allocArgs.push(recordSize)
		allocArgs.push(recordDtor)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: MmAllocName, args: allocArgs))

		// buffer@0 = &blob (immortal `.rdata`, materialized by a RIP-relative lea — never freed).
		let blobAddr = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(blobAddr, label: blobLabel.toByteArray()))
		self.emitConstArrayField(result, offset: ManagedRecordBufferOffset, value: blobAddr, dstBlock: dstBlock)

		// length@8 = the ELEMENT count, which equals the byte count only when an element is a byte.
		let lengthId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(lengthId, value: elementCount, valueType: StdType.i64))
		self.emitConstArrayField(result, offset: ManagedRecordLengthOffset, value: lengthId, dstBlock: dstBlock)

		// capacity@16 = the rdata sentinel (< 0) — tells `__managed_decref` the buffer is immortal.
		let capacityId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(capacityId, value: RdataBufferCapacity, valueType: StdType.i64))
		self.emitConstArrayField(result, offset: ManagedRecordCapacityOffset, value: capacityId, dstBlock: dstBlock)

		// element_size@24 — 1 for a `b"…"` (a byte is one byte, so `.get(i)` strides by 1), a NEGATIVE bit
		// width for a packed literal (`.get(i)` then reads its field out of a byte it shares).
		let elementSizeId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(elementSizeId, value: elementSize, valueType: StdType.i64))
		self.emitConstArrayField(result, offset: ManagedRecordElementSizeOffset, value: elementSizeId, dstBlock: dstBlock)
	end 'lowerConstArrayLiteral'

	// Store `value` into the constant array record's `offset` field (an 8-byte slot). The one store shape the
	// four field stamps share, so the record layout is written in one place. Named for the RECORD rather than
	// for the `b"…"` literal that was once its only producer: a PACKED array literal stamps the same four
	// fields through it, and two of the four now carry a value a byte string never had.
	function emitConstArrayField(record ValueId, offset ByteOffset, value ValueId, dstBlock IrBlock)
		self.stdModule.appendOp(dstBlock, op: StdOp.storeIndirect(record, offset: offset, valueId: value, valueType: StdType.i64))
	end 'emitConstArrayField'

	// Emit one `StdOp.param` per parameter at the function's ENTRY block, before any
	// body op. Parameter `i` is ValueId `i` (the ids the parser reserved), of the
	// function's `i`-th resolved Std param type. The x64 lowering turns each into the
	// `mov virtual(i), physical(argReg[i])` that captures the incoming ABI register. A
	// zero-parameter function emits nothing. The entry block is the first `blockRef`.
	function emitParams(func IrFunction)
		if func.paramCount == 0 'noParams'
			return
		end 'noParams'
		let entryRef = try func.blockRefs.get(0) otherwise panic("emitParams: function '{String.from(func.name)}' has no entry block")
		var entryBlock = try self.stdModule.blocks.get(entryRef) otherwise panic("emitParams: entry blockRef {entryRef} not in stdModule.blocks")
		for i in 0 upto func.paramCount 'eachParam'
			let paramType = try func.paramTypes.get(i) otherwise panic("emitParams: paramTypes.get OOB at {i} (paramCount={func.paramCount})")
			self.stdModule.appendOp(entryBlock, op: StdOp.param(i as ValueId, index: i, paramType: paramType))
		end 'eachParam'
	end 'emitParams'

	// --- Dictionary-passing substrate (P1.6-B1) ---

	// Build `layoutNeedingFuncs`: every function that carries the hidden layout-descriptor parameter (P1.6-B1)
	// — which the PARSER reserved, as the LAST param, for every method whose TRANSITIVE need
	// (`Queries.foldDescriptorNeeds`: direct `sizeof(T)` or a self-call to a sibling that needs one) was set. So
	// a method like `indirectSize` that only does `return self.directSize()` carries the param even though it
	// has no `sizeofType` op of its own — which is exactly why detection is by PARAM COUNT here, not an op-scan:
	// the reserved slot is the whole-program fact a caller reads to decide whether to append the descriptor arg.
	function buildLayoutNeedingFuncs()
		// Walks the CHECKED index's own array rather than the module's (A2l): this set is keyed by function
		// NAME, so two functions of one name would silently collapse into one entry and a caller would read
		// the wrong one's descriptor need. `FunctionNameIndex` has already refused that pair.
		for func in self.funcNames.functions 'eachFunc'
			if self.functionHasDescriptorParam(func) 'needsLayout'
				self.layoutNeedingFuncs.upsert(func.name, value: true)
			end 'needsLayout'
		end 'eachFunc'
	end 'buildLayoutNeedingFuncs'

	// Does `func` carry a layout-descriptor parameter (P1.6-B1)? The parser reserves it after the user + env +
	// EXISTENTIAL-WITNESS companions and BEFORE the fixed-element count and any constraint-witness parameters
	// (`[user][env][existentialWitness][layout][count][witness_0..k]`, P1.7a slice 2a + P1.7a-existentials
	// slice 1 + W190), so a `paramCount` above every OTHER hidden block means the layout slot is present. Each of the three
	// counts is derived from a whole-program fact the parser reserved by — the declared parameter TYPES for
	// the env and existential blocks, the enclosing type's `where` constraints for the witness block — so
	// caller and callee agree without a per-function field.
	//
	// ⚠ **A COUNT MISSING FROM THIS SUM READS AS A LAYOUT SLOT THAT IS NOT THERE.** Measured while the
	// existential block was absent from it: the first `function callGreet(g Greeter)` in the corpus made
	// `layoutNeedingFuncs` claim a free function needs a descriptor, and the caller then panicked in
	// `materializeStaticConstructorLayout` looking for a generic instance to source one from.
	function functionHasDescriptorParam(func IrFunction) returns bool
		return func.paramCount > func.maxonParamTypes.count() + countParamsWithTag(func.maxonParamTypes, tag: ValueTypeTag.function) + countParamsWithTag(func.maxonParamTypes, tag: ValueTypeTag.interfaceRef) + self.fixedElementCountParamCountFor(func.name) + self.witnessParamCountForFunc(func)
	end 'functionHasDescriptorParam'

	// ⭐⭐ **DOES `callee` CARRY THE HIDDEN FIXED-ELEMENT-COUNT PARAMETER (W190)?** — asked BY NAME, of the
	// same whole-program fixpoint `Parser.parseFunction` reserved the slot from, at BOTH ends of the ABI.
	//
	// ⚠ **THE LAYOUT SLOT IS RECOVERED FROM THE PARAMETER COUNT AND THIS ONE CANNOT BE, AND THE REASON IS
	// ARITHMETIC RATHER THAN TASTE.** `functionHasDescriptorParam` works by subtracting every OTHER hidden
	// block from `paramCount` and testing what is left over, which decides the question only while ONE
	// optional slot is unaccounted for. With two, `base + 1` is ambiguous between them. So the newer slot
	// states itself by name — and the older one goes on being derived, from a total this now subtracts.
	//
	// ⚠ **AND IT IS ASKED WITHOUT THE `anyFunction…` PRE-GATE `Parser.parseFunction` OPENS WITH, DELIBERATELY.**
	// That gate exists because asking the question there needs the qualified name BUILT — an allocation per
	// method declaration bought to learn `false`. Here the callee's name is already in hand, so the whole
	// cost is one set probe that a shared-empty set answers immediately; a gate would be a branch bought to
	// skip a branch.
	function fixedElementCountParamCountFor(callee ByteArray) returns ParamCount
		return 1 if self.signatures.functionReadsFixedElementCount(callee) else 0
	end 'fixedElementCountParamCountFor'

	// Bind the CURRENT function's hidden implicit parameters (P1.6-B1 layout + W190 count + P1.7a slice 2a
	// witnesses). The witness parameters occupy the FINAL `currentWitnessCount` ValueIds; the fixed-element
	// count (when present) sits just before them, and the layout descriptor (when present) one further in. `hasImplicitLayout` is the authoritative layout-presence bit (a zero-user-param
	// generic method's descriptor slot is legitimately ValueId 0, so the id cannot double as the presence flag);
	// `witnessParamBase` is witness slot 0's ValueId, read by `lowerWitnessDispatch` to forward a witness.
	function bindImplicitParams(func IrFunction)
		self.currentWitnessCount = self.witnessParamCountForFunc(func)
		self.witnessParamBase = func.paramCount - self.currentWitnessCount

		// ⭐ `[user][env][existentialWitness][layout][count][witness_0..k]` — read back from the END, so the
		// count slot is found first and the descriptor sits one further in (W190). BOTH offsets come from
		// `MaxonDialect`'s two slot functions, which is where `Parser.parseFunction` RESERVED them: the order
		// is one fact and a second spelling of it is a wrong register, never a compile error.
		let countSlots = self.fixedElementCountParamCountFor(func.name)
		self.hasImplicitFixedElementCount = countSlots != 0
		self.implicitCountValueId = 0
		if self.hasImplicitFixedElementCount 'countSlot'
			self.implicitCountValueId = fixedElementCountSlotValueId(func.paramCount, witnessParamCount: self.currentWitnessCount)
		end 'countSlot'

		self.hasImplicitLayout = self.functionHasDescriptorParam(func)
		self.implicitLayoutValueId = 0
		if not self.hasImplicitLayout 'noLayout'
			return
		end 'noLayout'

		self.implicitLayoutValueId = layoutDescriptorSlotValueId(func.paramCount, witnessParamCount: self.currentWitnessCount, fixedElementCountSlots: countSlots)
	end 'bindImplicitParams'

	// The number of hidden witness parameters `func` carries (P1.7a slice 2a) — the witness twin of
	// `functionHasDescriptorParam`. Derived from the function's own signature (`takesReceiver`) and its
	// enclosing type's `where`-constraint count, so the count is a pure function of whole-program facts and
	// needs no per-function field. A synthesized function with no signature (a closure/thunk) carries none.
	function witnessParamCountForFunc(func IrFunction) returns ParamCount
		let sig = try self.funcSignatures.get(func.name) otherwise return 0
		return self.witnessParamCountForCallee(func.name, sig: sig)
	end 'witnessParamCountForFunc'

	// The number of witness parameters the CALLEE `callee` carries (P1.7a slice 2a): its witness-constraint
	// count for an INSTANCE method, zero for a static or a free function. Both the callee side (append witness
	// arguments) and the current-function side (bind witness parameters) read this ONE rule, so they cannot
	// drift on how many witnesses a call passes — and it is the count OF the very list `appendWitnessArgs`
	// then walks (`ProgramSignatures.witnessConstraintsOfMethod`), rather than a second lookup that could
	// answer for a different list.
	function witnessParamCountForCallee(callee ByteArray, sig FuncSignature) returns ParamCount
		if not sig.takesReceiver() and not self.signatures.calleeReturnsItsDeclaringType(callee) 'noWitnessSource'
			return 0
		end 'noWitnessSource'
		return self.signatures.witnessConstraintsOfMethod(callee, extensionConstraints: sig.extensionConstraints).count()
	end 'witnessParamCountForCallee'

	// `finalizeCallArgs` (float widening + companion env args) PLUS the hidden IMPLICIT arguments a
	// dictionary-passing call carries: the layout descriptor (P1.6-B1), THEN the fixed element count (W190),
	// THEN one witness pointer per `where` constraint (P1.7a slice 2a) — in the
	// `[user][env][existentialWitness][layout][count][witness_0..k]` order the parser reserved them at, so the
	// caller's argument registers and the callee's `param` ops meet. That ORDER's arithmetic has one home,
	// `MaxonDialect`'s two slot functions; this list is the same order expressed as push order.
	function finalizeCallArgsWithLayout(argIds ValueIdArray, sig FuncSignature, callee ByteArray, result ValueId, dstBlock IrBlock) returns ValueIdArray
		let baseArgs = self.finalizeCallArgs(argIds, sig: sig, callee: callee, dstBlock: dstBlock)
		let needsLayout = self.layoutNeedingFuncs.contains(callee)
		let witnessCount = self.witnessParamCountForCallee(callee, sig: sig)
		// The SUPPLY side of the reserve/supply pair — the SAME counter `Parser.parseFunction` reserves with.
		let existentialCount = countParamsWithTag(sig.paramTypes, tag: ValueTypeTag.interfaceRef)
		let countSlots = self.fixedElementCountParamCountFor(callee)
		if not needsLayout and witnessCount == 0 and existentialCount == 0 and countSlots == 0 'noImplicits'
			return baseArgs
		end 'noImplicits'

		// A FRESH array — `baseArgs` may BE the slotted `argIds` verbatim (finalizeCallArgs's fast path
		// returns them unchanged), so pushing into it would mutate a possibly-shared array. Only a
		// dictionary-passing call pays this copy; the common path already returned `baseArgs` above.
		var out = ValueIdArray.create()
		out.append(baseArgs)
		// ⭐ **THE EXISTENTIAL WITNESSES COME FIRST — the ABI is
		// `[user][env][existentialWitness][layout][count][witness]` and this list is built in that order** (the
		// env companions are already inside `baseArgs`, appended by `finalizeCallArgs`). See
		// `Parser.bindExistentialWitnessParams` for why the block sits where it does.
		if existentialCount > 0 'existentialWitnesses'
			self.appendExistentialWitnessArgs(out, argIds: argIds, sig: sig, callee: callee, dstBlock: dstBlock)
		end 'existentialWitnesses'
		if needsLayout 'layout'
			out.push(self.materializeLayoutArgFor(argIds, sig: sig, result: result, callee: callee, dstBlock: dstBlock))
		end 'layout'
		if countSlots > 0 'fixedElementCount'
			out.push(self.materializeFixedElementCountArgFor(argIds, sig: sig, result: result, callee: callee, dstBlock: dstBlock))
		end 'fixedElementCount'
		if witnessCount > 0 'witnesses'
			self.appendWitnessArgs(out, argIds: argIds, sig: sig, result: result, callee: callee, dstBlock: dstBlock)
		end 'witnesses'
		return out
	end 'finalizeCallArgsWithLayout'

	// ⭐⭐ **APPEND THE WITNESS HALF OF EVERY EXISTENTIAL ARGUMENT (P1.7a-existentials slice 1)** — one per
	// interface-typed parameter of `callee`, in parameter order, which is the order
	// `Parser.bindExistentialWitnessParams` reserved the companions in.
	//
	// TWO ways a witness reaches the callee, and they are the two halves of the widening rule
	// (`ConformanceCheck.valueWidensToInterface`, which has already ACCEPTED this argument — a non-conforming
	// one is E3005 at `SemanticCheck.checkOneArgType` and never reaches lowering):
	//
	//   • the argument is ALREADY an existential (a parameter threaded onward, a merge phi, a field read) —
	//     FORWARD the witness the parser paired with it. Re-resolving one would ask for a table keyed
	//     `(<Iface>, <Iface>)`, which has no conformer and does not exist; v1 hits exactly that and soft-fails
	//     to a NULL witness (`materializeInterfaceWitness`), which is a wild jump at the next dispatch.
	//   • the argument is a CONCRETE conformer — materialize `__witness_<conformer>.<Iface>`, through the very
	//     helper the `Set`/`Map` runtimes already thread their key witnesses with, so a program reaches one
	//     table whichever door asked for it.
	function appendExistentialWitnessArgs(out ValueIdArray, argIds ValueIdArray, sig FuncSignature, callee ByteArray, dstBlock IrBlock)
		for i in 0 upto sig.paramTypes.count() 'eachParam'
			let paramType = try sig.paramTypes.get(i) otherwise panic("appendExistentialWitnessArgs: paramTypes.get OOB at {i} for '{String.from(callee)}'")
			if maxonTypeTag(paramType) != ValueTypeTag.interfaceRef 'notExistential'
				continue
			end 'notExistential'

			let arg = try argIds.get(i) otherwise panic("appendExistentialWitnessArgs: '{String.from(callee)}' declares an interface-typed parameter at position {i} but the call slotted only {argIds.count()} arguments — `slotCallArgs` fills every declared position")
			out.push(self.witnessForExistentialValue(arg, interfaceName: interfaceNameOfType(paramType, typeNames: self.typeNames), site: callee, dstBlock: dstBlock))
		end 'eachParam'
	end 'appendExistentialWitnessArgs'

	// The witness half for ONE value crossing into an interface-typed position — the FORWARD/MATERIALIZE split
	// `appendExistentialWitnessArgs` documents, and the same split `materializeWitnessArg` makes for a
	// constraint witness one mechanism over.
	//
	// ⭐ **IT SERVES BOTH WIDENING POSITIONS, WHICH IS WHY IT NAMES NEITHER (P1.7a slice 2).** An ARGUMENT's
	// witness travels in an adjacent hidden argument and a RETURN's in the secondary return register, but
	// WHICH TABLE to name is one question with one answer, and a returned existential must be
	// indistinguishable downstream from a parameter-borne one. `site` is the name a refusal quotes — the
	// callee for an argument, the returning function for a return.
	function witnessForExistentialValue(value ValueId, interfaceName ByteArray, site ByteArray, dstBlock IrBlock) returns ValueId
		if self.valueTagOf(value) == ValueTypeTag.interfaceRef 'forwardTheFatPointersOwnWitness'
			return self.pairedWitnessOf(value, site: site)
		end 'forwardTheFatPointersOwnWitness'

		return self.materializeWitnessTableAddr(self.conformerNameOf(value), instance: self.witnessInstanceOfValue(value), interfaceName: interfaceName, dstBlock: dstBlock)
	end 'witnessForExistentialValue'

	// The witness the parser paired with an existential VALUE (`IrFunction.valueWitnessIds`). It refuses the
	// `0` filler rather than passing it: a null table address is a wild jump at the callee's first dispatch,
	// and every producer of an interface-typed value pairs it at the moment it mints it
	// (`Parser.pairInterfaceWitness`), so a miss is a compiler invariant break.
	//
	// The column is grown on demand and stops at its highest paired value, so a ValueId PAST its end is the
	// same fact as a 0 within it — unpaired — and takes the same refusal. `Parser.witnessOfValue` states that
	// equivalence at the other end of the handoff.
	// ⚠ Its PARSER twin is `Parser.witnessOfValue`, which states the rule in full; see there for why the two
	// cannot share a home and must never disagree.
	function pairedWitnessOf(value ValueId, site ByteArray) returns ValueId
		let witness = try self.valueWitnessIds.get(value) otherwise 0 as ValueId
		if witness == 0 'unpaired'
			panic("pairedWitnessOf: v{value} is typed as an interface at '{String.from(site)}' but carries no witness half — the parser pairs every existential it mints (`Parser.pairInterfaceWitness`)")
		end 'unpaired'

		return witness
	end 'pairedWitnessOf'

	// The CANONICAL conformer name a concrete argument's witness table is keyed by — the SAME reduction the
	// conformance answer and the impl symbols use (`ProgramSignatures.conformerNameOfType`), so the widening
	// that accepted this argument and the table this looks up cannot be filed under different names.
	function conformerNameOf(value ValueId) returns ByteArray
		return self.signatures.conformerNameOfType(maxonTypeOfTag(self.valueTagOf(value), nameId: try self.valueNameIds.get(value) otherwise panic("conformerNameOf: value v{value} has no recorded type name — the two type columns are minted in lockstep")), idsFrom: self.typeNames).toByteArray()
	end 'conformerNameOf'

	// Append the hidden WITNESS arguments a dictionary-passing call to `callee` carries (P1.7a slice 2a) — one
	// per `where` constraint of the callee's enclosing type, in constraint (source) order, AFTER any layout
	// descriptor. `out` is the fresh argument array `finalizeCallArgsWithLayout` built (never `argIds`), so
	// pushing is safe.
	//
	// ⭐ **THE SOURCE VALUE IS THE RECEIVER, OR — FOR A `Self`-RETURNING STATIC — THE RESULT (W43b).** It is
	// `materializeLayoutArgFor`'s split exactly, one dictionary column over, and the two are decided by the
	// same predicate (`sig.takesReceiver()`) so a call can never take its descriptor from one value and its
	// witnesses from another.
	function appendWitnessArgs(out ValueIdArray, argIds ValueIdArray, sig FuncSignature, result ValueId, callee ByteArray, dstBlock IrBlock)
		let source = self.witnessSourceValue(argIds, sig: sig, result: result, callee: callee)
		let constraints = self.signatures.witnessConstraintsOfMethod(callee, extensionConstraints: sig.extensionConstraints)
		for i in 0 upto constraints.count() 'eachConstraint'
			let constraint = try constraints.get(i) otherwise panic("appendWitnessArgs: whereConstraints.get OOB at {i}")
			out.push(self.materializeWitnessArg(source, constraint: constraint, constraintIndex: i, callee: callee, dstBlock: dstBlock))
		end 'eachConstraint'
	end 'appendWitnessArgs'

	// The value a call's witness tables are read off — the RECEIVER for an instance method, the RESULT for a
	// `Self`-returning static (W43b). It is `materializeLayoutArgFor`'s split, decided by the same
	// `sig.takesReceiver()`, so a call cannot take its layout descriptor from one value and its witnesses
	// from another. A receiverless callee that is NOT a generic constructor carries no witness block at all
	// (`witnessParamCountForCallee`), so it never reaches here.
	function witnessSourceValue(argIds ValueIdArray, sig FuncSignature, result ValueId, callee ByteArray) returns ValueId
		if not sig.takesReceiver() 'staticConstructor'
			return result
		end 'staticConstructor'
		return try argIds.get(0) otherwise panic("witnessSourceValue: witness-carrying instance method '{String.from(callee)}' has no receiver argument — its first parameter is `self`")
	end 'witnessSourceValue'

	// The witness-table address to pass for ONE constraint (P1.7a slice 2a). A CONCRETE generic-instance
	// receiver → the RIP-relative address of `__witness_<ConcreteArg>.<Iface>` (`rdataAddr`), emitting the
	// table on first reference; a receiver that is the enclosing generic body's OWN `self` (`structRef`) or a
	// value of its type parameter → FORWARD the caller's own witness slot for the same constraint index (a
	// generic→generic call, both of the same type, so the slots align). Mirrors `materializeLayoutArg`.
	function materializeWitnessArg(receiver ValueId, constraint WhereConstraint, constraintIndex WitnessSlotIndex, callee ByteArray, dstBlock IrBlock) returns ValueId
		let tag = self.valueTagOf(receiver)
		if tag == ValueTypeTag.genericInstance 'concrete'
			let gid = try self.valueNameIds.get(receiver) otherwise panic("materializeWitnessArg: genericInstance receiver v{receiver} has no name-id (its GenericInstanceId)")

			// ⭐⭐ **AN INSTANCE OVER THE ENCLOSING BODY'S OWN TYPE PARAMETER FORWARDS, IT DOES NOT MATERIALIZE
			// (W41).** The receiver IS a concrete `genericInstance` — but the argument at the constrained
			// position may be an OPAQUE parameter of the function we are lowering: `Map.createIterator` building
			// a `MapIterator with (Key, Value)` while `Key` is still `Map`'s own parameter. There is no table to
			// name (`conformerTypeArgName` answers a mangled `T<digest>` that no conformance is filed under, and
			// `ensureWitnessTable` on it PANICS in `witnessSlotImpl`), and there does not need to be: the caller
			// was handed one, and its own `where` clause says which slot.
			//
			// ⚠ **THE SLOT COMES FROM THE SHARED VERDICT, NEVER FROM `constraintIndex`.** The two constraint
			// lists here belong to DIFFERENT declarations (`Map`'s and `MapIterator`'s), so the prefix-alignment
			// that lets the `structRef`/`typeParameter` arm below forward slot `i` to slot `i` does not hold and
			// must not be assumed — that is exactly the wrong forwarding index this rung exists to avoid.
			// `opaqueParamDischarge` is the same answer `checkWhereConstraints` accepted the program on, so the
			// slot placed here is the slot the check verified.
			let typeArg = self.signatures.substitutedInstanceArg(gid, position: constraint.typeParamIndex)
			if maxonTypeTag(typeArg) == ValueTypeTag.typeParameter 'opaqueArgument'
				return self.forwardOpaqueParamWitness(typeNameIdOf(typeArg), constraint: constraint, callee: callee)
			end 'opaqueArgument'

			// The CANONICAL conformer name (`Box with Integer` -> `int`, `Box with Point` -> `Point`), so the
			// table label (`__witness_int.Hashable`) and its slot reloc (`int.hash`) name the synthesized primitive
			// impl — the SAME reducer the E3017 check keys its conformance lookup by, never a second spelling.
			//
			// ⭐ **AND THE ARGUMENT'S OWN INSTANCE TRAVELS BESIDE THAT NAME (G19)**: the reduction answers WHICH
			// conformance, and where that conformance's impls carry a dictionary the table has to be keyed by the
			// instantiation as well. `witnessTableInstanceFor` decides; a `Box with Integer` still names
			// `__witness_int.Hashable` because `int` is no instance at all.
			let concreteType = self.signatures.conformerTypeArgName(gid, position: constraint.typeParamIndex).toByteArray()
			let argInstance = self.constraintArgumentInstance(gid, position: constraint.typeParamIndex)

			// ⭐⭐ **AND AN INSTANCE THAT IS STILL PARAMETRIC HAS NO TABLE AT ALL, SO THE CALL PASSES A ZERO AND
			// OWES A PROOF (BATCH43)** — see `NullWitnessArgRequest` for why no `.rdata` blob can serve it and
			// why a proved zero is not the null witness v1 concedes a runtime fault for. The arm above catches
			// a BARE opaque argument by forwarding a slot the caller was handed; this one is the argument that
			// is a whole INSTANCE over the caller's parameters, for which no caller ever held a slot.
			if self.constraintArgumentHasNoTable(concreteType, instance: argInstance, interfaceName: constraint.interfaceName) 'parametricArgument'
				self.pendingNullWitnessArgs.push(NullWitnessArgRequest.create(self.currentFuncName, callee: callee, constraintIndex: constraintIndex, conformerType: concreteType, interfaceName: constraint.interfaceName))
				let nullId = self.mintStdValueId()
				self.stdModule.appendOp(dstBlock, op: StdOp.const(nullId, value: 0, valueType: StdType.i64))
				return nullId
			end 'parametricArgument'

			let label = self.ensureWitnessTable(concreteType, instance: argInstance, interfaceName: constraint.interfaceName)
			let addrId = self.mintStdValueId()
			self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(addrId, label: label.toByteArray()))
			return addrId
		end 'concrete'
		if tag == ValueTypeTag.structRef or tag == ValueTypeTag.typeParameter 'forward'
			return self.forwardCallerWitness(constraintIndex, callee: callee)
		end 'forward'
		panic("materializeWitnessArg: call to witness-carrying '{String.from(callee)}' has a receiver of tag {tag.name} — an instance method's receiver is a concrete generic instance, the enclosing self (structRef), or a type parameter")
	end 'materializeWitnessArg'

	// Forward the CURRENT (generic) function's own witness slot for `constraintIndex` to a callee (P1.7a slice
	// 2a) — a generic body driving another generic method on `self` (or a value of its type parameter), both of
	// the same type, so the slot index aligns.
	// The witness twin of `forwardCallerLayout`: the caller MUST carry witnesses (an instance method of a
	// constrained type always does), so a missing slot is an internal invariant break, not a user error.
	//
	// ⚠ **THE TWO LISTS ARE PREFIX-ALIGNED, NOT IDENTICAL, AND THIS HEADER SAID "IDENTICAL" (corrected at
	// review — W23 made it false).** A TYPE EXTENSION's method carries the type's constraints FOLLOWED by the
	// extension's extras (`ProgramSignatures.typeExtensionWitnessConstraints`), so an extension body forwarding
	// to a plain method of the same type has a STRICTLY LONGER list than its callee. Alignment survives because
	// the type's own constraints come FIRST — that ordering is the whole reason the union appends rather than
	// interleaving, and it is what this function rests on.
	//
	// ⛔ **AND THE BOUND IS CHECKED, NOT ASSUMED.** The reverse direction — a caller whose list is SHORTER than
	// its callee's — indexes past this function's own parameters and returns a `ValueId` belonging to some
	// other value: a witness table read out of the wrong slot, which is a wild indirect call and not a
	// diagnosable type error. `Parser.requireReceiverSatisfiesExtensionConstraints` refuses that program with a
	// position, so reaching here means that refusal did not fire; testing only `== 0` let every non-zero
	// mismatch through in silence.
	// ⭐⭐ **FORWARD THE SLOT THE ENCLOSING DECLARATION'S OWN `where` CLAUSE PROMISED FOR AN OPAQUE ARGUMENT
	// (W41)** — the cross-declaration case `forwardCallerWitness` deliberately does not cover, because there
	// the two constraint lists belong to one type and align by index, and here they do not.
	//
	// ⚠⚠ **THE OWNER GUARD IS THE WHOLE SAFETY ARGUMENT AND IT IS CHECKED, NOT ASSUMED.**
	// `opaqueParamDischarge` returns an index into the OWNER declaration's `whereConstraints`, and that index
	// is a witness-parameter number only for a function whose witness block IS that list — a method of the
	// owner type (its own, or an extension's, whose extras come after). Lowering a body that reached an
	// opaque parameter owned by some OTHER declaration would forward a slot holding an unrelated table: a
	// wild indirect call, invisible to every check downstream. Nothing produces that shape today — a bare `T`
	// resolves against the ENCLOSING declaration's `uses` list and nowhere else — which is precisely why it
	// is worth a panic rather than a comment.
	//
	// ⚠ `unsatisfied` is likewise an invariant break rather than a user error: `checkWhereConstraints` ran
	// this same predicate and refused the program with E3017 if it did not discharge, so reaching lowering
	// means it did. Both panics name the two declarations, because the answer to "which one is wrong" is
	// always which pair failed to line up.
	function forwardOpaqueParamWitness(token TypeParamId, constraint WhereConstraint, callee ByteArray) returns ValueId
		let owner = try self.signatures.typeParamOwnerOf(token) otherwise panic("forwardOpaqueParamWitness: lowering '{String.from(self.currentFuncName)}' reached an opaque type parameter (token {token}) that no declaration filed — every `typeParameter` the parser mints is recorded against the `uses` list it was resolved from")
		// The declaring TYPE of the function being lowered — the same `Type.member` split
		// `witnessConstraintsOfMethod` reads a caller's own constraint list through, so the two agree on what
		// "this function's type" means by construction.
		let enclosingType = match splitQualifiedName(self.currentFuncName) 'q'
			notQualified gives EmptySourceText
			parts(typeName, _) gives typeName
		end 'q'
		if not enclosingType.equals(owner.declaringTypeName) 'foreignParameter'
			panic("forwardOpaqueParamWitness: '{String.from(self.currentFuncName)}' passes `{String.from(owner.paramName)}` of `type {String.from(owner.declaringTypeName)}` to '{String.from(callee)}', but this function is a method of `{String.from(enclosingType)}` — a witness slot index of one declaration is not a parameter number of another, and forwarding it would read a table out of an unrelated slot")
		end 'foreignParameter'

		match opaqueParamDischarge(self.signatures, interfaces: self.interfaces, token: token, interfaceName: constraint.interfaceName) 'discharge'
			slot(index) then return self.forwardCallerWitness(index, callee: callee)
			unsatisfied then panic("forwardOpaqueParamWitness: '{String.from(self.currentFuncName)}' passes `{String.from(owner.paramName)}` to '{String.from(callee)}', which requires `{String.from(constraint.interfaceName)}`, and `type {String.from(owner.declaringTypeName)}` promises nothing that reaches it — `checkWhereConstraints` asks this same question and refuses such a program with E3017, so the two have come apart")
		end 'discharge'
	end 'forwardOpaqueParamWitness'

	function forwardCallerWitness(constraintIndex WitnessSlotIndex, callee ByteArray) returns ValueId
		if constraintIndex >= self.currentWitnessCount 'noSuchSlot'
			panic("forwardCallerWitness: caller '{String.from(self.currentFuncName)}' carries {self.currentWitnessCount} witness parameter(s) and was asked to forward slot {constraintIndex} to '{String.from(callee)}' — a generic→generic dispatch is only reached from an instance method whose own constraint list is a PREFIX-COMPATIBLE superset of the callee's")
		end 'noSuchSlot'
		return (self.witnessParamBase + constraintIndex) as ValueId
	end 'forwardCallerWitness'

	// ⭐ **THE `.rdata` WITNESS-TABLE BLOB for `typeName` conforming to `interfaceName` (P1.7a slice 2a).** The
	// `24 + 8*methodCount`-byte blob (`methodCount@0`, `destroyFunc@8`, `flags@16`=0, `methods[N]@24`) is
	// registered zero-filled under `__witness_<Type>.<Iface>`; each method slot is stamped by a
	// `funcAbs64InRdata` relocation whose target is the member `checkConformance` ACCEPTED for that
	// requirement (`witnessSlotImpl` — NOT a second `<Type>.<method>` join of this pass's own, see R10) with
	// the SAME reloc that bakes a layout descriptor's `destroyFunc@40`. Every writer bakes it now — the PE one, the
	// Mach-O/ELF arm64 one (slice 2b-iv-C) and the wasm one as a funcref-table index (slice 2b-iv-B).
	// Each impl is DCE-ROOTED (`recordCallUsage`) so the reloc never names a `.text` VA that
	// was pruned — the noteDestructorUsage/noteClonerUsage rooting pattern for a slot named nowhere the module
	// call graph can see. Idempotent by label: a table referenced at many sites registers ONE blob, ONE set of
	// relocations, and one root.
	function ensureWitnessTable(typeName ByteArray, instance WitnessTableInstance, interfaceName ByteArray) returns String
		let table = self.witnessTableInstanceFor(typeName, instance: instance, interfaceName: interfaceName)
		let label = witnessTableLabel(self.witnessTableLabelComponent(typeName, instance: table), interfaceName: interfaceName)
		if self.emittedWitnessTables.contains(label) 'cached'
			return label
		end 'cached'
		self.emittedWitnessTables.insert(label)

		// ⭐ **THE SLOT LIST IS THE INTERFACE'S TRANSITIVE REQUIREMENT SET, not `iface.methods` (R10c)** — the
		// SAME list `Parser.findWitnessDispatchCandidates` numbers its `methodIndex` against, so the slot this
		// pass stamps and the offset the caller compiles are one answer. Reading `iface.methods` here left an
		// `extends`-inherited requirement with no slot at all.
		let iface = self.resolveWitnessInterface(interfaceName)
		let slots = interfaceWitnessSlots(self.interfaces, iface: iface)
		let methodCount = slots.count()
		let associatedCount = self.heldAssociatedSlotCount(interfaceName, iface: iface)

		// `methodCount@0`, then zero-fill through the header (`destroyFunc@8`, `flags@16`), every method
		// slot and — where this interface holds an associated position at an interface — the associated
		// block past them. The writer patches the slots via the relocations below. `scalarImage` is the SAME
		// little-endian serializer the `.data`/`.rdata` images use, so the header word matches every other
		// integer this backend writes.
		//
		// ⚠ **`methodCount@0` COUNTS THE METHOD SLOTS AND NOT THE BLOB'S SLOTS**, which is why it is written
		// from `methodCount` and not from the sum below. It is the length of the list a dispatch's
		// `methodIndex` indexes; the associated block is addressed from that same count and is not part of
		// it, so widening this word would move every reader's idea of where the methods end.
		var blob = ByteArray.create()
		blob.append(scalarImage(methodCount, byteCount: WitnessSlotBytes as ByteCount))
		blob.growFilled((WitnessTableHeaderBytes + WitnessSlotBytes * (methodCount + associatedCount)) as ElementCount, value: 0)
		_ = self.globalData.registerRdataConstantLabeled(label, bytes: blob)

		// ⭐ **`destroyFunc@8` — HOW AN OWNED EXISTENTIAL OF THIS CONFORMER IS RELEASED — and `retainFunc@16`,
		// HOW A SECOND OWNER OF ONE IS TAKEN (P1.7a-existentials slices 2 and 2b).** Both are derived from
		// ONE ownership-protocol answer, so they are non-zero together and cannot disagree about a conformer.
		//
		// ⭐⭐ **A PER-INSTANCE TABLE ASKS THE INSTANCE, WHICH IS THE WHOLE POINT OF HAVING ONE (G19)** — see
		// `ProgramSignatures.instanceDropCallee` for the leak the conformer-name answer produced on a nested
		// container. A shared table has no instance to ask and keeps the conformer's answer, byte for byte.
		self.stampOwnershipWord(self.witnessDestroyCallee(typeName, instance: table), label: label, offsetInLabel: WitnessDestroyFuncOffset)
		self.stampOwnershipWord(self.witnessRetainCallee(typeName, instance: table), label: label, offsetInLabel: WitnessRetainFuncOffset)

		for i in 0 upto methodCount 'eachMethod'
			let slot = try slots.get(i) otherwise panic("ensureWitnessTable: slots.get OOB at {i} below count {methodCount}")
			// The DECLARING interface, never this table's — `ConformanceCheck.recordWitnessSlotImpl` files its
			// selection under the interface the requirement was declared on, so an inherited slot's key is the
			// PARENT's. Passing `interfaceName` here would miss every projected slot's selection and panic.
			self.globalData.recordFuncAbs64InRdata(self.witnessSlotCallee(typeName, instance: table, slot: slot), rdataLabel: label, offsetInLabel: witnessMethodSlotOffset(i))
		end 'eachMethod'

		self.stampAssociatedWitnessSlots(typeName, interfaceName: interfaceName, label: label, methodCount: methodCount, associatedCount: associatedCount)
		return label
	end 'ensureWitnessTable'

	// ⭐⭐ **THE VERDICT BEHIND `WitnessTableInstance` — a caller states which instance it holds, and this
	// decides whether the table is keyed by it (G19).** Two independent reasons reduce a stated instance back
	// to the shared table, and both are about what the ADAPTER would have to build:
	//
	//   • the conformance's impls carry NO hidden dictionary, so a per-instance table would name the identical
	//     slots as the shared one under a second label — a duplicate blob and a moved golden for nothing;
	//   • the instance is not CONCRETE, so there is no descriptor and no argument witness to put in one. An
	//     instance over the enclosing body's own type parameters is exactly this shape, and it is the same
	//     fact `emitInstanceDescriptorAddr` acts on one mechanism over (it forwards the caller's blocks; a
	//     table has no caller to forward from, so here it can only decline).
	//
	// ⇒ a program that never reaches a dictionary-carrying conformance through a concrete instance mints
	// exactly the tables it always did.
	function witnessTableInstanceFor(typeName ByteArray, instance WitnessTableInstance, interfaceName ByteArray) returns WitnessTableInstance
		match instance 'stated'
			shared then return WitnessTableInstance.shared
			perInstance then break 'stated'
		end 'stated'

		if not self.conformanceImplsCarryADictionary(typeName, interfaceName: interfaceName) 'nothingToSupply'
			return WitnessTableInstance.shared
		end 'nothingToSupply'

		return instance if self.instanceIsFullyConcrete(instance) else WitnessTableInstance.shared
	end 'witnessTableInstanceFor'

	// The table's two OWNERSHIP words, each from the one source the table has: the INSTANCE when it is keyed by
	// one, the conformer NAME otherwise. Two functions rather than one returning a pair, because they are read
	// at two different offsets and each is one line; what they must share is the PROTOCOL answer, and they do —
	// see `ProgramSignatures.instanceDropCallee` / `existentialDestroyCallee`, each of which derives its
	// retain twin from the same protocol call.
	function witnessDestroyCallee(typeName ByteArray, instance WitnessTableInstance) returns ByteArray
		return match instance 'table'
			shared gives self.signatures.existentialDestroyCallee(typeName)
			perInstance(gid) gives self.signatures.instanceDropCallee(gid)
		end 'table'
	end 'witnessDestroyCallee'

	function witnessRetainCallee(typeName ByteArray, instance WitnessTableInstance) returns ByteArray
		return match instance 'table'
			shared gives self.signatures.existentialRetainCallee(typeName)
			perInstance(gid) gives self.signatures.instanceRetainCallee(gid)
		end 'table'
	end 'witnessRetainCallee'

	// The `<Type>` half of a table's label: the conformer's own name for the shared table, the instance's
	// canonical mangling for a per-instance one — the SAME mangling `__layout_<instance>` is built from
	// (`ensureLayoutDescriptor`), so a per-instance table and the descriptor its adapter passes name one
	// instance in one spelling.
	//
	// ⚠ **THE IMPLS ARE STILL THE CONFORMER'S, AND THAT SPLIT IS THE WHOLE OF THE PER-INSTANCE TABLE.** Which
	// member fills a slot, and what a held associated position binds, are facts about the DECLARATION and one
	// shared body answers them for every instantiation — so those questions keep asking `typeName` whichever
	// table is being built. What moves with the label is what is a fact about the INSTANCE: the adapter's
	// dictionary (`appendInstanceAdapterDictionary`) and the two ownership words (`witnessDestroyCallee`).
	function witnessTableLabelComponent(typeName ByteArray, instance WitnessTableInstance) returns ByteArray
		return match instance 'table'
			shared gives typeName
			perInstance(gid) gives self.signatures.mangleGenericInstance(gid)
		end 'table'
	end 'witnessTableLabelComponent'

	// Does ANY slot of this conformance hold an impl whose ABI is wider than the slot's — i.e. an impl that
	// takes the hidden dictionary a generic declaration reserves? Memoized per `(conformer, interface)`
	// because it is asked at every per-instance mint and is a pure function of the impls' declared arities.
	//
	// ⚠ **IT IS THE SAME TEST `witnessSlotCallee` MAKES PER SLOT, and it must stay that way**: this decides
	// the LABEL and that decides whether an ADAPTER is built, so a conformance called dictionary-free here
	// whose slot then demanded an adapter would hand a per-instance adapter a shared table's null dictionary.
	// Both go through `witnessSlotImplIsSlotShaped`.
	function conformanceImplsCarryADictionary(typeName ByteArray, interfaceName ByteArray) returns bool
		let key = witnessTableLabel(typeName, interfaceName: interfaceName)
		if let memoized = try self.dictionaryCarryingConformances.get(key) 'alreadyAsked'
			return memoized
		end 'alreadyAsked'

		let slots = interfaceWitnessSlots(self.interfaces, iface: self.resolveWitnessInterface(interfaceName))
		var carries = false
		for i in 0 upto slots.count() 'eachSlot'
			let slot = try slots.get(i) otherwise panic("conformanceImplsCarryADictionary: slots.get OOB at {i} below count {slots.count()}")
			if not self.witnessSlotImplIsSlotShaped(self.witnessSlotImpl(typeName, interfaceName: slot.sourceInterfaceName, method: slot.method), method: slot.method) 'thisSlotCarriesOne'
				carries = true
				break
			end 'thisSlotCarriesOne'
		end 'eachSlot'

		self.dictionaryCarryingConformances.upsert(key, value: carries)
		return carries
	end 'conformanceImplsCarryADictionary'

	// Is the member filling this slot already the slot's own shape — the ONE test that decides both whether an
	// adapter is needed (`witnessSlotCallee`) and whether the conformance needs a per-instance table
	// (`conformanceImplsCarryADictionary`).
	//
	// A COMPILER-SYNTHESIZED impl (`int.hash`, an `__` runtime entry) is in no signature registry and is built
	// to the requirement's shape by construction — see `witnessSlotCallee` for why it is never measured
	// against a signature that does not exist.
	function witnessSlotImplIsSlotShaped(implName ByteArray, method InterfaceMethodSig) returns bool
		if not self.funcSignatures.contains(implName) 'compilerSynthesizedImpl'
			return true
		end 'compilerSynthesizedImpl'

		let impl = try self.funcNames.funcNamed(implName) otherwise panic("witnessSlotImplIsSlotShaped: '{String.from(implName)}' has a declared signature but is in no function of this module — `witnessSlotImpl` names the member a conformance ACCEPTED, and a check accepts only a declaration the merge carried")
		return impl.paramCount == self.witnessSlotAbiArity(method)
	end 'witnessSlotImplIsSlotShaped'

	// Does this REQUEST name a fully concrete instance? `ProgramSignatures.instanceArgsAreFullyConcrete` is the
	// rule; this is the union's own arm on it, so a `shared` request needs no gid to ask about.
	function instanceIsFullyConcrete(instance WitnessTableInstance) returns bool
		return match instance 'table'
			shared gives false
			perInstance(gid) gives self.signatures.instanceArgsAreFullyConcrete(gid)
		end 'table'
	end 'instanceIsFullyConcrete'

	// ⭐⭐ **CAN THIS CONSTRAINT ARGUMENT BE GIVEN A WITNESS TABLE AT ALL (BATCH43)?** — the question a CALL
	// SITE has to ask that `witnessTableInstanceFor` deliberately does not, because that one decides which of
	// two tables to mint and this one decides whether either exists.
	//
	// ⚠ **IT IS THE SAME TWO PREDICATES, COMPOSED THE OTHER WAY, AND THAT IS THE WHOLE POINT.**
	// `witnessTableInstanceFor` reduces a stated instance to `shared` for two reasons that are NOT the same
	// fact: a conformance whose impls carry NO dictionary is SERVED correctly by the shared table (one
	// compiled impl answers for every instantiation), while a PARAMETRIC instance of one that DOES carry a
	// dictionary is served by nothing — its adapter would have to name a descriptor the enclosing frame holds
	// at run time. Reading both as "shared" is right for the mint and wrong for the argument: it sent the
	// second shape into a table whose adapter then hands the impl a null dictionary, and G19's
	// `requireWitnessSlotImplIgnoresDictionary` refused it with E3128 — the right refusal about the TABLE,
	// asked one mechanism away from the call the author wrote.
	//
	// Both halves stay in their own single home (`conformanceImplsCarryADictionary`, `instanceIsFullyConcrete`)
	// so this is a second COMPOSITION and never a second opinion.
	function constraintArgumentHasNoTable(typeName ByteArray, instance WitnessTableInstance, interfaceName ByteArray) returns bool
		// ⚠ **A `shared` REQUEST IS NOT A NON-CONCRETE ONE, AND `instanceIsFullyConcrete` ANSWERS `false` FOR
		// BOTH.** That predicate is asked only of a request already known to be `perInstance`
		// (`witnessTableInstanceFor` matches first), and an argument that names no instance at all — `int`, a
		// plain struct — is served by the conformer's own table exactly as it always was. Testing concreteness
		// without this arm would call every such argument untabulatable the moment its conformer's impls
		// carried a dictionary.
		match instance 'stated'
			shared then return false
			perInstance then break 'stated'
		end 'stated'

		if self.instanceIsFullyConcrete(instance) 'aConcreteInstantiation'
			return false
		end 'aConcreteInstantiation'

		return self.conformanceImplsCarryADictionary(typeName, interfaceName: interfaceName)
	end 'constraintArgumentHasNoTable'

	// The table a VALUE's witness is taken from — `perInstance` when the value is typed at a generic instance,
	// `shared` otherwise. The one place a value's own type column becomes a table request, so the existential
	// widening door and the constraint door cannot come to read a receiver differently.
	function witnessInstanceOfValue(value ValueId) returns WitnessTableInstance
		if self.valueTagOf(value) != ValueTypeTag.genericInstance 'namesNoInstance'
			return WitnessTableInstance.shared
		end 'namesNoInstance'

		return WitnessTableInstance.perInstance(try self.valueNameIds.get(value) otherwise panic("witnessInstanceOfValue: generic-instance value v{value} has no recorded name-id (its GenericInstanceId) — the two type columns are minted in lockstep"))
	end 'witnessInstanceOfValue'

	// ⭐ **THE TABLE REQUEST FOR ONE `where` CONSTRAINT'S SUBSTITUTED ARGUMENT** — the door
	// `materializeWitnessArg` and the adapter's own constraint walk both come through, so a constraint
	// discharged at a call site and the same constraint discharged inside an adapter name one table.
	//
	// ⚠ **THE REDUCTION ITSELF IS `ProgramSignatures.conformerTypeArgInstance`'s, and it has to be**: a stored
	// argument's ids are the SIGNATURE index's, not the project's, so resolving a declared name here would
	// read the wrong interner. See there for the alias spelling this used to answer `shared` for and for the
	// legal program that refused.
	function constraintArgumentInstance(gid GenericInstanceId, position TypeParamPosition) returns WitnessTableInstance
		if let instance = try self.signatures.conformerTypeArgInstance(gid, position: position) 'namesAnInstance'
			return WitnessTableInstance.perInstance(instance)
		end 'namesAnInstance'

		return WitnessTableInstance.shared
	end 'constraintArgumentInstance'

	// And from a declared NAME — the door a held associated position's BINDING comes through, which is a
	// rendered name rather than a type. Its two arms are `ProgramSignatures.instanceOfDeclaredName`'s, asked
	// there so this file holds no second opinion about which spellings name an instance.
	function witnessInstanceOfDeclaredName(name ByteArray) returns WitnessTableInstance
		if let instance = try self.signatures.instanceOfDeclaredName(name) 'namesAnInstance'
			return WitnessTableInstance.perInstance(instance)
		end 'namesAnInstance'

		return WitnessTableInstance.shared
	end 'witnessInstanceOfDeclaredName'

	// ⭐⭐ **WHAT A WITNESS SLOT ACTUALLY POINTS AT — the impl, or an ABI ADAPTER over it (WASM3).**
	//
	// A `witnessCall` passes exactly what the REQUIREMENT declares: a receiver plus one argument per formal
	// (`witnessFormalTypes`). An impl reached through that slot may declare MORE, because dictionary-passing
	// gives a generic method hidden trailing parameters the caller normally supplies from what it statically
	// knows — the enclosing instance's LAYOUT DESCRIPTOR (P1.6-B1) and one WITNESS TABLE per `where`
	// constraint (P1.7a slice 2a). A witness dispatch knows neither: it holds a table address and a slot
	// index, and the number of hidden parameters varies per conformer, so the arity cannot be folded into the
	// call site. An ADAPTER can bridge it, because the arity is fixed once the table is: it is a real function
	// of the requirement's own shape, and the slot points at it instead of at the impl.
	//
	// ⚠ What the adapter PASSES for those parameters is a null dictionary, and why that is the only available
	// answer — and what makes it sound — is `appendWitnessAdapterDictionary`'s to state, not this one's.
	//
	// ⚠ **WITHOUT IT THE SLOT HELD A FUNCTION OF THE WRONG ARITY, AND x64 ANSWERED CORRECTLY BY ACCIDENT.**
	// The impl read its hidden parameters out of whatever the ABI registers happened to hold; the two impls
	// the corpus reaches this way (`Array.hash`/`Array.equals`, whose conditional conformance
	// `where Element is Hashable and Equatable` reserves two witnesses unconditionally, and
	// `UpCursor.current`, whose `returns Element` reserves a descriptor) never READ them, so nothing showed.
	// MEASURED on wasm, where `call_indirect` checks the declared functype against the target's own:
	// `wasm trap: indirect call type mismatch` in `Map.insert` and in `total`, on two programs x64 runs
	// correctly. A body that DID read one would have been a wild dispatch on every target.
	//
	// ⭐ **AN IMPL WHOSE ABI ALREADY IS THE SLOT'S GETS NO ADAPTER**, which is almost all of them — the extra
	// call and the extra symbol are paid only where the shapes genuinely differ, so no existing dispatch and
	// no existing golden moves for a conformer that never needed one. This is `maxon-selfhosted`'s
	// `__witness_thunk_<instance>_<iface>_<method>` (`Passes/BuildWitnessTables.maxon:258`,
	// `LowerMaxonToStd.synthesizeOneWitnessThunk`) with that one difference: v1 routes EVERY per-instance slot
	// through a thunk, which costs a call on every generic dispatch in the program.
	//
	// A COMPILER-SYNTHESIZED impl (`int.hash`, an `__` runtime entry) is in no signature registry and is built
	// to the requirement's shape by construction — it has no `where` clause and no type parameter to describe
	// — so it is returned unchanged rather than measured against a signature that does not exist.
	function witnessSlotCallee(typeName ByteArray, instance WitnessTableInstance, slot CollectedInterfaceMethod) returns ByteArray
		let implName = self.witnessSlotImpl(typeName, interfaceName: slot.sourceInterfaceName, method: slot.method)
		if self.witnessSlotImplIsSlotShaped(implName, method: slot.method) 'theImplNeedsNoAdapter'
			return implName
		end 'theImplNeedsNoAdapter'

		// ⭐ **THE ADAPTER IS NAMED OFF THE TABLE'S OWN LABEL COMPONENT, NEVER OFF THE CONFORMER (G19)** —
		// two instances of one generic conformer share the impl and must NOT share the adapter, because the
		// adapter is exactly where the two dictionaries differ. A shared table's component IS the conformer,
		// so no existing adapter's symbol moves.
		let adapterName = witnessSlotAdapterSymbol(self.witnessTableLabelComponent(typeName, instance: instance), interfaceName: slot.sourceInterfaceName, methodName: slot.method.name)
		if self.emittedWitnessAdapters.contains(adapterName) 'anotherTableAlreadyRequestedIt'
			return adapterName
		end 'anotherTableAlreadyRequestedIt'

		self.emittedWitnessAdapters.insert(adapterName)
		self.pendingWitnessAdapters.push(WitnessAdapterRequest.create(typeName, implName: implName, adapterName: adapterName, slotArity: self.witnessSlotAbiArity(slot.method), instance: instance))
		return adapterName
	end 'witnessSlotCallee'

	// ⭐ **THE ARITY OF ONE WITNESS SLOT'S ABI** — a receiver, then one argument per declared formal. It is
	// the COUNT of the list `witnessFormalTypes` builds, stated here because the adapter side needs the number
	// without a receiver value to build that list from; `witnessFormalTypes` asserts its own list against it,
	// so the two cannot drift into an adapter of the wrong arity.
	//
	// ⚠ **A `static` REQUIREMENT HAS NO RECEIVER, AND ITS SLOT IS THE ONE PLACE THAT SHOWS.** A static impl
	// takes exactly its declared formals (`Point.tag()` is a 0-parameter function), so counting a receiver
	// here made its slot look one argument WIDER than the impl and demanded an adapter for a shape that
	// already matched — MEASURED, four cases across `interface-conformance` and `where-clauses`. Nothing ever
	// DISPATCHES through such a slot (`SemanticCheck` refuses that with E3116), which is why
	// `witnessFormalTypes` can seed a receiver unconditionally and still agree with this: it is asked only
	// about the requirements a dispatch reached.
	function witnessSlotAbiArity(method InterfaceMethodSig) returns ParamCount
		return method.paramTypeNames.count() if method.isStatic else 1 + method.paramTypeNames.count()
	end 'witnessSlotAbiArity'

	// ⭐⭐ **ONE MAXON OP, AS A REFERENCE THIS FRAME OWNS RATHER THAN A BORROW OF THE MODULE.** An op read
	// out of `self.maxonModule.ops` and BOUND is a borrow of the module for as long as the binding lives
	// (E3070), and `lowerOp`/`lowerTerminator` are methods that write this lowering's storage — so the
	// binding cannot span the call, however plainly this pass never writes its SOURCE module. Returning the
	// op takes a reference instead: shv2's return convention promotes a borrowed managed value to an owned
	// one (`Parser.emitOwnedValueReturn` — *"a borrowed struct/union/instance INCREFS"*), which is the
	// language's answer to "I need to hold this element", and costs one incref/decref per lowered op.
	function maxonOpAt(opIdx OpIndex) returns MaxonOp
		return try self.maxonModule.ops.get(opIdx) otherwise panic("maxonOpAt: op {opIdx} is not in maxonModule.ops")
	end 'maxonOpAt'

	// ⭐ **ONE MAXON OP REF, READ AFRESH.** `lowerMaxonToStd`'s block walk may not hold its source block
	// across the op loop (see there), so the per-op ref comes back through the module each time: an indexed
	// load for the block and one for the ref. It is a method rather than an inlined pair of `get`s so the
	// two panics that describe the invariant are written once.
	function maxonBlockOpRefAt(blockRef BlockRef, pos ElementCount) returns OpIndex
		let block = try self.maxonModule.blocks.get(blockRef) otherwise panic("maxonBlockOpRefAt: blockRef {blockRef} is not in maxonModule.blocks")
		return try block.opRefs.get(pos) otherwise panic("maxonBlockOpRefAt: opRefs.get OOB at {pos} in block {blockRef}")
	end 'maxonBlockOpRefAt'

	// Build the bodies of every requested witness-slot adapter, after the function walk (see
	// `WitnessAdapterRequest`). An adapter's own dictionary may request a further table, whose slots may
	// request further adapters, so the list is drained by INDEX over a growing array rather than by `for..in`.
	function installWitnessSlotAdapters(project Project)
		var next = 0 as ElementCount
		while next < self.pendingWitnessAdapters.count() 'drain'
			// ⚠⚠ **THE REQUEST IS COPIED OUT, AND THIS IS THE ONE SITE WHERE THAT IS NOT MERELY THE BORROW
			// RULE BEING SATISFIED — IT IS THE HAZARD THE RULE EXISTS FOR.** `synthesizeWitnessSlotAdapter`
			// APPENDS to `pendingWitnessAdapters` (an adapter's own dictionary may request a further table,
			// which is why this loop drains by index over a growing array in the first place), so the element
			// borrow `get` hands back is taken out of an array that then grows underneath it. E3070 refused
			// it; a `clone()` is what makes the request this frame's own for the length of the call.
			let request = (try self.pendingWitnessAdapters.get(next) otherwise panic("installWitnessSlotAdapters: pendingWitnessAdapters.get OOB at {next} below count {self.pendingWitnessAdapters.count()}")).clone()
			next = next + 1
			self.synthesizeWitnessSlotAdapter(request, project: project)
		end 'drain'
	end 'installWitnessSlotAdapters'

	// Emit ONE adapter: `__adapt___witness_<Type>.<Iface>.<method>(slot args…)` → the impl, called with those
	// same arguments plus the conformer's dictionary. Its declared parameter types are the impl's OWN first
	// `slotArity` types, so the forwarding is a straight copy and the adapter's register/valtype classes are
	// the impl's by construction rather than by a second derivation of the requirement's formals.
	//
	// The return side is forwarded WHOLE: `maxonReturnType` and `throwsTypeName` are copied from the impl, so
	// `functionUsesSecondaryReturnSlot` answers the same for both and the adapter declares exactly the result
	// words the impl produces — the error flag of a throwing requirement among them, which a dropped second
	// word would turn into a `for` loop that never terminates.
	function synthesizeWitnessSlotAdapter(request WitnessAdapterRequest, project Project)
		let impl = try self.funcNames.funcNamed(request.implName) otherwise panic("synthesizeWitnessSlotAdapter: '{String.from(request.implName)}' is in no function of this module — `witnessSlotCallee` resolved it there one phase earlier")

		var paramTypes = StdTypeArray.create()
		for k in 0 upto request.slotArity 'eachSlotParam'
			paramTypes.push(try impl.paramTypes.get(k) otherwise panic("synthesizeWitnessSlotAdapter: '{String.from(request.implName)}' declares {impl.paramTypes.count()} Std parameter types but its slot passes {request.slotArity} — a witness slot's arity can only be SHORTER than its impl's"))
		end 'eachSlotParam'

		var adapter = IrFunction.createFromStd(request.adapterName, returnType: impl.returnType, paramCount: request.slotArity, paramTypes: paramTypes, returnLine: 0, throwsTypeName: impl.throwsTypeName)
		adapter.maxonReturnType = impl.maxonReturnType
		var entry = self.stdModule.addBlock(adapter, label: b"entry")
		emitTypedParams(self.stdModule, block: entry, paramTypes: paramTypes)

		var args = ValueIdArray.create()
		for k in 0 upto request.slotArity 'eachForwardedArg'
			args.push(k as ValueId)
		end 'eachForwardedArg'
		self.appendWitnessAdapterDictionary(args, request: request, impl: impl, entry: entry, project: project)

		// Every id below `args.count()` is a parameter or a dictionary address, so the call's own result is
		// the next one — and the error flag, when the impl produces one, the one after that.
		let resultId = args.count()
		if functionUsesSecondaryReturnSlot(impl.maxonReturnType, throws: impl.throwsTypeName) 'aSecondReturnWord'
			let errorFlagId = (resultId + 1) as ValueId
			self.stdModule.appendOp(entry, op: StdOp.tryCall(resultId, errorFlagId: errorFlagId, callee: request.implName, args: args))
			self.stdModule.setTerminator(entry, op: StdOp.errorReturn(resultId, errorFlagId: errorFlagId))
		end 'aSecondReturnWord' else 'oneReturnWord'
			self.stdModule.appendOp(entry, op: StdOp.call(resultId, callee: request.implName, args: args))
			self.stdModule.setTerminator(entry, op: StdOp.retVoid if stdReturnTypeIsVoid(impl.returnType) else StdOp.ret(resultId))
		end 'oneReturnWord'

		self.stdModule.functions.push(adapter)
	end 'synthesizeWitnessSlotAdapter'

	// ⭐⭐ **WHERE A WITNESS SLOT'S DICTIONARY COMES FROM — THE TABLE'S OWN INSTANCE, OR NOWHERE (WASM3, G19).**
	//
	// A hidden dictionary parameter describes the conformer's TYPE ARGUMENT: the layout descriptor of the
	// instance (P1.6-B1), the fixed element count (W190) and one witness table per `where` constraint (P1.7a
	// slice 2a). Which of the two answers applies is decided ONCE, at the table (`witnessTableInstanceFor`),
	// and travels on the request — never re-derived here, because the LABEL the slot was stamped with is what
	// the caller jumped through and a second opinion about it is a wrong dictionary with no diagnostic.
	//
	//   • a **SHARED** table has no type argument to describe, because shv2 keys a generic conformer's table
	//     by its BASE name: `Array with Int` and `Array with String` both reduce to the one conformer `Array`
	//     and share `__witness_Array.Hashable` (`ProgramSignatures.conformerNameOfType`, whose header states
	//     the rule and the reason — *"the impls it names are ELEMENT-INDEPENDENT"*). There is no per-instance
	//     value to pass, and a zero is not a guess but the only consistent answer —
	//     `requireWitnessSlotImplIgnoresDictionary` then PROVES the impl reads none of it, which is the
	//     sentence that reduction already rests on, enforced.
	//   • a **PER-INSTANCE** table names exactly one instantiation, so every word is a compile-time constant
	//     of it, and the proof is unnecessary because the values are real.
	//
	// Before adapters existed the same parameters read whatever the ABI registers held — the identical
	// unsoundness, with no check and no diagnostic.
	//
	// ⛔ **THE OTHER TWO HIDDEN BLOCKS ARE NOT NULLABLE ON EITHER PATH, AND THE PANIC SAYS SO RATHER THAN
	// GUESSING.** A `function`-typed parameter carries a companion ENVIRONMENT and an interface-typed one
	// carries a WITNESS half; both are facts about the ARGUMENT, which only the caller has, and both are READ.
	// A requirement declaring such a formal has no ABI a witness dispatch can satisfy — the call site passes
	// one word where the impl reads two — and it was already broken before an adapter existed, silently.
	function appendWitnessAdapterDictionary(args ValueIdArray, request WitnessAdapterRequest, impl IrFunction, entry IrBlock, project Project)
		let sig = try self.funcSignatures.get(request.implName) otherwise panic("appendWitnessAdapterDictionary: '{String.from(request.implName)}' has no signature — `witnessSlotCallee` returned the impl unchanged for exactly that case")
		let companionCount = countParamsWithTag(sig.paramTypes, tag: ValueTypeTag.function) + countParamsWithTag(sig.paramTypes, tag: ValueTypeTag.interfaceRef)
		if companionCount > 0 'aPerArgumentCompanion'
			panic("appendWitnessAdapterDictionary: witness slot impl '{String.from(request.implName)}' declares a `function`- or interface-typed parameter, whose hidden companion word is a fact about the ARGUMENT — a witness dispatch passes one word per formal and cannot supply it")
		end 'aPerArgumentCompanion'

		match request.instance 'table'
			shared then self.appendNullAdapterDictionary(args, request: request, impl: impl, entry: entry, project: project)
			perInstance(gid) then self.appendInstanceAdapterDictionary(args, request: request, impl: impl, entry: entry, gid: gid, sig: sig)
		end 'table'
	end 'appendWitnessAdapterDictionary'

	// One zero per hidden parameter, so the adapter's call has exactly the impl's declared arity. The ids
	// continue the adapter's own dense space, which is why they are minted from the running count rather
	// than through `mintStdValueId` (that counter belongs to the function being LOWERED, and a foreign id
	// would leave the backend declaring locals up to it).
	function appendNullAdapterDictionary(args ValueIdArray, request WitnessAdapterRequest, impl IrFunction, entry IrBlock, project Project)
		self.requireWitnessSlotImplIgnoresDictionary(request, impl: impl, project: project)

		for _ in request.slotArity upto impl.paramCount 'eachHiddenParam'
			let zeroId = args.count()
			self.stdModule.appendOp(entry, op: StdOp.const(zeroId, value: 0, valueType: StdType.i64))
			args.push(zeroId)
		end 'eachHiddenParam'
	end 'appendNullAdapterDictionary'

	// ⭐⭐ **THE REAL DICTIONARY, BUILT FROM THE INSTANCE THE TABLE IS FOR (G19).** This is the mechanism
	// `maxon-selfhosted` calls a witness THUNK (`Passes/BuildWitnessTables.emitPerInstanceWitnessTables` +
	// `LowerMaxonToStd.synthesizeOneWitnessThunk`), reached through shv2's existing ADAPTER rather than
	// through a second synthesis path — the adapter already exists, already forwards the slot's arguments and
	// already carries the impl's return shape, and the only thing v1's thunk does that it did not is fill
	// these words.
	//
	// ⚠ **TWO DELIBERATE DIVERGENCES FROM v1, both about cost:**
	//   • v1 routes EVERY per-instance slot through a thunk, which pays a call on every generic witness
	//     dispatch in the program. Here a slot whose impl already IS the slot's shape keeps pointing straight
	//     at the impl (`witnessSlotImplIsSlotShaped`), so the extra call is paid only where a dictionary has
	//     to be built.
	//   • v1 EMITS one table per (gid × conformance) up front, for every interned instance. shv2 mints on
	//     demand from a call site that holds the instance, so an instantiation nothing widens costs nothing.
	//
	// ⚠ **THE ORDER IS THE ABI's — `[layout][count][witness_0..k]`, read back from the END by
	// `bindImplicitParams`** — and each block's PRESENCE is asked of the same predicate the call-site
	// appender asks (`layoutNeedingFuncs`, `fixedElementCountParamCountFor`, `witnessConstraintsOfMethod`),
	// so an adapter and a direct call to one impl cannot disagree about its parameter list. The arity check
	// at the end is the two copies of that number meeting.
	function appendInstanceAdapterDictionary(args ValueIdArray, request WitnessAdapterRequest, impl IrFunction, entry IrBlock, gid GenericInstanceId, sig FuncSignature)
		if self.layoutNeedingFuncs.contains(request.implName) 'aLayoutDescriptor'
			let descId = args.count()
			self.stdModule.appendOp(entry, op: StdOp.rdataAddr(descId, label: self.ensureLayoutDescriptor(gid).toByteArray()))
			args.push(descId)
		end 'aLayoutDescriptor'

		if self.fixedElementCountParamCountFor(request.implName) != 0 'aFixedElementCount'
			// A per-instance table is only minted for a CONCRETE instance, and a concrete instance states its
			// own count — `Vector with 4 Element` says 4 — so unlike the value door there is no caller slot to
			// fall back on and a silent instance is an internal break.
			if not self.signatures.valueStatesItsOwnElementCount(ValueTypeTag.genericInstance, nameId: gid) 'statesNoCount'
				panic("appendInstanceAdapterDictionary: '{String.from(request.implName)}' reads a fixed element count and the per-instance table for '{String.from(self.signatures.mangleGenericInstance(gid))}' states none — a table is keyed by an instance only when `instanceIsFullyConcrete` accepted it, and a concrete instance states its own count")
			end 'statesNoCount'

			let countId = args.count()
			self.stdModule.appendOp(entry, op: StdOp.const(countId, value: self.signatures.genericInstanceFixedSize(gid), valueType: StdType.i64))
			args.push(countId)
		end 'aFixedElementCount'

		let constraints = self.signatures.witnessConstraintsOfMethod(request.implName, extensionConstraints: sig.extensionConstraints)
		for i in 0 upto constraints.count() 'eachConstraint'
			let constraint = try constraints.get(i) otherwise panic("appendInstanceAdapterDictionary: whereConstraints.get OOB at {i} for '{String.from(request.implName)}'")
			let witnessId = args.count()
			self.stdModule.appendOp(entry, op: StdOp.rdataAddr(witnessId, label: self.instanceConstraintWitnessLabel(gid, constraint: constraint, implName: request.implName).toByteArray()))
			args.push(witnessId)
		end 'eachConstraint'

		if args.count() != impl.paramCount 'theTwoParameterListsDisagree'
			panic("appendInstanceAdapterDictionary: the adapter for '{String.from(request.implName)}' built {args.count()} argument(s) and the impl declares {impl.paramCount} — the three hidden blocks are asked of the same predicates the call-site appender uses, so a difference means one of them answers differently for an adapter than for a direct call")
		end 'theTwoParameterListsDisagree'
	end 'appendInstanceAdapterDictionary'

	// The witness table one `where` constraint of `gid`'s BASE resolves to at this instantiation — the
	// `concrete` arm of `materializeWitnessArg`, asked of an instance rather than of a receiver value, and
	// through the SAME two reducers (`conformerTypeArgName` for the label's conformer,
	// `constraintArgumentInstance` for whether that conformer's own table is per-instance) so a constraint
	// discharged at a call site and the same constraint discharged inside an adapter name one table.
	//
	// ⚠ **AN OPAQUE ARGUMENT CANNOT ARRIVE HERE, AND THE PANIC IS THE GUARD RATHER THAN A HOPE.** The
	// call-site door FORWARDS the caller's own slot for one (`forwardOpaqueParamWitness`); an adapter has no
	// caller and no slot, which is exactly why `witnessTableInstanceFor` refuses to key a table by a
	// non-concrete instance in the first place.
	function instanceConstraintWitnessLabel(gid GenericInstanceId, constraint WhereConstraint, implName ByteArray) returns String
		let typeArg = self.signatures.substitutedInstanceArg(gid, position: constraint.typeParamIndex)
		if maxonTypeTag(typeArg) == ValueTypeTag.typeParameter 'stillOpaque'
			panic("instanceConstraintWitnessLabel: the per-instance table for '{String.from(self.signatures.mangleGenericInstance(gid))}' owes '{String.from(implName)}' a witness for `{String.from(constraint.interfaceName)}` at type-parameter position {constraint.typeParamIndex}, and that argument is still opaque — `instanceIsFullyConcrete` gates exactly this")
		end 'stillOpaque'

		return self.ensureWitnessTable(self.signatures.conformerTypeArgName(gid, position: constraint.typeParamIndex).toByteArray(), instance: self.constraintArgumentInstance(gid, position: constraint.typeParamIndex), interfaceName: constraint.interfaceName)
	end 'instanceConstraintWitnessLabel'

	// ⭐⭐ **PROVE THE IMPL NEVER READS THE NULL DICTIONARY — the premise the base-keyed conformer name rests
	// on, asked of the one impl that is about to be handed a null one (WASM3).**
	//
	// The test is USE, not read-of-a-particular-kind: a hidden parameter that is dispatched through, forwarded
	// to another dictionary-passing callee, or merely stored is equally a value the adapter cannot supply.
	// It runs over the impl's LOWERED body — adapters are built after the function walk, so every hidden
	// parameter's uses are already Std ops — through `liveOpIndices`, never the flat array, which retains the
	// orphans of every earlier pass.
	//
	// The hidden block is the tail `[slotArity, paramCount)`: the ABI is `[user][env][existential][layout]
	// [count][witness]`, and `appendWitnessAdapterDictionary` has already refused the two middle blocks, so what
	// remains past the slot's own arguments is exactly the descriptor, the fixed-element count and the
	// witnesses.
	//
	// ⭐ **IT IS WIDTH-AGNOSTIC, WHICH IS WHY W190's NEW SLOT NEEDED NOTHING HERE — verified at review by
	// MEASUREMENT, not by reading.** An `extension Vector implements Sizer` whose `capacity()` reads
	// `countof(Self)` is refused with this diagnostic, and so is one that merely CALLS a sibling that does
	// (the forward is a USE of the slot like any other). So a `countof`-reading body cannot be reached
	// through a witness table at all, which is the right answer: one table serves every instantiation and
	// there is no instantiation to take the count from.
	function requireWitnessSlotImplIgnoresDictionary(request WitnessAdapterRequest, impl IrFunction, project Project)
		let referenced = self.loweredValueUses(impl)

		for hidden in request.slotArity upto impl.paramCount 'eachHiddenParam'
			if referenced.contains(hidden) 'theBodyReadsIt'
				reportPositioned(project, code: ErrorCode.semanticSharedConformanceReadsDictionary, message: "'{String.from(request.implName)}' satisfies a requirement of `{String.from(request.conformerType)}` and reads the hidden dictionary parameter its generic declaration reserves (its type parameter's layout descriptor, or a `where` constraint's witness table). A conforming generic type shares ONE witness table across every instantiation, so a dispatch through that table has no instantiation to take the dictionary from — the impls it holds must be independent of the type argument", line: impl.nameLine, column: impl.nameColumn, filePath: impl.sourceFilePath)
				return
			end 'theBodyReadsIt'
		end 'eachHiddenParam'
	end 'requireWitnessSlotImplIgnoresDictionary'

	// The value ids `func`'s LOWERED body reads — the one walk behind both hidden-block proofs (the null
	// dictionary a shared table's adapter passes, and the null witness a parametric constraint argument
	// passes). It goes through `liveOpIndices`, never the flat array, which retains the orphans of every
	// earlier pass, and through `collectStdOpUses`, which is exhaustive over `StdOp` in ONE place — so a new
	// op variant is a compile error there rather than a use silently missed at either proof.
	function loweredValueUses(func IrFunction) returns StdValueUseSet
		var referenced = StdValueUseSet.create()
		for opIdx in self.stdModule.liveOpIndices(func) 'eachOp'
			collectStdOpUses(try self.stdModule.ops.get(opIdx) otherwise panic("loweredValueUses: opIdx {opIdx} from liveOpIndices is not in stdModule.ops"), referenced: referenced)
		end 'eachOp'
		return referenced
	end 'loweredValueUses'

	// ⭐⭐ **SETTLE EVERY ZERO A PARAMETRIC CONSTRAINT ARGUMENT PASSED (BATCH43)** — drained after the function
	// walk, because the proof reads the CALLEE's lowered body and the caller may have been lowered first.
	//
	// It runs BEFORE `installWitnessSlotAdapters` rather than after, and that ordering is the reason the drain
	// is a plain walk rather than the growing-index one its sibling needs: nothing appended to this list can
	// arrive later, because an adapter sources its dictionary from the INSTANCE
	// (`instanceConstraintWitnessLabel`) and never through `materializeWitnessArg`.
	//
	// ⚠ **EACH REQUEST RE-WALKS ITS CALLEE'S BODY, AND THE BOUND IS WHY THAT IS NOT A CURVE.** The list holds
	// one entry per CALL SITE that builds a constrained instance whose argument is itself parametric — a
	// shared generic body constructing another generic type over its own parameters. The whole stdlib plus
	// the spec corpus contains exactly ONE (`Iterable.withIterator` → `WithIterIterator.create`), so a memo
	// keyed by callee would be a second structure bought to serve a single lookup. If a program ever holds
	// enough of these for the walk to show, the fix is that memo and not a narrower proof.
	function installParametricWitnessChecks(project Project)
		for request in self.pendingNullWitnessArgs 'eachRequest'
			self.requireCalleeIgnoresParametricWitness(request, project: project)
		end 'eachRequest'
	end 'installParametricWitnessChecks'

	// ⭐⭐ **THE PROOF THE ZERO RESTS ON: the callee never READS the witness parameter it landed in.**
	// `requireWitnessSlotImplIgnoresDictionary`'s argument, one mechanism up — and the same test, USE rather
	// than read-of-a-particular-kind. A witness that is dispatched through, FORWARDED to another
	// dictionary-passing callee, or merely stored is equally a value this call cannot supply, and all three
	// are uses of the parameter.
	//
	// ⚠ **THE PARAMETER IS FOUND THROUGH `witnessParamCountForCallee`, THE SAME DOOR THE CALL SITE SIZED ITS
	// HIDDEN BLOCK WITH** — the witness parameters are the FINAL `witnessCount` of the callee's list
	// (`bindImplicitParams`), so slot `i` is `paramCount - witnessCount + i`. Asked of the one rule both sides
	// of the ABI already read, so the parameter this proves clean is the parameter the zero reached.
	//
	// The blame is the CALLING function's declaration: it is the call the author must change, and the callee
	// — `WithIterIterator.create` in the corpus — is usually a library's.
	function requireCalleeIgnoresParametricWitness(request NullWitnessArgRequest, project Project)
		// ⚠ **A CALLEE THE WALK SKIPPED HAS NO BODY, AND AN EMPTY USE SET WOULD PASS THIS PROOF VACUOUSLY.**
		// It cannot happen — a reachable caller materialized this argument, and `requireUnreachableStdlibStayedDead`
		// refuses a compile where DFE keeps a function the Maxon-tier walk called dead — so the silent hole is
		// worth a panic rather than a comment.
		if self.unreachableStdlib.contains(request.callee) 'calleeHasNoLoweredBody'
			panic("requireCalleeIgnoresParametricWitness: '{String.from(request.callee)}' was skipped by the function walk as unreachable stdlib, so its lowered body proves nothing — yet '{String.from(request.caller)}' materialized a witness argument for it")
		end 'calleeHasNoLoweredBody'

		let callee = try self.funcNames.funcNamed(request.callee) otherwise panic("requireCalleeIgnoresParametricWitness: '{String.from(request.callee)}' is in no function of this module — `materializeWitnessArg` recorded a call the lowering had already resolved")
		let sig = try self.funcSignatures.get(request.callee) otherwise panic("requireCalleeIgnoresParametricWitness: '{String.from(request.callee)}' has no signature — a witness argument is appended only for a callee whose signature sized the hidden block")
		let witnessCount = self.witnessParamCountForCallee(request.callee, sig: sig)
		if request.constraintIndex >= witnessCount 'noSuchSlot'
			panic("requireCalleeIgnoresParametricWitness: '{String.from(request.callee)}' carries {witnessCount} witness parameter(s) and a call passed one for constraint {request.constraintIndex} — `appendWitnessArgs` walks the very list this count is of")
		end 'noSuchSlot'

		if not self.loweredValueUses(callee).contains((callee.paramCount - witnessCount + request.constraintIndex) as ValueId) 'theCalleeNeverReadsIt'
			return
		end 'theCalleeNeverReadsIt'

		let caller = try self.funcNames.funcNamed(request.caller) otherwise panic("requireCalleeIgnoresParametricWitness: '{String.from(request.caller)}' is in no function of this module — it is the function whose body this pass was lowering when the zero was recorded")
		reportPositioned(project, code: ErrorCode.semanticParametricConstraintWitnessRead, message: "'{String.from(request.caller)}' calls '{String.from(request.callee)}', whose `where` constraint requires a witness table for `{String.from(request.conformerType)}` conforming to `{String.from(request.interfaceName)}` at a generic instance written over this body's OWN type parameters — and '{String.from(request.callee)}' READS that witness. A conformance whose impls carry a hidden dictionary is given a table PER INSTANCE, whose slots supply that instantiation's layout descriptor; an instance that is still parametric names a descriptor the enclosing frame only holds at run time, so no static table exists to pass. Reach the constrained method through a concrete instance, or make the conformance's impls independent of their type argument", line: caller.nameLine, column: caller.nameColumn, filePath: caller.sourceFilePath)
	end 'requireCalleeIgnoresParametricWitness'

	// How many slots this table's ASSOCIATED block occupies — the interface's full associated-type count when
	// the program holds any of its positions at an interface, and 0 otherwise.
	//
	// ⇒ a program that never writes an interface as a `with` argument reserves nothing and mints exactly the
	// bytes it always did.
	//
	// ⚠ **THE LOAD SIDE DOES NOT ASK THIS, AND DOES NOT NEED TO.** `Parser.heldAssociatedReturnIn` reaches
	// `witnessAssociatedSlotOffset` only for a position `associatedTypeHeldAt` ANSWERED for, which is exactly
	// the condition that makes this return non-zero — so the block it addresses into is present by the same
	// fact rather than by a second agreement. What the two ends genuinely share is the OFFSET function and its
	// `methodCount` base, which is where a disagreement could still be written and therefore where the
	// arithmetic lives.
	function heldAssociatedSlotCount(interfaceName ByteArray, iface IrInterface) returns ElementCount
		if not self.signatures.interfaceHoldsAnAssociatedType(interfaceName) 'holdsNothing'
			return 0
		end 'holdsNothing'

		return iface.associatedTypeNames.count()
	end 'heldAssociatedSlotCount'

	// ⭐⭐ **THE NESTED TABLE, ONE SLOT PER HELD POSITION.** `createIterator()` hands back a value at the
	// interface `Iter` is held at, and the witness half of that fat pointer cannot ride the call — a witness
	// call carries one machine word per result. It does not have to: THIS conformer's binding for the
	// position is a compile-time fact of THIS conformance, so the table it would be widened through is a
	// compile-time constant and lives here, in the conformer's own table, where a dispatch site that has the
	// receiver's witness can load it.
	//
	// ⚠ **IT IS THE CONFORMER'S OWN BINDING AND NOT THE FOLD'S** (`conformerAssociatedBinding`, not
	// `associatedAbiBindingOf`): a held position is the one place two conformers are ALLOWED to bind
	// differently, which is the whole point — `UpBag` names `__witness_UpCursor.Cursor` here and `DownBag`
	// names `__witness_DownCursor.Cursor`, and a dispatch through either lands in the right one without the
	// call site knowing which.
	//
	// ⚠⚠ **THE BINDING IS REDUCED TO ITS CONFORMER NAME FIRST, EXACTLY AS THIS PASS'S OTHER TWO
	// `ensureWitnessTable` CALLERS DO (W58).** A conformance's `withArgs` are RENDERED names, so a binding to a
	// generic instance arrives as the canonical mint `UpCursor_Integer` — and a table is keyed by the CONFORMER
	// (`materializeWitnessArg` uses `conformerTypeArgName`, `witnessForExistentialValue` uses
	// `conformerNameOfType`; this was the one site reading the raw spelling). Under dictionary-passing that
	// reduction is what makes the table right rather than merely findable: `UpCursor.current` is compiled ONCE
	// over an opaque layout, so one `__witness_UpCursor.Cursor` answers for every instantiation, and it is
	// bit-for-bit the table a DIRECT widening of the same value already mints. Unreduced, the label named
	// `__witness_UpCursor_Integer.Cursor` and `witnessSlotImpl` PANICKED — *"no conformance selected a member
	// for slot 'UpCursor_Integer.Cursor.current'"* — because `checkConformance` files its selections under the
	// declared name, which is `stdlib/Array.maxon`'s `Iterable with (Element, ArrayIter)` shape.
	//
	// A conformance that bound nothing at this position is E3016's to report and stamps nothing: leaving the
	// zero-fill is right, because nothing will read a slot for a position that has no binding to widen.
	function stampAssociatedWitnessSlots(typeName ByteArray, interfaceName ByteArray, label String, methodCount WitnessMethodIndex, associatedCount ElementCount)
		for position in 0 upto associatedCount 'eachAssociatedType'
			if let held = try self.signatures.associatedTypeHeldAt(interfaceName, position: position) 'heldAtAnInterface'
				if let binding = try conformerAssociatedBinding(self.conformances, typeName: typeName, interfaceName: interfaceName, position: position) 'thisConformerBoundIt'
					let conformer = self.signatures.conformerNameOfDeclaredName(binding).toByteArray()
					self.globalData.recordRdataBlobRelativeOffset(self.ensureWitnessTable(conformer, instance: self.witnessInstanceOfDeclaredName(binding), interfaceName: held), rdataLabel: label, offsetInLabel: witnessAssociatedSlotOffset(methodCount, position: position))
				end 'thisConformerBoundIt'
			end 'heldAtAnInterface'
		end 'eachAssociatedType'
	end 'stampAssociatedWitnessSlots'

	// Stamp ONE ownership word of a `.rdata` blob with the `funcAbs64InRdata` reloc the witness method slots
	// take. An EMPTY callee leaves the zero-fill in place, which is the encoding every runtime entry that reads
	// such a word treats as "nothing to do" — an `int`/`bool`/`float` conformer, whose value half is not a
	// pointer at all, and equally a trivial generic type argument.
	//
	// ⚠ **THE SYMBOL IS INSTALLED BECAUSE THIS RELOCATION EXISTS, NOT BECAUSE SOMETHING PREDICTED IT**:
	// `MmRuntime.noteRelocatedFunctionUsage` roots every `.rdata` slot's callee after lowering, so the
	// relocated set and the installed set are one list rather than two that agree. See there for what a
	// pre-pipeline prediction cost when it was tried. It is ONE function rather than a spelling per word
	// because the empty test IS the encoding, and a second copy of it is where one word would come to be
	// stamped on a rule another had already stopped using.
	//
	// ⚠ It serves the WITNESS TABLE's two ownership words and the LAYOUT DESCRIPTOR's two
	// (`destroyFunc@40`, `retainFunc@64`) — which is why it names neither blob. Both pairs are non-zero
	// TOGETHER precisely because each pair's two callees come off one protocol answer and meet the one EMPTY
	// test here; the descriptor's `copyFunc@32` is a fact about an opaque `Array` COLUMN rather than about the
	// type argument, so it keeps its own predicate and does not come through here.
	function stampOwnershipWord(callee ByteArray, label String, offsetInLabel ByteOffset)
		if callee.isEmpty() 'ownsNothing'
			return
		end 'ownsNothing'

		self.globalData.recordFuncAbs64InRdata(callee, rdataLabel: label, offsetInLabel: offsetInLabel)
	end 'stampOwnershipWord'

	// ⭐⭐ **THE SYMBOL A WITNESS SLOT POINTS AT IS THE MEMBER `checkConformance` ACCEPTED — NOT A SECOND JOIN
	// OF THE SAME TWO NAMES (R10).** This site used to mint `qualifiedMethodName(typeName, method.name)` for
	// itself, and it agreed with the conformance check only because BOTH were wrong the same way: the check
	// resolved a requirement by that same bare key, so a type whose matching member was a LATER overload
	// (registered `Type.method#Suffix` under D7) was rejected before it could get here. Fixing the check alone
	// would have turned that loud false reject into a wrong `.text` address in the dictionary — no diagnostic,
	// at runtime. So the decision is made ONCE, by the check, and read here.
	//
	// ⚠ **A MISS IS AN INTERNAL DISAGREEMENT AND PANICS — with ONE legitimate exception, and it is not a
	// fallback.** A BUILTIN conformer (`int`/`float`/`bool`/`String`/`Character`) declares no `implements`, so
	// `checkConformance` never ran for it and there is no selection to be the same value as: its impls are
	// SYNTHESIZED one per `(conformer, method)` by `installBuiltinConformanceRuntime`, which mints them by
	// this very join and cannot overload them. The join IS the registration name there, and the gate is
	// `isIntrinsicBuiltinConformance` — the SAME predicate that decides the conformance and decides which
	// impls are installed, so the three cannot come to disagree about which pairs are builtin. Any other miss
	// means this table is stamping a slot no conformance accepted, which is a pipeline-ordering break rather
	// than anything an author could be told to write differently.
	//
	// ⭐⭐ **AND A PAYLOAD-FREE `enum` IS THE ONE GRANTED CONFORMER WHOSE IMPL IS NOT ITS OWN JOIN
	// (enum-hashable).** Every other row here names `<conformer>.<method>` because that IS the symbol its
	// installer mints; an enum mints none, because its value IS an i64 tag and `int.hash`/`int.equals` already
	// answer for it. `ProgramSignatures.enumConformanceImplName` is that decision's one home — shared with the
	// direct `e.hash()` dispatch, so `Map with (Color, …)` and `Color.red.hash()` cannot reach two bodies.
	function witnessSlotImpl(typeName ByteArray, interfaceName ByteArray, method InterfaceMethodSig) returns ByteArray
		if let selected = try self.witnessSlotImpls.get(witnessSlotImplKey(typeName, interfaceName: interfaceName, methodName: method.name)) 'chosenByConformance'
			return selected
		end 'chosenByConformance'

		let discovered = self.signatures.discoveredConformerOf(typeName)
		if not isIntrinsicBuiltinConformance(typeName, interfaceName: interfaceName, discovered: discovered) 'noSelection'
			panic("witnessSlotImpl: no conformance selected a member for slot '{String.from(typeName)}.{String.from(interfaceName)}.{String.from(method.name)}' — `checkConformance` files one per accepted requirement before the pipeline runs, and lowering is only reached once it accepted every one, so this table is being built for a conformance that was never validated")
		end 'noSelection'

		return match discovered 'discovered'
			payloadFreeEnum gives self.signatures.enumConformanceImplName(typeName, methodName: method.name)
			none to arrayRecord gives qualifiedMethodName(typeName, methodName: method.name)
		end 'discovered'
	end 'witnessSlotImpl'

	// Resolve an interface NAME when building a witness table (P1.7a slice 2a) — through `lookupInterface`,
	// the ONE statement of "builtin first, then the merged registry" that R9 gave this reader and
	// `ConformanceCheck` to share (the two used to spell that rule twice over the same store). What stays
	// local is the MISS: a witness table is only built for a constraint whose interface the parser already
	// resolved, so an unresolved name here is an internal invariant break, not a user error.
	// ⚠ **"same-file" WAS the rule and R8 DELETED IT**: the parser now resolves a constraint's interface
	// against the whole-program declaration index (`lookupInterface` over `signatures.interfaceMap()`), so it
	// resolves an interface declared below its use or in any other file. That widens what reaches here and does
	// NOT weaken the invariant — this store (`project.interfaces`, merged after every file parses) is a superset
	// of what the parse-time index could answer, so a name the parser resolved is necessarily present here.
	function resolveWitnessInterface(interfaceName ByteArray) returns IrInterface
		match lookupInterface(self.interfaces, name: interfaceName) 'resolved'
			found(iface) then return iface
			notFound then panic("resolveWitnessInterface: witness constraint interface '{String.from(interfaceName)}' is neither a builtin nor a declared interface — the parser resolved it at the dispatch site, so it must resolve here")
		end 'resolved'
	end 'resolveWitnessInterface'

	// The layout-descriptor argument a layout-needing call must pass, from the RIGHT source (P1.6-B1 / P1.7
	// slice 3b-i). An INSTANCE method reads it from its RECEIVER (`self` at slotted position 0 — the value of
	// the concrete generic instance). A receiverless STATIC constructor (`IntContainer.create(…)`) has no
	// receiver — its first argument is an ordinary user value — but its RESULT is the concrete instance it
	// builds, and the parser has already retyped that result to `genericInstance(gid)`, so the concrete gid is
	// read off the result. The discriminator is the callee's own parameter list (`__self` at position 0), not
	// the shape of `argIds`, so a static whose first argument happens to be a generic instance is unambiguous.
	function materializeLayoutArgFor(argIds ValueIdArray, sig FuncSignature, result ValueId, callee ByteArray, dstBlock IrBlock) returns ValueId
		if sig.takesReceiver() 'instanceMethod'
			// Read from `argIds` (the ORIGINAL receiver), never from the widened/env-derived `baseArgs`.
			let receiver = try argIds.get(0) otherwise panic("materializeLayoutArgFor: layout-needing instance method '{String.from(callee)}' has no receiver argument — its first parameter is `self`")
			return self.materializeLayoutArg(receiver, callee: callee, dstBlock: dstBlock)
		end 'instanceMethod'
		// ⭐ **A FIELD-DEFAULT HELPER IS THE ONE RECEIVERLESS LAYOUT-NEEDING CALLEE WHOSE DESCRIPTOR COMES
		// FROM THE CALLER (W43b).** Its result is the FIELD's type (`Array with Key`), not the enclosing
		// instance, so there is nothing to read a descriptor off — but its only call site is a `Self{…}`
		// inside the declaring type's own body (`requireConstructible`'s E3076), which is a method of that
		// type and therefore holds the descriptor to forward. `Parser.scanDescriptorNeedsInto` gives that
		// method the slot for exactly this reason, so `forwardCallerLayout` always finds one.
		if isFieldDefaultHelperName(callee) 'fieldDefault'
			return self.forwardCallerLayout(callee)
		end 'fieldDefault'
		return self.materializeStaticConstructorLayout(result, callee: callee, dstBlock: dstBlock)
	end 'materializeLayoutArgFor'

	// The descriptor address for a layout-needing STATIC generic constructor (P1.7 slice 3b-i) — the RIP-relative
	// address of its RESULT instance's descriptor blob. The result was retyped to `genericInstance(gid)` by the
	// parser (`retypeGenericAliasConstructorResult`), so the concrete gid — `Container with SmallInt` — is read
	// off the result's name column, exactly as an instance-method receiver's is. A receiverless layout-needing
	// callee is always such a constructor (a static that returns its own instance), so a non-instance result is
	// an internal invariant break.
	function materializeStaticConstructorLayout(result ValueId, callee ByteArray, dstBlock IrBlock) returns ValueId
		// ⭐⭐ **`Self.create()` INSIDE THE GENERIC'S OWN BODY IS THE SECOND RECEIVERLESS SHAPE, AND ITS
		// DESCRIPTOR IS THE CALLER'S — a forward, exactly as the field-default helper's is.** A `Self` call
		// names the type over its own parameters, not a concrete instantiation, so there is no gid to read a
		// blob address off and nothing to read it off: `Parser.scopedGenericInstanceOf` answers `notInScope`
		// for the scope's OWN name deliberately (its header carries the measurement — resolving `Self` to an
		// instance over its own parameters made `Box.make(x)` return a `Box_T…` that stopped satisfying
		// `returns Self`), so the result keeps the base's `structRef` and there is nothing concrete here by
		// construction. The enclosing body is a member of that very generic, so the descriptor it was handed
		// IS this call's — the same reasoning `emitInstanceDescriptorAddr` uses for an instance over the
		// enclosing body's own parameters, one tag over.
		//
		// ⛔⛔ **IT WAS A PANIC, AND SHV2'S OWN SOURCE IS WHERE IT FIRED.** `BlockKeyedTable.forBlockCount`
		// opens with `var table = Self.create()` — the ordinary way a generic's sized constructor reuses its
		// empty one — and lowering it aborted the compile outright: *"layout-needing static callee
		// 'BlockKeyedTable.create' returns a structRef, not a generic instance"*. The invariant the panic
		// asserted was simply not the whole set of receiverless shapes.
		if self.valueTagOf(result) != ValueTypeTag.genericInstance 'notAConcreteInstance'
			return self.forwardCallerLayout(callee)
		end 'notAConcreteInstance'
		return self.emitInstanceDescriptorAddr(result, dstBlock: dstBlock)
	end 'materializeStaticConstructorLayout'

	// The descriptor address for a generic-instance VALUE — the shared core of the two ways a layout-needing
	// call finds its descriptor source, an instance-method RECEIVER and a static-constructor RESULT
	// (P1.6-B1 / P1.7 slice 3b-i). One home so the gid read, the forward/mint decision and the address op
	// cannot drift between the two.
	//
	// ⭐⭐ **A `genericInstance` IS NOT ALWAYS CONCRETE — AN INSTANCE OVER THE ENCLOSING BODY'S OWN
	// PARAMETERS HAS NO BLOB TO POINT AT, AND IT FORWARDS.** `type Holder uses T` whose field is written with
	// the bare name `Cell` holds a `Cell with T` (the bare name binds at the enclosing scope's parameters), so
	// `self.cell.get()` inside `Holder`'s body is a layout-needing call on an instance whose type argument is
	// not a type at all. `ensureLayoutDescriptor` cannot build a blob for it — the blob carries the argument's
	// SIZE, and a type parameter's size IS the descriptor read the blob would have to contain, which is why
	// `primitiveTypeByteSize` panics rather than guessing. The answer the callee needs is already in the
	// caller's hand.
	//
	// ⭐⭐ **AND THE STATIC-CONSTRUCTOR RESULT TAKES THE SAME ARM, WHICH IS WHAT W161 CLOSED.** The forward
	// used to live one door up, on the RECEIVER path alone, so `EChain.create()` inside `type Bag uses Element`
	// — a `typealias EChain = Inner with Element`, a DECLARED generic over the enclosing type's own parameter —
	// reached the mint through `materializeStaticConstructorLayout` and ABORTED THE COMPILER. Nothing about the
	// argument-run reasoning is receiver-specific: both callers hold a value typed at the instance, and both
	// need the caller's own blocks. Splitting the decision by the DOOR the value came through is what made one
	// half work and the other panic.
	//
	// ⚠ **IT FORWARDS A BLOCK ADDRESS, NOT ALWAYS THE DESCRIPTOR'S HEAD.** The callee reads ITS parameter `i`
	// out of block `i` of whatever pointer it is handed, so the forward is sound exactly when the instance's
	// arguments are a CONTIGUOUS, IN-ORDER RUN of the caller's own parameters — `Cell with T` inside
	// `Holder uses T` is the run `[0,1)`, and `Cell with U` inside `Holder uses T, U` is the run `[1,2)`, whose
	// base is block 1. A permutation or a mixed concrete/parameter list has no single base and is not a run:
	// `genericInstanceArgsAreACallerParameterRun` answers no, and such a value keeps today's behaviour of
	// minting, which is right whenever it is genuinely concrete. The blob's own `size@0` describes the CALLER's
	// box rather than the callee's, and that is sound because nothing reads it: the four words a shared body
	// ever loads are `copyFunc@32`, `destroyFunc@40`, `elementLogicalSize@56` and `retainFunc@64`, and every
	// one of them is a fact about the type ARGUMENT, which the run makes identical on both sides.
	//
	// ⛔⛔ **A CALLER THAT CARRIES NO DESCRIPTOR HAS NOTHING TO FORWARD, AND IT KEEPS THE MINT.**
	// `stdlib/Interfaces.maxon`'s `extension Iterable` gives `Map` a `map` whose body walks a
	// `MapIterator with (Key, Value)` — an instance over `Map`'s own parameters — yet `Map.map` reserves
	// nothing: its need comes from a call on ANOTHER type's instance, and the descriptor-need fixpoint follows
	// SELF-calls only (`Parser.solveDescriptorNeeds`), so no edge reaches it. Such a chain keeps what it has
	// always had, a blob minted for the parameterised gid whose every ownership word is 0
	// (`typeParamOwnershipProtocol` answers `none` for a type-parameter argument) — INERT, and inert on BOTH
	// sides, because the retain and the drop read the same zero words. Forwarding a real descriptor into half
	// of such a chain would make the retains fire while the drops still read the mint, which trades an inert
	// pair for an unbalanced one. W161's edge is drawn only from a call whose receiver RESOLVES to such an
	// instance (`Parser.nestedInstanceCalleeAt`), and the emitted cursor calls `Map.map` makes resolve to
	// nothing — so that chain keeps both of its inert ends.
	function emitInstanceDescriptorAddr(instanceValue ValueId, dstBlock IrBlock) returns ValueId
		let gid = try self.valueNameIds.get(instanceValue) otherwise panic("emitInstanceDescriptorAddr: genericInstance value v{instanceValue} has no name-id (its GenericInstanceId) — the two type columns are dense and in lockstep")
		if self.hasImplicitLayout and self.signatures.genericInstanceArgsAreACallerParameterRun(gid) 'forwardsTheCallersOwnRun'
			// The run's base is argument 0's own `uses`-list position; the predicate above proved the rest follow it.
			return self.descriptorBlockAddr(layoutBlockOffsetFor(self.signatures.opaqueTypeParamPosition(self.signatures.substitutedInstanceArg(gid, position: 0))), dstBlock: dstBlock)
		end 'forwardsTheCallersOwnRun'

		let descId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(descId, label: self.ensureLayoutDescriptor(gid).toByteArray()))
		return descId
	end 'emitInstanceDescriptorAddr'

	// The layout-descriptor address to pass for a call whose receiver is `receiver`. A generic instance
	// receiver → its descriptor blob's address, or the caller's own block forwarded when the instance is
	// written over the caller's parameters (`emitInstanceDescriptorAddr` owns that split); a receiver that is
	// the caller's OWN type parameter (a generic body calling another generic method on a `T` value) →
	// FORWARD the caller's own layout slot. B1's acceptance calls come from a non-generic `main` on a
	// concrete instance, so the forward arm is reached only by a generic-to-generic call.
	function materializeLayoutArg(receiver ValueId, callee ByteArray, dstBlock IrBlock) returns ValueId
		let tag = self.valueTagOf(receiver)
		if tag == ValueTypeTag.genericInstance 'instance'
			return self.emitInstanceDescriptorAddr(receiver, dstBlock: dstBlock)
		end 'instance'
		// ⭐ A `structRef`(base) receiver is the enclosing generic body's OWN instance — `self` — so the
		// descriptor to pass is the caller's own, FORWARDED. A `typeParameter` receiver (a value of the caller's
		// `T`) forwards for the same reason. Both are the generic-to-generic threading that lets a shared body
		// drive another. The parser rejects the residual shape (a descriptor call on a non-`self` same-base
		// value) before lowering, so the caller here always carries a layout param.
		if tag == ValueTypeTag.structRef or tag == ValueTypeTag.typeParameter 'forward'
			return self.forwardCallerLayout(callee)
		end 'forward'
		panic("materializeLayoutArg: call to layout-needing '{String.from(callee)}' has a receiver of tag {tag.name} — an instance method's receiver is a concrete generic instance, the enclosing self (structRef), or a type parameter")
	end 'materializeLayoutArg'

	// ⭐⭐ **THE ELEMENT COUNT A COUNT-NEEDING CALL PASSES — A COMPILE-TIME CONSTANT AT EVERY CALL SITE,
	// WHICH IS THE WHOLE REASON THE COUNT IS A PARAMETER AND NOT A DESCRIPTOR WORD (W190).**
	// `materializeLayoutArgFor`'s twin, with the same two doors and the same authority: the CALLEE's own
	// parameter list decides whether the count is read off the RECEIVER's instance or off the static's RESULT
	// instance, so a static whose first argument happens to be a generic instance is unambiguous.
	//
	// ⛔⛔ **AND IT IS CORRECT WHERE THE DESCRIPTOR IS NOT.** `emitInstanceDescriptorAddr` may FORWARD the
	// caller's own blocks when the callee's instance is written over the caller's parameters, which is sound
	// for every word the blob carries because every one of them is a fact about the type ARGUMENT. A COUNT is
	// a fact about the INSTANCE: `Vector with 4 Element` states 4 whatever `Element` turns out to be, and the
	// caller's own blob states `NoFixedSize`. **MEASURED before this was a parameter: a `Vector with 4 Element`
	// field reached from inside `type Holder uses Element` answered 0.** Read here off the instance the call
	// site actually holds, the same shape answers 4 — and it does so without asking that call site for a
	// descriptor at all, which matters because a frame holding such a field is not guaranteed to have one.
	function materializeFixedElementCountArgFor(argIds ValueIdArray, sig FuncSignature, result ValueId, callee ByteArray, dstBlock IrBlock) returns ValueId
		if sig.takesReceiver() 'instanceMethod'
			// The ORIGINAL receiver, never the widened/env-derived `baseArgs` — `materializeLayoutArgFor`'s rule.
			return self.emitFixedElementCountOf(try argIds.get(0) otherwise panic("materializeFixedElementCountArgFor: count-needing instance method '{String.from(callee)}' has no receiver argument — its first parameter is `self`"), callee: callee, dstBlock: dstBlock)
		end 'instanceMethod'
		// ⭐ **A FIELD-DEFAULT HELPER IS THE ONE RECEIVERLESS COUNT-NEEDING CALLEE WHOSE ANSWER COMES FROM THE
		// CALLER, AND READING ITS RESULT WOULD BE A WRONG NUMBER RATHER THAN A MISSING ONE.** Its result is the
		// FIELD's type — which for a `var slot as Vector with 4 Element` STATES 4 — while the count it reads
		// through `countof(Self)` is the ENCLOSING instance's. `materializeLayoutArgFor` splits the same two
		// cases apart for the same reason; its only call site is a `Self{…}` inside the declaring type's own
		// body, which is a method of that type and therefore holds the count to forward.
		if isFieldDefaultHelperName(callee) 'fieldDefault'
			return self.forwardCallerFixedElementCount(callee)
		end 'fieldDefault'
		// A receiverless count-needing callee is a constructor whose RESULT is the instance —
		// `staticLayoutNeedsSelfReturn` refuses every other shape — so the result carries the concrete gid.
		return self.emitFixedElementCountOf(result, callee: callee, dstBlock: dstBlock)
	end 'materializeFixedElementCountArgFor'

	// Forward the CURRENT function's own count slot — `forwardCallerLayout`'s twin, and the single home of
	// the "we owe a count and the only source is our own slot" panic that both of this file's count doors end
	// on when the fixpoint's transitive reservation has failed to reach a caller.
	function forwardCallerFixedElementCount(callee ByteArray) returns ValueId
		if not self.hasImplicitFixedElementCount 'noSlot'
			panic("forwardCallerFixedElementCount: caller '{String.from(self.currentFuncName)}' has no fixed-element-count parameter to forward to '{String.from(callee)}' — the fixpoint's transitive reservation should make this unreachable")
		end 'noSlot'
		return self.implicitCountValueId
	end 'forwardCallerFixedElementCount'

	// The count for ONE value typed at a generic instance: a `const` when the instance STATES its own count,
	// and the caller's own slot forwarded when it does not.
	//
	// ⭐ **THE FORWARD ARM IS NOT AN OPTIMIZATION HERE, IT IS THE ONLY ANSWER.** `Self` inside
	// `type Vector uses Element` is `ownRecordSelfInstance`, interned at `NoFixedSize` so that ONE shared body
	// serves every size — so a `Vector` method calling a sibling on `self` holds an instance that states no
	// count, and the answer it must pass on is the one its own caller handed it.
	function emitFixedElementCountOf(instanceValue ValueId, callee ByteArray, dstBlock IrBlock) returns ValueId
		let tag = self.valueTagOf(instanceValue)
		if tag == ValueTypeTag.genericInstance 'anInstance'
			let gid = try self.valueNameIds.get(instanceValue) otherwise panic("emitFixedElementCountOf: genericInstance value v{instanceValue} has no name-id (its GenericInstanceId) — the two type columns are dense and in lockstep")

			// ⚠ The BRANCH is `valueStatesItsOwnElementCount`'s, not a second reading of the same two clauses:
			// `Parser.requireFixedElementCountSourceForForwarding` refuses on that predicate, and a refusal that
			// disagrees with this branch is either a rejected legal program or this routine's own abort.
			if self.signatures.valueStatesItsOwnElementCount(tag, nameId: gid) 'statesItsOwnCount'
				let countId = self.mintStdValueId()
				self.stdModule.appendOp(dstBlock, op: StdOp.const(countId, value: self.signatures.genericInstanceFixedSize(gid), valueType: StdType.i64))
				return countId
			end 'statesItsOwnCount'
		end 'anInstance'

		return self.forwardCallerFixedElementCount(callee)
	end 'emitFixedElementCountOf'

	// Forward the CURRENT (generic) function's own layout slot to a callee — when a generic body calls another
	// layout-needing method on `self` or on a value of its own type parameter. The caller MUST carry a layout
	// param: the parser's TRANSITIVE reservation gives one to every method that reaches such a call, and the
	// parser rejects the residual shape (a descriptor call on a non-`self` same-base value) before lowering, so
	// a missing slot here is a genuine internal invariant break rather than a user error.
	function forwardCallerLayout(callee ByteArray) returns ValueId
		if not self.hasImplicitLayout 'noSlot'
			panic("forwardCallerLayout: caller '{String.from(self.currentFuncName)}' has no layout descriptor to forward to '{String.from(callee)}' — the parser's transitive reservation and residual-rejection should make this unreachable")
		end 'noSlot'
		return self.implicitLayoutValueId
	end 'forwardCallerLayout'

	// The `.rdata` label of `gid`'s descriptor blob, emitting it on first reference. The blob is PURE DATA —
	// box size, alignment, the T-slot storage width, and the source-level `elementLogicalSize` that
	// `sizeof(T)` reads. Every function-pointer slot is 0 on disk; when `gid` holds an opaque-`T` `Array` or
	// bare field whose SUBSTITUTED argument owns a record (`Container with String`, P1.7 slice 3b-ii), a
	// `funcAbs64InRdata` relocation is recorded so the x64 writer patches `destroyFunc@40` with that
	// argument's destructor `.text` VA — the value the shared opaque `__managed_create` reads back into its
	// record's `element_destroy@40`. An argument owning NO record (a scalar, a ranged alias, a payload-free
	// enum) records nothing and the slot stays 0, so its walk is skipped. Idempotent: a gid referenced at
	// several call sites registers one blob and one reloc and shares the label.
	//
	// ⚠ **THE GATE IS THE ARGUMENT'S OWNERSHIP PROTOCOL, NOT ITS CONSUME CLASS, AND THIS COMMENT SAID
	// "A TRIVIAL ARGUMENT RECORDS NOTHING" WHILE THE CODE MEANT SOMETHING NARROWER (W41-trivial).** An
	// all-scalar STRUCT argument is trivial to CONSUME and is still a refcounted box: it now stamps both
	// `destroyFunc@40` and `retainFunc@64`, which is what makes the reference a container takes releasable.
	// See `ProgramSignatures.managedOpaqueArrayElementOf` for the wrong answer the two words' old, differing
	// gates produced.
	function ensureLayoutDescriptor(gid GenericInstanceId) returns String
		if self.layoutDescriptors.contains(gid) 'cached'
			return self.layoutDescriptors.labelFor(gid)
		end 'cached'

		// ⭐⭐ **`elementLogicalSize` IS A QUESTION ONLY A SINGLE-PARAMETER INSTANCE HAS AN ANSWER TO, AND A
		// MULTI-PARAMETER ONE STILL NEEDS THE REST OF THE DESCRIPTOR.**
		//
		// The slot exists for `sizeof(T)` — one type parameter, one size. `Map with (Key, Value)` has two, so
		// there is no single element to size, and asking used to PANIC (`genericInstanceSoleArgLogicalSize`).
		// That panic made every two-parameter generic holding a container over one of its parameters
		// uncompilable — `type Map uses Key, Value` with `var keys as Array with Key` is exactly that shape,
		// and it is why `stdlib/Map.maxon` could not be instantiated at all.
		//
		// ⚠ **THE OTHER THREE FIELDS ARE STILL MEANINGFUL AND STILL NEEDED**: the box size, the alignment and
		// the type-parameter slot width are per-INSTANCE facts, and the destructor relocation below hangs off
		// this same blob. Refusing to build a descriptor because ONE of its four fields has no answer denied
		// the instance the three that do.
		//
		// ⚠ **WHY WRITING `LAYOUT_NO_SOLE_ELEMENT` HERE IS SOUND RATHER THAN A SENTINEL NOBODY CHECKS**: the
		// only reader of this field is a shared body's `sizeof(T)`, and `parseSizeof` REFUSES `sizeof` of a
		// multi-parameter generic's type parameter with a positioned `E2015` — before any descriptor is asked
		// for. So the field is unreachable for exactly the instances that write it. The guarantee is the
		// refusal, not a convention: delete that refusal and this becomes a wrong answer, which is why the two
		// are named in each other's comments.
		let soleArgLogicalSize = self.signatures.genericInstanceSoleArgLogicalSizeOrNone(gid)
		let descriptor = LayoutDescriptor.create(self.signatures.genericInstanceBoxSize(gid), alignment: LAYOUT_MIN_ALIGNMENT, elementSize: LAYOUT_TYPE_PARAM_SLOT_BYTES, elementLogicalSize: soleArgLogicalSize)
		// ⭐ ONE BLOCK PER TYPE PARAMETER — see `layoutDescriptorBytesFor` for the wild free a single shared
		// `destroyFunc@40` caused on a two-parameter generic. A one-parameter instance emits one block and is
		// byte-identical to what it always emitted.
		let paramCount = self.signatures.genericInstanceArgCount(gid)
		let label = self.globalData.registerRdataConstantLabeled("__layout_{String.from(self.signatures.mangleGenericInstance(gid))}", bytes: encodeLayoutDescriptor(descriptor, typeParamCount: paramCount))
		self.layoutDescriptors.record(gid, label: label)

		// A MANAGED opaque-`T` `Array` field's `destroyFunc@40` is the ONLY compile-time reference to the
		// element destructor — the shared body's `loadIndirect(descriptor, +40)` is a runtime read the usage
		// scan cannot see — so the relocation both fills the slot AND is what the writer resolves the
		// destructor's `.text` VA against.
		//
		// ⭐⭐ **EVERY WORD STAMPED BELOW IS DCE-ROOTED OFF THE RELOCATION THE STAMP ITSELF RECORDS** —
		// `MmRuntime.noteRelocatedFunctionUsage`, which walks `pendingRdataRelocs` after lowering (W17-c). So the
		// rooted set IS the relocated set rather than a prediction of it, and no word can name a `.text` VA that
		// was never installed. Stated ONCE for all three words because it is one fact about the stamp and not
		// three facts about the slots: the pre-pipeline walks that used to predict the drop and clone roots
		// per-instance are deleted, and a predicate here is the sole gate on whether a word is written at all.
		//
		// ⭐ **THE `copyFunc@32` STAMP — the exact CLONE dual (P1.7 slice 3b-vi-b-β).** When the parameter's
		// managed opaque `Array` element is DIRECT-clonable (a String / struct / boxed-union / any container —
		// a managed-element one through its own per-instance one-argument thunk since G18 — i.e. anything a
		// single `(box) -> newBox` cloner can name), a second `funcAbs64InRdata` relocation fills `copyFunc@32`
		// with the element CLONER's `.text` VA, the value the shared opaque-copy wrappers read back and
		// `callIndirect` per element. A TRIVIAL element records nothing (its wrapper takes the byte-blit/COW
		// path), and a MANAGED element nothing can clone at all (an OS handle, a `Vector`, an existential)
		// records nothing either — it is never copied (the front end rejects a base that copies with such an
		// instantiation), so its 0 slot is never read.
		for position in 0 upto paramCount 'eachTypeParam'
			let blockBase = layoutBlockOffsetFor(position)
			// ⭐⭐ **THE `destroyFunc@40` STAMP AND THE `retainFunc@64` STAMP ARE ONE PAIR OF LINES OVER ONE
			// PREDICATE, AND SPLITTING THEM LEAKED (found at review).** Both are `stampOwnershipWord` over a
			// per-argument callee that answers EMPTY when the argument owns no record, so the two words are
			// non-zero together by construction — see `ProgramSignatures.typeParamDropCallee` for the measured
			// exit-101 the old FIELD-shaped drop gate produced beside this ARGUMENT-shaped retain gate.
			self.stampOwnershipWord(self.signatures.typeParamDropCallee(gid, position: position), label: label, offsetInLabel: (blockBase + LAYOUT_OFFSET_DESTROY_FUNC) as ByteOffset)
			if self.signatures.genericInstanceOpaqueArrayElementIsCopyable(gid, position: position) 'copyableOpaqueElement'
				self.globalData.recordFuncAbs64InRdata(self.signatures.managedOpaqueArrayElementCloneCallee(gid, position: position), rdataLabel: label, offsetInLabel: (blockBase + LAYOUT_OFFSET_COPY_FUNC) as ByteOffset)
			end 'copyableOpaqueElement'
			// ⭐⭐ **THE `retainFunc@64` STAMP — how a shared body takes the reference a record it BUILDS owes on
			// a borrowed opaque `T` (W41-opaque).** Its GATE is the argument's own ownership, which the drop
			// word above now shares; only `copyFunc@32` between them is a fact about the instance's opaque
			// `Array` FIELD, because a clone is about that column and not about the argument.
			// `typeParamRetainCallee` answers EMPTY for an argument owning no record and `stampOwnershipWord`
			// then leaves the zero `__retain_type_param` treats as inert.
			self.stampOwnershipWord(self.signatures.typeParamRetainCallee(gid, position: position), label: label, offsetInLabel: (blockBase + LAYOUT_OFFSET_RETAIN_FUNC) as ByteOffset)
		end 'eachTypeParam'

		return label
	end 'ensureLayoutDescriptor'

	// Lower `sizeof(T)` (P1.6-B1) to a runtime read of `elementLogicalSize@56` from the CURRENT function's
	// layout descriptor. The parser folds every CONCRETE sizeof to a literal, so this op only ever carries
	// a typeParameter; and it reserved the descriptor parameter whenever a body reads sizeof(T), so reaching
	// here without one is a pre-scan/op-scan divergence — a loud bug, not a silent wrong load.
	function lowerSizeofType(result ValueId, targetType MaxonType, dstBlock IrBlock)
		if maxonTypeTag(targetType) != ValueTypeTag.typeParameter 'notTypeParam'
			panic("lowerSizeofType: sizeofType carries a {maxonTypeTag(targetType).name} operand — the parser folds every concrete sizeof to a literal, so only the type-parameter case reaches this op")
		end 'notTypeParam'
		if not self.hasImplicitLayout 'noLayout'
			panic("lowerSizeofType: sizeof(T) in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's slot reservation and this lowering's op-scan disagree")
		end 'noLayout'
		self.stdModule.appendOp(dstBlock, op: StdOp.loadIndirect(result, addrId: self.implicitLayoutValueId, offset: LAYOUT_OFFSET_ELEMENT_LOGICAL_SIZE, valueType: StdType.i64))
	end 'lowerSizeofType'

	// Lower a Maxon `call` to `StdOp.call`. The parser recorded the argument SSA values
	// in SOURCE order with their labels; here they are reordered to the callee's
	// declaration order via `slotCallArgs` against the `funcSignatures` registry. Every
	// slotting error (unknown callee, arity, unknown/duplicate label) was already
	// reported by SemanticCheck, which gates the pipeline before lowering — so a miss
	// here is a compiler-invariant violation and panics rather than emitting wrong code.
	// The `argRanges` on the Maxon op are diagnostics-only (consumed by SemanticCheck),
	// so lowering ignores them.
	function lowerCall(result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argDefaultSlots ParamCountArray, dstBlock IrBlock)
		// ⭐ A COMPILER-EMITTED CALL HAS NO SIGNATURE TO SLOT AGAINST, and needs none:
		// `Parser.emitRuntimeCall` wrote its arguments itself, positionally, in declaration order — so
		// the reordering below would be the identity, and the registry lookup it needs first would panic
		// on a callee no file declares. `SemanticCheck.validateCall` skips it for the same reason, keyed
		// on the same predicate (`__print_string`/`__str_eq` are compiler-internal too, not just `__mm_`)
		// — and that predicate asks the registry rather than the PREFIX, because since A1r a `__` callee
		// may be a real declared function whose arguments the source labelled (`isSignaturelessCompilerCallee`).
		if isSignaturelessCompilerCallee(callee, funcSignatures: self.funcSignatures) 'compilerOwnCall'
			self.lowerRuntimeCall(result, callee: callee, args: args, argLabels: argLabels, dstBlock: dstBlock)
			return
		end 'compilerOwnCall'

		let sig = try self.funcSignatures.get(callee) otherwise panic("lowerCall: callee '{String.from(callee)}' has no signature — SemanticCheck must reject an unknown callee before lowering")
		match slotCallArgs(sig.paramNames, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots) 'slot'
			ordered(argIds) then self.appendDirectCall(result, callee: callee, args: self.finalizeCallArgsWithLayout(argIds, sig: sig, callee: callee, result: result, dstBlock: dstBlock), dstBlock: dstBlock)
			arityMismatch then panic("lowerCall: arity mismatch for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			unknownLabel then panic("lowerCall: unknown argument label for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			duplicateArg then panic("lowerCall: duplicate argument for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
		end 'slot'
	end 'lowerCall'

	// Emit `__mm_alloc(size, destructor[, tag])`. With `--debugstream` off this is the two-argument call it
	// has always been, byte for byte; with it on the interned tag index is appended as a third argument.
	// See the `allocTag` arm for why this tier is the one that can name it.
	function appendMmAllocTag(result ValueId, args ValueIdArray, dstBlock IrBlock)
		if not self.debugStream 'untracedBuild'
			self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: MmAllocName, args: args))
			return
		end 'untracedBuild'

		let tagIndex = self.allocTagIndexOf(result)
		let tagValue = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(tagValue, value: tagIndex, valueType: StdType.i64))
		var tagged = ValueIdArray.create()
		tagged.append(args)
		tagged.push(tagValue)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: MmAllocName, args: tagged))
	end 'appendMmAllocTag'

	// ⭐⭐ **THE TRACE TAG A PARSER-ALLOCATED BOX CARRIES.** Two sources, asked in this order:
	//
	//   1. **THE SIDE TABLE**, for a box that is not any declared type's — an interpolation scratch run, a
	//      closure environment, a promoted parameter cell. The parser recorded the tag against this very
	//      `__mm_alloc` op (`Project.allocTagSites`); nothing else in the compiler reads that table, and the
	//      value's TYPE is untouched by it. That separation is the whole point — see the table's own note
	//      for what happened when the tag rode in the type slot instead.
	//   2. **THE RESULT'S OWN TYPE**, for every box that has one:
	//      • a `string` result is the fused String RECORD. It has no name id — `MaxonType.string` is its
	//        own arm rather than a `named` one — so it takes the roster's `StringRecord`, the same spelling
	//        `StringRuntime`'s own allocations carry. Two producers of one record, one tag.
	//      • a `named` or `structRef` result is a BOXED UNION or a STRUCT RECORD, and its interned type
	//        name is exactly what a reader of the trace wants. BOTH tags, because the two spellings are one
	//        question here: a `type Point` box is `structRef` and a `union Shape` box is `named`, and both
	//        carry the layout's interned name in the same column.
	//      • anything else takes `Untagged`, which the monitor prints as `tag=0`. A `genericInstance` box
	//        is the deliberate one: its name id is a `GenericInstanceId`, not a type-name id, so reading it
	//        through `typeNames` would print a DIFFERENT type's name. Printing none is better than printing
	//        the wrong one.
	function allocTagIndexOf(result ValueId) returns ParsedInt
		let recorded = try self.allocTagSites.get(self.currentMaxonOpIndex) otherwise 'noRecordedTag'
			return self.allocTagFromResultType(result)
		end 'noRecordedTag'
		return mmTagIndex(recorded)
	end 'allocTagIndexOf'

	// ⭐⭐ **`__DebugStream.nameId("…")` COLLAPSES TO ITS INDEX HERE, AND THE CALL DISAPPEARS ENTIRELY.** The
	// parser could not number the name — the table is whole-program and it holds one file (see
	// `Project.debugStreamNameSites`) — so it emitted a marker carrying nothing and put the bytes in a side
	// table. This is the first tier that walks the merged module, so this is where a name becomes a number.
	//
	// ⚠ **INTERNED UNCONDITIONALLY, NOT UNDER `self.debugStream`, AND THE ASYMMETRY WITH THE `__mm_alloc`
	// TAG ARM ABOVE IS DELIBERATE.** A tag index is the compiler's own bookkeeping about a box, so an
	// untraced build may decline to mint one. A name id is a VALUE the program computes and may print, so it
	// may not depend on a compiler flag — only the BLOB is gated. `GlobalDataTable.debugStreamNames` carries
	// the same rule from the table's side, and it is the bootstrap's
	// (`MaxonToStandardConversion.LowerDebugStreamNameId`).
	//
	// ⚠ **A MISSING SIDE-TABLE ENTRY PANICS RATHER THAN DEFAULTING TO 0.** Index 0 is the monitor's "no
	// name", so a silent fallback would render every affected event as unnamed — a wrong ANSWER, in the
	// instrument, with nothing to notice it. The only way to arrive without an entry is for the parser's
	// record and its emit to have come apart, which `recordDebugStreamNameSite`'s contract exists to prevent.
	function lowerDebugStreamNameId(result ValueId, dstBlock IrBlock)
		let name = try self.debugStreamNameSites.get(self.currentMaxonOpIndex) otherwise panic("lowerDebugStreamNameId: the `__ds_name_id` marker at op {self.currentMaxonOpIndex} has no recorded name — `Parser.parseDebugStreamNameId` records one against the op it is about to emit, so the record and the emit have come apart")
		self.stdModule.appendOp(dstBlock, op: StdOp.const(result, value: self.globalData.debugStreamNames.intern(String.from(name)), valueType: StdType.i64))
	end 'lowerDebugStreamNameId'

	// ⭐⭐ **THE COMPILE-TIME GATE, AND THE ONLY PLACE IT IS DECIDED: `--debugstream` OFF MEANS ZERO
	// INSTRUCTIONS.** Not a branch that is never taken, not a call that returns immediately — the four
	// emitting markers lower to NO OPS AT ALL, so an ordinary build's emitted code is what it would have been
	// had the calls not been written. `enabled()` is the one exception and it has to be: it has a RESULT, so
	// it folds to the constant `false`, which every later fold and dead-branch elimination then sees.
	//
	// ⚠⚠ **THE BARE `project.debugStream` FLAG IS THE RIGHT GATE HERE, THOUGH THE INSTALL'S IS THE
	// CONJUNCTION `buildCarriesDebugStream`, AND THE TWO CANNOT DISAGREE FOR A PROGRAM THAT REACHES THIS
	// FUNCTION.** That conjunction is `--debugstream` AND `usesHeap`, and a program holding ANY of these
	// markers has already had `usesHeap` declared for it by `scanRuntimeUsage`'s log arm — the producer needs
	// `__slab_alloc` to attach and `__str_copy` to write a message, and neither is a bit this Maxon-module
	// walk could otherwise see. So for exactly the programs this arm can be reached from, the flag IS the
	// full condition. Reading the conjunction here instead would mean threading `RuntimeUsage` into a pass
	// that runs before the usage scan's answer is anyone else's business.
	//
	// ⚠ A DROPPED marker leaves its `result` ValueId undefined, which is correct rather than tolerated: the
	// four emitting members are VOID (`Parser.emitDebugStreamEmit` mints `ValueTypeTag.void`), so nothing can
	// read it — a void result is a discarded statement result and can never be an operand
	// (`valueTagToStdType`'s own `void` arm says so).
	function lowerDebugStreamEmit(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		if not self.debugStream 'untracedBuild'
			if callee.equals(DsLogEnabledMarkerName) 'enabled'
				self.stdModule.appendOp(dstBlock, op: StdOp.const(result, value: PredicateFalse, valueType: StdType.i1))
			end 'enabled'

			return
		end 'untracedBuild'

		if callee.equals(DsLogEnabledMarkerName) 'enabled'
			self.appendDebugStreamAttachedTest(result, dstBlock: dstBlock)
			return
		end 'enabled'

		// The two ends of a phase span share ONE entry point and differ in the wire code, which the parser
		// could not supply — it is the producer's constant, not the source's.
		if callee.equals(DsLogPhaseBeginMarkerName) 'phaseBegin'
			self.appendDebugStreamPhaseCall(result, eventType: DsEvLogPhaseBegin, args: args, dstBlock: dstBlock)
			return
		end 'phaseBegin'

		if callee.equals(DsLogPhaseEndMarkerName) 'phaseEnd'
			self.appendDebugStreamPhaseCall(result, eventType: DsEvLogPhaseEnd, args: args, dstBlock: dstBlock)
			return
		end 'phaseEnd'

		// These two arrive with exactly the arguments their entry point takes, so the marker becomes the call
		// and nothing else moves.
		if callee.equals(DsLogEventMarkerName) 'event'
			self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: DsEmitLogEventName, args: args))
			return
		end 'event'

		if callee.equals(DsLogTextMarkerName) 'text'
			self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: DsEmitLogTextName, args: args))
			return
		end 'text'

		panic("lowerDebugStreamEmit: '{String.from(callee)}' wears the `__ds_log_` marker prefix and no arm here claims it — `isDebugStreamLogMarker` and this dispatch are two readings of one roster (`DebugStreamRuntime`'s marker names), so a member was taught to the parser and not to the lowering")
	end 'lowerDebugStreamEmit'

	// `__ds_base != 0` — the run-time gate as a VALUE, which is the whole of `__DebugStream.enabled()`. A
	// load and a compare: no call, so a guarded body costs nothing when nothing is listening.
	function appendDebugStreamAttachedTest(result ValueId, dstBlock IrBlock)
		let addr = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.globalAddr(addr, label: DsBaseLabel))
		let base = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.loadIndirect(base, addrId: addr, offset: 0, valueType: StdType.i64))
		let detached = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(detached, value: 0, valueType: StdType.i64))
		self.stdModule.appendOp(dstBlock, op: StdOp.cmp(result, lhs: base, rhs: detached, pred: StdCmpPred.ne, operandType: StdType.i64))
	end 'appendDebugStreamAttachedTest'

	// `__ds_emit_log_phase(eventType, nameId, unitId)` — the source's two arguments with the producer's wire
	// code in front of them. ONE function for both ends of a span, because the code is the only difference
	// and a second copy is where the two would come to disagree about which end is which.
	function appendDebugStreamPhaseCall(result ValueId, eventType ParsedInt, args ValueIdArray, dstBlock IrBlock)
		let code = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(code, value: eventType, valueType: StdType.i64))
		var callArgs = ValueIdArray.create()
		callArgs.push(code)
		callArgs.append(args)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: DsEmitLogPhaseName, args: callArgs))
	end 'appendDebugStreamPhaseCall'

	function allocTagFromResultType(result ValueId) returns ParsedInt
		if self.valueTagOf(result) == ValueTypeTag.string 'stringRecord'
			return mmTagIndex(MmTag.StringRecord)
		end 'stringRecord'

		if self.valueTagOf(result) != ValueTypeTag.named and self.valueTagOf(result) != ValueTypeTag.structRef 'noTypeNameToRead'
			return mmTagIndex(MmTag.Untagged)
		end 'noTypeNameToRead'

		let nameId = try self.valueNameIds.get(result) otherwise return mmTagIndex(MmTag.Untagged)
		let name = try self.typeNames.nameOf(nameId) otherwise return mmTagIndex(MmTag.Untagged)
		return userTagIndex(self.globalData, name: String.from(name), debugStream: true)
	end 'allocTagFromResultType'

	// ⭐⭐ **A DIRECT CALL WHOSE CALLEE RETURNS AN INTERFACE DEFINES TWO VALUES, SO IT IS A `tryCall`
	// (P1.7a slice 2, the return ABI).** The callee wrote the witness half into the secondary return register
	// (`functionUsesSecondaryReturnSlot` — the callee's own view of this same fact), and `StdOp.tryCall` is
	// the op that captures that register. No new Std op and no new backend arm: v1 reaches the identical
	// arrangement — *"the secondary register — normally the error flag — carries the witness-table address
	// instead. Same register convention, same op shape"*.
	//
	// ⚠ **THE OTHER DISJUNCT NEVER ARRIVES HERE, AND THAT IS WHY THIS TESTS THE RESULT AND NOT THE CALLEE.**
	// A THROWING callee's call is a `MaxonOp.tryCall` from the parser and is lowered by `lowerTryCall`, so
	// the only writer of the slot this door can meet is the interface-returning one — and the two are
	// mutually exclusive anyway (a declaration that is both is E2015). The result's TAG is the parser's own
	// answer to "does this call hand back a fat pointer?", read from the one type oracle this tier has
	// (`valueTags`) rather than re-derived from the callee's signature.
	//
	// The second def is the ValueId the parser RESERVED and paired with the result
	// (`Parser.mintDirectCallValueResult`): defining it here is what makes a returned existential
	// indistinguishable downstream from a parameter-borne one — the same column, the same `pairedWitnessOf`.
	function appendDirectCall(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		if self.valueTagOf(result) == ValueTypeTag.interfaceRef 'existentialReturn'
			self.stdModule.appendOp(dstBlock, op: StdOp.tryCall(result, errorFlagId: self.pairedWitnessOf(result, site: callee), callee: callee, args: args))
			return
		end 'existentialReturn'

		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: args))
	end 'appendDirectCall'

	// Lower a call to an emitted runtime entry point: the arguments pass through VERBATIM.
	//
	// ⚠ The label guard is what stops "positional by construction" from quietly becoming "positional
	// by habit". `Parser.emitRuntimeCall` builds an all-empty label column (`emptyArgLabels`), so a
	// label here means someone taught the parser to write one — and since there is no signature to
	// match it against, the argument would be dropped into the position it happened to occupy rather
	// than the one it named. That is a wrong answer with no diagnostic anywhere, so it panics at the
	// one place that could still see it.
	function lowerRuntimeCall(result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, dstBlock IrBlock)
		requireRuntimeCallPositional(callee, argLabels: argLabels)
		// ⭐ **A1x's TOTAL REMAINDER IS EXPANDED HERE — the non-throwing twin of `lowerTryCall`'s checked-division
		// arm, and for the identical reason: there is no `__guarded_mod` function to call.** It is the only
		// division kind that can reach a plain `call`, because it is the only one that does not throw; the two
		// `__checked_*` names arrive through `lowerTryCall` and are refused below if they somehow do not.
		//
		// ⚠ **THE MATCH IS TERMINAL: the "not a division" arm CARRIES the rest of the lowering rather than
		// falling out of it.** A `match` arm is exactly one statement, so an arm that expands AND then leaves
		// the function ahead of the call path cannot be written — and `return self.lowerDivisionExpansion(…)`
		// is not the way out of that, because a void callee yields nothing to return
		// (`specs-shv2/void-call-result.md`). Routing the residue through `appendRuntimeCall` asks
		// `divisionKindOf` ONCE and keeps the classification exhaustive in one place, which is the shape
		// `lowerOp`'s own dispatch already has.
		match divisionKindOf(callee) 'guardedDivision'
			guardedRemainder then self.lowerDivisionExpansion(result, expansion: DivisionExpansion.guardedRemainder, signedness: divisionCalleeSignedness(callee), args: args, dstBlock: dstBlock)
			quotient to remainder then panic("lowerRuntimeCall: the THROWING '{String.from(callee)}' reached the plain call path — `isThrowingRuntimeCallee` names it, so `Parser.emitDivOrMod` must have emitted it without the `try` that E3057 requires")
			notCheckedDivision then self.appendRuntimeCall(result, callee: callee, args: args, dstBlock: dstBlock)
		end 'guardedDivision'
	end 'lowerRuntimeCall'

	// Every runtime callee `lowerRuntimeCall`'s division match hands on — that is, every one that is not
	// expanded in place. Most become the plain `StdOp.call` at the end; the guards ahead of it are the
	// callees this tier has to finish building, because the parser could not: an argument only a
	// whole-program view can supply (a layout descriptor, an allocation tag), or a marker that folds to a
	// constant rather than being called at all.
	function appendRuntimeCall(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		// An OPAQUE-`T` container create arrives SHORT ONE ARGUMENT — a `__managed_create` (P1.7 slice 3b-i)
		// with only element_size, a `__list_create` (W134) with none at all; its element destructor is not
		// known statically, so it is READ from the enclosing instance's threaded layout descriptor
		// (`destroyFunc@40`) HERE — the tier that owns the descriptor's ValueId — and appended as the LAST
		// argument, mirroring how `sizeof(T)` reads `elementLogicalSize@56`.
		if self.isOpaqueContainerCreateCall(callee, result: result) 'opaqueContainerCreate'
			self.appendOpaqueContainerCreate(result, callee: callee, args: args, dstBlock: dstBlock)
			return
		end 'opaqueContainerCreate'
		// A `__drop_type_param` (P1.7 slice 3b-v) arrives with ONE argument (the opaque owned value); its
		// element destructor is not known statically, so the enclosing instance's layout descriptor is
		// PREPENDED as the first argument (`__drop_type_param(descriptor, value)`) — the drop twin of
		// `appendOpaqueContainerCreate`'s destructor read, off the SAME `implicitLayoutValueId`.
		// A `__drop_type_param` (P1.7 slice 3b-v) and its co-ownership twin `__retain_type_param` (W41-opaque)
		// each arrive with ONE argument (the opaque value) and take the descriptor in front of it. ONE arm
		// because the prepend is one act: the block is chosen off the VALUE's own type parameter either way,
		// and two arms is where the drop's block and the retain's would come to be read differently.
		// ⭐ **AN `__mm_alloc` GETS ITS TRACE TAG HERE** (Workstream O3). The parser and `ModuleInit` both
		// write a two-argument `__mm_alloc(size, destructor)` — a struct record, a boxed union, an
		// interpolation scratch buffer — and none of them can name a USER type's tag, because the
		// whole-program type-name interner does not exist at their tier. It does here, so the append
		// happens once for all three producers.
		//
		// ⚠ The tag has TWO sources and `allocTagIndexOf` owns the order between them — the parser's
		// side table for a box that is not any declared type's, the result's own type for every box that
		// has one. Neither is decided at this arm; see that function.
		if callee.equals(MmAllocName) 'allocTag'
			self.appendMmAllocTag(result, args: args, dstBlock: dstBlock)
			return
		end 'allocTag'
		// ⭐⭐ **THE ONE RUNTIME CALLEE THAT BECOMES A CONSTANT RATHER THAN A CALL** — the
		// `__DebugStream.nameId("…")` marker. See `lowerDebugStreamNameId`.
		if callee.equals(DebugStreamNameIdMarkerName) 'debugStreamNameId'
			self.lowerDebugStreamNameId(result, dstBlock: dstBlock)
			return
		end 'debugStreamNameId'
		// ⭐⭐ **AND THE FIVE RUNTIME CALLEES THAT BECOME NOTHING AT ALL** — the `__DebugStream` log markers.
		// See `lowerDebugStreamEmit`, which is where the compile-time half of the gating rule is decided.
		if isDebugStreamLogMarker(callee) 'debugStreamLog'
			self.lowerDebugStreamEmit(result, callee: callee, args: args, dstBlock: dstBlock)
			return
		end 'debugStreamLog'
		if callee.equals(DropTypeParamName) or callee.equals(RetainTypeParamName) 'typeParamOwnership'
			self.appendTypeParamDescriptor(result, callee: callee, args: args, dstBlock: dstBlock)
			return
		end 'typeParamOwnership'
		// ⭐⭐ **A DICTIONARY DESTRUCTOR TAKES THE WHOLE DESCRIPTOR, NOT A BLOCK (BATCH41).** The arm above
		// hands `__drop_type_param` the block of the ONE parameter its value is typed at; a dictionary
		// destructor releases several fields standing at several parameters, so it indexes its own blocks —
		// off the `uses`-list positions its fields substitute to, which are positions in the SAME list this
		// descriptor lays out (`ProgramSignatures.genericInstanceFieldOpaqueBlockOffset` carries the argument).
		// That is what serves a PERMUTED instance — `Pair with (U, T)` inside `Holder uses T, U` — which a
		// single forwarded block base cannot express at all.
		if isDictionaryDestructorCallee(callee) 'dictionaryCascade'
			self.appendWholeLayoutDescriptor(result, callee: callee, args: args, dstBlock: dstBlock)
			return
		end 'dictionaryCascade'
		// ⚠⚠ **A WITNESS-THREADING ARM STOOD HERE AND IS GONE, AND ITS FAMILY COUNT WENT 3 → 1 → 0.** A
		// compiler-owned runtime call that PROBES a hash table it does not hold got the key's `Hashable`/
		// `Equatable` witness-table addresses appended as hidden trailing arguments — the dictionary-passing
		// twin of `appendWitnessArgs`. `__set_*`/`__map_*` read their key type off a RECEIVER and went with the
		// synthesized hash table (W105); `__cs_contains` named its `Character` key outright and went with the
		// `__cs_*` runtime (W129). Every corpus replacement is a declared generic method, so its witnesses are
		// ordinary dictionary PARAMETERS filled by `appendWitnessArgs`.
		// ⇒ **No compiler-owned runtime callee threads a witness table today**, and a new one would rebuild the
		// arm here — see `materializeWitnessTableAddr`, which holds what such an arm must not get wrong.
		// ⚠ The descriptor append runs FIRST and may itself emit ops into `dstBlock`, so the index the call is
		// about to occupy is read AFTER it and immediately before the append — the same discipline
		// `Parser.emitRuntimeCallInto` states for its own op index.
		let callArgs = self.opaqueCopyArgsWithDescriptor(callee, args: args, dstBlock: dstBlock)
		self.recordStaticElementStride(args, opIndex: self.stdModule.opCount())
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: callArgs))
	end 'appendRuntimeCall'

	// ⭐⭐ **WRITE DOWN THE COMPILE-TIME `element_size@24` STAMP OF THIS CALL'S CONTAINER (EC15)** — the one
	// fact `inlineManagedPrimitives` needs to emit ONE of `emitStrideDispatch`'s arms instead of forking on a
	// stride that is fixed by the element type. `Array with Integer` is 8 in every program that ever runs, and
	// the pass was loading `element_size@24` and comparing it twice at EVERY element access.
	//
	// ⭐ **IT IS CALLEE-AGNOSTIC, AND THAT IS WHAT MAKES IT COMPLETE.** It asks about the ARGUMENT, not about
	// a roster of primitive names: a roster here would be a second copy of the one
	// `InlineManagedPrimitives.expandPlainCall` / `expandThrowingCall` dispatch on, free to drift from it, and
	// this project's signature bug is one fact written down twice. An entry recorded for a call the pass never
	// expands (`__managed_count`, `__managed_push`) is simply never read; a missing one costs a specialization,
	// never an answer.
	//
	// ⚠ **`isArrayInstanceAt` IS THE GATE, TAG AND ALL, AND IT IS NOT SPELLED OUT HERE.** It is the ONE home of
	// the two-part test — a bare `TypeNameId` shares the numeric space with a `GenericInstanceId`, so an
	// instance-registry walk keyed on an unchecked id answers TRUE about an instance the caller never had. It
	// also settles the `__ManagedMemory` half for free: `Array with T` and `__ManagedMemory with T` are ONE
	// `GenericInstanceId` (`isArrayBaseName`), so `arr.memory.set(…)` records the same stamp `arr.get(…)` does.
	//
	// ⚠⚠ **AN OPAQUE ELEMENT IS REFUSED, AND THAT IS THE W57 TRAP RATHER THAN A CONSERVATISM.** A shared
	// generic body over `Array with T` is compiled ONCE for every instantiation, so it has no single stride —
	// and `arrayElementSize` would answer for it anyway, off `trivialElementSlot` of a type parameter. Recording
	// that answer would specialize `Array with Byte`'s body onto an 8-byte access.
	//
	// ⚠ **IT RECORDS A STAMP AND NOT A VERDICT, and the difference is load-bearing.** The stamp is the one
	// `ProgramSignatures.arrayElementSize` gives this INSTANCE; whether the record reaching the call actually
	// carries it is `strideDispatchPlanForStamp`'s question, and its answer is not "yes" for every width —
	// see there for the shape that made a byte-typed field answer 0 where 7 is correct.
	//
	// ⚠ Both type columns are read PERMISSIVELY. They are dense over the values the PARSER minted, and this
	// tier mints its own (`mintStdValueId` — a layout descriptor, a destructor slot); such a value can never be
	// argument 0 of an element access today, and a `return` rather than a panic is what keeps that from being a
	// premise this function rests on.
	function recordStaticElementStride(args ValueIdArray, opIndex OpIndex)
		let container = try args.get(0) otherwise 'noArguments'
			return
		end 'noArguments'

		let tag = try self.valueTags.get(container) otherwise 'notAParserMintedValue'
			return
		end 'notAParserMintedValue'

		let instance = try self.valueNameIds.get(container) otherwise 'noNameId'
			return
		end 'noNameId'

		if not self.signatures.isArrayInstanceAt(tag, nameId: instance) 'notAnArrayRecord'
			return
		end 'notAnArrayRecord'

		if self.signatures.containerElementIsOpaque(instance) 'sharedGenericBody'
			return
		end 'sharedGenericBody'

		// ⚠ The index was read from `ops.count()` one statement above the append it belongs to, so it cannot
		// already be occupied. A second entry under one key would mean this table's key space is not the one
		// its header claims it is, which is exactly the failure a stale-coordinate side table dies of.
		if self.stdOpElementStrides.contains(opIndex) 'keyAlreadyTaken'
			panic("recordStaticElementStride: Std op index {opIndex} already carries an element stride — the key space is meant to be one entry per appended call, so `ops.count()` and the append it names have come apart")
		end 'keyAlreadyTaken'

		self.stdOpElementStrides.upsert(opIndex, value: self.signatures.arrayElementSize(instance))
	end 'recordStaticElementStride'

	// The `rdataAddr` of the `__witness_<conformerType>.<interface>` table (P1.7b slice A) — the address of one
	// of a conformer's protocol witnesses. `ensureWitnessTable` registers the blob and its `funcAbs64` slot
	// reloc (to the synthesized `int.hash`/`int.equals`) on first reference, idempotent by label, so many
	// operations on one conformer build ONE table per interface.
	//
	// ⚠ It was `materializeKeyWitness` while a hash-table KEY was the only conformer threaded this way, and an
	// `Array`'s ELEMENT was briefly the second; nothing here was ever about a key.
	//
	// ⚠⚠ **ITS SECOND CALLER WAS `withWitnessTableArgs` — the loop that appended one of these per constraint
	// into a COMPILER-OWNED runtime callee — and that whole family is retired (W105, then W129).** The rule it
	// enforced outlives it and is the one a rebuilt arm must not get wrong, because the cost of missing it was a
	// MEASURED access violation rather than a tidiness point: every witness-carrying callee before `__map_get`
	// was non-throwing, so "append the witnesses" and "lower a throwing call" had never had to meet, and
	// `lowerTryCall`'s compiler-owned arm never asked. Lowered without them, `__map_get(map, key)` left the two
	// witness PARAMETERS reading whatever the ABI registers happened to hold, and the fused `witnessCall` inside
	// the probe's `hash()` jumped through it — `create` + `upsert` + `contains` all correct and the first
	// `try m.get(k)` faulting with 0xC0000005. ⇒ **A compiler-owned callee that takes witness parameters must
	// have EVERY lowering path that emits it reach one appender**, never two that agree by hand.
	function materializeWitnessTableAddr(conformerType ByteArray, instance WitnessTableInstance, interfaceName ByteArray, dstBlock IrBlock) returns ValueId
		let label = self.ensureWitnessTable(conformerType, instance: instance, interfaceName: interfaceName)
		let addrId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(addrId, label: label.toByteArray()))
		return addrId
	end 'materializeWitnessTableAddr'

	// Append the enclosing instance's layout DESCRIPTOR to an OPAQUE-`T` array-copy call's arguments (P1.7 slice
	// 3b-vi-b-β) — the LAST argument the `__managed_{slice,clone,append}_opaque` wrappers read `copyFunc@32` from,
	// exactly as `appendOpaqueContainerCreate` appends the `destroyFunc@40` read for an opaque `__managed_create`. A
	// non-opaque-copy callee passes through UNCHANGED, so this is a safe wrapper over every runtime call's args.
	// Shared by the non-throwing (`lowerRuntimeCall`) and throwing (`lowerTryCall`, the throwing `slice`) paths so
	// they cannot drift on whether — or where — the descriptor is appended. The descriptor is guaranteed by the
	// parser's copy-descriptor-need seed (a method that copies an opaque array reserves it, exactly as an opaque
	// `X.create()` or a `sizeof(T)` method does), so its absence here is a parser/lowering divergence — a loud
	// bug, not a silent wrong load, matching `appendOpaqueContainerCreate`.
	function opaqueCopyArgsWithDescriptor(callee ByteArray, args ValueIdArray, dstBlock IrBlock) returns ValueIdArray
		if not isOpaqueElementCopyCallee(callee) 'notOpaqueCopy'
			return args
		end 'notOpaqueCopy'
		if not self.hasImplicitLayout 'noLayout'
			panic("opaqueCopyArgsWithDescriptor: opaque array copy '{String.from(callee)}' in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's copy-descriptor-need seed and this lowering disagree")
		end 'noLayout'
		// The COPIED array's own type parameter decides the block (W43b) — its `copyFunc@32` is that column's
		// cloner and no other's, the exact dual of `appendOpaqueContainerCreate`'s destructor read.
		let source = try args.get(0) otherwise panic("opaqueCopyArgsWithDescriptor: opaque array copy '{String.from(callee)}' has no receiver argument — its first parameter is the array record")
		var fullArgs = ValueIdArray.create()
		fullArgs.append(args)
		fullArgs.push(self.descriptorBlockAddr(self.opaqueContainerBlockOffset(source, callee: callee), dstBlock: dstBlock))
		return fullArgs
	end 'opaqueCopyArgsWithDescriptor'

	// Emit `__drop_type_param(descriptor, value)` (P1.7 slice 3b-v) / `__retain_type_param(descriptor, value)`
	// (W41-opaque): prepend the CURRENT function's layout descriptor to the single `value` argument the parser
	// emitted. The descriptor parameter is guaranteed by the parser's descriptor-need seed (a method that drops
	// an opaque feed binding, or STORES a borrowed opaque value into a record, needs it exactly as a
	// `sizeof(T)` / opaque `X.create()` method does), so its absence here is a parser/lowering divergence — a
	// loud bug, not a silent wrong load, matching `appendOpaqueContainerCreate`. `result` is the parser's result
	// value — VOID for the drop, the CO-OWNER for the retain — passed through so the Std op's result column
	// stays dense either way.
	function appendTypeParamDescriptor(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		if not self.hasImplicitLayout 'noLayout'
			panic("appendTypeParamDescriptor: `{String.from(callee)}` in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's descriptor-need seed and this lowering disagree")
		end 'noLayout'
		// The value's own type parameter decides the block (W43b): both entries read their word off whatever
		// descriptor they are handed, so a two-parameter generic acting on its SECOND parameter's value must be
		// handed that parameter's block and not the first's.
		let value = try args.get(0) otherwise panic("appendTypeParamDescriptor: `{String.from(callee)}` has no value argument")
		var fullArgs = ValueIdArray.create()
		fullArgs.push(self.descriptorBlockAddr(self.typeParamValueBlockOffset(value, callee: callee), dstBlock: dstBlock))
		fullArgs.append(args)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: fullArgs))
	end 'appendTypeParamDescriptor'

	// Emit `__destruct_dict_<mangled>(descriptor, box)` — prepend the CURRENT function's WHOLE layout descriptor
	// to the single box argument the parser emitted. The descriptor parameter is guaranteed by the same
	// reservation `__drop_type_param` rests on, and by the same refusal when it is missing
	// (`Parser.dropReadsTheLayoutDescriptor` puts both families through one test), so its absence here is a
	// parser/lowering divergence — a loud bug, not a silent wrong load.
	function appendWholeLayoutDescriptor(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		if not self.hasImplicitLayout 'noLayout'
			panic("appendWholeLayoutDescriptor: `{String.from(callee)}` in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's descriptor-need seed and this lowering disagree")
		end 'noLayout'
		var fullArgs = ValueIdArray.create()
		fullArgs.push(self.implicitLayoutValueId)
		fullArgs.append(args)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: fullArgs))
	end 'appendWholeLayoutDescriptor'

	// The descriptor block of the type parameter a descriptor-gated ownership value is typed at — read off the
	// value's own `typeParameter` token, the same token the stamp matched positions against.
	function typeParamValueBlockOffset(value ValueId, callee ByteArray) returns ByteOffset
		let tag = self.valueTagOf(value)
		if tag != ValueTypeTag.typeParameter 'notATypeParameter'
			panic("typeParamValueBlockOffset: `{String.from(callee)}` was given a {tag.name} value — only an opaque type-parameter value is owned through the descriptor")
		end 'notATypeParameter'
		let token = try self.valueNameIds.get(value) otherwise panic("typeParamValueBlockOffset: typeParameter value v{value} has no name-id (its type-parameter token) — the two type columns are dense and in lockstep")
		return layoutBlockOffsetFor(self.signatures.opaqueTypeParamPosition(MaxonType.typeParameter(token)))
	end 'typeParamValueBlockOffset'

	// Is this runtime call an OPAQUE-`T` container `create()` — an `__managed_create` (P1.7 slice 3b-i) or a
	// `__list_create` (W134) whose result instance's element is a type parameter? The parser emits such a create
	// SHORT its element-destructor argument, which `appendOpaqueContainerCreate` supplies. A CONCRETE create (its
	// element known) already carries every argument and takes the plain path.
	//
	// ⚠ The callee test is a two-name set rather than `opaqueInstanceCreateReadsTheDescriptor` over the result, and
	// deliberately: the runtime ENTRY is what decides whether an argument is missing, and a container whose
	// opaque create ever takes a third route would be admitted here by its instance while emitting a call this
	// arm knows nothing about.
	function isOpaqueContainerCreateCall(callee ByteArray, result ValueId) returns bool
		if not callee.equals(ManagedCreateName) and not callee.equals(ListCreateName) 'notCreate'
			return false
		end 'notCreate'
		if self.valueTagOf(result) != ValueTypeTag.genericInstance 'notInstance'
			return false
		end 'notInstance'
		return self.signatures.containerElementIsOpaque(try self.valueNameIds.get(result) otherwise panic("isOpaqueContainerCreateCall: genericInstance '{String.from(callee)}' result v{result} has no name-id (its GenericInstanceId)"))
	end 'isOpaqueContainerCreateCall'

	// Emit an opaque-`T` container create: load the element destructor from the enclosing instance's layout
	// descriptor `destroyFunc@40` slot, then call the runtime entry with it as the LAST argument —
	// `__managed_create(element_size, element_destroy)` for an array or vector, `__list_create(element_drop)`
	// for a chain, which states its whole argument list in that one word. The reserved descriptor param is
	// guaranteed by the parser's descriptor-need seed (an opaque `X.create()` seeds it exactly as `sizeof(T)`
	// does), so its absence here is a parser/lowering divergence — a loud bug, not a silent wrong load,
	// matching `lowerSizeofType`.
	function appendOpaqueContainerCreate(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		if not self.hasImplicitLayout 'noLayout'
			panic("appendOpaqueContainerCreate: an opaque container `create()` (`{String.from(callee)}` — an `Array with <type parameter>`, a `Vector with <N> <type parameter>` since S2u, or a chain since W134; see `ProgramSignatures.opaqueInstanceCreateReadsTheDescriptor`) in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's descriptor-need seed and this lowering disagree")
		end 'noLayout'
		// ⭐ **WHICH type parameter's dictionary — the block for the ELEMENT's OWN parameter (W43b).** A
		// two-parameter generic creates one opaque container per column from ONE shared body, and reading a fixed
		// `destroyFunc@40` gave both columns the FIRST column's destructor: measured, an `Array with Value`
		// over `Integer` was stamped `__str_decref` and freed its ints as Strings at teardown.
		let destroyId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.loadIndirect(destroyId, addrId: self.implicitLayoutValueId, offset: self.opaqueContainerBlockOffset(result, callee: callee) + LAYOUT_OFFSET_DESTROY_FUNC, valueType: StdType.i64))
		var fullArgs = ValueIdArray.create()
		fullArgs.append(args)
		fullArgs.push(destroyId)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: fullArgs))
	end 'appendOpaqueContainerCreate'

	// ⭐ **THE DESCRIPTOR BLOCK an OPAQUE CONTAINER VALUE's dictionary lives in (W43b)** — the block for the type
	// parameter its ELEMENT names. Read off the container instance's own element type, which is the same
	// `typeParameter` token `managedOpaqueArrayElementOf` matched positions against when it stamped the slot,
	// so the write side and this read side name one block by construction. A concrete-element container never
	// reaches here (its callers gate on `containerElementIsOpaque` / `isOpaqueElementCopyCallee`).
	function opaqueContainerBlockOffset(containerInstance ValueId, callee ByteArray) returns ByteOffset
		let gid = try self.valueNameIds.get(containerInstance) otherwise panic("opaqueContainerBlockOffset: opaque container value v{containerInstance} of '{String.from(callee)}' has no name-id (its GenericInstanceId) — the two type columns are dense and in lockstep")
		return layoutBlockOffsetFor(self.signatures.opaqueTypeParamPosition(self.signatures.containerElementType(gid)))
	end 'opaqueContainerBlockOffset'

	// ⭐ **THE ADDRESS OF ONE TYPE PARAMETER'S DICTIONARY BLOCK inside the current function's descriptor
	// (W43b)** — what a runtime graph that takes a descriptor POINTER and reads a FIXED field offset from it
	// (`__drop_type_param`'s `destroyFunc@40`, the `__managed_*_opaque` wrappers' `copyFunc@32`) must be handed,
	// so that those graphs need no second offset argument and no signature change: the caller knows the
	// parameter statically and the callee keeps reading field 0 of whatever block it was given.
	//
	// Parameter 0's block IS the descriptor, so a single-parameter instance emits no arithmetic at all and
	// its code is byte-identical to what it emitted before the descriptor grew a block per parameter.
	function descriptorBlockAddr(blockOffset ByteOffset, dstBlock IrBlock) returns ValueId
		if blockOffset == 0 'theFirstBlockIsTheDescriptor'
			return self.implicitLayoutValueId
		end 'theFirstBlockIsTheDescriptor'

		let offsetId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(offsetId, value: blockOffset as ParsedInt, valueType: StdType.i64))
		let addrId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(addrId, lhs: self.implicitLayoutValueId, rhs: offsetId, opcode: StdBinOpcode.add, operandType: StdType.i64))
		return addrId
	end 'descriptorBlockAddr'

	// Lower a Maxon `indirectCall` to `StdOp.callIndirect` (P1.5-A1). There is NO signature to SLOT
	// against — a function TYPE has no parameter names, so the arguments are already in call order (the
	// parser parsed them positionally, and the op carries no labels). But the Std op DOES carry the
	// function value's register-file signature (`resultType`/`argFloatMask`, P1.5 #78) so a float result is
	// captured from the float return register and a float arg travels in a float argument register: both
	// are read straight off the already-typed result and arg VALUES (`stdTypeOf`, via `appendCallIndirect`),
	// with no callee name to look them up under. The callee value passes through as
	// the register the call goes through. Routed through this helper, not constructed inline in `lowerOp`'s
	// `match` arm, for the same shape `lowerCall` uses: the C# reference miscompiles the SCRUTINEE's decref
	// when the arm binds a managed array (`args`) and consumes it inline (measured: a `mm_decref` on a
	// sentinel pointer crashing every `try`/`throw` program's lowering); handing `args` to a function first
	// is exactly what `call`/`tryCall` do, and it compiles cleanly.
	// ⚠ It takes the WHOLE `MaxonOp` and RE-MATCHES it here rather than receiving `(result, callee, args)`
	// destructured by `lowerOp`'s big `match`, and that indirection is NOT gratuitous. The C# reference
	// (which compiles shv2) MISCOMPILES a `match` arm that BINDS an `Array with …` payload sitting in the
	// TAIL field slot of its variant, when the arm lives in a large match: it corrupts the SCRUTINEE's
	// decref and crashes every `try`/`throw` program's lowering with a `mm_decref` on a sentinel pointer.
	// (`call`/`tryCall` bind `args` safely only because a later `argRanges` field follows it; `indirectCall`
	// has no trailing field.) Binding `args` in a SMALL dedicated match here sidesteps the reference's bug,
	// keeps the natural field order, and is a Std→Maxon lowering with no other cost. The self-hosted
	// compiler will not need it, but the bootstrap does today.
	function lowerIndirectCall(op MaxonOp, dstBlock IrBlock)
		match op 'ic'
			// ⚠ The arm HANDS `args` straight to a helper and does nothing else with it — the bootstrap
			// miscompile the file header warns of (a tail-slot `Array` bound in this arm) is sidestepped only
			// while the arm's body is a single function call, so the `stdTypeOf`/`indirectCallParamTypes` work
			// (which also reads `args`) MUST live in the helper, not inline here. Inlining it re-triggered the
			// scrutinee-decref corruption (a `mm_decref` underflow tearing the module down).
			indirectCall(result, callee, args) then self.appendCallIndirect(dstBlock, result: result, callee: callee, args: args)
			default panic("lowerIndirectCall: expected an `indirectCall` op, got a different MaxonOp variant — `lowerOp` routes only `indirectCall` here")
		end 'ic'
	end 'lowerIndirectCall'

	// Build the Std `callIndirect`, recovering the function value's register-file signature from the
	// already-typed result and arg VALUES (P1.5 #78): `resultType` is the result value's Std type (a float
	// result is captured from the float return register), and `argFloatMask` has bit k set iff argument k is
	// a float — a float argument travels in a float argument register, everything else (incl. the trailing
	// uniform-ABI companion env pointer, `Parser.emitClosureEnvArg`, an i64) in a GPR. Both come from
	// `stdTypeOf`, the per-value type the parser recorded.
	//
	// ⚠⚠ **AND `stdTypeOf` ALONE IS NOT ENOUGH, WHICH IS WHY THE WIDENING RUNS FIRST.** This comment used to
	// claim the placement "matches the callee's declared parameter types BY CONSTRUCTION (a well-typed
	// argument shares its callee parameter's type)". That holds only when every argument is already a value
	// of its own declared type, and an UNTYPED INT LITERAL is not: `f(2)` at a `float` parameter is a
	// well-typed program the language widens implicitly, and reading the literal's own type made the mask
	// say GPR where the callee reads XMM. `v * 2.0` then multiplied whatever was in the register — a silent
	// wrong answer, and one the mask made CONSISTENTLY wrong end to end, so nothing downstream could catch
	// it. A comment was doing a check's job. The widening below makes the old sentence true by making the
	// argument a float BEFORE the mask is taken, which is exactly the order the DIRECT call path uses.
	// A helper because `lowerIndirectCall`'s arm must hand `args` to a function and touch it no other way.
	function appendCallIndirect(dstBlock IrBlock, result ValueId, callee ValueId, args ValueIdArray)
		let declaredParams = self.indirectCalleeParamTypes(callee)
		self.stdModule.appendOp(dstBlock, op: StdOp.callIndirect(result, calleeReg: callee, resultType: StdReturnType.value(self.indirectResultType(result)), argFloatMask: paramFloatMask(declaredParams), args: self.crossFloatDomainArgs(args, paramTypes: declaredParams, callee: NoNamedCallee, dstBlock: dstBlock)))
	end 'appendCallIndirect'

	// ⭐ **THE DECLARED PARAMETER TYPES OF THE FUNCTION VALUE BEING CALLED — the one fact an indirect call's
	// whole ABI is derived from.** A direct call reads its callee's parameter types from `funcSignatures`;
	// here the callee is a VALUE, and its declared type is whatever governs it: the FUNCTION it refers to (a
	// `functionRef` or a lifted closure) or the function TYPEALIAS the place it came from was written with.
	// `declaredFunctionShapeOf` is the one lookup that answers for all three, and it is the SAME one
	// `SemanticCheck.checkIndirectCall` used to prove the arity and the argument types — so the check and
	// the lowering cannot come to disagree about which signature this call binds against.
	function indirectCalleeParamTypes(callee ValueId) returns MaxonTypeArray
		// The SAME `requireFunctionShapeOf` SemanticCheck asked of this same call — one door, so the check
		// and the lowering cannot come to disagree about which signature the call binds against.
		return requireFunctionShapeOf(self.functionTypes, name: self.functionValueName(callee), side: "called").paramTypes
	end 'indirectCalleeParamTypes'

	// The NAME governing a function value's type, from the per-value name column of the function being
	// lowered — the twin of `SemanticCheck.functionValueGoverningName`, reading the same column and turning
	// the id into a name through the one shared `TypeResolution.functionTypeNameOf`.
	function functionValueName(value ValueId) returns ByteArray
		let nameId = try self.valueNameIds.get(value) otherwise panic("functionValueName: value v{value} in '{String.from(self.currentFuncName)}' has no recorded type name — the two type columns are minted in lockstep and `lower` re-points both per function")
		return functionTypeNameOf(self.functionTypes, nameId: nameId)
	end 'functionValueName'

	// ⭐⭐ **THE DECLARED FORMALS OF THE REQUIREMENT A WITNESS CALL DISPATCHES — the one fact the call's whole
	// ABI is derived from, and the twin of `indirectCalleeParamTypes` for the other indirect shape.** A direct
	// call reads its callee's parameter types from `funcSignatures`; a function VALUE reads them off the
	// declared `FunctionShape`; a witness call has no callee to ask at all — under dictionary passing the
	// shared body binds against the INTERFACE and the concrete impl is chosen at run time. So it asks the
	// interface, through the identity the op carries (`interfaceDeclIndex` + `methodIndex`), and every
	// conformer's impl is forced by E3016 to declare exactly these types.
	//
	// ⚠⚠ **IT USED TO READ THE ARGUMENT VALUES, AND THAT WAS A SILENT MISCOMPILE ON wasm.** `stdTypeOf` reads
	// the parser's `valueTags` column, which is NOT resolved: `parseTypeReference` mints a bare `named` for the
	// IDENTIFIER `ExitCode`, and `named` collapses to `i64` — while the conformer's impl declares its parameter
	// from the RESOLVED signature, where `exitCode` collapses to `u32`, a wasm `i32`. MEASURED on four shapes
	// (an existential receiver, a constrained type parameter, a throwing requirement, and an `ExitCode`-typed
	// parameter binding as the actual): every one compiled clean, answered correctly on x64-windows, and died
	// `wasm trap: indirect call type mismatch`, `call_indirect` declaring `(param i64 i64)` against
	// `(param i64 i32)`. The discriminator that named the cause: the SAME requirement and the SAME conformer
	// WORK when the actual is an interface method's result, one of the few expressions the parser does tag
	// `exitCode` — so the answer depended on which SPELLING of "this is an `ExitCode`" the actual happened to
	// carry, not on the formal. `bool` was safe only by an accident of syntax (it is a KEYWORD, so
	// `parseTypeReference` tags it directly, and `typealias Flag = bool` is E2015), which is why `ExitCode` is
	// the only narrow type that ever reached this and why 3,958 green tests could not see it.
	//
	// ⚠ **AND REPAIRING THE TAG WOULD NOT HAVE BEEN ENOUGH.** An actual's type can genuinely differ from its
	// formal's: `g.greet(loud: 5)` at a `greet(loud bool)` requirement compiles in shv2 AND in the bootstrap
	// (the E3005 a DIRECT call gets is missing for a witness dispatch). Arg-derived widths are unsound while
	// that check is absent; formal-derived widths are sound regardless, because `pushIndirectArgs` then coerces
	// the actual to the width the callee declares — which is exactly what the register targets already do by
	// moving a whole 64-bit register.
	//
	// ⭐ **POSITION 0 IS THE RECEIVER, WHICH NO FORMAL DESCRIBES, AND IT IS A MACHINE WORD BY AN ENFORCED
	// RULE.** A constrained type parameter is an opaque 8-byte slot — E2062 REFUSES a float type argument in so
	// many words — and an existential's receiver is its fat pointer's value half, a pointer. So the receiver
	// takes `integer`, and the formals fill positions 1…n.
	//
	// ⭐ **A FORMAL THE INTERFACE DOES NOT NAME A TYPE FOR IS AN ASSOCIATED TYPE, AND ITS TYPE IS THE
	// CONFORMERS' BINDING.** The formals are RENDERED SOURCE NAMES, and `witnessFormalType` below decides each
	// one: an ASSOCIATED type first (a `uses` parameter can spell a builtin, so the order is load-bearing —
	// see there), resolved through `associatedAbiBindingOf`; otherwise `builtinTypeNameTag`, with everything it
	// does not name reduced to the machine word by `renderedTypeNameAbiType`, which is right for `Self`, a user
	// type, a type parameter and a ranged alias alike.
	//
	// ⚠ **THE ACTUAL IS NEVER CONSULTED, AND IT USED TO BE.** Falling back to the argument's own tag reads the
	// unresolved `valueTags` column — this slice's own defect one level down — and it cannot see a binding the
	// actual does not happen to match. Two conformers that bind one dispatched associated type DIFFERENTLY have
	// no single answer at all: the shared body is compiled once, so it is compiled against one of them and
	// hands the other's impl bits it reads as something else. MEASURED, x64 SEGFAULTED on one such pair and
	// silently answered 1 for 51 on another. That is refused whole-program by E3119, on every target, because
	// the register targets are the half that fails quietly.
	function witnessFormalTypes(methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex, receiver ValueId) returns MaxonTypeArray
		let slot = self.witnessRequirementSlot(methodIndex, interfaceDeclIndex: interfaceDeclIndex)
		let formals = slot.method.paramTypeNames

		var types = MaxonTypeArray.create()
		types.push(MaxonType.integer)

		for j in 0 upto formals.count() 'eachFormal'
			let formalName = try formals.get(j) otherwise panic("witnessFormalTypes: formals.get OOB at {j} below count {formals.count()}")
			types.push(self.witnessFormalType(formalName, interfaceDeclIndex: interfaceDeclIndex, receiver: receiver))
		end 'eachFormal'

		// The CHECK between the two copies of one number: this list's length IS the slot's ABI arity, and
		// `witnessSlotAbiArity` — which an adapter's parameter list is cut to, without a receiver value to
		// build this list from — states it separately. An adapter one argument short of what the call site
		// pushes is a run-time trap on wasm and a wrong register on x64, neither of them diagnosable.
		//
		// It also catches the ONE way the two can legitimately differ: a `static` requirement, which has no
		// receiver to seed and which `SemanticCheck` refuses to dispatch through (E3116). Reaching here with
		// one means that refusal did not fire.
		if types.count() != self.witnessSlotAbiArity(slot.method) 'theTwoArityStatementsDisagree'
			panic("witnessFormalTypes: slot '{String.from(slot.method.name)}' passes {types.count()} argument(s) here and `witnessSlotAbiArity` says {self.witnessSlotAbiArity(slot.method)} — the call site and the adapter builder must cut the same list, and a `static` requirement (which has no receiver) must not have reached a dispatch at all")
		end 'theTwoArityStatementsDisagree'

		return types
	end 'witnessFormalTypes'

	// ⭐⭐ **THE DECLARED TYPE OF ONE WITNESS FORMAL, AND THE ORDER OF THE TWO TESTS IS LOAD-BEARING.** An
	// ASSOCIATED TYPE is asked about FIRST and a builtin NAME second, because a `uses` parameter is an
	// IDENTIFIER and identifiers can spell builtins: `float`/`bool`/`int` are keywords a `uses` list cannot
	// hold (E2010), but `ExitCode` and `String` are not. `interface Taker uses ExitCode` is a legal program
	// whose `ExitCode` is a TYPE PARAMETER denoting whatever each conformer binds — and asking
	// `builtinTypeNameTag` first read it as the u32 builtin and declared the argument an i32 against an i64
	// callee. MEASURED: x64 answered 31 and wasm TRAPPED, on a program that was green before this order
	// existed. `builtinTypeNameTag`'s own header states the rule that violated — it is valid only at a door
	// holding a RENDERED type name, never at one asking what a `named` reference DENOTES.
	//
	// ⭐⭐ **THE ASSOCIATED TYPE IS RESOLVED AGAINST THE DISPATCHED INTERFACE, NOT THE DECLARING ONE.** Under
	// `extends`, a requirement projected in from a parent spells the PARENT's `uses` name — but a conformance
	// writes `implements Derived with X`, so the binding is the CHILD's to give and `implements Base with X`
	// is not even constructible (E3016). Asking the declaring interface found no conformance at all,
	// answered `unconformed`, and silently fell back to the machine word for EVERY inherited requirement:
	// MEASURED, a `float` binding reached through a `Derived` existential answered 31 for 51 on x64 and
	// trapped on wasm. `ConformanceCheck` walks the same dispatched interface with the same transitive slot
	// list, so the check and this emission now key on one interface.
	//
	// ⭐ **AND AN ASSOCIATED TYPE RESOLVES TO ITS BINDING, NEVER TO THE ACTUAL.** The class is a fact about the
	// CONFORMER (`implements Taker with float` is what makes the formal an f64), so it comes from
	// `associatedAbiBindingOf` — the same whole-program fold the E3119 check refuses a disagreement from, so a
	// program that passes the check and a call this emits cannot describe one argument two ways. Reading the
	// ACTUAL's tag instead was this slice's own defect one level down: it is the unresolved `valueTags`
	// column, it PANICKED `maxonTypeToStdType` outright on a `named` actual, and it cannot see a binding the
	// actual does not happen to match.
	function witnessFormalType(formalName ByteArray, interfaceDeclIndex InterfaceDeclIndex, receiver ValueId) returns MaxonType
		let dispatched = self.interfaceAtDeclIndex(interfaceDeclIndex)
		if let position = try namePositionIn(dispatched.associatedTypeNames, name: formalName) 'aConformerBindsIt'
			return self.associatedFormalType(dispatched.name, position: position, formalName: formalName, receiver: receiver)
		end 'aConformerBindsIt'

		return renderedTypeNameAbiType(formalName, signatures: self.signatures)
	end 'witnessFormalType'

	// ⭐⭐ **THE RESOLVED TYPE OF AN ASSOCIATED FORMAL — THE RECEIVER'S OWN CLAIM FIRST, THE WHOLE-PROGRAM FOLD
	// ONLY WHERE THE RECEIVER MAKES NONE (W59).** An associated binding is a property of the USE SITE, so a
	// receiver declared `Taker with Integer` fixes `Element` for every dispatch on it whatever some other
	// conformer binds — and `SemanticCheck.checkExistentialSiteClaimAtArgument` (E3127) is what makes only
	// conformers binding `Integer` reach it.
	//
	// ⚠ **THE SITE'S ANSWER GOES THROUGH `renderedTypeNameAbiType` AND NOT THROUGH THE `MaxonType`**, so this
	// arm and the fold below reduce one spelling by one rule. `instanceArgDisplayName` is the SAME rendered
	// name `SemanticCheck.existentialSiteClaimAgainst` compares a conformer's binding against, so the check
	// that admits a widening and the ABI this emits for it cannot come to read the string two ways.
	//
	// ⚠⚠ **`disagreed` IS UNREACHABLE, AND NOT FOR THE REASON IT USED TO BE.** It was sound because E3119
	// refused every disagreement whole-program; W59 narrowed that refusal to exactly the positions no dispatch
	// site fixes — `ConformanceCheck.dispatchedAssociatedNamesOf` walks the same receivers this function reads
	// and gates on the same `valueExistentialInstances` column. So a `disagreed` here means a site fixed
	// nothing AND that gate let it through, which is the two doors disagreeing about one receiver.
	//
	// `unconformed` means no type in the program conforms, so no dispatch through this requirement is
	// reachable and the machine word constrains nothing — unchanged by the per-site rule, which narrows WHICH
	// conformers can arrive and cannot conjure one where there are none.
	function associatedFormalType(interfaceName ByteArray, position ElementCount, formalName ByteArray, receiver ValueId) returns MaxonType
		if let siteBinding = try self.receiverSiteBinding(receiver, position: position, interfaceName: interfaceName) 'theReceiverClaimsIt'
			return renderedTypeNameAbiType(siteBinding, signatures: self.signatures)
		end 'theReceiverClaimsIt'

		match associatedAbiBindingOf(self.conformances, signatures: self.signatures, interfaceName: interfaceName, position: position) 'binding'
			agreed(_, _, declaredType) then return declaredType
			unconformed then return MaxonType.integer
			disagreed(first, firstBinding, second, secondBinding) then panic("associatedFormalType: '{String.from(interfaceName)}' binds `{String.from(formalName)}` to `{String.from(firstBinding)}` in '{String.from(first.typeName)}' and to `{String.from(secondBinding)}` in '{String.from(second.typeName)}', while the receiver v{receiver} of this dispatch claims nothing at position {position} — which `ConformanceCheck.checkAssociatedTypeAbiAgreement` reports as E3119, so the pipeline's error gate must stop before lowering")
		end 'binding'
	end 'associatedFormalType'

	// ⭐ **WHAT THE RECEIVER'S OWN DECLARATION BOUND ONE ASSOCIATED POSITION TO** — the site's claim, as the
	// RENDERED name. `MapError.keyNotFound` for a receiver that claims nothing at all (a bare `Taker`
	// parameter, an UNBOUND constrained type parameter, a field load, a merge phi) and for one whose instance
	// bound too few arguments, which is E3016's to report.
	//
	// The twin of `Parser.instanceBoundAssociatedType`, which answers the same question for the dispatch's
	// RESULT out of the same column — one receiver, one instance, one position, so a call's result type and its
	// argument ABI are decided by the same fact rather than by two readings of it.
	//
	// ⭐ **A CONSTRAINED TYPE PARAMETER CLAIMS THROUGH ITS `where` CLAUSE INSTEAD (G19)**, which is the same
	// arrangement one tier up: `ConformanceCheck.receiverClaimedPositions` reads the two stores in this order
	// and for this reason, so the refusal that admits the dispatch and the ABI this emits for it cannot come to
	// disagree about what the site fixed.
	function receiverSiteBinding(receiver ValueId, position ElementCount, interfaceName ByteArray) returns ByteArray throws MapError
		if let instance = try self.currentExistentialInstances.get(receiver) 'declaredAtAnInstantiatedExistential'
			if position >= self.signatures.genericInstanceArgCount(instance) 'boundNothingHere'
				throw MapError.keyNotFound
			end 'boundNothingHere'

			return self.signatures.instanceArgDisplayName(instance, position: position)
		end 'declaredAtAnInstantiatedExistential'

		if self.valueTagOf(receiver) != ValueTypeTag.typeParameter 'notAConstrainedParameter'
			throw MapError.keyNotFound
		end 'notAConstrainedParameter'

		let token = try self.valueNameIds.get(receiver) otherwise throw MapError.keyNotFound
		let bindings = constrainedParamAssociatedBindings(self.signatures, token: token, interfaceName: interfaceName)
		if position >= bindings.count() 'theConstraintBoundNothingHere'
			throw MapError.keyNotFound
		end 'theConstraintBoundNothingHere'

		return try bindings.get(position) otherwise panic("receiverSiteBinding: bindings.get OOB at {position} below count {bindings.count()}")
	end 'receiverSiteBinding'

	// Witness slot `methodIndex` of the interface `interfaceDeclIndex` names — the same `(interface, slot)` pair
	// `Parser.appendInterfaceDispatchCandidates` numbered the dispatch by, so the requirement this recovers is
	// the one the call was resolved against.
	function witnessRequirementSlot(methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex) returns CollectedInterfaceMethod
		let slots = self.witnessSlotsOf(interfaceDeclIndex)
		return try slots.get(methodIndex) otherwise panic("witnessRequirementSlot: slot {methodIndex} is outside the {slots.count()} witness slots of interface {interfaceDeclIndex} — the op's `(interfaceDeclIndex, methodIndex)` pair was numbered against a different slot list")
	end 'witnessRequirementSlot'

	// ⭐ **THE INTERFACE A DISPATCH'S HANDLE NAMES, RESOLVED THROUGH THE ONE RULE** — `lookupInterface`, over
	// the merged registry this pass holds, so a synthesized protocol answers before any user declaration
	// exactly as it does at every other reader. `ProgramSignatures` stores the NAME rather than the
	// declaration precisely so this resolution happens here (see `interfaceNamesInDeclOrder`).
	//
	// ⚠⚠ **THE HANDLE IS MINTED AGAINST ONE STORE AND RESOLVED AGAINST ANOTHER, AND THAT SEAM IS ASSERTED.**
	// `Parser.appendInterfaceDispatchCandidates` numbers the dispatch against `ProgramSignatures`, whose
	// interfaces `foldInterfaceDeclarations` writes; this resolves against `project.interfaces`, which
	// `ParseStaging.mergeArtifact` writes. Two writers of what must be one declaration. If they ever
	// disagreed about `methods` or `extendsInterfaces`, `methodIndex` would recover a DIFFERENT requirement
	// and set a wrong ABI for the call — a wrong answer, not a compile error, on every target. The slot COUNT
	// is the cheap witness of that agreement (it is exactly what `methodIndex` is an index into), so it is
	// compared here rather than hoped for: one `interfaceWitnessSlots` walk of the signature-index
	// declaration against the memoized walk of the merged one, on the FIRST dispatch through each interface
	// and never again.
	function interfaceAtDeclIndex(interfaceDeclIndex InterfaceDeclIndex) returns IrInterface
		let name = self.signatures.interfaceNameAtDeclIndex(interfaceDeclIndex)
		match lookupInterface(self.interfaces, name: name) 'resolve'
			found(iface) then return iface
			notFound then panic("interfaceAtDeclIndex: interface '{String.from(name)}' holds position {interfaceDeclIndex} in the signature index but resolves to nothing in the merged registry — a witness dispatch was numbered against a declaration the merge did not carry")
		end 'resolve'
	end 'interfaceAtDeclIndex'

	// The slot-count agreement `interfaceAtDeclIndex`'s header states, asked once per interface at the moment
	// its slot list is first built. It walks the SIGNATURE-INDEX declaration — the one the parser numbered
	// against — and compares its slot count with the merged one's, which is the only property `methodIndex`
	// rests on.
	function requireSlotNumberingAgrees(interfaceDeclIndex InterfaceDeclIndex, mergedSlots CollectedInterfaceMethodArray)
		let name = self.signatures.interfaceNameAtDeclIndex(interfaceDeclIndex)
		match lookupInterface(self.signatures.interfaceMap(), name: name) 'asTheParserSawIt'
			// A synthesized protocol is in NEITHER map — `lookupInterface` builds it fresh from the same
			// constants on both sides, so there is no second writer to disagree with and nothing to compare.
			notFound then return
			found(parserIface) then requireSameSlotNumbering(name, parserSlots: interfaceWitnessSlots(self.signatures.interfaceMap(), iface: parserIface), mergedSlots: mergedSlots)
		end 'asTheParserSawIt'
	end 'requireSlotNumberingAgrees'

	// `interfaceDeclIndex`'s transitive witness slot list, built on the FIRST dispatch through that interface
	// and held after — the lowering's twin of `Parser.witnessSlotsOf`, memoized for the reason stated there.
	//
	// ⚠ **THE MEMO IS NOT AN OPTIMIZATION.** `interfaceWitnessSlots` walks the `extends` graph and builds a
	// fresh array plus a visited set on every call; asked once per dispatch OP that is the measured quadratic
	// the parser's memo exists to remove, ported into a second pass. Keyed the same way, on the same property:
	// the list is a pure function of the interface, which is fixed before any body is parsed. The two-store
	// agreement check rides the same first walk, so it costs one extra walk per INTERFACE, not per dispatch.
	function witnessSlotsOf(interfaceDeclIndex InterfaceDeclIndex) returns CollectedInterfaceMethodArray
		if let memoized = try self.witnessSlotMemo.get(interfaceDeclIndex) 'alreadyWalked'
			return memoized
		end 'alreadyWalked'

		let slots = interfaceWitnessSlots(self.interfaces, iface: self.interfaceAtDeclIndex(interfaceDeclIndex))
		self.requireSlotNumberingAgrees(interfaceDeclIndex, mergedSlots: slots)
		self.witnessSlotMemo.upsert(interfaceDeclIndex, value: slots)
		return slots
	end 'witnessSlotsOf'

	// ⭐ **LOWER A CONSTRAINED-TYPE-PARAMETER DISPATCH TO THE FUSED `StdOp.witnessCall` (P1.7a slice 2a).** The
	// witness ADDRESS is the enclosing (generic) function's own threaded witness parameter for this constraint
	// — FORWARDED, exactly as `forwardCallerLayout` forwards the layout descriptor: a `witnessDispatch` is only
	// ever emitted inside a generic body, whose `T` witness arrived as a hidden parameter (the concrete
	// `__witness_<Type>.<Iface>` was materialized at the CALL SITE and passed in). Re-matched in a SMALL match
	// so `args` is bound in a single-call arm, never in `lowerOp`'s big one (the tail-slot-Array decref
	// corruption `lowerIndirectCall` documents).
	function lowerWitnessDispatch(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'w'
			witnessDispatch(result, args, witness, methodIndex, interfaceDeclIndex, isVoid, _) then self.appendWitnessCall(dstBlock, result: result, args: args, witness: witness, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, isVoid: isVoid)
			default panic("lowerWitnessDispatch: expected a `witnessDispatch` op, got a different MaxonOp variant — `lowerOp` routes only `witnessDispatch` here")
		end 'w'
	end 'lowerWitnessDispatch'

	// ⭐ **LOWER A THROWING CONSTRAINED-TYPE-PARAMETER DISPATCH TO THE FUSED `StdOp.witnessTryCall` (P1.7a
	// slice 2b-v).** `witnessTryDispatch : witnessDispatch :: tryCall : call`, so this is the non-throwing
	// lowering plus the one thing a throwing call adds — the second `errorFlag` result captured from the
	// dual-register error ABI. Re-matched in a SMALL match so `args` is bound in a single-call arm, never in
	// `lowerOp`'s big one (the tail-slot-`Array` decref corruption `lowerIndirectCall` documents).
	function lowerWitnessTryDispatch(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'w'
			witnessTryDispatch(result, errorFlag, args, witness, methodIndex, interfaceDeclIndex, isVoid) then self.appendWitnessTryCall(dstBlock, result: result, errorFlag: errorFlag, args: args, witness: witness, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, isVoid: isVoid)
			default panic("lowerWitnessTryDispatch: expected a `witnessTryDispatch` op, got a different MaxonOp variant — `lowerOp` routes only `witnessTryDispatch` here")
		end 'w'
	end 'lowerWitnessTryDispatch'

	// Build the Std `witnessCall`: jump through the table `witness` holds, then capture the result exactly as
	// `appendCallIndirect` does (an `isVoid` method leaves no result register to capture, so its `resultType`
	// is `void`). A helper because `lowerWitnessDispatch`'s arm must hand `args` to a function and touch it no
	// other way (see there and `lowerIndirectCall`).
	//
	// ⭐ **THE WITNESS ARRIVES AS A VALUE AND THIS LOWERING RESOLVES NOTHING (P1.7a-existentials slice 1).**
	// It used to take a `constraintIndex` and turn it into the enclosing function's hidden witness parameter,
	// which meant re-deriving whole-program a count the PARSER had already reserved — and left an existential
	// receiver, whose witness is the fat pointer's own second half, with no index to name. The parser resolves
	// its own reservation now (`Parser.witnessParamValueId`), so both receiver kinds arrive here already
	// pointing at a value and this is the single Std emission for them.
	function appendWitnessCall(dstBlock IrBlock, result ValueId, args ValueIdArray, witness ValueId, methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex, isVoid bool)
		let resultType = self.witnessCallResultType(result, isVoid: isVoid)
		let declaredParams = self.witnessFormalTypes(methodIndex, interfaceDeclIndex: interfaceDeclIndex, receiver: witnessDispatchReceiver(args))
		self.stdModule.appendOp(dstBlock, op: StdOp.witnessCall(result, witnessAddr: witness, methodIndex: methodIndex, resultType: resultType, argFloatMask: paramFloatMask(declaredParams), args: self.crossFloatDomainArgs(args, paramTypes: declaredParams, callee: NoNamedCallee, dstBlock: dstBlock)))
	end 'appendWitnessCall'

	// The throwing twin of `appendWitnessCall`, sharing its result typing (`witnessCallResultType`) verbatim —
	// the two differ ONLY in which Std op they append and in the second result the throwing one defines. A
	// helper for the same reason its twin is one: `lowerWitnessTryDispatch`'s arm must hand `args` to a
	// function and touch it no other way.
	function appendWitnessTryCall(dstBlock IrBlock, result ValueId, errorFlag ValueId, args ValueIdArray, witness ValueId, methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex, isVoid bool)
		let resultType = self.witnessCallResultType(result, isVoid: isVoid)
		let declaredParams = self.witnessFormalTypes(methodIndex, interfaceDeclIndex: interfaceDeclIndex, receiver: witnessDispatchReceiver(args))
		self.stdModule.appendOp(dstBlock, op: StdOp.witnessTryCall(result, errorFlagId: errorFlag, witnessAddr: witness, methodIndex: methodIndex, resultType: resultType, argFloatMask: paramFloatMask(declaredParams), args: self.crossFloatDomainArgs(args, paramTypes: declaredParams, callee: NoNamedCallee, dstBlock: dstBlock)))
	end 'appendWitnessTryCall'

	// The Std return type a witness call CAPTURES its result in — the result value's own type, or `void` for
	// an `isVoid` method (no result register to capture). Shared by both witness lowerings so the throwing and
	// non-throwing forms cannot drift on how a result is typed.
	//
	// ⚠ **IT READS THE VALUE COLUMN WHERE `witnessFormalTypes` MAY NOT, AND THE ASYMMETRY IS EARNED — BUT
	// ONLY BECAUSE THE ONE CASE IT COULD NOT COVER IS NOW REFUSED.** A witness call's ARGUMENT widths cannot
	// come from `stdTypeOf`: the parser tags an `ExitCode` ANNOTATION as a bare `named` and that collapses to
	// the wrong width (see there). The RESULT is the opposite case for a requirement whose return type the
	// interface SPELLS — `Parser.interfaceReturnMaxonType` asks `TypeResolution.builtinTypeNameTag` about that
	// spelling, so the tag on the value IS the interface's own answer already, the formals rule arriving by a
	// shorter road rather than a second source. That is the W1 fix, and
	// `where-clauses.witness-exitcode-return-high` pins it.
	//
	// ⚠ The road does NOT reach a return the interface leaves to a conformer. An ASSOCIATED return type
	// spells only the `uses` name, so that door answers `named` → `int` while the impl returns whatever was
	// bound — MEASURED at 35 on x64 where the program computes 31, and a trap on wasm. Fixing it needs the
	// binding at PARSE time, which no store holds mid-parse, so it is REFUSED instead: E3120, in
	// `ConformanceCheck.checkAssociatedReturnIsMachineWord`. Every return that reaches here is therefore one
	// the interface itself names, and this reads the right width for all of them.
	function witnessCallResultType(result ValueId, isVoid bool) returns StdReturnType
		return StdReturnType.void if isVoid else StdReturnType.value(self.stdTypeOf(result))
	end 'witnessCallResultType'

	// The Std type an indirect call CAPTURES its result in — normally the result value's own type. But a
	// VOID function value (`let cb = doIt; cb()` at statement position, P1.5 #68) has NO result to capture:
	// like a void DIRECT call, whose return register holds a garbage integer nobody reads
	// (StdLoweringShared.calleeResultClass), its result is captured as a garbage i64. `stdTypeOf`/
	// `valueTagToStdType` deliberately PANIC on a void tag — a void value can never be an OPERAND — but a
	// call RESULT is a def, not an operand, so the void case is handled here rather than by widening that
	// guard. The `__fnref_` thunk of a void target returns exactly this dummy i64 (Runtime/FnRefThunk), so
	// the capture register (native) and the `call_indirect` result functype (wasm) agree with it.
	function indirectResultType(result ValueId) returns StdType
		let tag = self.valueTagOf(result)
		return StdType.i64 if tag == ValueTypeTag.void else valueTagToStdType(tag)
	end 'indirectResultType'

	// ⭐ **`async f(args…)` → SPAWN A GREEN THREAD** (P1.5-B1a). The arguments are slotted to parameter order
	// (`slotCallArgs`, exactly as `lowerCall`), then spilled into the GT struct's INLINE arg region — one
	// `storeIndirect` per argument, the trampoline reading them back into the ABI argument registers. The
	// callee's DIRECT `.text` address (`funcAddr`, NOT a `__fnref_` thunk: the trampoline calls it with user
	// arguments only, its own `(userargs) -> R` shape) becomes `__gt_spawn(funcPtr)`, whose result is the Promise
	// handle (the GT struct pointer). No float widening is possible — SemanticCheck refused a non-scalar
	// parameter — so the slotted args pass through as i64 without `finalizeCallArgs`.
	function lowerAsyncCall(result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argDefaultSlots ParamCountArray, dstBlock IrBlock)
		let sig = try self.funcSignatures.get(callee) otherwise panic("lowerAsyncCall: async callee '{String.from(callee)}' has no signature — SemanticCheck must reject an unknown callee before lowering")
		match slotCallArgs(sig.paramNames, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots) 'slot'
			ordered(argIds) then self.emitAsyncSpawn(result, callee: callee, argIds: argIds, dstBlock: dstBlock)
			arityMismatch then panic("lowerAsyncCall: arity mismatch for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			unknownLabel then panic("lowerAsyncCall: unknown argument label for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			duplicateArg then panic("lowerAsyncCall: duplicate argument for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
		end 'slot'
	end 'lowerAsyncCall'

	// Emit the direct function address, the `__gt_spawn(funcPtr)` call, and the argument spills into the GT
	// struct's INLINE arg region, given the arguments already slotted to parameter order. Split out of
	// `lowerAsyncCall` so the slotting `match` uses statement arms (a panic on a mis-slotting SemanticCheck
	// should have gated), the same shape `lowerCall` uses.
	function emitAsyncSpawn(result ValueId, callee ByteArray, argIds ValueIdArray, dstBlock IrBlock)
		// The inline region is a FIXED MaxAsyncArgs slots; one store per argument at `GtOffArgInline + k *
		// GtArgSlotBytes`. A callee with more arguments than that would store PAST the region — a silent struct
		// overrun the trampoline then mis-loads — so this stays as the STRUCTURAL BACKSTOP.
		//
		// ⚠ It is a backstop and no longer the only guard: `Parser.emitAsyncCall` refuses the same program with
		// a positioned diagnostic naming `MaxAsyncArgs`. It used to be the only one, under a comment claiming it
		// "cannot fire today" because MaxAsyncArgs equalled the parser's six-register parameter cap — which
		// stopped being true the moment ordinary calls gained stack arguments and the cap went. Reaching here
		// now means the parser's gate was bypassed (a synthesized spawn, a new async lowering path), which is a
		// compiler bug and belongs in a panic.
		if argIds.count() > MaxAsyncArgs 'overflow'
			panic("emitAsyncSpawn: async callee '{String.from(callee)}' has {argIds.count()} arguments but the inline arg region holds only MaxAsyncArgs ({MaxAsyncArgs}) slots — `Parser.emitAsyncCall` refuses a source-level spawn past that, so this spawn reached lowering without passing it")
		end 'overflow'

		// funcPtr = &callee ; result = __gt_spawn(funcPtr) — the Promise handle (the GT struct pointer). The arg
		// region is now INLINE in the struct (P1.5-B1c #87), so there is no separate slab buffer to allocate.
		let funcPtr = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.funcAddr(funcPtr, funcName: callee))
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: GtSpawnName, args: argsOf(funcPtr)))

		// Fill the struct's inline arg region: one store per argument at `result + GtOffArgInline + k * GtArgSlotBytes`.
		// `__gt_spawn` set `gt.argBuf` to a self-pointer at `GtOffArgInline`, and the allocator's zeroing left the
		// unfilled slots at 0 (harmlessly loaded into unread argument registers).
		//
		// ⚠⚠ **THE GT IS NOT DISCOVERABLE UNTIL `__gt_ready` BELOW, AND THAT ORDER IS THE WHOLE OF THIS
		// SEQUENCE'S CORRECTNESS.** These stores used to run AFTER `__gt_spawn` had already enqueued the thread,
		// under a comment reading *"SAFE to fill AFTER the spawn: a spawned GT is only ENQUEUED, not run, until
		// awaited (single-M)"*. A worker M falsifies that premise, and it was MEASURED doing so: at
		// `MAXON_MAX_PROCS=12`, 600 threads each reading one integer argument summed to a DIFFERENT wrong total
		// on every run, because a worker dequeued and ran them while this loop was still writing. Publishing
		// last removes the premise rather than restating it — see `GtRuntime.GtReadyName`.
		for k in 0 upto argIds.count() 'eachArg'
			let argId = try argIds.get(k) otherwise panic("emitAsyncSpawn: argIds.get OOB at {k}")
			self.stdModule.appendOp(dstBlock, op: StdOp.storeIndirect(result, offset: (GtOffArgInline + k * GtArgSlotBytes) as ByteOffset, valueId: argId, valueType: StdType.i64))
		end 'eachArg'

		self.emitAsyncReleaserStore(result, callee: callee, dstBlock: dstBlock)

		// PUBLISH. Everything the trampoline and the releaser read is now written.
		let readyResult = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.call(readyResult, callee: GtReadyName, args: argsOf(result)))
	end 'emitAsyncSpawn'

	// ⭐⭐ **LEAVE THE THREAD THE ADDRESS OF THE CODE THAT KNOWS HOW TO RELEASE IT (A2).** `gt.releaser` is
	// read by `__gt_await` (result CONSUMED) and by `__gt_promise_drop` (result NOT consumed), which is where
	// the reference `Parser.transferAsyncSpawnArgs` took for each managed argument is given back.
	//
	// **A CALLEE WITH NOTHING TO RELEASE STORES NOTHING AT ALL**, rather than storing 0: `__gt_spawn`'s slab
	// zeroes (fresh) and whole-struct memzero (recycled) have already put 0 there, so the store would be
	// redundant — and leaving it out is what keeps every existing scalar async golden byte-identical. That
	// makes the memzero load-bearing for a THIRD reason, which `GtOffReleaser`'s header records: without it a
	// recycled struct would inherit the previous tenant's releaser and free that tenant's arguments out of
	// stale slots.
	//
	// ⚠ Whether a releaser EXISTS is `asyncCalleeNeedsReleaser`'s answer and is not restated here — see there
	// for why a disagreement between this site and the synthesis is a compile error at neither, and for which
	// of the two directions leaks silently.
	function emitAsyncReleaserStore(gt ValueId, callee ByteArray, dstBlock IrBlock)
		if not asyncCalleeNeedsReleaser(callee, funcSignatures: self.funcSignatures, signatures: self.signatures, typeNames: self.typeNames) 'nothingToRelease'
			return
		end 'nothingToRelease'

		let releaserPtr = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.funcAddr(releaserPtr, funcName: asyncReleaserName(callee)))
		self.stdModule.appendOp(dstBlock, op: StdOp.storeIndirect(gt, offset: GtOffReleaser as ByteOffset, valueId: releaserPtr, valueType: StdType.i64))
	end 'emitAsyncReleaserStore'

	// ⭐⭐ **`spawn <T>.<factory>(…)` → `__svc_spawn(&<T>.__loop, state, &<T>.request's drop)` (SV1 wave 3).**
	// The op carries the TYPE and the state; the two ADDRESSES are derived here, from that one name, because
	// deriving them at the parse would put the loop's symbol in a second place and the abandon callee in a
	// third — and a `funcAddr` naming a symbol nothing built is a link failure with no line on it.
	//
	// ⭐⭐ **THE ABANDON CALLEE IS `<T>.__abandon` SINCE SV2, AND IT WAS THE REQUEST UNION'S BARE CASCADE.**
	// `SERVICES_DESIGN.md` reserved such a function and SV1 argued it away — *"in shv2 that is the
	// tag-conditional `__destruct_<U>` cascade P1.3 already emits"* — which was right while a dead message
	// owed nothing but its payloads. A dead message now also owes its AWAITER an answer, and leaving one
	// parked for a reply that will never come is a hang with no diagnostic; `Project.serviceAbandonSymbol`
	// states the obligation, and `<T>.__abandon`'s own body still ends in that very cascade.
	//
	// ⚠ Both symbols are ROOTED by these two `funcAddr`s, which `DeadFunctionElimination` treats as static
	// edges (`funcAddrCalleeEdge` — v1 shipped that arm MISSING). The loop is additionally reachable from
	// nothing else at all, which is what keeps a service-free program's output byte-identical.
	function lowerServiceSpawn(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 's'
			serviceSpawn(result, typeName, state) then self.emitServiceSpawn(result, typeName: typeName, state: state, dstBlock: dstBlock)
			default panic("lowerServiceSpawn: expected a `serviceSpawn` op, got a different MaxonOp variant — `lowerOp` routes only `serviceSpawn` here")
		end 's'
	end 'lowerServiceSpawn'

	function emitServiceSpawn(result ValueId, typeName ByteArray, state ValueId, dstBlock IrBlock)
		let loopPtr = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.funcAddr(loopPtr, funcName: serviceLoopSymbol(typeName)))
		let abandonPtr = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.funcAddr(abandonPtr, funcName: serviceAbandonSymbol(typeName)))
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: SvcSpawnName, args: threeArgs(loopPtr, second: state, third: abandonPtr)))
	end 'emitServiceSpawn'

	// ⭐ **`h.m(…)` → `__mbox_send(mailbox, request)` (SV1 wave 3).** Everything else about a send happened at
	// the parse: the arguments were MOVED into the request box, the box was built and tagged, and the mailbox
	// was loaded out of the handle. The op's `callee` is carried for `UnusedExportCheck` and `StdlibSource`,
	// which read it as a reference to the message — neither is a lowering question, so nothing here reads it.
	function lowerServiceSend(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 's'
			serviceSend(result, _, handle, request) then self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: MboxSendName, args: twoArgs(handle, second: request)))
			default panic("lowerServiceSend: expected a `serviceSend` op, got a different MaxonOp variant — `lowerOp` routes only `serviceSend` here")
		end 's'
	end 'lowerServiceSend'

	// ⭐⭐ **`serviceReplyCell` → `__gt_cell_alloc(&__gt_reply_release_<message>)` (SV2).** The op carries the
	// MESSAGE's name and the one address is derived here, from that name, on `emitServiceSpawn`'s precedent
	// and for its reason: deriving it at the parse would put the releaser's symbol in a second place, and a
	// `funcAddr` naming a symbol nothing built is a link failure with no line on it.
	//
	// ⚠ **A MESSAGE WHOSE REPLY OWNS NO HEAP WRITES A NULL RELEASER, and that is the common case.** The cell
	// is slab-zeroed, so a plan `serviceReplyNeedsReleaser` answers false for stores nothing at all and both
	// release sites read the 0 and SKIP — `emitAsyncReleaserStore`'s arrangement one road over.
	function lowerServiceReplyCell(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 's'
			serviceReplyCell(result, messageName) then self.emitServiceReplyCell(result, messageName: messageName, dstBlock: dstBlock)
			default panic("lowerServiceReplyCell: expected a `serviceReplyCell` op, got a different MaxonOp variant — `lowerOp` routes only `serviceReplyCell` here")
		end 's'
	end 'lowerServiceReplyCell'

	function emitServiceReplyCell(result ValueId, messageName ByteArray, dstBlock IrBlock)
		let releaserPtr = self.mintStdValueId()
		if serviceReplyNeedsReleaser(messageName, funcSignatures: self.funcSignatures, signatures: self.signatures, typeNames: self.typeNames) 'ownsAResult'
			self.stdModule.appendOp(dstBlock, op: StdOp.funcAddr(releaserPtr, funcName: serviceReplyReleaserName(messageName)))
		end 'ownsAResult' else 'nothingToRelease'
			self.stdModule.appendOp(dstBlock, op: StdOp.const(releaserPtr, value: 0, valueType: StdType.i64))
		end 'nothingToRelease'
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: GtCellAllocName, args: argsOf(releaserPtr)))
	end 'emitServiceReplyCell'

	// `await p` → `__gt_await(p)`. The scheduler drive is entirely in the runtime; here it is a plain call
	// yielding the awaited scalar in R8.
	function lowerAwait(result ValueId, promise ValueId, dstBlock IrBlock)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: GtAwaitName, args: argsOf(promise)))
	end 'lowerAwait'

	// `try await p` → `__gt_try_await(p)`, a THROWING call: the awaited scalar in R8 (`result`), the error
	// flag in R10 (`errorFlag`). The runtime driver returns both through `errorReturn`; this `tryCall`
	// captures both, exactly as `lowerTryCall` does for a throwing free call. The parser's `try … otherwise …`
	// desugar (already emitted around this op) reads the flag.
	function lowerTryAwait(result ValueId, errorFlag ValueId, promise ValueId, dstBlock IrBlock)
		self.stdModule.appendOp(dstBlock, op: StdOp.tryCall(result, errorFlagId: errorFlag, callee: GtTryAwaitName, args: argsOf(promise)))
	end 'lowerTryAwait'

	// Materialize a function value's `.text` address (P1.5-A2b-2). Under the uniform `(userargs, env) -> R`
	// ABI every USER function value is called through the SAME indirect signature, so the address must name a
	// function of that shape. A LIFTED CLOSURE already is one (its trailing `__env` parameter). A PLAIN named
	// function is not, and its direct calls must stay unchurned — so its value use materializes the address of
	// its `__fnref_` thunk instead, which `installFnRefThunks` synthesizes with the env-carrying signature.
	// The thunk names cannot drift: `fnRefThunkName` is the ONE builder both this site and the synthesis read.
	//
	// Whether a bridge is needed at all is NOT decided here: it is `FnRefThunk.functionValueNeedsEnvThunk`, the
	// one place that rule lives, because `collectFnRefThunkTargets` must reach the SAME verdict and a
	// disagreement between the two is a compile error at neither — see that predicate's header, and the
	// `wasm trap: indirect call type mismatch` the A1r review measured when the rule was written out twice.
	function lowerFunctionRef(result ValueId, funcName ByteArray, dstBlock IrBlock)
		let target = fnRefThunkName(funcName) if functionValueNeedsEnvThunk(funcName, funcSignatures: self.funcSignatures) else funcName
		self.stdModule.appendOp(dstBlock, op: StdOp.funcAddr(result, funcName: target))
	end 'lowerFunctionRef'

	// ⭐ **int→float ARGUMENT WIDENING (F3a)** — the CALL-SITE dual of the `return`/assignment float
	// coercions the parser already owns, and it lives HERE because this is the first tier that holds a
	// callee's ALIAS-RESOLVED parameter types (`funcSignatures` re-synced by TypeResolution, and
	// `functionAliasShapes` built by it) beside the one `slotCallArgs` the check and the lowering share.
	// BOTH call shapes route through it — a direct call with its callee's signature, an indirect one with
	// the shape of the function type its callee VALUE was declared with — so there is one answer to
	// "which arguments widen" and it does not depend on how the callee was named. An integer argument at a `float`
	// parameter is a LOSSLESS widening the language performs implicitly — `SemanticCheck.checkArgTypes`
	// accepts it as `ok` (the lossy `float`→`int` is E3009, and is NOT this) — but the int value is
	// born in a GPR while a float parameter is passed in an XMM register, so with no conversion the
	// backend meets a GPR→XMM move that `crosses register files` and panics. Each integral ordered
	// argument at a float parameter is converted with `siToFp` (`cvtsi2sd`), the SAME op
	// `Parser.promoteToFloat` inserts for `x + 2.0`; the result is XMM-classed (`unaryResultClass`), so
	// the value-class column and the backend's XMM arg routing (`argFpRegisterAt`) then agree the
	// argument belongs in an XMM slot — this pass inserts the conversion and the backend needs no change.
	//
	// ⚠ THE PARSER CANNOT DO THIS. A callee's parameter types are a WHOLE-PROGRAM fact — the callee may
	// be declared in another file — and shv2 has them only after the per-file parses merge (the
	// SignatureIndex carries return types, not parameter types). This tier is the first place they
	// exist, resolved.
	//
	// It EMITS each conversion into `dstBlock` before returning, so the `call`/`tryCall` the caller
	// appends NEXT sees the converted value already defined (the emit happens while this call's result
	// is evaluated as the `args:` argument, ahead of the enclosing `appendOp`).
	//
	// ⚠ **AN ARGUMENT PAST THE LAST DECLARED PARAMETER PASSES THROUGH.** An INDIRECT call's `args` carries
	// one more entry than its function type declares — the uniform-ABI companion env pointer
	// (`IndirectCallEnvArgCount`), an i64 the compiler appended and no parameter describes. Indexing a
	// parameter for it would panic, and slicing it off first would allocate an array on every indirect call
	// merely to hand the same values back. A DIRECT call never takes this path: `slotCallArgs` returns
	// exactly one ordered argument per parameter, so the counts are equal and nothing is skipped. Too FEW
	// arguments is a program error `SemanticCheck` has already refused (E3036) for both shapes.
	// ⚠⚠ **A BY-REFERENCE POSITION CROSSES NO DOMAIN, AND WITHOUT THIS THE FLOAT CASE IS A BACKEND PANIC
	// (PBR-2).** The argument at such a position is the ADDRESS of a cell, an integer; the callee's declared
	// type is the type of what the cell HOLDS. Compared naively the two disagree in exactly the way an
	// int-at-a-float-parameter does, so the widening fired on a pointer — MEASURED as
	// `a register-to-register move from xmm0 to rcx crosses register files` out of the x64 emitter, on
	// `pass-by-reference.mutate-float-ref`. `callee` is threaded in for this one question; an INDIRECT call
	// cannot reach a by-reference parameter at all (a function TYPE carries no by-reference-ness), which is
	// why `paramFloatMask`'s two indirect callers need no equivalent.
	function crossFloatDomainArgs(argIds ValueIdArray, paramTypes MaxonTypeArray, callee ByteArray, dstBlock IrBlock) returns ValueIdArray
		// FAST PATH, and it is what keeps this allocation-neutral on the hot call-lowering path: a call
		// whose arguments are already in the domain their parameters want returns them verbatim — no
		// `ValueIdArray` built, no op emitted. Without it every lowered call allocates a fresh array it
		// never changes (measured: a linear per-call allocation delta across the scale ladder).
		//
		// ⚠ **THE SCAN ASKS THE EXACT PER-ARGUMENT QUESTION, NOT A CHEAPER APPROXIMATION OF IT.** It used to
		// ask only whether the SIGNATURE had a float parameter, which the opaque-word direction cannot be
		// expressed in — a `T` parameter is an i64 — so widening the approximation to "float or type
		// parameter" would have allocated at every `push`, `set` and `get` of every generic container. Asked
		// exactly, the scan allocates nothing and answers for both directions at once.
		if not self.anyArgCrossesTheFloatDomain(argIds, paramTypes: paramTypes) 'everyArgAlreadyInItsDomain'
			return argIds
		end 'everyArgAlreadyInItsDomain'

		var crossed = ValueIdArray.create()
		for i in 0 upto argIds.count() 'eachArg'
			let argId = try argIds.get(i) otherwise panic("crossFloatDomainArgs: argIds.get OOB at {i}")
			if i >= paramTypes.count() 'pastDeclaredParams'
				crossed.push(argId)
				continue
			end 'pastDeclaredParams'
			// The scalar gate first, for `Parser.bindParameters`' measured reason: `paramIsByRef` returns a
			// union, and this loop runs per argument of every call that crosses the float domain.
			if self.signatures.programTakesAParamByRef() and self.signatures.paramIsByRef(callee, index: i) 'anAddressRatherThanAValue'
				crossed.push(argId)
				continue
			end 'anAddressRatherThanAValue'

			let paramType = try paramTypes.get(i) otherwise panic("crossFloatDomainArgs: paramTypes.get OOB at {i} — the bound was just tested")
			crossed.push(self.floatDomainCrossedArg(argId, paramType: paramType, dstBlock: dstBlock))
		end 'eachArg'
		return crossed
	end 'crossFloatDomainArgs'

	// The fast path's scan and the loop's test are ONE predicate, asked once per position each — so a call
	// this declines to rebuild is exactly a call in which `floatDomainCrossedArg` would have handed every
	// argument back unchanged. Two spellings would be two chances to skip a conversion the loop would have
	// made, which is a wrong register file rather than a diagnostic.
	//
	// An argument past the last declared parameter passes through untouched (the enclosing header says why an
	// indirect call has one), so the scan stops at the shorter of the two columns rather than asking about a
	// position no parameter describes.
	// ⚠ The gate and the loop must agree about by-reference positions, or the fast path returns the argument
	// list verbatim for a call whose only crossing was one this pass must NOT perform — which is the correct
	// answer, so the gate deliberately does NOT ask about them: a by-reference position that "crosses" here
	// simply means the loop below will decline it. Over-answering costs one array build on such a call.
	function anyArgCrossesTheFloatDomain(argIds ValueIdArray, paramTypes MaxonTypeArray) returns bool
		let declared = paramTypes.count()
		for i in 0 upto argIds.count() 'eachArg'
			if i >= declared 'pastDeclaredParams'
				break
			end 'pastDeclaredParams'

			let argId = try argIds.get(i) otherwise panic("anyArgCrossesTheFloatDomain: argIds.get OOB at {i}")
			let paramType = try paramTypes.get(i) otherwise panic("anyArgCrossesTheFloatDomain: paramTypes.get OOB at {i} — the bound was just tested")
			if self.argCrossesTheFloatDomain(argId, paramType: paramType) 'crosses'
				return true
			end 'crosses'
		end 'eachArg'
		return false
	end 'anyArgCrossesTheFloatDomain'

	// ⭐⭐ **DOES THIS ARGUMENT HAVE TO CHANGE REGISTER FILES TO REACH ITS PARAMETER?** Two directions, and
	// they are one question because they are one boundary:
	//
	//   • **INTO a float parameter** (F3a) — the argument is an integer, and a non-float argument bound for a
	//     float parameter is ALWAYS one: `SemanticCheck` has already rejected every other type (E3005).
	//   • **INTO A TYPE PARAMETER'S OPAQUE WORD** — the argument is a float and the parameter is a `T`. shv2
	//     DICTIONARY-PASSES, so `push(value Element)` is compiled ONCE for every instantiation at once and
	//     its formal is the 8-byte GENERAL-PURPOSE slot every type parameter travels in. An f64 actual is born
	//     in XMM, so handing it over unconverted asks the emitter to move xmm0 into rax: MEASURED on
	//     `a.growFilled(4, value: 3.5)` over an `Array with float` once `stdlib/Array.maxon` is listed —
	//     *"a register-to-register move from xmm0 to rax crosses register files"* (`X64Backend:834`).
	//
	// ⚠ A parameter cannot be both: a `typeParameter` lowers to i64, never to f64.
	function argCrossesTheFloatDomain(argId ValueId, paramType MaxonType) returns bool
		if stdTypeIsFloat(maxonTypeToStdType(paramType)) 'aFloatParameter'
			return not stdTypeIsFloat(self.stdTypeOf(argId))
		end 'aFloatParameter'

		return maxonTypeTag(paramType) == ValueTypeTag.typeParameter and stdTypeIsFloat(self.stdTypeOf(argId))
	end 'argCrossesTheFloatDomain'

	// One argument: converted when `argCrossesTheFloatDomain` says it must, else the argument verbatim. The
	// conversion REUSES `lowerUnaryOp`, so the op construction and its guard stay in the one place that owns
	// them, and every conversion this picks genuinely crosses the domain — which is what keeps
	// `assertConversionCrossesDomain` satisfied in both directions.
	//
	// ⭐⭐ **WHICH CONVERSION IS NOT THE SAME QUESTION AS WHETHER (A4o).** An ordinary integer WIDENS
	// (`promoteToFloat` → `siToFp`); a FLOAT-BACKED ENUM's i64 is already the double's IEEE-754 encoding and
	// is REINTERPRETED (`bitsToFloat` → `bitcastI64ToF64`). MEASURED with only the widening here:
	// `takesFloat(Weight.light)` for `light = 2.5` printed **4612811918334231000.0**.
	//
	// ⚠ **AND THIS IS THE ONE SUCH SITE THE PARSER CANNOT OWN**, which is why the fix lands at this tier
	// rather than beside its five siblings in `Parser.floatBehindEnumValue`: the conversion is forced by the
	// CALLEE's declared parameter type, a whole-program fact a file's parse may not hold (this function's
	// own header states the same split for the widening). The enum identity survives to here only because
	// the parser publishes `valueTags`/`valueNameIds` on the `IrFunction` — by the Std tier itself, a
	// float-backed enum and an `int` are both `i64`.
	function floatDomainCrossedArg(argId ValueId, paramType MaxonType, dstBlock IrBlock) returns ValueId
		if not self.argCrossesTheFloatDomain(argId, paramType: paramType) 'alreadyInItsDomain'
			return argId
		end 'alreadyInItsDomain'

		let converted = self.mintStdValueId()
		self.lowerUnaryOp(converted, operand: argId, op: self.floatDomainCrossingOp(argId, paramType: paramType), dstBlock: dstBlock)
		return converted
	end 'floatDomainCrossedArg'

	// WHICH conversion the crossing above is. The opaque-word direction is a REINTERPRETATION and not a
	// narrowing: the slot holds the f64's 64 bits, so `floatToBits` in and `bitsToFloat` out
	// (`Parser.emitCall`'s inverse half) round-trip every value including NaNs and the two zeros — the same
	// pairing `Parser.containerElementWord` states at the element boundary.
	function floatDomainCrossingOp(argId ValueId, paramType MaxonType) returns MaxonUnaryOp
		if maxonTypeTag(paramType) == ValueTypeTag.typeParameter 'intoTheOpaqueWord'
			return MaxonUnaryOp.floatToBits
		end 'intoTheOpaqueWord'

		return MaxonUnaryOp.bitsToFloat if self.argIsFloatBackedEnum(argId) else MaxonUnaryOp.promoteToFloat
	end 'floatDomainCrossingOp'

	// Is `value` a FLOAT-BACKED enum's — the question `floatDomainCrossingOp` picks its conversion by. The
	// Maxon-tier twin of `Parser.valueIsFloatBackedEnum`, reading the very columns that parser published,
	// so the two tiers cannot come to disagree about which values carry an encoded double.
	//
	// A name id that is not an enum's answers `false` through `enumIsFloatBacked`; an UNKNOWN id cannot
	// happen for a `named` value (the parser mints every one of them from this interner) and so panics
	// rather than being read as "not an enum", which would silently restore the widening.
	function argIsFloatBackedEnum(value ValueId) returns bool
		if self.valueTagOf(value) != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		let nameId = try self.valueNameIds.get(value) otherwise panic("argIsFloatBackedEnum: value v{value} has no recorded type name — the two type columns are minted in lockstep by Parser.mintValue")
		let name = try self.typeNames.nameOf(nameId) otherwise panic("argIsFloatBackedEnum: type-name id {nameId} is not in the whole-program interner — every `named` tag is minted with an id folded into it")
		return self.signatures.enumIsFloatBacked(name)
	end 'argIsFloatBackedEnum'

	// ⭐ **APPEND THE COMPANION ENVIRONMENT ARGUMENT FOR EACH FUNCTION-TYPED PARAMETER (P1.5-A2b-2).** The
	// uniform ABI splits a function value into (fn ptr, env): the slotted `argIds` carry the fn-ptr half at
	// each function-typed parameter's position, and this appends the env half — the argument value's OWN
	// environment (a capturing closure's block, else a null for a plain function reference or a non-capturing
	// closure). The environments append in PARAMETER order, exactly the order the callee's
	// `Parser.bindClosureEnvParams` assigned its companion parameters, so fn-ptr and env meet at the callee.
	// This is the DIRECT-call dual of `Parser.emitClosureEnvArg` (the indirect-call threading); it lives at
	// this tier because it needs the callee's ALIAS-RESOLVED parameter types (a `function` parameter may be
	// declared in another file), which the parser does not have.
	// The two call-argument transforms a slotted call needs, composed in one place so `lowerCall` and
	// `lowerTryCall` cannot apply them in different orders: an int→float widening at a float parameter (F3a),
	// then a companion environment appended per function parameter (P1.5-A2b-2). They are independent (a
	// parameter is float, function, or neither), and widening preserves the arg count, so the env append's
	// per-position scan stays aligned with the signature.
	function finalizeCallArgs(argIds ValueIdArray, sig FuncSignature, callee ByteArray, dstBlock IrBlock) returns ValueIdArray
		return self.appendCalleeEnvArgs(self.crossFloatDomainArgs(argIds, paramTypes: sig.paramTypes, callee: callee, dstBlock: dstBlock), sig: sig, dstBlock: dstBlock)
	end 'finalizeCallArgs'

	function appendCalleeEnvArgs(argIds ValueIdArray, sig FuncSignature, dstBlock IrBlock) returns ValueIdArray
		// FAST PATH: almost no callee takes a function parameter, so a signature with none returns its
		// arguments verbatim — no array built, no op emitted (the shape `crossFloatDomainArgs` uses).
		if not signatureHasFunctionParam(sig) 'noFunctionParam'
			return argIds
		end 'noFunctionParam'

		var withEnvs = ValueIdArray.create()
		for argId in argIds 'copyUser'
			withEnvs.push(argId)
		end 'copyUser'
		for i in 0 upto argIds.count() 'eachParam'
			let paramType = try sig.paramTypes.get(i) otherwise panic("appendCalleeEnvArgs: sig.paramTypes.get OOB at {i} — slotCallArgs returned {argIds.count()} ordered args against a {sig.paramCount()}-parameter signature")
			if maxonTypeTag(paramType) != ValueTypeTag.function 'notFunction'
				continue
			end 'notFunction'
			let argId = try argIds.get(i) otherwise panic("appendCalleeEnvArgs: argIds.get OOB at {i}")
			withEnvs.push(self.calleeEnvArg(argId, dstBlock: dstBlock))
		end 'eachParam'
		return withEnvs
	end 'appendCalleeEnvArgs'

	// The environment a function-value ARGUMENT carries: its own env when it has one (`valueClosureEnv != 0` —
	// a capturing closure's block, published by the parser), else a freshly materialized null. A stored 0
	// unambiguously means "no environment" (a real env id is always `>= 1`), so a null is minted for a plain
	// function reference / non-capturing closure argument.
	function calleeEnvArg(argId ValueId, dstBlock IrBlock) returns ValueId
		let env = try self.valueClosureEnv.get(argId) otherwise panic("calleeEnvArg: v{argId} has no closure-env slot — the column is dense over every ValueId the parser minted")
		if env != 0 'carriesEnv'
			return env
		end 'carriesEnv'
		let nullEnv = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(nullEnv, value: 0, valueType: StdType.i64))
		return nullEnv
	end 'calleeEnvArg'

	// Lower a Maxon binary op to its Std counterpart. The operand and result
	// ValueIds pass through verbatim (this pass never renumbers — see the header);
	// only the source-level operator maps to a width/ABI-resolved Std op. Every
	// NON-TRAPPING operator becomes a `StdOp.binOp` carrying the mapped opcode; the
	// TRAPPING division family (`div`/`mod`) becomes its OWN Std variant (`StdOp.div`/
	// `mod`) — a dedicated arm, NOT routed through the binOp-opcode helper — because idiv
	// can fault and so needs `isPure: false` metadata a shared opcode field cannot carry
	// (mirrors why `compare` split into `StdOp.cmp`).
	//
	// TWO range arms reach `appendStdBinOp`, not one, because `div`/`mod` sit BETWEEN the
	// arithmetic band and the bit band in `MaxonBinOp` (they were there first, and the
	// band-append invariant forbids re-ordering an enum to make a range contiguous — a
	// silently-swallowed variant costs far more than one extra arm).
	function lowerBinOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, dstBlock IrBlock)
		match op 'op'
			add to mul then self.appendStdBinOp(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
			div then self.lowerDivision(result, lhs: lhs, rhs: rhs, dstBlock: dstBlock)
			mod then self.stdModule.appendOp(dstBlock, op: StdOp.mod(result, lhs: lhs, rhs: rhs, signedness: IntegerSignedness.signed))
			bitAnd to shrLogical then self.appendStdBinOp(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
			// `min`/`max` need no `lowerDivision`-style fork the way `div` does: only ONE of the two
			// divisions is a pure `binOp`, so `/` has to ask its operand type which op it becomes,
			// while these are float-only outright (`stdBinOpcodeIsFloatOnly`) and the parser has
			// already promoted both operands. So they take the plain append, like the arith band.
			min to max then self.appendStdBinOp(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
			// The UNSIGNED pair takes the same two routes their signed twins take, carrying the one thing
			// that differs. They need no float fork: `divisionOpcodeFor` mints them only from two
			// non-negative INTEGER ranges (a ranged float alias carries tag `float`, never `named`), so
			// there is no unsigned float divide to be, and `lowerDivision`'s fork would have nothing to ask.
			divUnsigned then self.stdModule.appendOp(dstBlock, op: StdOp.div(result, lhs: lhs, rhs: rhs, signedness: IntegerSignedness.unsigned))
			modUnsigned then self.stdModule.appendOp(dstBlock, op: StdOp.mod(result, lhs: lhs, rhs: rhs, signedness: IntegerSignedness.unsigned))
		end 'op'
	end 'lowerBinOp'

	// ⭐ **THE TWO DIVISIONS ARE DIFFERENT OPS**, and the operand type alone decides which one a
	// source `/` becomes. They differ in the single property the arith band's membership rule is
	// defined by — PURITY — so they land on opposite sides of it, which is the rule WORKING
	// rather than an exception to it (see StdDialect's StdBinOpcode header):
	//
	//   • INTEGER `/` traps. `idiv` faults on a zero divisor and on `i64.min / -1`, so it must
	//     never be reordered or dropped, and it needs `StdOp.div`'s own `isPure: false` to say
	//     so — metadata a shared opcode field cannot carry.
	//   • FLOAT `/` cannot trap. `divsd` answers `inf`/`nan` per IEEE-754, so it is pure, it
	//     shares `binOp`'s exact operand shape, and it rides `StdBinOpcode.div`.
	function lowerDivision(result ValueId, lhs ValueId, rhs ValueId, dstBlock IrBlock)
		if stdTypeIsFloat(self.stdTypeOf(lhs)) 'float'
			self.appendStdBinOp(result, lhs: lhs, rhs: rhs, op: MaxonBinOp.div, dstBlock: dstBlock)
			return
		end 'float'

		self.stdModule.appendOp(dstBlock, op: StdOp.div(result, lhs: lhs, rhs: rhs, signedness: IntegerSignedness.signed))
	end 'lowerDivision'

	// Append the `StdOp.binOp` a non-trapping Maxon binary operator lowers to. The one
	// emit site shared by the arithmetic and bit bands, so the two range arms above
	// dispatch rather than duplicate.
	//
	// ⭐ `operandType` IS THE OPERAND'S REAL TYPE, read from the parser's oracle — the backend
	// selects `addsd` over `add` from this field and nothing else, so a placeholder here is a
	// silent wrong answer rather than a missing feature.
	//
	// It is the LEFT operand's type, which is exact for every operator that reaches here and not
	// merely a convention: the arithmetic and word operators have already been checked to agree
	// (`checkBinOpOperands`), and a SHIFT deliberately does not — its right operand is a
	// DISTANCE, whose type says nothing about anything, and the value being shifted is the only
	// one that decides (TypeRules' ⭐ THE SHIFT RULE).
	function appendStdBinOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, dstBlock IrBlock)
		let opcode = maxonBinOpToStdOpcode(op)
		let operandType = self.stdTypeOf(lhs)

		// The FLOAT-ONLY opcodes may not be built over an integer operand type, and the guard is what
		// makes that unrepresentable rather than merely unwritten. Not representable beats not written
		// down. The two kinds have different stakes and one gate, so the message names which opcode
		// arrived:
		//   • `div` — an integer one would declare the trapping `idiv` PURE, free for the scheduler to
		//     reorder or delete. `lowerDivision` is the gate that makes it unreachable.
		//   • `min`/`max` — there is no integer form of either in the language at all, and every target
		//     lowering assumes f64 registers. `Parser.emitBinaryMathIntrinsic` promotes both operands.
		if stdBinOpcodeIsFloatOnly(opcode) and not stdTypeIsFloat(operandType) 'floatOnlyOverInteger'
			panic("appendStdBinOp: `binOp({opcode.name})` over an INTEGER operand type — `{opcode.name}` is FLOAT-ONLY (stdBinOpcodeIsFloatOnly). Integer division lowers to the non-pure `StdOp.div` (`lowerDivision` decides), and `min`/`max` have no integer form: their operands are promoted by `Parser.emitBinaryMathIntrinsic`")
		end 'floatOnlyOverInteger'

		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(result, lhs: lhs, rhs: rhs, opcode: opcode, operandType: operandType))
	end 'appendStdBinOp'

	// Lower a Maxon unary op to its Std counterpart. Like lowerBinOp, the operand
	// and result ValueIds pass through verbatim; only the source-level operator maps
	// to a width/ABI-resolved Std opcode — except the sign extensions, which have no
	// single Std opcode and EXPAND (see `lowerSignExtend`).
	//
	// ⚠ The match is TERMINAL — the non-extension arm carries the 1:1 lowering rather than falling out of
	// it — for the reason `lowerRuntimeCall`'s division match carries its own residue: a `match` arm is one
	// statement, and a void callee has no value for a `return` to hand back.
	function lowerUnaryOp(result ValueId, operand ValueId, op MaxonUnaryOp, dstBlock IrBlock)
		match signExtendSlotOf(op) 'aSignExtension'
			fromBytes(slotBytes) then self.lowerSignExtend(result, operand: operand, slotBytes: slotBytes, dstBlock: dstBlock)
			notASignExtension then self.appendStdUnaryOp(result, operand: operand, op: op, dstBlock: dstBlock)
		end 'aSignExtension'
	end 'lowerUnaryOp'

	// The 1:1 half of `lowerUnaryOp`: the operators that map straight onto one Std opcode.
	//
	// ⭐ `operandType` IS THE OPERAND'S TYPE — the SOURCE the instruction reads — and on the two
	// CONVERSION opcodes that is emphatically not the result's: `trunc` reads an f64 and produces
	// an i64, `promoteToFloat` the reverse. Taking it from `operand` rather than from `result` is
	// therefore correct for every opcode at once, and is the only spelling that is.
	function appendStdUnaryOp(result ValueId, operand ValueId, op MaxonUnaryOp, dstBlock IrBlock)
		let opcode = maxonUnaryOpToStdOpcode(op)
		let operandType = self.stdTypeOf(operand)
		assertUnaryOperandDomain(opcode, operandType: operandType)
		self.stdModule.appendOp(dstBlock, op: StdOp.unaryOp(result, operand: operand, opcode: opcode, operandType: operandType))
	end 'appendStdUnaryOp'

	// ⭐⭐ **A SIGN EXTENSION BECOMES `shl` THEN ARITHMETIC `shr` BY THE SAME COUNT** — the slot's top bit
	// walked up to bit 63 and back down with the sign fill. `StdBinOpcode.shr` IS the arithmetic shift (its
	// logical twin is a separate opcode, `shrLogical`), which is the whole of what makes the pair a sign
	// extension rather than a mask.
	//
	// ⭐⭐ **AND IT IS AN EXPANSION RATHER THAN A NEW `StdUnaryOpcode`, ON A MEASURABILITY ARGUMENT.** Every
	// target has a single instruction for this — x64 `movsx`/`movsxd`, arm64 `sxtb`/`sxth`/`sxtw`, wasm
	// `i64.extend8_s`/`16_s`/`32_s` — so a Std opcode with three per-target lowerings is the better CODE and
	// was the first design. What stopped it is that those are three new hand-written ENCODINGS in three
	// backends, and this tree can execute exactly one of them: arm64 needs the Mac and the wasm lane is the
	// cross-target sweep's. A wrong bit in an encoder is a silently wrong NUMBER, so three unrunnable
	// encodings would be three unverifiable claims. `shl`/`shr` are already emitted by every program in the
	// corpus on all three targets, so this expansion is correct on each of them by the same evidence that
	// says a shift is. ⇒ the native instruction is a codegen rung with a cross-target gate, not this one.
	//
	// The count is `(8 - slotBytes) * 8`, a `const` the Std-tier `foldConstOperands` then folds into both
	// shifts' immediate forms, so the emitted code is two shift-immediates and no register for the count.
	function lowerSignExtend(result ValueId, operand ValueId, slotBytes ByteOffset, dstBlock IrBlock)
		let count = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(count, value: (MachineWordBytes - slotBytes) * BitsPerByte, valueType: StdType.i64))

		let raised = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(raised, lhs: operand, rhs: count, opcode: StdBinOpcode.shl, operandType: StdType.i64))
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(result, lhs: raised, rhs: count, opcode: StdBinOpcode.shr, operandType: StdType.i64))
	end 'lowerSignExtend'

	// Lower a Maxon comparison to `StdOp.cmp`. Operand/result ValueIds pass through
	// verbatim; only the source-level comparison operator maps to a Std predicate.
	//
	// ⭐ `operandType` DECIDES THE CONDITION-CODE FAMILY, so on a compare it is not merely
	// descriptive: `cmp` answers in OF/SF (which the signed `jl`/`jg` family reads) and `ucomisd`
	// leaves OF=SF=0 and answers in ZF/PF/CF (which the UNSIGNED `jb`/`ja` family reads). The
	// same `StdCmpPred.less` therefore lowers to `jl` for an i64 and `jb` for an f64, and a float
	// compare lowered to `jl` would read flags that were never written. The result is a bool, so
	// the type must come from an OPERAND — `lhs`, which `emitCompare` has already required to
	// agree with `rhs`. See specs-shv2/float-compare-branch.md.
	//
	// ⭐⭐ **AND THE INTEGER FAMILY IS CHOSEN THE SAME WAY, WHICH IS WHY THE VERDICT ARRIVES AS A TYPE
	// AND NOT AS A SECOND FIELD.** `x64.cmp` over two i64s writes OF/SF/CF all three; which of them the
	// branch reads is the whole of signed-vs-unsigned, and it is the identical question `isFloat` was
	// already answering one domain over. So an unsigned ordering compare is lowered by RELABELLING the
	// operand type (`unsignedStdTypeOf`) rather than by carrying a flag the three backends would each
	// have to remember to consult beside the type they already consult.
	//
	// ⚠ **THE DECISION IS NOT MADE HERE AND CANNOT BE.** It reads BOTH operands' declared ranges, which
	// this tier no longer has — the parser decided it (`comparisonSignedness`) and `MaxonOp.compare`
	// carried it exactly this far. The relabelling preserves width, so a narrow operand stays narrow.
	//
	// ⚠⚠ **IT IS NORMALIZED IN BOTH DIRECTIONS, AND THE SIGNED ARM IS NOT A NO-OP.** `stdTypeOf` already
	// answers `u32` for an `ExitCode` operand (`valueTagToStdType`) — a fact about ONE value's storage,
	// decided long before any pair was considered. Passing that through unchanged would leave the backend
	// reading a SECOND, one-sided answer out of the type: `e > n` with an `ExitCode` on the left and a
	// plain `int` on the right has the pair verdict SIGNED (the right operand admits negatives) and an
	// lhs type of `u32`, so the two would disagree, and the backend's copy would win. Spelling the
	// verdict into the type in both directions is what keeps ONE answer in the program.
	function lowerCompare(result ValueId, lhs ValueId, rhs ValueId, op MaxonCmpOp, signedness IntegerSignedness, dstBlock IrBlock)
		let pred = maxonCmpOpToStdPred(op)
		let lhsType = self.stdTypeOf(lhs)
		let operandType = match signedness 'family'
			signed gives signedStdTypeOf(lhsType)
			unsigned gives unsignedStdTypeOf(lhsType)
		end 'family'
		self.stdModule.appendOp(dstBlock, op: StdOp.cmp(result, lhs: lhs, rhs: rhs, pred: pred, operandType: operandType))
	end 'lowerCompare'

	// Lower a Maxon conditional branch to its Std counterpart, as the block's
	// terminator. The condition value and both target BlockIds pass through verbatim.
	function lowerCondBranch(cond ValueId, thenBlockId BlockId, elseBlockId BlockId, dstBlock IrBlock)
		self.stdModule.setTerminator(dstBlock, op: StdOp.condBranch(cond, thenBlockId: thenBlockId, elseBlockId: elseBlockId))
	end 'lowerCondBranch'

	// Lower a Maxon unconditional branch to its Std counterpart, as the block's
	// terminator.
	function lowerBranch(targetBlockId BlockId, dstBlock IrBlock)
		self.stdModule.setTerminator(dstBlock, op: StdOp.branch(targetBlockId))
	end 'lowerBranch'

	// Lower the dense-match jump table 1:1 to its Std twin, as the block's terminator. Everything passes
	// through verbatim (the parser already emitted the bias `subtract` and biased the table): the biased
	// index value id, the dense block-id table, and the default. RE-MATCHES `hlOp` in a SMALL match so the
	// `denseTargetBlockIds` Array is not bound in `lowerOp`'s big one — the `lowerIndirectCall` discipline.
	function lowerSwitch(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'sw'
			switch(subject, denseTargetBlockIds, defaultBlockId) then self.stdModule.setTerminator(dstBlock, op: StdOp.switch(subject, denseTargetBlockIds: denseTargetBlockIds, defaultBlockId: defaultBlockId))
			default panic("lowerSwitch: expected a `switch` op, got a different MaxonOp variant — `lowerTerminator` routes only `switch` here")
		end 'sw'
	end 'lowerSwitch'

	// Copy a source block's op-LESS terminator marker (`dead`/`fallthrough`) onto its
	// freshly-cloned Std block. `unset` needs no action (the clone already starts
	// there); an `opIndex` terminator never reaches here (the caller guards with
	// hasTerminatorOp). This keeps `assertAllBlocksTerminated` satisfied for the
	// unreachable continuation block the `if`/`else` parser marks `dead`.
	// ⚠ **IT TAKES THE TERMINATOR SLOT AND THE BLOCK'S ID, NOT THE BLOCK.** Its caller walks the Maxon
	// blocks while WRITING the lowering's own storage, so it may not hold a block record read out of
	// `maxonModule.blocks` (E3070) — and the slot is a scalar-payload union it copied out before the walk
	// began. The id replaces the label the panic used to quote for the same reason, and names the block
	// more exactly (a label is not an identity).
	function carryOplessTerminator(srcTerminator Terminator, srcBlockId BlockId, dstBlock IrBlock)
		match srcTerminator 'carry'
			unset then break 'carry'
			dead then dstBlock.terminator = Terminator.dead
			fallthrough then dstBlock.terminator = Terminator.fallthrough
			opIndex then panic("carryOplessTerminator: block {srcBlockId} has an op terminator but terminatorNamesAnOp() was false")
		end 'carry'
	end 'carryOplessTerminator'

	// Emit the function-return terminator (or, for a mid-block ret, a body op) for a VALUE return. A function
	// that uses NEITHER half of the secondary return slot emits a plain `StdOp.ret`; one that uses it emits
	// the dual-register `errorReturn(primary, secondary)`. `asTerminator` toggles setTerminator (block-final)
	// vs appendOp (the rare mid-block ret).
	//
	// ⭐ **THIS IS THE ONE PLACE THE ABI DECIDES ret-vs-errorReturn** — from `functionUsesSecondaryReturnSlot`
	// and never from the token — so the parser's ordinary `ret` needs no knowledge of either channel. The
	// predicate answers WHETHER; what actually rides is the other half of the same fact, and the two are
	// mutually exclusive because there is one register (see the predicate):
	//
	//   • a THROWING function writes a ZERO error flag, so the ABI is honored on EVERY exit of a throwing
	//     function and not only on the throw;
	//   • an INTERFACE-RETURNING one writes the WITNESS half of the fat pointer it is handing back, resolved
	//     through the very helper an existential ARGUMENT's witness comes through — so a returned existential
	//     and a passed one name one table, and a value returned as itself (a threaded parameter) FORWARDS its
	//     own witness rather than re-resolving a `(<Iface>, <Iface>)` table that does not exist.
	function emitRetOrErrorReturn(retVal ValueId, dstBlock IrBlock, asTerminator bool)
		if functionUsesSecondaryReturnSlot(self.currentMaxonReturnType, throws: self.currentThrows) 'secondaryReturnSlot'
			self.emitTerminatorOrBody(dstBlock, op: StdOp.errorReturn(retVal, errorFlagId: self.secondaryReturnValue(retVal, dstBlock: dstBlock)), asTerminator: asTerminator)
			return
		end 'secondaryReturnSlot'
		self.emitTerminatorOrBody(dstBlock, op: StdOp.ret(retVal), asTerminator: asTerminator)
	end 'emitRetOrErrorReturn'

	// The word this function's return puts in the SECONDARY register — asked only where
	// `functionUsesSecondaryReturnSlot` already said there is one, so the two disjuncts are the only cases and
	// a third would be a predicate/emitter disagreement rather than a user error.
	function secondaryReturnValue(retVal ValueId, dstBlock IrBlock) returns ValueId
		if throwsClauseIsThrowing(self.currentThrows) 'noErrorInFlight'
			return self.emitZeroConst(dstBlock)
		end 'noErrorInFlight'

		match self.currentMaxonReturnType 'declaredReturn'
			void then panic("secondaryReturnValue: '{String.from(self.currentFuncName)}' uses the secondary return slot, is not throwing, and returns VOID — `functionUsesSecondaryReturnSlot` answers true for a void non-throwing function nowhere")
			value(inner) then return self.witnessForExistentialValue(retVal, interfaceName: interfaceNameOfType(inner, typeNames: self.typeNames), site: self.currentFuncName, dstBlock: dstBlock)
		end 'declaredReturn'
	end 'secondaryReturnValue'

	// The VOID-return counterpart. A function using the secondary slot still writes BOTH registers — a
	// family-default `0` primary and its secondary word — because even a void throwing function's caller reads
	// the flag register. Only the THROWING disjunct can reach it: a void return type is not an interface, so
	// `functionUsesSecondaryReturnSlot` reduces here to exactly the `throws` clause. It is asked through the
	// predicate anyway, so the rule has one home and not two.
	function emitRetVoidOrErrorReturn(dstBlock IrBlock, asTerminator bool)
		if functionUsesSecondaryReturnSlot(self.currentMaxonReturnType, throws: self.currentThrows) 'secondaryReturnSlot'
			let defaultVal = self.emitZeroConst(dstBlock)
			self.emitTerminatorOrBody(dstBlock, op: StdOp.errorReturn(defaultVal, errorFlagId: self.secondaryReturnValue(defaultVal, dstBlock: dstBlock)), asTerminator: asTerminator)
			return
		end 'secondaryReturnSlot'
		self.emitTerminatorOrBody(dstBlock, op: StdOp.retVoid, asTerminator: asTerminator)
	end 'emitRetVoidOrErrorReturn'

	// `throw E.case` / `throw U.case(x)` / `throw e` — the error-flag ENCODE lives HERE (the ABI in one
	// place, per PLAN.md), not in the parser. `errIsBoxed` (set by the parser, which alone holds the enum
	// registry that classifies the thrown type) picks the encoding:
	//   • a BOXED union — `errValue` is the heap-box POINTER, written to the flag VERBATIM. It is non-zero
	//     (`__mm_alloc` never returns 0), so `flag != 0` still reads "error in flight", and there is NO
	//     `+ bias` add: the pointer must survive round-trip to the caller's `(e)` binding intact.
	//   • a SCALAR enum — `errValue` is the ORDINAL, and the flag is `errValue + ErrorFlagOrdinalBias` (the
	//     runtime add covering both the compile-time-constant `throw E.case` and the caught-runtime-value
	//     `throw e` uniformly), reserving 0 for "no error".
	// The primary register carries a family-default `0` the caller ignores when the flag is non-zero — but
	// it is CLASSED for the return type's register file (`emitZeroConstOfReturnType`: an XMM zero for a
	// float return), or the backend's `errorReturn` move would cross register files. The parser's
	// `(e)`-binding DECODE reads the SAME `errIsBoxed` fact (via `throwsTypeIsBoxedUnion`) and the SAME
	// `ErrorFlagOrdinalBias`, so encode and decode cannot drift on either.
	function lowerThrowError(errValue ValueId, errIsBoxed bool, dstBlock IrBlock)
		// A BOXED error's `errValue` is already the flag (the box pointer) — no `const`/`add`, so the primary
		// default is the only op. A SCALAR error emits `bias`, `flag = errValue + bias`, then the primary
		// default, in that order so its ValueId numbering and op sequence stay what they were before boxed
		// errors existed: `emitZeroConstOfReturnType` mints exactly one id like the plain zero it replaced,
		// so the scalar goldens do not move — only a FLOAT return (which previously PANICKED the backend, so
		// has no prior golden) now emits an XMM zero here instead of a GPR one.
		if errIsBoxed 'boxed'
			let boxedDefault = self.emitZeroConstOfReturnType(dstBlock)
			self.stdModule.setTerminator(dstBlock, op: StdOp.errorReturn(boxedDefault, errorFlagId: errValue))
			return
		end 'boxed'
		let flag = self.mintStdValueId()
		self.encodeScalarErrorFlag(flag, errValue: errValue, dstBlock: dstBlock)
		let defaultVal = self.emitZeroConstOfReturnType(dstBlock)
		self.stdModule.setTerminator(dstBlock, op: StdOp.errorReturn(defaultVal, errorFlagId: flag))
	end 'lowerThrowError'

	// ⭐⭐ **THE SCALAR ERROR-FLAG ENCODE — `ordinal + ErrorFlagOrdinalBias` — AND IT IS THE ONLY PLACE IT IS
	// SPELLED.** Two ops reach it and they are the same fact under two grammars: `throwError`, which publishes
	// the flag to the CALLER through the error register, and `errorFlagEncode`, which hands it to a block-form
	// `try`'s shared handler as a VALUE (a bare `throw` inside the body branches rather than returns). A second
	// spelling of this add — in the parser, say, where the matching DECODE already lives — would be the ABI
	// written at two tiers, free to drift the day the bias moves; both readers of `ErrorFlagOrdinalBias`
	// (`Parser.declareCaughtError`'s decode and this) then still name the one constant, which is the property
	// PLAN.md's own note about this bias asks for.
	//
	// ⚠ **THE DESTINATION IS THE CALLER'S**, so each spelling of the encode defines the id ITS OWN consumer
	// names: the terminator form a fresh value it invents, the value form the `result` the parser declared and
	// the routed edge already carries in its `argIds`. This pass does not renumber (`lowerLiteral`'s header),
	// so a value form that could not write `result` directly would owe it a rename op.
	function encodeScalarErrorFlag(flag ValueId, errValue ValueId, dstBlock IrBlock)
		let bias = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(bias, value: ErrorFlagOrdinalBias, valueType: StdType.i64))
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(flag, lhs: errValue, rhs: bias, opcode: StdBinOpcode.add, operandType: StdType.i64))
	end 'encodeScalarErrorFlag'

	// `MaxonOp.errorFlagEncode` — the flag a ROUTED bare `throw` carries on its edge to the block handler.
	// Same two encodings `lowerThrowError` picks between, off the same `errIsBoxed` bit the parser stamped:
	// a BOXED union's pointer IS its flag, a SCALAR enum's is `ordinal + bias` through the shared routine.
	//
	// ⚠ **`result` MUST BE DEFINED BY AN OP, AND ONLY THE BOXED ARM PAYS FOR THAT.** This pass does not
	// renumber (`lowerLiteral`'s header), so the Maxon `result` id the routed edge already names in its
	// `argIds` has to be the destination of a real Std instruction. The SCALAR arm simply IS that instruction
	// — the shared encode writes `result` directly. A BOXED error computes nothing at all (the pointer is the
	// flag), so it has no instruction to be, and the Std tier has no move op: `add 0` is its rename.
	function lowerErrorFlagEncode(result ValueId, errValue ValueId, errIsBoxed bool, dstBlock IrBlock)
		if not errIsBoxed 'scalarEncodeDefinesItDirectly'
			self.encodeScalarErrorFlag(result, errValue: errValue, dstBlock: dstBlock)
			return
		end 'scalarEncodeDefinesItDirectly'

		let zero = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(result, lhs: errValue, rhs: zero, opcode: StdBinOpcode.add, operandType: StdType.i64))
	end 'lowerErrorFlagEncode'

	// An uncaught `try f()` — re-publish the caught flag VERBATIM. `errorFlag` is ALREADY the `ordinal + 1`
	// encoding (it came straight out of a `tryCall`), so there is NO re-encoding — the whole reason
	// `propagateError` is distinct from `throwError`.
	function lowerPropagateError(errorFlag ValueId, dstBlock IrBlock)
		let defaultVal = self.emitZeroConstOfReturnType(dstBlock)
		self.stdModule.setTerminator(dstBlock, op: StdOp.errorReturn(defaultVal, errorFlagId: errorFlag))
	end 'lowerPropagateError'

	// A throwing free call `try callee(args…)` — the arg slotting is `lowerCall`'s exactly (it IS a call),
	// plus the `errorFlag` second result. The parser has already rejected a non-throwing USER callee (E3055).
	//
	// ⭐ **A COMPILER-EMITTED THROWING CALLEE (`__managed_get`/`__managed_set`/`__managed_first`/…) HAS NO SIGNATURE TO
	// SLOT AGAINST** — the parser wrote its arguments positionally (`emitRuntimeCall`), so they pass verbatim,
	// exactly as `lowerCall` routes a non-throwing runtime call through `lowerRuntimeCall`. The array
	// accessors are the first throwing builtins (P1.7 slice 1); before them no builtin threw, which is why
	// this path is new. The label guard is `lowerRuntimeCall`'s: a runtime call is positional by
	// construction, so a label would silently mis-slot.
	//
	// ⚠ A source-written `try __int_fromString(s)` from `stdlib/Builtins.maxon` (A1r) is NOT that: it names a
	// DECLARED throwing function, so it takes `appendThrowingCall`'s slotting path like every other `try f(…)`. The
	// discriminator is `isSignaturelessCompilerCallee`, `lowerCall`'s exactly — this is the throwing twin of
	// that site and the two must part company on the same fact.
	function lowerTryCall(result ValueId, errorFlag ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argDefaultSlots ParamCountArray, dstBlock IrBlock)
		// ⭐ **A CHECKED DIVIDE IS EXPANDED, NOT CALLED (A1).** Asked FIRST, and exhaustively, so a checked
		// division callee can never fall through to the `StdOp.tryCall` `appendThrowingCall` emits — there is no `__checked_div`
		// function for such a call to reach, and the linker's "call to unknown function" would be the failure.
		// `CheckedDivisionRuntime`'s header explains why this family has no body to call.
		//
		// ⚠ **A1x's `guardedRemainder` MUST NOT ARRIVE HERE**, and the arm says so rather than sharing the
		// expansion's door: it is TOTAL, so it is not a `try` target at all — the parser refuses a `try` over it
		// (E3055) and reaches the expansion through `lowerRuntimeCall` instead. Answering it here would mean a
		// `tryCall` whose error flag nothing ever sets.
		//
		// ⚠ **THE MATCH IS TERMINAL — the "not a division" arm CARRIES the call path rather than falling out
		// of it.** A `match` arm is exactly one statement, so an arm that expands AND then leaves the function
		// ahead of that path cannot be written, and `return self.lowerDivisionExpansion(…)` is not the escape:
		// a void callee yields nothing to return (`specs-shv2/void-call-result.md`). It is
		// `lowerRuntimeCall`'s arrangement, for `lowerRuntimeCall`'s reason.
		match divisionKindOf(callee) 'checkedDivision'
			quotient then self.lowerDivisionExpansion(result, expansion: DivisionExpansion.checkedQuotient(errorFlag), signedness: divisionCalleeSignedness(callee), args: args, dstBlock: dstBlock)
			remainder then self.lowerDivisionExpansion(result, expansion: DivisionExpansion.checkedRemainder(errorFlag), signedness: divisionCalleeSignedness(callee), args: args, dstBlock: dstBlock)
			guardedRemainder then panic("lowerTryCall: a TOTAL `__guarded_mod` reached the throwing call path — `isThrowingDivisionRuntimeCallee` answers false for it, so `Parser.requireThrowingNamedTryTarget` must have refused the `try` before lowering")
			notCheckedDivision then self.appendThrowingCall(result, errorFlag: errorFlag, callee: callee, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots, dstBlock: dstBlock)
		end 'checkedDivision'
	end 'lowerTryCall'

	// Emit the `StdOp.tryCall` for every throwing callee that is not an expanded division — verbatim
	// arguments for a compiler-owned one, label-slotted for a declared one.
	function appendThrowingCall(result ValueId, errorFlag ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argDefaultSlots ParamCountArray, dstBlock IrBlock)
		if isSignaturelessCompilerCallee(callee, funcSignatures: self.funcSignatures) 'compilerOwnTryCall'
			requireRuntimeCallPositional(callee, argLabels: argLabels)
			// ⚠ **A WITNESS-CARRYING `tryCall` ARM STOOD HERE FOR `__map_get`, AND WENT WITH IT (W105).**
			// `__map_get` was the only compiler-owned callee that both THREADED witness tables and THREW, and
			// forgetting it cost a measured 0xC0000005 — see `materializeWitnessTableAddr`, which now holds that
			// measurement and the one-door rule it proves. The rule outlives the arm: NO compiler-owned runtime
			// callee threads a witness table at all since W129, so one added later — throwing or not — builds its
			// appender once and reaches it from here as well as from `lowerRuntimeCall`.
			// The throwing OPAQUE-`T` `slice` (`__managed_slice_opaque`) takes the enclosing instance's descriptor as
			// its last argument, appended here exactly as the non-throwing clone/append do in `lowerRuntimeCall`.
			// The stride record is `appendRuntimeCall`'s, asked here for the THREE throwing element primitives
			// (`__managed_get`, `__managed_set`, `__managed_mem_set`) — the same fact about the same argument,
			// so the two doors share the one recorder rather than each testing the argument for itself.
			let tryCallArgs = self.opaqueCopyArgsWithDescriptor(callee, args: args, dstBlock: dstBlock)
			self.recordStaticElementStride(args, opIndex: self.stdModule.opCount())
			self.stdModule.appendOp(dstBlock, op: StdOp.tryCall(result, errorFlagId: errorFlag, callee: callee, args: tryCallArgs))
			return
		end 'compilerOwnTryCall'

		let sig = try self.funcSignatures.get(callee) otherwise panic("appendThrowingCall: throwing callee '{String.from(callee)}' has no signature — SemanticCheck must reject an unknown callee before lowering")
		match slotCallArgs(sig.paramNames, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots) 'slot'
			ordered(argIds) then self.stdModule.appendOp(dstBlock, op: StdOp.tryCall(result, errorFlagId: errorFlag, callee: callee, args: self.finalizeCallArgsWithLayout(argIds, sig: sig, callee: callee, result: result, dstBlock: dstBlock)))
			arityMismatch then panic("appendThrowingCall: arity mismatch for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			unknownLabel then panic("appendThrowingCall: unknown argument label for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			duplicateArg then panic("appendThrowingCall: duplicate argument for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
		end 'slot'
	end 'appendThrowingCall'

	// ⭐⭐ **EXPAND `__checked_div` / `__checked_mod` / `__guarded_mod` IN PLACE — AND BRANCHLESSLY (A1, A1x).**
	// The whole body is a divisor test, and for the zero hazard the test IS the error flag:
	//
	//   INTEGER `/`:   `flag = (divisor == 0)` · `safe = divisor or flag` · `result = dividend / safe`
	//   FLOAT   `/`:   `flag = (divisor == 0.0)` · `result = dividend / divisor`
	//   INTEGER `mod`: the same, over a dividend the overflow guard has already masked (A1x, below)
	//
	// ⭐ **THE COMPARE'S OWN 0/1 IS THE ERROR FLAG, WITH NO `select` AND NO SECOND CONSTANT.**
	// `__DivisionByZeroError` has one case at ordinal 0, so its flag encoding is `0 + ErrorFlagOrdinalBias` = 1
	// — exactly what an `x == 0` compare produces. That is a derivation, not a coincidence to rely on
	// silently, so `DivisionByZeroFlag` is ASSERTED below rather than assumed: insert a case before
	// `divisionByZero`, or change the bias, and this stops compiling instead of encoding the wrong error.
	//
	// ⭐ **THE INTEGER ARM'S `or` IS WHAT MAKES THE ZERO PATH SAFE WITHOUT A BRANCH.** x64 `idiv` (and wasm
	// `i64.div_s`) FAULT on a zero divisor, and a trap is not a catchable `DivisionByZero` — so the divide must
	// never see one. `divisor or flag` is `divisor` whenever the divisor is non-zero (the flag is 0) and `1`
	// when it is zero (`0 or 1`), so the divide always runs on a safe operand and its quotient on the zero
	// path is simply discarded by the `try` fork the parser already built. Both operands are already in
	// registers; the whole guard is two extra instructions.
	//
	// ⭐ **THE FLOAT ARM NEEDS NO GUARD AT ALL**, and the asymmetry is the ISA's rather than a shortcut:
	// `divsd` cannot fault — IEEE-754 answers `±inf`/`NaN` — so only the FLAG has to be computed, and the
	// infinity it would have produced is discarded on the error edge. The zero test is a FLOAT compare and
	// never an integer bit-compare, which is what makes it catch `-0.0` as well as `+0.0` (IEEE-754 makes the
	// two equal, and `x / ±0.0` is a degenerate infinity either way).
	//
	// ⭐ **WHY NOT THE BOOTSTRAP'S THREE-BLOCK CFG** (`MaxonToStandardConversion.ManagedMemory.cs:2336-2394`,
	// which splits entry → {zero, ok} → merge around a stack temp both arms store into and the merge reloads).
	// Two reasons, and the first is structural: `lowerMaxonToStd` maps Maxon blocks to Std blocks **1:1** by
	// construction (`lower`'s per-block walk, which `retypeBlockArgs` and every block id downstream depend on),
	// so splitting here would break an invariant of the pass rather than add code to it. The second is that
	// shv2 would not want the shape anyway — it carries values in BLOCK ARGS, not memory temps, so the
	// bootstrap's store/reload pair has no counterpart, and the branchless form has no phi to merge either.
	// The behaviour is identical: same flag, same quotient, and on the zero path a discarded result the
	// bootstrap seeds to 0 and this leaves as `dividend / 1`.
	// ⭐⭐ **THE `mod` OVERFLOW GUARD (A1x), AND WHY IT MASKS THE DIVIDEND RATHER THAN FIXING THE DIVISOR.**
	// `idiv` raises `#DE` on `i64.min / -1` as well as on a zero divisor, and a `mod` inherits that fault from
	// a quotient it does not even read. The remainder's own answer at that divisor is not merely
	// representable, it is CONSTANT: **`a mod -1` is `0` for every `a`** (truncated division gives
	// `a - (-1)·trunc(a / -1) = a - a`). So the expansion divides **0** instead, whose remainder is that same
	// `0` and whose quotient cannot overflow:
	//
	//   `negOne = -1` · `isNegOne = (divisor == negOne)` · `mask = isNegOne + negOne` · `safe = dividend and mask`
	//
	// `isNegOne` is 0 or 1, so `mask` is `-1` (all ones — `dividend` passes through untouched) for every other
	// divisor and `0` exactly at `-1`. **Four instructions, no branch**, composing with A1's zero guard rather
	// than forking around it.
	//
	// ⭐ **THE ONE `-1` CONSTANT IS BOTH THE COMPARAND AND THE DECREMENT**, which is why the third op is an
	// `add` and not a `sub 1`: `isNegOne - 1` and `isNegOne + (-1)` are the same value, and reusing the
	// constant costs one fewer `const` op and one fewer live value across the divide.
	//
	// ⭐ **IT TESTS ONLY THE DIVISOR — never the dividend — and that is the asymmetry with `/`.** `a / -1`
	// overflows for exactly ONE dividend (`i64.min`) and has no answer when it does, so `/` would need both
	// operands tested and would still have nothing to return; `specs-shv2/division.md` documents its fault as
	// deliberate. A guard keyed on the dividend would also pass every `i64.min` case while quietly answering
	// wrongly for none — which is precisely why the corpus pins an ORDINARY dividend beside the extreme one.
	//
	// ⚠ **UNREACHED WHERE THE PARSER PROVED THE DIVISOR IS NOT `-1`.** `emitDivOrMod` routes such a `mod` to a
	// bare `StdOp.mod` and never reaches any expansion, so a literal divisor, a folded variable, or a ranged
	// type excluding `-1` (`int(1 to 1000)`, `int(i64.min to -2)`) pays none of these four ops. That is what
	// keeps every existing division golden byte-identical.
	//
	// ⚠⚠ **AND IT COVERS ONLY THE `mod`s A SOURCE PROGRAM WROTE.** Three COMPILER-AUTHORED builders emit
	// `StdOp.mod` directly, past the parser and past this guard, and their safety arguments are NOT the same
	// one:
	//
	//   • `StringRuntime`'s digit loop and `GraphemeRuntime`'s Hangul decomposition divide by a `StdOp.const`
	//     the builder emits two lines above the `mod` (`DecimalRadix`, a syllable count). Those are safe by
	//     CONSTRUCTION — the divisor cannot be `0` or `-1` because it is written there in the source.
	//   • `GtRuntime`'s tick conversion (`__gt_now_ns`) divides by `freq`, a **RUNTIME value** — a
	//     `loadIndirect` of the clock-frequency global that `QueryPerformanceFrequency` filled. It is safe by
	//     the OS CONTRACT (the counter frequency is positive and fixed at boot) and by nothing this compiler
	//     can see. The same value feeds two unguarded `StdOp.div`s in the same function, so if that contract
	//     were ever broken the quotients would fault first.
	//
	// ⇒ **a future runtime builder dividing by something it RECEIVED is outside every proof in this file**,
	// and the third bullet is what that mistake will look like. It is written down rather than checked
	// because there is nothing here to derive an answer from: at that tier a divisor is a bare ValueId with
	// no range and no constant domain, so the obligation belongs to whoever emits the op.
	function emitRemainderOverflowSafeDividend(dividend ValueId, divisor ValueId, operandType StdType, dstBlock IrBlock) returns ValueId
		let negOne = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(negOne, value: OverflowingDivisorPattern, valueType: operandType))

		let isNegOne = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.cmp(isNegOne, lhs: divisor, rhs: negOne, pred: StdCmpPred.eq, operandType: operandType))

		let mask = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(mask, lhs: isNegOne, rhs: negOne, opcode: StdBinOpcode.add, operandType: operandType))

		let safeDividend = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(safeDividend, lhs: dividend, rhs: mask, opcode: StdBinOpcode.bitAnd, operandType: operandType))

		return safeDividend
	end 'emitRemainderOverflowSafeDividend'

	// A1's zero test and the error flag it materializes, in one place because they are one derivation — see
	// this expansion's header for why the compare's own `0`/`1` IS the encoded error and needs no `select`.
	function emitDivisorZeroFlag(errorFlag ValueId, divisor ValueId, operandType StdType, dstBlock IrBlock)
		if DivisionByZeroFlag != BoolTrueValue 'flagIsNotTheCompare'
			panic("emitDivisorZeroFlag: `divisionByZero` encodes error flag {DivisionByZeroFlag}, but this expansion uses the divisor compare's own true payload ({BoolTrueValue}) as the flag — a case inserted before `divisionByZero`, or a changed `ErrorFlagOrdinalBias`, has broken that derivation")
		end 'flagIsNotTheCompare'

		let zero = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(zero, value: DivisorZeroPattern, valueType: operandType))
		self.stdModule.appendOp(dstBlock, op: StdOp.cmp(errorFlag, lhs: divisor, rhs: zero, pred: StdCmpPred.eq, operandType: operandType))
	end 'emitDivisorZeroFlag'

	function lowerDivisionExpansion(result ValueId, expansion DivisionExpansion, signedness IntegerSignedness, args ValueIdArray, dstBlock IrBlock)
		let kind = divisionExpansionKind(expansion)

		let dividend = try args.get(0) otherwise panic("lowerDivisionExpansion: an expanded divide has two arguments — `emitDivOrMod` pushes the dividend first")
		let divisor = try args.get(1) otherwise panic("lowerDivisionExpansion: an expanded divide has two arguments — `emitDivOrMod` pushes the divisor second")

		// The operand type is the LEFT operand's, `appendStdBinOp`'s convention — and here the two sides are
		// checked to AGREE rather than assumed to. `emitDivOrMod` promotes both through `promotedOperand`, so a
		// mixed pair is a promotion bug; emitting the divide anyway would read an i64 out of a GPR as an f64
		// (or the reverse), which is the same silent wrong answer `appendStdBinOp`'s own guard refuses.
		let operandType = self.stdTypeOf(dividend)
		if self.stdTypeOf(divisor) != operandType 'mixedDomains'
			panic("lowerDivisionExpansion: the dividend and the divisor of an expanded divide are in DIFFERENT domains (one float, one integer) — `emitDivOrMod` must promote both operands before emitting one")
		end 'mixedDomains'

		// ⚠ The two checked arms share one body, spelled twice: Maxon cannot bind a payload in a RANGE arm
		// (`checkedQuotient(f) to checkedRemainder(f)` is E2010), and the alternative — reading the flag out
		// through a second union, or a helper that panics for the total arm — would put the pairing back into a
		// place that can be got wrong. One CALL twice beats one FACT twice.
		match expansion 'zeroTest'
			checkedQuotient(errorFlag) then self.emitDivisorZeroFlag(errorFlag, divisor: divisor, operandType: operandType, dstBlock: dstBlock)
			checkedRemainder(errorFlag) then self.emitDivisorZeroFlag(errorFlag, divisor: divisor, operandType: operandType, dstBlock: dstBlock)
			// A1x's total remainder has no error channel at all — its divisor is PROVEN non-zero, so a flag
			// register would be one nobody reads and a compare nobody branches on.
			guardedRemainder then break 'zeroTest'
		end 'zeroTest'

		// ⭐⭐ **THE DIVIDE ITSELF GOES THROUGH `lowerBinOp`, WHICH IS ALREADY THE ONE PLACE THAT DECIDES WHAT
		// A `/` OR A `mod` BECOMES.** This expansion's job is the GUARD — which operands the divide reads —
		// and not the OPCODE. Written out here instead, it was a second copy of `lowerDivision`'s float/int
		// choice and of `lowerBinOp`'s `mod` arm, with nothing making the two agree. It also re-derives
		// `appendStdBinOp`'s purity guard for free rather than sitting beside it.
		//
		// ⭐ **THAT WARNING NAMED THE EXACT SHAPE X10 THEN LANDED, AND ROUTING THROUGH `lowerBinOp` IS WHY IT
		// COST NOTHING.** It read: *"add an UNSIGNED divide for an unsigned operand type in `lowerDivision`
		// and a checked unsigned divide would go on emitting the signed `idiv`, silently, for every divisor
		// the compiler cannot prove non-zero."* The unsigned divide exists now, and the expansion picks its
		// opcode from the SAME `divisionOpcodeFor` the bare route does — so the silent divergence the comment
		// predicted never had a place to occur.
		//
		// ⚠ The FLOAT arm hands it the RAW operands and the integer arm the guarded ones, and that asymmetry is
		// the ISA's, stated once in this function's header: `divsd` cannot fault, so a float divide needs the
		// FLAG computed and nothing else guarded.
		if stdTypeIsFloat(operandType) 'floatDivide'
			match kind 'floatKind'
				quotient then break 'floatKind'
				remainder to guardedRemainder then panic("lowerDivisionExpansion: float `mod` does not exist — `requireBinOpOperands` refuses it, so a float-typed remainder expansion is a parser bug")
				notCheckedDivision then panic("lowerDivisionExpansion: reached with `notCheckedDivision` — `lowerTryCall` and `lowerRuntimeCall` route only the three division kinds here")
			end 'floatKind'

			// ⚠ THERE IS NO UNSIGNED FLOAT DIVIDE, and the arm below would emit an INTEGER one over two
			// IEEE bit patterns rather than fail. `Parser.emitDivOrMod` asks the signedness rule only of
			// an integer pair, so this is unreachable — which is exactly why it must say so out loud.
			if signedness == IntegerSignedness.unsigned 'unsignedFloat'
				panic("lowerDivisionExpansion: an UNSIGNED float `/` — `divsd` has no signedness and `Parser.emitDivOrMod` asks the division signedness rule only of an integer operand pair, so the callee name that carried this here was minted for a float divide")
			end 'unsignedFloat'

			self.lowerBinOp(result, lhs: dividend, rhs: divisor, op: MaxonBinOp.div, dstBlock: dstBlock)
			return
		end 'floatDivide'

		// A1x — asked of the KIND rather than of the channel, because both remainders need it: a possibly-zero
		// divisor is a possibly-`-1` divisor too (`emitDivOrMod`'s proof rules out neither), and the quotient
		// needs it never.
		var safeDividend = dividend
		if divisionKindReadsRemainder(kind) 'remainderOverflow'
			safeDividend = self.emitRemainderOverflowSafeDividend(dividend, divisor: divisor, operandType: operandType, dstBlock: dstBlock)
		end 'remainderOverflow'

		// A1 — `divisor or flag` is `divisor` whenever the divisor is non-zero and `1` when it is zero, so the
		// divide always runs on a safe operand. A total division's divisor needs no repair: nothing proved it
		// zero, so nothing has to be OR'd out of it.
		var safeDivisor = divisor
		match expansion 'divisorGuard'
			checkedQuotient(errorFlag) then safeDivisor = self.emitOrredSafeDivisor(divisor, errorFlag: errorFlag, operandType: operandType, dstBlock: dstBlock)
			checkedRemainder(errorFlag) then safeDivisor = self.emitOrredSafeDivisor(divisor, errorFlag: errorFlag, operandType: operandType, dstBlock: dstBlock)
			guardedRemainder then break 'divisorGuard'
		end 'divisorGuard'

		// ⭐ The KIND says WHICH division and the callee's SIGNEDNESS says at what reading — the two facts
		// the name carries, rejoined through the same `divisionOpcodeFor` the bare route mints its opcode
		// with, so an expanded divide and a bare one cannot pick different instructions from one source `/`.
		self.lowerBinOp(result, lhs: safeDividend, rhs: safeDivisor, op: divisionOpcodeFor(divisionOperatorForKind(kind), unsigned: signedness == IntegerSignedness.unsigned), dstBlock: dstBlock)
	end 'lowerDivisionExpansion'

	// A1's zero guard: the divisor the `idiv` actually reads. See `lowerDivisionExpansion`'s header for why
	// an `or` with the error flag is the whole of it.
	function emitOrredSafeDivisor(divisor ValueId, errorFlag ValueId, operandType StdType, dstBlock IrBlock) returns ValueId
		let safeDivisor = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(safeDivisor, lhs: divisor, rhs: errorFlag, opcode: StdBinOpcode.bitOr, operandType: operandType))
		return safeDivisor
	end 'emitOrredSafeDivisor'

	// ⭐ **`panic("message")` — THE SAME `mrt_panic` ROUTE THE RANGE-CHECK GUARD TAKES**, reached with the
	// message the parser already baked. The parser emitted a dead return terminator after this op, so the
	// block stays well-formed though control never reaches it.
	//
	// ⭐ **THIS DOOR WAS THE ONLY THING MISSING.** It used to materialize `RuntimeAbort.userPanic` (134) and
	// `osExit`, dropping the message on the floor — while `InsertRangeChecks`, one tier along, was already
	// interning a `panic at <file>:<line>: …` blob and calling a runtime that prints it, walks the stack and
	// exits 1. Two panics, one runtime, and a user's was wired to neither the printer nor the exit code the
	// language promises. The mechanism needed no work; the wire did.
	//
	// The blob is registered through `registerStringBlob` — the same immortal, NUL-terminated, DEDUPED BY
	// BYTES `.rdata` path a String literal's payload takes. Deduping by bytes is what makes two panics with
	// distinct messages take distinct labels (and two with identical text at identical positions correctly
	// share one), so `osPanic` can never print a neighbour's message.
	// ⚠ **THE BAKED HALF OF A PAIR.** A message with an INTERPOLATION cannot be interned — `{x}` is not
	// known until the program runs — so the parser assembles that line at run time and emits
	// `panicAbortValue`, which lowers to `osPanicValue` (a POINTER) a few lines above. Both end on
	// `mrt_panic` with a NUL-terminated line; only where the bytes live differs.
	function lowerPanicAbort(message ByteArray, dstBlock IrBlock)
		let blobLabel = registerStringBlob(self.globalData, bytes: message)
		self.stdModule.appendOp(dstBlock, op: StdOp.osPanic(blobLabel.toByteArray()))
	end 'lowerPanicAbort'

	// A fresh `const 0` (i64) — the ZERO ERROR FLAG (always a GPR value) needs one, at several sites, so
	// the mint-and-append lives in one place. The family-default PRIMARY value is a different call
	// (`emitZeroConstOfReturnType`): a flag is always integral, but a primary value must be born in the
	// return type's register file.
	function emitZeroConst(dstBlock IrBlock) returns ValueId
		let zero = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
		return zero
	end 'emitZeroConst'

	// The THROW-edge PRIMARY value — a family-default the caller reads ONLY for its register file, never
	// its bits (once the error flag is set the value is dead). It must be born in the file the return type
	// occupies, or the backend's `errorReturn` move crosses register files and the x64 emitter panics
	// (`move from rax to xmm0 crosses register files`). A FLOAT return needs an XMM-classed zero — an f64
	// `const 0`, which `buildValueClassColumns` classes XMM from its Std type (the f64 bits of 0.0 are 0).
	// It mints EXACTLY ONE ValueId whatever the return type, so the id numbering is unchanged.
	//
	// ⚠ **THE TYPE IS `stdDefaultPrimaryReturnType`'S AND NOT THIS FUNCTION'S (X6 review)** — the same
	// answer `InsertRangeChecks.emitDeadReturn` mints its dead primary from, which used to be a second and
	// STRICTER rule spelled in that pass. See that function for the divergence and why the declared type
	// is the right single answer.
	function emitZeroConstOfReturnType(dstBlock IrBlock) returns ValueId
		let zero = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(zero, value: 0, valueType: stdDefaultPrimaryReturnType(self.currentReturnType)))
		return zero
	end 'emitZeroConstOfReturnType'

	// A fresh ValueId for the current function, past the parser's dense id space — a plain counter bump,
	// no per-function object. The Std passes downstream grow their dense columns to fit the highest id, so
	// a monotonically increasing id is all that is required.
	function mintStdValueId() returns ValueId
		let id = self.nextValueId
		self.nextValueId = self.nextValueId + 1
		return id
	end 'mintStdValueId'

	// set-as-terminator vs append-as-body, shared by the return/error-return emitters.
	function emitTerminatorOrBody(dstBlock IrBlock, op StdOp, asTerminator bool)
		if asTerminator 'asTerm'
			self.stdModule.setTerminator(dstBlock, op: op)
		end 'asTerm' else 'asBody'
			self.stdModule.appendOp(dstBlock, op: op)
		end 'asBody'
	end 'emitTerminatorOrBody'
end 'MaxonToStdLowering'
