// LowerMaxonToStd — Maxon → Std lowering. Takes a MaxonModule and produces a
// fresh StdModule.
//
// **What this pass is FOR: the width/ABI collapse and the 1:N desugaring.**
// `MaxonType` is width-free and source-level; `StdType` is width/ABI-resolved.
// That translation (`maxonTypeToStdType`) is this boundary's real content, along
// with the 1:N expansions that GROW here — a `for-in` into an iterator protocol, a
// labelled method call into a dispatch, a string interpolation into a buffer
// build, an `own.drop` into a `__destruct_T` call.
//
// **What this pass is NOT for: value numbering.** ValueIds pass through VERBATIM —
// the parser mints them (see MaxonDialect's MaxonOp header). v1 did the opposite:
// it named Maxon values `$tN` and re-derived ids here through a per-function
// `nameToId` map, which cost a heap String + ByteArray per value and a
// byte-sequence-keyed hash map (O(len) compares, one insert + one lookup per
// value) to convert one dense counter into another. It constructed no SSA — user
// variables are `VarSlot`s, and `mem2reg` does the real SSA work at the Std tier.
// The map, `defineName`, and `resolveName` are all deleted.
//
// Ops that SYNTHESIZE new values (the 1:N desugarings) must not collide with the parser's ids: they
// mint from `nextValueId`, a per-function counter seeded at the parser's dense id count (the next free
// id). P1.4b's error lowering is the first to synthesize — the `+1` flag re-encode, the zero flag of a
// throwing return, the `panicAbort` exit code — and the Std passes downstream grow their dense columns
// to fit, so a monotonic counter is all that is needed (no per-function object).
//
// THIN for maxon-shv2 M1: lowers exactly the `return 42` slice —
//   maxon.literal -> StdOp.const
//   maxon.ret     -> StdOp.ret
// Later milestones GROW `lowerOp`/`lowerTerminator` with the var / arith / call
// / control-flow arms (and the throwing / fat-interface return arms of
// `emitRetOrErrorReturn`) as the Maxon and Std dialects grow.

// Collapse a source-level MaxonType to its width/ABI-resolved StdType. M1
// handles only the primitive arms. `named` and `unresolved` are a
// TypeResolution (Chunk C) responsibility: that pass replaces every
// `named(alias)` with the primitive it resolves to (consulting the typealias
// registry for its width) and eliminates every `unresolved` BEFORE lowering
// runs. Seeing either arm here is a pipeline-ordering bug (TypeResolution did
// not run, or left a residue) — not a user error — so it panics loudly rather
// than silently guessing a width. GROWS at Chunk C to resolve `named` widths
// through the registry once that registry exists.
export function maxonTypeToStdType(ref MaxonType) returns StdType
	// The two arms TypeResolution was supposed to eliminate. They are a PIPELINE-ORDERING bug
	// (that pass did not run, or left a residue) rather than a user error, and they are checked
	// HERE rather than in `valueTagToStdType` because the two functions are asked different
	// questions about the same arm — see that function's header on why a `named` TAG is normal
	// while a `named` TYPE at this point is not.
	match ref 'residue'
		named then panic("maxonTypeToStdType: a `named` type must be resolved to a primitive before lowering (TypeResolution did not run)")
		unresolved then panic("maxonTypeToStdType: an `unresolved` type reached lowering (TypeResolution did not run)")
		boolean to float then break 'residue'
		exitCode then break 'residue'
		// A struct reference is NOT a residue — it is what `resolveNamedType` PRODUCES for a
		// declared `type`, and it is already concrete. Its width is a machine word, assigned one
		// line down by the same table every other arm's comes from. (`named` is checked above and
		// this is not, because they are two different questions about one union: a `named` type
		// surviving to here means resolution left work undone; a `structRef` means resolution DID
		// its work.)
		structRef then break 'residue'
		// A String is NOT a residue — `Parser.parseTypeReference` produces `MaxonType.string` for the
		// `String` builtin directly (syntactically, like `Self`), so it is already concrete. Its width
		// is a machine word (a pointer), assigned one line down by the same table every arm's comes from.
		string then break 'residue'
		// A function value is NOT a residue — `Parser.parseTypeReference`/`emitFunctionRef` produce
		// `MaxonType.function` directly, so it is already concrete. Its width is a machine word (a `.text`
		// code pointer), assigned one line down by the same table every arm's comes from.
		function then break 'residue'
		// A type parameter and a generic instance are NOT residues (P1.6-A) — the parser produces them
		// directly and `resolveType` leaves them alone (they are already concrete: an opaque i64 and a
		// struct pointer). Their width is a machine word, assigned one line down by the same table.
		typeParameter then break 'residue'
		genericInstance then break 'residue'
	end 'residue'

	return valueTagToStdType(maxonTypeTag(ref))
end 'maxonTypeToStdType'

// ⭐ THE WIDTH/ABI COLLAPSE, STATED OVER THE PARSER'S DENSE TAG COLUMN — and the form the
// per-OPERAND path must use. `maxonTypeToStdType` is the same collapse asked of a `MaxonType`,
// and it DELEGATES here rather than restating the lattice: this boundary's whole content is that
// one table, and two copies of it are the drift that would let a `literal`'s width and its
// operand's width come to disagree.
//
// It takes a TAG, and the reason is measured rather than aesthetic: the alternative spelling —
// `maxonTypeToStdType(maxonTypeOfTag(tag, …))` — REBUILDS A `MaxonType`, and **a Maxon union
// value is a heap object** (MaxonDialect's ValueTypeTag header has the measurement: the first cut
// of exactly this shape cost +4,165 allocations on scale-test's smallest rung). `operandType` is
// read for every operand of every arithmetic op in the program — the compiler's hottest path — so
// the answer has to be a scalar computed from a scalar.
//
// ⚠ `named` collapses to `i64` here and PANICS there, and that asymmetry is deliberate. A
// `MaxonType.named` reaching lowering means TypeResolution left a residue; a `named` TAG is
// perfectly ordinary, because `TypeResolution.resolveTypes` rewrites function SIGNATURES and
// never the parser's `valueTags` column — so a parameter declared with a ranged alias still
// carries a `named` tag right here. It collapses to i64 because a `named` value is an INT in every
// position F1 can reach one: as of F1 a `float(low to high)` alias is also legal
// (`Parser.readTypeAliasDeclaration`), but a float alias is tagged `named` only as a param/field, all
// deferred to the float ABI (F2), and the i64 collapse there forces a cross-file move the x64
// allocator PANICS on rather than passing a double in a GPR — never a wrong answer. Classing a float
// alias as f64 needs `named` resolved through the alias registry, which is that F2 work (TypeRules'
// `typeClassOf`/`tagIsIntegral`/`notOperatorFor` all cite the same resolution).
export function valueTagToStdType(tag ValueTypeTag) returns StdType
	match tag 'collapse'
		boolean then return StdType.i1
		integer then return StdType.i64
		float then return StdType.f64
		named then return StdType.i64
		// `exitCode` is the resolved `ExitCode` builtin alias. Its width is
		// assigned HERE (unsigned 32-bit) — this is the sole place ExitCode's
		// width lives, keeping MaxonType itself width-free (see MaxonDialect).
		exitCode then return StdType.u32
		unresolved then panic("valueTagToStdType: an `unresolved` tag reached lowering — it is a call to a function no file in the program declares, which SemanticCheck reports as E3004 and which therefore never reaches codegen")
		void then panic("valueTagToStdType: a `void` tag names no value, so it has no width — a void call's result is a discarded statement result (Parser.parseCall) and can never be an operand")
		// ⭐ A STRUCT IS A POINTER, AND THIS LINE IS THE WHOLE OF THAT DECISION. `type Point` is a
		// heap-allocated refcounted box (`Parser.emitStructLiteral` → `__mm_alloc`), and a value of
		// that type is the box's ADDRESS — one machine word, in a GPR, passed and returned like any
		// other i64. It is why `sizeof(Outer{p Point, n Integer})` is 16 and not 24: a struct FIELD
		// is a pointer too. Nothing above this line knows the width, which is the point — MaxonType
		// stays width-free (see MaxonDialect) and the machine word is named exactly once, here.
		structRef then return StdType.i64
		// ⭐ A STRING IS A POINTER — to the fused 48-byte rdata record. One machine word, in a GPR,
		// passed and returned like any other i64. Nothing above this line knows the width, which is the
		// point: MaxonType stays width-free and the machine word is named exactly once, here.
		string then return StdType.i64
		// ⭐ A FUNCTION VALUE IS A POINTER — a `.text` code address. One machine word, in a GPR, passed
		// and returned like any other i64. Nothing above this line knows the width, which is the point:
		// MaxonType stays width-free and the machine word is named exactly once, here.
		function then return StdType.i64
		// ⭐ A TYPE PARAMETER IS AN OPAQUE MACHINE WORD (P1.6-A). `T` in `type Box uses T` lowers to an
		// i64, which is the WHOLE of what makes a generic type's method bodies compile ONCE and be
		// byte-identical to the equivalent monomorphic struct: a trivial type argument is passed in a
		// GPR and stored in an 8-byte slot like any other scalar. Nothing above this line knows the
		// width — MaxonType stays width-free — and the machine word is named exactly once, here.
		typeParameter then return StdType.i64
		// A GENERIC INSTANCE IS A POINTER to the base struct's box — one machine word, like `structRef`.
		genericInstance then return StdType.i64
	end 'collapse'
end 'valueTagToStdType'

// Collapse a function's MaxonReturnType to its StdReturnType. `void` maps
// straight across; a value return collapses its inner type via maxonTypeToStdType.
export function maxonReturnTypeToStdReturnType(ref MaxonReturnType) returns StdReturnType
	match ref 'collapse'
		void then return StdReturnType.void
		value(inner) then return StdReturnType.value(maxonTypeToStdType(inner))
	end 'collapse'
end 'maxonReturnTypeToStdReturnType'

// Map a source-level binary operator to its width/ABI-resolved Std `binOp` opcode.
// Every NON-TRAPPING operator maps to a `StdBinOpcode` — the arithmetic set
// (`add`/`sub`/`mul`), the bit set (`bitAnd`/`bitOr`/`bitXor`/`shl`/`shr`), and the FLOAT
// division. `mod` does NOT (it lowers to its own `StdOp.mod` variant because idiv traps —
// see `lowerBinOp`), so it panics here rather than inventing a bogus opcode.
// Exhaustive over MaxonBinOp (every arm is named).
//
// ⚠ `div` IS FLOAT-ONLY, and this function CANNOT enforce that — it sees an operator, not an
// operand type. `lowerDivision` is the one place a `/` picks its Std op, and `appendStdBinOp`
// carries the guard that makes an integer `binOp(div)` unrepresentable rather than merely
// unwritten. Do not call this with `div` from anywhere else.
export function maxonBinOpToStdOpcode(op MaxonBinOp) returns StdBinOpcode
	match op 'map'
		add then return StdBinOpcode.add
		sub then return StdBinOpcode.sub
		mul then return StdBinOpcode.mul
		div then return StdBinOpcode.div
		mod then panic("maxonBinOpToStdOpcode: `mod` lowers to StdOp.mod — a trapping op with its own Std variant, not a binOp opcode; lowerBinOp must route it directly")
		bitAnd then return StdBinOpcode.bitAnd
		bitOr then return StdBinOpcode.bitOr
		bitXor then return StdBinOpcode.bitXor
		shl then return StdBinOpcode.shl
		shr then return StdBinOpcode.shr
		shrLogical then return StdBinOpcode.shrLogical
	end 'map'
end 'maxonBinOpToStdOpcode'

// Map a source-level unary operator to its Std opcode. A 1:1 rename in every arm —
// the TYPE decision that split `not` into `bitNot`/`logicalNot` was already made in
// the parser (see MaxonUnaryOp), so nothing is re-derived here. Exhaustive by
// construction.
export function maxonUnaryOpToStdOpcode(op MaxonUnaryOp) returns StdUnaryOpcode
	return match op 'map'
		neg gives StdUnaryOpcode.neg
		bitNot gives StdUnaryOpcode.bitNot
		logicalNot gives StdUnaryOpcode.logicalNot
		// The conversion pair — still a 1:1 rename, and still no decision made here: the parser
		// chose the DIRECTION (it is the tier that knows the operand is a float), and the Std
		// opcode only renames it. `trunc` is the source builtin; `promoteToFloat` is inserted.
		trunc gives StdUnaryOpcode.fpToSi
		promoteToFloat gives StdUnaryOpcode.siToFp
		// The math intrinsics — a 1:1 rename like the rest, and the only reason they are spelled
		// separately from the conversions above is that they are NOT conversions: they stay inside
		// the float domain, so `assertConversionCrossesDomain` must not be asked about them.
		floor gives StdUnaryOpcode.floor
		ceil gives StdUnaryOpcode.ceil
		round gives StdUnaryOpcode.round
		sqrt gives StdUnaryOpcode.sqrt
	end 'map'
end 'maxonUnaryOpToStdOpcode'

// **A UNARY OPCODE'S OPERAND DOMAIN IS PART OF THE OPCODE**, and the parser is what has to have
// arranged it. Every arm is unreachable by construction, which is exactly why the check is written:
// it is what stops "unreachable" from quietly becoming "unwritten" the day one of those gates moves.
//
//   • a CONVERSION must CROSS the domain it names — `siToFp` over a float, or `fpToSi` over an
//     integer, converts a type to ITSELF, and there is no instruction for it. `Parser.promoteToFloat`
//     returns early on a value already in the float domain, and `Parser.emitTrunc` answers
//     `trunc(int)` with the operand itself rather than an op.
//   • a MATH INTRINSIC (`floor`/`ceil`/`round`/`sqrt`) is f64 → f64, so it must be handed a FLOAT —
//     `Parser.emitMathIntrinsic` promotes an integer argument before emitting the op, which is what
//     makes `sqrt(16)` answer 4 rather than reaching an instruction that has no integer form.
//
// It reads `operandType`, which is the SOURCE and — on the conversions — never the result. That is
// the one fact StdUnaryOpcode's header exists to hammer, and the one that would send a value to the
// wrong register file if it were read backwards; `stdUnaryOperandIsFloat` is the single place it is
// written down, shared with both native isels.
function assertUnaryOperandDomain(opcode StdUnaryOpcode, operandType StdType)
	if stdTypeIsFloat(operandType) == stdUnaryOperandIsFloat(opcode) 'agrees'
		return
	end 'agrees'

	let required = "FLOAT" if stdUnaryOperandIsFloat(opcode) else "INTEGER"
	panic("lowerUnaryOp: Std unary opcode {opcode.name} reads a {required} operand and was handed Std type {operandType.name} — the parser owns this precondition (promoteToFloat/emitTrunc/emitMathIntrinsic), so a mismatch here is a front-end bug, not a lowering one")
end 'assertUnaryOperandDomain'

// Map a source-level comparison operator to its Std predicate. M4 is a 1:1 mapping;
// exhaustive by construction (every MaxonCmpOp arm is named). The x64 tier turns the
// predicate into a signed jcc condition when it fuses the compare with its branch.
export function maxonCmpOpToStdPred(op MaxonCmpOp) returns StdCmpPred
	return match op 'map'
		eq gives StdCmpPred.eq
		ne gives StdCmpPred.ne
		lt gives StdCmpPred.lt
		gt gives StdCmpPred.gt
		le gives StdCmpPred.le
		ge gives StdCmpPred.ge
	end 'map'
end 'maxonCmpOpToStdPred'

// Does any parameter of `sig` have `float` type — the ONLY thing that can force an int→float
// argument widening (see `MaxonToStdLowering.widenIntArgsToFloatParams`). A bounded scan (parameters
// are capped at the register-arg ABI count), so it is O(1) per call and allocates nothing; it is what
// lets the overwhelmingly common no-float call return its arguments verbatim rather than build a fresh
// array it would never change. `sig.paramTypes` is alias-resolved by TypeResolution, so
// `maxonTypeToStdType` cannot meet a residual `named` here.
function signatureHasFloatParam(sig FuncSignature) returns bool
	for paramType in sig.paramTypes 'eachParam'
		if stdTypeIsFloat(maxonTypeToStdType(paramType)) 'float'
			return true
		end 'float'
	end 'eachParam'
	return false
end 'signatureHasFloatParam'

// Does any parameter of `sig` have `function` type — the ONLY thing that forces a companion environment
// argument to be threaded at the call (see `MaxonToStdLowering.appendCalleeEnvArgs`). Bounded scan (the same
// shape as `signatureHasFloatParam`), so the overwhelmingly common no-function call returns its slotted
// arguments verbatim rather than building a fresh array.
function signatureHasFunctionParam(sig FuncSignature) returns bool
	for paramType in sig.paramTypes 'eachParam'
		if maxonTypeTag(paramType) == ValueTypeTag.function 'function'
			return true
		end 'function'
	end 'eachParam'
	return false
end 'signatureHasFunctionParam'

// Public entry: lower a whole MaxonModule to a fresh StdModule. Takes the whole `Project`, because the
// lowering now needs three things off it: the `funcSignatures` registry (label→positional argument
// slotting), the `.rdata` table (`globalData`, where string literals and — P1.6-B1 — layout descriptors
// register), and the whole-program `ProgramSignatures` (`queryProgramSignatures`, memoized before the
// pipeline) whose `genericInstances`/`structTypes` size and mangle a generic instance's layout descriptor.
//
// ⚠ **`project` is a P1.6-B1 addition** — the pre-B1 lowering took only `funcSignatures` + `globalData`
// and never touched the project. Dictionary-passing forced it: a `sizeof(T)` call site must materialise
// the receiver instance's descriptor, which needs the whole-program `(baseId, args)` payload that lives
// only on `ProgramSignatures`, and that is reachable only through the project.

// The set of qualified function names whose body reads `sizeof(T)` and therefore carries a hidden
// trailing layout-descriptor parameter (P1.6-B1). Built once per lowering by an op-scan; read at a call
// site to decide whether to append the descriptor argument, and per callee to bind the descriptor param.
export typealias LayoutNeedingFuncSet = Map with (ByteArray, bool)

// The set of witness-table `.rdata` labels already emitted (P1.7a slice 2a) — the blob, its method-slot
// relocations, and the DCE-rooting of each impl are recorded ONCE per `(Type, Interface)`, even though a
// concrete dispatch may reference the table at many call sites. `registerRdataConstantLabeled` is idempotent
// by label on its own, but the relocations and the root are not, so this dedup gate guards them.
//
// ⭐ **KEYED ON THE LABEL, WHICH *IS* THE PAIR** — and that is a property of the label, not an assumption
// here. `witnessTableLabel` joins with a character no name can contain, so the label and the
// `(Type, Interface)` pair are in bijection and this memo is lossless. It was NOT, when the join was `_`:
// `(A_B, C)` and `(A, B_C)` shared a key, so the second pair hit this gate, took the first pair's table and
// never recorded its own relocations — a silent wrong answer that looked exactly like a cache hit. The
// remedy is the separator and NOT a second, pair-keyed memo beside this one: two keys for one fact is the
// shape that drifts, and with an injective label there is nothing the pair knows that the label does not.
export typealias WitnessTableLabelSet = Set with String

export function lowerMaxonToStd(maxonModule MaxonModule, project Project) returns StdModule
	return MaxonToStdLowering.create(maxonModule, project: project).lower()
end 'lowerMaxonToStd'

// The label guard shared by `lowerRuntimeCall` (a plain `call`) and the compiler-internal arm of
// `lowerTryCall` (a throwing `tryCall`): a runtime entry point is declared by nothing, so there is no
// signature to slot a label against — a label would silently fill the position it was WRITTEN in, a wrong
// answer with no diagnostic anywhere. `Parser.emitRuntimeCall` builds an all-empty label column, so a
// label here means someone taught the parser to write one. It panics at the one place that could still
// see it. ONE home so the non-throwing and throwing runtime-call paths cannot drift on this rule.
function requireRuntimeCallPositional(callee ByteArray, argLabels ByteArrayArray)
	for label in argLabels 'eachLabel'
		if not label.isEmpty() 'labelled'
			panic("requireRuntimeCallPositional: the runtime call to '{String.from(callee)}' carries the argument label '{String.from(label)}' — a runtime entry point is declared by nothing, so there is no signature to slot a label against and the argument would silently fill the position it was WRITTEN in. Runtime calls are positional: see Parser.emitRuntimeCall")
		end 'labelled'
	end 'eachLabel'
end 'requireRuntimeCallPositional'

type MaxonToStdLowering
	var maxonModule as MaxonModule
	var stdModule as StdModule
	// Whole-program parameter signatures (names + types), for `lowerCall`'s
	// label→positional argument slotting.
	var funcSignatures as FuncSignatureMap
	// The whole-program signature index (`queryProgramSignatures`) — P1.6-B1's source for a generic
	// instance's `(baseId, args)` payload: `ensureLayoutDescriptor` sizes and mangles a descriptor
	// through `genericInstanceBoxSize` / `genericInstanceSoleArgLogicalSize` / `mangleGenericInstance`.
	var signatures as ProgramSignatures
	// The qualified names of functions that carry a hidden layout-descriptor parameter (P1.6-B1) — built
	// once by `buildLayoutNeedingFuncs` (an op-scan for `sizeofType(typeParameter)`), then read at every
	// call site (append the descriptor argument?) and per callee (bind the descriptor param?).
	var layoutNeedingFuncs as LayoutNeedingFuncSet
	// `GenericInstanceId` ⇒ the `.rdata` label of its emitted descriptor blob (P1.6-B1). Filled lazily by
	// `ensureLayoutDescriptor` — one blob per instance actually used as a `sizeof(T)` receiver — so a
	// program pays for exactly the descriptors it references.
	var layoutDescriptors as LayoutDescriptorRegistry
	// The whole-program user interface registry (P1.7a slice 2a), from `project.interfaces` — resolved (with
	// the synthesized builtins) to read an interface's method LIST when building a witness table blob (one slot
	// per method, in decl order). Fully merged by lowering time, so a cross-file interface resolves here.
	var interfaces as IrInterfaceMap
	// The witness tables already emitted (P1.7a slice 2a) — the dedup gate for the blob's relocations + root.
	var emittedWitnessTables as WitnessTableLabelSet
	// The backend's `.rdata` table — where `stringLiteral` registers its immortal 48-byte record and
	// its NUL-terminated byte blob (P1.2 wave A). It is the SAME table the backend later resolves the
	// emitted `rdataAddr` label against, and the one that carries the buffer fixups to the PE writer.
	// Threaded here rather than a field on some later pass because this is the FIRST tier that turns a
	// source literal into rdata bytes.
	var globalData as GlobalDataTable
	// ⭐ THE TYPE ORACLE FOR THE FUNCTION CURRENTLY BEING LOWERED — the parser's per-value
	// `ValueTypeTag` column, published on `IrFunction.valueTags` and re-pointed at each function
	// by `lower`. It is what fills the Std arith band's `operandType`.
	//
	// Reading it is ASKING THE ONE ORACLE, not building a second one. The parser decided every
	// value's source-level type (it must — a bool `and` is control flow), and it publishes the
	// column precisely so a later pass need not re-derive one. The alternative — recovering an
	// operand's type by walking back to its defining op — is a SECOND TYPE SYSTEM in the tier
	// furthest from the source, which is the exact thing `operandType` was added to prevent (see
	// StdDialect's `binOp` header).
	//
	// It is a per-function BINDING rather than a parameter threaded through `lowerOp`, because
	// every op in a function shares one column and the walk is already per-function.
	var valueTags as ValueTypeTagArray
	// The per-value closure-environment column of the function CURRENTLY being lowered (P1.5-A2b-2) —
	// re-pointed per function like `valueTags`, from the SAME `IrFunction.valueClosureEnv` the parser
	// published. `appendCalleeEnvArgs` reads it to thread a function-value ARGUMENT's environment to a callee.
	var valueClosureEnv as ValueIdArray
	// The per-value NAME column of the function CURRENTLY being lowered — re-pointed per function like
	// `valueTags`, from `IrFunction.valueNameIds`. For a `genericInstance`-tagged receiver at a `sizeof(T)`
	// call site it carries the `GenericInstanceId`, which `materializeLayoutArg` resolves to a descriptor.
	var valueNameIds as TypeNameIdArray
	// The name of the function CURRENTLY being lowered — re-pointed per function, for the diagnostics the
	// dictionary-passing invariant checks raise (`bindImplicitLayoutParam` / `forwardCallerLayout`).
	var currentFuncName as ByteArray
	// The ValueId of the CURRENT function's hidden layout-descriptor parameter (P1.6-B1), or an unused 0
	// when it carries none — `hasImplicitLayout` is the authoritative "does it carry one?" bit, because a
	// zero-user-parameter generic method's descriptor slot is legitimately ValueId 0 (no sentinel).
	var implicitLayoutValueId as ValueId
	// Does the CURRENT function carry a layout-descriptor parameter? The non-sentinel gate on
	// `implicitLayoutValueId` — read by `sizeof(T)` lowering and `forwardCallerLayout`.
	var hasImplicitLayout as bool
	// The number of hidden WITNESS parameters the CURRENT function carries (P1.7a slice 2a) — one per `where`
	// constraint of its enclosing type, for an instance method of a constrained generic type (0 otherwise).
	// The witness parameters occupy the FINAL `currentWitnessCount` ValueIds, so witness slot `i` is
	// `witnessParamBase + i`. `bindImplicitParams` sets both from the type's constraint count.
	var currentWitnessCount as ParamCount
	// The ValueId of the CURRENT function's FIRST witness parameter (P1.7a slice 2a) — `paramCount -
	// currentWitnessCount`. Read by `lowerWitnessDispatch` to forward the caller's own witness slot to a
	// dispatch. Meaningless (and unread) when `currentWitnessCount` is 0.
	var witnessParamBase as ValueId
	// The `throws` clause of the function CURRENTLY being lowered (P1.4b) — re-pointed per function like
	// `valueTags`. `emitRetOrErrorReturn` reads it to decide whether a normal `ret`/`retVoid` becomes the
	// dual-register `errorReturn` (a THROWING function writes both the value AND a zero error flag).
	var currentThrows as ThrowsClause
	// The Std RETURN TYPE of the function CURRENTLY being lowered (F3b) — re-pointed per function like
	// `currentThrows`, from the SAME `IrFunction.returnType` the backend reads. A throwing function's
	// throw-edge primary value is a family-default the caller ignores, so only its REGISTER FILE matters;
	// `emitZeroConstOfReturnType` reads this to class that default as the return type's file (an XMM zero
	// for a float return, else a GPR zero) — the identical field `emitReturnValueMove` keys the return
	// register off, so the throw-edge default and the return register cannot come to disagree.
	var currentReturnType as StdReturnType
	// The next fresh ValueId for the CURRENT function — a plain counter (no per-function object) seeded at
	// the parser's dense id count, i.e. the next free id. The ops this pass synthesizes (the flag re-encode
	// of a throw, the zero flag of a normal throwing return, the exit code a `panicAbort` expands into) mint
	// from here so their ids collide with none the parser minted; the Std passes downstream grow their dense
	// columns to fit the highest id, so a monotonic counter is all that is required.
	var nextValueId as ValueId

	static function create(maxonModule MaxonModule, project Project) returns MaxonToStdLowering
		// `queryProgramSignatures` is memoized and was computed by `compileToCodeResult` before the
		// pipeline runs, so this is an O(1) cache hit; a fresh FAILURE here is impossible (a signature
		// error would already have thrown before lowering was scheduled).
		let signatures = try queryProgramSignatures(project) otherwise panic("MaxonToStdLowering.create: queryProgramSignatures failed inside the lowering pass — it is computed and memoized by compileToCodeResult before the pipeline runs, so it cannot fail fresh here")
		return Self{maxonModule: maxonModule, stdModule: StdModule.create(), funcSignatures: project.funcSignatures, signatures: signatures, layoutNeedingFuncs: LayoutNeedingFuncSet.create(), layoutDescriptors: LayoutDescriptorRegistry.create(), interfaces: project.interfaces, emittedWitnessTables: WitnessTableLabelSet.create(), globalData: project.globalData, valueTags: ValueTypeTagArray.create(), valueClosureEnv: ValueIdArray.create(), valueNameIds: TypeNameIdArray.create(), currentFuncName: EmptySourceText, implicitLayoutValueId: 0, hasImplicitLayout: false, currentWitnessCount: 0, witnessParamBase: 0, currentThrows: ThrowsClause.none, currentReturnType: StdReturnType.void, nextValueId: 0}
	end 'create'

	// The Maxon type TAG a value carries, from the column `lower` pointed at the CURRENT function. The one
	// read+panic for "this value has a recorded tag" — every SSA value is minted through `Parser.mintValue`
	// and the column is dense over every ValueId, so a miss is a lowering bug (a value never minted, or
	// `lower` failing to re-point `valueTags` at the function being walked).
	function valueTagOf(value ValueId) returns ValueTypeTag
		return try self.valueTags.get(value) otherwise panic("valueTagOf: value v{value} has no recorded type — every SSA value must be minted through Parser.mintValue, and `lower` must point `valueTags` at the function being walked")
	end 'valueTagOf'

	// The Std type a VALUE computes in — the truth the arith band's `operandType` carries, and a
	// single indexed read of the column `lower` pointed at this function.
	function stdTypeOf(value ValueId) returns StdType
		return valueTagToStdType(self.valueTagOf(value))
	end 'stdTypeOf'

	function lower() returns StdModule
		// Which functions carry a hidden layout-descriptor parameter (P1.6-B1) — computed ONCE, up front,
		// so both directions of the ABI (a callee binding its slot, a caller appending the argument) read
		// one whole-program answer. An op-scan over the Maxon module; O(total ops), linear.
		self.buildLayoutNeedingFuncs()

		// Relocate blocks 1:1 first so blockRef indices stay aligned between the
		// source MaxonModule and the dest StdModule; each dest block starts empty
		// and its ops are appended during the per-function walk below. The
		// per-block source footprint is copied in lock-step so it survives to the
		// coverage-instrumentation pass (a later-milestone consumer).
		for i in 0 upto self.maxonModule.blocks.count() 'relocateBlocks'
			let srcBlock = try self.maxonModule.blocks.get(i) otherwise panic("lowerMaxonToStd: maxonModule.blocks.get OOB at {i}")
			// Fresh block: opRefs/terminator are rebuilt by the per-function walk below.
			// The phi model the parser attached (block-args + the per-edge branchEdges
			// carrying each phi's incoming values) is SHARED with the Maxon block, not
			// copied: the ValueIds it names pass through this lowering verbatim, so the
			// two tiers want the identical data. Sharing is safe because no Std pass
			// mutates it in place — `pruneDeadBlockArgs` rebuilds both lists and
			// field-assigns them onto the Std block, leaving the Maxon block's own
			// arrays untouched. See IrBlock's header for the ownership rules.
			var dstBlock = IrBlock.create(srcBlock.id, label: srcBlock.label)
			dstBlock.blockArgs = srcBlock.blockArgs
			dstBlock.branchEdges = srcBlock.branchEdges
			self.stdModule.blocks.push(dstBlock)
			let srcInfo = try self.maxonModule.blockSourceInfo.get(i) otherwise BlockSourceInfo.empty()
			self.stdModule.blockSourceInfo.push(srcInfo)
		end 'relocateBlocks'

		// Transfer each function, collapsing its Maxon-phase types (return type +
		// param types) to the Std-phase types. blockRefs stay valid because block
		// indices were kept 1:1 above.
		for i in 0 upto self.maxonModule.functions.count() 'transferFuncs'
			var func = try self.maxonModule.functions.get(i) otherwise panic("lowerMaxonToStd: maxonModule.functions.get OOB at {i}")
			var stdParams = StdTypeArray.create()
			for paramType in func.maxonParamTypes 'eachParam'
				stdParams.push(maxonTypeToStdType(paramType))
			end 'eachParam'
			// The uniform ABI's companion environment parameters (P1.5-A2b-2) sit PAST the user parameters:
			// `paramCount` counts them, `maxonParamTypes` does not (each is an i64 pointer with no source type).
			// Grow the Std parameter list to `paramCount` so `emitParams` materializes every incoming register and
			// the wasm functype covers every slot.
			for _ in func.maxonParamTypes.count() upto func.paramCount 'envParam'
				stdParams.push(StdType.i64)
			end 'envParam'
			func.returnType = maxonReturnTypeToStdReturnType(func.maxonReturnType)
			func.paramTypes = stdParams
			self.stdModule.functions.push(func)
		end 'transferFuncs'

		// Walk each function's blocks and lower their body ops + terminator. Value
		// ids need no per-function reset — the parser already numbered them densely
		// per function, and this pass passes them through untouched.
		for srcFunc in self.stdModule.functions 'eachFunc'
			// Point the type oracle at THIS function before any of its ops are lowered — the
			// column is dense per function, so every `stdTypeOf` below reads the right one.
			self.valueTags = srcFunc.valueTags
			// The closure-environment column travels with it (P1.5-A2b-2): `appendCalleeEnvArgs` threads a
			// function-value argument's env from here.
			self.valueClosureEnv = srcFunc.valueClosureEnv
			// The name column travels with it too (P1.6-B1): `materializeLayoutArg` reads a `genericInstance`
			// receiver's `GenericInstanceId` out of it.
			self.valueNameIds = srcFunc.valueNameIds
			self.currentFuncName = srcFunc.name
			// Bind this function's hidden implicit parameters (P1.6-B1 layout + P1.7a slice 2a witnesses).
			self.bindImplicitParams(srcFunc)
			self.currentThrows = srcFunc.throwsTypeName
			// The Std return type was collapsed onto `srcFunc.returnType` in the `transferFuncs` pass above,
			// so it is final here — read it, don't re-collapse `maxonReturnType`.
			self.currentReturnType = srcFunc.returnType
			// The next free ValueId is the count of the dense per-value column the parser handed over.
			self.nextValueId = srcFunc.valueTags.count()
			self.emitParams(srcFunc)

			for blockRef in srcFunc.blockRefs 'eachBlock'
				let srcBlock = try self.maxonModule.blocks.get(blockRef) otherwise panic("lowerMaxonToStd: blockRef from srcFunc.blockRefs not in maxonModule.blocks")
				var dstBlock = try self.stdModule.blocks.get(blockRef) otherwise panic("lowerMaxonToStd: stdModule.blocks 1:1 with maxonModule.blocks but get({blockRef}) failed")

				self.retypeBlockArgs(dstBlock)

				for opIdx in srcBlock.opRefs 'eachOp'
					let hlOp = try self.maxonModule.ops.get(opIdx) otherwise panic("lowerMaxonToStd: opIdx from srcBlock.opRefs not in maxonModule.ops")
					self.lowerOp(hlOp, dstBlock: dstBlock)
				end 'eachOp'

				if srcBlock.hasTerminatorOp() 'hasTerm'
					let termOp = try self.maxonModule.ops.get(srcBlock.terminatorIndex()) otherwise panic("lowerMaxonToStd: terminatorIndex not in maxonModule.ops")
					self.lowerTerminator(termOp, dstBlock: dstBlock)
				end 'hasTerm' else 'noTermOp'
					// An op-less terminator (`dead` for an unreachable if/else continuation,
					// `fallthrough` if a later pass elides one) carries no op to lower, but
					// its marker must survive so the Std block is still "terminated" — the
					// clone above left every dst block at `unset`.
					self.carryOplessTerminator(srcBlock, dstBlock: dstBlock)
				end 'noTermOp'
			end 'eachBlock'
		end 'eachFunc'

		return self.stdModule
	end 'lower'

	// Give every phi on this block the Std type its VALUE computes in — from `stdTypeOf`, the same
	// one oracle every operand's `operandType` comes from. A phi and its incoming values are then
	// typed by one fact rather than two that must agree.
	//
	// ⚠ THE PARSER CANNOT DO THIS, which is why it is here and not at the mint site. `Parser.mintPhi`
	// holds the phi's Maxon TAG and looks like the obvious place, but the collapse is only TOTAL
	// once SemanticCheck and TypeResolution have run: at parse time a tag may still be `unresolved`
	// (a call to a function no file declares — that is E3004's job) or `named` (a ranged alias, until
	// TypeResolution rewrites the signature). `valueTagToStdType` panics on the first and would have
	// crashed the compiler on a program with a clean diagnostic already waiting for it. By this pass
	// both residues are gone, and that is exactly what earns `stdTypeOf` the right to panic on them.
	//
	// It MUTATES the block-arg list `relocateBlocks` shares with the Maxon block, and that is this
	// pass's business rather than a violation of the sharing rule: the boundary is where Std facts
	// are established, `argType` IS a Std fact, and no Maxon-tier pass reads it.
	function retypeBlockArgs(block IrBlock)
		for i in 0 upto block.blockArgs.count() 'eachArg'
			var arg = try block.blockArgs.get(i) otherwise panic("retypeBlockArgs: i < count() but blockArgs.get({i}) failed")
			arg.argType = self.stdTypeOf(arg.valueId)
		end 'eachArg'
	end 'retypeBlockArgs'

	// Lower a regular (non-terminator) Maxon body op. A `ret`/`retVoid` reaching
	// here (mid-block) is the rare body-op form (v1 hits it for partially-
	// terminated closure bodies) and lowers the same way as the terminator, just
	// appended rather than set.
	function lowerOp(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'lower'
			call(result, callee, args, argLabels, _, _) then self.lowerCall(result, callee: callee, args: args, argLabels: argLabels, dstBlock: dstBlock)
			literal(result, value, litType) then self.lowerLiteral(result, value: value, litType: litType, dstBlock: dstBlock)
			ret(retVal) then self.emitRetOrErrorReturn(retVal, dstBlock: dstBlock, asTerminator: false)
			retVoid then self.emitRetVoidOrErrorReturn(dstBlock, asTerminator: false)
			binOp(result, lhs, rhs, op) then self.lowerBinOp(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
			unaryOp(result, operand, op) then self.lowerUnaryOp(result, operand: operand, op: op, dstBlock: dstBlock)
			compare(result, lhs, rhs, op) then self.lowerCompare(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
			condBranch then panic("lowerMaxonToStd: a `condBranch` appeared as a body op (parser bug — a branch is always a block terminator)")
			branch then panic("lowerMaxonToStd: a `branch` appeared as a body op (parser bug — a branch is always a block terminator)")
			// The varAccess band lowers 1:1 into the Std memory band — the two are the same three ops
			// at two tiers, and the ONLY thing that happens here is the width collapse the tier
			// boundary exists for (`maxonTypeToStdType`: `boolean` → `i1`, whose `storageBytes` is the
			// 1 the `.data` image lays down). The label and the offset pass through verbatim.
			globalAddr(result, label) then self.stdModule.appendOp(dstBlock, op: StdOp.globalAddr(result, label: label))
			loadIndirect(result, addr, offset, valueType) then self.stdModule.appendOp(dstBlock, op: StdOp.loadIndirect(result, addrId: addr, offset: offset, valueType: maxonTypeToStdType(valueType)))
			storeIndirect(addr, offset, value, valueType) then self.stdModule.appendOp(dstBlock, op: StdOp.storeIndirect(addr, offset: offset, valueId: value, valueType: maxonTypeToStdType(valueType)))
			stringLiteral(result, bytes) then self.lowerStringLiteral(result, bytes: bytes, dstBlock: dstBlock)
			// A throwing call: like `call`, plus the second `errorFlag` result (the Std `tryCall`).
			tryCall(result, errorFlag, callee, args, argLabels, _, _) then self.lowerTryCall(result, errorFlag: errorFlag, callee: callee, args: args, argLabels: argLabels, dstBlock: dstBlock)
			// `panicAbort` expands into `osExit` (the message is validated but not printed — see the helper).
			panicAbort then self.lowerPanicAbort(dstBlock)
			// A function VALUE — a `.text` code address (P1.5-A1). Lowers to the Std `funcAddr`, the
			// `.text` twin of `globalAddr`; a PLAIN function routes through its `__fnref_` env-thunk so the
			// materialized address has the uniform `(userargs, env) -> R` shape (P1.5-A2b-2).
			functionRef(result, funcName) then self.lowerFunctionRef(result, funcName: funcName, dstBlock: dstBlock)
			// A call THROUGH a function value (P1.5-A1) — lowers to the Std `callIndirect`, the callee value
			// passing through as the register the call goes through. Positional args, no labels to slot.
			indirectCall then self.lowerIndirectCall(hlOp, dstBlock: dstBlock)
			// The error terminators are never body ops.
			throwError to propagateError then panic("lowerMaxonToStd: an error terminator appeared as a body op (parser bug — throwError/propagateError are always block terminators)")
			// P1.5-B1a: `async f(…)` spills its scalar args into a slab argument buffer and spawns a green
			// thread; `await p` drives the scheduler until the promise completes. `args` is safe to bind in
			// this big match because a later field (`argLabels`/`argRanges`) follows it — see lowerIndirectCall.
			asyncCall(result, callee, args, argLabels, _, _) then self.lowerAsyncCall(result, callee: callee, args: args, argLabels: argLabels, dstBlock: dstBlock)
			await (result, promise) then self.lowerAwait(result, promise: promise, dstBlock: dstBlock)
			tryAwait(result, errorFlag, promise) then self.lowerTryAwait(result, errorFlag: errorFlag, promise: promise, dstBlock: dstBlock)
			// `sizeof(T)` — a runtime read of the enclosing instance's layout descriptor (P1.6-B1). The
			// parser folds every CONCRETE sizeof to a literal, so this op only ever carries a typeParameter.
			sizeofType(result, targetType) then self.lowerSizeofType(result, targetType: targetType, dstBlock: dstBlock)
			// P1.7 slice 2: a `b"…"` literal — an owned heap `Array with Byte` record over an immortal rdata blob.
			byteStringLiteral(result, bytes) then self.lowerByteStringLiteral(result, bytes: bytes, dstBlock: dstBlock)
			// The dense-match jump table is ALWAYS a block terminator, never a body op — see `lowerTerminator`.
			switch then panic("lowerMaxonToStd: a `switch` op appeared as a body op (parser bug — the jump table is always a block terminator)")
			// A constrained-type-parameter dispatch (P1.7a slice 2a) — materialize/forward the witness address
			// and emit the fused `StdOp.witnessCall`. Routed through a helper that RE-MATCHES the op in a SMALL
			// match rather than binding `args` in this big one — the tail-slot-Array corruption `lowerIndirectCall`
			// documents.
			witnessDispatch then self.lowerWitnessDispatch(hlOp, dstBlock: dstBlock)
		end 'lower'
	end 'lowerOp'

	// Lower a block terminator. A `literal` here is a parser bug (a literal is
	// never a block terminator).
	function lowerTerminator(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'lower'
			ret(retVal) then self.emitRetOrErrorReturn(retVal, dstBlock: dstBlock, asTerminator: true)
			retVoid then self.emitRetVoidOrErrorReturn(dstBlock, asTerminator: true)
			throwError(errValue, errIsBoxed) then self.lowerThrowError(errValue, errIsBoxed: errIsBoxed, dstBlock: dstBlock)
			propagateError(errorFlag) then self.lowerPropagateError(errorFlag, dstBlock: dstBlock)
			condBranch(cond, thenBlockId, elseBlockId) then self.lowerCondBranch(cond, thenBlockId: thenBlockId, elseBlockId: elseBlockId, dstBlock: dstBlock)
			branch(targetBlockId) then self.lowerBranch(targetBlockId, dstBlock: dstBlock)
			// The dense-match jump table lowers 1:1 to the Std twin. Routed through a helper that RE-MATCHES
			// the op in a SMALL match rather than binding `denseTargetBlockIds` in this big one — the tail-slot
			// Array corruption `lowerIndirectCall` documents (the array is the middle slot here, but the helper
			// keeps the discipline uniform and the natural field order).
			switch then self.lowerSwitch(hlOp, dstBlock: dstBlock)
			literal then panic("lowerMaxonToStd: a `literal` op appeared as a block terminator (parser bug — literal is never a terminator)")
			binOp then panic("lowerMaxonToStd: a `binOp` op appeared as a block terminator (parser bug — a binary op is never a terminator)")
			unaryOp then panic("lowerMaxonToStd: a `unaryOp` op appeared as a block terminator (parser bug — a unary op is never a terminator)")
			compare then panic("lowerMaxonToStd: a `compare` op appeared as a block terminator (parser bug — a comparison is never a terminator)")
			call then panic("lowerMaxonToStd: a `call` op appeared as a block terminator (parser bug — a call is a body op, never a terminator)")
			globalAddr to storeIndirect then panic("lowerMaxonToStd: a varAccess op appeared as a block terminator (parser bug — a global's address, load and store are all body ops, never terminators)")
			stringLiteral then panic("lowerMaxonToStd: a `stringLiteral` op appeared as a block terminator (parser bug — a string literal is a value-producing body op, never a terminator)")
			tryCall then panic("lowerMaxonToStd: a `tryCall` op appeared as a block terminator (parser bug — a throwing call is a value-producing body op, never a terminator)")
			panicAbort then panic("lowerMaxonToStd: a `panicAbort` op appeared as a block terminator (parser bug — panicAbort is a body op followed by a dead return terminator)")
			functionRef then panic("lowerMaxonToStd: a `functionRef` op appeared as a block terminator (parser bug — a function reference is a value-producing body op, never a terminator)")
			indirectCall then panic("lowerMaxonToStd: an `indirectCall` op appeared as a block terminator (parser bug — an indirect call is a value-producing body op, never a terminator)")
			asyncCall to tryAwait then panic("lowerMaxonToStd: an async/await op appeared as a block terminator (parser bug — `async`/`await`/`try await` are value-producing body ops, never terminators)")
			sizeofType then panic("lowerMaxonToStd: a `sizeofType` op appeared as a block terminator (parser bug — sizeof is a value-producing body op, never a terminator)")
			byteStringLiteral then panic("lowerMaxonToStd: a `byteStringLiteral` op appeared as a block terminator (parser bug — a byte-string literal is a value-producing body op, never a terminator)")
			witnessDispatch then panic("lowerMaxonToStd: a `witnessDispatch` op appeared as a block terminator (parser bug — a witness dispatch is a value-producing body op, never a terminator)")
		end 'lower'
	end 'lowerTerminator'

	// Lower an integer/float literal to `StdOp.const`. The literal's collapsed
	// StdType rides along on the op: it carries both the width and the float-ness
	// the backend needs to pick a GP mov-immediate vs an XMM load, so no separate
	// opcode (v1's constI64/constF64) is required. `result` is the parser's
	// ValueId — this pass does not renumber.
	function lowerLiteral(result ValueId, value ParsedInt, litType MaxonType, dstBlock IrBlock)
		let stdType = maxonTypeToStdType(litType)
		self.stdModule.appendOp(dstBlock, op: StdOp.const(result, value: value, valueType: stdType))
	end 'lowerLiteral'

	// ⭐ **A STRING LITERAL BECOMES IMMORTAL RDATA + A `lea`** (P1.2 wave A). Two `.rdata` entries are
	// registered — the NUL-terminated byte blob, and the 48-byte record whose `buffer@0` points at it —
	// and the result is the RIP-relative ADDRESS of the record. `registerRdataConstant` DEDUPES both by
	// bytes, so every occurrence of the same literal shares one blob and one record.
	//
	// The record's `buffer@0` cannot be filled here: it is the blob's ABSOLUTE VA, and no VA exists
	// until the PE writer lays out `.rdata`. So the field is a placeholder and a `(record, blob)` fixup
	// is recorded on the data table for the writer to patch (`GlobalDataTable.recordStringBufferFixup`
	// → `PeWriter`). NOTHING is heap-allocated: no `__mm_alloc`, no MM header, no drop.
	//
	// ⚠ It emits `StdOp.rdataAddr`, NOT `StdOp.globalAddr`: `globalAddr` lowers to a `.data`-section
	// relocation (`dataSectionRipRelDisp32`), and the record lives in read-only `.rdata`
	// (`ripRelDisp32`). The two differ only in the section they measure from — which is exactly what
	// the relocation kind discriminates.
	function lowerStringLiteral(result ValueId, bytes ByteArray, dstBlock IrBlock)
		let blobLabel = registerStringBlob(self.globalData, bytes: bytes)
		let recordLabel = registerStringRecord(self.globalData, blobLabel: blobLabel, byteLength: bytes.count(), isAscii: bytesAreAscii(bytes))
		self.globalData.recordStringBufferFixup(recordLabel, blobLabel: blobLabel)
		self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(result, label: recordLabel.toByteArray()))
	end 'lowerStringLiteral'

	// ⭐ **A `b"…"` BYTE-STRING LITERAL (P1.7 slice 2)** — the Array analogue of `lowerStringLiteral`, and it
	// DIVERGES from it in exactly one place: a String literal is a FULLY rdata record (immortal, never
	// dropped), while a byte-string is a first-class OWNED `Array with Byte` — so the RECORD is `__mm_alloc`'d
	// (giving it the MM header + refcount the ownership model drops through `__arr_decref`) while only the
	// element BUFFER stays in immortal `.rdata`. `capacity@16` is the negative rdata sentinel `__arr_decref`
	// reads to skip freeing that buffer; `element_size@24` is 1 so the byte-packed blob strides one byte per
	// element. `bytes` is already Latin-1-decoded (`Parser.decodeByteStringLiteral`), so this is pure emission.
	//
	// Only the FOUR non-zero fields are stamped: `parent@32` and `element_destroy@40` come pre-zeroed from
	// `__mm_alloc`'s zeroing contract (the same one `__arr_create` relies on to leave them unwritten).
	function lowerByteStringLiteral(result ValueId, bytes ByteArray, dstBlock IrBlock)
		let blobLabel = registerByteArrayLiteralBlob(self.globalData, bytes: bytes)

		// result = __mm_alloc(ArrRecordBytes, 0) — the owned heap 48-byte record (MM header + refcount before it).
		let recordSize = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(recordSize, value: ArrRecordBytes as ParsedInt, valueType: StdType.i64))
		let recordDtor = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(recordDtor, value: 0, valueType: StdType.i64))
		var allocArgs = ValueIdArray.create()
		allocArgs.push(recordSize)
		allocArgs.push(recordDtor)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: MmAllocName, args: allocArgs))

		// buffer@0 = &blob (immortal `.rdata`, materialized by a RIP-relative lea — never freed).
		let blobAddr = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(blobAddr, label: blobLabel.toByteArray()))
		self.emitByteStringField(result, offset: ArrBufferOffset, value: blobAddr, dstBlock: dstBlock)

		// length@8 = the byte count.
		let lengthId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(lengthId, value: bytes.count() as ParsedInt, valueType: StdType.i64))
		self.emitByteStringField(result, offset: ArrLengthOffset, value: lengthId, dstBlock: dstBlock)

		// capacity@16 = the rdata sentinel (< 0) — tells `__arr_decref` the buffer is immortal.
		let capacityId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(capacityId, value: RdataBufferCapacity, valueType: StdType.i64))
		self.emitByteStringField(result, offset: ArrCapacityOffset, value: capacityId, dstBlock: dstBlock)

		// element_size@24 = 1 (a byte is one byte, so the blob is byte-packed and `.get(i)` strides by 1).
		let elementSizeId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(elementSizeId, value: ByteStringElementSize, valueType: StdType.i64))
		self.emitByteStringField(result, offset: ArrElementSizeOffset, value: elementSizeId, dstBlock: dstBlock)
	end 'lowerByteStringLiteral'

	// Store `value` into the byte-string record's `offset` field (an 8-byte slot). The one store shape the
	// four field stamps share, so the record layout is written in one place.
	function emitByteStringField(record ValueId, offset ByteOffset, value ValueId, dstBlock IrBlock)
		self.stdModule.appendOp(dstBlock, op: StdOp.storeIndirect(record, offset: offset, valueId: value, valueType: StdType.i64))
	end 'emitByteStringField'

	// Emit one `StdOp.param` per parameter at the function's ENTRY block, before any
	// body op. Parameter `i` is ValueId `i` (the ids the parser reserved), of the
	// function's `i`-th resolved Std param type. The x64 lowering turns each into the
	// `mov virtual(i), physical(argReg[i])` that captures the incoming ABI register. A
	// zero-parameter function emits nothing. The entry block is the first `blockRef`.
	function emitParams(func IrFunction)
		if func.paramCount == 0 'noParams'
			return
		end 'noParams'
		let entryRef = try func.blockRefs.get(0) otherwise panic("emitParams: function '{String.from(func.name)}' has no entry block")
		var entryBlock = try self.stdModule.blocks.get(entryRef) otherwise panic("emitParams: entry blockRef {entryRef} not in stdModule.blocks")
		for i in 0 upto func.paramCount 'eachParam'
			let paramType = try func.paramTypes.get(i) otherwise panic("emitParams: paramTypes.get OOB at {i} (paramCount={func.paramCount})")
			self.stdModule.appendOp(entryBlock, op: StdOp.param(i as ValueId, index: i, paramType: paramType))
		end 'eachParam'
	end 'emitParams'

	// --- Dictionary-passing substrate (P1.6-B1) ---

	// Build `layoutNeedingFuncs`: every function that carries the hidden layout-descriptor parameter (P1.6-B1)
	// — which the PARSER reserved, as the LAST param, for every method whose TRANSITIVE need
	// (`computeTypeDescriptorNeeds`: direct `sizeof(T)` or a self-call to a sibling that needs one) was set. So
	// a method like `indirectSize` that only does `return self.directSize()` carries the param even though it
	// has no `sizeofType` op of its own — which is exactly why detection is by PARAM COUNT here, not an op-scan:
	// the reserved slot is the whole-program fact a caller reads to decide whether to append the descriptor arg.
	function buildLayoutNeedingFuncs()
		for func in self.maxonModule.functions 'eachFunc'
			if self.functionHasDescriptorParam(func) 'needsLayout'
				self.layoutNeedingFuncs.upsert(func.name, value: true)
			end 'needsLayout'
		end 'eachFunc'
	end 'buildLayoutNeedingFuncs'

	// Does `func` carry a layout-descriptor parameter (P1.6-B1)? The parser reserves it after the user + env
	// companions and BEFORE any witness parameters (`[user][env][layout][witness_0..k]`, P1.7a slice 2a), so a
	// `paramCount` above the user + env + WITNESS count means the layout slot is present. The witness count is
	// derived whole-program from the enclosing type's `where` constraints (`witnessParamCountForFunc`), the
	// SAME rule the parser reserved by, so caller and callee agree without a per-function field.
	function functionHasDescriptorParam(func IrFunction) returns bool
		return func.paramCount > func.maxonParamTypes.count() + self.envParamCount(func) + self.witnessParamCountForFunc(func)
	end 'functionHasDescriptorParam'

	// Bind the CURRENT function's hidden implicit parameters (P1.6-B1 layout + P1.7a slice 2a witnesses). The
	// witness parameters occupy the FINAL `currentWitnessCount` ValueIds; the layout descriptor (when present)
	// sits just before them. `hasImplicitLayout` is the authoritative layout-presence bit (a zero-user-param
	// generic method's descriptor slot is legitimately ValueId 0, so the id cannot double as the presence flag);
	// `witnessParamBase` is witness slot 0's ValueId, read by `lowerWitnessDispatch` to forward a witness.
	function bindImplicitParams(func IrFunction)
		self.currentWitnessCount = self.witnessParamCountForFunc(func)
		self.witnessParamBase = func.paramCount - self.currentWitnessCount

		self.hasImplicitLayout = self.functionHasDescriptorParam(func)
		self.implicitLayoutValueId = 0
		if not self.hasImplicitLayout 'noLayout'
			return
		end 'noLayout'

		self.implicitLayoutValueId = (func.paramCount - self.currentWitnessCount - 1) as ValueId
	end 'bindImplicitParams'

	// The number of hidden witness parameters `func` carries (P1.7a slice 2a) — the witness twin of
	// `functionHasDescriptorParam`. Derived from the function's own signature (`takesReceiver`) and its
	// enclosing type's `where`-constraint count, so the count is a pure function of whole-program facts and
	// needs no per-function field. A synthesized function with no signature (a closure/thunk) carries none.
	function witnessParamCountForFunc(func IrFunction) returns ParamCount
		let sig = try self.funcSignatures.get(func.name) otherwise return 0
		return self.witnessParamCountForCallee(func.name, sig: sig)
	end 'witnessParamCountForFunc'

	// The number of witness parameters the CALLEE `callee` carries (P1.7a slice 2a): its enclosing type's
	// `where`-constraint count for an INSTANCE method, zero for a static or a free function. Both the callee
	// side (append witness arguments) and the current-function side (bind witness parameters) read this ONE
	// rule, so they cannot drift on how many witnesses a call passes.
	function witnessParamCountForCallee(callee ByteArray, sig FuncSignature) returns ParamCount
		if not sig.takesReceiver() 'notInstance'
			return 0
		end 'notInstance'
		match splitQualifiedName(callee) 'q'
			notQualified then return 0
			parts(typeName, _) then return self.signatures.structWhereConstraintCount(typeName)
		end 'q'
	end 'witnessParamCountForCallee'

	// The number of companion-environment parameters `func` carries (P1.5-A2b-2) — one per function-typed
	// user parameter — used to locate the layout slot that sits past them.
	function envParamCount(func IrFunction) returns ParamCount
		var n = 0 as ParamCount
		for pt in func.maxonParamTypes 'each'
			if maxonTypeTag(pt) == ValueTypeTag.function 'fnParam'
				n = n + 1
			end 'fnParam'
		end 'each'
		return n
	end 'envParamCount'

	// `finalizeCallArgs` (float widening + companion env args) PLUS the hidden IMPLICIT arguments a
	// dictionary-passing call carries: the layout descriptor (P1.6-B1) THEN one witness pointer per `where`
	// constraint (P1.7a slice 2a), in the `[user][env][layout][witness_0..k]` order the parser reserved them
	// at — so the caller's argument registers and the callee's `param` ops meet.
	function finalizeCallArgsWithLayout(argIds ValueIdArray, sig FuncSignature, callee ByteArray, result ValueId, dstBlock IrBlock) returns ValueIdArray
		let baseArgs = self.finalizeCallArgs(argIds, sig: sig, dstBlock: dstBlock)
		let needsLayout = self.layoutNeedingFuncs.contains(callee)
		let witnessCount = self.witnessParamCountForCallee(callee, sig: sig)
		if not needsLayout and witnessCount == 0 'noImplicits'
			return baseArgs
		end 'noImplicits'

		// A FRESH array — `baseArgs` may BE the slotted `argIds` verbatim (finalizeCallArgs's fast path
		// returns them unchanged), so pushing into it would mutate a possibly-shared array. Only a
		// dictionary-passing call pays this copy; the common path already returned `baseArgs` above.
		var out = ValueIdArray.create()
		out.append(baseArgs)
		if needsLayout 'layout'
			out.push(self.materializeLayoutArgFor(argIds, sig: sig, result: result, callee: callee, dstBlock: dstBlock))
		end 'layout'
		if witnessCount > 0 'witnesses'
			self.appendWitnessArgs(out, argIds: argIds, callee: callee, dstBlock: dstBlock)
		end 'witnesses'
		return out
	end 'finalizeCallArgsWithLayout'

	// Append the hidden WITNESS arguments a dictionary-passing call to `callee` carries (P1.7a slice 2a) — one
	// per `where` constraint of the callee's enclosing type, in constraint (source) order, AFTER any layout
	// descriptor. Only an INSTANCE method carries witnesses (`witnessParamCountForCallee` returns 0 for a
	// static/free callee), so the receiver is always `argIds[0]` — the value whose CONCRETE instance (or
	// enclosing `self`) supplies each witness. `out` is the fresh argument array `finalizeCallArgsWithLayout`
	// built (never `argIds`), so pushing is safe.
	function appendWitnessArgs(out ValueIdArray, argIds ValueIdArray, callee ByteArray, dstBlock IrBlock)
		let receiver = try argIds.get(0) otherwise panic("appendWitnessArgs: witness-carrying instance method '{String.from(callee)}' has no receiver argument — its first parameter is `self`")
		let constraints = self.calleeWhereConstraints(callee)
		for i in 0 upto constraints.count() 'eachConstraint'
			let constraint = try constraints.get(i) otherwise panic("appendWitnessArgs: whereConstraints.get OOB at {i}")
			out.push(self.materializeWitnessArg(receiver, constraint: constraint, constraintIndex: i, callee: callee, dstBlock: dstBlock))
		end 'eachConstraint'
	end 'appendWitnessArgs'

	// The `where` constraints of `callee`'s enclosing type (P1.7a slice 2a). `callee` is a qualified
	// `Type.method`; a non-qualified callee has no enclosing type and so no constraints (its witness count was
	// already 0, so this is unreached for it — the panic guards a caller invariant, not a user error).
	function calleeWhereConstraints(callee ByteArray) returns WhereConstraintArray
		match splitQualifiedName(callee) 'q'
			notQualified then panic("calleeWhereConstraints: witness-carrying callee '{String.from(callee)}' is not a qualified `Type.method` — only an instance method carries witnesses, and its name is always qualified")
			parts(typeName, _) then return self.signatures.structWhereConstraints(typeName)
		end 'q'
	end 'calleeWhereConstraints'

	// The witness-table address to pass for ONE constraint (P1.7a slice 2a). A CONCRETE generic-instance
	// receiver → the RIP-relative address of `__witness_<ConcreteArg>.<Iface>` (`rdataAddr`), emitting the
	// table on first reference; a receiver that is the enclosing generic body's OWN `self` (`structRef`) or a
	// value of its type parameter → FORWARD the caller's own witness slot for the same constraint index (a
	// generic→generic call, both of the same type, so the slots align). Mirrors `materializeLayoutArg`.
	function materializeWitnessArg(receiver ValueId, constraint WhereConstraint, constraintIndex WitnessSlotIndex, callee ByteArray, dstBlock IrBlock) returns ValueId
		let tag = self.valueTagOf(receiver)
		if tag == ValueTypeTag.genericInstance 'concrete'
			let gid = try self.valueNameIds.get(receiver) otherwise panic("materializeWitnessArg: genericInstance receiver v{receiver} has no name-id (its GenericInstanceId)")
			// The CANONICAL conformer name (`Box with Integer` -> `int`, `Box with Point` -> `Point`), so the
			// table label (`__witness_int.Hashable`) and its slot reloc (`int.hash`) name the synthesized primitive
			// impl — the SAME reducer the E3017 check keys its conformance lookup by, never a second spelling.
			let concreteType = self.signatures.conformerTypeArgName(gid, position: constraint.typeParamIndex).toByteArray()
			let label = self.ensureWitnessTable(concreteType, interfaceName: constraint.interfaceName)
			let addrId = self.mintStdValueId()
			self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(addrId, label: label.toByteArray()))
			return addrId
		end 'concrete'
		if tag == ValueTypeTag.structRef or tag == ValueTypeTag.typeParameter 'forward'
			return self.forwardCallerWitness(constraintIndex, callee: callee)
		end 'forward'
		panic("materializeWitnessArg: call to witness-carrying '{String.from(callee)}' has a receiver of tag {tag.name} — an instance method's receiver is a concrete generic instance, the enclosing self (structRef), or a type parameter")
	end 'materializeWitnessArg'

	// Forward the CURRENT (generic) function's own witness slot for `constraintIndex` to a callee (P1.7a slice
	// 2a) — a generic body driving another generic method on `self` (or a value of its type parameter), both of
	// the same type, so the caller's constraint list and the callee's are identical and the slot index aligns.
	// The witness twin of `forwardCallerLayout`: the caller MUST carry witnesses (an instance method of a
	// constrained type always does), so a missing slot is an internal invariant break, not a user error.
	function forwardCallerWitness(constraintIndex WitnessSlotIndex, callee ByteArray) returns ValueId
		if self.currentWitnessCount == 0 'noSlot'
			panic("forwardCallerWitness: caller '{String.from(self.currentFuncName)}' has no witness parameter to forward to '{String.from(callee)}' — a generic→generic dispatch is only reached from an instance method of a constrained type, which always carries witnesses")
		end 'noSlot'
		return (self.witnessParamBase + constraintIndex) as ValueId
	end 'forwardCallerWitness'

	// ⭐ **THE `.rdata` WITNESS-TABLE BLOB for `typeName` conforming to `interfaceName` (P1.7a slice 2a).** The
	// `24 + 8*methodCount`-byte blob (`methodCount@0`, `parentTablePtr@8`=0, `flags@16`=0, `methods[N]@24`) is
	// registered zero-filled under `__witness_<Type>.<Iface>`; each method slot is stamped by a
	// `funcAbs64InRdata` relocation whose target is the conforming type's own `<Type>.<method>` impl (the SAME
	// reloc that bakes a layout descriptor's `destroyFunc@40`, so x64-only — the writers refuse it on
	// arm64/wasm/macOS). Each impl is DCE-ROOTED (`recordCallUsage`) so the reloc never names a `.text` VA that
	// was pruned — the noteDestructorUsage/noteClonerUsage rooting pattern for a slot named nowhere the module
	// call graph can see. Idempotent by label: a table referenced at many sites registers ONE blob, ONE set of
	// relocations, and one root.
	function ensureWitnessTable(typeName ByteArray, interfaceName ByteArray) returns String
		let label = witnessTableLabel(typeName, interfaceName: interfaceName)
		if self.emittedWitnessTables.contains(label) 'cached'
			return label
		end 'cached'
		self.emittedWitnessTables.insert(label)

		let iface = self.resolveWitnessInterface(interfaceName)
		let methodCount = iface.methods.count()

		// `methodCount@0`, then zero-fill through the header (`parentTablePtr@8`, `flags@16`) and every method
		// slot — the writer patches the slots via the relocations below. `scalarImage` is the SAME little-endian
		// serializer the `.data`/`.rdata` images use, so the header word matches every other integer this backend
		// writes.
		var blob = ByteArray.create()
		blob.append(scalarImage(methodCount as ParsedInt, byteCount: WitnessSlotBytes as ByteCount))
		blob.growFilled((WitnessTableHeaderBytes + WitnessSlotBytes * methodCount) as ElementCount, value: 0)
		_ = self.globalData.registerRdataConstantLabeled(label, bytes: blob)

		for i in 0 upto methodCount 'eachMethod'
			let method = try iface.methods.get(i) otherwise panic("ensureWitnessTable: methods.get OOB at {i} below count {methodCount}")
			let impl = qualifiedMethodName(typeName, methodName: method.name)
			self.globalData.recordFuncAbs64InRdata(impl, rdataLabel: label, offsetInLabel: witnessMethodSlotOffset(i))
		end 'eachMethod'

		return label
	end 'ensureWitnessTable'

	// Resolve an interface NAME when building a witness table (P1.7a slice 2a) — a synthesized builtin FIRST
	// (matching `ConformanceCheck.resolveInterface`), then a user interface from the merged `project.interfaces`.
	// A witness table is only built for a constraint whose interface the parser already resolved same-file, so an
	// unresolved name here is an internal invariant break, not a user error.
	function resolveWitnessInterface(interfaceName ByteArray) returns IrInterface
		match builtinInterface(interfaceName) 'builtin'
			found(iface) then return iface
			notFound then break 'builtin'
		end 'builtin'
		return try self.interfaces.get(interfaceName) otherwise panic("resolveWitnessInterface: witness constraint interface '{String.from(interfaceName)}' is neither a builtin nor a declared interface — the parser resolved it at the dispatch site, so it must resolve here")
	end 'resolveWitnessInterface'

	// The layout-descriptor argument a layout-needing call must pass, from the RIGHT source (P1.6-B1 / P1.7
	// slice 3b-i). An INSTANCE method reads it from its RECEIVER (`self` at slotted position 0 — the value of
	// the concrete generic instance). A receiverless STATIC constructor (`IntContainer.create(…)`) has no
	// receiver — its first argument is an ordinary user value — but its RESULT is the concrete instance it
	// builds, and the parser has already retyped that result to `genericInstance(gid)`, so the concrete gid is
	// read off the result. The discriminator is the callee's own parameter list (`__self` at position 0), not
	// the shape of `argIds`, so a static whose first argument happens to be a generic instance is unambiguous.
	function materializeLayoutArgFor(argIds ValueIdArray, sig FuncSignature, result ValueId, callee ByteArray, dstBlock IrBlock) returns ValueId
		if sig.takesReceiver() 'instanceMethod'
			// Read from `argIds` (the ORIGINAL receiver), never from the widened/env-derived `baseArgs`.
			let receiver = try argIds.get(0) otherwise panic("materializeLayoutArgFor: layout-needing instance method '{String.from(callee)}' has no receiver argument — its first parameter is `self`")
			return self.materializeLayoutArg(receiver, callee: callee, dstBlock: dstBlock)
		end 'instanceMethod'
		return self.materializeStaticConstructorLayout(result, callee: callee, dstBlock: dstBlock)
	end 'materializeLayoutArgFor'

	// The descriptor address for a layout-needing STATIC generic constructor (P1.7 slice 3b-i) — the RIP-relative
	// address of its RESULT instance's descriptor blob. The result was retyped to `genericInstance(gid)` by the
	// parser (`retypeGenericAliasConstructorResult`), so the concrete gid — `Container with SmallInt` — is read
	// off the result's name column, exactly as an instance-method receiver's is. A receiverless layout-needing
	// callee is always such a constructor (a static that returns its own instance), so a non-instance result is
	// an internal invariant break.
	function materializeStaticConstructorLayout(result ValueId, callee ByteArray, dstBlock IrBlock) returns ValueId
		if self.valueTagOf(result) != ValueTypeTag.genericInstance 'notInstance'
			panic("materializeStaticConstructorLayout: layout-needing static callee '{String.from(callee)}' returns a {self.valueTagOf(result).name}, not a generic instance — a receiverless layout-needing callee is a generic constructor whose result carries the concrete gid")
		end 'notInstance'
		return self.emitInstanceDescriptorAddr(result, dstBlock: dstBlock)
	end 'materializeStaticConstructorLayout'

	// Emit the RIP-relative address of the descriptor blob for a CONCRETE generic-instance value (`rdataAddr`
	// of `ensureLayoutDescriptor`), the shared core of the two ways a layout-needing call finds its descriptor
	// source — an instance-method RECEIVER and a static-constructor RESULT (P1.6-B1 / P1.7 slice 3b-i). One home
	// so the gid read, the descriptor emission and the address op cannot drift between the two.
	function emitInstanceDescriptorAddr(instanceValue ValueId, dstBlock IrBlock) returns ValueId
		let gid = try self.valueNameIds.get(instanceValue) otherwise panic("emitInstanceDescriptorAddr: genericInstance value v{instanceValue} has no name-id (its GenericInstanceId) — the two type columns are dense and in lockstep")
		let descId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(descId, label: self.ensureLayoutDescriptor(gid).toByteArray()))
		return descId
	end 'emitInstanceDescriptorAddr'

	// The layout-descriptor address to pass for a call whose receiver is `receiver`. A CONCRETE generic
	// instance receiver → the RIP-relative address of its descriptor blob (`rdataAddr`); a receiver that is
	// the caller's OWN type parameter (a generic body calling another generic method on a `T` value) →
	// FORWARD the caller's own layout slot. B1's acceptance calls come from a non-generic `main` on a
	// concrete instance, so the forward arm is reached only by a generic-to-generic call.
	function materializeLayoutArg(receiver ValueId, callee ByteArray, dstBlock IrBlock) returns ValueId
		let tag = self.valueTagOf(receiver)
		if tag == ValueTypeTag.genericInstance 'concrete'
			return self.emitInstanceDescriptorAddr(receiver, dstBlock: dstBlock)
		end 'concrete'
		// ⭐ A `structRef`(base) receiver is the enclosing generic body's OWN instance — `self` — so the
		// descriptor to pass is the caller's own, FORWARDED. A `typeParameter` receiver (a value of the caller's
		// `T`) forwards for the same reason. Both are the generic-to-generic threading that lets a shared body
		// drive another. The parser rejects the residual shape (a descriptor call on a non-`self` same-base
		// value) before lowering, so the caller here always carries a layout param.
		if tag == ValueTypeTag.structRef or tag == ValueTypeTag.typeParameter 'forward'
			return self.forwardCallerLayout(callee)
		end 'forward'
		panic("materializeLayoutArg: call to layout-needing '{String.from(callee)}' has a receiver of tag {tag.name} — an instance method's receiver is a concrete generic instance, the enclosing self (structRef), or a type parameter")
	end 'materializeLayoutArg'

	// Forward the CURRENT (generic) function's own layout slot to a callee — when a generic body calls another
	// layout-needing method on `self` or on a value of its own type parameter. The caller MUST carry a layout
	// param: the parser's TRANSITIVE reservation gives one to every method that reaches such a call, and the
	// parser rejects the residual shape (a descriptor call on a non-`self` same-base value) before lowering, so
	// a missing slot here is a genuine internal invariant break rather than a user error.
	function forwardCallerLayout(callee ByteArray) returns ValueId
		if not self.hasImplicitLayout 'noSlot'
			panic("forwardCallerLayout: caller '{String.from(self.currentFuncName)}' has no layout descriptor to forward to '{String.from(callee)}' — the parser's transitive reservation and residual-rejection should make this unreachable")
		end 'noSlot'
		return self.implicitLayoutValueId
	end 'forwardCallerLayout'

	// The `.rdata` label of `gid`'s descriptor blob, emitting it on first reference. The blob is PURE DATA —
	// box size, alignment, the T-slot storage width, and the source-level `elementLogicalSize` that
	// `sizeof(T)` reads. `destroyFunc@40` is 0 on disk; when `gid` holds a MANAGED opaque-`T` `Array` field
	// (`Container with String`, P1.7 slice 3b-ii), a `funcAbs64InRdata` relocation is recorded so the x64
	// writer patches that slot with the element destructor's `.text` VA — the value the shared opaque
	// `__arr_create` reads back into its record's `element_destroy@40`. A TRIVIAL argument records nothing and
	// the slot stays 0 (no element walk). Idempotent: a gid referenced at several call sites registers one blob
	// and one reloc and shares the label.
	function ensureLayoutDescriptor(gid GenericInstanceId) returns String
		if self.layoutDescriptors.contains(gid) 'cached'
			return self.layoutDescriptors.labelFor(gid)
		end 'cached'

		let descriptor = LayoutDescriptor.create(self.signatures.genericInstanceBoxSize(gid), alignment: LAYOUT_MIN_ALIGNMENT, elementSize: LAYOUT_TYPE_PARAM_SLOT_BYTES, elementLogicalSize: self.signatures.genericInstanceSoleArgLogicalSize(gid))
		let label = self.globalData.registerRdataConstantLabeled("__layout_{String.from(self.signatures.mangleGenericInstance(gid))}", bytes: encodeLayoutDescriptor(descriptor))
		self.layoutDescriptors.record(gid, label: label)

		// A MANAGED opaque-`T` `Array` field's `destroyFunc@40` is the ONLY compile-time reference to the
		// element destructor — the shared body's `loadIndirect(descriptor, +40)` is a runtime read the usage
		// scan cannot see — so the relocation both fills the slot AND is what the writer resolves the
		// destructor's `.text` VA against. The destructor is DCE-rooted where the enclosing instance's own
		// `__destruct_<mangled>` is noted (`noteDestructorUsage`), so it is installed for the writer to resolve.
		if self.signatures.genericInstanceHasManagedOpaqueArrayField(gid) 'managedOpaqueElement'
			self.globalData.recordFuncAbs64InRdata(self.signatures.managedOpaqueArrayElementDropCallee(gid), rdataLabel: label, offsetInLabel: LAYOUT_OFFSET_DESTROY_FUNC)
		end 'managedOpaqueElement'

		// ⭐ **THE `copyFunc@32` STAMP — the exact CLONE dual of the `destroyFunc@40` stamp above (P1.7 slice
		// 3b-vi-b-β).** When the instance's managed opaque-`T` `Array` element is DIRECT-clonable (a String /
		// struct / boxed-union / trivial-element-array element — the only shape a single `(box) -> newBox` cloner
		// can hold), a second `funcAbs64InRdata` relocation fills `copyFunc@32` with the element CLONER's `.text`
		// VA, the value the shared opaque-copy wrappers read back and `callIndirect` per element. A TRIVIAL element
		// records nothing (its wrapper takes the byte-blit/COW path), and a MANAGED but non-direct element
		// (`Array with (Array with String)`) records nothing either — it is never copied (the front end rejects a
		// base that copies with such an instantiation), so its 0 slot is never read. The cloner is DCE-rooted on
		// the SAME `genericInstanceOpaqueArrayElementIsCopyable` predicate (`rootManagedOpaqueArrayElementClones`),
		// so the reloc never names a `.text` VA that was not installed.
		if self.signatures.genericInstanceOpaqueArrayElementIsCopyable(gid) 'copyableOpaqueElement'
			self.globalData.recordFuncAbs64InRdata(self.signatures.managedOpaqueArrayElementCloneCallee(gid), rdataLabel: label, offsetInLabel: LAYOUT_OFFSET_COPY_FUNC)
		end 'copyableOpaqueElement'

		return label
	end 'ensureLayoutDescriptor'

	// Lower `sizeof(T)` (P1.6-B1) to a runtime read of `elementLogicalSize@56` from the CURRENT function's
	// layout descriptor. The parser folds every CONCRETE sizeof to a literal, so this op only ever carries
	// a typeParameter; and it reserved the descriptor parameter whenever a body reads sizeof(T), so reaching
	// here without one is a pre-scan/op-scan divergence — a loud bug, not a silent wrong load.
	function lowerSizeofType(result ValueId, targetType MaxonType, dstBlock IrBlock)
		if maxonTypeTag(targetType) != ValueTypeTag.typeParameter 'notTypeParam'
			panic("lowerSizeofType: sizeofType carries a {maxonTypeTag(targetType).name} operand — the parser folds every concrete sizeof to a literal, so only the type-parameter case reaches this op")
		end 'notTypeParam'
		if not self.hasImplicitLayout 'noLayout'
			panic("lowerSizeofType: sizeof(T) in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's slot reservation and this lowering's op-scan disagree")
		end 'noLayout'
		self.stdModule.appendOp(dstBlock, op: StdOp.loadIndirect(result, addrId: self.implicitLayoutValueId, offset: LAYOUT_OFFSET_ELEMENT_LOGICAL_SIZE, valueType: StdType.i64))
	end 'lowerSizeofType'

	// Lower a Maxon `call` to `StdOp.call`. The parser recorded the argument SSA values
	// in SOURCE order with their labels; here they are reordered to the callee's
	// declaration order via `slotCallArgs` against the `funcSignatures` registry. Every
	// slotting error (unknown callee, arity, unknown/duplicate label) was already
	// reported by SemanticCheck, which gates the pipeline before lowering — so a miss
	// here is a compiler-invariant violation and panics rather than emitting wrong code.
	// The `argRanges` on the Maxon op are diagnostics-only (consumed by SemanticCheck),
	// so lowering ignores them.
	function lowerCall(result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, dstBlock IrBlock)
		// ⭐ A COMPILER-INTERNAL CALL HAS NO SIGNATURE TO SLOT AGAINST, and needs none:
		// `Parser.emitRuntimeCall` wrote its arguments itself, positionally, in declaration order — so
		// the reordering below would be the identity, and the registry lookup it needs first would panic
		// on a callee no file declares. `SemanticCheck.validateCall` skips it for the same reason, keyed
		// on the same predicate (`__print_string`/`__str_eq` are compiler-internal too, not just `__mm_`).
		if isCompilerInternalCallee(callee) 'compilerOwnCall'
			self.lowerRuntimeCall(result, callee: callee, args: args, argLabels: argLabels, dstBlock: dstBlock)
			return
		end 'compilerOwnCall'

		let sig = try self.funcSignatures.get(callee) otherwise panic("lowerCall: callee '{String.from(callee)}' has no signature — SemanticCheck must reject an unknown callee before lowering")
		match slotCallArgs(sig, args: args, argLabels: argLabels) 'slot'
			ordered(argIds) then self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: self.finalizeCallArgsWithLayout(argIds, sig: sig, callee: callee, result: result, dstBlock: dstBlock)))
			arityMismatch then panic("lowerCall: arity mismatch for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			unknownLabel then panic("lowerCall: unknown argument label for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			duplicateArg then panic("lowerCall: duplicate argument for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
		end 'slot'
	end 'lowerCall'

	// Lower a call to an emitted runtime entry point: the arguments pass through VERBATIM.
	//
	// ⚠ The label guard is what stops "positional by construction" from quietly becoming "positional
	// by habit". `Parser.emitRuntimeCall` builds an all-empty label column (`emptyArgLabels`), so a
	// label here means someone taught the parser to write one — and since there is no signature to
	// match it against, the argument would be dropped into the position it happened to occupy rather
	// than the one it named. That is a wrong answer with no diagnostic anywhere, so it panics at the
	// one place that could still see it.
	function lowerRuntimeCall(result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, dstBlock IrBlock)
		requireRuntimeCallPositional(callee, argLabels: argLabels)
		// An OPAQUE-`T` `__arr_create` (P1.7 slice 3b-i) arrives with ONE argument (element_size); its
		// `element_destroy@40` is not known statically, so it is READ from the enclosing instance's threaded
		// layout descriptor (`destroyFunc@40`) HERE — the tier that owns the descriptor's ValueId — and appended
		// as the second argument, mirroring how `sizeof(T)` reads `elementLogicalSize@56`.
		if self.isOpaqueArrayCreateCall(callee, result: result) 'opaqueArrayCreate'
			self.appendOpaqueArrayCreate(result, callee: callee, args: args, dstBlock: dstBlock)
			return
		end 'opaqueArrayCreate'
		// A `__drop_type_param` (P1.7 slice 3b-v) arrives with ONE argument (the opaque owned value); its
		// element destructor is not known statically, so the enclosing instance's layout descriptor is
		// PREPENDED as the first argument (`__drop_type_param(descriptor, value)`) — the drop twin of
		// `appendOpaqueArrayCreate`'s destructor read, off the SAME `implicitLayoutValueId`.
		if callee.equals(DropTypeParamName) 'dropTypeParam'
			self.appendDropTypeParamDescriptor(result, callee: callee, args: args, dstBlock: dstBlock)
			return
		end 'dropTypeParam'
		// A set runtime call that hashes/compares its key (`__set_insert`/`__set_contains`/`__set_remove`,
		// P1.7b slice A) gets the key's `Hashable`/`Equatable` witness-table addresses appended as its two
		// hidden trailing arguments — the receiver's concrete key type is known here, so `ensureWitnessTable`
		// materializes them, the dictionary-passing twin of `appendWitnessArgs` for a generic instance method.
		if isSetWitnessCallee(callee) 'setWitness'
			self.appendSetWitnessArgs(result, callee: callee, args: args, dstBlock: dstBlock)
			return
		end 'setWitness'
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: self.opaqueCopyArgsWithDescriptor(callee, args: args)))
	end 'lowerRuntimeCall'

	// ⭐ **APPEND THE KEY-WITNESS ARGUMENTS to a set runtime call (P1.7b slice A).** `insert`/`contains`/
	// `remove` on a `Set with T` dispatch the key's `hash`/`equals` through witnesses, so the concrete key
	// type's `Hashable`/`Equatable` tables ride as the trailing two arguments (`[set, elem, hashWitness,
	// eqWitness]`). The receiver `args[0]` is a concrete `Set` instance, so its key type is read off the gid
	// through `conformerTypeArgName` — the SAME canonical-conformer reducer `materializeWitnessArg` uses, so a
	// `Set with Integer` and a `Box with Integer` name their `int` witness table identically — and
	// `materializeKeyWitness` takes each table's `rdataAddr`.
	function appendSetWitnessArgs(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		let gid = self.setWitnessKeyGid(result, callee: callee, args: args)
		let keyType = self.signatures.conformerTypeArgName(gid, position: 0 as TypeParamId).toByteArray()
		var fullArgs = ValueIdArray.create()
		fullArgs.append(args)
		fullArgs.push(self.materializeKeyWitness(keyType, interfaceName: HashableInterfaceName, dstBlock: dstBlock))
		fullArgs.push(self.materializeKeyWitness(keyType, interfaceName: EquatableInterfaceName, dstBlock: dstBlock))
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: fullArgs))
	end 'appendSetWitnessArgs'

	// The `Set` instance whose key type names the witness tables threaded into a set runtime call. For
	// `insert`/`contains`/`remove` it is the SET RECEIVER (`args[0]`). For `__set_from` — which builds a set FROM
	// an array — `args[0]` is the SOURCE ARRAY, so the set is the RESULT instead (its element type is the same,
	// but the array is not the set; reading the gid off the result keeps the witness bound to what is being
	// built, not to the thing being consumed). One door, so "whose key type?" has one answer.
	function setWitnessKeyGid(result ValueId, callee ByteArray, args ValueIdArray) returns GenericInstanceId
		if callee.equals(SetFromName) 'fromConstruction'
			return try self.valueNameIds.get(result) otherwise panic("setWitnessKeyGid: `__set_from` result v{result} has no name-id (its GenericInstanceId) — a `Set from […]` value is always a concrete generic instance")
		end 'fromConstruction'
		let setReceiver = try args.get(0) otherwise panic("setWitnessKeyGid: set runtime call '{String.from(callee)}' has no receiver argument — its first parameter is the set record")
		return try self.valueNameIds.get(setReceiver) otherwise panic("setWitnessKeyGid: set receiver v{setReceiver} has no name-id (its GenericInstanceId) — a `Set` value is always a concrete generic instance")
	end 'setWitnessKeyGid'

	// The `rdataAddr` of the `__witness_<keyType>.<interface>` table (P1.7b slice A) — the address a set runtime
	// call passes for the key's `Hashable` or `Equatable` witness. `ensureWitnessTable` registers the blob and
	// its `funcAbs64` slot reloc (to the synthesized `int.hash`/`int.equals`) on first reference, idempotent by
	// label, so many set operations on one key type build ONE table per interface.
	function materializeKeyWitness(keyType ByteArray, interfaceName ByteArray, dstBlock IrBlock) returns ValueId
		let label = self.ensureWitnessTable(keyType, interfaceName: interfaceName)
		let addrId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.rdataAddr(addrId, label: label.toByteArray()))
		return addrId
	end 'materializeKeyWitness'

	// Append the enclosing instance's layout DESCRIPTOR to an OPAQUE-`T` array-copy call's arguments (P1.7 slice
	// 3b-vi-b-β) — the LAST argument the `__arr_{slice,clone,append}_opaque` wrappers read `copyFunc@32` from,
	// exactly as `appendOpaqueArrayCreate` appends the `destroyFunc@40` read for an opaque `__arr_create`. A
	// non-opaque-copy callee passes through UNCHANGED, so this is a safe wrapper over every runtime call's args.
	// Shared by the non-throwing (`lowerRuntimeCall`) and throwing (`lowerTryCall`, the throwing `slice`) paths so
	// they cannot drift on whether — or where — the descriptor is appended. The descriptor is guaranteed by the
	// parser's copy-descriptor-need seed (a method that copies an opaque array reserves it, exactly as an opaque
	// `X.create()` or a `sizeof(T)` method does), so its absence here is a parser/lowering divergence — a loud
	// bug, not a silent wrong load, matching `appendOpaqueArrayCreate`.
	function opaqueCopyArgsWithDescriptor(callee ByteArray, args ValueIdArray) returns ValueIdArray
		if not isOpaqueArrayCopyCallee(callee) 'notOpaqueCopy'
			return args
		end 'notOpaqueCopy'
		if not self.hasImplicitLayout 'noLayout'
			panic("opaqueCopyArgsWithDescriptor: opaque array copy '{String.from(callee)}' in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's copy-descriptor-need seed and this lowering disagree")
		end 'noLayout'
		var fullArgs = ValueIdArray.create()
		fullArgs.append(args)
		fullArgs.push(self.implicitLayoutValueId)
		return fullArgs
	end 'opaqueCopyArgsWithDescriptor'

	// Emit `__drop_type_param(descriptor, value)` (P1.7 slice 3b-v): prepend the CURRENT function's layout
	// descriptor to the single `value` argument the parser emitted. The descriptor parameter is guaranteed by
	// the parser's descriptor-need seed (a method that drops an opaque feed binding needs it, exactly as a
	// `sizeof(T)` / opaque `X.create()` method does), so its absence here is a parser/lowering divergence — a
	// loud bug, not a silent wrong load, matching `appendOpaqueArrayCreate`. `result` is the parser's VOID
	// result value (a drop returns nothing), passed through so the Std op's result column stays dense.
	function appendDropTypeParamDescriptor(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		if not self.hasImplicitLayout 'noLayout'
			panic("appendDropTypeParamDescriptor: `__drop_type_param` in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's descriptor-need seed (a method that drops an opaque feed binding) and this lowering disagree")
		end 'noLayout'
		var fullArgs = ValueIdArray.create()
		fullArgs.push(self.implicitLayoutValueId)
		fullArgs.append(args)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: fullArgs))
	end 'appendDropTypeParamDescriptor'

	// Is this runtime call an OPAQUE-`T` `Array.create()` — an `__arr_create` whose result instance's element
	// is a type parameter (P1.7 slice 3b-i)? The parser emits such a create with only `element_size`; the
	// `element_destroy@40` argument is supplied by `appendOpaqueArrayCreate`. A concrete `__arr_create` (its
	// element known) already carries both arguments and takes the plain path.
	function isOpaqueArrayCreateCall(callee ByteArray, result ValueId) returns bool
		if not callee.equals(ArrCreateName) 'notCreate'
			return false
		end 'notCreate'
		if self.valueTagOf(result) != ValueTypeTag.genericInstance 'notInstance'
			return false
		end 'notInstance'
		return self.signatures.arrayElementIsOpaque(try self.valueNameIds.get(result) otherwise panic("isOpaqueArrayCreateCall: genericInstance __arr_create result v{result} has no name-id (its GenericInstanceId)"))
	end 'isOpaqueArrayCreateCall'

	// Emit an opaque-`T` `__arr_create` (P1.7 slice 3b-i): load the element destructor from the enclosing
	// instance's layout descriptor `destroyFunc@40` slot, then call `__arr_create(element_size, element_destroy)`.
	// The reserved descriptor param is guaranteed by the parser's descriptor-need seed (an opaque `X.create()`
	// seeds it exactly as `sizeof(T)` does), so its absence here is a parser/lowering divergence — a loud bug,
	// not a silent wrong load, matching `lowerSizeofType`.
	function appendOpaqueArrayCreate(result ValueId, callee ByteArray, args ValueIdArray, dstBlock IrBlock)
		if not self.hasImplicitLayout 'noLayout'
			panic("appendOpaqueArrayCreate: opaque `Array.create()` in '{String.from(self.currentFuncName)}' but the function carries no layout descriptor parameter — the parser's descriptor-need seed and this lowering disagree")
		end 'noLayout'
		let destroyId = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.loadIndirect(destroyId, addrId: self.implicitLayoutValueId, offset: LAYOUT_OFFSET_DESTROY_FUNC, valueType: StdType.i64))
		var fullArgs = ValueIdArray.create()
		fullArgs.append(args)
		fullArgs.push(destroyId)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: callee, args: fullArgs))
	end 'appendOpaqueArrayCreate'

	// Lower a Maxon `indirectCall` to `StdOp.callIndirect` (P1.5-A1). There is NO signature to SLOT
	// against — a function TYPE has no parameter names, so the arguments are already in call order (the
	// parser parsed them positionally, and the op carries no labels). But the Std op DOES carry the
	// function value's register-file signature (`resultType`/`argFloatMask`, P1.5 #78) so a float result is
	// captured from the float return register and a float arg travels in a float argument register: both
	// are read straight off the already-typed result and arg VALUES (`stdTypeOf`, via `appendCallIndirect`),
	// with no callee name to look them up under. The callee value passes through as
	// the register the call goes through. Routed through this helper, not constructed inline in `lowerOp`'s
	// `match` arm, for the same shape `lowerCall` uses: the C# reference miscompiles the SCRUTINEE's decref
	// when the arm binds a managed array (`args`) and consumes it inline (measured: a `mm_decref` on a
	// sentinel pointer crashing every `try`/`throw` program's lowering); handing `args` to a function first
	// is exactly what `call`/`tryCall` do, and it compiles cleanly.
	// ⚠ It takes the WHOLE `MaxonOp` and RE-MATCHES it here rather than receiving `(result, callee, args)`
	// destructured by `lowerOp`'s big `match`, and that indirection is NOT gratuitous. The C# reference
	// (which compiles shv2) MISCOMPILES a `match` arm that BINDS an `Array with …` payload sitting in the
	// TAIL field slot of its variant, when the arm lives in a large match: it corrupts the SCRUTINEE's
	// decref and crashes every `try`/`throw` program's lowering with a `mm_decref` on a sentinel pointer.
	// (`call`/`tryCall` bind `args` safely only because a later `argRanges` field follows it; `indirectCall`
	// has no trailing field.) Binding `args` in a SMALL dedicated match here sidesteps the reference's bug,
	// keeps the natural field order, and is a Std→Maxon lowering with no other cost. The self-hosted
	// compiler will not need it, but the bootstrap does today.
	function lowerIndirectCall(op MaxonOp, dstBlock IrBlock)
		match op 'ic'
			// ⚠ The arm HANDS `args` straight to a helper and does nothing else with it — the bootstrap
			// miscompile the file header warns of (a tail-slot `Array` bound in this arm) is sidestepped only
			// while the arm's body is a single function call, so the `stdTypeOf`/`indirectCallParamTypes` work
			// (which also reads `args`) MUST live in the helper, not inline here. Inlining it re-triggered the
			// scrutinee-decref corruption (a `mm_decref` underflow tearing the module down).
			indirectCall(result, callee, args) then self.appendCallIndirect(dstBlock, result: result, callee: callee, args: args)
			default panic("lowerIndirectCall: expected an `indirectCall` op, got a different MaxonOp variant — `lowerOp` routes only `indirectCall` here")
		end 'ic'
	end 'lowerIndirectCall'

	// Build the Std `callIndirect`, recovering the function value's register-file signature from the
	// already-typed result and arg VALUES (P1.5 #78): `resultType` is the result value's Std type (a float
	// result is captured from the float return register), and `argFloatMask` has bit k set iff argument k is
	// a float — a float argument travels in a float argument register, everything else (incl. the trailing
	// uniform-ABI companion env pointer, `Parser.emitClosureEnvArg`, an i64) in a GPR. Both come from
	// `stdTypeOf`, the per-value type the parser recorded, so the indirect call's placement matches the
	// callee thunk's / lifted closure's declared parameter types by construction (a well-typed argument
	// shares its callee parameter's type). A helper because `lowerIndirectCall`'s arm must hand `args` to a
	// function and touch it no other way (see there).
	function appendCallIndirect(dstBlock IrBlock, result ValueId, callee ValueId, args ValueIdArray)
		self.stdModule.appendOp(dstBlock, op: StdOp.callIndirect(result, calleeReg: callee, resultType: StdReturnType.value(self.indirectResultType(result)), argFloatMask: self.argFloatMaskOf(args), args: args))
	end 'appendCallIndirect'

	// Bit k set iff argument k is a float (an f64, routed to a float argument register) — the per-argument
	// register-file mask a `callIndirect`/`witnessCall` carries, computed from the already-typed arg VALUES
	// (`stdTypeOf`). ONE home, shared by the indirect-call and witness-call lowerings so the two cannot drift
	// on how an argument's file is decided.
	function argFloatMaskOf(args ValueIdArray) returns ArgFloatMask
		var mask = 0 as ArgFloatMask
		for k in 0 upto args.count() 'eachArg'
			let arg = try args.get(k) otherwise panic("argFloatMaskOf: args.get OOB at {k}")
			if stdTypeIsFloat(self.stdTypeOf(arg)) 'floatArg'
				mask = mask or (1 shl k)
			end 'floatArg'
		end 'eachArg'
		return mask
	end 'argFloatMaskOf'

	// ⭐ **LOWER A CONSTRAINED-TYPE-PARAMETER DISPATCH TO THE FUSED `StdOp.witnessCall` (P1.7a slice 2a).** The
	// witness ADDRESS is the enclosing (generic) function's own threaded witness parameter for this constraint
	// — FORWARDED, exactly as `forwardCallerLayout` forwards the layout descriptor: a `witnessDispatch` is only
	// ever emitted inside a generic body, whose `T` witness arrived as a hidden parameter (the concrete
	// `__witness_<Type>.<Iface>` was materialized at the CALL SITE and passed in). Re-matched in a SMALL match
	// so `args` is bound in a single-call arm, never in `lowerOp`'s big one (the tail-slot-Array decref
	// corruption `lowerIndirectCall` documents).
	function lowerWitnessDispatch(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'w'
			witnessDispatch(result, args, constraintIndex, methodIndex, isVoid) then self.appendWitnessCall(dstBlock, result: result, args: args, constraintIndex: constraintIndex, methodIndex: methodIndex, isVoid: isVoid)
			default panic("lowerWitnessDispatch: expected a `witnessDispatch` op, got a different MaxonOp variant — `lowerOp` routes only `witnessDispatch` here")
		end 'w'
	end 'lowerWitnessDispatch'

	// Build the Std `witnessCall`: forward the current function's witness parameter for `constraintIndex` as the
	// table address, then capture the result exactly as `appendCallIndirect` does (an `isVoid` method leaves no
	// result register to capture, so its `resultType` is `void`). A helper because `lowerWitnessDispatch`'s arm
	// must hand `args` to a function and touch it no other way (see there and `lowerIndirectCall`).
	function appendWitnessCall(dstBlock IrBlock, result ValueId, args ValueIdArray, constraintIndex WitnessSlotIndex, methodIndex WitnessMethodIndex, isVoid bool)
		if self.currentWitnessCount == 0 'noWitnessParam'
			panic("appendWitnessCall: a witness dispatch in '{String.from(self.currentFuncName)}' but the function carries no witness parameters — the parser's reservation (an instance method of a constrained generic type) and this lowering's whole-program split disagree")
		end 'noWitnessParam'
		let witnessAddr = (self.witnessParamBase + constraintIndex) as ValueId

		let resultType = StdReturnType.void if isVoid else StdReturnType.value(self.stdTypeOf(result))
		self.stdModule.appendOp(dstBlock, op: StdOp.witnessCall(result, witnessAddr: witnessAddr, methodIndex: methodIndex, resultType: resultType, argFloatMask: self.argFloatMaskOf(args), args: args))
	end 'appendWitnessCall'

	// The Std type an indirect call CAPTURES its result in — normally the result value's own type. But a
	// VOID function value (`let cb = doIt; cb()` at statement position, P1.5 #68) has NO result to capture:
	// like a void DIRECT call, whose return register holds a garbage integer nobody reads
	// (StdLoweringShared.calleeResultClass), its result is captured as a garbage i64. `stdTypeOf`/
	// `valueTagToStdType` deliberately PANIC on a void tag — a void value can never be an OPERAND — but a
	// call RESULT is a def, not an operand, so the void case is handled here rather than by widening that
	// guard. The `__fnref_` thunk of a void target returns exactly this dummy i64 (Runtime/FnRefThunk), so
	// the capture register (native) and the `call_indirect` result functype (wasm) agree with it.
	function indirectResultType(result ValueId) returns StdType
		let tag = self.valueTagOf(result)
		return StdType.i64 if tag == ValueTypeTag.void else valueTagToStdType(tag)
	end 'indirectResultType'

	// ⭐ **`async f(args…)` → SPAWN A GREEN THREAD** (P1.5-B1a). The arguments are slotted to parameter order
	// (`slotCallArgs`, exactly as `lowerCall`), then spilled into the GT struct's INLINE arg region — one
	// `storeIndirect` per argument, the trampoline reading them back into the ABI argument registers. The
	// callee's DIRECT `.text` address (`funcAddr`, NOT a `__fnref_` thunk: the trampoline calls it with user
	// arguments only, its own `(userargs) -> R` shape) becomes `__gt_spawn(funcPtr)`, whose result is the Promise
	// handle (the GT struct pointer). No float widening is possible — SemanticCheck refused a non-scalar
	// parameter — so the slotted args pass through as i64 without `finalizeCallArgs`.
	function lowerAsyncCall(result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, dstBlock IrBlock)
		let sig = try self.funcSignatures.get(callee) otherwise panic("lowerAsyncCall: async callee '{String.from(callee)}' has no signature — SemanticCheck must reject an unknown callee before lowering")
		match slotCallArgs(sig, args: args, argLabels: argLabels) 'slot'
			ordered(argIds) then self.emitAsyncSpawn(result, callee: callee, argIds: argIds, dstBlock: dstBlock)
			arityMismatch then panic("lowerAsyncCall: arity mismatch for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			unknownLabel then panic("lowerAsyncCall: unknown argument label for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			duplicateArg then panic("lowerAsyncCall: duplicate argument for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
		end 'slot'
	end 'lowerAsyncCall'

	// Emit the direct function address, the `__gt_spawn(funcPtr)` call, and the argument spills into the GT
	// struct's INLINE arg region, given the arguments already slotted to parameter order. Split out of
	// `lowerAsyncCall` so the slotting `match` uses statement arms (a panic on a mis-slotting SemanticCheck
	// should have gated), the same shape `lowerCall` uses.
	function emitAsyncSpawn(result ValueId, callee ByteArray, argIds ValueIdArray, dstBlock IrBlock)
		// The inline region is a FIXED MaxAsyncArgs slots; one store per argument at `GtOffArgInline + k *
		// GtArgSlotBytes`. A callee with more arguments than that would store PAST the region — a silent struct
		// overrun the trampoline then mis-loads — so this stays as the STRUCTURAL BACKSTOP.
		//
		// ⚠ It is a backstop and no longer the only guard: `Parser.emitAsyncCall` refuses the same program with
		// a positioned diagnostic naming `MaxAsyncArgs`. It used to be the only one, under a comment claiming it
		// "cannot fire today" because MaxAsyncArgs equalled the parser's six-register parameter cap — which
		// stopped being true the moment ordinary calls gained stack arguments and the cap went. Reaching here
		// now means the parser's gate was bypassed (a synthesized spawn, a new async lowering path), which is a
		// compiler bug and belongs in a panic.
		if argIds.count() > MaxAsyncArgs 'overflow'
			panic("emitAsyncSpawn: async callee '{String.from(callee)}' has {argIds.count()} arguments but the inline arg region holds only MaxAsyncArgs ({MaxAsyncArgs}) slots — `Parser.emitAsyncCall` refuses a source-level spawn past that, so this spawn reached lowering without passing it")
		end 'overflow'

		// funcPtr = &callee ; result = __gt_spawn(funcPtr) — the Promise handle (the GT struct pointer). The arg
		// region is now INLINE in the struct (P1.5-B1c #87), so there is no separate slab buffer to allocate.
		let funcPtr = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.funcAddr(funcPtr, funcName: callee))
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: GtSpawnName, args: argsOf(funcPtr)))

		// Fill the struct's inline arg region: one store per argument at `result + GtOffArgInline + k * GtArgSlotBytes`.
		// SAFE to fill AFTER the spawn: a spawned GT is only ENQUEUED, not run, until awaited (single-M), so the
		// slots are written before the trampoline ever loads them. `__gt_spawn` set `gt.argBuf` to a self-pointer
		// at `GtOffArgInline`, and the slab/memzero left the unfilled slots zero (harmlessly loaded into unread
		// argument registers).
		for k in 0 upto argIds.count() 'eachArg'
			let argId = try argIds.get(k) otherwise panic("emitAsyncSpawn: argIds.get OOB at {k}")
			self.stdModule.appendOp(dstBlock, op: StdOp.storeIndirect(result, offset: (GtOffArgInline + k * GtArgSlotBytes) as ByteOffset, valueId: argId, valueType: StdType.i64))
		end 'eachArg'
	end 'emitAsyncSpawn'

	// `await p` → `__gt_await(p)`. The scheduler drive is entirely in the runtime; here it is a plain call
	// yielding the awaited scalar in R8.
	function lowerAwait(result ValueId, promise ValueId, dstBlock IrBlock)
		self.stdModule.appendOp(dstBlock, op: StdOp.call(result, callee: GtAwaitName, args: argsOf(promise)))
	end 'lowerAwait'

	// `try await p` → `__gt_try_await(p)`, a THROWING call: the awaited scalar in R8 (`result`), the error
	// flag in R10 (`errorFlag`). The runtime driver returns both through `errorReturn`; this `tryCall`
	// captures both, exactly as `lowerTryCall` does for a throwing free call. The parser's `try … otherwise …`
	// desugar (already emitted around this op) reads the flag.
	function lowerTryAwait(result ValueId, errorFlag ValueId, promise ValueId, dstBlock IrBlock)
		self.stdModule.appendOp(dstBlock, op: StdOp.tryCall(result, errorFlagId: errorFlag, callee: GtTryAwaitName, args: argsOf(promise)))
	end 'lowerTryAwait'

	// Materialize a function value's `.text` address (P1.5-A2b-2). Under the uniform `(userargs, env) -> R`
	// ABI every USER function value is called through the SAME indirect signature, so the address must name a
	// function of that shape. A LIFTED CLOSURE already is one (its trailing `__env` parameter). A PLAIN named
	// function is not, and its direct calls must stay unchurned — so its value use materializes the address of
	// its `__fnref_` thunk instead, which `installFnRefThunks` synthesizes with the env-carrying signature.
	// The thunk names cannot drift: `fnRefThunkName` is the ONE builder both this site and the synthesis read.
	//
	// A COMPILER-INTERNAL callee (`__`-prefixed — an array element destructor stamped into `element_destroy@40`,
	// P1.7 slice 3) takes the BARE address: it is invoked through a plain `callIndirect(ptr)` in the drop walk,
	// NOT the uniform closure ABI, so it needs no env thunk (and none is synthesized for it — `collectFnRefThunkTargets`
	// skips `__`-prefixed names). The `__` prefix is the discriminator both this site and the thunk collector read.
	function lowerFunctionRef(result ValueId, funcName ByteArray, dstBlock IrBlock)
		let target = funcName if (isLiftedClosureName(funcName) or isCompilerInternalCallee(funcName)) else fnRefThunkName(funcName)
		self.stdModule.appendOp(dstBlock, op: StdOp.funcAddr(result, funcName: target))
	end 'lowerFunctionRef'

	// ⭐ **int→float ARGUMENT WIDENING (F3a)** — the CALL-SITE dual of the `return`/assignment float
	// coercions the parser already owns, and it lives HERE because this is the first tier that holds a
	// callee's ALIAS-RESOLVED parameter types (`funcSignatures`, re-synced by TypeResolution) beside
	// the one `slotCallArgs` the check and the lowering share. An integer argument at a `float`
	// parameter is a LOSSLESS widening the language performs implicitly — `SemanticCheck.checkArgTypes`
	// accepts it as `ok` (the lossy `float`→`int` is E3009, and is NOT this) — but the int value is
	// born in a GPR while a float parameter is passed in an XMM register, so with no conversion the
	// backend meets a GPR→XMM move that `crosses register files` and panics. Each integral ordered
	// argument at a float parameter is converted with `siToFp` (`cvtsi2sd`), the SAME op
	// `Parser.promoteToFloat` inserts for `x + 2.0`; the result is XMM-classed (`unaryResultClass`), so
	// the value-class column and the backend's XMM arg routing (`argFpRegisterAt`) then agree the
	// argument belongs in an XMM slot — this pass inserts the conversion and the backend needs no change.
	//
	// ⚠ THE PARSER CANNOT DO THIS. A callee's parameter types are a WHOLE-PROGRAM fact — the callee may
	// be declared in another file — and shv2 has them only after the per-file parses merge (the
	// SignatureIndex carries return types, not parameter types). This tier is the first place they
	// exist, resolved.
	//
	// It EMITS each conversion into `dstBlock` before returning, so the `call`/`tryCall` the caller
	// appends NEXT sees the converted value already defined (the emit happens while this call's result
	// is evaluated as the `args:` argument, ahead of the enclosing `appendOp`).
	function widenIntArgsToFloatParams(argIds ValueIdArray, sig FuncSignature, dstBlock IrBlock) returns ValueIdArray
		// FAST PATH, and it is what keeps this allocation-neutral on the hot call-lowering path: only a
		// float PARAMETER can force a widening, and almost no callee has one, so a signature with none
		// returns its arguments verbatim — no `ValueIdArray` built, no op emitted. Without it every
		// lowered call allocates a fresh array it never changes (measured: a linear per-call allocation
		// delta across the scale ladder).
		if not signatureHasFloatParam(sig) 'noFloatParam'
			return argIds
		end 'noFloatParam'

		var widened = ValueIdArray.create()
		for i in 0 upto argIds.count() 'eachArg'
			let argId = try argIds.get(i) otherwise panic("widenIntArgsToFloatParams: argIds.get OOB at {i}")
			let paramType = try sig.paramTypes.get(i) otherwise panic("widenIntArgsToFloatParams: sig.paramTypes.get OOB at {i} — slotCallArgs returned {argIds.count()} ordered args against a {sig.paramCount()}-parameter signature")
			widened.push(self.floatWidenedArg(argId, paramType: paramType, dstBlock: dstBlock))
		end 'eachArg'
		return widened
	end 'widenIntArgsToFloatParams'

	// One argument: widened to `float` when its parameter is `float` and the argument is integral,
	// else the argument verbatim. A non-float argument bound for a float parameter is ALWAYS an
	// integer — SemanticCheck has already rejected every other type (`bool`/`String`/struct disagree
	// with `float`, E3005) — so `not stdTypeIsFloat` on the argument is exactly "the integer that
	// widens", and it is also what keeps `assertConversionCrossesDomain` satisfied (`siToFp`'s operand
	// is never a float). The conversion REUSES `lowerUnaryOp` through the `promoteToFloat` unary op
	// (which maps to `siToFp`), so the op construction and its guard stay in the one place that owns them.
	function floatWidenedArg(argId ValueId, paramType MaxonType, dstBlock IrBlock) returns ValueId
		if not stdTypeIsFloat(maxonTypeToStdType(paramType)) or stdTypeIsFloat(self.stdTypeOf(argId)) 'noWiden'
			return argId
		end 'noWiden'

		let widened = self.mintStdValueId()
		self.lowerUnaryOp(widened, operand: argId, op: MaxonUnaryOp.promoteToFloat, dstBlock: dstBlock)
		return widened
	end 'floatWidenedArg'

	// ⭐ **APPEND THE COMPANION ENVIRONMENT ARGUMENT FOR EACH FUNCTION-TYPED PARAMETER (P1.5-A2b-2).** The
	// uniform ABI splits a function value into (fn ptr, env): the slotted `argIds` carry the fn-ptr half at
	// each function-typed parameter's position, and this appends the env half — the argument value's OWN
	// environment (a capturing closure's block, else a null for a plain function reference or a non-capturing
	// closure). The environments append in PARAMETER order, exactly the order the callee's
	// `Parser.bindClosureEnvParams` assigned its companion parameters, so fn-ptr and env meet at the callee.
	// This is the DIRECT-call dual of `Parser.emitClosureEnvArg` (the indirect-call threading); it lives at
	// this tier because it needs the callee's ALIAS-RESOLVED parameter types (a `function` parameter may be
	// declared in another file), which the parser does not have.
	// The two call-argument transforms a slotted call needs, composed in one place so `lowerCall` and
	// `lowerTryCall` cannot apply them in different orders: an int→float widening at a float parameter (F3a),
	// then a companion environment appended per function parameter (P1.5-A2b-2). They are independent (a
	// parameter is float, function, or neither), and widening preserves the arg count, so the env append's
	// per-position scan stays aligned with the signature.
	function finalizeCallArgs(argIds ValueIdArray, sig FuncSignature, dstBlock IrBlock) returns ValueIdArray
		return self.appendCalleeEnvArgs(self.widenIntArgsToFloatParams(argIds, sig: sig, dstBlock: dstBlock), sig: sig, dstBlock: dstBlock)
	end 'finalizeCallArgs'

	function appendCalleeEnvArgs(argIds ValueIdArray, sig FuncSignature, dstBlock IrBlock) returns ValueIdArray
		// FAST PATH: almost no callee takes a function parameter, so a signature with none returns its
		// arguments verbatim — no array built, no op emitted (the shape `widenIntArgsToFloatParams` uses).
		if not signatureHasFunctionParam(sig) 'noFunctionParam'
			return argIds
		end 'noFunctionParam'

		var withEnvs = ValueIdArray.create()
		for argId in argIds 'copyUser'
			withEnvs.push(argId)
		end 'copyUser'
		for i in 0 upto argIds.count() 'eachParam'
			let paramType = try sig.paramTypes.get(i) otherwise panic("appendCalleeEnvArgs: sig.paramTypes.get OOB at {i} — slotCallArgs returned {argIds.count()} ordered args against a {sig.paramCount()}-parameter signature")
			if maxonTypeTag(paramType) != ValueTypeTag.function 'notFunction'
				continue
			end 'notFunction'
			let argId = try argIds.get(i) otherwise panic("appendCalleeEnvArgs: argIds.get OOB at {i}")
			withEnvs.push(self.calleeEnvArg(argId, dstBlock: dstBlock))
		end 'eachParam'
		return withEnvs
	end 'appendCalleeEnvArgs'

	// The environment a function-value ARGUMENT carries: its own env when it has one (`valueClosureEnv != 0` —
	// a capturing closure's block, published by the parser), else a freshly materialized null. A stored 0
	// unambiguously means "no environment" (a real env id is always `>= 1`), so a null is minted for a plain
	// function reference / non-capturing closure argument.
	function calleeEnvArg(argId ValueId, dstBlock IrBlock) returns ValueId
		let env = try self.valueClosureEnv.get(argId) otherwise panic("calleeEnvArg: v{argId} has no closure-env slot — the column is dense over every ValueId the parser minted")
		if env != 0 'carriesEnv'
			return env
		end 'carriesEnv'
		let nullEnv = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(nullEnv, value: 0, valueType: StdType.i64))
		return nullEnv
	end 'calleeEnvArg'

	// Lower a Maxon binary op to its Std counterpart. The operand and result
	// ValueIds pass through verbatim (this pass never renumbers — see the header);
	// only the source-level operator maps to a width/ABI-resolved Std op. Every
	// NON-TRAPPING operator becomes a `StdOp.binOp` carrying the mapped opcode; the
	// TRAPPING division family (`div`/`mod`) becomes its OWN Std variant (`StdOp.div`/
	// `mod`) — a dedicated arm, NOT routed through the binOp-opcode helper — because idiv
	// can fault and so needs `isPure: false` metadata a shared opcode field cannot carry
	// (mirrors why `compare` split into `StdOp.cmp`).
	//
	// TWO range arms reach `appendStdBinOp`, not one, because `div`/`mod` sit BETWEEN the
	// arithmetic band and the bit band in `MaxonBinOp` (they were there first, and the
	// band-append invariant forbids re-ordering an enum to make a range contiguous — a
	// silently-swallowed variant costs far more than one extra arm).
	function lowerBinOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, dstBlock IrBlock)
		match op 'op'
			add to mul then self.appendStdBinOp(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
			div then self.lowerDivision(result, lhs: lhs, rhs: rhs, dstBlock: dstBlock)
			mod then self.stdModule.appendOp(dstBlock, op: StdOp.mod(result, lhs: lhs, rhs: rhs))
			bitAnd to shrLogical then self.appendStdBinOp(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
		end 'op'
	end 'lowerBinOp'

	// ⭐ **THE TWO DIVISIONS ARE DIFFERENT OPS**, and the operand type alone decides which one a
	// source `/` becomes. They differ in the single property the arith band's membership rule is
	// defined by — PURITY — so they land on opposite sides of it, which is the rule WORKING
	// rather than an exception to it (see StdDialect's StdBinOpcode header):
	//
	//   • INTEGER `/` traps. `idiv` faults on a zero divisor and on `i64.min / -1`, so it must
	//     never be reordered or dropped, and it needs `StdOp.div`'s own `isPure: false` to say
	//     so — metadata a shared opcode field cannot carry.
	//   • FLOAT `/` cannot trap. `divsd` answers `inf`/`nan` per IEEE-754, so it is pure, it
	//     shares `binOp`'s exact operand shape, and it rides `StdBinOpcode.div`.
	function lowerDivision(result ValueId, lhs ValueId, rhs ValueId, dstBlock IrBlock)
		if stdTypeIsFloat(self.stdTypeOf(lhs)) 'float'
			self.appendStdBinOp(result, lhs: lhs, rhs: rhs, op: MaxonBinOp.div, dstBlock: dstBlock)
			return
		end 'float'

		self.stdModule.appendOp(dstBlock, op: StdOp.div(result, lhs: lhs, rhs: rhs))
	end 'lowerDivision'

	// Append the `StdOp.binOp` a non-trapping Maxon binary operator lowers to. The one
	// emit site shared by the arithmetic and bit bands, so the two range arms above
	// dispatch rather than duplicate.
	//
	// ⭐ `operandType` IS THE OPERAND'S REAL TYPE, read from the parser's oracle — the backend
	// selects `addsd` over `add` from this field and nothing else, so a placeholder here is a
	// silent wrong answer rather than a missing feature.
	//
	// It is the LEFT operand's type, which is exact for every operator that reaches here and not
	// merely a convention: the arithmetic and word operators have already been checked to agree
	// (`checkBinOpOperands`), and a SHIFT deliberately does not — its right operand is a
	// DISTANCE, whose type says nothing about anything, and the value being shifted is the only
	// one that decides (TypeRules' ⭐ THE SHIFT RULE).
	function appendStdBinOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, dstBlock IrBlock)
		let opcode = maxonBinOpToStdOpcode(op)
		let operandType = self.stdTypeOf(lhs)

		// `binOp(div)` is FLOAT-ONLY, and an integer one here would declare `idiv` PURE — a
		// trapping instruction the scheduler is then free to reorder or delete. `lowerDivision`
		// is the gate that makes this unreachable; the guard is what stops it being merely
		// unwritten. Not representable beats not written down.
		if opcode == StdBinOpcode.div and not stdTypeIsFloat(operandType) 'trappingDivAsBinOp'
			panic("appendStdBinOp: `binOp(div)` over an INTEGER operand type would declare the trapping `idiv` pure — integer division lowers to `StdOp.div`, and `lowerDivision` is the one place that decides")
		end 'trappingDivAsBinOp'

		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(result, lhs: lhs, rhs: rhs, opcode: opcode, operandType: operandType))
	end 'appendStdBinOp'

	// Lower a Maxon unary op to its Std counterpart. Like lowerBinOp, the operand
	// and result ValueIds pass through verbatim; only the source-level operator maps
	// to a width/ABI-resolved Std opcode.
	// ⭐ `operandType` IS THE OPERAND'S TYPE — the SOURCE the instruction reads — and on the two
	// CONVERSION opcodes that is emphatically not the result's: `trunc` reads an f64 and produces
	// an i64, `promoteToFloat` the reverse. Taking it from `operand` rather than from `result` is
	// therefore correct for every opcode at once, and is the only spelling that is.
	function lowerUnaryOp(result ValueId, operand ValueId, op MaxonUnaryOp, dstBlock IrBlock)
		let opcode = maxonUnaryOpToStdOpcode(op)
		let operandType = self.stdTypeOf(operand)
		assertUnaryOperandDomain(opcode, operandType: operandType)
		self.stdModule.appendOp(dstBlock, op: StdOp.unaryOp(result, operand: operand, opcode: opcode, operandType: operandType))
	end 'lowerUnaryOp'

	// Lower a Maxon comparison to `StdOp.cmp`. Operand/result ValueIds pass through
	// verbatim; only the source-level comparison operator maps to a Std predicate.
	//
	// ⭐ `operandType` DECIDES THE CONDITION-CODE FAMILY, so on a compare it is not merely
	// descriptive: `cmp` answers in OF/SF (which the signed `jl`/`jg` family reads) and `ucomisd`
	// leaves OF=SF=0 and answers in ZF/PF/CF (which the UNSIGNED `jb`/`ja` family reads). The
	// same `StdCmpPred.less` therefore lowers to `jl` for an i64 and `jb` for an f64, and a float
	// compare lowered to `jl` would read flags that were never written. The result is a bool, so
	// the type must come from an OPERAND — `lhs`, which `emitCompare` has already required to
	// agree with `rhs`. See specs-shv2/float-compare-branch.md.
	function lowerCompare(result ValueId, lhs ValueId, rhs ValueId, op MaxonCmpOp, dstBlock IrBlock)
		let pred = maxonCmpOpToStdPred(op)
		self.stdModule.appendOp(dstBlock, op: StdOp.cmp(result, lhs: lhs, rhs: rhs, pred: pred, operandType: self.stdTypeOf(lhs)))
	end 'lowerCompare'

	// Lower a Maxon conditional branch to its Std counterpart, as the block's
	// terminator. The condition value and both target BlockIds pass through verbatim.
	function lowerCondBranch(cond ValueId, thenBlockId BlockId, elseBlockId BlockId, dstBlock IrBlock)
		self.stdModule.setTerminator(dstBlock, op: StdOp.condBranch(cond, thenBlockId: thenBlockId, elseBlockId: elseBlockId))
	end 'lowerCondBranch'

	// Lower a Maxon unconditional branch to its Std counterpart, as the block's
	// terminator.
	function lowerBranch(targetBlockId BlockId, dstBlock IrBlock)
		self.stdModule.setTerminator(dstBlock, op: StdOp.branch(targetBlockId))
	end 'lowerBranch'

	// Lower the dense-match jump table 1:1 to its Std twin, as the block's terminator. Everything passes
	// through verbatim (the parser already emitted the bias `subtract` and biased the table): the biased
	// index value id, the dense block-id table, and the default. RE-MATCHES `hlOp` in a SMALL match so the
	// `denseTargetBlockIds` Array is not bound in `lowerOp`'s big one — the `lowerIndirectCall` discipline.
	function lowerSwitch(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'sw'
			switch(subject, denseTargetBlockIds, defaultBlockId) then self.stdModule.setTerminator(dstBlock, op: StdOp.switch(subject, denseTargetBlockIds: denseTargetBlockIds, defaultBlockId: defaultBlockId))
			default panic("lowerSwitch: expected a `switch` op, got a different MaxonOp variant — `lowerTerminator` routes only `switch` here")
		end 'sw'
	end 'lowerSwitch'

	// Copy a source block's op-LESS terminator marker (`dead`/`fallthrough`) onto its
	// freshly-cloned Std block. `unset` needs no action (the clone already starts
	// there); an `opIndex` terminator never reaches here (the caller guards with
	// hasTerminatorOp). This keeps `assertAllBlocksTerminated` satisfied for the
	// unreachable continuation block the `if`/`else` parser marks `dead`.
	function carryOplessTerminator(srcBlock IrBlock, dstBlock IrBlock)
		match srcBlock.terminator 'carry'
			unset then break 'carry'
			dead then dstBlock.terminator = Terminator.dead
			fallthrough then dstBlock.terminator = Terminator.fallthrough
			opIndex then panic("carryOplessTerminator: block '{String.from(srcBlock.label)}' has an op terminator but hasTerminatorOp() was false")
		end 'carry'
	end 'carryOplessTerminator'

	// Emit the function-return terminator (or, for a mid-block ret, a body op) for a VALUE return. In a
	// NON-throwing function it is a plain `StdOp.ret`. In a THROWING one it is the dual-register
	// `errorReturn(retVal, 0)` — the primary value AND a ZERO error flag (no error in flight), so the ABI
	// is honored on every exit of a throwing function, not just the throw. `asTerminator` toggles
	// setTerminator (block-final) vs appendOp (the rare mid-block ret).
	//
	// ⭐ **THIS IS THE ONE PLACE THE ABI DECIDES ret-vs-errorReturn** — from the function's `throws` clause,
	// not from the token — so the parser's ordinary `ret` needs no knowledge of the error channel.
	function emitRetOrErrorReturn(retVal ValueId, dstBlock IrBlock, asTerminator bool)
		if throwsClauseIsThrowing(self.currentThrows) 'throwing'
			let zeroFlag = self.emitZeroConst(dstBlock)
			self.emitTerminatorOrBody(dstBlock, op: StdOp.errorReturn(retVal, errorFlagId: zeroFlag), asTerminator: asTerminator)
			return
		end 'throwing'
		self.emitTerminatorOrBody(dstBlock, op: StdOp.ret(retVal), asTerminator: asTerminator)
	end 'emitRetOrErrorReturn'

	// The VOID-return counterpart. A non-throwing function returns nothing (`StdOp.retVoid`); a THROWING
	// one still writes BOTH registers — a family-default `0` primary and a `0` error flag — through
	// `errorReturn`, because even a void throwing function's caller reads the flag register.
	function emitRetVoidOrErrorReturn(dstBlock IrBlock, asTerminator bool)
		if throwsClauseIsThrowing(self.currentThrows) 'throwing'
			let defaultVal = self.emitZeroConst(dstBlock)
			let zeroFlag = self.emitZeroConst(dstBlock)
			self.emitTerminatorOrBody(dstBlock, op: StdOp.errorReturn(defaultVal, errorFlagId: zeroFlag), asTerminator: asTerminator)
			return
		end 'throwing'
		self.emitTerminatorOrBody(dstBlock, op: StdOp.retVoid, asTerminator: asTerminator)
	end 'emitRetVoidOrErrorReturn'

	// `throw E.case` / `throw U.case(x)` / `throw e` — the error-flag ENCODE lives HERE (the ABI in one
	// place, per PLAN.md), not in the parser. `errIsBoxed` (set by the parser, which alone holds the enum
	// registry that classifies the thrown type) picks the encoding:
	//   • a BOXED union — `errValue` is the heap-box POINTER, written to the flag VERBATIM. It is non-zero
	//     (`__mm_alloc` never returns 0), so `flag != 0` still reads "error in flight", and there is NO
	//     `+ bias` add: the pointer must survive round-trip to the caller's `(e)` binding intact.
	//   • a SCALAR enum — `errValue` is the ORDINAL, and the flag is `errValue + ErrorFlagOrdinalBias` (the
	//     runtime add covering both the compile-time-constant `throw E.case` and the caught-runtime-value
	//     `throw e` uniformly), reserving 0 for "no error".
	// The primary register carries a family-default `0` the caller ignores when the flag is non-zero — but
	// it is CLASSED for the return type's register file (`emitZeroConstOfReturnType`: an XMM zero for a
	// float return), or the backend's `errorReturn` move would cross register files. The parser's
	// `(e)`-binding DECODE reads the SAME `errIsBoxed` fact (via `throwsTypeIsBoxedUnion`) and the SAME
	// `ErrorFlagOrdinalBias`, so encode and decode cannot drift on either.
	function lowerThrowError(errValue ValueId, errIsBoxed bool, dstBlock IrBlock)
		// A BOXED error's `errValue` is already the flag (the box pointer) — no `const`/`add`, so the primary
		// default is the only op. A SCALAR error emits `bias`, `flag = errValue + bias`, then the primary
		// default, in that order so its ValueId numbering and op sequence stay what they were before boxed
		// errors existed: `emitZeroConstOfReturnType` mints exactly one id like the plain zero it replaced,
		// so the scalar goldens do not move — only a FLOAT return (which previously PANICKED the backend, so
		// has no prior golden) now emits an XMM zero here instead of a GPR one.
		if errIsBoxed 'boxed'
			let boxedDefault = self.emitZeroConstOfReturnType(dstBlock)
			self.stdModule.setTerminator(dstBlock, op: StdOp.errorReturn(boxedDefault, errorFlagId: errValue))
			return
		end 'boxed'
		let bias = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(bias, value: ErrorFlagOrdinalBias, valueType: StdType.i64))
		let flag = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(flag, lhs: errValue, rhs: bias, opcode: StdBinOpcode.add, operandType: StdType.i64))
		let defaultVal = self.emitZeroConstOfReturnType(dstBlock)
		self.stdModule.setTerminator(dstBlock, op: StdOp.errorReturn(defaultVal, errorFlagId: flag))
	end 'lowerThrowError'

	// An uncaught `try f()` — re-publish the caught flag VERBATIM. `errorFlag` is ALREADY the `ordinal + 1`
	// encoding (it came straight out of a `tryCall`), so there is NO re-encoding — the whole reason
	// `propagateError` is distinct from `throwError`.
	function lowerPropagateError(errorFlag ValueId, dstBlock IrBlock)
		let defaultVal = self.emitZeroConstOfReturnType(dstBlock)
		self.stdModule.setTerminator(dstBlock, op: StdOp.errorReturn(defaultVal, errorFlagId: errorFlag))
	end 'lowerPropagateError'

	// A throwing free call `try callee(args…)` — the arg slotting is `lowerCall`'s exactly (it IS a call),
	// plus the `errorFlag` second result. The parser has already rejected a non-throwing USER callee (E3055).
	//
	// ⭐ **A COMPILER-INTERNAL THROWING CALLEE (`__arr_get`/`__arr_set`/`__arr_first`/…) HAS NO SIGNATURE TO
	// SLOT AGAINST** — the parser wrote its arguments positionally (`emitRuntimeCall`), so they pass verbatim,
	// exactly as `lowerCall` routes a non-throwing runtime call through `lowerRuntimeCall`. The array
	// accessors are the first throwing builtins (P1.7 slice 1); before them no builtin threw, which is why
	// this path is new. The label guard is `lowerRuntimeCall`'s: a runtime call is positional by
	// construction, so a label would silently mis-slot.
	function lowerTryCall(result ValueId, errorFlag ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, dstBlock IrBlock)
		if isCompilerInternalCallee(callee) 'compilerOwnTryCall'
			requireRuntimeCallPositional(callee, argLabels: argLabels)
			// The throwing OPAQUE-`T` `slice` (`__arr_slice_opaque`) takes the enclosing instance's descriptor as
			// its last argument, appended here exactly as the non-throwing clone/append do in `lowerRuntimeCall`.
			self.stdModule.appendOp(dstBlock, op: StdOp.tryCall(result, errorFlagId: errorFlag, callee: callee, args: self.opaqueCopyArgsWithDescriptor(callee, args: args)))
			return
		end 'compilerOwnTryCall'

		let sig = try self.funcSignatures.get(callee) otherwise panic("lowerTryCall: throwing callee '{String.from(callee)}' has no signature — SemanticCheck must reject an unknown callee before lowering")
		match slotCallArgs(sig, args: args, argLabels: argLabels) 'slot'
			ordered(argIds) then self.stdModule.appendOp(dstBlock, op: StdOp.tryCall(result, errorFlagId: errorFlag, callee: callee, args: self.finalizeCallArgsWithLayout(argIds, sig: sig, callee: callee, result: result, dstBlock: dstBlock)))
			arityMismatch then panic("lowerTryCall: arity mismatch for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			unknownLabel then panic("lowerTryCall: unknown argument label for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
			duplicateArg then panic("lowerTryCall: duplicate argument for '{String.from(callee)}' reached lowering — SemanticCheck must gate it")
		end 'slot'
	end 'lowerTryCall'

	// `panic("message")` — exit the process with a non-zero code. The parser emitted a dead return
	// terminator after this op, so the block stays well-formed though control never reaches it.
	//
	// ⚠ **THE MESSAGE IS NOT PRINTED at this rung.** It is parsed and type-checked (it must be a `String`),
	// but printing it would need `osWriteStdout` — and hence the Win64 `WriteFile` import wired even for a
	// panic-only program that never uses `print`, plus a stderr write path. No Wave-1 case ever REACHES a
	// panic (every one is a `default panic(…)` on a matched value or an `otherwise panic(…)` on a
	// succeeding call), so the message text is untested; printing it is a follow-up. The exit — via
	// `ExitProcess`, always imported by the entry stub — is what makes a reached panic observably a
	// failure, and that IS emitted.
	//
	// ⚠ **THE NUMBER IS `RuntimeAbort`'s, NOT THIS FILE'S.** It used to be a local `UserPanicExitCode =
	// 134` beside a comment calling it "a conventional abort code", which is precisely how
	// `ArrayRuntime` and `GtRuntime` came to spend 70 twice: a number picked against whatever list the
	// picker could see from where they stood. A user panic and a runtime abort end the same process the
	// same way, so they share one space, and that space now has one declaration site whose duplicate
	// check is the language's (E3031). Bound to a local first for the same E9001 reason
	// `emitRuntimeAbort` documents.
	function lowerPanicAbort(dstBlock IrBlock)
		let panicCode = RuntimeAbort.userPanic.rawValue as ParsedInt
		let code = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(code, value: panicCode, valueType: StdType.i64))
		self.stdModule.appendOp(dstBlock, op: StdOp.osExit(code))
	end 'lowerPanicAbort'

	// A fresh `const 0` (i64) — the ZERO ERROR FLAG (always a GPR value) needs one, at several sites, so
	// the mint-and-append lives in one place. The family-default PRIMARY value is a different call
	// (`emitZeroConstOfReturnType`): a flag is always integral, but a primary value must be born in the
	// return type's register file.
	function emitZeroConst(dstBlock IrBlock) returns ValueId
		let zero = self.mintStdValueId()
		self.stdModule.appendOp(dstBlock, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
		return zero
	end 'emitZeroConst'

	// The THROW-edge PRIMARY value — a family-default the caller reads ONLY for its register file, never
	// its bits (once the error flag is set the value is dead). It must be born in the file the return type
	// occupies, or the backend's `errorReturn` move crosses register files and the x64 emitter panics
	// (`move from rax to xmm0 crosses register files`). A FLOAT return needs an XMM-classed zero — an f64
	// `const 0`, which `buildValueClassColumns` classes XMM from its Std type (the f64 bits of 0.0 are 0);
	// every other return type, and a void one, keeps the i64 GPR zero. Both branches mint EXACTLY ONE
	// ValueId, so the id numbering — and hence every non-float golden — is byte-for-byte unchanged.
	function emitZeroConstOfReturnType(dstBlock IrBlock) returns ValueId
		if stdReturnTypeIsFloat(self.currentReturnType) 'float'
			let zero = self.mintStdValueId()
			self.stdModule.appendOp(dstBlock, op: StdOp.const(zero, value: 0, valueType: StdType.f64))
			return zero
		end 'float'

		return self.emitZeroConst(dstBlock)
	end 'emitZeroConstOfReturnType'

	// A fresh ValueId for the current function, past the parser's dense id space — a plain counter bump,
	// no per-function object. The Std passes downstream grow their dense columns to fit the highest id, so
	// a monotonically increasing id is all that is required.
	function mintStdValueId() returns ValueId
		let id = self.nextValueId
		self.nextValueId = self.nextValueId + 1
		return id
	end 'mintStdValueId'

	// set-as-terminator vs append-as-body, shared by the return/error-return emitters.
	function emitTerminatorOrBody(dstBlock IrBlock, op StdOp, asTerminator bool)
		if asTerminator 'asTerm'
			self.stdModule.setTerminator(dstBlock, op: op)
		end 'asTerm' else 'asBody'
			self.stdModule.appendOp(dstBlock, op: op)
		end 'asBody'
	end 'emitTerminatorOrBody'
end 'MaxonToStdLowering'
