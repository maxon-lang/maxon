// LowerMaxonToStd — Maxon → Std lowering. Takes a MaxonModule and produces a
// fresh StdModule.
//
// **What this pass is FOR: the width/ABI collapse and the 1:N desugaring.**
// `MaxonType` is width-free and source-level; `StdType` is width/ABI-resolved.
// That translation (`maxonTypeToStdType`) is this boundary's real content, along
// with the 1:N expansions that GROW here — a `for-in` into an iterator protocol, a
// labelled method call into a dispatch, a string interpolation into a buffer
// build, an `own.drop` into a `__destruct_T` call.
//
// **What this pass is NOT for: value numbering.** ValueIds pass through VERBATIM —
// the parser mints them (see MaxonDialect's MaxonOp header). v1 did the opposite:
// it named Maxon values `$tN` and re-derived ids here through a per-function
// `nameToId` map, which cost a heap String + ByteArray per value and a
// byte-sequence-keyed hash map (O(len) compares, one insert + one lookup per
// value) to convert one dense counter into another. It constructed no SSA — user
// variables are `VarSlot`s, and `mem2reg` does the real SSA work at the Std tier.
// The map, `defineName`, and `resolveName` are all deleted.
//
// Ops that SYNTHESIZE new values (the 1:N desugarings, from M3 on) must not
// collide with the parser's ids: they allocate from a `ValueIdRef` seeded at
// `scanMaxValueId(func) + 1`. M1's two lowerings synthesize nothing, so no such
// ref exists yet.
//
// THIN for maxon-shv2 M1: lowers exactly the `return 42` slice —
//   maxon.literal -> StdOp.const
//   maxon.ret     -> StdOp.ret
// Later milestones GROW `lowerOp`/`lowerTerminator` with the var / arith / call
// / control-flow arms (and the throwing / fat-interface return arms of
// `emitRetOrErrorReturn`) as the Maxon and Std dialects grow.

// Collapse a source-level MaxonType to its width/ABI-resolved StdType. M1
// handles only the primitive arms. `named` and `unresolved` are a
// TypeResolution (Chunk C) responsibility: that pass replaces every
// `named(alias)` with the primitive it resolves to (consulting the typealias
// registry for its width) and eliminates every `unresolved` BEFORE lowering
// runs. Seeing either arm here is a pipeline-ordering bug (TypeResolution did
// not run, or left a residue) — not a user error — so it panics loudly rather
// than silently guessing a width. GROWS at Chunk C to resolve `named` widths
// through the registry once that registry exists.
export function maxonTypeToStdType(ref MaxonType) returns StdType
	match ref 'collapse'
		boolean then return StdType.i1
		integer then return StdType.i64
		float then return StdType.f64
		// `exitCode` is the resolved `ExitCode` builtin alias. Its width is
		// assigned HERE (unsigned 32-bit) — this is the sole place ExitCode's
		// width lives, keeping MaxonType itself width-free (see MaxonDialect).
		exitCode then return StdType.u32
		named then panic("maxonTypeToStdType: a `named` type must be resolved to a primitive before lowering (TypeResolution did not run)")
		unresolved then panic("maxonTypeToStdType: an `unresolved` type reached lowering (TypeResolution did not run)")
	end 'collapse'
end 'maxonTypeToStdType'

// Collapse a function's MaxonReturnType to its StdReturnType. `void` maps
// straight across; a value return collapses its inner type via maxonTypeToStdType.
export function maxonReturnTypeToStdReturnType(ref MaxonReturnType) returns StdReturnType
	match ref 'collapse'
		void then return StdReturnType.void
		value(inner) then return StdReturnType.value(maxonTypeToStdType(inner))
	end 'collapse'
end 'maxonReturnTypeToStdReturnType'

// Map a source-level binary operator to its width/ABI-resolved Std opcode. M3
// carries the 1:1 integer arithmetic set (`add`/`sub`/`mul`); the mapping GROWS in
// lockstep as MaxonBinOp/StdBinOpcode gain arms (comparison at M4, `/`/`mod` at
// M5). Exhaustive by construction (every MaxonBinOp arm is named).
export function maxonBinOpToStdOpcode(op MaxonBinOp) returns StdBinOpcode
	return match op 'map'
		add gives StdBinOpcode.add
		sub gives StdBinOpcode.sub
		mul gives StdBinOpcode.mul
	end 'map'
end 'maxonBinOpToStdOpcode'

// Map a source-level unary operator to its Std opcode. M3 is a 1:1 `neg` → `neg`;
// GROWS as MaxonUnaryOp/StdUnaryOpcode gain arms. Exhaustive by construction.
export function maxonUnaryOpToStdOpcode(op MaxonUnaryOp) returns StdUnaryOpcode
	return match op 'map'
		neg gives StdUnaryOpcode.neg
	end 'map'
end 'maxonUnaryOpToStdOpcode'

// Public entry: lower a whole MaxonModule to a fresh StdModule. Instantiates the
// per-run lowering worker (which owns the name→id state) and runs it.
export function lowerMaxonToStd(maxonModule MaxonModule) returns StdModule
	return MaxonToStdLowering.create(maxonModule).lower()
end 'lowerMaxonToStd'

type MaxonToStdLowering
	var maxonModule as MaxonModule
	var stdModule as StdModule
	// Qualified name of the function currently lowering — for diagnostics only.
	var currentFuncName as String

	static function create(maxonModule MaxonModule) returns MaxonToStdLowering
		return Self{maxonModule: maxonModule, stdModule: StdModule.create(), currentFuncName: ""}
	end 'create'

	function lower() returns StdModule
		// Clone blocks 1:1 first so blockRef indices stay aligned between the
		// source MaxonModule and the dest StdModule; each dest block starts empty
		// and its ops are appended during the per-function walk below. The
		// per-block source footprint is copied in lock-step so it survives to the
		// coverage-instrumentation pass (a later-milestone consumer).
		for i in 0 upto self.maxonModule.blocks.count() 'cloneBlocks'
			let srcBlock = try self.maxonModule.blocks.get(i) otherwise panic("lowerMaxonToStd: maxonModule.blocks.get OOB at {i}")
			self.stdModule.blocks.push(IrBlock.create(srcBlock.id, label: srcBlock.label))
			let srcInfo = try self.maxonModule.blockSourceInfo.get(i) otherwise BlockSourceInfo.empty()
			self.stdModule.blockSourceInfo.push(srcInfo)
		end 'cloneBlocks'

		// Transfer each function, collapsing its Maxon-phase types (return type +
		// param types) to the Std-phase types. blockRefs stay valid because block
		// indices were kept 1:1 above.
		for i in 0 upto self.maxonModule.functions.count() 'transferFuncs'
			var func = try self.maxonModule.functions.get(i) otherwise panic("lowerMaxonToStd: maxonModule.functions.get OOB at {i}")
			var stdParams = StdTypeArray.create()
			for paramType in func.maxonParamTypes 'eachParam'
				stdParams.push(maxonTypeToStdType(paramType))
			end 'eachParam'
			func.returnType = maxonReturnTypeToStdReturnType(func.maxonReturnType)
			func.paramTypes = stdParams
			self.stdModule.functions.push(func)
		end 'transferFuncs'

		// Walk each function's blocks and lower their body ops + terminator. Value
		// ids need no per-function reset — the parser already numbered them densely
		// per function, and this pass passes them through untouched.
		for srcFunc in self.stdModule.functions 'eachFunc'
			self.currentFuncName = srcFunc.name

			for blockRef in srcFunc.blockRefs 'eachBlock'
				let srcBlock = try self.maxonModule.blocks.get(blockRef) otherwise panic("lowerMaxonToStd: blockRef from srcFunc.blockRefs not in maxonModule.blocks")
				var dstBlock = try self.stdModule.blocks.get(blockRef) otherwise panic("lowerMaxonToStd: stdModule.blocks 1:1 with maxonModule.blocks but get({blockRef}) failed")

				for opIdx in srcBlock.opRefs 'eachOp'
					let hlOp = try self.maxonModule.ops.get(opIdx) otherwise panic("lowerMaxonToStd: opIdx from srcBlock.opRefs not in maxonModule.ops")
					self.lowerOp(hlOp, dstBlock: dstBlock)
				end 'eachOp'

				if srcBlock.hasTerminatorOp() 'hasTerm'
					let termOp = try self.maxonModule.ops.get(srcBlock.terminatorIndex()) otherwise panic("lowerMaxonToStd: terminatorIndex not in maxonModule.ops")
					self.lowerTerminator(termOp, dstBlock: dstBlock)
				end 'hasTerm'
			end 'eachBlock'
		end 'eachFunc'

		return self.stdModule
	end 'lower'

	// Lower a regular (non-terminator) Maxon body op. A `ret`/`retVoid` reaching
	// here (mid-block) is the rare body-op form (v1 hits it for partially-
	// terminated closure bodies) and lowers the same way as the terminator, just
	// appended rather than set.
	function lowerOp(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'lower'
			literal(result, value, litType) then self.lowerLiteral(result, value: value, litType: litType, dstBlock: dstBlock)
			ret(retVal) then self.emitRetOrErrorReturn(retVal, dstBlock: dstBlock, asTerminator: false)
			retVoid then self.rejectVoidReturn()
			binOp(result, lhs, rhs, op) then self.lowerBinOp(result, lhs: lhs, rhs: rhs, op: op, dstBlock: dstBlock)
			unaryOp(result, operand, op) then self.lowerUnaryOp(result, operand: operand, op: op, dstBlock: dstBlock)
		end 'lower'
	end 'lowerOp'

	// Lower a block terminator. A `literal` here is a parser bug (a literal is
	// never a block terminator).
	function lowerTerminator(hlOp MaxonOp, dstBlock IrBlock)
		match hlOp 'lower'
			ret(retVal) then self.emitRetOrErrorReturn(retVal, dstBlock: dstBlock, asTerminator: true)
			retVoid then self.rejectVoidReturn()
			literal then panic("lowerMaxonToStd: a `literal` op appeared as a block terminator (parser bug — literal is never a terminator)")
			binOp then panic("lowerMaxonToStd: a `binOp` op appeared as a block terminator (parser bug — a binary op is never a terminator)")
			unaryOp then panic("lowerMaxonToStd: a `unaryOp` op appeared as a block terminator (parser bug — a unary op is never a terminator)")
		end 'lower'
	end 'lowerTerminator'

	// Lower an integer/float literal to `StdOp.const`. The literal's collapsed
	// StdType rides along on the op: it carries both the width and the float-ness
	// the backend needs to pick a GP mov-immediate vs an XMM load, so no separate
	// opcode (v1's constI64/constF64) is required. `result` is the parser's
	// ValueId — this pass does not renumber.
	function lowerLiteral(result ValueId, value ParsedInt, litType MaxonType, dstBlock IrBlock)
		let stdType = maxonTypeToStdType(litType)
		self.stdModule.appendOp(dstBlock, op: StdOp.const(result, value: value, valueType: stdType))
	end 'lowerLiteral'

	// Lower a Maxon binary op to its Std counterpart. The operand and result
	// ValueIds pass through verbatim (this pass never renumbers — see the header);
	// only the source-level operator maps to a width/ABI-resolved Std opcode.
	function lowerBinOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, dstBlock IrBlock)
		let opcode = maxonBinOpToStdOpcode(op)
		self.stdModule.appendOp(dstBlock, op: StdOp.binOp(result, lhs: lhs, rhs: rhs, opcode: opcode))
	end 'lowerBinOp'

	// Lower a Maxon unary op to its Std counterpart. Like lowerBinOp, the operand
	// and result ValueIds pass through verbatim; only the source-level operator maps
	// to a width/ABI-resolved Std opcode.
	function lowerUnaryOp(result ValueId, operand ValueId, op MaxonUnaryOp, dstBlock IrBlock)
		let opcode = maxonUnaryOpToStdOpcode(op)
		self.stdModule.appendOp(dstBlock, op: StdOp.unaryOp(result, operand: operand, opcode: opcode))
	end 'lowerUnaryOp'

	// Emit the function-return terminator (or, for a mid-block ret, a body op).
	// M1 has only the PLAIN-ret arm: a non-throwing, non-interface-returning
	// function hands its single value back via `StdOp.ret`. The throwing
	// (errorReturn + zero flag) and fat-interface (errorReturn + witness) arms
	// GROW in at M15 / M6 — once the Std dialect gains `errorReturn` and
	// functions can throw or return interface types. `asTerminator` toggles
	// setTerminator (block-final) vs appendOp (the rare mid-block ret).
	function emitRetOrErrorReturn(retVal ValueId, dstBlock IrBlock, asTerminator bool)
		let plainOp = StdOp.ret(retVal)
		if asTerminator 'asTerm'
			self.stdModule.setTerminator(dstBlock, op: plainOp)
		end 'asTerm' else 'asBody'
			self.stdModule.appendOp(dstBlock, op: plainOp)
		end 'asBody'
	end 'emitRetOrErrorReturn'

	// A void `return` cannot be lowered yet: `StdOp` has no void-return variant
	// (it arrives with the function/ABI work at M5). Reaching here means a
	// void-returning function survived to lowering — which M1 cannot produce, as
	// the only function it compiles is `main`, and a void `main` is rejected by
	// E3002 before the pipeline gets this far. So this is a pipeline-ordering bug,
	// not a user error, and it fails loudly rather than silently emitting nothing.
	function rejectVoidReturn()
		panic("lowerMaxonToStd: a void `return` reached lowering in func '{self.currentFuncName}' — StdOp has no void-return variant until M5, and E3002 should have rejected a void `main` first")
	end 'rejectVoidReturn'
end 'MaxonToStdLowering'
