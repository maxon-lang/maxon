// IrInterface.maxon — the parsed shape of an `interface` declaration and a type's
// declared `implements` conformance (P1.7a slice 1 — the FRONT-END half of
// interfaces + witness tables: declaration + conformance CHECKING, no witness
// tables, no dictionary-passing, no existentials).
//
// ⭐ **TYPES ARE STORED AS RENDERED SOURCE STRINGS, not interned `MaxonType`s.** A
// conformance check compares an interface method against a type's method by SOURCE
// spelling (`Integer`, `Self`, `void`) and the E3016 message PRINTS that spelling,
// so the string is exactly what the checker needs. It also buys two properties the
// interned form would cost work to keep — the same two `paramAggregateNames` buys
// (Project.maxon): the string carries no interner id, so `mergeArtifact` folds an
// interface with NO remap; and it does not depend on `resolveTypes`, which erases
// `Integer` to `int` — and `checkConformance` runs BEFORE resolution, so the alias
// name is still there to print.
//
// ⭐ **The stdlib protocol interfaces (Stringable, Hashable, …) are SYNTHESIZED on
// lookup, not parsed.** shv2 does not read `stdlib/`; it synthesizes `String`/`Array`
// natively, and it synthesizes these the same way (`builtinInterface`). So a
// `type X implements Stringable` resolves against a compiler-known interface rather
// than raising a spurious E3015 — exactly as a `String` field resolves against a
// compiler-known type. This keeps the builtins OUT of the merge/reset machinery:
// `project.interfaces` holds only USER-declared interfaces.

// The rendered spelling of a `Self` type in an interface signature — the conforming
// type substitutes for it during a conformance check (`Movable.move returns Self`
// matches `Point.move returns Point`). Named because the renderer that writes it and
// the checker that substitutes it must agree on the exact bytes.
export let InterfaceSelfTypeName = b"Self"

// The rendered spelling of a void (no-`returns`) method result — `increment()` stores
// this and the E3016 message prints `returns void`. Named for `InterfaceSelfTypeName`'s
// reason: two sites depend on the exact bytes.
export let InterfaceVoidTypeName = b"void"

// The method a user struct must supply to be interpolated (`"{p}"` → `Pair.toString()`).
// Exported because the interpolation lowering (Parser) dispatches to it by name and the
// builtin `Stringable`/`FormattedStringable` interfaces declare it.
export let ToStringMethodName = b"toString"

// --- Witness tables (P1.7a slice 2a — the dictionary-passing dispatch substrate) ---

// The index of a `where`-constraint in a type's constraint list (P1.7a slice 2a) — which hidden witness
// PARAMETER an instance method reads to dispatch through that constraint. A type has at most a handful of
// constraints (each costs an ABI register), so a 16-bit index is ample.
export typealias WitnessSlotIndex = int(0 to u16.max)

// The DECL-ORDER index of a method within an interface (P1.7a slice 2a) — slot `i` of the witness table
// holds interface method `i`. An interface declares a handful of methods, so 16 bits is ample.
export typealias WitnessMethodIndex = int(0 to u16.max)

// ⭐ **WITNESS-TABLE BYTE LAYOUT** (P1.7a slice 2a), matching v1's `WitnessTable`: a header of
// `methodCount@0`, `parentTablePtr@8` (always 0 — parent-interface methods are projected INTO the child
// table at decl order, so no runtime chain), `flags@16` (0), then `methods[N]@24` — one 8-byte function
// pointer per interface method, in decl order, each stamped by a `funcAbs64InRdata` relocation. The fused
// `witnessCall` reads method `i` from `[witnessAddr + WitnessTableHeaderBytes + WitnessSlotBytes*i]`, so
// the emitter (the blob) and every reader (the x64, arm64 and wasm lowerings) must share these two
// constants — which is why they are stated once, here, rather than per backend.
export let WitnessTableHeaderBytes = 24 as ByteOffset
export let WitnessSlotBytes = 8 as ByteOffset

// The byte offset of witness-table method slot `index` (P1.7a slice 2a) — `24 + 8*index`. The ONE place
// the header size and slot stride combine, so the blob's slot layout and the fused call's memory offset
// cannot drift.
export function witnessMethodSlotOffset(index WitnessMethodIndex) returns ByteOffset
	return WitnessTableHeaderBytes + WitnessSlotBytes * index
end 'witnessMethodSlotOffset'

// ⭐⭐ **THE SEPARATOR THE WITNESS LABEL JOINS ITS TWO NAMES WITH, AND THE CHARACTER CLASS *IS* THE
// INJECTIVITY ARGUMENT.** The label identifies a `(conformer, interface)` PAIR, so a separator that a
// name may itself contain does not identify one: `_` is a legal identifier byte (`Lexer.isAlphaNum`), so
// an `_`-join spelled `(A_B, C)` and `(A, B_C)` as one `__witness_A_B_C`. That was not a collision the
// mint could see — it MEMOIZES ON THE LABEL, so the second pair did not contest the first, it silently
// BECAME it, and every method slot dispatched to the other conformer's impl with the other conformer's
// `self`. MEASURED: exit 0, no diagnostic, the program returned 33 where the answer is 43.
//
// ⚠ **IT IS THE *SECOND* HALF THAT CARRIES THE PROOF, AND ONLY THE SECOND.** The split is exact as soon as
// `interfaceName` holds no separator: the LAST separator after `__witness_` is then always the join, whatever
// the conformer half holds. Stating it of BOTH halves would be stating it of the half that cannot promise it
// — `ProgramSignatures.mangleTypeArg`'s `named` arm hands back a raw interned type name, and interned type
// names include the QUALIFIED per-instance spellings `joinQualifiedName` builds (`IntWrapper.Idx`), which are
// joined with a `.` of their own (`SignatureIndex.QualifiedAliasSeparator`). Nothing keeps those out of a
// conformer position by CHARACTER CLASS; today they are kept out by E3017/E2015 refusing them a conformance
// at all, which is a front-end gate and not a property of the lexer. **They are also harmless**, which is the
// point: a conformer may carry a separator and the split still lands in one place.
//
// The interface half CAN promise it, and does so where a name is admitted rather than where it is used: an
// interface name is a single `identifier` token — `where T is <ident>` (`Parser.readWhereClause`) and
// `implements <ident>, …` (`Parser.parseTypeImplementsClause`) — or one of the compiler's own synthesized
// protocol names below, and the lexer admits only `[A-Za-z0-9_]` inside an identifier. So injectivity is a
// property of the LEXER rather than of a decoding algorithm a later reader has to get right — but of the lexer
// acting on ONE half, which is why `requireSeparatorFreeLabelComponent` is asked of that half and not the
// other — and, at `witnessSlotImplKey`, of the method half for the same reason.
//
// Escaping by DOUBLING the separator would not even have worked: with a one-byte separator, a run of five
// underscores between two components admits three valid splits.
//
// ⚠ **DELIBERATELY NOT `Parser.MethodNameSeparator`, which holds the same byte, and the two have different
// ADMISSIBLE SETS — which is what makes them two facts rather than one written twice.** That one is pinned to
// exactly `.`: it is the separator the AUTHOR writes at a call site (`Point.create`), the mangled method name
// carries it verbatim, and both reference compilers emit that spelling. This one is pinned only to *some* byte
// outside the identifier alphabet — any of ~30 would do. A constant with a singleton admissible set and a
// constant with a thirty-member one cannot be the same fact, and MEASURED: rebuilt with this separator alone
// moved to `#`, the whole suite still returns every correct answer (60 goldens move, 0 wrong answers), so
// nothing anywhere requires the two to agree. One constant would couple a `.rdata` label to a piece of surface
// syntax so that a change to either silently moved the other. What the two genuinely share is only the lexer
// property above — which is why each states it where its own value lives.
let WitnessLabelSeparator = "."

// The `.rdata` label of the witness table for `typeName` conforming to `interfaceName` (P1.7a slice 2a) —
// `__witness_<Type>.<Iface>`. The ONE place this label is spelled, shared by the blob emitter (which
// registers it) and the concrete dispatch site (which takes its `rdataAddr`), so they cannot disagree.
export function witnessTableLabel(typeName ByteArray, interfaceName ByteArray) returns String
	requireSeparatorFreeLabelComponent(interfaceName, component: WitnessLabelComponent.interfaceName)

	return "__witness_{String.from(typeName)}{WitnessLabelSeparator}{String.from(interfaceName)}"
end 'witnessTableLabel'

// ⭐⭐ **THE KEY IDENTIFYING ONE WITNESS-TABLE SLOT — `(conformer, interface, method)` (R10).** It is what
// `ConformanceCheck` files its SELECTED impl under and what `LowerMaxonToStd.ensureWitnessTable` reads that
// selection back by, so the member a conformance ACCEPTED and the symbol a slot's relocation NAMES are one
// value rather than two joins of the same names that happen to agree. Under D7 those two joins genuinely
// diverge: a requirement satisfied by a later overload is registered `Type.method#Suffix` while an
// un-suffixed join spells the FIRST declaration, and both sites minting their own was a silent wrong
// dispatch waiting for conformance to be fixed.
//
// It is BUILT ON the table label rather than beside it, so the pair half of the key cannot drift from the
// label the slot actually belongs to — and the method half is held to the same separator-freedom the
// interface half is (below).
//
// ⚠ **WHAT THAT BUYS IS INJECTIVITY, NOT DECODABILITY, and the distinction matters because NOTHING SPLITS
// THIS KEY** (R10 review — an earlier wording here claimed a "three-way split", which no reader performs
// and no future reader should be invited to write). The property spent is that two DISTINCT triples never
// spell one key: the conformer half may itself carry a separator (`mangleTypeArg`'s qualified per-instance
// spellings do), so it is only the last two components that must be free of it — and each of those is a
// single token the lexer keeps the separator out of. Both halves free ⇒ the join is a function of the
// triple, which is the whole of what a map key needs.
export function witnessSlotImplKey(typeName ByteArray, interfaceName ByteArray, methodName ByteArray) returns ByteArray
	requireSeparatorFreeLabelComponent(methodName, component: WitnessLabelComponent.methodName)

	return "{witnessTableLabel(typeName, interfaceName: interfaceName)}{WitnessLabelSeparator}{String.from(methodName)}".toByteArray()
end 'witnessSlotImplKey'

// ⭐ **THE INJECTIVITY ARGUMENT, ENFORCED AT THE JOIN THAT RELIES ON IT INSTEAD OF ONLY ARGUED ABOVE IT.**
// The property lives three files away — an interface name and a method name are each a single token, so the
// lexer keeps the separator out of both — and a join whose correctness rests on a fact stated only in
// someone else's file is the shape that already bit this label once. This is that fact, asked where it is
// spent: once by `witnessTableLabel` of its interface half, once by `witnessSlotImplKey` of its method half.
//
// It is UNREACHABLE today and that is exactly what it is for: what it catches is a LATER widening of what
// may name an interface — a namespaced `where T is Foo.Bar` is the obvious one — which would otherwise
// silently restore the very bug the separator was introduced to fix, with no diagnostic and a wrong answer
// at runtime. A PANIC and not a diagnostic, because the broken invariant would be the COMPILER's (two
// conformances quietly sharing one dictionary), not anything the author could be told to write differently.
//
// The separator byte is read OUT of `WitnessLabelSeparator` rather than restated as a literal: a second
// spelling would be free to drift from the join it is supposed to be checking, which is the whole failure
// mode this function exists to prevent.
//
// ⚠ **THE CALLER NAMES ITS COMPONENT AND NOTHING ELSE — the sentence is BUILT ON THE FAILURE PATH, and that
// is measured rather than tidy (R10 review).** Passing the join template and the "identifies" clause as
// STRING arguments made every call build them: an interpolation over a `let` String is not folded, so
// `join: "__witness_<Type>{WitnessLabelSeparator}<Iface>"` compiled to an `__mm_alloc` plus three
// `__str_copy`s (measured in the emitted IR) at every `witnessTableLabel` and every `witnessSlotImplKey` —
// one heap String per call, to describe a panic the header above documents as unreachable. A discriminator
// costs nothing and puts each component's three facts (what it is called, which join spends it, what that
// join would stop identifying) in ONE arm instead of scattering them across the two call sites. Same shape,
// and for the same reason, as `Parser.nameExpectationOf`.
function requireSeparatorFreeLabelComponent(name ByteArray, component WitnessLabelComponent)
	let separator = try WitnessLabelSeparator.toByteArray().get(0) otherwise panic("requireSeparatorFreeLabelComponent: WitnessLabelSeparator is a one-byte literal")

	for i in 0 upto name.count() 'scan'
		if (try name.get(i) otherwise panic("requireSeparatorFreeLabelComponent: index {i} is below count {name.count()}, but get failed")) == separator 'contains'
			panic("requireSeparatorFreeLabelComponent: {separatorFreedomSubjectOf(component)} '{String.from(name)}' contains the label separator '{WitnessLabelSeparator}', so `{separatorFreedomJoinOf(component)}` no longer identifies {separatorFreedomIdentitiesOf(component)} — two would spell one name and the second would silently take the first's dictionary. An interface name and a method name are each a single token today; whatever widened that has to pick a separator no component can hold")
		end 'contains'
	end 'scan'
end 'requireSeparatorFreeLabelComponent'

// Which half of a witness label the separator-freedom argument is being spent on (see
// `requireSeparatorFreeLabelComponent`). The conformer half is deliberately absent: it MAY carry the
// separator (`mangleTypeArg`'s qualified per-instance spellings do), which is exactly why it is the LAST TWO
// components that have to be free of it.
enum WitnessLabelComponent
	// The `<Iface>` of `__witness_<Type>.<Iface>`, asked by `witnessTableLabel`.
	interfaceName
	// The `<method>` of `__witness_<Type>.<Iface>.<method>`, asked by `witnessSlotImplKey`.
	methodName
end 'WitnessLabelComponent'

// What to CALL the offending component in the panic. Rendered on the FAILURE path only (see
// `requireSeparatorFreeLabelComponent`), as are the two below.
function separatorFreedomSubjectOf(component WitnessLabelComponent) returns String
	match component 'which'
		interfaceName then return "interface name"
		methodName then return "method name"
	end 'which'
end 'separatorFreedomSubjectOf'

// The JOIN whose injectivity this component's separator-freedom is what buys — the one that stops being a
// function of its parts the moment a component can hold the separator.
function separatorFreedomJoinOf(component WitnessLabelComponent) returns String
	match component 'which'
		interfaceName then return "__witness_<Type>{WitnessLabelSeparator}<Iface>"
		methodName then return "__witness_<Type>{WitnessLabelSeparator}<Iface>{WitnessLabelSeparator}<method>"
	end 'which'
end 'separatorFreedomJoinOf'

// What that join identifies, and would stop identifying.
function separatorFreedomIdentitiesOf(component WitnessLabelComponent) returns String
	match component 'which'
		interfaceName then return "ONE (conformer, interface) pair"
		methodName then return "ONE (conformer, interface, method) slot"
	end 'which'
end 'separatorFreedomIdentitiesOf'

// --- The stdlib protocol-interface names (SYNTHESIZED, not parsed from stdlib/) ---
let StringableInterfaceName = b"Stringable"
let FormattedStringableInterfaceName = b"FormattedStringable"

// `Hashable`/`Equatable`/`Comparable` are EXPORTED, the other protocol names are not, and the three consumers
// are the reason: the comparison-operator lowerings pick their PROTOCOL by name (`==`/`!=` is Equatable's,
// `<`/`>`/`<=`/`>=` is Comparable's) and then read everything else off the synthesized interface
// (`requireBuiltinInterface`); and the `Set` runtime threads a key's `Hashable`/`Equatable` witness tables by
// name (`LowerMaxonToStd.appendSetWitnessArgs` materializes `rdataAddr(__witness_<key>.Hashable)`), whose label
// must be the one the builtin-conformance table registers under. Each reads THIS spelling instead of keeping
// its own — `SetRuntime` used to keep a second copy of two of them.
export let HashableInterfaceName = b"Hashable"
export let EquatableInterfaceName = b"Equatable"
export let ComparableInterfaceName = b"Comparable"
let CloneableInterfaceName = b"Cloneable"
let ErrorInterfaceName = b"Error"

// The protocol methods + their result/param type spellings, verbatim from
// stdlib/Interfaces.maxon (the SAME file the reference compilers parse).
export let HashMethodName = b"hash"
export let EqualsMethodName = b"equals"

// All three are exported for ONE reason: `BuiltinConformanceRuntime` names each SYNTHESIZED impl it installs
// (`int.hash`, `<scalar>.equals`, `<scalar>.compare`, `String.hash`/`String.equals`) by joining a conformer
// name to the method name, and that symbol must be the one the witness-table reloc points at. The operator
// lowerings do NOT name them — they read the method off the protocol `builtinInterface` synthesizes
// (`requireBuiltinInterface`), so the method searched for and its result type stay one fact.
export let CompareMethodName = b"compare"
let CloneMethodName = b"clone"
let FormatParamName = b"format"
let OtherParamName = b"other"
export let HashValueTypeName = b"HashValue"

// `stdlib/Character.maxon`'s `export typealias Codepoint = int(0 to 1114111)` — the SECOND name
// `isSynthesizedIntAliasName` answers for (see its header for why it cannot come from a registry). It sits
// beside `HashValueTypeName` rather than in the parser or the whitelist because both readers of the
// synthesized-alias set already live here, and a spelling kept anywhere else would be a second copy of the
// name that only the day of a rename would show to be wrong.
export let CodepointTypeName = b"Codepoint"

// ⚠ There is deliberately no `StringTypeName`/`BoolTypeName` beside these: the rendered spelling of
// `String` in `Stringable.toString() returns String` and of `bool` in `Equatable.equals(…) returns bool`
// IS the CONFORMER NAME of that type (`StringConformerName` / `BoolConformerName` below) — one fact, "how
// this type is spelled in source", wearing an interface signature's hat. They were two constants holding
// the same bytes for `String`, which is precisely the shape that drifts.
// Exported: `Comparable.compare`'s result type is a COMPILER-KNOWN ENUM, and the enum registries are
// seeded with its layout under this exact name (`Project.builtinOrderingEnum`). One spelling for the
// interface's rendered return type, the seeded layout's name, and the declaration reject that keeps a
// user from binding the name.
export let OrderingTypeName = b"Ordering"

// `Ordering`'s three cases, in DECLARATION order, verbatim from stdlib/Interfaces.maxon:34-38. Named
// rather than spelled at each use because THREE parties depend on the exact bytes: the layout builder
// that declares them, the synthesized `int.compare` that returns their tags, and the `<`/`>`/`<=`/`>=`
// lowering that tests its dispatch result against them.
export let OrderingLessThanCaseName = b"lessThan"
export let OrderingEqualToCaseName = b"equalTo"
export let OrderingGreaterThanCaseName = b"greaterThan"

// One method SIGNATURE declared in an interface body (no body). Its type columns are
// rendered SOURCE strings (see the header). `paramNames`/`paramTypeNames` are parallel.
export type InterfaceMethodSig
	export let name as ByteArray
	export let paramNames as ByteArrayArray
	export let paramTypeNames as ByteArrayArray
	export let returnTypeName as ByteArray
	// A `static function` in an interface body carries no receiver, so a conforming type
	// need not supply it as an instance method — the conformance check SKIPS it, matching
	// the reference oracle (`if method.IsStatic continue`).
	export let isStatic as bool
	// ⭐ **THE METHOD'S DECLARED `throws` (P1.7a slice 2b-v)** — the fact that decides which ABI a
	// witness dispatch of this method uses. A `throwing` clause makes the dispatch a dual-register
	// `witnessTryCall` that a `try` must cover (E3057 without one); `none` makes it the single-register
	// `witnessCall`, which a `try` may not cover (E3055). Both directions of the conformance relation are
	// checked against it (`validateThrowsConformance`), because the CALLER's ABI is picked from the
	// INTERFACE while the callee's is picked from the IMPL: the two must agree or the flag register is
	// written by one end and not read by the other.
	export let throwsClause as ThrowsClause

	export static function create(name ByteArray, paramNames ByteArrayArray, paramTypeNames ByteArrayArray, returnTypeName ByteArray, isStatic bool, throwsClause ThrowsClause) returns InterfaceMethodSig
		return Self{name: name, paramNames: paramNames, paramTypeNames: paramTypeNames, returnTypeName: returnTypeName, isStatic: isStatic, throwsClause: throwsClause}
	end 'create'
end 'InterfaceMethodSig'

export typealias InterfaceMethodSigArray = Array with InterfaceMethodSig

// ⭐⭐ **THE ONE RENDERER OF A DECLARED TYPE TO THE SOURCE STRING A CONFORMANCE COMPARES AND PRINTS.**
// BOTH sides of the conformance relation come through here — the INTERFACE side at parse time
// (`Parser.renderInterfaceTypeName`, which adds only the `Self` arm on top of it) and the IMPL side at
// check time (`ConformanceCheck.signatureMatches` / `formatActualSignature`) — and it is ONE function
// because a rendered name is a type IDENTITY, not a caption: `signatureMatches` decides conformance by
// comparing two of these strings. A tag the two sides spell DIFFERENTLY is a false REJECT; a tag they
// both spell as one KIND WORD is a false ACCEPT, which no positive test can see.
//
// ⚠ **`maxonTypeName` ALONE CANNOT BE THAT RENDERER — two of its arms name a KIND rather than a TYPE**,
// and this is the one site where that difference is a wrong answer instead of a cosmetic one:
//
//   • a `typeParameter`'s id is a POSITION in its declaring type's `uses` list and not an interner id, so
//     `maxonTypeName` gives the literal `type parameter` for every one of them: `T` and `U` render alike
//     and neither matches ITSELF, which rejected `type Box uses T implements Holder with T` — how every
//     generic container in `stdlib/` declares conformance (R5).
//   • a `genericInstance` renders as the literal `struct`, so `Array with Integer` and `Array with String`
//     render alike — a FALSE ACCEPT. MEASURED (R5 review): shv2 compiled and ran a type whose
//     `take(xs Array with String)` satisfied an interface requiring `take(xs Array with Integer)`, exit 42,
//     where the bootstrap reports E3016 on the same program. An instance's identity is
//     `ProgramSignatures.canonicalInstanceName` — the compiler's own answer to "are these two the same
//     type?", which every OTHER comparison site already asks, and which collapses the two spellings of one
//     instance to one string.
//
// The lists are the CALLER's because only the caller knows whose they are: the parser renders against the
// declaration it is inside (`enclosingTypeParams`) and its file-local interner, the conformance check
// against the conforming type's recorded `uses` names and the project interner. They are four PARAMETERS
// and deliberately not one record: a record is a heap box, this is called once per rendered type, and the
// ladder read the difference — +32/+48/+80/+144/+272/+528 allocations at 32 bytes each, measured A/B on
// this branch, for nothing but a shorter call. The RULE lives here, once —
// it was two copies for one rung, and the copies AGREED on the `genericInstance` hole, which is exactly why
// the hole read as an acceptance rather than as a disagreement.
export function renderDeclaredTypeName(t MaxonType, declarationName ByteArray, typeParamNames ByteArrayArray, typeNames TypeNameInterner, signatures ProgramSignatures) returns ByteArray
	let tag = maxonTypeTag(t)

	if tag == ValueTypeTag.typeParameter 'typeParameterType'
		return try typeParamNames.get(typeNameIdOf(t)) otherwise panic("renderDeclaredTypeName: type-parameter position {typeNameIdOf(t)} is outside '{String.from(declarationName)}'s own `uses` list of {typeParamNames.count()}, which is the list its signatures were resolved against")
	end 'typeParameterType'

	if tag == ValueTypeTag.genericInstance 'genericInstanceType'
		return signatures.canonicalInstanceName(typeNameIdOf(t))
	end 'genericInstanceType'

	return maxonTypeName(t, typeNames: typeNames).toByteArray()
end 'renderDeclaredTypeName'

// A parsed (or synthesized) `interface`. `extendsInterfaces` are parent interface names
// whose methods a conforming type must ALSO supply (`interface D extends B` — the check
// projects B's methods into D at decl order); `associatedTypeNames` are the `uses`
// parameters, POSITIONALLY bound by a conformance's `with` arguments (R5) — the list
// `InterfaceConformance.withArgs` lines up against, and the list an unbound name is
// reported from.
export type IrInterface
	export let name as ByteArray
	export let methods as InterfaceMethodSigArray
	export let extendsInterfaces as ByteArrayArray
	export let associatedTypeNames as ByteArrayArray

	export static function create(name ByteArray, methods InterfaceMethodSigArray, extendsInterfaces ByteArrayArray, associatedTypeNames ByteArrayArray) returns IrInterface
		return Self{name: name, methods: methods, extendsInterfaces: extendsInterfaces, associatedTypeNames: associatedTypeNames}
	end 'create'
end 'IrInterface'

export typealias IrInterfaceMap = Map with (ByteArray, IrInterface)

// The per-file artifact contribution form — declaration order, folded into the
// whole-program `IrInterfaceMap` by `mergeArtifact`.
export typealias IrInterfaceArray = Array with IrInterface

// The SHARED EMPTY `with` argument list every conformance that writes no `with` clause holds (R5) —
// which is every conformance in the corpus but the associated-type specs. `InterfaceConformance` binds
// it with `let` and the substitution only READS it, so one allocation serves them all, the discipline
// `Project.sharedEmptyWhereConstraints` states in full. It is the reason `withoutBindings` exists as a
// second constructor rather than each caller spelling `ByteArrayArray.create()`: a caller that allocated
// its own empty list would pay one heap object per declared conformance and nothing would notice.
let sharedEmptyWithArgs = ByteArrayArray.create()

// ⭐ **ONE `I [with A, B]` ENTRY OF AN `implements` CLAUSE (R5).** The interface NAME and this
// conformance's POSITIONAL bindings for that interface's `uses` names, kept together because they mean
// nothing apart: `withArgs[i]` binds `iface.associatedTypeNames[i]`. Two parallel columns on the decl
// would be the same data with an alignment hazard a record makes unrepresentable.
//
// The arguments are RENDERED SOURCE STRINGS for `InterfaceMethodSig`'s reason (see this file's header):
// what they substitute INTO is a requirement's rendered type string, and the E3016 message prints the
// result — `implements Typed with Float` must print `expected make() returns Float`.
export type InterfaceConformance
	export let interfaceName as ByteArray
	export let withArgs as ByteArrayArray

	export static function create(interfaceName ByteArray, withArgs ByteArrayArray) returns InterfaceConformance
		return Self{interfaceName: interfaceName, withArgs: withArgs}
	end 'create'

	// A conformance that wrote no `with` clause at all — it binds nothing, and shares the one empty list.
	export static function withoutBindings(interfaceName ByteArray) returns InterfaceConformance
		return Self{interfaceName: interfaceName, withArgs: sharedEmptyWithArgs}
	end 'withoutBindings'
end 'InterfaceConformance'

export typealias InterfaceConformanceArray = Array with InterfaceConformance

// A `type X implements I1, I2` conformance declaration. Carries the type NAME token
// position (line/column/file) so the E3015/E3016 diagnostic lands ON the type name —
// the anchor both reference compilers use (`nameToken` / `conf.line, conf.column`).
export type ConformanceDecl
	export let typeName as ByteArray
	export let interfaces as InterfaceConformanceArray
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber
	export let filePath as FilePath

	export static function create(typeName ByteArray, interfaces InterfaceConformanceArray, nameLine LineNumber, nameColumn ColumnNumber, filePath FilePath) returns ConformanceDecl
		return Self{typeName: typeName, interfaces: interfaces, nameLine: nameLine, nameColumn: nameColumn, filePath: filePath}
	end 'create'
end 'ConformanceDecl'

export typealias ConformanceDeclArray = Array with ConformanceDecl

// The outcome of resolving an interface NAME to its definition — a synthesized builtin
// or a user-declared one, else `notFound` (which `checkConformance` renders as E3015).
export union InterfaceLookup
	found(iface IrInterface)
	notFound
end 'InterfaceLookup'

// ⭐ **THE RESOLVED TARGET OF A CONSTRAINED-TYPE-PARAMETER DISPATCH (P1.7a slice 2a)** — `self.item.digest()`
// resolved against the enclosing type's `where` constraints. `constraintIndex` is which constraint (and so
// which hidden witness parameter) supplies the method; `methodIndex` is the DECL-ORDER slot of the method in
// that constraint's interface (the witness-table slot); `returnTypeName` is the interface method's rendered
// return type, used to type the dispatch result exactly as a direct call types its own. `paramTypeNames` are
// the method's rendered formal parameter types (P1.7a slice 2b) — read to reject a concrete value marshalled
// into a `Self`-typed formal (`Equatable.equals`'s and `Comparable.compare`'s `other Self`), which would fault
// (a struct `equals` dereferences an int literal as its `other` pointer).
export type WitnessDispatchTarget
	export let constraintIndex as WitnessSlotIndex
	export let methodIndex as WitnessMethodIndex
	export let returnTypeName as ByteArray
	export let paramTypeNames as ByteArrayArray
	// ⭐ **THE AUTHORITATIVE `name:` LABEL VOCABULARY OF THIS DISPATCH (P1.7a slice 2b-vi)** — parallel to
	// `paramTypeNames`, and the list `Project.slotCallArgs` slots the call's arguments against. It is the
	// INTERFACE's parameter names, never a conformer's, and it has to be: under dictionary-passing the shared
	// body has no concrete callee to ask, and `ConformanceCheck.signatureMatches` compares arity and TYPES
	// only (it reads `paramNames` to format E3016 and never compares it), so several conformers may spell
	// their parameters differently and only the interface's names are common to all of them.
	export let paramNames as ByteArrayArray
	// The interface method's declared `throws` (P1.7a slice 2b-v) — carried through the resolution so the
	// dispatch site picks the throwing or non-throwing witness ABI, and so the `try` desugar can type the
	// `(e)` binding it recovers. A witness method is in NO signature registry (there is no callee NAME to
	// ask `throwsOf` about), so this is the only place the fact reaches the call site.
	export let throwsClause as ThrowsClause
	// The method NAME, for the E3055/E3057/E3059 diagnostics a witness `try` target reports. A direct call
	// blames its callee name; a witness dispatch blames the interface method the user actually wrote.
	export let methodName as ByteArray

	export static function create(constraintIndex WitnessSlotIndex, methodIndex WitnessMethodIndex, returnTypeName ByteArray, paramTypeNames ByteArrayArray, throwsClause ThrowsClause, methodName ByteArray, paramNames ByteArrayArray) returns WitnessDispatchTarget
		return Self{constraintIndex: constraintIndex, methodIndex: methodIndex, returnTypeName: returnTypeName, paramTypeNames: paramTypeNames, throwsClause: throwsClause, methodName: methodName, paramNames: paramNames}
	end 'create'
end 'WitnessDispatchTarget'

// The outcome of searching a type parameter's `where` constraints for one whose interface declares a given
// method (P1.7a slice 2b) — `found` when a constraint supplies it, `notFound` when none does. The non-throwing
// core shared by the `.method()` dispatch (which turns `notFound` into its "no constraint provides this method"
// reject) and the `==`/`!=`-on-a-type-parameter lowering (which turns it into E3005 "requires `where T is
// Equatable`"): the search runs in ONE place, and each caller owns its own diagnostic for the miss.
export union WitnessDispatchLookup
	found(target WitnessDispatchTarget)
	notFound
end 'WitnessDispatchLookup'

// The decl-order index of the method named `methodName` in `iface` (P1.7a slice 2a), or `methods.count()`
// (the "not declared by this interface" sentinel) when absent — the witness-table slot the dispatch reads.
// Do two interface methods declare the SAME formals — the same rendered types, in the same order (and so,
// by construction, the same arity)? Both sides are `InterfaceMethodSig.paramTypeNames`, which are rendered
// by ONE renderer (`Parser.renderInterfaceTypeName`) that spells the enclosing interface `Self` either way,
// so a byte comparison is exact and no canonicalization is owed.
//
// ⚠ NOT `ConformanceCheck.signatureMatches`, and the two must not be merged: that one asks whether an IMPL
// satisfies an interface method, so it substitutes `Self` for the conformer's own name and collapses ranged
// aliases to their underlying primitive. This one asks whether one INTERFACE method is another — both sides
// already in the interface's own vocabulary, where `Self` means `Self`.
export function interfaceFormalsMatch(a ByteArrayArray, b ByteArrayArray) returns bool
	if a.count() != b.count() 'arityDiffers'
		return false
	end 'arityDiffers'

	for i in 0 upto a.count() 'eachFormal'
		let left = try a.get(i) otherwise panic("interfaceFormalsMatch: a.get OOB at {i} below count {a.count()}")
		let right = try b.get(i) otherwise panic("interfaceFormalsMatch: b.get OOB at {i} below count {b.count()}")
		if not left.equals(right) 'differs'
			return false
		end 'differs'
	end 'eachFormal'

	return true
end 'interfaceFormalsMatch'

export function interfaceMethodIndex(iface IrInterface, methodName ByteArray) returns WitnessMethodIndex
	for i in 0 upto iface.methods.count() 'each'
		let method = try iface.methods.get(i) otherwise panic("interfaceMethodIndex: methods.get OOB at {i} below count {iface.methods.count()}")
		if method.name.equals(methodName) 'hit'
			return i
		end 'hit'
	end 'each'
	return iface.methods.count()
end 'interfaceMethodIndex'

// A nullary interface method (`hash()`, `toString()`, `clone()`). Every SYNTHESIZED protocol method is
// non-throwing — the builtin conformances (`int.hash()`, `String.equals(other)`) are compiler-emitted
// runtime chunks with no error channel — so the throws clause is `none` at both helpers.
function nullaryInterfaceMethod(name ByteArray, returnTypeName ByteArray) returns InterfaceMethodSig
	return InterfaceMethodSig.create(name, paramNames: ByteArrayArray.create(), paramTypeNames: ByteArrayArray.create(), returnTypeName: returnTypeName, isStatic: false, throwsClause: ThrowsClause.none)
end 'nullaryInterfaceMethod'

// A one-parameter interface method (`equals(other Self)`, `toString(format String)`).
function unaryInterfaceMethod(name ByteArray, paramName ByteArray, paramTypeName ByteArray, returnTypeName ByteArray) returns InterfaceMethodSig
	var paramNames = ByteArrayArray.create()
	paramNames.push(paramName)
	var paramTypeNames = ByteArrayArray.create()
	paramTypeNames.push(paramTypeName)
	return InterfaceMethodSig.create(name, paramNames: paramNames, paramTypeNames: paramTypeNames, returnTypeName: returnTypeName, isStatic: false, throwsClause: ThrowsClause.none)
end 'unaryInterfaceMethod'

// An interface with exactly one method and no `extends`/`uses` — every synthesized
// protocol interface but `Error`.
function singleMethodInterface(name ByteArray, method InterfaceMethodSig) returns IrInterface
	var methods = InterfaceMethodSigArray.create()
	methods.push(method)
	return IrInterface.create(name, methods: methods, extendsInterfaces: ByteArrayArray.create(), associatedTypeNames: ByteArrayArray.create())
end 'singleMethodInterface'

// A marker interface with NO methods (`Error`). A type conforms to it by declaring
// `implements Error` alone; there is nothing to check.
function markerInterface(name ByteArray) returns IrInterface
	return IrInterface.create(name, methods: InterfaceMethodSigArray.create(), extendsInterfaces: ByteArrayArray.create(), associatedTypeNames: ByteArrayArray.create())
end 'markerInterface'

// ⭐⭐ **THE Std RESULT TYPE OF A SYNTHESIZED PROTOCOL METHOD — ONE FACT, READ BY EVERY BUILDER THAT MUST
// AGREE WITH IT (P1.7a slice 2b-iv-B).** A witness table's method slot is typed by the INTERFACE, so three
// parties have to spell one signature: the DISPATCH SITE (which derives it from the declarations just below,
// through `Parser.interfaceReturnMaxonType` → `valueTagToStdType`), the synthesized IMPL that lands in the
// slot (`BuiltinConformanceRuntime`, `StringRuntime.buildStrEq`), and the hand-built `Set` runtime whose
// bodies dispatch `hash`/`equals` through witnesses of their own (`SetRuntime`). Nothing makes a synthesized
// impl obey a conformance check — there is none to run — so without this the three were three copies.
//
// ⚠ **THEY HAD ALREADY DRIFTED, AND ONLY ONE TARGET COULD SEE IT.** `equals` returns `bool` — an `i1`, a
// wasm `i32` — while every impl and the `Set` runtime declared the uniform machine word `i64`. On x64/arm64 a
// `bool` rides a 64-bit register as readily as a tag, so the disagreement computed the right answer
// everywhere; on wasm, whose `call_indirect` checks the declared functype against the target's own EXACTLY,
// it was a **`wasm trap: indirect call type mismatch`** across 18 spec cases (`set`, `equatable`,
// `primitive-conformance`, `string-conformance`).
//
// It is keyed by the RENDERED RETURN-TYPE NAME each declaration below already carries, so adding a protocol
// method means writing its return type once — in the declaration — and this answers for it.
export function builtinProtocolResultStdType(returnTypeName ByteArray) returns StdType
	// `bool` is the one sub-64 result: `valueTagToStdType(boolean)` is `i1`.
	if returnTypeName.equals(BoolConformerName) 'boolResult'
		return StdType.i1
	end 'boolResult'

	// `HashValue` is a ranged int alias and `Ordering` an enum — both collapse to a machine word
	// (`valueTagToStdType`'s `named`/`integer` arms), which is what makes them agree with the impls already.
	if returnTypeName.equals(HashValueTypeName) or returnTypeName.equals(OrderingTypeName) 'machineWordResult'
		return StdType.i64
	end 'machineWordResult'

	panic("builtinProtocolResultStdType: '{String.from(returnTypeName)}' is not a synthesized protocol method's return type — the three below return `bool`, `HashValue` and `Ordering`, and a fourth must be given its Std type here rather than assumed to be a machine word")
end 'builtinProtocolResultStdType'

// The SYNTHESIZED stdlib protocol interfaces, verbatim from stdlib/Interfaces.maxon —
// so `implements Stringable`/`Hashable`/… resolves without shv2 reading the stdlib (the
// same reason `String`/`Array` are synthesized). Returns `notFound` for every other name,
// leaving the user-declared registry as the only other source. `Iterator`/`Iterable`
// (associated types) are slice-2 territory and are deliberately not synthesized here.
export function builtinInterface(name ByteArray) returns InterfaceLookup
	if name.equals(StringableInterfaceName) 'stringable'
		return InterfaceLookup.found(singleMethodInterface(StringableInterfaceName, method: nullaryInterfaceMethod(ToStringMethodName, returnTypeName: StringConformerName)))
	end 'stringable'

	if name.equals(FormattedStringableInterfaceName) 'formatted'
		return InterfaceLookup.found(singleMethodInterface(FormattedStringableInterfaceName, method: unaryInterfaceMethod(ToStringMethodName, paramName: FormatParamName, paramTypeName: StringConformerName, returnTypeName: StringConformerName)))
	end 'formatted'

	if name.equals(HashableInterfaceName) 'hashable'
		return InterfaceLookup.found(singleMethodInterface(HashableInterfaceName, method: nullaryInterfaceMethod(HashMethodName, returnTypeName: HashValueTypeName)))
	end 'hashable'

	if name.equals(EquatableInterfaceName) 'equatable'
		return InterfaceLookup.found(singleMethodInterface(EquatableInterfaceName, method: unaryInterfaceMethod(EqualsMethodName, paramName: OtherParamName, paramTypeName: InterfaceSelfTypeName, returnTypeName: BoolConformerName)))
	end 'equatable'

	if name.equals(ComparableInterfaceName) 'comparable'
		return InterfaceLookup.found(singleMethodInterface(ComparableInterfaceName, method: unaryInterfaceMethod(CompareMethodName, paramName: OtherParamName, paramTypeName: InterfaceSelfTypeName, returnTypeName: OrderingTypeName)))
	end 'comparable'

	if name.equals(CloneableInterfaceName) 'cloneable'
		return InterfaceLookup.found(singleMethodInterface(CloneableInterfaceName, method: nullaryInterfaceMethod(CloneMethodName, returnTypeName: InterfaceSelfTypeName)))
	end 'cloneable'

	if name.equals(ErrorInterfaceName) 'error'
		return InterfaceLookup.found(markerInterface(ErrorInterfaceName))
	end 'error'

	return InterfaceLookup.notFound
end 'builtinInterface'

// ⭐ **WHICH INTERFACE DOES THIS NAME DENOTE, ASKED OF THE MERGED REGISTRY — ONE RULE, ONE HOME (R9).**
// A synthesized builtin FIRST, then the user-declared registry, else `notFound`. Builtins win so a user
// cannot shadow `Stringable` with a broken redeclaration, and the common protocol interfaces resolve
// without shv2 reading the stdlib.
//
// ⚠ **IT TAKES THE MAP, NOT THE `Project`, AND THAT IS WHAT LETS BOTH POST-MERGE READERS SHARE IT.**
// `ConformanceCheck` asks through `project.interfaces` and `LowerMaxonToStd` through the field it was
// constructed with — the SAME object, aliased — so a `Project`-shaped parameter would have forced the
// lowering to keep a second spelling of a rule stated here. The two callers still differ in what a MISS
// MEANS (a user's typo'd interface name is `E3015`; a witness table naming an unresolvable interface is an
// internal invariant break), so the miss stays theirs and only the lookup is shared.
//
// ⚠ This is deliberately NOT merged with `Parser.lookupInterfaceForParse`, which R8 put over the
// declaration INDEX: that one answers mid-parse, before any file has merged, and the split is the same
// parse-time/check-time one R8's header defends. What was genuine duplication is these two, which read one
// store in one phase.
export function lookupInterface(interfaces IrInterfaceMap, name ByteArray) returns InterfaceLookup
	match builtinInterface(name) 'builtin'
		found(iface) then return InterfaceLookup.found(iface)
		notFound then break 'builtin'
	end 'builtin'

	if let userIface = try interfaces.get(name) 'userDeclared'
		return InterfaceLookup.found(userIface)
	end 'userDeclared'

	return InterfaceLookup.notFound
end 'lookupInterface'

// ⭐ **THE SYNTHESIZED PROTOCOL UNDER `name`, FOR A CALLER THAT NEEDS ITS *DECLARATION* AND NOT MERELY ITS
// NAME.** A consumer that must agree with a protocol about more than one fact — the comparison-operator
// lowering needs `Comparable`'s METHOD NAME to search the `where` constraints for, AND that method's RESULT
// TYPE to read the dispatch's verdict off — reads both off the interface `builtinInterface` synthesizes here,
// instead of spelling them a second time at the consumer. Three parallel spellings of one interface (name,
// method, result) are exactly the shape that drifts; one fetch cannot.
//
// It PANICS on a miss because the only legitimate caller names a protocol this function synthesizes; a
// user-declared interface is resolved through the registries (`requireInterfaceForParse`), never here.
export function requireBuiltinInterface(name ByteArray) returns IrInterface
	match builtinInterface(name) 'lookup'
		found(iface) then return iface
		notFound then panic("requireBuiltinInterface: '{String.from(name)}' is not one of the synthesized protocol interfaces — only a caller naming a protocol `builtinInterface` declares may ask for its declaration")
	end 'lookup'
end 'requireBuiltinInterface'

// The canonical conformer name of the primitive `int` — what `ProgramSignatures.conformerTypeArgName`
// reduces every ranged int alias to, and the key of `int`'s witness tables (`__witness_int.*`) and its
// synthesized `int.hash`/`int.equals` impls. Named because the intrinsic-conformance predicate, the witness
// materializer, and the impl installer must all spell it the same. It MUST equal
// `primitiveTypeTagName(ValueTypeTag.integer)` — the one place a resolved `integer` is rendered to a name.
export let IntConformerName = b"int"

// ⭐ **THE COMPILER'S OWN SYNTHESIZED RANGED INT ALIASES — the names that erase to `integer` without
// appearing in ANY alias registry.** `HashValue` is the declared result type of the synthesized
// `Hashable.hash()` (`builtinInterface`), and shv2 reads no stdlib, so its `typealias HashValue =
// int(0 to u32.max)` is nowhere a reader can look it up: every reduction that goes THROUGH an alias
// registry answers "not an alias" and leaves the name nominal.
//
// TWO readers reduce a `named` type that way, and they must not answer differently:
//
//   • `TypeResolution.resolveNamedType` — erases it to `integer`, or every user `hash() returns HashValue`
//     is E3011. It has known this since P1.7a slice 2a.
//   • `Parser.rangedAliasTag` — the parse-time reduction the direct builtin-conformance dispatch classifies
//     a receiver by (`builtinConformerOfType`).
//
// ⚠ **MEASURED: THEY DID DISAGREE.** The parser's copy knew only the registry, so `i.hash()`'s own result —
// a `HashValue`, i.e. an int — was not an int to it, and `i.hash().hash()` was **E2015 "Unsupported: .
// statement"** on a program the language has no rule against, while the header of `rangedAliasTag` named
// `HashValue` as one of the four spellings that reduce to ONE conformer. The `→ integer` half of the fact
// is stated in this function's NAME, which is what both readers now spell instead of the erasure.
//
// ⭐ **`Codepoint` JOINS IT AT P1.8 SLICE E, FOR EXACTLY THE STATED REASON AND NOT A NEW ONE.** It is
// declared `export typealias Codepoint = int(0 to 1114111)` in `stdlib/Character.maxon` — a module shv2
// CANNOT load, because it declares `type Character` and `Character` is a name this compiler owns
// (`isCompilerOwnedTypeName`; measured: whitelisting it is one `E3005 Cannot return 'struct' from function
// declared to return 'Character'` at its own `static function init`). So the alias is in no registry for
// the same reason `HashValue` is in none, and the same two readers have to answer for it. It is what
// `stdlib/helpers/string/utf16.maxon` — the module the whitelist DOES load for this slice — spells its
// codepoint parameters and `utf16DecodeSurrogates`'s result as; without this it is `E3011 Unknown type
// 'Codepoint'` five times over, which is the ONLY thing that stood between that file and compiling.
//
// ⚠ The erasure DROPS THE RANGE. On the ARGUMENT side that costs nothing, because a REGISTRY alias's
// range is dropped at this door too (`resolveNamedType`'s alias arm returns `alias.underlying`,
// width-free): MEASURED on the unmodified compiler with a real `typealias Codepoint = int(0 to 1114111)`
// in scope, `utf16Width(2000000)` compiles clean — shv2 does not range-check an argument against its
// parameter's declared alias at all. A user's OWN `typealias Codepoint` also keeps its range wherever
// ranges ARE enforced, because those readers ask `aliasOf`, which still finds the declaration (measured:
// `500 as Codepoint` under a user `typealias Codepoint = int(0 to 10)` is E3005, naming `Codepoint`).
//
// ⚠⚠ **BUT "INDISTINGUISHABLE TO EVERY CHECK THAT EXISTS" IS NOT TRUE OF THE *RETURN* SIDE, AND THAT
// ASYMMETRY IS LIVE INSIDE ONE STDLIB MODULE** (found at the P1.8 Slice E review). `insertRangeChecks`
// guards a RETURN through a ranged alias, and it can only find a range a REGISTRY holds. So in
// `stdlib/helpers/string/utf16.maxon`, a precondition violation is loud through one alias and silent
// through the other: `utf16LeadSurrogate(1000000000)` — declared `returns CodeUnit16`, a registry alias —
// panics `Range check failed: value outside typealias 'CodeUnit16'` (pinned by
// `specs-shv2/string-views.md`), while `utf16DecodeSurrogates(0, low: 0)` — declared `returns Codepoint`,
// this synthesized one — MEASURED returns **-56613888**, a negative number wearing a type whose declared
// range starts at 0. Both are documented precondition violations and neither reference would compute
// anything better, but only one of them says so. Closing it means giving a synthesized alias its RANGE
// and not merely its erasure, which is `HashValue`'s question too (`int(0 to u32.max)`, same silence) and
// therefore its own rung rather than a line here.
export function isSynthesizedIntAliasName(name ByteArray) returns bool
	return name.equals(HashValueTypeName)
end 'isSynthesizedIntAliasName'

// The canonical conformer name of the managed concrete `String` — the twin of `IntConformerName` for the
// String intrinsic conformance (P1.7b). It keys `String`'s witness tables (`__witness_String.*`) and its
// synthesized `String.hash`/`String.equals` impls, and it MUST equal
// `primitiveTypeTagName(ValueTypeTag.string)` — the one place a resolved `string` argument is rendered to a
// name (`conformerTypeArgName` -> `mangleTypeArg` -> `primitiveTypeTagName`), so the conformance answer, the
// witness-table label, and the impl symbol cannot drift on how they spell it.
//
// ⭐ **IT IS ALSO THE SPELLING `Parser.parseTypeReference` RECOGNIZES IN A TYPE POSITION (W1 review).** It had
// a second constant for that — a `StringBuiltinName = b"String"` in `Parser.maxon` — which is what
// `BoolConformerName` below forbids in so many words, and the two sides of one question: `parseTypeReference`
// decides that `String` in a type position IS the builtin, and `builtinTypeNameTag` decides that a stored
// `String` is. Those must be the same name or a rendered signature and a type reference stop agreeing.
export let StringConformerName = b"String"

// The canonical conformer name of the primitive `float` (P1.7a slice 2b-iii) — the key of its synthesized
// `float.equals`/`float.compare` impls, and, like its two siblings, it MUST equal
// `primitiveTypeTagName(ValueTypeTag.float)`.
export let FloatConformerName = b"float"

// The canonical conformer name of the managed concrete `Character` (P1.8 Slice D) — the key of its
// `__witness_Character.*` tables and its synthesized `Character.hash`/`Character.equals` impls, and, like
// every sibling above, it MUST equal `primitiveTypeTagName(ValueTypeTag.character)`.
//
// ⚠ **IT IS A SEPARATE CONFORMER FROM `String` EVEN THOUGH THE TWO IMPLS ARE THE SAME GRAPH.** A
// `Character` and a `String` share the fused byte record (`TypeRules.tagIsByteRecord`), so hashing and
// comparing them is byte-for-byte the same work — and `installBuiltinConformanceRuntime` builds both
// pairs from the SAME two builders for exactly that reason. What may not be shared is the SYMBOL: a
// witness slot is stamped `qualifiedMethodName(<conformer>, <method>)` from the conformer the TYPE
// ARGUMENT reduces to, and a `Set with Character` reduces to `Character`. Pointing it at `String.hash`
// would mean a program using only Character keys links a symbol whose name says String, and the day the
// two representations diverge the mistake would be silent.
//
// ⭐ It is ALSO the type-position spelling `Parser.parseTypeReference` recognizes, and the name a `for c in s`
// element binds under in a diagnostic — for `StringConformerName`'s reason above, and it replaced a second
// `CharacterBuiltinName = b"Character"` constant in `Parser.maxon` at the same time (W1 review).
export let CharacterConformerName = b"Character"

// The canonical conformer name of the primitive `bool` (P1.7a slice 2b-iii) — the key of its synthesized
// `bool.compare` impl, and it MUST equal `primitiveTypeTagName(ValueTypeTag.boolean)`. It doubles as the
// rendered spelling of `Equatable.equals`'s `bool` RESULT type (`builtinInterface`), which is the same fact
// and so must not become a second constant.
export let BoolConformerName = b"bool"

// ⭐ **THE INTRINSIC BUILTIN-TYPE CONFORMANCES (P1.7a slices 2b/2b-ii/2b-iii + its last slice, + P1.7b) —
// the SINGLE source of "does a builtin type conform to this protocol?"** The primitives `int`/`float`/`bool`
// AND the managed concrete `String` conform with NO user `implements`: shv2 synthesizes their
// `int.hash`/`int.equals`/`int.compare`, `float.hash`/`float.equals`/`float.compare`, `bool.compare` and
// `String.hash`/`String.equals` impls natively (the type-side twin of the synthesized
// `Hashable`/`Equatable`/`Comparable` interfaces), so
// `Box with Integer where T is Hashable`, `Pair with Integer where T is Comparable` and `Box with String
// where T is Hashable and Equatable` are legal and their witness slots resolve to real `.text` symbols.
// `typeConformsTo` ORs this with the user registry, and the install-need decision reads it too, so the E3017
// answer, the witness table, and the synthesized-impl set cannot drift. `typeName` is the CANONICAL conformer
// name (`Integer` already collapsed to `int`; a `String` argument already named `String`). `String` is a
// MANAGED type, not a primitive — hence the neutral "builtin" spelling.
//
// ⚠ **THE TABLE IS DELIBERATELY RAGGED, and each hole is a mechanism that does not exist rather than an
// oversight** — which is why the interface test is per conformer rather than one shared disjunction:
//
//   • **`String` is NOT `Comparable`** — a byte record has no ordering, and neither reference compiler gives
//     it one (`stdlib/String.maxon:34` lists `BuiltinStringLiteral, Hashable, Equatable, Iterable,
//     Cloneable`, and no extension adds `Comparable`).
//   • **`bool` is NEITHER `Hashable` NOR `Equatable`** — both reference compilers omit them (`bool` arrays
//     bit-pack, `specs/primitive-hashable.md:13`), and the canonical corpus contains no `bool.hash`/
//     `bool.equals` case at all, positive or negative.
//   • **`Character` is NOT `Comparable`** — the reference's `Character` declares `Hashable, Equatable,
//     Cloneable` and no ordering, the same hole `String` has above.
//
// ⭐ **DIRECT DISPATCH ON A CONCRETE VALUE (`i.compare(j)`, `i.hash()`, `f.equals(g)`) SHIPS**, and it is
// gated on THIS predicate — see `builtinConformerMethod` below and `Parser.dispatchBuiltinConformanceMethod`.
// So a receiver whose type has no intrinsic conformance gets a diagnostic instead of a call to a symbol
// nothing installs, and the parser's dispatch, the E3017 conformance answer and the installed impl set
// cannot drift: they are one function's three readers.
//
// Still deliberately excluded: direct dispatch on a `String` VALUE (`s.hash()` — a String receiver is routed
// to `parseStringMethodCall` before the conformer classifier is asked). (`Set`-with-`String` keys SHIP,
// P1.7b, riding exactly this `String` Hashable/Equatable answer.)
export function isIntrinsicBuiltinConformance(typeName ByteArray, interfaceName ByteArray) returns bool
	if typeName.equals(IntConformerName) 'int'
		return interfaceName.equals(HashableInterfaceName) or interfaceName.equals(EquatableInterfaceName) or interfaceName.equals(ComparableInterfaceName)
	end 'int'
	if typeName.equals(StringConformerName) 'string'
		return interfaceName.equals(HashableInterfaceName) or interfaceName.equals(EquatableInterfaceName)
	end 'string'
	// A `Character` conforms exactly where a `String` does, and for the same reason: both ARE the fused
	// byte record, so both hash their bytes and compare them. It is NOT `Comparable` — the reference's
	// `Character` declares `Hashable, Equatable, Cloneable` and no ordering (`stdlib/Character.maxon`), the
	// same hole `String` has one line up.
	if typeName.equals(CharacterConformerName) 'character'
		return interfaceName.equals(HashableInterfaceName) or interfaceName.equals(EquatableInterfaceName)
	end 'character'
	if typeName.equals(FloatConformerName) 'float'
		return interfaceName.equals(HashableInterfaceName) or interfaceName.equals(EquatableInterfaceName) or interfaceName.equals(ComparableInterfaceName)
	end 'float'
	if typeName.equals(BoolConformerName) 'bool'
		return interfaceName.equals(ComparableInterfaceName)
	end 'bool'
	return false
end 'isIntrinsicBuiltinConformance'

// --- Direct dispatch on a CONCRETE value (`i.compare(j)`) ---

// The builtin conformer a receiver's RESOLVED value tag dispatches under, or `notAConformer` when that tag
// has none.
//
// ⚠ **PAYLOAD-FREE ON PURPOSE, AND THE REASON IS MEASURED.** The obvious shape is a union carrying the
// conformer's NAME (`conformer(typeName ByteArray)`), and it was written that way first. But this is asked
// on the PER-METHOD-CALL path — `Parser.parseMethodCall` classifies every receiver that is not a String,
// Array or Set, and the postfix loop classifies every value a `.` follows — and a union with an associated
// value is heap-BOXED, so that shape allocated a 16-byte box at every one of those sites, including the
// overwhelming majority (a plain struct receiver) whose answer is "no conformer at all". `scale-test` read
// it as the WHOLE of this feature's per-rung cost: +32/+64/+128/+256/+512/+1,024 allocations across the
// doubling ladder, exactly one per struct-method call site in the corpus, in `phase:parse` and nowhere
// else. A payload-free enum is a scalar, so the classification is free and only a dispatch that is going
// to HAPPEN pays for a name (`builtinConformerName`).
export enum BuiltinConformer
	notAConformer
	intConformer
	floatConformer
	boolConformer
end 'BuiltinConformer'

// ⭐ **THE BUILTIN CONFORMER A RESOLVED VALUE TAG CARRIES** — the ONE place a receiver's TYPE becomes the
// conformer the intrinsic-conformance answer and the impl symbol are keyed by.
//
// The caller resolves ranged ALIASES to their underlying tag first (`Parser.rangedAliasTag`), exactly as
// `ProgramSignatures.conformerTypeArgName` reduces a witness type ARGUMENT — so `Integer`, `Byte` and a bare
// `int` all arrive here as `integer` and all dispatch `int.*`.
//
// ⚠ **EVERY OTHER TAG ANSWERS `notAConformer`, INCLUDING TAGS THAT WILL LATER HAVE ONE.** `string` is
// routed to `parseStringMethodCall` before this is asked, so admitting it here would name a symbol nothing
// installs — a link-time panic in place of a clean diagnostic. A tag joins this map when its impl does.
//
// ⚠ A tag admitted here answers for the CONFORMER, not for a method: `bool` carries `compare` and NEITHER
// `hash` NOR `equals`, and that hole is `isIntrinsicBuiltinConformance`'s to state — `builtinConformerMethod`
// reads it and turns `b.hash()` into a positioned reject.
export function builtinConformerOfTag(tag ValueTypeTag) returns BuiltinConformer
	if tag == ValueTypeTag.integer 'int'
		return BuiltinConformer.intConformer
	end 'int'
	if tag == ValueTypeTag.float 'float'
		return BuiltinConformer.floatConformer
	end 'float'
	if tag == ValueTypeTag.boolean 'bool'
		return BuiltinConformer.boolConformer
	end 'bool'
	return BuiltinConformer.notAConformer
end 'builtinConformerOfTag'

// Does `conformer` carry a builtin conformance at all? The gate BOTH dispatch paths open with (a binding
// receiver in `parseMethodCall`, a value receiver in the postfix loop), named once so the two cannot come
// to disagree about it, and written as a comparison rather than a per-variant match so a conformer added
// above is admitted by both paths without an edit here.
export function isBuiltinConformer(conformer BuiltinConformer) returns bool
	return conformer != BuiltinConformer.notAConformer
end 'isBuiltinConformer'

// ⭐ **THE CANONICAL NAME A CONFORMER IS KEYED BY** — the key of the intrinsic-conformance answer, of the
// `__witness_<conformer>.*` tables and of the `<conformer>.<method>` impl symbols, so a direct dispatch and a
// witness dispatch on the same type reach the same body. Each name's own header states the invariant this
// rests on: it MUST equal `primitiveTypeTagName` of the tag it answers for, i.e. `int`/`float`/`bool` are
// what resolved `integer`/`float`/`boolean` tags are called everywhere in the compiler.
//
// Fetched only where a name is actually spelled — a dispatch that is going to be emitted, or a diagnostic
// naming the receiver's type — never on the classification path. The match is EXHAUSTIVE, so a conformer
// added to `BuiltinConformer` fails to compile here until it is given its name, which is the check that
// keeps this map and the tag map above from drifting apart.
//
// It PANICS on `notAConformer` for `requireBuiltinInterface`'s reason: only a caller the gate above has
// already admitted may ask for a name, so a miss is a driver invariant violation rather than user input.
export function builtinConformerName(conformer BuiltinConformer) returns ByteArray
	match conformer 'c'
		intConformer then return IntConformerName
		floatConformer then return FloatConformerName
		boolConformer then return BoolConformerName
		notAConformer then panic("builtinConformerName: asked for the name of a value that carries no builtin conformance — every caller is gated on `isBuiltinConformer`, so the gate and the name must read one classifier")
	end 'c'
end 'builtinConformerName'

// ⭐ **IS `name` A SYMBOL ONLY THE DIRECT BUILTIN-CONFORMANCE DISPATCH CAN HAVE MINTED?** The second half
// of `MmRuntime.isCompilerInternalCallee`, and the reason that predicate needed one: a synthesized impl is
// compiler-owned but wears NO `__` prefix — it carries a real `.text` symbol so a witness-table reloc can
// name it (BuiltinConformanceRuntime's header) — so the prefix test cannot see it, and every reader that
// asks "is this the compiler's own callee?" was answering `false` for `int.compare`.
//
// **It is a QUALIFIER test, and the qualifier is the whole soundness argument.** `int`, `float` and `bool`
// are KEYWORDS (`Lexer.keywordTable`), so no user type may be declared under one and no user method symbol
// can ever wear `int.`/`float.`/`bool.` — every callee under those qualifiers is one the compiler minted.
// That is why no method LIST is needed here and why one must not be added: the fact being stated is *"these
// primitive qualifiers belong to the compiler"*, which is one fact, where "and these three methods" would be
// a second copy of `builtinConformerMethod`'s answer.
//
// ⚠ **`String.` IS DELIBERATELY ABSENT AND MUST STAY SO UNTIL DIRECT STRING DISPATCH SHIPS.** `String` is
// NOT in `TypeResolution.isCompilerOwnedTypeName`, so a user `type String` with its own `hash()` legitimately
// owns the symbol `String.hash` — admitting it here would route a genuine user call past arity validation and
// signature slotting, and would make `Parser.requireCalleeIsNotReservedName` reject a legal
// `String.hash(…)` static call outright. The builtin `String.hash`/`String.equals` impls are reached ONLY
// through witness relocs, which never consult this predicate.
//
// The conformers listed here are exactly those `builtinConformerOfTag` can return, because those are the
// only qualifiers the parser can emit a direct dispatch under. A tag joins that map and this one together.
export function isBuiltinConformanceImplName(name ByteArray) returns bool
	return isQualifiedUnderTypeName(name, typeName: IntConformerName) or isQualifiedUnderTypeName(name, typeName: FloatConformerName) or isQualifiedUnderTypeName(name, typeName: BoolConformerName)
end 'isBuiltinConformanceImplName'

// The protocol method a builtin conformer supplies under a given name, or `notSupplied`.
export union BuiltinConformerMethodLookup
	supplied(method InterfaceMethodSig)
	notSupplied
end 'BuiltinConformerMethodLookup'

// The protocols a BUILTIN type can intrinsically conform to — the only interface names
// `isIntrinsicBuiltinConformance` ever answers `true` for, listed once so the method search below covers
// exactly the set that predicate admits and not one name more.
function builtinConformableProtocolNames() returns ByteArrayArray
	var names = ByteArrayArray.create()
	names.push(HashableInterfaceName)
	names.push(EquatableInterfaceName)
	names.push(ComparableInterfaceName)
	return names
end 'builtinConformableProtocolNames'

// ⭐ **THE METHOD A DIRECT `<value>.<name>(…)` DISPATCH RESOLVES TO ON A BUILTIN CONFORMER** — searched
// through the conformer's INTRINSIC conformances, so the method set is DERIVED from
// `isIntrinsicBuiltinConformance` plus the synthesized protocol declarations rather than listed a second
// time. Two consequences are the point:
//
//   • the parser cannot route a method the installer will not install (`int.compare` resolves because `int`
//     conforms to `Comparable`; a `Comparable`-less conformer's `.compare()` simply is not found), and
//   • the returned `InterfaceMethodSig` carries the method's NAME (which spells the impl symbol), its
//     formal TYPES (which the `Self`-argument check reads) and its RETURN TYPE (which types the call's
//     result) — all three fetched off the one declaration instead of respelled at the dispatch site, the
//     same "fetch, don't describe" rule `requireBuiltinInterface` exists for.
export function builtinConformerMethod(typeName ByteArray, methodName ByteArray) returns BuiltinConformerMethodLookup
	for protocolName in builtinConformableProtocolNames() 'eachProtocol'
		if not isIntrinsicBuiltinConformance(typeName, interfaceName: protocolName) 'doesNotConform'
			continue
		end 'doesNotConform'

		let iface = requireBuiltinInterface(protocolName)
		let methodIndex = interfaceMethodIndex(iface, methodName: methodName)
		if methodIndex < iface.methods.count() 'declaresMethod'
			return BuiltinConformerMethodLookup.supplied(try iface.methods.get(methodIndex) otherwise panic("builtinConformerMethod: methods.get OOB at {methodIndex} below count {iface.methods.count()} for protocol '{String.from(protocolName)}'"))
		end 'declaresMethod'
	end 'eachProtocol'

	return BuiltinConformerMethodLookup.notSupplied
end 'builtinConformerMethod'

// ⭐ **THE METHODS A BUILTIN CONFORMER ACTUALLY SUPPLIES, RENDERED** — what the reject for a method it does
// NOT supply prints. DERIVED from the very walk `builtinConformerMethod` searches, so a diagnostic can never
// advertise a method the dispatch would then fail to find. That is not hypothetical: the reject used to name
// "`hash`, `equals` and `compare`" as a fixed list, which became a WRONG answer the moment a conformer with
// a ragged conformance row arrived — `b.hash()` would be told `bool` supplies `hash` while
// `isIntrinsicBuiltinConformance` withholds `Hashable` from it (see that predicate's ragged-table warning).
// The row that first made this concrete was `float`, which had `equals`/`compare` and no `hash`; `float` is
// fully `Hashable` now, and the derivation is what let that change land here with no edit at all.
export function builtinConformerMethodNames(typeName ByteArray) returns String
	var rendered = ""
	for protocolName in builtinConformableProtocolNames() 'eachProtocol'
		if not isIntrinsicBuiltinConformance(typeName, interfaceName: protocolName) 'doesNotConform'
			continue
		end 'doesNotConform'

		let iface = requireBuiltinInterface(protocolName)
		for method in iface.methods 'eachMethod'
			if not rendered.isEmpty() 'separator'
				rendered = "{rendered}, "
			end 'separator'
			rendered = "{rendered}`{String.from(method.name)}`"
		end 'eachMethod'
	end 'eachProtocol'
	return rendered
end 'builtinConformerMethodNames'
