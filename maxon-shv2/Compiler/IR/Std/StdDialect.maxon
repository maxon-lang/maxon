// Std Dialect — mid-level IR. The width/ABI-resolved tier between the
// source-proximate Maxon dialect and the target-specific dialects (x64/arm64).
// All mid-level optimization passes (mem2reg, canonicalize, cse, licm, dce, …)
// run here, and so do the machine-level passes (instruction scheduling,
// coalescing) that v1 ran on a separate MIR tier.
//
// **DELIBERATE DIVERGENCE FROM v1: there is no MIR tier.** v1 ran
// Maxon → Std → MIR → Target; shv2 runs Maxon → Std → Target. v1's `lowerStdToMir`
// was ~90% a mechanical 1:1 rename — Std's `ValueId`s ALREADY ARE the infinite
// virtual registers MIR claimed to introduce, so the tier bought no new value
// model. Its only real content was desugaring a handful of Std-only ops, which
// is a Std→Std rewrite (`lowerToMachineForm`, see the `sugar` band below), not a
// tier. Deleting the tier drops a whole module copy from peak RSS and removes a
// boundary that had already started hiding drift in v1 (`MirOp.movReg` survived
// with zero construction sites because the tier wall made it invisible).
//
// **`StdOp` IS FLAT.** v1 nested it as `StdOp.arith(StdArithOp.const(StdArithConst))`
// — an artifact of a migration that did not want to touch every pass, not a
// design (v1's own StdDialect header says so). Nesting is expensive here: Maxon
// heap-boxes and refcounts every payload-carrying union case, so each nesting
// level is another heap object. That 3-boxes-per-op shape, on the most numerous
// object in the compiler, is a first-order cost — roughly half of v1's
// self-compile cycles go to memory-management churn. Flat = ONE box per op.
//
// Coarse membership ("is this any kind of call?") is recovered WITHOUT nesting by
// the `StdOpMeta` struct backing every variant carries — the same idiom
// MaxonDialect already uses and justifies. The backing is REQUIRED by the
// language, so a new variant cannot be added without declaring its category,
// role, and inline policy here.
//
// THIN for maxon-shv2 M1: carries the shapes the `return 42` slice lowers to —
// the full `StdType` classification (needed everywhere: block-arg types, function
// signatures) plus the `const` and `ret` ops. Later milestones GROW `StdOp` with
// the arith-unary/binary (M3), control-flow (M4), call/param (M5), and memory
// (M6) variants.

// --- CastCategory: coarse type family for cast validation ---
// Kept whole (int/float/bool/string/cstring) even though M1 only produces
// int/bool — the StdType backing values below reference every family, and the
// call-site type checker (Chunk B) needs the full set to reject mismatches.
enum CastCategory
	int
	float
	bool
	string
	cstring
end 'CastCategory'

// --- StdTypeInfo: metadata carried by each StdType case ---
export type StdTypeInfo
	export let isFloat as bool
	// ⭐⭐ **DOES THIS TYPE READ ITS TOP BIT AS A VALUE BIT RATHER THAN A SIGN?** — the fact that makes
	// `StdType` able to answer a COMPARISON's condition-code family, which is the one question about a
	// compare that this tier cannot re-derive (see `lowerCompare`, and `stdTypeIsUnsigned` below).
	//
	// ⚠ **IT IS NOT A WIDTH FACT AND IT IS NOT A STORAGE FACT.** Every integer here occupies a full GPR
	// and every arithmetic op but four is bit-identical in both readings — `add`, `sub`, `mul`, and the
	// bitwise family answer the same for `u64.max` whether you call it `-1` or `18446744073709551615`.
	// The four that are NOT are the ORDERING comparisons, which is why this bit exists at all: `3 < -1`
	// and `3 < 18446744073709551615` are opposite answers to one instruction pair, chosen by `jl` or
	// `jb`. (Division reads its own `IntegerSignedness` field for the same reason one op earlier; the two
	// are the same FACT arriving by two routes, because `div` carries no `operandType` to put it on.)
	//
	// It rides the per-case backing for the reason `storageBytes` does: a signedness table beside the
	// enum would be a second declaration of the enum, free to omit a case the day one is appended.
	export let isUnsigned as bool
	export let castCategory as CastCategory
	// The type's footprint IN MEMORY, in bytes — what a `.data` slot of it occupies and
	// what `loadIndirect`/`storeIndirect` transfer. NOT its width in a register: an `i1`
	// lives in a full 64-bit GPR but occupies ONE byte of storage, which is exactly what
	// `specs/static-variables.md`'s `data-section-bool-1byte` pins.
	//
	// It rides the per-case BACKING rather than a `match` in a helper for the reason every
	// other fact here does: a size table beside the enum is a second declaration of the
	// enum, free to omit a case the day one is appended. Here a new case cannot be added
	// without stating its size.
	export let storageBytes as ByteCount
end 'StdTypeInfo'

// --- StdType: ABI/width-level type classification ---
// Each case carries a StdTypeInfo backing value encoding whether the type lives
// in a floating-point register, which cast family it belongs to, and how many
// bytes it occupies in memory.
export enum StdType
	i1 = StdTypeInfo{isFloat: false, isUnsigned: false, castCategory: CastCategory.bool, storageBytes: 1}
	i8 = StdTypeInfo{isFloat: false, isUnsigned: false, castCategory: CastCategory.int, storageBytes: 1}
	i16 = StdTypeInfo{isFloat: false, isUnsigned: false, castCategory: CastCategory.int, storageBytes: 2}
	i32 = StdTypeInfo{isFloat: false, isUnsigned: false, castCategory: CastCategory.int, storageBytes: 4}
	i64 = StdTypeInfo{isFloat: false, isUnsigned: false, castCategory: CastCategory.int, storageBytes: 8}
	u8 = StdTypeInfo{isFloat: false, isUnsigned: true, castCategory: CastCategory.int, storageBytes: 1}
	u16 = StdTypeInfo{isFloat: false, isUnsigned: true, castCategory: CastCategory.int, storageBytes: 2}
	u32 = StdTypeInfo{isFloat: false, isUnsigned: true, castCategory: CastCategory.int, storageBytes: 4}
	u64 = StdTypeInfo{isFloat: false, isUnsigned: true, castCategory: CastCategory.int, storageBytes: 8}
	f32 = StdTypeInfo{isFloat: true, isUnsigned: false, castCategory: CastCategory.float, storageBytes: 4}
	f64 = StdTypeInfo{isFloat: true, isUnsigned: false, castCategory: CastCategory.float, storageBytes: 8}
end 'StdType'

export function stdTypeIsFloat(t StdType) returns bool
	return t.rawValue.isFloat
end 'stdTypeIsFloat'

// ⭐ **THE TWIN OF `stdTypeIsFloat`, AND THE COMPARISON LOWERING'S SECOND QUESTION.** Read where a
// condition-code family is chosen (x64's `condCodeForPred`, arm64's `arm64CondForPred`, wasm's
// `emitCmpPred`) and nowhere else: every other consumer of an integer `StdType` wants its WIDTH or its
// storage, both of which the signed and unsigned spellings share. A float is never unsigned — the two
// bits are disjoint, not a hierarchy — so a reader asking both questions gets `isFloat` first, exactly
// as those three do.
export function stdTypeIsUnsigned(t StdType) returns bool
	return t.rawValue.isUnsigned
end 'stdTypeIsUnsigned'

// ⭐⭐ **THE UNSIGNED SPELLING OF AN INTEGER `StdType` — the ONE table that turns the front end's
// signedness verdict into the `operandType` a compare carries** (`LowerMaxonToStd.lowerCompare`).
//
// ⚠ **IT IS A RELABELLING, NEVER A CONVERSION.** The value in the register does not move: `u64` and
// `i64` are the same 64 bits and the same GPR, and what changes is only which condition codes read the
// flags a `cmp` of them writes. That is why it must preserve WIDTH exactly — an `i32` operand relabelled
// `u64` would compare a half-register against a whole one — and why the float arms panic rather than
// answering: `ucomisd` has no signedness, so a caller that reached here with one has already decided
// something this cannot express.
// ⭐⭐ **THE SIGNED SPELLING OF AN INTEGER `StdType`, AND A FLOAT'S OWN TYPE UNCHANGED.**
//
// ⚠ **THE FLOAT ARM IS THE ASYMMETRY WITH `unsignedStdTypeOf`, AND IT IS DELIBERATE.** These two are
// not a mirrored pair: `signed` is the answer `comparisonSignedness` gives a FLOAT compare — there is
// no third verdict for "has no signedness", because the two families a float can take are already
// decided by `isFloat` one question earlier — so every float compare arrives HERE and its type must
// survive intact (arm64's `arm64RequireScalarDouble` and wasm's `requireF64` read it). Nothing can
// arrive at `unsignedStdTypeOf` the same way, which is why that one panics on a float and this one
// must not.
export function signedStdTypeOf(t StdType) returns StdType
	return match t 'u'
		i1 to i64 gives t
		u8 gives StdType.i8
		u16 gives StdType.i16
		u32 gives StdType.i32
		u64 gives StdType.i64
		f32 to f64 gives t
	end 'u'
end 'signedStdTypeOf'

// The twin of the above. See `lowerCompare` for why BOTH exist rather than only this one: a compare's
// `operandType` carries the PAIR's verdict, so it must be normalized in both directions — an operand
// that already reads `u32` (every `ExitCode`) must be spelled `i32` when the pair's verdict is signed,
// or the backend would read a second, one-sided answer out of the type and disagree with the front end.
export function unsignedStdTypeOf(t StdType) returns StdType
	match t 'u'
		i1 then panic("unsignedStdTypeOf: i1 is a BOOL — it holds 0 or 1, so its two readings agree on every value and no rule can ask for one. Reaching here means a front end decided a bool comparison was unsigned, which `comparisonOperandsAreUnsigned` cannot say: a bool declares no ranged alias, so both its operands read `signed`")
		i8 then return StdType.u8
		i16 then return StdType.u16
		i32 then return StdType.u32
		i64 then return StdType.u64
		u8 to u64 then return t
		f32 to f64 then panic("unsignedStdTypeOf: a FLOAT compare has no signedness — `ucomisd` answers in ZF/PF/CF whatever the operands' signs — so the front end must never route one here (`comparisonSignedness` gates it)")
	end 'u'
end 'unsignedStdTypeOf'

// ⭐⭐ **WHICH READING OF A 64-BIT PATTERN AN INSTRUCTION TAKES — the ONE property of the three operator
// families whose answer it changes that is not derivable from anything at this tier.** The Std tier is
// TYPELESS about signedness: an i64 here is 64 bits and nothing more, so a pass that met a bare `div`
// would have no way left to ask which reading was meant. The answer is a FRONT-END fact, decided once
// from both operands' declared ranges (`TypeRules`' ⭐⭐ THE DIVISION SIGNEDNESS RULE and its ⭐⭐
// ORDERING-COMPARISON twin) and carried down on the op.
//
// ⚠ **IT WAS `DivideSignedness` AND THE DIVIDE IS NO LONGER ITS ONLY READER** — three families read it
// now, and each is a place where one bit pattern has two honest answers: the DIVIDE (`idiv` vs `div`),
// the DECIMAL RENDERER (`-1` vs `18446744073709551615`, X11), and the four ORDERING COMPARISONS (`jl`
// vs `jb`). The renaming is not cosmetic: a reader of `MaxonOp.compare`'s field who found a type named
// for division would reasonably conclude the field was in the wrong place.
//
// ⭐ **A FIELD ON `StdOp.div`/`mod`, NOT TWO MORE VARIANTS — and the reason is the band-append
// invariant, not brevity.** `shr`/`shrLogical` split into two OPCODES one tier up because the Maxon
// tier's operator is a bare enum value with nowhere for a flag to live. Here the operation is a
// VARIANT with fields, so the fact has a natural home — the same home `binOp`'s and `cmpImm`'s
// `operandType` already has. And appending two variants after `mod` would shift every ordinal past
// the arith band, where a range arm SPANNING the band boundary (`FoldConstOperands`' `binOpImm to
// retVoid` is one) would swallow them silently. A field cannot be swallowed.
//
// ⭐ It also keeps x64's fixed-register machinery keyed on ONE variant. `idiv` and `div` have the
// identical RDX:RAX operand contract, so the allocator's `implicitDefs`, the prologue's clobber scan
// and the splitter each go on seeing one op — a second variant would have had to be added to every
// one of them, and a miss there is a miscoloured register rather than a compile error.
export enum IntegerSignedness
	// x64 `idiv`, arm64 `sdiv`, wasm `i64.div_s`/`i64.rem_s`. The reading every division in the
	// language had before X10, and still the reading for every operand pair that admits a negative.
	signed
	// x64 `div` (with RDX ZEROED rather than sign-extended), arm64 `udiv`, wasm `i64.div_u`/`i64.rem_u`.
	// Reached only when BOTH operands are non-negative and at least one says so by DECLARATION.
	unsigned
end 'IntegerSignedness'

// ⭐⭐ **THE CANONICAL `StdType` OF AN ABI CLASS — so that a backend which holds only the float BIT can
// rejoin the one type→valtype door instead of restating it.** `stdTypeOfAbiClass(stdTypeIsFloat(t))` is `t`'s
// class representative, and every `StdType` in a class maps to one ABI valtype by construction, so
// `wasmMachineValTypeOf(stdTypeOfAbiClass(stdTypeIsFloat(t))) == wasmMachineValTypeOf(t)` for all eleven.
//
// ⚠ **IT EXISTS BECAUSE THE TWO ENDS OF A `call_indirect` WERE TWO STATEMENTS OF ONE RULE.** The CALLEE's
// wasm functype is derived from its declared `StdType`s (`funcParamValTypes`); the CALL SITE's was derived
// from the op's `ArgFloatMask` by a second, independent float → valtype table. The two agreed across every
// `StdType`, and nothing made them: an edit to either would have diverged silently into a run-time
// `indirect call type mismatch`, which is the one failure mode neither end can report at compile time. Now
// the bit becomes a type here and the type becomes a valtype there.
//
// ⚠ **THERE WAS A SECOND, WIDTH BIT, AND IT IS DELETED (WASM3).** `stdTypeIsNarrow` picked `u32`/`f32` for a
// sub-word argument so a `call_indirect` could name a `bool` parameter's real `i32`. A per-site width cannot
// survive ERASURE — a shared generic body declares an opaque `Element` where the callee's own declaration
// says `bool` — so the wasm ABI is the MACHINE WORD throughout, which is what the register targets always
// did and what `maxon-selfhosted`'s wasm backend does. See `StdToWasm.indirectCallArgValType`.
export function stdTypeOfAbiClass(isFloat bool) returns StdType
	return StdType.f64 if isFloat else StdType.i64
end 'stdTypeOfAbiClass'

// ⭐ **THE SHAPE A PER-ARGUMENT ABI MASK IS** — one bit per argument, low `argCount` bits meaningful,
// stored in a full machine word, ceiling `MaxAbiArgs`. It exists so that `argMaskBit`'s signature can name
// the SHAPE rather than the one mask that wears it: `ArgFloatMask` below says WHICH FACT its bits carry, and
// a reader that takes "an ABI mask" should say that. (It had a sibling, `ArgNarrowMask`; WASM3 deleted it —
// see `stdTypeOfAbiClass`.) The two are spelled over the same range rather than derived from one another
// because a typealias of a typealias is not a type this language admits (E2003) — so what makes them one
// shape is this paragraph and the identical bound, and a change to the bound belongs to both at once.
typealias ArgAbiMask = int(0 to u64.max)

// A per-ARGUMENT float bitmask carried by the three indirect-call ops (`callIndirect`, `witnessCall`,
// `witnessTryCall`) — bit k set iff argument k is a float (an f64,
// which a backend routes to a float argument register / declares as an f64 wasm valtype rather than a GPR
// i64). Only the low arg-count bits are meaningful; the storage is a full machine word. A SCALAR, so the op
// stays at one managed field (P1.5 #78 — see `callIndirect`).
//
// ⭐ **IT IS THE ONE FLOAT-VS-GPR MASK, both ends of every call.** A callee folds its declared parameter
// types into one (`floatParamMaskOf`); a caller looks the callee's up by name (`calleeArgFloatMask`) or
// reads an indirect call's off the op. Both then hand it to the SAME placement rule
// (`abiFileSlotIndex`/`abiArgIsOnStack`/`abiStackSlotsBefore`, StdLoweringShared), which is what makes
// "where does argument k go?" one answer rather than two that could disagree. It used to have a
// Targets-tier twin, `ParamFloatMask`, spelling the identical bitmask for the callee side; the twin is
// gone. The tier boundary it was protecting is one-way and already permits this direction — a Targets-tier
// lowering may name a Std typealias, and every one of them now does.
export typealias ArgFloatMask = int(0 to u64.max)

// ⛔ **THE STATED CEILING ON A SIGNATURE'S ARGUMENTS — and it is THIS MASK'S OWN WIDTH.** `1 shl k` must
// land inside the machine word the mask is, so a call cannot carry more than 64 arguments: bit 64 does not
// exist, and an argument past it would be classed GPR whatever its type, silently routing an f64 through
// an integer register.
//
// It is therefore DIAGNOSED rather than assumed — `Parser.requireAbiParamCount` refuses a signature past it
// with a positioned error that names this number and this reason. That is the whole difference from the cap
// it replaced: `MaxRegisterParams = 6` was not a limit of anything, only of a milestone that had not been
// built, and it refused programs the machine can run perfectly well. This one is a limit of a
// representation, and the day a program needs a 65th argument the fix is to widen the representation, which
// the diagnostic says.
export let MaxAbiArgs = 64 as ParamCount

// Bit k of a per-argument ABI mask — the one door the four backends read an indirect call's per-argument
// register file (`ArgFloatMask`) through. It takes the SHAPE (`ArgAbiMask`) rather than the one mask that
// wears it, so a second per-argument fact can be added without a second bit test being written.
export function argMaskBit(mask ArgAbiMask, argIndex ParamCount) returns bool
	return ((mask shr argIndex) and 1) != 0
end 'argMaskBit'

// How many bytes a value of `t` occupies in memory — see `StdTypeInfo.storageBytes`.
export function stdTypeStorageBytes(t StdType) returns ByteCount
	return t.rawValue.storageBytes
end 'stdTypeStorageBytes'

// --- StdReturnType: function return type (either void or a concrete StdType) ---
// Void-returning functions are `void`; value-returning functions carry the
// concrete StdType in `value`. Consumers dispatch on this union rather than
// using a sentinel StdType to mean "no return".
export union StdReturnType
	void
	value(inner StdType)
end 'StdReturnType'

export typealias StdReturnTypeArray = Array with StdReturnType

export function stdReturnTypeIsVoid(rt StdReturnType) returns bool
	return match rt 'check'
		void gives true
		value gives false
	end 'check'
end 'stdReturnTypeIsVoid'

export function stdReturnTypeIsFloat(rt StdReturnType) returns bool
	return match rt 'check'
		void gives false
		value(inner) gives stdTypeIsFloat(inner)
	end 'check'
end 'stdReturnTypeIsFloat'

// ⭐⭐ **THE Std TYPE A SYNTHESIZED ZERO PRIMARY RETURN VALUE IS BORN IN — spelled ONCE (X6 review).**
// Two passes mint such a value and neither can read the other's bits: `LowerMaxonToStd`'s THROW edge
// (`emitZeroConstOfReturnType` — the primary a caller ignores once the error flag is set) and
// `InsertRangeChecks`'s DEAD return after `mrt_panic` (`emitDeadReturn` — a block that never runs but
// must still leave the function the way the ABI says).
//
// ⛔ **THEY HAD TWO DIFFERENT RULES FOR IT, AND THAT IS THE DIVERGENCE THIS FUNCTION ENDS.** Lowering
// coarsened the answer to `f64`-or-`i64` because all it believed it owed was the REGISTER FILE; the
// range-check pass read the declared type straight off `returnType`. Both satisfy the register-file
// obligation, so nothing ever failed — which is exactly the shape that makes the next clause added to
// one of them a wrong answer at the other with no compile error at either. The DECLARED type is the
// stricter of the two and is right wherever the coarse one was: it is the same register file by
// construction, and on wasm it is the function's own result valtype instead of one needing a coercion.
//
// A VOID function still has an answer, and it is not vacuous: a void THROWING function returns through
// `errorReturn` and so writes a primary register its caller reads only for its shape. The machine word
// is the family default there.
export function stdDefaultPrimaryReturnType(rt StdReturnType) returns StdType
	return match rt 'check'
		void gives StdType.i64
		value(inner) gives inner
	end 'check'
end 'stdDefaultPrimaryReturnType'

// --- StdOpCategory: coarse op family, recovered without nesting ---
// Replaces v1's outer-union arms (`StdOp.arith(...)`, `StdOp.call(...)`, …) with
// a metadata field, so membership tests stay cheap while `StdOp` stays flat.
// Declared whole even though M1 only produces `arith` and `call` — the same
// growth-is-additive convention MaxonDialect's `OpCategory` follows.
//
// `sugar` is the load-bearing one: it names the Std-only ops that exist purely to
// be rewritten away (v1's descriptorField / witnessMethod / unboxValue / drop /
// free / …). They are eliminated by a Std→Std `lowerToMachineForm` pass before the
// backend runs — see the "sugar band" contract below.
export enum StdOpCategory
	arith
	control
	call
	memory
	system
	sugar
end 'StdOpCategory'

// The structural role an op plays in a function, where that role is a property of
// the OP rather than of its category. Replaces v1's three single-variant tag
// bools (`isRet` / `isErrorReturn` / `isParam`), which existed only so passes
// could ask "is this the return?" without a match.
enum OpRole
	plain
	ret
	errorReturn
	param
end 'OpRole'

// The Std-tier binary-operation opcodes carried by `StdOp.binOp`. A family that
// shares one operand shape (two value operands, one result) stays a single
// `binOp` variant with this opcode field — see the StdOp header's "flat does NOT
// mean one variant per opcode" rule. M2 landed `add`; M3 grew the rest of the
// non-trapping integer ALU ops (`sub`, `mul`). A compare still splits out as its
// OWN variant (it sets `isCmp` — different metadata the per-variant backing cannot
// reach through an opcode field) when `if` lands at M4; the trapping `div`/`mod`
// (which set `isPure: false`) arrive at M5 with the real register allocator.
// P1.0d.2 appends the BIT band — `bitAnd`/`bitOr`/`bitXor`/`shl`/`shr`. They share
// `binOp`'s exact operand shape (two values in, one out) and its exact metadata
// profile (pure, non-trapping, flag-clobbering), so per the header's "flat does NOT
// mean one variant per opcode" rule they are opcodes, not variants.
//
// The RIGHT SHIFT is TWO opcodes, and it has to be. A Std value is a typeless i64 — it
// carries no signedness — so this tier cannot ask which way a right shift fills; it can
// only be TOLD. `shr` is ARITHMETIC (x64 `sar`, sign-replicating) and `shrLogical` is
// LOGICAL (x64 `shr`, zero-filling), and the Maxon tier picks between them from the
// left operand's declared type (TypeRules' ⭐ THE SHIFT RULE — Go's rule: a signed left
// operand shifts arithmetically, an unsigned one logically). Collapsing them into one
// opcode is what made `u64.max shr 60` answer -1 in shv2 and 15 in the bootstrap.
//
// P1.0d.4 appends `div` — and it is FLOAT-ONLY, which looks like an exception and is not.
// The band's membership rule is its METADATA profile, and the rule that keeps the trapping
// integer `div` out is `isPure: false`: `idiv` faults on a zero divisor (and on
// `i64.min / -1`), so it must not be reordered or eliminated, and it needs its own variant
// to say so. `divsd` does not fault — IEEE-754 answers `inf`/`nan` instead — so float
// division is pure, non-trapping, and shares `binOp`'s exact operand shape. By the dialect's
// own rule it is an opcode, not a variant. The two divisions differ in the one property the
// band is defined by, so they land on opposite sides of it; that is the rule WORKING.
//
// ⚠ `binOp(div)` with an INTEGER `operandType` is ILLEGAL and the validator throws on it —
// it would declare a trapping instruction pure. Integer division stays `StdOp.div`.
//
// ⭐⭐⭐ `min` (specs/min.md) AND `max` (specs/max.md) ARE APPENDED PAST `div`, AS THE FLOAT-ONLY
// MEMBERS — same membership argument as `div`'s: two operands, one result, all f64, and neither can
// fault. What they do NOT share with `div` is a single agreed hardware meaning, and that is what the
// rest of this block is about. **They are ONE decision, made once, read twice**: every sentence below
// is about the PAIR, and the only thing that differs between them is which strict comparison the
// definition names.
//
// ⭐⭐ **THE DEFINITION: `min(a, b)` IS `a` WHEN `a < b`, AND `b` OTHERWISE. `max(a, b)` IS `a` WHEN
// `a > b`, AND `b` OTHERWISE.** One sentence each, and each settles NaN and signed zero at the same
// time, because a STRICT comparison is FALSE whenever either operand is NaN (IEEE-754's unordered
// rule) and FALSE for two zeros of opposite sign (they compare EQUAL). So:
//
//   min(nan, 5.0) = 5.0     min(5.0, nan) = nan     min(+0.0, -0.0) = -0.0     min(-0.0, +0.0) = +0.0
//   max(nan, 5.0) = 5.0     max(5.0, nan) = nan     max(+0.0, -0.0) = -0.0     max(-0.0, +0.0) = +0.0
//
// ⚠ The two rows are IDENTICAL, and that is the definition being honest rather than a typo: on an
// unordered or an equal-compare input the strict test is false whichever direction it points, so both
// ops answer with their SECOND operand. `min` and `max` differ only where the operands are ORDERED
// and DISTINCT — exactly the cases a program without NaNs ever sees.
//
// ⇒ **NEITHER IS COMMUTATIVE, DELIBERATELY.** That is not a defect of the definitions, it is what any
// definition reachable in one or two instructions on all three targets looks like; see below.
// `binOpcodeIsCommutative` answers `false` for both, and so does v1's `CommuteForCoalescing` for the
// same opcodes. **A pass that swaps a `binOp(min)`'s or `binOp(max)`'s operands changes its answer on
// NaN input.**
//
// ⭐⭐ **WHY THESE DEFINITIONS AND NOT IEEE'S `minimum`/`maximum` — THE THREE TARGET INSTRUCTIONS
// DISAGREE WITH EACH OTHER, AND THAT IS A MEASURED FACT ABOUT BOTH REFERENCE COMPILERS, NOT A RISK.**
// The obvious lowering is one native instruction per target, and the obvious lowering is WRONG:
//
//   • x64  `minsd`/`maxsd`     — return SRC2 when the operands are unordered OR are both zeros.
//                                They ARE `a < b ? a : b` and `a > b ? a : b`, exactly.
//   • arm64 `fmin`/`fmax`      — IEEE NaN-PROPAGATING: a NaN in either operand gives a NaN, in
//                                either order, and the signed zeros are ordered −0 < +0 either way.
//   • wasm  `f64.min`/`f64.max`— same as arm64's, and unlike x64's.
//
// **The bootstrap and v1 BOTH emit exactly those, unreconciled**, so each of them answers
// `min(nan, 5.0)` differently depending on which target it compiled for. Measured on the bootstrap's
// x64 host: `min(nan, 5.0)` is `5.0` and `min(5.0, nan)` is `nan` — the `minsd` reading; `max` reads
// the same on `maxsd`. Nothing in `specs/min.md` or `specs/max.md` exercises a NaN or a signed zero,
// so no suite on either compiler can see the split; it is a wrong answer waiting for a corpus, and
// 'both references do it' is how it survived.
//
// ⇒ **shv2 PICKS ONE MEANING AND MAKES ALL THREE TARGETS EMIT IT.** The x64 reading is the one
// picked, for three reasons, in order: it is the only one of the two that the OTHER two targets can
// reproduce EXACTLY (see the lowerings — `fcmp`+`fcsel mi`/`gt` and `f64.lt`/`f64.gt`+`select` are
// bit-for-bit the compare-and-select, whereas rebuilding NaN-propagation on x64 costs three SSE ops
// and still cannot promise a NaN PAYLOAD); it keeps shv2 bit-identical to the bootstrap on the host
// target, where the spec suite and the oracle both live; and it is one sentence a reader can
// implement, where IEEE's `minimum`/`maximum` is a table.
//
// ⚠ THE PRICE, NAMED: neither is commutative, and `min(a, b)` is not `-max(-a, -b)`. Both follow from
// a strict comparison being false on unordered, both are properties of the definitions rather than of
// any one target, and neither is observable by a program that never makes a NaN.
//
// ⚠ APPENDED AT THE END, PAST `div`, per the band-append invariant — and here that invariant did
// real work twice: every `match` over this enum that carried a `div` arm had to gain a `min` arm, and
// then every `div to min` arm had to gain `max`, because no range could swallow either.
// `div`/`min`/`max` are adjacent, so those arms mostly widened to `div to max`; that adjacency is a
// convenience of the current order and NOT the definition of the set. `stdBinOpcodeIsFloatOnly` is
// where the set is named, so a fourth float-only opcode that cannot be appended adjacent to these
// three changes that one function rather than being silently misjudged by a range whose endpoints
// happened to work.
export enum StdBinOpcode
	add
	sub
	mul
	bitAnd
	bitOr
	bitXor
	shl
	shr
	shrLogical
	div
	min
	max
	// ⭐⭐ **THE HIGH 64 BITS OF THE 128-BIT SIGNED PRODUCT — the one operation a division by a
	// compile-time constant cannot be replaced without (`EC18`, `StrengthReduceDivision`).** `n * M`
	// at 128 bits, keeping bits 64..127. x64 spells it `imul r/m64` (the ONE-operand group-3 form,
	// `TargetOp.imulHighReg`), AArch64 `SMULH`, and wasm has NO form of it at all — which is why the
	// pass that produces it asks `targetLowersMulHigh` and reduces nothing on a target that cannot
	// spell it.
	//
	// It is COMMUTATIVE and PURE — an ordinary `binOp` in every respect. It carries no signedness
	// field because there is no unsigned twin YET: the unsigned magic sequence needs a 65-bit
	// multiplier and an "add indicator" fixup this rung did not take, and inventing the opcode for it
	// now would be a case no lowering could serve. `mulHighUnsigned` is what that rung appends.
	//
	// ⚠ APPENDED AT THE END, PAST `max`, per the band-append invariant — and note it is NOT float-only,
	// so it is the first opcode since `shrLogical` that a `div to max` range arm must NOT swallow. It
	// cannot: every such arm stops at `max` and fails to compile until it names this one.
	mulHighSigned
end 'StdBinOpcode'

// ⭐⭐ **THE STD BINARY OPCODES WITH NO INTEGER FORM** — THE one place that set is stated, for the
// same reason `stdUnaryOperandIsFloat` exists beside `StdUnaryOpcode`: it is a property OF THE
// OPCODE and not of any one backend, and it already had three would-be copies.
//
// `div` is float-only because the INTEGER division that shares its spelling traps (`idiv` faults on
// a zero divisor and on `i64.min / -1`) and so needs `StdOp.div`'s own `isPure: false` — a `binOp`
// carrying it would declare a trapping instruction pure. `min`/`max` are float-only because the
// language has no integer form of either: `specs/min.md` and `specs/max.md` type them
// `(a float, b float) float` and the parser promotes both operands before emitting the op.
//
// Its one CALLER is the boundary that must not CREATE an illegal op
// (`LowerMaxonToStd.appendStdBinOp`), which is the only place the question can still be answered
// before the op exists. The three backends' integer paths refuse the same opcodes through exhaustive
// `match` arms rather than by calling this — a `match` over `StdBinOpcode` has to name them anyway,
// and an arm that named them AND asked this would be the same fact stated twice. What they take from
// here is the NAME: each panic points at this function instead of re-arguing which opcodes are
// float-only, which is what the `div`-era messages did in three different sets of words.
export function stdBinOpcodeIsFloatOnly(opcode StdBinOpcode) returns bool
	return match opcode 'k'
		add to shrLogical gives false
		div to max gives true
		// EC18's high multiply is INTEGER-ONLY, which is the opposite exception and needs its own arm:
		// there is no float 128-bit product, and `appendStdBinOp` would be right to refuse one.
		mulHighSigned gives false
	end 'k'
end 'stdBinOpcodeIsFloatOnly'

// The Std-tier unary-operation opcodes carried by `StdOp.unaryOp`. M3 lands `neg`
// (integer negate). A separate opcode set from StdBinOpcode because a unary op has
// a different operand shape (one operand, one result). Non-trapping, so `unaryOp`
// is `isPure`.
//
// P1.0d.2 appends `bitNot` (x64 `not` — flip all 64 bits) and `logicalNot` (x64
// `xor reg, 1` — flip bit 0 of a 0/1 bool). Two opcodes, not one, because they are
// two DIFFERENT instructions: `not` on a bool would produce -1/-2, which reads as
// truthy either way. The Maxon tier has already resolved which one the source `not`
// meant (see MaxonUnaryOp).
//
// ⭐⭐ P1.0d.4 appends the CONVERSION PAIR, and without it a float can neither enter
// nor leave the float domain. This is the band that makes `trunc()` — the f64→ExitCode
// bridge nearly every case in specs-shv2/float-type.md ends on — expressible at all, and
// the band that lets `5 + 2.0` promote. Both reference compilers model these as UNARY
// opcodes and shv2 follows: v1 as `StdArithUnaryOpcode.{siToFpF64, fpToSiI64}`, the
// bootstrap as `MaxonTruncOp`. A conversion has a unary op's exact shape — one operand in,
// one result out, non-trapping, pure — so per the header's rule it is an opcode, not a
// variant.
//
// ⚠⚠ THESE TWO, AND THE `bitcastF64ToI64`/`bitcastI64ToF64` PAIR APPENDED AT THE END OF THE ENUM,
// ARE THE ONLY
// OPCODES WHOSE RESULT TYPE DIFFERS FROM THEIR `operandType`, and that is the fact to hold on
// to. For `neg`/`bitNot`/`logicalNot` the two coincide, so nothing has ever had to distinguish
// them. Here they cannot: **`operandType` is always the
// SOURCE — what the instruction reads — and the OPCODE names the result.** `siToFp` reads
// an integer and produces f64; `fpToSi` reads f64 and produces an integer. Read
// `operandType` as "the result type" on these and you get exactly the wrong register file.
//
// ⚠ `siToFp` with a float `operandType`, or `fpToSi` with an integer one, is ILLEGAL — it
// would name a conversion from a type to itself, and the x64 instruction for it does not
// exist. Throw rather than emit.
//
// ⭐ `fpToSi` TRUNCATES TOWARD ZERO, and the `t` in its instruction (`cvttsd2si`, not
// `cvtsd2si`) is the whole reason it is the right one: `cvtsd2si` rounds under MXCSR's
// current mode — banker's rounding by default — so `trunc(3.99)` would answer **4**.
// The spec says 3. The two mnemonics differ by one letter and by a wrong answer.
//
// ⭐ P1.0d.4-C appends the MATH INTRINSICS — `floor`/`ceil`/`round`/`sqrt`, and (with `specs/abs.md`)
// `abs`, FIVE in all. They are the
// mirror image of the conversion pair above and the reason to read the two bands together:
// a conversion's operand and result are in DIFFERENT files, these two are in the SAME one, and
// neither is `operandType`'s naive reading. **All five read an f64 and produce an f64**, so
// `operandType` happens to name the result as well — but only because the domains coincide, and a
// table that says so must say it deliberately (see `unaryResultClass` / `unaryResultValType`,
// where they need their own arms precisely because they sit PAST `fpToSi` in this enum).
//
// Four of the five are ONE instruction on every target — x64 `sqrtsd` / `roundsd imm8`, arm64 `fsqrt` /
// `frint{n,p,m}`, wasm `f64.{sqrt,nearest,ceil,floor}`.
//
// ⚠ `abs` IS THE EXCEPTION, ON x64 ONLY, and — with `fneg`, its sign-flipping twin appended after it —
// one of the two opcodes in this enum a backend does have to SYNTHESIZE. arm64 has `fabs`/`fneg` and
// wasm has `f64.abs`/`f64.neg`; SSE2 has neither a scalar float absolute value nor a negate, so the
// x64 isel clears the sign bit with a `psllq`/`psrlq` pair (`TargetOp.absF64RegReg`, where the full
// reasoning and the divergence from both reference compilers is recorded) and flips it with an
// `xorpd` against a mask built in a scratch XMM (`TargetOp.negF64RegReg`). That is a TARGET fact and
// changes nothing here: each opcode is still f64 → f64, still non-trapping, still one operand.
//
// ⭐ `round` IS TIES-TO-EVEN (banker's rounding), which is what all three of those instruction
// families do natively and what `specs/round.md` pins (`round(2.5)` is 2). It is NOT C's `round()`.
//
// ⭐⭐ P1.7a's LAST SLICE APPENDS `bitcastF64ToI64` — the REINTERPRETATION, and the third distinct
// operand/result relationship in this enum. It is neither of the two above:
//   • the CONVERSIONS (`siToFp`/`fpToSi`) change the VALUE and the FILE — `2.9` becomes `2`;
//   • the MATH INTRINSICS change the VALUE and stay in the FILE;
//   • the BITCAST changes NEITHER the bits NOR the value's meaning to the machine — it moves the
//     SAME 64 bits from an XMM register to a GPR, so it crosses the file while computing nothing.
// It exists for `float.hash` (`BuiltinConformanceRuntime.buildFloatHash`), which masks a float's
// IEEE-754 pattern to 32 bits — a question about BITS that no arithmetic opcode can ask.
//
// ⭐⭐ `bitcastI64ToF64` IS ITS INVERSE, AND THE TWO ARE NOW A PAIR — the reinterpretation READ BACK.
// It reads a GPR and writes an XMM/SIMD register, the same 64 bits the other direction moved out, and
// it is one instruction on every target: x64 `movq xmm, r64` (66 REX.W 0F 6E), arm64 `fmov d, x`,
// wasm `f64.reinterpret_i64`.
//
// ⚠ **IT IS THE ONE MEMBER OF THIS ENUM PAST `fpToSi` THAT READS A GPR**, which is why
// `stdUnaryOperandIsFloat` has to give it an arm of its own answering FALSE — every other member
// from `fpToSi` down reads the float file, so a range extended to reach this one would invert its
// answer. The DOMAIN follows the SOURCE, and this opcode's source is the integer side.
//
// ITS PRODUCER is `stdlib/Builtins.maxon`'s `__float_fromString`, reached through the Maxon-tier
// door `__Builtins.bitsToFloat` (`Parser.BuiltinsBitsToFloatName`): the tree's ONE correctly-rounded
// decimal reader answers BITS, and turning those bits back into the `float` a Maxon program asked for
// is a question no arithmetic opcode can answer either. That closes the loop the outbound direction
// opened — the print path takes a float apart, the parse path puts one back together, and there is
// exactly one conversion in each direction.
//
// ⚠ APPENDED PAST THE MATH BAND, BOTH OF THEM, per the band-append invariant, and this enum's range arms are the
// reason that matters: `stdUnaryOperandIsFloat` reads `fpToSi to fneg`, `unaryResultClass` and
// `unaryResultValType` read `floor to fneg`, and the wasm isel dispatches `floor to fneg` while the
// arm64 and x64 isels dispatch `floor to round` (the ROUNDING sub-band alone — `sqrt`, `abs` and `fneg`
// are each their own lowering). They do NOT all span the same members, so a member inserted anywhere
// before the band's end would be swallowed by some and not by others — misclassified at a subset of
// sites, which is worse than at all of them. Every one of those arms was re-read when this landed.
//
// ⚠ `abs` JOINED THE MATH BAND AT ITS END, past `sqrt` and before `bitcastF64ToI64`, and that is why
// every `… to sqrt` range above then read `… to abs`: the band GREW, so the arms that describe the
// band name its new last member. Appending `abs` past `bitcastF64ToI64` instead would have left it
// outside all four of them — a math intrinsic classified by the arms that answer for a reinterpretation.
//
// ⚠ `fneg` JOINED THE SAME WAY (2026-08-30), past `abs`, so those ranges now read `… to fneg`. It is
// `abs`'s twin — a sign-bit FLIP where `abs` is a sign-bit CLEAR — and the op a source `-x` over a
// float lowers to; before it that `-x` was `0.0 - x`, which is `+0.0` for a positive zero (see
// `MaxonUnaryOp.fneg`). f64 → f64, non-trapping, one operand: the math band's shape exactly. Native on
// arm64 (`fneg`) and wasm (`f64.neg`); synthesized on x64 (`TargetOp.negF64RegReg`), like `abs`.
//
// ⚠ THE TWO BITCASTS ARE NOT A "BAND" ANY RANGE MAY SPAN, though they sit adjacent and are inverses.
// They DISAGREE about the one question the arms above ask — `stdUnaryOperandIsFloat` is `true` for
// the outbound one and `false` for the inbound — so a `bitcastF64ToI64 to bitcastI64ToF64` range is
// wrong at every site that asks about the operand or the result — `stdUnaryOperandIsFloat`,
// `unaryResultClass`, `unaryResultValType` — so every one of those names them one at a time. A site
// whose answer genuinely does not depend on the direction (`floatRoundModeFor`'s "there is nothing
// here to round") may span them, and says so.
export enum StdUnaryOpcode
	neg
	bitNot
	logicalNot
	siToFp
	fpToSi
	floor
	ceil
	round
	sqrt
	abs
	fneg
	bitcastF64ToI64
	bitcastI64ToF64
end 'StdUnaryOpcode'

// ⭐⭐ **THE ONE ANSWER TO "does this unary opcode READ a float?"** — and the reason it lives beside
// the enum rather than in a backend is that it is a property OF THE OPCODE, not of any one target.
// Three callers ask it and none of them may re-derive it: the Maxon→Std boundary asserts the
// operand it was handed agrees (`assertUnaryOperandDomain`), and the x64 and arm64 isels each
// refuse an integer-only instruction over an f64 register. Those two backends carried a private
// copy each (`unaryOpcodeCrossesFiles` / `arm64UnaryCrossesFiles`) — the same fact written down
// twice, one register file apart.
//
// ⚠ IT IS THE OPERAND'S DOMAIN, NOT THE RESULT'S, and on the conversion pair those differ: `siToFp`
// answers **false** (it reads the INT side; its RESULT is the float) and `fpToSi` **true**. Read it
// as "what register file does this instruction's SOURCE come out of" and every arm is obvious.
export function stdUnaryOperandIsFloat(opcode StdUnaryOpcode) returns bool
	return match opcode 'k'
		// `neg`/`bitNot`/`logicalNot` are integer/bool instructions, and `siToFp` reads the integer
		// half of the conversion pair.
		neg to siToFp gives false
		// `fpToSi` reads the float half, and the five math intrinsics and the sign flip `fneg` are
		// f64 → f64.
		fpToSi to fneg gives true
		// The BITCAST reads an f64 and writes a GPR. It gets its own arm rather than extending the
		// range above, because that range's answer is "true" for two different reasons — `fpToSi`
		// converts out of the float domain and the intrinsics stay inside it — and this is a third:
		// it leaves the domain without converting. Extending the range would make the comment above
		// false for its last member, which is how a range arm's endpoint stops describing its content.
		bitcastF64ToI64 gives true
		// ⚠ THE INBOUND BITCAST IS THE ONLY MEMBER PAST `siToFp` THAT READS AN INTEGER, and it is the
		// clearest case of this function being about the SOURCE: `bitcastI64ToF64`'s result is an f64,
		// so anything reading the opcode's NAME for its answer gets `true` and colours the operand into
		// an XMM register that holds an i64. Its `false` is `siToFp`'s `false`, one band apart.
		bitcastI64ToF64 gives false
	end 'k'
end 'stdUnaryOperandIsFloat'

// The Std-tier comparison predicates carried by `StdOp.cmp` (M4). Signed integer
// comparisons: the x64 lowering maps each to a signed setcc/jcc condition (`lt`→JL,
// `gt`→JG, …). A separate op (not a `binOp` opcode) because a compare carries
// DIFFERENT metadata (`isCmp: true`) the per-variant `StdOpMeta` backing cannot
// reach through an opcode field — see the StdOp header's "flat does NOT mean one
// variant per opcode" rule.
export enum StdCmpPred
	eq
	ne
	lt
	gt
	le
	ge
end 'StdCmpPred'

// The read-modify-write operation `StdOp.atomicRmw` performs on the word it names (F2). One member
// today, and the enum exists rather than a family of `atomic*` VARIANTS because of the rule the StdOp
// header states: a family sharing one operand shape AND one metadata profile is an OPCODE FIELD, not a
// variant. v1 spells this as three ops (`atomicInc`, `atomicDec`, `atomicXadd`) and pays for it in every
// backend's match — `atomicInc(addr)` IS `atomicRmw(_, addr, +1, add)`, and the only things the separate
// variants buy are a shorter x86 encoding and `lock dec`'s ZF, neither of which is vocabulary. (The
// encoding half is recovered at the x64 isel — see `lowerAtomicRmw` there; the ZF half has no reader,
// because shv2's decref path branches on a value it loads rather than on flags.)
//
// ⭐ **A LATER MEMBER APPENDS HERE, AND THAT IS THE WHOLE POINT OF THE FIELD.** `and`/`or`/`xchg` all
// share `add`'s operand shape and its metadata, so each is one member plus one arm in each of the three
// backends — never a fourth `StdOp` variant, and never a new tier boundary to thread. Every backend
// matches this enum exhaustively, so an appended member is a COMPILE error in each of them rather than a
// silently wrong lowering.
export enum StdAtomicRmwOpcode
	add
end 'StdAtomicRmwOpcode'

// The two values `StdOp.atomicCas` answers with — the SUCCESS BOOLEAN convention stated as code rather
// than only as prose on the op. They live here, at the contract, because a backend that has to SPELL the
// answer must not spell it from memory: the two native lanes read the boolean straight off the hardware
// (x86 `setz`, AArch64 `CSET`, both of which produce 1/0 by definition), while the wasm lane materializes
// it and is therefore the one reader. Inverting the convention has to be possible in ONE place.
export let AtomicCasSucceeded = 1 as ParsedInt
export let AtomicCasFailed = 0 as ParsedInt

// Per-variant static metadata backing for StdOp (read via `op.rawValue`). Carries
// what passes need to classify an op WITHOUT matching on it: the category (see
// above), the structural role, the two inliner axes, and the scheduling facts the
// instruction scheduler and the backends' use counting consume.
export type StdOpMeta
	export let category as StdOpCategory
	export let role as OpRole
	// Side-effect-free: the op can be duplicated, reordered, or dropped when its
	// result is unused.
	//
	// ⭐⭐ **IT HAS A READER SINCE `EC13` (2026-08-28), AND IT IS THE FIRST.**
	// `eliminateCommonSubexpressions` gates on it: an op it would replace with an
	// earlier equal one must be `isPure`, which is what keeps `div`/`mod` (they trap)
	// and every load, call and OS primitive out of the pass — and the ONE flag that
	// says so, rather than a second list of op names inside the pass.
	//
	// ⚠⚠ **THAT READER DOES NOT MAKE EVERY VARIANT'S VALUE GATED, AND THE OLD WARNING
	// STANDS FOR THE REST.** Measured 2026-07-15: a sweep of all nine `StdOpMeta`
	// fields found `isPure` read NOWHERE, and a SABOTAGE confirmed it — `loadIndirect`
	// flipped to `isPure: true` left `specs-shv2` at **371/0, exit 0**, including both
	// `*-load-not-hoisted` specs. Re-measured 2026-08-28 with CSE landed, that same
	// sabotage is now REACHABLE — a load is only CSE'd if this flag lies — but a lie
	// on a variant CSE's own roster (`classifyArithOperands`) already refuses is still
	// invisible, because the roster answers `neither` before the flag is asked.
	//
	// ⇒ **The values are still held by REVIEW for every variant outside the arith
	// band.** That is why each variant's value is argued at its own line rather than
	// asserted. **OPEN.md #27** carries the finding and the keep-vs-delete question
	// for this field's FIVE equally unread siblings (`role`,
	// `isUnsupportedInInlineBody`, `isMemory`, `isStore`, `isCmp` — only `category`,
	// `isCall` and `clobbersFlags` have a reader). The other readers this field was
	// awaiting are the inliner's callee-body purity gate (v1: `Inliner.isPureOp`) and
	// DCE/LICM, which are still scheduled and still do not exist.
	//
	// Declared PER VARIANT, which is the flat union's payoff: v1 could only answer
	// this by CATEGORY at the match site (`arith gives true; control gives true;
	// call(c) gives c.rawValue.isPureForInlining; memory/system give false`), a
	// blanket that has no way to say a trapping op is impure — v1's own `arith`
	// band would call an integer `div` (which faults on divide-by-zero) pure. Here
	// M3's `div` simply declares `isPure: false` and nothing else changes.
	export let isPure as bool
	// The op cannot appear inside a callee body that the multi-block splice is asked
	// to inline — it escapes the inliner's static-callee model (v1: `indirectCall`,
	// `witnessCall`, `tailCall`, `errorReturn`). ORTHOGONAL to `isPure`: purity says
	// whether the op may be moved, this says whether it may be spliced at all.
	export let isUnsupportedInInlineBody as bool
	// True for ops that access memory or have side effects the scheduler must
	// treat as a barrier (loads, stores, calls, syscalls, atomics, locks).
	export let isMemory as bool
	// True for ops that write memory or have externally-observable side effects
	// (must order with subsequent loads). Pure loads are memory but not stores.
	export let isStore as bool
	// True for ops with full call-barrier semantics (clobber caller-saved regs,
	// may observe/modify arbitrary memory). Also true for `param`.
	export let isCall as bool
	// True if the op MAY clobber x64 EFLAGS / ARM64 NZCV once lowered. A LOWERING
	// artifact, not a side effect — a flag-clobbering op is still `isPure`.
	//
	// ⚠ IT IS A **MAY**-CLOBBER OVER-APPROXIMATION, DELIBERATELY, AND THE IMPRECISION IS
	// STRUCTURAL. The x64 flags behaviour of three variants depends on their OPCODE, which
	// per-variant metadata cannot see (see the StdOp header):
	//
	//   • `binOp(add)`        lowers to `lea` — writes NO flags. `sub`/`mul` do.
	//   • `binOpImm(add|sub)` lowers to `lea` — writes NO flags. `mul`/the word ALU forms do.
	//   • `unaryOp(bitNot)`   lowers to `not` — writes NO flags. `neg`/`logicalNot` do.
	//
	// `true` on those three is SOUND: the only consumer (`recordFusableCompare`) walks
	// backward for the last flag WRITER, so over-claiming a write can only make it decline a
	// legal fusion — never fuse an illegal one. **Do NOT "correct" them to `false`** — the
	// answer genuinely differs per opcode, and a per-variant `false` would be a LIE for
	// `sub`/`mul`/`neg`, which IS unsound. Making them exact means SPLITTING the variant
	// (the dialect's own documented rule for metadata an opcode field cannot carry). That is
	// a real option and it is priced: it buys fusion across an intervening `lea`, which no
	// measured program does. Not taken.
	//
	// `const` is the one that is NOT an over-approximation and must stay exact — see its
	// variant below.
	export let clobbersFlags as bool
	// A compare feeding a branch — the backends pair the two, so the classification
	// must survive as metadata rather than being re-derived per target.
	export let isCmp as bool
end 'StdOpMeta'

// --- StdOp: the flat op union ---
//
// Variants are declared in CATEGORY-CONTIGUOUS BANDS, in `StdOpCategory` order:
// arith · control · call · memory · system · sugar. The banding is what makes a
// flat union as ergonomic as the nested one it replaces: a pass that treats a
// whole category uniformly covers it with ONE `match` range arm
// (`firstArith to lastArith then …`) instead of one arm per variant.
//
// INVARIANT — **a new variant is APPENDED AT THE END OF ITS BAND, never inserted
// into the middle of one.** A range arm names its endpoints, so it silently
// swallows anything inserted between them: the compiler reports no missing-case
// error, and the new op is misclassified at every range-arm site at once. This is
// the one place the project's "no silent unhandled cases" rule has no compiler
// backstop, so it is a convention the reviewer must enforce. Appending at a band's
// end is always safe (the range's endpoint moves with it, deliberately).
//
// Flat does NOT mean one variant per opcode. Where a family shares an operand
// shape and differs only in the operation (`add`/`sub`/`mul`/…), it stays ONE
// variant with an opcode field — but a member needing DIFFERENT metadata (a
// compare sets `isCmp`; a division traps) splits out as its own variant, because
// the `StdOpMeta` backing attaches per variant and cannot reach an opcode buried
// inside a field. M3's arithmetic lands as `binOp(… opcode StdBinOpcode)` +
// a separate `cmp(…)` for exactly that reason.
export union StdOp
	// --- band: arith ---
	// Materialize a constant into a virtual register (`resultId`). `valueType`
	// carries the width AND the float-ness the backend needs to pick a GP
	// mov-immediate vs an XMM load — replacing v1's `constI64`/`constF64` opcode
	// pair, which could not express i32/u8/f32 without new opcodes.
	//
	// ⚠ `clobbersFlags: FALSE`, and unlike its band-mates this is EXACT, not an
	// over-approximation: `constMaterializationOp` emits `movRegImm32` or `movRegImm` and
	// NOTHING ELSE, and `mov r, imm` writes no flags. It has no opcode field, so there is no
	// per-opcode case to hide behind.
	//
	// It read `true` until 2026-07-14, justified by an `xor reg, reg` zeroing idiom for the
	// value==0 case — an idiom the lowering DOES NOT EMIT and never has (StdToX64Conversion
	// says so at `constMaterializationOp`: it is a deferred size/flags tradeoff). The comment
	// described a compiler we did not write, and the cost was real: a short-circuit's seed
	// literal sits between a compare and its branch, so the false claim broke compare/branch
	// fusion on `if a > 0 and b > 0` — 3 wasted instructions (`setcc` + `movzx` + a redundant
	// `cmp`) on the commonest conditional shape there is.
	//
	// ⚠ THE DAY THE `xor reg, reg` IDIOM LANDS, THIS MUST CHANGE — `xor` DOES write flags, so
	// `const`'s answer becomes value-dependent (false for every value but 0) and per-variant
	// metadata cannot express that. Split the variant, or take `true` back. The guard is
	// repeated at the idiom's own site so whoever adds it trips over it there.
	const(resultId ValueId, value ParsedInt, valueType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Binary op `resultId = lhs <opcode> rhs` over two virtual registers. M3 carries
	// `add`/`sub`/`mul`, all `isPure` (integer add/sub/mul never trap — unlike the
	// trapping `div` below, which declares `isPure: false`) and `clobbersFlags: true`
	// (x64 `add`/`sub`/`imul` write EFLAGS). Appended at the END of the arith band,
	// honoring the band-append invariant; `cmp` splits out as its own variant at M4.
	//
	// ⭐ `operandType` is what the op COMPUTES IN, and P1.0d.4 added it because without
	// it this tier could not tell `add` from `addsd`. A Std value USED to be a typeless
	// i64 and the band could stay silent about type; a float breaks that, and the
	// alternative to a field here is the backend re-deriving the type from the operands'
	// defs — a second type system, in the tier furthest from the source. It is a FIELD,
	// not a variant, exactly as `const.valueType` is: the operand shape and the metadata
	// profile do not change with the type.
	//
	// ⚠ `clobbersFlags: true` is an OVER-APPROXIMATION for floats and is deliberately
	// left that way: `addsd`/`subsd`/`mulsd`/`divsd` write NO flags. `true` costs a
	// scheduling barrier that is not needed and can never cost correctness, whereas
	// making the answer depend on `operandType` would put value-dependent metadata in a
	// per-variant table that cannot express it — the same trap `const` documents above.
	// Tightening it means splitting the variant.
	binOp(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode, operandType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Unary op `resultId = <opcode> operand` over one virtual register. M3 carries
	// `neg`, which is `isPure` (integer negate never traps) and `clobbersFlags: true`
	// (x64 `neg` writes EFLAGS). Appended at the END of the arith band, after `binOp`,
	// honoring the band-append invariant. `operandType` per `binOp` above.
	unaryOp(resultId ValueId, operand ValueId, opcode StdUnaryOpcode, operandType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Comparison `resultId = lhs <pred> rhs`, producing an i1. M4's `if` condition.
	// `isCmp: true` (the metadata the x64 backend pairs with the following branch);
	// `isPure: true` (a compare never traps); `clobbersFlags: true` (x64 `cmp` and
	// `ucomisd` both write EFLAGS — exact here, not an approximation). SPLIT OUT of
	// `binOp` at the END of the arith band because it needs this different metadata —
	// see StdCmpPred and the StdOp header.
	//
	// ⭐ `operandType` DECIDES THE CONDITION-CODE FAMILY, and it is not optional. `cmp`
	// answers in OF/SF, which the signed JL/JG family reads; `ucomisd` leaves OF=SF=0
	// always and answers in ZF/PF/CF, which the UNSIGNED JB/JA family reads. So the same
	// `StdCmpPred.less` lowers to `jl` for an i64 and `jb` for an f64, and a float
	// compare lowered to `jl` reads flags that were never written. The predicate alone
	// never determined the condition code; it only looked that way while every Std
	// compare was a signed i64. See X64CondCode and specs-shv2/float-compare-branch.md.
	cmp(resultId ValueId, lhs ValueId, rhs ValueId, pred StdCmpPred, operandType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: true}
	// Binary op with a CONSTANT right operand folded to an immediate: `resultId =
	// lhs <opcode> imm`. Produced by `foldConstOperands` from a `binOp` whose rhs
	// was a `const` (the const op is then DCE'd), so the literal never occupies a
	// register. The x64 lowering picks a copy-free 3-operand form per opcode: `add`
	// to `lea dest, [lhs + imm]`, `sub` to `lea dest, [lhs - imm]`, `mul` to `imul
	// dest, lhs, imm` — none of which is two-address, so no seed copy is ever
	// emitted. `isPure` (integer add/sub/mul never trap); `clobbersFlags: true` (the
	// `imul` lowering writes EFLAGS; the `lea` forms do not, but the flag is a "may
	// clobber" over-approximation the scheduler treats as a barrier). APPENDED at the
	// END of the arith band, after `cmp`, honoring the band-append invariant.
	//
	// ⭐⭐ INTEGER ONLY — no SSE form takes an immediate: `addsd` reads its right operand
	// from a register or from memory, never from an encoded constant. So a float `binOp`
	// CANNOT fold to this op and `foldConstOperands` must refuse a float rhs.
	//
	// ⚠ THE FOLD IS A WRONG-ANSWER SITE IF IT DOES NOT CHECK. Fold `3.5 > 9.5` and the
	// IEEE bit patterns go through an INTEGER `cmp reg, imm32`. It would even give the
	// right answer for most inputs — positive doubles happen to order correctly when
	// compared as sign-magnitude integers — so the tests that would catch it are the
	// ones with a negative operand or a NaN, not the ones named "float comparison".
	//
	// ⭐⭐ **IT CARRIES `operandType` — THE WIDTH THE FOLD WOULD OTHERWISE DELETE (X5).** The
	// field was absent, on the argument that "integer only" was the whole of what a reader
	// needs; INTEGER and 64-BIT are not the same claim, and every backend that cannot keep
	// each value in a 64-bit register had to re-derive the width from `lhs`. That is only
	// right while `lhs`'s own type equals the op's, which a folded `binOp` does not
	// promise: the `mod` overflow guard adds `-1` to an **i1** compare result at i64 width
	// (`emitRemainderOverflowSafeDividend`), and wasm re-derived that as a 32-bit `add`,
	// zero-extended the all-ones mask, and `and`ed away the top half of every dividend.
	// The width belongs to the OP, exactly as it does on `binOp`/`cmp`, and is now stated
	// once instead of guessed twice. See `specs-shv2/safety.md`
	// `mod-guard-passes-a-wide-dividend-through-untouched`.
	binOpImm(resultId ValueId, lhs ValueId, imm Imm32, opcode StdBinOpcode, operandType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Comparison with a CONSTANT right operand folded to an immediate: `resultId =
	// lhs <pred> imm`, producing an i1. Produced by `foldConstOperands` from a `cmp`
	// whose rhs was a `const` (canonicalized there so the const lands on the rhs, with
	// the predicate flipped when the const started on the lhs). Lowers to `cmp reg,
	// imm32` so the literal needs no register. Same `isCmp`/`isPure`/`clobbersFlags`
	// profile as `cmp`. APPENDED at the END of the arith band, after `binOpImm`.
	//
	// ⭐ It carries `operandType` for `binOpImm`'s reason and its own: the fold is the only
	// producer, and it must not change WHAT IS ASKED. A `cmp` against a literal whose left
	// operand is a **u32** — `ExitCode` is the one shv2 mints — compared at 32 bits reads a
	// value above `i32.max` as negative, so `e > 100` answered `le` on wasm and `gt` on x64
	// from one source. The type also keeps the x64 branch-fusion path from ASSUMING i64
	// (`recordFusableCompare`), which is the same fact written a second time.
	// See `specs-shv2/comparison-operators.md` `compare-against-a-literal-keeps-the-operand-width`.
	cmpImm(resultId ValueId, lhs ValueId, imm Imm32, pred StdCmpPred, operandType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: true}
	// Integer division `resultId = lhs / rhs` (quotient), TRUNCATING toward
	// zero, at the signedness `signedness` names (see `IntegerSignedness` — the front end decides it
	// from BOTH operands' declared ranges, because a value's signedness is gone by this tier).
	// SPLIT OUT of `binOp` — it does NOT ride the `StdBinOpcode` opcode field —
	// because x64 `idiv` can FAULT (#DE on divide-by-zero and on INT_MIN / -1
	// overflow), so it declares `isPure: false` (it may NOT be dropped, duplicated, or
	// reordered when its result is unused), which the shared `binOp` metadata cannot
	// express through an opcode. `clobbersFlags: true` (idiv leaves EFLAGS undefined —
	// a "may clobber" the scheduler treats as a barrier). The divide-by-zero / overflow
	// TRAP itself is delivered by the runtime fault handler (a Workstream-R / M6
	// deliverable), NOT guarded by the compiler. APPENDED at the END of the arith band,
	// after `cmpImm`, honoring the band-append invariant.
	div(resultId ValueId, lhs ValueId, rhs ValueId, signedness IntegerSignedness) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Integer modulo `resultId = lhs mod rhs` (remainder), matching `div`'s
	// truncation and reading its `signedness` the same way. Same `isPure: false` (idiv faults) +
	// `clobbersFlags: true` profile as `div` — it is the SAME x64 instruction, reading the REMAINDER
	// out of RDX instead of the quotient out of RAX. APPENDED at the END of the arith band, after
	// `div`, honoring the band-append invariant.
	mod(resultId ValueId, lhs ValueId, rhs ValueId, signedness IntegerSignedness) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// --- band: control ---
	// Two-way conditional branch terminator: transfer to `thenBlockId` if `condId`
	// (an i1) holds, else to `elseBlockId`. M4's `if` lowers to this. Not pure (a
	// terminator cannot be dropped or reordered); does not clobber flags (the x64
	// `jcc` READS flags, it does not set them — the preceding `cmp` set them).
	condBranch(condId ValueId, thenBlockId BlockId, elseBlockId BlockId) = StdOpMeta{category: StdOpCategory.control, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Unconditional branch terminator to `targetBlockId` (a then/else block falling
	// through to the merge block). Same non-pure, flag-neutral profile as condBranch.
	branch(targetBlockId BlockId) = StdOpMeta{category: StdOpCategory.control, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// --- band: call ---
	// Return terminator. `retValId` names the value moved into the return register.
	ret(retValId ValueId) = StdOpMeta{category: StdOpCategory.call, role: OpRole.ret, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Parameter materialization at function entry: `resultId` is the SSA value of
	// parameter `index` (M5: the two coincide — a parameter is ValueId `index`), of
	// type `paramType`. Emitted once per parameter at the entry block; the x64
	// lowering turns it into `mov virtual(resultId), physical(argReg[index])` so the
	// parameter's incoming ABI register is captured into its virtual register. `role`
	// is `param`; `isCall: true` marks it a scheduling barrier that must stay at entry
	// (per the StdOpMeta `isCall` contract, which names `param`), and `isPure: false`
	// keeps it from being reordered or dropped. APPENDED at the END of the call band,
	// after `ret`, honoring the band-append invariant.
	param(resultId ValueId, index ParamCount, paramType StdType) = StdOpMeta{category: StdOpCategory.call, role: OpRole.param, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: true, clobbersFlags: false, isCmp: false}
	// A direct function call `resultId = callee(args…)`. `callee` is the resolved
	// function name; `args` are the argument SSA values in the callee's PARAMETER
	// order (lowerCall has already reordered any labelled arguments to declaration
	// order). The x64 lowering moves each arg into its ABI register, emits the
	// `callDirect`, then moves the R8 return value into `resultId`. Full call-barrier
	// metadata (`isCall`/`isMemory`/`isStore`/`clobbersFlags` all true, `isPure` false
	// — a call may read/write memory and must not move or drop). APPENDED at the END of
	// the call band, after `param`.
	call(resultId ValueId, callee ByteArray, args ValueIdArray) = StdOpMeta{category: StdOpCategory.call, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// Void return terminator — the return of a function with no `returns` clause. A
	// DISTINCT variant rather than a `ret` carrying some absent-value ValueId: `ValueId`
	// has no "absent" value, and a sentinel one would be READ as a real use by
	// `collectStdOpUses` (keeping a dead value live, or naming a value that was never
	// defined). Its Maxon-tier twin `MaxonOp.retVoid` splits for the same reason.
	//
	// Carries no operand at all, so it reads nothing and rewrites nothing; the x64
	// lowering emits the bare `ret` (the frame teardown is the prologue/epilogue pass's).
	// APPENDED at the END of the call band, after `call` — which is also the end of the
	// union, so the two range arms that stop at `call` (FoldConstOperands) had to be
	// extended by hand. See the band-append invariant in the StdOp header.
	retVoid = StdOpMeta{category: StdOpCategory.call, role: OpRole.ret, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// --- band: memory (P1.0d.5b — top-level `var`) ---
	//
	// ⭐ THREE OPS, NOT A FUSED `globalLoad`/`globalStore` PAIR, and the split is the point.
	// A global's read is `globalAddr` + `loadIndirect`, and its write is `globalAddr` +
	// `storeIndirect` — the SAME general pair a struct field (P1.1) and a heap value (P1.2)
	// need, reached one milestone early rather than as a special case that has to be undone.
	// This is v1's shape verbatim (`maxon-selfhosted/Compiler/Runtime/runtime.std:30-31`:
	// `v1 = std globalAddr __mm_alloc_count` then `v2 = std loadIndirect v1 0`), and it is
	// what starts retiring PLAN.md's R1 blocker — that the Std tier produces only
	// `arith`/`call`, so the Std-IR runtime route has no ops to land on.
	//
	// APPENDED PAST THE END OF THE UNION (`retVoid` was the last variant), which is the
	// band-append invariant working in the reviewer's favour: every stale `… to retVoid` /
	// `… to call` range arm now FAILS TO COMPILE until it is consciously extended. Measured:
	// appending these produced 7 loud E2026 non-exhaustive errors and ZERO silent swallows.
	// (The "silently swallows" danger is INSERTING MID-BAND, which this is not.)
	//
	// The ADDRESS of a data-section global. `label` is identifier TEXT, not a value — the
	// same name/value split `call`'s `callee` follows — and it is the label the backend
	// resolves against `GlobalDataTable.dataSection`. `isPure: true` (it recomputes an
	// address that cannot change, so it is freely REMATERIALIZABLE — an x64 `lea
	// [rip+disp32]` needs no input register at all) and `isMemory: false` (it computes an
	// address; it does not TOUCH memory — nothing is loaded).
	globalAddr(resultId ValueId, label ByteArray) = StdOpMeta{category: StdOpCategory.memory, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Read `valueType` bytes from `addrId + offset` into `resultId`.
	//
	// ⚠ **`isPure: false`, AND THAT IS THE CORRECT DECLARATION, NOT A CONSERVATISM.** A load
	// is side-effect-FREE in the everyday sense — it writes nothing — and calling it pure on
	// that basis is precisely the trap. `isPure` here licenses a pass to DUPLICATE, REORDER or
	// DROP the op, and a load may do none of those: what it reads is a mutable location some
	// OTHER op writes. Declared pure, a global's read would HOIST OUT of a loop that writes the
	// global (`specs/short-circuit-evaluation.md`'s `short-circuit-in-while-condition` reads
	// and writes `trace` every iteration), and the loop would then read a stale value for ever.
	// That is a SILENT WRONG ANSWER, not a crash. Purity is "may this op be moved?", and the
	// answer for a load is no. `clobbersFlags: false` is exact: `mov`/`movzx` write no flags.
	//
	// ⚠ **NOTHING READS THIS FLAG YET — see the `isPure` field's own note and OPEN.md #27.** The
	// value above is right and must stay right; it is simply not what makes the property hold
	// today. Do not "verify" it by running a spec: none can fail on it.
	loadIndirect(resultId ValueId, addrId ValueId, offset ByteOffset, valueType StdType) = StdOpMeta{category: StdOpCategory.memory, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Write `valueId` as `valueType` bytes to `addrId + offset`. `isStore: true` (it writes
	// memory, so it must order against every later load — the metadata contract's own words),
	// `isPure: false`. APPENDED at the END of the memory band, after `loadIndirect`.
	storeIndirect(addrId ValueId, offset ByteOffset, valueId ValueId, valueType StdType) = StdOpMeta{category: StdOpCategory.memory, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: true, isCall: false, clobbersFlags: false, isCmp: false}
	// --- band: system (P1.0r — the allocator's page source) ---
	//
	// ⭐ THE FIRST PRODUCER OF THE `system` BAND, and the band is why this op is spelled this way
	// rather than as an `importCall(slot IatSlot, …)` in the `call` band. Two independent reasons,
	// and both are load-bearing:
	//
	// 1. **TIERING.** `IatSlot` is a WINDOWS PE concept (`Targets/Windows/PeWriter.maxon`), and it
	//    is referenced nowhere outside `Targets/`. Naming it here would put a PE import-table index
	//    in the target-NEUTRAL mid-level tier — the tier ARCHITECTURE says the wasm backend will
	//    consume directly. `osAllocPages` says WHAT is wanted (pages) and lets each backend say HOW
	//    (x64-windows: `VirtualAlloc` through the IAT; Linux: `mmap`; wasm: `memory.grow`). BOTH
	//    reference compilers independently refuse the leak: v1 has `std osAllocPages <size>`, and
	//    the bootstrap has `IEmitterBackend.OsAllocPages` with `VirtualAlloc` appearing in zero
	//    files above backend tier.
	// 2. **THE BAND-APPEND INVARIANT.** The `call` band ends at `retVoid` — MID-UNION — so a variant
	//    appended there is SILENTLY swallowed by every range arm spanning it. The `system` band sits
	//    past `storeIndirect`, i.e. at the END of the union, where an append is LOUD: measured, this
	//    one produced 12 E2026 non-exhaustive errors and zero silent swallows. The safer band is
	//    also the correct one.
	//
	// `sizeId` is a VALUE (the byte count), not a name — the same value/name split `call`'s `callee`
	// and `globalAddr`'s `label` sit on the other side of. The result is the base address of a
	// freshly-committed, OS-ZEROED region, which is what lets `__slab_alloc` hand out bump slots
	// without memzeroing them (see ARCHITECTURE.md → "Allocator: the zeroing contract").
	//
	// Full call-barrier metadata: it IS a call once lowered (an indirect call through the IAT), so
	// it clobbers the caller-saved registers and may observe or modify arbitrary memory.
	// `isUnsupportedInInlineBody: true` per that field's own contract, which names v1's
	// `indirectCall` as its example — this lowers to exactly that, and it escapes the inliner's
	// static-callee model.
	osAllocPages(resultId ValueId, sizeId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// Write `lenId` bytes starting at `bufId` to STDOUT (P1.2 wave A — `print`). A `system`-band op for
	// the same two reasons `osAllocPages` is: it says WHAT is wanted (bytes to stdout) and lets each
	// backend say HOW (x64-windows: `GetStdHandle`+`WriteFile` through the IAT; a wasm backend would
	// name its own), keeping the Win32 import table out of the target-neutral tier; and it appends at
	// the END of the union, where the append is LOUD (every `… to osAllocPages` range arm fails to
	// compile until consciously extended). Full call-barrier metadata (it IS an indirect call once
	// lowered), exactly like `osAllocPages`.
	//
	// ⭐⭐ **IT DEFINES THE BYTE COUNT THE OS REPORTS, AND IT USED TO DEFINE NOTHING (W35).** The
	// comment here said *"`print` returns void — so it carries no result id"*, which was true of the
	// only consumer it then had: a bare-name `print` builtin routing to `__print_string`. That builtin
	// is retired, `print` is `stdlib/Print.maxon`'s ordinary declaration, and the floor under it is
	// `__Builtins.writeStdout` — whose canonical contract is *"returns the byte count written"*
	// (`/specs/builtins-type.md:24`) and which the bootstrap honours by capturing `WriteFile`'s
	// `lpNumberOfBytesWritten`. So the count had to come from the OS rather than from the length the
	// caller asked for, and the op is where each ABI's own answer is picked up.
	//
	// ⚠ **IT IS THE OS's ANSWER, NOT A VERDICT** — the same division `osFileOpenRead` draws for its raw
	// handle and `osReadFile` for its raw BOOL: three of the four lanes report a short or failed write
	// in the value itself (Win32 writes 0 into the out-param, a POSIX `write` answers a negative errno)
	// and classifying that is the caller's, one tier up. The fourth lane has no count to report at all:
	// WASI Preview2's `blocking-write-and-flush` writes the WHOLE contents or fails, so `lenId` IS the
	// count it wrote, and that is the ABI's guarantee rather than a synthesized stand-in.
	osWriteStdout(resultId ValueId, bufId ValueId, lenId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// The RIP-relative ADDRESS of an `.rdata` constant — a String literal's 56-byte record (P1.2 wave
	// A). The `.rdata` twin of `globalAddr`: identical operand shape (a `label` NAME, one plain def, no
