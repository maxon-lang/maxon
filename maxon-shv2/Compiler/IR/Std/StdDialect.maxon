// Std Dialect — mid-level IR. The width/ABI-resolved tier between the
// source-proximate Maxon dialect and the target-specific dialects (x64/arm64).
// All mid-level optimization passes (mem2reg, canonicalize, cse, licm, dce, …)
// run here, and so do the machine-level passes (instruction scheduling,
// coalescing) that v1 ran on a separate MIR tier.
//
// **DELIBERATE DIVERGENCE FROM v1: there is no MIR tier.** v1 ran
// Maxon → Std → MIR → Target; shv2 runs Maxon → Std → Target. v1's `lowerStdToMir`
// was ~90% a mechanical 1:1 rename — Std's `ValueId`s ALREADY ARE the infinite
// virtual registers MIR claimed to introduce, so the tier bought no new value
// model. Its only real content was desugaring a handful of Std-only ops, which
// is a Std→Std rewrite (`lowerToMachineForm`, see the `sugar` band below), not a
// tier. Deleting the tier drops a whole module copy from peak RSS and removes a
// boundary that had already started hiding drift in v1 (`MirOp.movReg` survived
// with zero construction sites because the tier wall made it invisible).
//
// **`StdOp` IS FLAT.** v1 nested it as `StdOp.arith(StdArithOp.const(StdArithConst))`
// — an artifact of a migration that did not want to touch every pass, not a
// design (v1's own StdDialect header says so). Nesting is expensive here: Maxon
// heap-boxes and refcounts every payload-carrying union case, so each nesting
// level is another heap object. That 3-boxes-per-op shape, on the most numerous
// object in the compiler, is a first-order cost — roughly half of v1's
// self-compile cycles go to memory-management churn. Flat = ONE box per op.
//
// Coarse membership ("is this any kind of call?") is recovered WITHOUT nesting by
// the `StdOpMeta` struct backing every variant carries — the same idiom
// MaxonDialect already uses and justifies. The backing is REQUIRED by the
// language, so a new variant cannot be added without declaring its category,
// role, and inline policy here.
//
// THIN for maxon-shv2 M1: carries the shapes the `return 42` slice lowers to —
// the full `StdType` classification (needed everywhere: block-arg types, function
// signatures) plus the `const` and `ret` ops. Later milestones GROW `StdOp` with
// the arith-unary/binary (M3), control-flow (M4), call/param (M5), and memory
// (M6) variants.

// --- CastCategory: coarse type family for cast validation ---
// Kept whole (int/float/bool/string/cstring) even though M1 only produces
// int/bool — the StdType backing values below reference every family, and the
// call-site type checker (Chunk B) needs the full set to reject mismatches.
export enum CastCategory
	int
	float
	bool
	string
	cstring
end 'CastCategory'

// --- StdTypeInfo: metadata carried by each StdType case ---
export type StdTypeInfo
	export let isFloat as bool
	export let castCategory as CastCategory
	// The type's footprint IN MEMORY, in bytes — what a `.data` slot of it occupies and
	// what `loadIndirect`/`storeIndirect` transfer. NOT its width in a register: an `i1`
	// lives in a full 64-bit GPR but occupies ONE byte of storage, which is exactly what
	// `specs/static-variables.md`'s `data-section-bool-1byte` pins.
	//
	// It rides the per-case BACKING rather than a `match` in a helper for the reason every
	// other fact here does: a size table beside the enum is a second declaration of the
	// enum, free to omit a case the day one is appended. Here a new case cannot be added
	// without stating its size.
	export let storageBytes as ByteCount
end 'StdTypeInfo'

// --- StdType: ABI/width-level type classification ---
// Each case carries a StdTypeInfo backing value encoding whether the type lives
// in a floating-point register, which cast family it belongs to, and how many
// bytes it occupies in memory.
export enum StdType
	i1 = StdTypeInfo{isFloat: false, castCategory: CastCategory.bool, storageBytes: 1}
	i8 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int, storageBytes: 1}
	i16 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int, storageBytes: 2}
	i32 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int, storageBytes: 4}
	i64 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int, storageBytes: 8}
	u8 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int, storageBytes: 1}
	u16 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int, storageBytes: 2}
	u32 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int, storageBytes: 4}
	u64 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int, storageBytes: 8}
	f32 = StdTypeInfo{isFloat: true, castCategory: CastCategory.float, storageBytes: 4}
	f64 = StdTypeInfo{isFloat: true, castCategory: CastCategory.float, storageBytes: 8}
end 'StdType'

export function stdTypeIsFloat(t StdType) returns bool
	return t.rawValue.isFloat
end 'stdTypeIsFloat'

// A per-ARGUMENT float bitmask carried by `callIndirect` — bit k set iff argument k is a float (an f64,
// which a backend routes to a float argument register / declares as an f64 wasm valtype rather than a GPR
// i64). Only the low arg-count bits are meaningful; the storage is a full machine word, and `1 shl k` can
// never overflow it because the parser caps a call's arguments (user params + the companion env) at
// `MaxRegisterParams` = 6, far below 64. A SCALAR, so the op stays at one managed field (P1.5 #78 — see
// `callIndirect`). It is the Std-tier, call-SITE twin of the Targets-tier, callee-side `ParamFloatMask`:
// the two answer the identical float-vs-GPR question on opposite sides of a call. The boundary is one-way —
// a Targets-tier lowering may name this Std typealias (the backends carry it, and `calleeArgFloatMask`
// produces it for a direct call), but the Std tier must not name the Targets-tier `ParamFloatMask`, so the
// two stay separate rather than one being reused across the Std→Target boundary.
export typealias ArgFloatMask = int(0 to u64.max)

// Bit k of an `ArgFloatMask` — true iff argument k travels in a float register / is an f64 valtype. The one
// door the three backends read a `callIndirect`'s per-argument register file through.
export function argIsFloat(mask ArgFloatMask, argIndex ParamCount) returns bool
	return ((mask shr argIndex) and 1) != 0
end 'argIsFloat'

// How many bytes a value of `t` occupies in memory — see `StdTypeInfo.storageBytes`.
export function stdTypeStorageBytes(t StdType) returns ByteCount
	return t.rawValue.storageBytes
end 'stdTypeStorageBytes'

// --- StdReturnType: function return type (either void or a concrete StdType) ---
// Void-returning functions are `void`; value-returning functions carry the
// concrete StdType in `value`. Consumers dispatch on this union rather than
// using a sentinel StdType to mean "no return".
export union StdReturnType
	void
	value(inner StdType)
end 'StdReturnType'

export typealias StdReturnTypeArray = Array with StdReturnType

export function stdReturnTypeIsVoid(rt StdReturnType) returns bool
	return match rt 'check'
		void gives true
		value gives false
	end 'check'
end 'stdReturnTypeIsVoid'

export function stdReturnTypeIsFloat(rt StdReturnType) returns bool
	return match rt 'check'
		void gives false
		value(inner) gives stdTypeIsFloat(inner)
	end 'check'
end 'stdReturnTypeIsFloat'

// --- StdOpCategory: coarse op family, recovered without nesting ---
// Replaces v1's outer-union arms (`StdOp.arith(...)`, `StdOp.call(...)`, …) with
// a metadata field, so membership tests stay cheap while `StdOp` stays flat.
// Declared whole even though M1 only produces `arith` and `call` — the same
// growth-is-additive convention MaxonDialect's `OpCategory` follows.
//
// `sugar` is the load-bearing one: it names the Std-only ops that exist purely to
// be rewritten away (v1's descriptorField / witnessMethod / unboxValue / drop /
// free / …). They are eliminated by a Std→Std `lowerToMachineForm` pass before the
// backend runs — see the "sugar band" contract below.
export enum StdOpCategory
	arith
	control
	call
	memory
	system
	sugar
end 'StdOpCategory'

// The structural role an op plays in a function, where that role is a property of
// the OP rather than of its category. Replaces v1's three single-variant tag
// bools (`isRet` / `isErrorReturn` / `isParam`), which existed only so passes
// could ask "is this the return?" without a match.
export enum OpRole
	plain
	ret
	errorReturn
	param
end 'OpRole'

// The Std-tier binary-operation opcodes carried by `StdOp.binOp`. A family that
// shares one operand shape (two value operands, one result) stays a single
// `binOp` variant with this opcode field — see the StdOp header's "flat does NOT
// mean one variant per opcode" rule. M2 landed `add`; M3 grew the rest of the
// non-trapping integer ALU ops (`sub`, `mul`). A compare still splits out as its
// OWN variant (it sets `isCmp` — different metadata the per-variant backing cannot
// reach through an opcode field) when `if` lands at M4; the trapping `div`/`mod`
// (which set `isPure: false`) arrive at M5 with the real register allocator.
// P1.0d.2 appends the BIT band — `bitAnd`/`bitOr`/`bitXor`/`shl`/`shr`. They share
// `binOp`'s exact operand shape (two values in, one out) and its exact metadata
// profile (pure, non-trapping, flag-clobbering), so per the header's "flat does NOT
// mean one variant per opcode" rule they are opcodes, not variants.
//
// The RIGHT SHIFT is TWO opcodes, and it has to be. A Std value is a typeless i64 — it
// carries no signedness — so this tier cannot ask which way a right shift fills; it can
// only be TOLD. `shr` is ARITHMETIC (x64 `sar`, sign-replicating) and `shrLogical` is
// LOGICAL (x64 `shr`, zero-filling), and the Maxon tier picks between them from the
// left operand's declared type (TypeRules' ⭐ THE SHIFT RULE — Go's rule: a signed left
// operand shifts arithmetically, an unsigned one logically). Collapsing them into one
// opcode is what made `u64.max shr 60` answer -1 in shv2 and 15 in the bootstrap.
//
// P1.0d.4 appends `div` — and it is FLOAT-ONLY, which looks like an exception and is not.
// The band's membership rule is its METADATA profile, and the rule that keeps the trapping
// integer `div` out is `isPure: false`: `idiv` faults on a zero divisor (and on
// `i64.min / -1`), so it must not be reordered or eliminated, and it needs its own variant
// to say so. `divsd` does not fault — IEEE-754 answers `inf`/`nan` instead — so float
// division is pure, non-trapping, and shares `binOp`'s exact operand shape. By the dialect's
// own rule it is an opcode, not a variant. The two divisions differ in the one property the
// band is defined by, so they land on opposite sides of it; that is the rule WORKING.
//
// ⚠ `binOp(div)` with an INTEGER `operandType` is ILLEGAL and the validator throws on it —
// it would declare a trapping instruction pure. Integer division stays `StdOp.div`.
export enum StdBinOpcode
	add
	sub
	mul
	bitAnd
	bitOr
	bitXor
	shl
	shr
	shrLogical
	div
end 'StdBinOpcode'

// The Std-tier unary-operation opcodes carried by `StdOp.unaryOp`. M3 lands `neg`
// (integer negate). A separate opcode set from StdBinOpcode because a unary op has
// a different operand shape (one operand, one result). Non-trapping, so `unaryOp`
// is `isPure`.
//
// P1.0d.2 appends `bitNot` (x64 `not` — flip all 64 bits) and `logicalNot` (x64
// `xor reg, 1` — flip bit 0 of a 0/1 bool). Two opcodes, not one, because they are
// two DIFFERENT instructions: `not` on a bool would produce -1/-2, which reads as
// truthy either way. The Maxon tier has already resolved which one the source `not`
// meant (see MaxonUnaryOp).
//
// ⭐⭐ P1.0d.4 appends the CONVERSION PAIR, and without it a float can neither enter
// nor leave the float domain. This is the band that makes `trunc()` — the f64→ExitCode
// bridge nearly every case in specs-shv2/float-type.md ends on — expressible at all, and
// the band that lets `5 + 2.0` promote. Both reference compilers model these as UNARY
// opcodes and shv2 follows: v1 as `StdArithUnaryOpcode.{siToFpF64, fpToSiI64}`, the
// bootstrap as `MaxonTruncOp`. A conversion has a unary op's exact shape — one operand in,
// one result out, non-trapping, pure — so per the header's rule it is an opcode, not a
// variant.
//
// ⚠⚠ THESE TWO ARE THE ONLY OPCODES WHOSE RESULT TYPE DIFFERS FROM THEIR `operandType`,
// and that is the fact to hold on to. For `neg`/`bitNot`/`logicalNot` the two coincide, so
// nothing has ever had to distinguish them. Here they cannot: **`operandType` is always the
// SOURCE — what the instruction reads — and the OPCODE names the result.** `siToFp` reads
// an integer and produces f64; `fpToSi` reads f64 and produces an integer. Read
// `operandType` as "the result type" on these and you get exactly the wrong register file.
//
// ⚠ `siToFp` with a float `operandType`, or `fpToSi` with an integer one, is ILLEGAL — it
// would name a conversion from a type to itself, and the x64 instruction for it does not
// exist. Throw rather than emit.
//
// ⭐ `fpToSi` TRUNCATES TOWARD ZERO, and the `t` in its instruction (`cvttsd2si`, not
// `cvtsd2si`) is the whole reason it is the right one: `cvtsd2si` rounds under MXCSR's
// current mode — banker's rounding by default — so `trunc(3.99)` would answer **4**.
// The spec says 3. The two mnemonics differ by one letter and by a wrong answer.
//
// ⭐ P1.0d.4-C appends the FOUR MATH INTRINSICS — `floor`/`ceil`/`round`/`sqrt`. They are the
// mirror image of the conversion pair above and the reason to read the two bands together:
// a conversion's operand and result are in DIFFERENT files, these two are in the SAME one, and
// neither is `operandType`'s naive reading. **All four read an f64 and produce an f64**, so
// `operandType` happens to name the result as well — but only because the domains coincide, and a
// table that says so must say it deliberately (see `unaryResultClass` / `unaryResultValType`,
// where they need their own arms precisely because they sit PAST `fpToSi` in this enum).
//
// Each is ONE instruction on every target — x64 `sqrtsd` / `roundsd imm8`, arm64 `fsqrt` /
// `frint{n,p,m}`, wasm `f64.{sqrt,nearest,ceil,floor}` — so there is no opcode here that a backend
// has to synthesize.
//
// ⭐ `round` IS TIES-TO-EVEN (banker's rounding), which is what all three of those instruction
// families do natively and what `specs/round.md` pins (`round(2.5)` is 2). It is NOT C's `round()`.
export enum StdUnaryOpcode
	neg
	bitNot
	logicalNot
	siToFp
	fpToSi
	floor
	ceil
	round
	sqrt
end 'StdUnaryOpcode'

// ⭐⭐ **THE ONE ANSWER TO "does this unary opcode READ a float?"** — and the reason it lives beside
// the enum rather than in a backend is that it is a property OF THE OPCODE, not of any one target.
// Three callers ask it and none of them may re-derive it: the Maxon→Std boundary asserts the
// operand it was handed agrees (`assertUnaryOperandDomain`), and the x64 and arm64 isels each
// refuse an integer-only instruction over an f64 register. Those two backends carried a private
// copy each (`unaryOpcodeCrossesFiles` / `arm64UnaryCrossesFiles`) — the same fact written down
// twice, one register file apart.
//
// ⚠ IT IS THE OPERAND'S DOMAIN, NOT THE RESULT'S, and on the conversion pair those differ: `siToFp`
// answers **false** (it reads the INT side; its RESULT is the float) and `fpToSi` **true**. Read it
// as "what register file does this instruction's SOURCE come out of" and every arm is obvious.
export function stdUnaryOperandIsFloat(opcode StdUnaryOpcode) returns bool
	return match opcode 'k'
		// `neg`/`bitNot`/`logicalNot` are integer/bool instructions, and `siToFp` reads the integer
		// half of the conversion pair.
		neg to siToFp gives false
		// `fpToSi` reads the float half, and the four math intrinsics are f64 → f64.
		fpToSi to sqrt gives true
	end 'k'
end 'stdUnaryOperandIsFloat'

// The Std-tier comparison predicates carried by `StdOp.cmp` (M4). Signed integer
// comparisons: the x64 lowering maps each to a signed setcc/jcc condition (`lt`→JL,
// `gt`→JG, …). A separate op (not a `binOp` opcode) because a compare carries
// DIFFERENT metadata (`isCmp: true`) the per-variant `StdOpMeta` backing cannot
// reach through an opcode field — see the StdOp header's "flat does NOT mean one
// variant per opcode" rule.
export enum StdCmpPred
	eq
	ne
	lt
	gt
	le
	ge
end 'StdCmpPred'

// Per-variant static metadata backing for StdOp (read via `op.rawValue`). Carries
// what passes need to classify an op WITHOUT matching on it: the category (see
// above), the structural role, the two inliner axes, and the scheduling facts the
// instruction scheduler and the backends' use counting consume.
export type StdOpMeta
	export let category as StdOpCategory
	export let role as OpRole
	// Side-effect-free: the op can be duplicated, reordered, or dropped when its
	// result is unused.
	//
	// ⚠⚠ **THIS FIELD HAS NO READER TODAY — IT IS A DECLARATION AWAITING ONE, AND
	// EVERY OP'S VALUE MUST STILL BE RIGHT.** Measured 2026-07-15: a sweep of all
	// nine `StdOpMeta` fields finds `isPure` read NOWHERE (`op.rawValue` is never
	// even aliased to a local, so the sweep is complete), and a SABOTAGE confirms it
	// — `loadIndirect` flipped to `isPure: true` leaves `specs-shv2` at **371/0,
	// exit 0**, including both `*-load-not-hoisted` specs. Its readers are the
	// inliner's callee-body purity gate (v1: `Inliner.isPureOp`) and DCE/CSE/LICM;
	// all are SCHEDULED and none exist (`buildDefaultPipeline` hoists nothing).
	//
	// ⇒ **No spec can gate this field, so the values are held by REVIEW alone.** That
	// is why each variant's value is argued at its own line rather than asserted, and
	// why a wrong one is invisible until the first hoisting pass makes it a silent
	// wrong answer in every program at once. **OPEN.md #27** carries the finding and
	// the keep-vs-delete question for this field's FIVE equally unread siblings
	// (`role`, `isUnsupportedInInlineBody`, `isMemory`, `isStore`, `isCmp` — only
	// `category`, `isCall` and `clobbersFlags` have a reader).
	//
	// Declared PER VARIANT, which is the flat union's payoff: v1 could only answer
	// this by CATEGORY at the match site (`arith gives true; control gives true;
	// call(c) gives c.rawValue.isPureForInlining; memory/system give false`), a
	// blanket that has no way to say a trapping op is impure — v1's own `arith`
	// band would call an integer `div` (which faults on divide-by-zero) pure. Here
	// M3's `div` simply declares `isPure: false` and nothing else changes.
	export let isPure as bool
	// The op cannot appear inside a callee body that the multi-block splice is asked
	// to inline — it escapes the inliner's static-callee model (v1: `indirectCall`,
	// `witnessCall`, `tailCall`, `errorReturn`). ORTHOGONAL to `isPure`: purity says
	// whether the op may be moved, this says whether it may be spliced at all.
	export let isUnsupportedInInlineBody as bool
	// True for ops that access memory or have side effects the scheduler must
	// treat as a barrier (loads, stores, calls, syscalls, atomics, locks).
	export let isMemory as bool
	// True for ops that write memory or have externally-observable side effects
	// (must order with subsequent loads). Pure loads are memory but not stores.
	export let isStore as bool
	// True for ops with full call-barrier semantics (clobber caller-saved regs,
	// may observe/modify arbitrary memory). Also true for `param`.
	export let isCall as bool
	// True if the op MAY clobber x64 EFLAGS / ARM64 NZCV once lowered. A LOWERING
	// artifact, not a side effect — a flag-clobbering op is still `isPure`.
	//
	// ⚠ IT IS A **MAY**-CLOBBER OVER-APPROXIMATION, DELIBERATELY, AND THE IMPRECISION IS
	// STRUCTURAL. The x64 flags behaviour of three variants depends on their OPCODE, which
	// per-variant metadata cannot see (see the StdOp header):
	//
	//   • `binOp(add)`        lowers to `lea` — writes NO flags. `sub`/`mul` do.
	//   • `binOpImm(add|sub)` lowers to `lea` — writes NO flags. `mul`/the word ALU forms do.
	//   • `unaryOp(bitNot)`   lowers to `not` — writes NO flags. `neg`/`logicalNot` do.
	//
	// `true` on those three is SOUND: the only consumer (`recordFusableCompare`) walks
	// backward for the last flag WRITER, so over-claiming a write can only make it decline a
	// legal fusion — never fuse an illegal one. **Do NOT "correct" them to `false`** — the
	// answer genuinely differs per opcode, and a per-variant `false` would be a LIE for
	// `sub`/`mul`/`neg`, which IS unsound. Making them exact means SPLITTING the variant
	// (the dialect's own documented rule for metadata an opcode field cannot carry). That is
	// a real option and it is priced: it buys fusion across an intervening `lea`, which no
	// measured program does. Not taken.
	//
	// `const` is the one that is NOT an over-approximation and must stay exact — see its
	// variant below.
	export let clobbersFlags as bool
	// A compare feeding a branch — the backends pair the two, so the classification
	// must survive as metadata rather than being re-derived per target.
	export let isCmp as bool
end 'StdOpMeta'

// --- StdOp: the flat op union ---
//
// Variants are declared in CATEGORY-CONTIGUOUS BANDS, in `StdOpCategory` order:
// arith · control · call · memory · system · sugar. The banding is what makes a
// flat union as ergonomic as the nested one it replaces: a pass that treats a
// whole category uniformly covers it with ONE `match` range arm
// (`firstArith to lastArith then …`) instead of one arm per variant.
//
// INVARIANT — **a new variant is APPENDED AT THE END OF ITS BAND, never inserted
// into the middle of one.** A range arm names its endpoints, so it silently
// swallows anything inserted between them: the compiler reports no missing-case
// error, and the new op is misclassified at every range-arm site at once. This is
// the one place the project's "no silent unhandled cases" rule has no compiler
// backstop, so it is a convention the reviewer must enforce. Appending at a band's
// end is always safe (the range's endpoint moves with it, deliberately).
//
// Flat does NOT mean one variant per opcode. Where a family shares an operand
// shape and differs only in the operation (`add`/`sub`/`mul`/…), it stays ONE
// variant with an opcode field — but a member needing DIFFERENT metadata (a
// compare sets `isCmp`; a division traps) splits out as its own variant, because
// the `StdOpMeta` backing attaches per variant and cannot reach an opcode buried
// inside a field. M3's arithmetic lands as `binOp(… opcode StdBinOpcode)` +
// a separate `cmp(…)` for exactly that reason.
export union StdOp
	// --- band: arith ---
	// Materialize a constant into a virtual register (`resultId`). `valueType`
	// carries the width AND the float-ness the backend needs to pick a GP
	// mov-immediate vs an XMM load — replacing v1's `constI64`/`constF64` opcode
	// pair, which could not express i32/u8/f32 without new opcodes.
	//
	// ⚠ `clobbersFlags: FALSE`, and unlike its band-mates this is EXACT, not an
	// over-approximation: `constMaterializationOp` emits `movRegImm32` or `movRegImm` and
	// NOTHING ELSE, and `mov r, imm` writes no flags. It has no opcode field, so there is no
	// per-opcode case to hide behind.
	//
	// It read `true` until 2026-07-14, justified by an `xor reg, reg` zeroing idiom for the
	// value==0 case — an idiom the lowering DOES NOT EMIT and never has (StdToX64Conversion
	// says so at `constMaterializationOp`: it is a deferred size/flags tradeoff). The comment
	// described a compiler we did not write, and the cost was real: a short-circuit's seed
	// literal sits between a compare and its branch, so the false claim broke compare/branch
	// fusion on `if a > 0 and b > 0` — 3 wasted instructions (`setcc` + `movzx` + a redundant
	// `cmp`) on the commonest conditional shape there is.
	//
	// ⚠ THE DAY THE `xor reg, reg` IDIOM LANDS, THIS MUST CHANGE — `xor` DOES write flags, so
	// `const`'s answer becomes value-dependent (false for every value but 0) and per-variant
	// metadata cannot express that. Split the variant, or take `true` back. The guard is
	// repeated at the idiom's own site so whoever adds it trips over it there.
	const(resultId ValueId, value ParsedInt, valueType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Binary op `resultId = lhs <opcode> rhs` over two virtual registers. M3 carries
	// `add`/`sub`/`mul`, all `isPure` (integer add/sub/mul never trap — unlike the
	// trapping `div` below, which declares `isPure: false`) and `clobbersFlags: true`
	// (x64 `add`/`sub`/`imul` write EFLAGS). Appended at the END of the arith band,
	// honoring the band-append invariant; `cmp` splits out as its own variant at M4.
	//
	// ⭐ `operandType` is what the op COMPUTES IN, and P1.0d.4 added it because without
	// it this tier could not tell `add` from `addsd`. A Std value USED to be a typeless
	// i64 and the band could stay silent about type; a float breaks that, and the
	// alternative to a field here is the backend re-deriving the type from the operands'
	// defs — a second type system, in the tier furthest from the source. It is a FIELD,
	// not a variant, exactly as `const.valueType` is: the operand shape and the metadata
	// profile do not change with the type.
	//
	// ⚠ `clobbersFlags: true` is an OVER-APPROXIMATION for floats and is deliberately
	// left that way: `addsd`/`subsd`/`mulsd`/`divsd` write NO flags. `true` costs a
	// scheduling barrier that is not needed and can never cost correctness, whereas
	// making the answer depend on `operandType` would put value-dependent metadata in a
	// per-variant table that cannot express it — the same trap `const` documents above.
	// Tightening it means splitting the variant.
	binOp(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode, operandType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Unary op `resultId = <opcode> operand` over one virtual register. M3 carries
	// `neg`, which is `isPure` (integer negate never traps) and `clobbersFlags: true`
	// (x64 `neg` writes EFLAGS). Appended at the END of the arith band, after `binOp`,
	// honoring the band-append invariant. `operandType` per `binOp` above.
	unaryOp(resultId ValueId, operand ValueId, opcode StdUnaryOpcode, operandType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Comparison `resultId = lhs <pred> rhs`, producing an i1. M4's `if` condition.
	// `isCmp: true` (the metadata the x64 backend pairs with the following branch);
	// `isPure: true` (a compare never traps); `clobbersFlags: true` (x64 `cmp` and
	// `ucomisd` both write EFLAGS — exact here, not an approximation). SPLIT OUT of
	// `binOp` at the END of the arith band because it needs this different metadata —
	// see StdCmpPred and the StdOp header.
	//
	// ⭐ `operandType` DECIDES THE CONDITION-CODE FAMILY, and it is not optional. `cmp`
	// answers in OF/SF, which the signed JL/JG family reads; `ucomisd` leaves OF=SF=0
	// always and answers in ZF/PF/CF, which the UNSIGNED JB/JA family reads. So the same
	// `StdCmpPred.less` lowers to `jl` for an i64 and `jb` for an f64, and a float
	// compare lowered to `jl` reads flags that were never written. The predicate alone
	// never determined the condition code; it only looked that way while every Std
	// compare was a signed i64. See X64CondCode and specs-shv2/float-compare-branch.md.
	cmp(resultId ValueId, lhs ValueId, rhs ValueId, pred StdCmpPred, operandType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: true}
	// Binary op with a CONSTANT right operand folded to an immediate: `resultId =
	// lhs <opcode> imm`. Produced by `foldConstOperands` from a `binOp` whose rhs
	// was a `const` (the const op is then DCE'd), so the literal never occupies a
	// register. The x64 lowering picks a copy-free 3-operand form per opcode: `add`
	// to `lea dest, [lhs + imm]`, `sub` to `lea dest, [lhs - imm]`, `mul` to `imul
	// dest, lhs, imm` — none of which is two-address, so no seed copy is ever
	// emitted. `isPure` (integer add/sub/mul never trap); `clobbersFlags: true` (the
	// `imul` lowering writes EFLAGS; the `lea` forms do not, but the flag is a "may
	// clobber" over-approximation the scheduler treats as a barrier). APPENDED at the
	// END of the arith band, after `cmp`, honoring the band-append invariant.
	//
	// ⭐⭐ INTEGER ONLY — it carries NO `operandType`, and that is a statement about the
	// HARDWARE, not a convention. There is no SSE form that takes an immediate: `addsd`
	// reads its right operand from a register or from memory, never from an encoded
	// constant. So a float `binOp` CANNOT fold to this op, `foldConstOperands` must
	// refuse a float rhs, and the absence of the field is what says so.
	//
	// ⚠ THE FOLD IS A WRONG-ANSWER SITE IF IT DOES NOT CHECK. Fold `3.5 > 9.5` and the
	// IEEE bit patterns go through an INTEGER `cmp reg, imm32`. It would even give the
	// right answer for most inputs — positive doubles happen to order correctly when
	// compared as sign-magnitude integers — so the tests that would catch it are the
	// ones with a negative operand or a NaN, not the ones named "float comparison".
	binOpImm(resultId ValueId, lhs ValueId, imm Imm32, opcode StdBinOpcode) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Comparison with a CONSTANT right operand folded to an immediate: `resultId =
	// lhs <pred> imm`, producing an i1. Produced by `foldConstOperands` from a `cmp`
	// whose rhs was a `const` (canonicalized there so the const lands on the rhs, with
	// the predicate flipped when the const started on the lhs). Lowers to `cmp reg,
	// imm32` so the literal needs no register. Same `isCmp`/`isPure`/`clobbersFlags`
	// profile as `cmp`. APPENDED at the END of the arith band, after `binOpImm`.
	cmpImm(resultId ValueId, lhs ValueId, imm Imm32, pred StdCmpPred) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: true}
	// Signed integer division `resultId = lhs / rhs` (quotient), TRUNCATING toward
	// zero. SPLIT OUT of `binOp` — it does NOT ride the `StdBinOpcode` opcode field —
	// because x64 `idiv` can FAULT (#DE on divide-by-zero and on INT_MIN / -1
	// overflow), so it declares `isPure: false` (it may NOT be dropped, duplicated, or
	// reordered when its result is unused), which the shared `binOp` metadata cannot
	// express through an opcode. `clobbersFlags: true` (idiv leaves EFLAGS undefined —
	// a "may clobber" the scheduler treats as a barrier). The divide-by-zero / overflow
	// TRAP itself is delivered by the runtime fault handler (a Workstream-R / M6
	// deliverable), NOT guarded by the compiler. APPENDED at the END of the arith band,
	// after `cmpImm`, honoring the band-append invariant.
	div(resultId ValueId, lhs ValueId, rhs ValueId) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Signed integer modulo `resultId = lhs mod rhs` (remainder), matching `div`'s
	// truncation. Same `isPure: false` (idiv faults) + `clobbersFlags: true` profile as
	// `div` — it is the SAME x64 `idiv` instruction, reading the REMAINDER out of RDX
	// instead of the quotient out of RAX. APPENDED at the END of the arith band, after
	// `div`, honoring the band-append invariant.
	mod(resultId ValueId, lhs ValueId, rhs ValueId) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// --- band: control ---
	// Two-way conditional branch terminator: transfer to `thenBlockId` if `condId`
	// (an i1) holds, else to `elseBlockId`. M4's `if` lowers to this. Not pure (a
	// terminator cannot be dropped or reordered); does not clobber flags (the x64
	// `jcc` READS flags, it does not set them — the preceding `cmp` set them).
	condBranch(condId ValueId, thenBlockId BlockId, elseBlockId BlockId) = StdOpMeta{category: StdOpCategory.control, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Unconditional branch terminator to `targetBlockId` (a then/else block falling
	// through to the merge block). Same non-pure, flag-neutral profile as condBranch.
	branch(targetBlockId BlockId) = StdOpMeta{category: StdOpCategory.control, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// --- band: call ---
	// Return terminator. `retValId` names the value moved into the return register.
	ret(retValId ValueId) = StdOpMeta{category: StdOpCategory.call, role: OpRole.ret, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Parameter materialization at function entry: `resultId` is the SSA value of
	// parameter `index` (M5: the two coincide — a parameter is ValueId `index`), of
	// type `paramType`. Emitted once per parameter at the entry block; the x64
	// lowering turns it into `mov virtual(resultId), physical(argReg[index])` so the
	// parameter's incoming ABI register is captured into its virtual register. `role`
	// is `param`; `isCall: true` marks it a scheduling barrier that must stay at entry
	// (per the StdOpMeta `isCall` contract, which names `param`), and `isPure: false`
	// keeps it from being reordered or dropped. APPENDED at the END of the call band,
	// after `ret`, honoring the band-append invariant.
	param(resultId ValueId, index ParamCount, paramType StdType) = StdOpMeta{category: StdOpCategory.call, role: OpRole.param, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: true, clobbersFlags: false, isCmp: false}
	// A direct function call `resultId = callee(args…)`. `callee` is the resolved
	// function name; `args` are the argument SSA values in the callee's PARAMETER
	// order (lowerCall has already reordered any labelled arguments to declaration
	// order). The x64 lowering moves each arg into its ABI register, emits the
	// `callDirect`, then moves the R8 return value into `resultId`. Full call-barrier
	// metadata (`isCall`/`isMemory`/`isStore`/`clobbersFlags` all true, `isPure` false
	// — a call may read/write memory and must not move or drop). APPENDED at the END of
	// the call band, after `param`.
	call(resultId ValueId, callee ByteArray, args ValueIdArray) = StdOpMeta{category: StdOpCategory.call, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// Void return terminator — the return of a function with no `returns` clause. A
	// DISTINCT variant rather than a `ret` carrying some absent-value ValueId: `ValueId`
	// has no "absent" value, and a sentinel one would be READ as a real use by
	// `collectStdOpUses` (keeping a dead value live, or naming a value that was never
	// defined). Its Maxon-tier twin `MaxonOp.retVoid` splits for the same reason.
	//
	// Carries no operand at all, so it reads nothing and rewrites nothing; the x64
	// lowering emits the bare `ret` (the frame teardown is the prologue/epilogue pass's).
	// APPENDED at the END of the call band, after `call` — which is also the end of the
	// union, so the two range arms that stop at `call` (FoldConstOperands) had to be
	// extended by hand. See the band-append invariant in the StdOp header.
	retVoid = StdOpMeta{category: StdOpCategory.call, role: OpRole.ret, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// --- band: memory (P1.0d.5b — top-level `var`) ---
	//
	// ⭐ THREE OPS, NOT A FUSED `globalLoad`/`globalStore` PAIR, and the split is the point.
	// A global's read is `globalAddr` + `loadIndirect`, and its write is `globalAddr` +
	// `storeIndirect` — the SAME general pair a struct field (P1.1) and a heap value (P1.2)
	// need, reached one milestone early rather than as a special case that has to be undone.
	// This is v1's shape verbatim (`maxon-selfhosted/Compiler/Runtime/runtime.std:30-31`:
	// `v1 = std globalAddr __mm_alloc_count` then `v2 = std loadIndirect v1 0`), and it is
	// what starts retiring PLAN.md's R1 blocker — that the Std tier produces only
	// `arith`/`call`, so the Std-IR runtime route has no ops to land on.
	//
	// APPENDED PAST THE END OF THE UNION (`retVoid` was the last variant), which is the
	// band-append invariant working in the reviewer's favour: every stale `… to retVoid` /
	// `… to call` range arm now FAILS TO COMPILE until it is consciously extended. Measured:
	// appending these produced 7 loud E2026 non-exhaustive errors and ZERO silent swallows.
	// (The "silently swallows" danger is INSERTING MID-BAND, which this is not.)
	//
	// The ADDRESS of a data-section global. `label` is identifier TEXT, not a value — the
	// same name/value split `call`'s `callee` follows — and it is the label the backend
	// resolves against `GlobalDataTable.dataSection`. `isPure: true` (it recomputes an
	// address that cannot change, so it is freely REMATERIALIZABLE — an x64 `lea
	// [rip+disp32]` needs no input register at all) and `isMemory: false` (it computes an
	// address; it does not TOUCH memory — nothing is loaded).
	globalAddr(resultId ValueId, label ByteArray) = StdOpMeta{category: StdOpCategory.memory, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Read `valueType` bytes from `addrId + offset` into `resultId`.
	//
	// ⚠ **`isPure: false`, AND THAT IS THE CORRECT DECLARATION, NOT A CONSERVATISM.** A load
	// is side-effect-FREE in the everyday sense — it writes nothing — and calling it pure on
	// that basis is precisely the trap. `isPure` here licenses a pass to DUPLICATE, REORDER or
	// DROP the op, and a load may do none of those: what it reads is a mutable location some
	// OTHER op writes. Declared pure, a global's read would HOIST OUT of a loop that writes the
	// global (`specs/short-circuit-evaluation.md`'s `short-circuit-in-while-condition` reads
	// and writes `trace` every iteration), and the loop would then read a stale value for ever.
	// That is a SILENT WRONG ANSWER, not a crash. Purity is "may this op be moved?", and the
	// answer for a load is no. `clobbersFlags: false` is exact: `mov`/`movzx` write no flags.
	//
	// ⚠ **NOTHING READS THIS FLAG YET — see the `isPure` field's own note and OPEN.md #27.** The
	// value above is right and must stay right; it is simply not what makes the property hold
	// today. Do not "verify" it by running a spec: none can fail on it.
	loadIndirect(resultId ValueId, addrId ValueId, offset ByteOffset, valueType StdType) = StdOpMeta{category: StdOpCategory.memory, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Write `valueId` as `valueType` bytes to `addrId + offset`. `isStore: true` (it writes
	// memory, so it must order against every later load — the metadata contract's own words),
	// `isPure: false`. APPENDED at the END of the memory band, after `loadIndirect`.
	storeIndirect(addrId ValueId, offset ByteOffset, valueId ValueId, valueType StdType) = StdOpMeta{category: StdOpCategory.memory, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: true, isCall: false, clobbersFlags: false, isCmp: false}
	// --- band: system (P1.0r — the allocator's page source) ---
	//
	// ⭐ THE FIRST PRODUCER OF THE `system` BAND, and the band is why this op is spelled this way
	// rather than as an `importCall(slot IatSlot, …)` in the `call` band. Two independent reasons,
	// and both are load-bearing:
	//
	// 1. **TIERING.** `IatSlot` is a WINDOWS PE concept (`Targets/Windows/PeWriter.maxon`), and it
	//    is referenced nowhere outside `Targets/`. Naming it here would put a PE import-table index
	//    in the target-NEUTRAL mid-level tier — the tier ARCHITECTURE says the wasm backend will
	//    consume directly. `osAllocPages` says WHAT is wanted (pages) and lets each backend say HOW
	//    (x64-windows: `VirtualAlloc` through the IAT; Linux: `mmap`; wasm: `memory.grow`). BOTH
	//    reference compilers independently refuse the leak: v1 has `std osAllocPages <size>`, and
	//    the bootstrap has `IEmitterBackend.OsAllocPages` with `VirtualAlloc` appearing in zero
	//    files above backend tier.
	// 2. **THE BAND-APPEND INVARIANT.** The `call` band ends at `retVoid` — MID-UNION — so a variant
	//    appended there is SILENTLY swallowed by every range arm spanning it. The `system` band sits
	//    past `storeIndirect`, i.e. at the END of the union, where an append is LOUD: measured, this
	//    one produced 12 E2026 non-exhaustive errors and zero silent swallows. The safer band is
	//    also the correct one.
	//
	// `sizeId` is a VALUE (the byte count), not a name — the same value/name split `call`'s `callee`
	// and `globalAddr`'s `label` sit on the other side of. The result is the base address of a
	// freshly-committed, OS-ZEROED region, which is what lets `__slab_alloc` hand out bump slots
	// without memzeroing them (see ARCHITECTURE.md → "Allocator: the zeroing contract").
	//
	// Full call-barrier metadata: it IS a call once lowered (an indirect call through the IAT), so
	// it clobbers the caller-saved registers and may observe or modify arbitrary memory.
	// `isUnsupportedInInlineBody: true` per that field's own contract, which names v1's
	// `indirectCall` as its example — this lowers to exactly that, and it escapes the inliner's
	// static-callee model.
	osAllocPages(resultId ValueId, sizeId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// Write `lenId` bytes starting at `bufId` to STDOUT (P1.2 wave A — `print`). A `system`-band op for
	// the same two reasons `osAllocPages` is: it says WHAT is wanted (bytes to stdout) and lets each
	// backend say HOW (x64-windows: `GetStdHandle`+`WriteFile` through the IAT; a wasm backend would
	// name its own), keeping the Win32 import table out of the target-neutral tier; and it appends at
	// the END of the union, where the append is LOUD (every `… to osAllocPages` range arm fails to
	// compile until consciously extended). It DEFINES NO VALUE — `print` returns void — so it carries
	// no result id. Full call-barrier metadata (it IS an indirect call once lowered), exactly like
	// `osAllocPages`.
	osWriteStdout(bufId ValueId, lenId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// The RIP-relative ADDRESS of an `.rdata` constant — a String literal's 48-byte record (P1.2 wave
	// A). The `.rdata` twin of `globalAddr`: identical operand shape (a `label` NAME, one plain def, no
	// value use) and identical metadata (`isPure: true` — it recomputes an address that cannot change,
	// freely rematerializable; `isMemory: false` — a `lea` touches no memory). They are TWO ops rather
	// than one with a section field because the section is the whole difference the relocation kind
	// carries: `globalAddr` lowers to a `.data` relocation (`dataSectionRipRelDisp32`), this to an
	// `.rdata` one (`ripRelDisp32`). APPENDED at the END of the union, past `osWriteStdout` — its
	// `memory` category is metadata independent of this position, and a mid-band insert would be
	// silently swallowed by the `branch to osAllocPages` full-tail range arms in the backend.
	rdataAddr(resultId ValueId, label ByteArray) = StdOpMeta{category: StdOpCategory.memory, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// --- P1.4b: scalar error handling ---
	//
	// ⚠ APPENDED PAST THE END OF THE UNION (`rdataAddr` was the last variant), which is the band-append
	// invariant working in the reviewer's favour: every stale `… to rdataAddr` full-tail range arm now
	// FAILS TO COMPILE until it is consciously extended. The `category` metadata places each variant
	// logically (a `call`-band `tryCall`, a `call`-band `errorReturn`, a `system`-band `osExit`)
	// independently of this tail position.
	//
	// A throwing direct call `resultId = try callee(args…)` — defines TWO results: `resultId` (primary
	// value from R8 / x0) and `errorFlagId` (the dual-register error flag from R10 / x9). Metadata
	// identical to `call`: full call-barrier semantics. The x64/arm64 lowering captures BOTH return
	// registers through the parallel-copy resolver (never a naive `mov;mov`, which collapses a
	// value/flag swap — see StdToX64Conversion.lowerTryCall).
	tryCall(resultId ValueId, errorFlagId ValueId, callee ByteArray, args ValueIdArray) = StdOpMeta{category: StdOpCategory.call, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// The DUAL-REGISTER epilogue terminator: write `retValId` to the primary return register (R8 / x0)
	// and `errorFlagId` to the error-flag register (R10 / x9), then the return terminator. This is the
	// ONE place the second register is written, and `role: OpRole.errorReturn` — the placeholder
	// declared since M1 — finally gets its producer. `isPure: true` mirrors `ret`. `isUnsupportedInInlineBody:
	// true` matches the field's own documented example (v1 lists `errorReturn`): a dual-register exit
	// terminator escapes the inliner's static-callee model. The flag has no reader yet, so this is a
	// declaration awaiting one — but the value is the debugged one. APPENDED here, past `rdataAddr`.
	errorReturn(retValId ValueId, errorFlagId ValueId) = StdOpMeta{category: StdOpCategory.call, role: OpRole.errorReturn, isPure: true, isUnsupportedInInlineBody: true, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Terminate the process with exit code `codeId` — the primitive a user `panic(...)` ends on (via the
	// `__abort` runtime graph). A `system`-band op for the same two reasons `osAllocPages`/`osWriteStdout`
	// are: it says WHAT is wanted (exit with a code) and lets each backend say HOW (x64-windows:
	// `ExitProcess` through the IAT; arm64-macOS: the `_exit` import), keeping the OS ABI out of the
	// target-neutral tier; and it appends at the END of the union, where the append is LOUD. Full
	// call-barrier metadata: it IS a diverging call once lowered.
	osExit(codeId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// --- P1.5-A1: non-capturing function values ---
	//
	// ⚠ APPENDED PAST THE END OF THE UNION (`osExit` was the last variant), which is the band-append
	// invariant working in the reviewer's favour: every stale `… to osExit` / `branch to osAllocPages`
	// full-tail range arm now FAILS TO COMPILE until it is consciously extended. The `category` metadata
	// places each variant logically (a `memory`-band `funcAddr`, a `call`-band `callIndirect`)
	// independently of this tail position.
	//
	// The RIP-relative ADDRESS of a named function — the `.text` twin of `globalAddr` (`.data`) and
	// `rdataAddr` (`.rdata`): identical operand shape (a `funcName` NAME, one plain def, no value use) and
	// identical metadata (`isPure: true` — it recomputes an address that cannot change, freely
	// rematerializable; `isMemory: false` — a `lea` touches no memory). They are distinct ops rather than
	// one with a section field because the section is the whole difference the relocation kind carries:
	// `globalAddr`→a `.data` reloc, `rdataAddr`→an `.rdata` one, this→a `.text` function-symbol fixup (x64
	// `CallFixup`, resolved intra-`.text` by `resolveCallFixups`).
	funcAddr(resultId ValueId, funcName ByteArray) = StdOpMeta{category: StdOpCategory.memory, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// A call THROUGH a function VALUE — `resultId = calleeReg(args…)`. `calleeReg` is the SSA value holding
	// the code pointer (from a `funcAddr`, a param, or a field load), NOT a name — the whole reason it is
	// distinct from `call`. Metadata identical to `call`: full call-barrier semantics. The x64/arm64
	// lowering moves each arg into its ABI register, calls THROUGH the callee register (`callReg` /
	// `arm64BranchLinkReg`), then moves the return value into `resultId`.
	//
	// ⭐ IT CARRIES THE FUNCTION VALUE'S SIGNATURE — `resultType` (the result's return type) and
	// `argFloatMask` (bit k set iff argument k is a float) — because, unlike a direct `call`, there is NO
	// callee NAME to recover it from (`calleeResultClasses` / `calleeParamClasses` are keyed by name).
	// Without it every backend assumed an INTEGER result and integer args, so a float-returning or
	// float-taking function value colored a move across register files (P1.5 #78). The FRONT END already
	// types the result value and every arg value, so `lowerIndirectCall` reads both straight off `stdTypeOf`
	// — no parser or Maxon-op change. A backend routes arg `k` to a float or GPR register by bit `k` of the
	// mask (`args`'s trailing entry, the uniform-ABI env pointer, is never float) and captures the result by
	// `resultType`, exactly as a direct call reads the callee's declared types.
	//
	// ⭐ `resultType` IS A `StdReturnType`, NOT A BARE `StdType` — the union `void | value(StdType)` — because
	// an indirect callee can be genuinely VOID with NO result at all: the per-element destructor
	// (`__str_decref`/`__destruct_<T>`/`__mm_decref`/`__arr_decref`, a `(param i64)` void function) the array
	// drop walk invokes (`ArrayRuntime.emitElementDestroyRange`). A void function VALUE (`let cb = doIt; cb()`)
	// is DIFFERENT and stays `value(i64)`: it routes through a `__fnref_` thunk that returns a dummy i64, so
	// its `call_indirect` functype `(…)->i64` matches the thunk (LowerMaxonToStd.indirectResultType). The raw
	// void destructor has no such thunk — its true type is `(param i64)` with no result — so on `void` the
	// wasm functype interns ZERO results and the native backends capture no result register. Making the whole
	// wasm signature (not just the width) exact is what stops the `call_indirect` type check from trapping.
	//
	// ⚠ `resultType`/`argFloatMask` ARE SCALARS, DELIBERATELY. A per-arg `StdTypeArray` here would be a SECOND
	// managed field on the variant, which the bootstrap that compiles shv2 mishandles in the union's
	// synthesized destructor — a wild free surfacing as an unrelated `mm_decref` underflow at teardown, on
	// EVERY indirect call. `StdReturnType` is a VALUE union (its `value` arm wraps the enum `StdType`, no
	// heap), so it adds no managed field: `argFloatMask` and it keep `callIndirect` at ONE managed field
	// (`args`) exactly like its original shape — the same allocation-flat idiom `CalleeParamClassMap`'s
	// `ParamFloatMask` uses caller-side for the identical question. `args` stays LAST (the one managed field),
	// scalars first. Both are METADATA, not value operands: `collectStdOpUses`/`remapStdOpUses` leave them
	// untouched.
	callIndirect(resultId ValueId, calleeReg ValueId, resultType StdReturnType, argFloatMask ArgFloatMask, args ValueIdArray) = StdOpMeta{category: StdOpCategory.call, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// A ranged-typealias RANGE-CHECK PANIC (P1.9): abort with the interned message at `.rdata` label
	// `label`, printing it plus a symbolized backtrace and exiting 1. A `system`-band op — the same
	// shape and rationale as `osExit`/`osWriteStdout`: it says WHAT is wanted (panic with this message)
	// and each backend says HOW (x64 loads the address into the ABI's first-arg register and calls the
	// `mrt_panic` runtime chunk; arm64/wasm have no panic runtime yet and reject it). It is spelled as a
	// dedicated op rather than an `StdOp.call` because `mrt_panic` is a hand-assembled runtime chunk with
	// NO Std function, so the callee-argument-class lookup a normal `call` performs has nothing to resolve
	// against — exactly why `osExit`/`osAllocPages` are their own ops too. `isCall: true` so
	// `functionMakesCall` reserves the shadow space the call needs; it defines no value and never returns.
	//
	// ⚠ APPENDED PAST THE END OF THE UNION, past `callIndirect`, per the band-append invariant: every
	// stale `… to callIndirect` full-tail range arm now FAILS TO COMPILE until it is consciously extended
	// (the invariant working in the reviewer's favour). Its `category: system` places it logically,
	// independent of this tail position.
	osRangePanic(label ByteArray) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// --- P1.5 mid-body-yield: the two OS-import primitives the green-thread SLEEP substrate needs ---
	//
	// ⚠ APPENDED PAST THE END OF THE UNION (`osRangePanic` was the last variant), per the band-append
	// invariant: every stale `… to osRangePanic` full-tail range arm now FAILS TO COMPILE until it is
	// consciously extended (the invariant working in the reviewer's favour). Their `category: system`
	// places them logically in the system band, independent of this tail position.
	//
	// Both are `system`-band ops for the SAME two reasons `osAllocPages`/`osWriteStdout` are: they say WHAT
	// is wanted (read the monotonic clock into two out-param buffers; sleep the OS thread N milliseconds) and
	// let each backend say HOW (x64-windows: `QueryPerformanceFrequency`/`QueryPerformanceCounter`/`Sleep`
	// through the IAT, `Targets/Windows/PeWriter.maxon`; arm64/wasm/x64-linux have no clock/sleep primitive
	// at this rung and reject it), keeping the Win32 import table out of the target-neutral tier. Full
	// call-barrier metadata: each IS an indirect call once lowered, exactly like `osAllocPages`.
	//
	// `osReadClock(ticksPtr, freqPtr)` writes QueryPerformanceCounter's tick count to `[ticksPtr]` and
	// QueryPerformanceFrequency's frequency to `[freqPtr]` — two VALUE operands (the out-param addresses,
	// computed by the builder via `globalAddr` of two `.data` scratch slots), no result. The
	// ticks→nanoseconds arithmetic stays BUILDER-BUILT (`__gt_now_ns` in GtRuntime.maxon) using the split
	// identity `ns = (ticks/freq)*1e9 + ((ticks mod freq)*1e9)/freq`, which is overflow-safe in plain 64-bit
	// Std ops for any realistic QPF (≤ a few GHz) and centuries of uptime — so no 128-bit MUL/DIV, and no new
	// Target op, is needed. It keeps the clock math in the Std tier the rewrite's thesis puts it in.
	osReadClock(ticksPtrId ValueId, freqPtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// `osSleepMs(ms)` sleeps the OS thread for `ms` milliseconds (Windows `Sleep(ms)`) — the netpoller's real
	// wait on the earliest timer deadline (never a busy-spin). One VALUE operand (the millisecond count), no
	// result. APPENDED at the END of the union, after `osReadClock`.
	osSleepMs(msId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// --- P1.5 subprocess seed: the five OS-import primitives the green-thread SUBPROCESS substrate needs ---
	//
	// ⚠ APPENDED PAST THE END OF THE UNION (`osSleepMs` was the last variant), per the band-append invariant:
	// every stale `… to osSleepMs` full-tail range arm now FAILS TO COMPILE until it is consciously extended (the
	// invariant working in the reviewer's favour). Their `category: system` places them logically in the system
	// band, independent of this tail position.
	//
	// All five are `system`-band ops for the SAME two reasons `osAllocPages`/`osReadClock`/`osSleepMs` are: they
	// say WHAT is wanted (spawn a child, wait on a handle, read an exit code, close a handle) and let each backend
	// say HOW (x64-windows: `CreateProcessA`/`WaitForSingle`|`MultipleObjects`/`GetExitCodeProcess`/`CloseHandle`
	// through the IAT, `Targets/Windows/PeWriter.maxon`; arm64/wasm have no subprocess primitive at this rung and
	// reject it), keeping the Win32 import table out of the target-neutral tier. Full call-barrier metadata: each
	// IS an indirect call once lowered, exactly like `osAllocPages`.
	//
	// ⭐ ONLY `osWaitHandle` DEFINES A VALUE, and it is declared LAST among the five for that reason: keeping the
	// four result-less ops contiguous lets the value-class classifiers (`recordOpResultClass`, `stdOpDefinesValue`,
	// `stdOpDefinedIdOrZero`) cover them with ONE range arm instead of carving `osWaitHandle` out of a range's
	// middle. The other four consume their `BOOL` result via MEMORY (an exit code lands in `codePtr`) or ignore it
	// (the netpoll re-scans after `osWaitHandles`), exactly as `osWriteStdout` ignores `WriteFile`'s `BOOL` — so
	// they carry no result id and their x64 lowering emits no RAX capture.
	//
	// `osProcessSpawn(cmdlinePtr, startupPtr, procInfoPtr)` = `CreateProcessA(NULL, cmdlinePtr, NULL, NULL, FALSE,
	// 0, NULL, NULL, startupPtr, procInfoPtr)`. Three VALUE operands (the mutable cmdline buffer + the two OUT
	// structs); ten Win64 arguments, six of them on the stack (see `win64OutgoingArgDisp`). It is the only op here
	// with outgoing stack-argument space (`stdOpOutgoingArgBytes`), which is why it is declared FIRST.
	osProcessSpawn(cmdlinePtrId ValueId, startupPtrId ValueId, procInfoPtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// `osProcessExitCode(handle, codePtr)` = `GetExitCodeProcess(handle, codePtr)` — writes the child's DWORD exit
	// code to `[codePtr]` (an out-param buffer, like `osReadClock`'s). Two VALUE operands, no result.
	osProcessExitCode(handleId ValueId, codePtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// `osWaitHandles(handleArrayPtr, count, timeoutMs)` = `WaitForMultipleObjects(count, handleArrayPtr, FALSE,
	// timeoutMs)` — the netpoll's single-M block on the parked children (and the earliest timer delta). Three VALUE
	// operands, no result: the netpoll re-scans each handle with `osWaitHandle(h, 0)` after the wait returns, so
	// the aggregate wait result is not read.
	osWaitHandles(handleArrayPtrId ValueId, countId ValueId, timeoutMsId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// `osCloseHandle(handle)` = `CloseHandle(handle)`. One VALUE operand, no result (the `BOOL` is ignored, like
	// `osWriteStdout`'s).
	osCloseHandle(handleId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// `osWaitHandle(handle, timeoutMs)` = `WaitForSingleObject(handle, timeoutMs)` — the per-handle poll
	// `__gt_proc_check` runs with `timeoutMs = 0` to test `== WAIT_OBJECT_0 (0)`. THE ONE op here that DEFINES a
	// value (the wait result, a GPR i64 captured from RAX). Declared LAST so the four result-less ops stay
	// contiguous (see the ⭐ note above).
	osWaitHandle(resultId ValueId, handleId ValueId, timeoutMsId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// --- P1.5-B1a′ relocating morestack: the page-FREE twin of `osAllocPages` ---
	//
	// ⚠ APPENDED PAST THE END OF THE UNION (`osWaitHandle` was the last variant), per the band-append invariant:
	// every stale `… to osWaitHandle` full-tail range arm now FAILS TO COMPILE until it is consciously extended
	// (the invariant working in the reviewer's favour). Its `category: system` places it logically in the system
	// band, independent of this tail position.
	//
	// `osFreePages(addr)` RELEASES a page region an earlier `osAllocPages` committed — the free twin the bump heap
	// (which never frees) never needed, but the green-thread scheduler does: a completed GT's stack (possibly GROWN
	// by the morestack, so of a size only the runtime knows) is released here, on `__gt_drive_until`'s completion
	// path, so a spawn/await loop stays bounded without the fixed-size free-list the 1 MiB rung used. ONE VALUE
	// operand (the region base), no result — the mirror of `osExit`/`osCloseHandle`. It carries no SIZE because the
	// x64-windows page source (`VirtualFree(addr, 0, MEM_RELEASE)`) frees the whole reservation from its base alone.
	//
	// ⭐ x64-WINDOWS ONLY, exactly like its five subprocess siblings and the two sleep ops above it — the whole
	// green-thread substrate is x64-windows-gated at this rung, and `osFreePages` is emitted ONLY inside that
	// substrate (`__gt_drive_until`), so its arm64/linux/wasm lowerings reject rather than implement an untested
	// `munmap`/`memory`-shrink that no test could ever reach (see StdToX64/StdToArm64/StdToWasm). Full call-barrier
	// metadata: it IS an indirect call once lowered, exactly like `osAllocPages`.
	osFreePages(addrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: true, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// --- P1.1b slice 2: the DENSE-match jump table ---
	//
	// ⚠ APPENDED AT THE VERY END OF THE UNION, past `osFreePages` (the last `system`-band op), per the
	// band-append invariant: a mid-band insert is silently swallowed by a `… to X` range arm. Its
	// `StdOpCategory.control` is metadata — the switch IS a control-flow terminator, the Std twin of
	// `condBranch`/`branch` — recorded independent of this tail position (those two sit in the `control`
	// band up front; a range arm reading the control band by ordinal never reaches here, so the position is
	// safe and the category honest).
	//
	// ⭐ **THE MULTIWAY BRANCH TERMINATOR** — the Std twin of `MaxonOp.switch`, which lowers to it 1:1.
	// `subjectId` is the already zero-biased index; `denseTargetBlockIds[i]` is the block a biased subject
	// value `i` transfers to, holes filled with `defaultBlockId`; an out-of-range value (UNSIGNED) reaches
	// `defaultBlockId`. Same profile as `branch` — control, not pure, not a compare, no memory/store/call.
	// The backends lower it to the target jump-table op (`x64JumpTable`/`arm64JumpTable`) or, on wasm, an
	// inner `br_table`. Its array field is bound only in dedicated small matches, never in
	// `collectStdOpUses`/`remapStdOpUses`'s big ones (which read/rewrite only `subjectId`).
	switch(subjectId ValueId, denseTargetBlockIds BlockIdArray, defaultBlockId BlockId) = StdOpMeta{category: StdOpCategory.control, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// --- P1.7a slice 2a: the FUSED witness call (constrained-type-parameter interface dispatch) ---
	//
	// ⚠ APPENDED AT THE VERY END OF THE UNION, past `switch`, per the band-append invariant: a mid-union
	// insert is silently swallowed by a `… to X` range arm. Its `category: call` is metadata placing it
	// logically in the call band, independent of this tail position.
	//
	// ⭐ **LOAD-AND-CALL IN ONE OP, so the loaded function pointer NEVER occupies a virtual register** — v1's
	// load-bearing perf decision, taken from day one. `resultId = (*[witnessAddr + 24 + 8*methodIndex])(args…)`:
	// the callee pointer is read from witness-table slot `methodIndex` off `witnessAddr` (the threaded witness
	// parameter, a `.rdata` table address) and called in the SAME instruction — the x64 lowering emits a
	// memory-indirect `call qword [witnessAddr + off]`, never a load-into-register then `call reg`. Fusing it
	// is the whole point: a separate `loadIndirect` + `callIndirect` would give the fn-ptr an SSA value the
	// register allocator must color and keep live across the argument moves, on the hottest dispatch shape a
	// generic collection has.
	//
	// It is `callIndirect` with the callee expressed as a MEMORY ADDRESS (base + offset) rather than a
	// register: identical `resultType`/`argFloatMask`/`args` shape and identical full-call-barrier metadata,
	// so it shares that op's argument-marshaling and result-capture lowering verbatim. `witnessAddr` is a
	// VALUE USE (the table address must be live at the call); `methodIndex` is metadata (the slot). `args`
	// stays LAST (the ONE managed field, receiver at index 0), scalars first — the same allocation-flat shape
	// `callIndirect` documents (a second managed field breaks the bootstrap's synthesized destructor). x64
	// only at this slice: arm64/wasm loudly refuse (the witness blob rides the x64 `funcAbs64InRdata` reloc).
	witnessCall(resultId ValueId, witnessAddr ValueId, methodIndex WitnessMethodIndex, resultType StdReturnType, argFloatMask ArgFloatMask, args ValueIdArray) = StdOpMeta{category: StdOpCategory.call, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// --- P1.5 dogfood slice 1a: the IOCP overlapped-read substrate's OS-import primitives ---
	//
	// ⚠ APPENDED AT THE VERY END OF THE UNION, past `switch` (a `control`-band op physically at the tail), per the
	// band-append invariant: every stale `… to switch` / `… to osFreePages` full-tail range arm now FAILS TO COMPILE
	// until it is consciously extended (the invariant working in the reviewer's favour, and how these ops found every
	// site that must classify or lower them). Each carries `category: system` (metadata placing it logically in the
	// system band, independent of this tail position) — the same shape and rationale as the P1.5 subprocess ops:
	// each says WHAT is wanted and lets each backend say HOW, keeping the Win32 import table out of the target-neutral
	// tier. ⭐ x64-WINDOWS ONLY, like the whole green-thread substrate; every other backend REJECTS them (they are
	// emitted only inside the x64-windows-gated IOCP runtime, so a linux/arm64/wasm lowering would be untested dead
	// code no test could reach). Full call-barrier metadata: each IS one or more indirect calls once lowered.
	//
	// The FIVE value-defining ones — `osIocpCreate`, `osEventCreate`, `osThreadCreate`, `osReadOverlapped`,
	// `osLastError` — DEFINE a result (a HANDLE, a BOOL, or an error code captured from RAX). The rest consume their
	// result via MEMORY (an out-param pointer) or ignore it (a lock op's void return), so they carry no result id, as
	// `osCloseHandle`/`osWaitHandles` do.
	//
	// `osPipeCreate(namePtr, saPtr, iocp, readPtr, writePtr)` = create ONE overlapped read pipe: CreateNamedPipeW(name,
	// INBOUND|OVERLAPPED|FIRST_PIPE_INSTANCE, …) → the parent READ end stored to `[readPtr]`; CreateFileW(name,
	// GENERIC_WRITE, …, saPtr=inheritable, OPEN_EXISTING, …) → the inheritable child WRITE end stored to `[writePtr]`;
	// SetHandleInformation strips inheritance from the read end; CreateIoCompletionPort registers the read end with
	// `iocp` and SetFileCompletionNotificationModes sets FILE_SKIP_COMPLETION_PORT_ON_SUCCESS. Five VALUE operands, no
	// result (the two handles land in memory). Ports v1's `__subp_create_overlapped_pipe` read path.
	osPipeCreate(namePtrId ValueId, saPtrId ValueId, iocpId ValueId, readPtrId ValueId, writePtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osIocpCreate()` = `CreateIoCompletionPort(INVALID_HANDLE_VALUE, NULL, 0, 1)` — create the process-wide IOCP. No
	// value operands; DEFINES the port handle (captured from RAX).
	osIocpCreate(resultId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osEventCreate()` = `CreateEventA(NULL, FALSE, FALSE, NULL)` — an AUTO-RESET, initially-unsignaled event (the
	// netpoll's wake). No value operands; DEFINES the event handle.
	osEventCreate(resultId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osThreadCreate(entryPtr)` = `CreateThread(NULL, 0, entryPtr, NULL, 0, NULL)` — start the IOCP completion thread.
	// One VALUE operand (the `.text` entry address, from a `funcAddr`); DEFINES the thread handle.
	osThreadCreate(resultId ValueId, entryPtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osLockInit(lockPtr)` = `InitializeCriticalSection(lockPtr)`. One VALUE operand (the CRITICAL_SECTION region), no result.
	osLockInit(lockPtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osLockEnter(lockPtr)` = `EnterCriticalSection(lockPtr)` — the run-queue guard's acquire at a main-thread mutation
	// site (the completion thread acquires it DIRECTLY in the hand-assembled loop, not through this op). One VALUE operand, no result.
	osLockEnter(lockPtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osLockLeave(lockPtr)` = `LeaveCriticalSection(lockPtr)`. One VALUE operand, no result.
	osLockLeave(lockPtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osReadOverlapped(handle, buf, cap, bytesOutPtr, ovl)` = `ReadFile(handle, buf, cap, bytesOutPtr, ovl)` — issue the
	// overlapped read. FIVE args (`ovl` is the 5th, a stack arg); DEFINES the BOOL result (captured from RAX): nonzero =
	// SYNCHRONOUS completion (with FILE_SKIP_COMPLETION_PORT_ON_SUCCESS, no IOCP packet posts — `[bytesOutPtr]` has the
	// count and the caller must NOT yield); zero = the read is queued OR failed — the caller reads `osLastError` to
	// distinguish ERROR_IO_PENDING (yield) from ERROR_BROKEN_PIPE (EOF) from a real error.
	osReadOverlapped(resultId ValueId, handleId ValueId, bufId ValueId, capId ValueId, bytesOutPtrId ValueId, ovlId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osLastError()` = `GetLastError()` — the thread's last-error, read IMMEDIATELY after a failing `osReadOverlapped` (no
	// intervening call clobbers it — the shim's TIB writes do not touch the TEB's LastError word). No value operands; DEFINES the code.
	osLastError(resultId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
	// `osProcessSpawnInherit(cmdlinePtr, startupPtr, procInfoPtr)` = `CreateProcessA(NULL, cmdlinePtr, NULL, NULL, TRUE, 0,
	// NULL, NULL, startupPtr, procInfoPtr)` — the `osProcessSpawn` twin with bInheritHandles=TRUE, so a child inherits the
	// pipe write end its STARTUPINFO names as hStdOutput. Three VALUE operands, no result — identical marshalling to
	// `osProcessSpawn` save the one TRUE flag (shared lowering).
	osProcessSpawnInherit(cmdlinePtrId ValueId, startupPtrId ValueId, procInfoPtrId ValueId) = StdOpMeta{category: StdOpCategory.system, role: OpRole.plain, isPure: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false, isUnsupportedInInlineBody: true}
end 'StdOp'

export typealias StdOpArray = Array with StdOp

// The set of value ids a function's ops READ. Every Std-tier pass that asks "does anything
// still read this value?" — the const DCE, the dead-block-arg prune, the trivial-block-arg
// elimination — reads it from `collectStdOpUses` below rather than re-matching the union, so a
// new StdOp variant is a compile error in ONE place instead of a silently-missed use at each of
// them. (This is the Std tier's counterpart to `targetOpOperands`, which plays the same role for
// the Target tier's liveness, splitter, colorer and checker.)
//
// A DENSE COLUMN, not a `Set`. A ValueId IS a dense, function-local index — so a hash set spends a
// hash and a probe to look up something that is already an array subscript. That is the design's
// "NO `Set`/`Map` and NO hashing in the hot path" rule (ARCHITECTURE.md §"Data representation")
// broken in the one place it is easiest to break it, and on the corpus's single large function it
// showed: `foldConstOperands` grew at exponent **1.29 in TIME while its ALLOCATIONS grew at 0.99** —
// the signature of a structure whose asymptotics are fine and whose CONSTANT degrades, because every
// probe into a table that doubles with the program is a cache miss that the previous rung did not
// take. It was invisible while the register allocator's quadratic dwarfed it at 87% of the compile;
// removing that made this the phase over its budget.
//
// It needs no size up front — the column grows to fit the highest id it is given — so it is a drop-in
// for the `Set` it replaces, with the same three operations and no hashing at all.
export type StdValueUseSet
	var member as BoolArray

	export static function create() returns StdValueUseSet
		return Self{member: BoolArray.create()}
	end 'create'

	export function insert(valueId ValueId)
		// `growFilled`, NOT `resize`: this column is extended ONE ENTRY AT A TIME (inserting ids in
		// increasing order is exactly what the collect walk does), and `resize` reserves EXACTLY the length
		// it is given — Θ(values²) of allocator traffic for a column that ends up Θ(values) long. Measured,
		// on the first cut of this very type: +4 GB at scale rung 5, with the byte curve at exponent 2.0.
		// `growFilled` grows the capacity geometrically and clears what the growth added.
		self.member.growFilled(valueId + 1, value: false)

		try self.member.set(valueId, value: true) otherwise panic("StdValueUseSet.insert: member.set OOB at {valueId}")
	end 'insert'

	export function contains(valueId ValueId) returns bool
		if valueId >= self.member.count() 'neverInserted'
			return false
		end 'neverInserted'
		return try self.member.get(valueId) otherwise panic("StdValueUseSet.contains: member.get OOB at {valueId}")
	end 'contains'
end 'StdValueUseSet'

// Add the value ids `op` READS to `referenced` — its DEFS are not uses, and neither are the
// branch-edge args (those live on the predecessor's `IrBlock`, not on the op). Exhaustive
// over StdOp, no bare `default`.
//
// EXPORTED, not module-scoped: the Std→x64 lowering reads it too, to decide which compare
// results are read as VALUES (and so need a `setcc`) rather than only as branch FLAGS. That
// is exactly the question this function exists to answer in one place — a second, private
// "what does this op read?" match inside the backend is the drift it was written to prevent.
export function collectStdOpUses(op StdOp, referenced StdValueUseSet)
	match op 'u'
		const then break 'u'
		binOp(_, lhs, rhs, _, _) then insertUsePair(referenced, a: lhs, b: rhs)
		unaryOp(_, operand, _, _) then referenced.insert(operand)
		cmp(_, lhs, rhs, _, _) then insertUsePair(referenced, a: lhs, b: rhs)
		binOpImm(_, lhs, _, _) then referenced.insert(lhs)
		cmpImm(_, lhs, _, _) then referenced.insert(lhs)
		div(_, lhs, rhs) then insertUsePair(referenced, a: lhs, b: rhs)
		mod(_, lhs, rhs) then insertUsePair(referenced, a: lhs, b: rhs)
		condBranch(condId, _, _) then referenced.insert(condId)
		branch then break 'u'
		ret(retValId) then referenced.insert(retValId)
		param then break 'u'
		call(_, _, args) then insertUseArgs(referenced, args: args)
		retVoid then break 'u'
		// `globalAddr` reads nothing — its `label` is a NAME, not a value, so it has no
		// operand at all (its result is a def). The other two read the address they are
		// handed, and a store reads the value it writes as well.
		globalAddr then break 'u'
		loadIndirect(_, addrId, _, _) then referenced.insert(addrId)
		storeIndirect(addrId, _, valueId, _) then insertUsePair(referenced, a: addrId, b: valueId)
		// The size is a real value operand — the only one this op reads; its result is a def.
		osAllocPages(_, sizeId) then referenced.insert(sizeId)
		// Both the buffer and the length are real value operands; this op defines nothing.
		osWriteStdout(bufId, lenId) then insertUsePair(referenced, a: bufId, b: lenId)
		// `rdataAddr` reads nothing — its `label` is a NAME, not a value (its result is a def), exactly
		// like `globalAddr`.
		rdataAddr then break 'u'
		// A throwing call reads its arguments exactly as `call` does; `resultId`/`errorFlagId` are DEFS.
		tryCall(_, _, _, args) then insertUseArgs(referenced, args: args)
		// The dual-register terminator reads BOTH the primary value and the error flag it writes out.
		errorReturn(retValId, errorFlagId) then insertUsePair(referenced, a: retValId, b: errorFlagId)
		// The exit code is the one value operand `osExit` reads.
		osExit(codeId) then referenced.insert(codeId)
		// `funcAddr` reads nothing — its `funcName` is a NAME, not a value (its result is a def), exactly
		// like `globalAddr`/`rdataAddr`.
		funcAddr then break 'u'
		// An indirect call reads the callee register AND its arguments; `resultId` is a def, and
		// `resultType`/`argFloatMask` are metadata (not value operands).
		callIndirect(_, calleeReg, _, _, args) then insertUseCalleeAndArgs(referenced, calleeReg: calleeReg, args: args)
		// A range panic reads nothing — its `label` is a NAME (an `.rdata` symbol), not a value, and it
		// defines nothing.
		osRangePanic then break 'u'
		// Both out-param ADDRESSES are real value operands (the builder's `globalAddr` results); this op
		// defines nothing. The `ms` count is the one value `osSleepMs` reads. Both must be reported here or
		// the allocator would free the address/count registers early and the OS call would read garbage.
		osReadClock(ticksPtrId, freqPtrId) then insertUsePair(referenced, a: ticksPtrId, b: freqPtrId)
		osSleepMs(msId) then referenced.insert(msId)
		// P1.5 subprocess: each reads its operands and (except `osWaitHandle`) defines nothing. `osWaitHandle`'s
		// `resultId` is a DEF, so it is skipped here exactly as `osAllocPages`'s result id is.
		osProcessSpawn(cmdlinePtr, startupPtr, procInfoPtr) then insertUseTriple(referenced, a: cmdlinePtr, b: startupPtr, c: procInfoPtr)
		osProcessExitCode(handle, codePtr) then insertUsePair(referenced, a: handle, b: codePtr)
		osWaitHandles(handleArrayPtr, count, timeoutMs) then insertUseTriple(referenced, a: handleArrayPtr, b: count, c: timeoutMs)
		osCloseHandle(handle) then referenced.insert(handle)
		osWaitHandle(_, handle, timeoutMs) then insertUsePair(referenced, a: handle, b: timeoutMs)
		// The region base is the one value operand `osFreePages` reads; it defines nothing (like `osExit`/`osCloseHandle`).
		osFreePages(addr) then referenced.insert(addr)
		// The jump table reads ONLY the biased index `subjectId`; `denseTargetBlockIds`/`defaultBlockId` are
		// block ids (the CFG, carried on the op), NOT value operands, and are deliberately not bound here (a
		// tail-slot Array binding in this big match is the decref-corruption trap `switch` documents).
		switch(subjectId, _, _) then referenced.insert(subjectId)
		// A witness call reads the WITNESS-TABLE ADDRESS and its arguments — the exact shape of `callIndirect`
		// (`witnessAddr` in place of the callee register), so it reports uses the same way. `resultId` is a def;
		// `methodIndex`/`resultType`/`argFloatMask` are metadata (not value operands).
		witnessCall(_, witnessAddr, _, _, _, args) then insertUseCalleeAndArgs(referenced, calleeReg: witnessAddr, args: args)
		// P1.5 dogfood slice 1a: each IOCP op reports its VALUE operands; its `resultId` (where present) is a DEF,
		// skipped here exactly as `osWaitHandle`'s is. `osIocpCreate`/`osEventCreate`/`osLastError` read nothing (a
		// pure result def, like `osAllocPages`'s but with no size operand).
		osPipeCreate(namePtr, saPtr, iocp, readPtr, writePtr) then insertUseQuint(referenced, a: namePtr, b: saPtr, c: iocp, d: readPtr, e: writePtr)
		osIocpCreate then break 'u'
		osEventCreate then break 'u'
		osThreadCreate(_, entryPtr) then referenced.insert(entryPtr)
		osLockInit(lockPtr) then referenced.insert(lockPtr)
		osLockEnter(lockPtr) then referenced.insert(lockPtr)
		osLockLeave(lockPtr) then referenced.insert(lockPtr)
		osReadOverlapped(_, handle, buf, cap, bytesOutPtr, ovl) then insertUseQuint(referenced, a: handle, b: buf, c: cap, d: bytesOutPtr, e: ovl)
		osLastError then break 'u'
		osProcessSpawnInherit(cmdlinePtr, startupPtr, procInfoPtr) then insertUseTriple(referenced, a: cmdlinePtr, b: startupPtr, c: procInfoPtr)
	end 'u'
end 'collectStdOpUses'

// Mark every call argument value as used, so a `const` fed ONLY to a call (`f(5)`) is not
// pruned as dead. A `param` has no uses (its result is a def), so it contributes nothing.
function insertUseArgs(referenced StdValueUseSet, args ValueIdArray)
	for arg in args 'each'
		referenced.insert(arg)
	end 'each'
end 'insertUseArgs'

function insertUsePair(referenced StdValueUseSet, a ValueId, b ValueId)
	referenced.insert(a)
	referenced.insert(b)
end 'insertUsePair'

// The three-operand twin of `insertUsePair` — for the subprocess ops that read three value operands
// (`osProcessSpawn`'s cmdline + two out-struct pointers; `osWaitHandles`'s handle array + count + timeout).
function insertUseTriple(referenced StdValueUseSet, a ValueId, b ValueId, c ValueId)
	referenced.insert(a)
	referenced.insert(b)
	referenced.insert(c)
end 'insertUseTriple'

// The five-operand twin — for the P1.5 IOCP ops that read five value operands (`osPipeCreate`'s name + SA + iocp +
// two out-pointers; `osReadOverlapped`'s handle + buf + cap + bytesOut-pointer + overlapped).
function insertUseQuint(referenced StdValueUseSet, a ValueId, b ValueId, c ValueId, d ValueId, e ValueId)
	referenced.insert(a)
	referenced.insert(b)
	referenced.insert(c)
	referenced.insert(d)
	referenced.insert(e)
end 'insertUseQuint'

// An indirect call reads its callee register AND every argument. The callee is a value operand (the
// code pointer), unlike a direct `call` whose callee is a NAME — so it must be inserted alongside the
// args or the value holding the function pointer would look dead and be pruned.
function insertUseCalleeAndArgs(referenced StdValueUseSet, calleeReg ValueId, args ValueIdArray)
	referenced.insert(calleeReg)
	insertUseArgs(referenced, args: args)
end 'insertUseCalleeAndArgs'

// `op` with every READ mapped through `subst` — a DENSE column, `subst[v]` being what `v` is
// rewritten to (and `v` itself where nothing changes). The mirror of `collectStdOpUses`: it
// rewrites exactly the operands that one reports, so the two cannot drift. DEFS are left alone
// (a def is not a use), and so are branch-edge args — those live on the predecessor's `IrBlock`,
// not on the op, so rewriting them is the caller's job. Exhaustive over StdOp with no bare
// `default`, for the same reason its twin is: a new variant must be a COMPILE ERROR here rather
// than a silently-missed rewrite at every call site.
//
// A COLUMN, NOT A (from, to) PAIR, and that is a performance contract rather than a convenience.
// The pair form could only rewrite ONE value per walk, so a caller with k substitutions to make
// walked the function k times — O(ops x k), and worse, it rebuilt every branch edge k times, which
// made its ALLOCATIONS quadratic too. `elimTrivialBlockArgs` had exactly that shape and it made
// the pass 54% of a large compile. The column form applies all k in a single walk.
module function remapStdOpUses(op StdOp, subst ValueIdArray) returns StdOp
	return match op 'r'
		const gives op
		binOp(resultId, lhs, rhs, opcode, operandType) gives StdOp.binOp(resultId, lhs: remappedValue(lhs, subst: subst), rhs: remappedValue(rhs, subst: subst), opcode: opcode, operandType: operandType)
		unaryOp(resultId, operand, opcode, operandType) gives StdOp.unaryOp(resultId, operand: remappedValue(operand, subst: subst), opcode: opcode, operandType: operandType)
		cmp(resultId, lhs, rhs, pred, operandType) gives StdOp.cmp(resultId, lhs: remappedValue(lhs, subst: subst), rhs: remappedValue(rhs, subst: subst), pred: pred, operandType: operandType)
		binOpImm(resultId, lhs, imm, opcode) gives StdOp.binOpImm(resultId, lhs: remappedValue(lhs, subst: subst), imm: imm, opcode: opcode)
		cmpImm(resultId, lhs, imm, pred) gives StdOp.cmpImm(resultId, lhs: remappedValue(lhs, subst: subst), imm: imm, pred: pred)
		div(resultId, lhs, rhs) gives StdOp.div(resultId, lhs: remappedValue(lhs, subst: subst), rhs: remappedValue(rhs, subst: subst))
		mod(resultId, lhs, rhs) gives StdOp.mod(resultId, lhs: remappedValue(lhs, subst: subst), rhs: remappedValue(rhs, subst: subst))
		condBranch(condId, thenBlockId, elseBlockId) gives StdOp.condBranch(remappedValue(condId, subst: subst), thenBlockId: thenBlockId, elseBlockId: elseBlockId)
		branch gives op
		ret(retValId) gives StdOp.ret(remappedValue(retValId, subst: subst))
		param gives op
		call(resultId, callee, args) gives StdOp.call(resultId, callee: callee, args: remappedArgs(args, subst: subst))
		retVoid gives op
		// The exact mirror of `collectStdOpUses`'s three arms: `globalAddr` reports no use,
		// so it rewrites nothing and is handed back unchanged.
		globalAddr gives op
		loadIndirect(resultId, addrId, offset, valueType) gives StdOp.loadIndirect(resultId, addrId: remappedValue(addrId, subst: subst), offset: offset, valueType: valueType)
		storeIndirect(addrId, offset, valueId, valueType) gives StdOp.storeIndirect(remappedValue(addrId, subst: subst), offset: offset, valueId: remappedValue(valueId, subst: subst), valueType: valueType)
		// The exact mirror of `collectStdOpUses`'s arm: the size is the one read, so it is the one rewrite.
		osAllocPages(resultId, sizeId) gives StdOp.osAllocPages(resultId, sizeId: remappedValue(sizeId, subst: subst))
		// The mirror of `collectStdOpUses`: both operands are reads, so both are rewritten.
		osWriteStdout(bufId, lenId) gives StdOp.osWriteStdout(remappedValue(bufId, subst: subst), lenId: remappedValue(lenId, subst: subst))
		// `rdataAddr` reports no use (its `label` is a name), so it rewrites nothing and is handed back
		// unchanged — the exact mirror of `collectStdOpUses`'s `globalAddr`/`rdataAddr` arms.
		rdataAddr gives op
		// The exact mirror of `collectStdOpUses`: `tryCall` rewrites its args (its two results are defs),
		// `errorReturn` rewrites both operands it reads, `osExit` rewrites its code operand.
		tryCall(resultId, errorFlagId, callee, args) gives StdOp.tryCall(resultId, errorFlagId: errorFlagId, callee: callee, args: remappedArgs(args, subst: subst))
		errorReturn(retValId, errorFlagId) gives StdOp.errorReturn(remappedValue(retValId, subst: subst), errorFlagId: remappedValue(errorFlagId, subst: subst))
		osExit(codeId) gives StdOp.osExit(remappedValue(codeId, subst: subst))
		// `funcAddr` reports no use (its `funcName` is a name), so it rewrites nothing and is handed back
		// unchanged — the exact mirror of `collectStdOpUses`'s `globalAddr`/`rdataAddr`/`funcAddr` arms.
		funcAddr gives op
		// The exact mirror of `collectStdOpUses`: `callIndirect` rewrites its callee register and its args
		// (its result is a def); `resultType`/`argFloatMask` are metadata carried through unchanged.
		callIndirect(resultId, calleeReg, resultType, argFloatMask, args) gives StdOp.callIndirect(resultId, calleeReg: remappedValue(calleeReg, subst: subst), resultType: resultType, argFloatMask: argFloatMask, args: remappedArgs(args, subst: subst))
		// `osRangePanic` reads no value (its `label` is a name), so it rewrites nothing and is handed back
		// unchanged — the mirror of `funcAddr`/`rdataAddr`.
		osRangePanic gives op
		// The exact mirror of `collectStdOpUses`: `osReadClock` rewrites both out-param addresses it reads,
		// `osSleepMs` rewrites its millisecond count. Both define nothing.
		osReadClock(ticksPtrId, freqPtrId) gives StdOp.osReadClock(remappedValue(ticksPtrId, subst: subst), freqPtrId: remappedValue(freqPtrId, subst: subst))
		osSleepMs(msId) gives StdOp.osSleepMs(remappedValue(msId, subst: subst))
		// The exact mirror of `collectStdOpUses`'s subprocess arms: rewrite exactly the operands they read;
		// `osWaitHandle`'s `resultId` is a def, so it passes through unmapped.
		osProcessSpawn(cmdlinePtr, startupPtr, procInfoPtr) gives StdOp.osProcessSpawn(remappedValue(cmdlinePtr, subst: subst), startupPtrId: remappedValue(startupPtr, subst: subst), procInfoPtrId: remappedValue(procInfoPtr, subst: subst))
		osProcessExitCode(handle, codePtr) gives StdOp.osProcessExitCode(remappedValue(handle, subst: subst), codePtrId: remappedValue(codePtr, subst: subst))
		osWaitHandles(handleArrayPtr, count, timeoutMs) gives StdOp.osWaitHandles(remappedValue(handleArrayPtr, subst: subst), countId: remappedValue(count, subst: subst), timeoutMsId: remappedValue(timeoutMs, subst: subst))
		osCloseHandle(handle) gives StdOp.osCloseHandle(remappedValue(handle, subst: subst))
		osWaitHandle(resultId, handle, timeoutMs) gives StdOp.osWaitHandle(resultId, handleId: remappedValue(handle, subst: subst), timeoutMsId: remappedValue(timeoutMs, subst: subst))
		// The exact mirror of `collectStdOpUses`'s arm: the region base is the one read, so it is the one rewrite.
		osFreePages(addr) gives StdOp.osFreePages(remappedValue(addr, subst: subst))
		// The exact mirror of `collectStdOpUses`'s `switch` arm: only the biased index `subjectId` is a value
		// operand, so it is the one rewrite; the block-id table and default carry through verbatim. Binding
		// the middle-slot Array is safe — a trailing non-Array field (`defaultBlockId`) follows it, exactly
		// the condition that lets `call` bind its trailing args here.
		switch(subjectId, denseTargetBlockIds, defaultBlockId) gives StdOp.switch(remappedValue(subjectId, subst: subst), denseTargetBlockIds: denseTargetBlockIds, defaultBlockId: defaultBlockId)
		// The exact mirror of `collectStdOpUses`'s `witnessCall` arm: rewrite the witness-table address and the
		// args (its result is a def; `methodIndex`/`resultType`/`argFloatMask` are metadata carried through).
		witnessCall(resultId, witnessAddr, methodIndex, resultType, argFloatMask, args) gives StdOp.witnessCall(resultId, witnessAddr: remappedValue(witnessAddr, subst: subst), methodIndex: methodIndex, resultType: resultType, argFloatMask: argFloatMask, args: remappedArgs(args, subst: subst))
		// The exact mirror of `collectStdOpUses`'s P1.5 IOCP arms: rewrite exactly the value operands they read;
		// the result-only ops (`osIocpCreate`/`osEventCreate`/`osLastError`) rewrite nothing.
		osPipeCreate(namePtr, saPtr, iocp, readPtr, writePtr) gives StdOp.osPipeCreate(remappedValue(namePtr, subst: subst), saPtrId: remappedValue(saPtr, subst: subst), iocpId: remappedValue(iocp, subst: subst), readPtrId: remappedValue(readPtr, subst: subst), writePtrId: remappedValue(writePtr, subst: subst))
		osIocpCreate gives op
		osEventCreate gives op
		osThreadCreate(resultId, entryPtr) gives StdOp.osThreadCreate(resultId, entryPtrId: remappedValue(entryPtr, subst: subst))
		osLockInit(lockPtr) gives StdOp.osLockInit(remappedValue(lockPtr, subst: subst))
		osLockEnter(lockPtr) gives StdOp.osLockEnter(remappedValue(lockPtr, subst: subst))
		osLockLeave(lockPtr) gives StdOp.osLockLeave(remappedValue(lockPtr, subst: subst))
		osReadOverlapped(resultId, handle, buf, cap, bytesOutPtr, ovl) gives StdOp.osReadOverlapped(resultId, handleId: remappedValue(handle, subst: subst), bufId: remappedValue(buf, subst: subst), capId: remappedValue(cap, subst: subst), bytesOutPtrId: remappedValue(bytesOutPtr, subst: subst), ovlId: remappedValue(ovl, subst: subst))
		osLastError gives op
		osProcessSpawnInherit(cmdlinePtr, startupPtr, procInfoPtr) gives StdOp.osProcessSpawnInherit(remappedValue(cmdlinePtr, subst: subst), startupPtrId: remappedValue(startupPtr, subst: subst), procInfoPtrId: remappedValue(procInfoPtr, subst: subst))
	end 'r'
end 'remapStdOpUses'

// IDENTITY for any id outside the column. The column is sized by the BLOCK-ARG id space (the only
// values a phi-folding pass ever rewrites), and an operand above it — an op result, a parameter —
// is by definition not a block-arg and so is not being rewritten. Same discipline, and the same
// reason, as `pruneDeadBlockArgs.flagOf`.
module function remappedValue(v ValueId, subst ValueIdArray) returns ValueId
	return try subst.get(v) otherwise v
end 'remappedValue'

function remappedArgs(args ValueIdArray, subst ValueIdArray) returns ValueIdArray
	var out = ValueIdArray.create()
	for a in args 'each'
		out.push(remappedValue(a, subst: subst))
	end 'each'
	return out
end 'remappedArgs'

// --- The sugar band contract ---
//
// v1 enforced "no sugar reaches the backend" with a TYPE: sugar ops existed in
// `StdOp` and simply had no `MirOp` counterpart, so the Std→MIR lowering could not
// represent them past the boundary. Collapsing the tier gives that up, and the
// replacement is deliberate rather than accidental — two independent guards:
//
//   1. Each sugar variant gets an explicit `panic("… must be desugared by
//      lowerToMachineForm")` arm in the backend's `match` — NOT a bare `default`,
//      which the project forbids precisely because it swallows new cases.
//   2. `assertNoSugarOps` below, a whole-module gate. It catches an op the
//      per-variant arms would miss — one reachable only through a `match` range arm,
//      or sitting in a block the backend's own walk happens not to visit.
//
// Both are vacuous at M1 (no sugar variants exist yet), so `lowerToMachineForm`
// itself is NOT written now. It arrives with the first sugar op (M6's `drop`/`free`,
// M14's descriptor/witness ops), as a Std→Std pass.
//
// The gate is run by `buildBackend` — the single TARGET-NEUTRAL backend entry — not
// inside `lowerStdToX64`. Sugar is a property of the Std tier, not of x64, so every
// future backend (arm64, wasm) inherits the check instead of having to remember to
// re-install it.
//
// It walks LIVE ops via `IrModule.liveOpIndices`, NOT the flat `module.ops` array:
// `lowerToMachineForm` is a block-rebuilding pass, so the sugar ops it desugars
// survive in `module.ops` as orphans. Scanning the flat array would panic on those
// dead entries and report a desugaring failure that never happened.
export function assertNoSugarOps(module StdModule)
	for func in module.functions 'eachFunc'
		for opIdx in module.liveOpIndices(func) 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("assertNoSugarOps: live op index {opIdx} not in module.ops")
			if op.rawValue.category == StdOpCategory.sugar 'isSugar'
				panic("Std→Target: a `sugar`-category StdOp survived into the backend in function '{String.from(func.name)}' — lowerToMachineForm did not run, or does not handle this op")
			end 'isSugar'
		end 'eachOp'
	end 'eachFunc'
end 'assertNoSugarOps'
