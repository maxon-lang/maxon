// Std Dialect — mid-level IR. The width/ABI-resolved tier between the
// source-proximate Maxon dialect and the target-specific dialects (x64/arm64).
// All mid-level optimization passes (mem2reg, canonicalize, cse, licm, dce, …)
// run here, and so do the machine-level passes (instruction scheduling,
// coalescing) that v1 ran on a separate MIR tier.
//
// **DELIBERATE DIVERGENCE FROM v1: there is no MIR tier.** v1 ran
// Maxon → Std → MIR → Target; shv2 runs Maxon → Std → Target. v1's `lowerStdToMir`
// was ~90% a mechanical 1:1 rename — Std's `ValueId`s ALREADY ARE the infinite
// virtual registers MIR claimed to introduce, so the tier bought no new value
// model. Its only real content was desugaring a handful of Std-only ops, which
// is a Std→Std rewrite (`lowerToMachineForm`, see the `sugar` band below), not a
// tier. Deleting the tier drops a whole module copy from peak RSS and removes a
// boundary that had already started hiding drift in v1 (`MirOp.movReg` survived
// with zero construction sites because the tier wall made it invisible).
//
// **`StdOp` IS FLAT.** v1 nested it as `StdOp.arith(StdArithOp.const(StdArithConst))`
// — an artifact of a migration that did not want to touch every pass, not a
// design (v1's own StdDialect header says so). Nesting is expensive here: Maxon
// heap-boxes and refcounts every payload-carrying union case, so each nesting
// level is another heap object. That 3-boxes-per-op shape, on the most numerous
// object in the compiler, is a first-order cost — roughly half of v1's
// self-compile cycles go to memory-management churn. Flat = ONE box per op.
//
// Coarse membership ("is this any kind of call?") is recovered WITHOUT nesting by
// the `StdOpMeta` struct backing every variant carries — the same idiom
// MaxonDialect already uses and justifies. The backing is REQUIRED by the
// language, so a new variant cannot be added without declaring its category,
// role, and inline policy here.
//
// THIN for maxon-shv2 M1: carries the shapes the `return 42` slice lowers to —
// the full `StdType` classification (needed everywhere: block-arg types, function
// signatures) plus the `const` and `ret` ops. Later milestones GROW `StdOp` with
// the arith-unary/binary (M3), control-flow (M4), call/param (M5), and memory
// (M6) variants.

// --- CastCategory: coarse type family for cast validation ---
// Kept whole (int/float/bool/string/cstring) even though M1 only produces
// int/bool — the StdType backing values below reference every family, and the
// call-site type checker (Chunk B) needs the full set to reject mismatches.
export enum CastCategory
	int
	float
	bool
	string
	cstring
end 'CastCategory'

// --- StdTypeInfo: metadata carried by each StdType case ---
export type StdTypeInfo
	export let isFloat as bool
	export let castCategory as CastCategory
end 'StdTypeInfo'

// --- StdType: ABI/width-level type classification ---
// Each case carries a StdTypeInfo backing value encoding whether the type lives
// in a floating-point register and which cast family it belongs to.
export enum StdType
	i1 = StdTypeInfo{isFloat: false, castCategory: CastCategory.bool}
	i8 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int}
	i16 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int}
	i32 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int}
	i64 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int}
	u8 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int}
	u16 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int}
	u32 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int}
	u64 = StdTypeInfo{isFloat: false, castCategory: CastCategory.int}
	f32 = StdTypeInfo{isFloat: true, castCategory: CastCategory.float}
	f64 = StdTypeInfo{isFloat: true, castCategory: CastCategory.float}
end 'StdType'

export function stdTypeIsFloat(t StdType) returns bool
	return t.rawValue.isFloat
end 'stdTypeIsFloat'

// --- StdReturnType: function return type (either void or a concrete StdType) ---
// Void-returning functions are `void`; value-returning functions carry the
// concrete StdType in `value`. Consumers dispatch on this union rather than
// using a sentinel StdType to mean "no return".
export union StdReturnType
	void
	value(inner StdType)
end 'StdReturnType'

export typealias StdReturnTypeArray = Array with StdReturnType

export function stdReturnTypeIsVoid(rt StdReturnType) returns bool
	return match rt 'check'
		void gives true
		value gives false
	end 'check'
end 'stdReturnTypeIsVoid'

export function stdReturnTypeIsFloat(rt StdReturnType) returns bool
	return match rt 'check'
		void gives false
		value(inner) gives stdTypeIsFloat(inner)
	end 'check'
end 'stdReturnTypeIsFloat'

// --- StdOpCategory: coarse op family, recovered without nesting ---
// Replaces v1's outer-union arms (`StdOp.arith(...)`, `StdOp.call(...)`, …) with
// a metadata field, so membership tests stay cheap while `StdOp` stays flat.
// Declared whole even though M1 only produces `arith` and `call` — the same
// growth-is-additive convention MaxonDialect's `OpCategory` follows.
//
// `sugar` is the load-bearing one: it names the Std-only ops that exist purely to
// be rewritten away (v1's descriptorField / witnessMethod / unboxValue / drop /
// free / …). They are eliminated by a Std→Std `lowerToMachineForm` pass before the
// backend runs — see the "sugar band" contract below.
export enum StdOpCategory
	arith
	control
	call
	memory
	system
	sugar
end 'StdOpCategory'

// The structural role an op plays in a function, where that role is a property of
// the OP rather than of its category. Replaces v1's three single-variant tag
// bools (`isRet` / `isErrorReturn` / `isParam`), which existed only so passes
// could ask "is this the return?" without a match.
export enum OpRole
	plain
	ret
	errorReturn
	param
end 'OpRole'

// The Std-tier binary-operation opcodes carried by `StdOp.binOp`. A family that
// shares one operand shape (two value operands, one result) stays a single
// `binOp` variant with this opcode field — see the StdOp header's "flat does NOT
// mean one variant per opcode" rule. M2 landed `add`; M3 grew the rest of the
// non-trapping integer ALU ops (`sub`, `mul`). A compare still splits out as its
// OWN variant (it sets `isCmp` — different metadata the per-variant backing cannot
// reach through an opcode field) when `if` lands at M4; the trapping `div`/`mod`
// (which set `isPure: false`) arrive at M5 with the real register allocator.
export enum StdBinOpcode
	add
	sub
	mul
end 'StdBinOpcode'

// The Std-tier unary-operation opcodes carried by `StdOp.unaryOp`. M3 lands `neg`
// (integer negate). A separate opcode set from StdBinOpcode because a unary op has
// a different operand shape (one operand, one result). Non-trapping, so `unaryOp`
// is `isPure`.
export enum StdUnaryOpcode
	neg
end 'StdUnaryOpcode'

// The Std-tier comparison predicates carried by `StdOp.cmp` (M4). Signed integer
// comparisons: the x64 lowering maps each to a signed setcc/jcc condition (`lt`→JL,
// `gt`→JG, …). A separate op (not a `binOp` opcode) because a compare carries
// DIFFERENT metadata (`isCmp: true`) the per-variant `StdOpMeta` backing cannot
// reach through an opcode field — see the StdOp header's "flat does NOT mean one
// variant per opcode" rule.
export enum StdCmpPred
	eq
	ne
	lt
	gt
	le
	ge
end 'StdCmpPred'

// Per-variant static metadata backing for StdOp (read via `op.rawValue`). Carries
// what passes need to classify an op WITHOUT matching on it: the category (see
// above), the structural role, the two inliner axes, and the scheduling facts the
// instruction scheduler and the backends' use counting consume.
export type StdOpMeta
	export let category as StdOpCategory
	export let role as OpRole
	// Side-effect-free: the op can be duplicated, reordered, or dropped when its
	// result is unused. The inliner's callee-body purity gate reads this (v1:
	// `Inliner.isPureOp`), and DCE/CSE/LICM will too.
	//
	// Declared PER VARIANT, which is the flat union's payoff: v1 could only answer
	// this by CATEGORY at the match site (`arith gives true; control gives true;
	// call(c) gives c.rawValue.isPureForInlining; memory/system give false`), a
	// blanket that has no way to say a trapping op is impure — v1's own `arith`
	// band would call an integer `div` (which faults on divide-by-zero) pure. Here
	// M3's `div` simply declares `isPure: false` and nothing else changes.
	export let isPure as bool
	// The op cannot appear inside a callee body that the multi-block splice is asked
	// to inline — it escapes the inliner's static-callee model (v1: `indirectCall`,
	// `witnessCall`, `tailCall`, `errorReturn`). ORTHOGONAL to `isPure`: purity says
	// whether the op may be moved, this says whether it may be spliced at all.
	export let isUnsupportedInInlineBody as bool
	// True for ops that access memory or have side effects the scheduler must
	// treat as a barrier (loads, stores, calls, syscalls, atomics, locks).
	export let isMemory as bool
	// True for ops that write memory or have externally-observable side effects
	// (must order with subsequent loads). Pure loads are memory but not stores.
	export let isStore as bool
	// True for ops with full call-barrier semantics (clobber caller-saved regs,
	// may observe/modify arbitrary memory). Also true for `param`.
	export let isCall as bool
	// True if the op may clobber x64 EFLAGS / ARM64 NZCV once lowered. `const` is
	// covered because its zero case lowers to the `xor reg, reg` idiom (which sets
	// flags); that idiom itself arrives at M3. Note this is a LOWERING artifact, not
	// a side effect — a flag-clobbering op is still `isPure`.
	export let clobbersFlags as bool
	// A compare feeding a branch — the backends pair the two, so the classification
	// must survive as metadata rather than being re-derived per target.
	export let isCmp as bool
end 'StdOpMeta'

// --- StdOp: the flat op union ---
//
// Variants are declared in CATEGORY-CONTIGUOUS BANDS, in `StdOpCategory` order:
// arith · control · call · memory · system · sugar. The banding is what makes a
// flat union as ergonomic as the nested one it replaces: a pass that treats a
// whole category uniformly covers it with ONE `match` range arm
// (`firstArith to lastArith then …`) instead of one arm per variant.
//
// INVARIANT — **a new variant is APPENDED AT THE END OF ITS BAND, never inserted
// into the middle of one.** A range arm names its endpoints, so it silently
// swallows anything inserted between them: the compiler reports no missing-case
// error, and the new op is misclassified at every range-arm site at once. This is
// the one place the project's "no silent unhandled cases" rule has no compiler
// backstop, so it is a convention the reviewer must enforce. Appending at a band's
// end is always safe (the range's endpoint moves with it, deliberately).
//
// Flat does NOT mean one variant per opcode. Where a family shares an operand
// shape and differs only in the operation (`add`/`sub`/`mul`/…), it stays ONE
// variant with an opcode field — but a member needing DIFFERENT metadata (a
// compare sets `isCmp`; a division traps) splits out as its own variant, because
// the `StdOpMeta` backing attaches per variant and cannot reach an opcode buried
// inside a field. M3's arithmetic lands as `binOp(… opcode StdBinOpcode)` +
// a separate `cmp(…)` for exactly that reason.
export union StdOp
	// --- band: arith ---
	// Materialize a constant into a virtual register (`resultId`). `valueType`
	// carries the width AND the float-ness the backend needs to pick a GP
	// mov-immediate vs an XMM load — replacing v1's `constI64`/`constF64` opcode
	// pair, which could not express i32/u8/f32 without new opcodes.
	const(resultId ValueId, value ParsedInt, valueType StdType) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Binary op `resultId = lhs <opcode> rhs` over two virtual registers. M3 carries
	// `add`/`sub`/`mul`, all `isPure` (integer add/sub/mul never trap — unlike the
	// `div` that M5 will declare `isPure: false`) and `clobbersFlags: true` (x64
	// `add`/`sub`/`imul` write EFLAGS). Appended at the END of the arith band,
	// honoring the band-append invariant; `cmp` splits out as its own variant at M4.
	binOp(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Unary op `resultId = <opcode> operand` over one virtual register. M3 carries
	// `neg`, which is `isPure` (integer negate never traps) and `clobbersFlags: true`
	// (x64 `neg` writes EFLAGS). Appended at the END of the arith band, after `binOp`,
	// honoring the band-append invariant.
	unaryOp(resultId ValueId, operand ValueId, opcode StdUnaryOpcode) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Integer comparison `resultId = lhs <pred> rhs`, producing an i1. M4's `if`
	// condition. `isCmp: true` (the metadata the x64 backend pairs with the following
	// branch); `isPure: true` (a compare never traps); `clobbersFlags: true` (x64 `cmp`
	// writes EFLAGS). SPLIT OUT of `binOp` at the END of the arith band because it needs
	// this different metadata — see StdCmpPred and the StdOp header.
	cmp(resultId ValueId, lhs ValueId, rhs ValueId, pred StdCmpPred) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: true}
	// Binary op with a CONSTANT right operand folded to an immediate: `resultId =
	// lhs <opcode> imm`. Produced by `foldConstOperands` from a `binOp` whose rhs
	// was a `const` (the const op is then DCE'd), so the literal never occupies a
	// register. The x64 lowering picks a copy-free 3-operand form per opcode: `add`
	// to `lea dest, [lhs + imm]`, `sub` to `lea dest, [lhs - imm]`, `mul` to `imul
	// dest, lhs, imm` — none of which is two-address, so no seed copy is ever
	// emitted. `isPure` (integer add/sub/mul never trap); `clobbersFlags: true` (the
	// `imul` lowering writes EFLAGS; the `lea` forms do not, but the flag is a "may
	// clobber" over-approximation the scheduler treats as a barrier). APPENDED at the
	// END of the arith band, after `cmp`, honoring the band-append invariant.
	binOpImm(resultId ValueId, lhs ValueId, imm Imm32, opcode StdBinOpcode) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Comparison with a CONSTANT right operand folded to an immediate: `resultId =
	// lhs <pred> imm`, producing an i1. Produced by `foldConstOperands` from a `cmp`
	// whose rhs was a `const` (canonicalized there so the const lands on the rhs, with
	// the predicate flipped when the const started on the lhs). Lowers to `cmp reg,
	// imm32` so the literal needs no register. Same `isCmp`/`isPure`/`clobbersFlags`
	// profile as `cmp`. APPENDED at the END of the arith band, after `binOpImm`.
	cmpImm(resultId ValueId, lhs ValueId, imm Imm32, pred StdCmpPred) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: true}
	// Signed integer division `resultId = lhs / rhs` (quotient), TRUNCATING toward
	// zero. SPLIT OUT of `binOp` — it does NOT ride the `StdBinOpcode` opcode field —
	// because x64 `idiv` can FAULT (#DE on divide-by-zero and on INT_MIN / -1
	// overflow), so it declares `isPure: false` (it may NOT be dropped, duplicated, or
	// reordered when its result is unused), which the shared `binOp` metadata cannot
	// express through an opcode. `clobbersFlags: true` (idiv leaves EFLAGS undefined —
	// a "may clobber" the scheduler treats as a barrier). The divide-by-zero / overflow
	// TRAP itself is delivered by the runtime fault handler (a Workstream-R / M6
	// deliverable), NOT guarded by the compiler. APPENDED at the END of the arith band,
	// after `cmpImm`, honoring the band-append invariant.
	div(resultId ValueId, lhs ValueId, rhs ValueId) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// Signed integer modulo `resultId = lhs mod rhs` (remainder), matching `div`'s
	// truncation. Same `isPure: false` (idiv faults) + `clobbersFlags: true` profile as
	// `div` — it is the SAME x64 `idiv` instruction, reading the REMAINDER out of RDX
	// instead of the quotient out of RAX. APPENDED at the END of the arith band, after
	// `div`, honoring the band-append invariant.
	mod(resultId ValueId, lhs ValueId, rhs ValueId) = StdOpMeta{category: StdOpCategory.arith, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: true, isCmp: false}
	// --- band: control ---
	// Two-way conditional branch terminator: transfer to `thenBlockId` if `condId`
	// (an i1) holds, else to `elseBlockId`. M4's `if` lowers to this. Not pure (a
	// terminator cannot be dropped or reordered); does not clobber flags (the x64
	// `jcc` READS flags, it does not set them — the preceding `cmp` set them).
	condBranch(condId ValueId, thenBlockId BlockId, elseBlockId BlockId) = StdOpMeta{category: StdOpCategory.control, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Unconditional branch terminator to `targetBlockId` (a then/else block falling
	// through to the merge block). Same non-pure, flag-neutral profile as condBranch.
	branch(targetBlockId BlockId) = StdOpMeta{category: StdOpCategory.control, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// --- band: call ---
	// Return terminator. `retValId` names the value moved into the return register.
	ret(retValId ValueId) = StdOpMeta{category: StdOpCategory.call, role: OpRole.ret, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
	// Parameter materialization at function entry: `resultId` is the SSA value of
	// parameter `index` (M5: the two coincide — a parameter is ValueId `index`), of
	// type `paramType`. Emitted once per parameter at the entry block; the x64
	// lowering turns it into `mov virtual(resultId), physical(argReg[index])` so the
	// parameter's incoming ABI register is captured into its virtual register. `role`
	// is `param`; `isCall: true` marks it a scheduling barrier that must stay at entry
	// (per the StdOpMeta `isCall` contract, which names `param`), and `isPure: false`
	// keeps it from being reordered or dropped. APPENDED at the END of the call band,
	// after `ret`, honoring the band-append invariant.
	param(resultId ValueId, index ParamCount, paramType StdType) = StdOpMeta{category: StdOpCategory.call, role: OpRole.param, isPure: false, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: true, clobbersFlags: false, isCmp: false}
	// A direct function call `resultId = callee(args…)`. `callee` is the resolved
	// function name; `args` are the argument SSA values in the callee's PARAMETER
	// order (lowerCall has already reordered any labelled arguments to declaration
	// order). The x64 lowering moves each arg into its ABI register, emits the
	// `callDirect`, then moves the R8 return value into `resultId`. Full call-barrier
	// metadata (`isCall`/`isMemory`/`isStore`/`clobbersFlags` all true, `isPure` false
	// — a call may read/write memory and must not move or drop). APPENDED at the END of
	// the call band, after `param`.
	call(resultId ValueId, callee ByteArray, args ValueIdArray) = StdOpMeta{category: StdOpCategory.call, role: OpRole.plain, isPure: false, isUnsupportedInInlineBody: false, isMemory: true, isStore: true, isCall: true, clobbersFlags: true, isCmp: false}
	// Void return terminator — the return of a function with no `returns` clause. A
	// DISTINCT variant rather than a `ret` carrying some absent-value ValueId: `ValueId`
	// has no "absent" value, and a sentinel one would be READ as a real use by
	// `collectStdOpUses` (keeping a dead value live, or naming a value that was never
	// defined). Its Maxon-tier twin `MaxonOp.retVoid` splits for the same reason.
	//
	// Carries no operand at all, so it reads nothing and rewrites nothing; the x64
	// lowering emits the bare `ret` (the frame teardown is the prologue/epilogue pass's).
	// APPENDED at the END of the call band, after `call` — which is also the end of the
	// union, so the two range arms that stop at `call` (FoldConstOperands) had to be
	// extended by hand. See the band-append invariant in the StdOp header.
	retVoid = StdOpMeta{category: StdOpCategory.call, role: OpRole.ret, isPure: true, isUnsupportedInInlineBody: false, isMemory: false, isStore: false, isCall: false, clobbersFlags: false, isCmp: false}
end 'StdOp'

export typealias StdOpArray = Array with StdOp

// The set of value ids a function's ops READ. Every Std-tier pass that asks "does anything
// still read this value?" — the const DCE, the dead-block-arg prune — reads it from
// `collectStdOpUses` below rather than re-matching the union, so a new StdOp variant is a
// compile error in ONE place instead of a silently-missed use at each of them. (This is the
// Std tier's counterpart to `targetOpOperands`, which plays the same role for the Target
// tier's liveness, splitter, colorer and checker.)
export typealias StdValueUseSet = Set with ValueId

// Add the value ids `op` READS to `referenced` — its DEFS are not uses, and neither are the
// branch-edge args (those live on the predecessor's `IrBlock`, not on the op). Exhaustive
// over StdOp, no bare `default`.
module function collectStdOpUses(op StdOp, referenced StdValueUseSet)
	match op 'u'
		const then break 'u'
		binOp(_, lhs, rhs, _) then insertUsePair(referenced, a: lhs, b: rhs)
		unaryOp(_, operand, _) then referenced.insert(operand)
		cmp(_, lhs, rhs, _) then insertUsePair(referenced, a: lhs, b: rhs)
		binOpImm(_, lhs, _, _) then referenced.insert(lhs)
		cmpImm(_, lhs, _, _) then referenced.insert(lhs)
		div(_, lhs, rhs) then insertUsePair(referenced, a: lhs, b: rhs)
		mod(_, lhs, rhs) then insertUsePair(referenced, a: lhs, b: rhs)
		condBranch(condId, _, _) then referenced.insert(condId)
		branch then break 'u'
		ret(retValId) then referenced.insert(retValId)
		param then break 'u'
		call(_, _, args) then insertUseArgs(referenced, args: args)
		retVoid then break 'u'
	end 'u'
end 'collectStdOpUses'

// Mark every call argument value as used, so a `const` fed ONLY to a call (`f(5)`) is not
// pruned as dead. A `param` has no uses (its result is a def), so it contributes nothing.
function insertUseArgs(referenced StdValueUseSet, args ValueIdArray)
	for arg in args 'each'
		referenced.insert(arg)
	end 'each'
end 'insertUseArgs'

function insertUsePair(referenced StdValueUseSet, a ValueId, b ValueId)
	referenced.insert(a)
	referenced.insert(b)
end 'insertUsePair'

// `op` with every READ mapped through `subst` — a DENSE column, `subst[v]` being what `v` is
// rewritten to (and `v` itself where nothing changes). The mirror of `collectStdOpUses`: it
// rewrites exactly the operands that one reports, so the two cannot drift. DEFS are left alone
// (a def is not a use), and so are branch-edge args — those live on the predecessor's `IrBlock`,
// not on the op, so rewriting them is the caller's job. Exhaustive over StdOp with no bare
// `default`, for the same reason its twin is: a new variant must be a COMPILE ERROR here rather
// than a silently-missed rewrite at every call site.
//
// A COLUMN, NOT A (from, to) PAIR, and that is a performance contract rather than a convenience.
// The pair form could only rewrite ONE value per walk, so a caller with k substitutions to make
// walked the function k times — O(ops x k), and worse, it rebuilt every branch edge k times, which
// made its ALLOCATIONS quadratic too. `elimTrivialBlockArgs` had exactly that shape and it made
// the pass 54% of a large compile. The column form applies all k in a single walk.
module function remapStdOpUses(op StdOp, subst ValueIdArray) returns StdOp
	return match op 'r'
		const gives op
		binOp(resultId, lhs, rhs, opcode) gives StdOp.binOp(resultId, lhs: remappedValue(lhs, subst: subst), rhs: remappedValue(rhs, subst: subst), opcode: opcode)
		unaryOp(resultId, operand, opcode) gives StdOp.unaryOp(resultId, operand: remappedValue(operand, subst: subst), opcode: opcode)
		cmp(resultId, lhs, rhs, pred) gives StdOp.cmp(resultId, lhs: remappedValue(lhs, subst: subst), rhs: remappedValue(rhs, subst: subst), pred: pred)
		binOpImm(resultId, lhs, imm, opcode) gives StdOp.binOpImm(resultId, lhs: remappedValue(lhs, subst: subst), imm: imm, opcode: opcode)
		cmpImm(resultId, lhs, imm, pred) gives StdOp.cmpImm(resultId, lhs: remappedValue(lhs, subst: subst), imm: imm, pred: pred)
		div(resultId, lhs, rhs) gives StdOp.div(resultId, lhs: remappedValue(lhs, subst: subst), rhs: remappedValue(rhs, subst: subst))
		mod(resultId, lhs, rhs) gives StdOp.mod(resultId, lhs: remappedValue(lhs, subst: subst), rhs: remappedValue(rhs, subst: subst))
		condBranch(condId, thenBlockId, elseBlockId) gives StdOp.condBranch(remappedValue(condId, subst: subst), thenBlockId: thenBlockId, elseBlockId: elseBlockId)
		branch gives op
		ret(retValId) gives StdOp.ret(remappedValue(retValId, subst: subst))
		param gives op
		call(resultId, callee, args) gives StdOp.call(resultId, callee: callee, args: remappedArgs(args, subst: subst))
		retVoid gives op
	end 'r'
end 'remapStdOpUses'

// IDENTITY for any id outside the column. The column is sized by the BLOCK-ARG id space (the only
// values a phi-folding pass ever rewrites), and an operand above it — an op result, a parameter —
// is by definition not a block-arg and so is not being rewritten. Same discipline, and the same
// reason, as `pruneDeadBlockArgs.flagOf`.
module function remappedValue(v ValueId, subst ValueIdArray) returns ValueId
	return try subst.get(v) otherwise v
end 'remappedValue'

function remappedArgs(args ValueIdArray, subst ValueIdArray) returns ValueIdArray
	var out = ValueIdArray.create()
	for a in args 'each'
		out.push(remappedValue(a, subst: subst))
	end 'each'
	return out
end 'remappedArgs'

// --- The sugar band contract ---
//
// v1 enforced "no sugar reaches the backend" with a TYPE: sugar ops existed in
// `StdOp` and simply had no `MirOp` counterpart, so the Std→MIR lowering could not
// represent them past the boundary. Collapsing the tier gives that up, and the
// replacement is deliberate rather than accidental — two independent guards:
//
//   1. Each sugar variant gets an explicit `panic("… must be desugared by
//      lowerToMachineForm")` arm in the backend's `match` — NOT a bare `default`,
//      which the project forbids precisely because it swallows new cases.
//   2. `assertNoSugarOps` below, a whole-module gate. It catches an op the
//      per-variant arms would miss — one reachable only through a `match` range arm,
//      or sitting in a block the backend's own walk happens not to visit.
//
// Both are vacuous at M1 (no sugar variants exist yet), so `lowerToMachineForm`
// itself is NOT written now. It arrives with the first sugar op (M6's `drop`/`free`,
// M14's descriptor/witness ops), as a Std→Std pass.
//
// The gate is run by `buildBackend` — the single TARGET-NEUTRAL backend entry — not
// inside `lowerStdToX64`. Sugar is a property of the Std tier, not of x64, so every
// future backend (arm64, wasm) inherits the check instead of having to remember to
// re-install it.
//
// It walks LIVE ops via `IrModule.liveOpIndices`, NOT the flat `module.ops` array:
// `lowerToMachineForm` is a block-rebuilding pass, so the sugar ops it desugars
// survive in `module.ops` as orphans. Scanning the flat array would panic on those
// dead entries and report a desugaring failure that never happened.
export function assertNoSugarOps(module StdModule)
	for func in module.functions 'eachFunc'
		for opIdx in module.liveOpIndices(func) 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("assertNoSugarOps: live op index {opIdx} not in module.ops")
			if op.rawValue.category == StdOpCategory.sugar 'isSugar'
				panic("Std→Target: a `sugar`-category StdOp survived into the backend in function '{String.from(func.name)}' — lowerToMachineForm did not run, or does not handle this op")
			end 'isSugar'
		end 'eachOp'
	end 'eachFunc'
end 'assertNoSugarOps'
