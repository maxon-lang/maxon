// TargetPrinter — serialize a lowered TargetModule to a stable, human-readable
// text form (v1's `RequiredIR` look, trimmed to shv2's thin Target tier).
//
// Two consumers: `build --emit-ir` (writes the printed IR to `<output>.ir`) and
// the spec runner (embeds it in a committed `.test` fragment so every test
// carries its generated code, diffable across codegen changes — v1's
// `specs/fragments-*` model).
//
// WHY the op match is exhaustive with NO bare `default`: this printer is the one
// place a new `TargetOp` variant is forced to be handled. TargetOp carries no
// tier boundary that would make an unprinted op unrepresentable, so a `default`
// arm here would silently print `??` for any op a later milestone adds. An
// exhaustive `match` turns "someone added a TargetOp" into a COMPILE error at
// `formatTargetOp`, so the printer can never fall out of sync with the dialect.
// This is the same "you cannot add an op without declaring its facts" discipline
// the dialect's `TargetOpMeta` enforces, applied to text emission.

// Two-space nesting, ISA-mnemonic prefix, and the section punctuation are format
// contracts shared with the committed fragments — named, not scattered literals,
// so the one place the layout is defined is here.
let BlockLabelIndent = "  "
let OpIndent = "    "

// Every mnemonic is prefixed once by the ISA namespace (`x64.`) at the print
// site rather than baked into all 16 match arms — the arms stay mnemonic-only
// and the namespace lives in one constant.
let X64OpPrefix = "x64."
let Arm64OpPrefix = "arm64."
let FuncHeaderPrefix = "func @"

// Serialize a whole TargetModule: each function in module order (the entry stub
// `mrt_start` first, then user functions in source order — a deterministic
// order the register allocator and lowering preserve), separated by one blank
// line, with no trailing blank line.
//
// `includeRuntime` gates the emitted-runtime/entry functions (`mrt_start`, and
// later the `__slab_*`/`__mm_*`/`__destruct_*` runtime): the committed spec
// fragments pass `false` so a fragment shows ONLY the program's own functions —
// the shared runtime scaffolding never changes per-test and is pure noise there.
// `build --emit-ir` passes `true` for the complete backend-debugging view.
//
// The printed text grows with the PROGRAM, so both accumulators here are `StringBuilder`s: a `String`
// owns exactly the bytes it holds and its `append` recopies all of them (stdlib/String.maxon), which
// would make printing a module quadratic in its own output.
// ⭐ THE `.data` SECTION IS PRINTED FIRST, and it is the reason `globalData` is a parameter here.
//
// It gives the top-level `var` feature the SAME gate every other emitted thing has: the golden
// fragment pins the layout, so a slot that moves, changes width, or changes its initial value is a
// FAILING TEST with a reviewable diff rather than a silent difference in a program's starting state
// — which no exit code can see until the one path that reads that global happens to run.
//
// ⚠ It is NOT what a ```RequiredData block is checked against, and an earlier draft of this comment
// said it was. `SpecTestRunner.checkRequiredData` parses that block into BYTES and compares them
// against the `.data` section read back out of the linked PE (`PeSectionReader`) — this text is
// never consulted. That independence is deliberate and is the gate's whole value: a spec checked
// against the printer would only ever prove the compiler agrees with itself, and could not catch a
// section header with a wrong RVA or a raw pointer off by an alignment. The two share the `i64 42`
// NOTATION because it reads well in both places; they share no code, and that is the point.
//
// So the two gates are complementary, not redundant: this golden pins what the compiler DECIDED,
// RequiredData pins what the linker actually WROTE.
//
// A program with no global prints NOTHING here, not an empty header: the section does not exist, and
// every pre-existing golden is unchanged by this rung as a result.
export function printDataSection(globalData GlobalDataTable) returns String
	if globalData.dataSection.count() == 0 'noGlobals'
		return ""
	end 'noGlobals'

	var out = StringBuilder.create()
	out.append("data \{\n")
	for entry in globalData.dataSection 'each'
		out.append("  {entry.label}@{entry.offset} = {entry.valueType.name} {entry.value}\n")
	end 'each'
	out.append("}\n")
	return out.build()
end 'printDataSection'

export function printTargetModule(module TargetModule, globalData GlobalDataTable, includeRuntime bool) returns String
	var body = StringBuilder.create()
	let dataText = printDataSection(globalData)
	body.append(dataText)
	// The data block is followed by a blank line, exactly as two functions are — so a program WITH
	// globals reads as `data { … }` then its functions, and one WITHOUT is byte-for-byte unchanged.
	var afterFirst = dataText.byteLength() > 0

	// The module's ISA, recovered once and threaded down so the SHARED ops (which carry no ISA of their
	// own) name their operands against the right register file. See `moduleTargetCpu`.
	let cpu = moduleTargetCpu(module)

	for func in module.functions 'eachFunc'
		if not includeRuntime and isRuntimeFunction(func) 'skipRuntime'
			continue
		end 'skipRuntime'

		if afterFirst 'separator'
			body.append("\n")
		end 'separator'

		body.append(printTargetFunction(module, func: func, cpu: cpu))
		afterFirst = true
	end 'eachFunc'

	return body.build()
end 'printTargetModule'

// True for the runtime/entry functions shv2's backend synthesizes (not from user source): the entry stub
// `mrt_start`, the emitted `__`-prefixed runtime (`__slab_*`, `__mm_*`, `__destruct_*`, …), the
// `__fnref_` env-thunks and `__module_init`/`__module_cleanup`.
//
// EXPORTED because it is the SAME set the P1.5-B1a′ GT stack guard EXEMPTS (X64Backend's
// `emitFunctionChunk`): a runtime function must never trigger `__gt_morestack` — the scheduler core
// runs the grower, and its own kernel calls are already shimmed onto the system stack (slice 1) — so
// "which functions are compiler-emitted runtime" is one predicate, shared by the golden-skip here and
// the guard exemption there, not two copies free to drift.
//
// ⚠⚠ **THE NAME SHAPE ALONE WAS A REACHABLE SEGFAULT, AND PROVENANCE IS THE SECOND CLAUSE THAT FIXES IT
// (A1r review).** This read the two prefixes and nothing else, on the stated premise *"Maxon reserves `__`
// for compiler-internal names, so a user function can never collide"* — which **D6 falsified**:
// `stdlib/Builtins.maxon` may DECLARE `__`-prefixed names, and A1r made them CALLABLE. A user function
// wearing the prefix was therefore handed the SCHEDULER's exemption. MEASURED on x64-windows: a
// `__probeDeep` declared in that module, recursing 4000 deep inside an `async` worker, **SIGSEGVs (exit
// 139)** because no guard ever called `__gt_morestack`; the identical program with the `__` dropped from
// the name exits **42**. A safety exemption keyed on a naming convention is only as sound as the
// convention, and this convention had acquired an exemption of its own.
//
// **`sourceFilePath` is the fact, and it is recorded at CONSTRUCTION by the only party that knows it**: the
// parser stamps it on every function it builds (`parseFunction`, and `parseClosureExpression` for a lifted
// closure), and `IrFunction.createFromStd` / `ModuleInit`'s `IrFunction.create` — the two doors a synthesized
// function comes through — leave it empty. So it is derived rather than guessed, and no name can fool it:
// not a declared `__int_fromString`, and not a lifted closure inside one (`__int_fromString$closure_0`),
// which the prefix test also exempted.
//
// ⚠ **IT NARROWS THE NAME TEST AND DOES NOT REPLACE IT, and that is not conservatism — MEASURED, replacing
// it fails 118 spec tests.** An empty `sourceFilePath` is a strictly WIDER set than this one: it also holds
// the SYNTHESIZED BUILTIN bodies — `int.compare`, `String.hash`, the `Set`/`CharacterSet` families — which
// are compiler-built but deliberately wear NO prefix (a witness reloc must name a real `.text` symbol; see
// `IrInterface.isBuiltinConformanceImplName`). Those are exactly the bodies the `set`/`string-trim`/
// `character-set`/`primitive-comparable` goldens exist to pin, and on the GT side they are ordinary frames a
// green thread runs and MUST grow for. Both readers want *"the invariant scaffolding"*, which is the
// CONJUNCTION: the runtime's own naming band, and not parsed from source.
export function isRuntimeFunction(func IrFunction) returns bool
	return (bytesStartWith(func.name, prefix: b"mrt_") or bytesStartWith(func.name, prefix: b"__")) and func.sourceFilePath.isEmpty()
end 'isRuntimeFunction'

// Serialize one function: `func @<name> {`, then each block as `<label>:` followed
// by its ops (and terminator) one per line, then the closing brace.
function printTargetFunction(module TargetModule, func IrFunction, cpu CpuArch) returns String
	let openBrace = "\{"
	let closeBrace = "\}"
	var sb = StringBuilder.create()
	sb.append("{FuncHeaderPrefix}{String.from(func.name)} {openBrace}\n")

	// The function's blocks in `blockRefs` order — the same public-API walk the
	// backend's `emitFunctionChunk` uses. Collected once so branch targets can be
	// resolved to labels against it.
	let funcBlocks = resolveFuncBlocks(module.blocks, blockRefs: func.blockRefs)

	for block in funcBlocks 'eachBlock'
		sb.append("{BlockLabelIndent}{String.from(block.label)}:\n")

		for opIdx in block.opRefs 'eachOp'
			sb.append(printOpLine(module, opIdx: opIdx, blocks: funcBlocks, cpu: cpu))
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerm'
			sb.append(printOpLine(module, opIdx: block.terminatorIndex(), blocks: funcBlocks, cpu: cpu))
		end 'hasTerm'
	end 'eachBlock'

	sb.append("{closeBrace}\n")
	return sb.build()
end 'printTargetFunction'

// One op, indented, ISA-prefixed, newline-terminated. An out-of-range op index
// is an invariant violation (a block references an op not in `module.ops`), not
// a user error, so it panics rather than printing a sentinel.
function printOpLine(module TargetModule, opIdx OpIndex, blocks IrBlockArray, cpu CpuArch) returns String
	let op = try module.ops.get(opIdx) otherwise panic("printOpLine: op index {opIdx} out of range in module.ops")
	return "{OpIndent}{opIsaPrefix(cpu)}{formatTargetOp(op, blocks: blocks, cpu: cpu)}\n"
end 'printOpLine'

// The ISA namespace ops print under — the whole module's, not the op's. A module is single-target
// (buildBackend dispatches on cpu), so every op prints `x64.` or `arm64.` uniformly; a SHARED op
// (movRegReg, the spill/reload forms, xchgRegReg) prints under the module's ISA, not the x64 band it
// happens to sit in. x64 output stays byte-identical (an x64 module's ops all printed `x64.` before).
function opIsaPrefix(cpu CpuArch) returns String
	return match cpu 'c'
		x64 gives X64OpPrefix
		arm64 gives Arm64OpPrefix
		wasm32 panic("opIsaPrefix: maxon-shv2 has no wasm Target printer")
	end 'c'
end 'opIsaPrefix'

// The ISA a Target module was lowered for, recovered from its ops: any op in the arm64 band means an
// arm64 module, else x64. A module is single-ISA, and the SHARED ops carry no ISA of their own, so
// their operands can only be named against the module's ISA — recovered here once (the printer's
// caller lives in another tier's file, so deriving it keeps the name rendering self-contained).
function moduleTargetCpu(module TargetModule) returns CpuArch
	for op in module.ops 'eachOp'
		if opIsArm64Band(op) 'arm64'
			return CpuArch.arm64
		end 'arm64'
	end 'eachOp'
	return CpuArch.x64
end 'moduleTargetCpu'

// True when `op` is one of the arm64-SPECIFIC ops (the `arm64Ret..arm64ImportCall` band) — the shared
// ops (in the x64 band positionally) and the x64-specific ops are false, so a module is arm64 iff it
// holds at least one of these. Exhaustive, so a new op variant is a compile error, not a mis-classify.
function opIsArm64Band(op TargetOp) returns bool
	return match op 'p'
		prologue to leaRegRdata gives false
		arm64Ret to arm64Syscall gives true
		// P1.5-A1: the x64 `leaRegFunc`/`callReg`, and the x64-linux `x64Syscall`, are appended past the
		// arm64 band (band-append), but they are x64 ops, so `false` — a module is NOT arm64 for holding them.
		leaRegFunc to x64Syscall gives false
		// The jump tables are per-ISA: `x64JumpTable` is an x64 op (module not arm64 for it), `arm64JumpTable`
		// an arm64 one.
		x64JumpTable gives false
		arm64JumpTable gives true
		// The memory-indirect witness call is an x64 op (P1.7a slice 2a).
		callMem gives false
		// The stack-argument pair IS arm64-specific (see their dialect header for why x64 needs no op).
		arm64StoreOutgoingArg to arm64LoadIncomingArg gives true
		// P1.7a's last slice: `arm64FmovGprFp` is the arm64 half of the bit reinterpretation, so a
		// module holding one IS arm64. Its x64 twin `movqGprXmm` sits inside the `prologue to
		// leaRegRdata` arm above and is correctly `false` there.
		arm64FmovGprFp gives true
	end 'p'
end 'opIsArm64Band'

// Render one TargetOp as `<mnemonic> <operands>` (the ISA namespace is added by the caller).
// EXHAUSTIVE over every TargetOp variant — see the file header: no bare `default`, so a new variant is
// a compile error here, not a silent `??`. `cpu` names the module's ISA so the SHARED ops render their
// operands against the right register file (`sharedVregName`); the x64/arm64-specific arms need no
// dispatch (they only ever appear in their own ISA's modules).
function formatTargetOp(op TargetOp, blocks IrBlockArray, cpu CpuArch) returns String
	return match op 'op'
		prologue(stackSize) gives "prologue {stackSize}"
		epilogue(stackSize) gives "epilogue {stackSize}"
		ret gives "ret"
		jmp(targetBlockId) gives "jmp {String.from(resolveBlockLabel(targetBlockId, blocks: blocks))}"
		jcc(cond, targetBlockId) gives "jcc {condCodeName(cond)}, {String.from(resolveBlockLabel(targetBlockId, blocks: blocks))}"
		movRegImm(dest, value) gives "movRegImm {vregName(dest)}, {value}"
		movRegImm32(dest, value) gives "movRegImm32 {vregName(dest)}, {value}"
		movRegReg(destReg, srcReg) gives "movRegReg {sharedVregName(destReg, cpu: cpu)}, {sharedVregName(srcReg, cpu: cpu)}"
		movReg32Reg32(destReg, srcReg) gives "movReg32Reg32 {vregName(destReg)}, {vregName(srcReg)}"
		subRegReg(dest, lhs, rhs) gives "subRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		imulRegReg(dest, lhs, rhs) gives "imulRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		negReg(dest, src) gives "negReg {vregName(dest)}, {vregName(src)}"
		cmpRegReg(lhsReg, rhsReg) gives "cmpRegReg {vregName(lhsReg)}, {vregName(rhsReg)}"
		leaRegRegReg(dest, base, index) gives "leaRegRegReg {vregName(dest)}, {vregName(base)}, {vregName(index)}"
		leaRegRegImm32(dest, base, disp) gives "leaRegRegImm32 {vregName(dest)}, {vregName(base)}, {disp}"
		imulRegRegImm32(dest, src, imm) gives "imulRegRegImm32 {vregName(dest)}, {vregName(src)}, {imm}"
		cmpRegImm32(reg, imm) gives "cmpRegImm32 {vregName(reg)}, {imm}"
		xchgRegReg(a, b) gives "xchgRegReg {sharedVregName(a, cpu: cpu)}, {sharedVregName(b, cpu: cpu)}"
		callDirect(targetName) gives "callDirect {String.from(targetName)}"
		iatCall(slotIndex) gives "iatCall {slotIndex}"
		cqo gives "cqo"
		idivReg(divisor) gives "idivReg {vregName(divisor)}"
		pushReg(reg) gives "pushReg {registerName(reg)}"
		popReg(reg) gives "popReg {registerName(reg)}"
		storeSlotReg(slot, srcReg) gives "storeSlotReg slot{slot}, {sharedVregName(srcReg, cpu: cpu)}"
		loadRegSlot(destReg, slot) gives "loadRegSlot {sharedVregName(destReg, cpu: cpu)}, slot{slot}"
		andRegReg(dest, lhs, rhs) gives "andRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		orRegReg(dest, lhs, rhs) gives "orRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		xorRegReg(dest, lhs, rhs) gives "xorRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		notReg(dest, src) gives "notReg {vregName(dest)}, {vregName(src)}"
		andRegImm32(dest, lhs, imm) gives "andRegImm32 {vregName(dest)}, {vregName(lhs)}, {imm}"
		orRegImm32(dest, lhs, imm) gives "orRegImm32 {vregName(dest)}, {vregName(lhs)}, {imm}"
		xorRegImm32(dest, lhs, imm) gives "xorRegImm32 {vregName(dest)}, {vregName(lhs)}, {imm}"
		shlRegImm8(dest, lhs, imm) gives "shlRegImm8 {vregName(dest)}, {vregName(lhs)}, {imm}"
		sarRegImm8(dest, lhs, imm) gives "sarRegImm8 {vregName(dest)}, {vregName(lhs)}, {imm}"
		shrRegImm8(dest, lhs, imm) gives "shrRegImm8 {vregName(dest)}, {vregName(lhs)}, {imm}"
		shlRegCl(dest, lhs) gives "shlRegCl {vregName(dest)}, {vregName(lhs)}"
		sarRegCl(dest, lhs) gives "sarRegCl {vregName(dest)}, {vregName(lhs)}"
		shrRegCl(dest, lhs) gives "shrRegCl {vregName(dest)}, {vregName(lhs)}"
		setccReg(dest, cond) gives "setccReg {condCodeName(cond)}, {vregName(dest)}"
		// The data-section band. The LABEL is printed, because it is what the golden pins: a fragment
		// showing `leaRegGlobal rax, __data_counter` is what makes a wrong slot a reviewable diff.
		leaRegGlobal(dest, label) gives "leaRegGlobal {vregName(dest)}, {String.from(label)}"
		loadRegBaseDisp(dest, base, disp, width) gives "loadRegBaseDisp.{accessWidthName(width)} {sharedVregName(dest, cpu: cpu)}, [{sharedVregName(base, cpu: cpu)} + {disp}]"
		storeBaseDispReg(base, disp, src, width) gives "storeBaseDispReg.{accessWidthName(width)} [{sharedVregName(base, cpu: cpu)} + {disp}], {sharedVregName(src, cpu: cpu)}"
		addsdRegReg(dest, lhs, rhs) gives "addsdRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		subsdRegReg(dest, lhs, rhs) gives "subsdRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		mulsdRegReg(dest, lhs, rhs) gives "mulsdRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		divsdRegReg(dest, lhs, rhs) gives "divsdRegReg {vregName(dest)}, {vregName(lhs)}, {vregName(rhs)}"
		ucomisdRegReg(lhs, rhs) gives "ucomisdRegReg {vregName(lhs)}, {vregName(rhs)}"
		movsdRegRip(dest, label) gives "movsdRegRip {vregName(dest)}, [rip + {String.from(label)}]"
		cvtsi2sdRegReg(dest, src) gives "cvtsi2sdRegReg {vregName(dest)}, {vregName(src)}"
		cvttsd2siRegReg(dest, src) gives "cvttsd2siRegReg {vregName(dest)}, {vregName(src)}"
		// The MATH INTRINSICS. `roundsd`'s MODE is printed by its `FloatRoundMode` member name rather
		// than its imm8: what the golden must pin is the ROUNDING, and `0x01` cannot be reviewed
		// without the manual open beside it.
		sqrtsdRegReg(dest, src) gives "sqrtsdRegReg {vregName(dest)}, {vregName(src)}"
		roundsdRegReg(dest, src, mode) gives "roundsdRegReg.{mode.name} {vregName(dest)}, {vregName(src)}"
		// The BIT REINTERPRETATION. Printed dest-first like every other x64 arm here, NOT in the
		// encoder's inverted ModR/M order — a golden shows the data flow, and the field inversion is
		// `encodeMovqGprXmm`'s private business.
		movqGprXmm(dest, src) gives "movqGprXmm {vregName(dest)}, {vregName(src)}"
		// The LABEL is printed for the same reason `leaRegGlobal`'s is: a fragment showing which
		// `.rdata` record a `lea` names makes a wrong record a reviewable diff.
		leaRegRdata(dest, label) gives "leaRegRdata {vregName(dest)}, [rip + {String.from(label)}]"
		// --- arm64 SCALAR-CORE band ---
		//
		// Each arm64 operand prints through `arm64VregName` (its `RegNum` mapped to an arm64 register
		// name), and each condition through the `Arm64CondCode` member name. The mnemonics are the
		// arm64 spellings; the `arm64.` namespace is added by `opIsaPrefix` at the print site.
		arm64Ret gives "ret"
		arm64Branch(targetBlockId) gives "b {String.from(resolveBlockLabel(targetBlockId, blocks: blocks))}"
		arm64CondBranch(cond, targetBlockId) gives "b.{cond.name} {String.from(resolveBlockLabel(targetBlockId, blocks: blocks))}"
		arm64Cbz(reg, targetBlockId) gives "cbz {arm64VregName(reg)}, {String.from(resolveBlockLabel(targetBlockId, blocks: blocks))}"
		arm64Cbnz(reg, targetBlockId) gives "cbnz {arm64VregName(reg)}, {String.from(resolveBlockLabel(targetBlockId, blocks: blocks))}"
		arm64MovImm(dest, value) gives "movImm {arm64VregName(dest)}, {value}"
		// The frame-record offset is rendered ONLY when the frame has an outgoing stack-argument region to push
		// it past — which is what having one MEANS, and which no function in the corpus does. Rendering an
		// unconditional `+0` would be a golden's worth of noise about a region that does not exist, on every
		// arm64 function there is. The rendering stays injective: a frame with a region reads differently from
		// one without.
		arm64Prologue(stackSize, recordOffset) gives "prologue {stackSize}" if recordOffset == 0 else "prologue {stackSize} record@{recordOffset}"
		arm64Epilogue(stackSize, recordOffset) gives "epilogue {stackSize}" if recordOffset == 0 else "epilogue {stackSize} record@{recordOffset}"
		arm64Add(dest, lhs, rhs) gives "add {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Sub(dest, lhs, rhs) gives "sub {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Mul(dest, lhs, rhs) gives "mul {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Sdiv(dest, lhs, rhs) gives "sdiv {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Udiv(dest, lhs, rhs) gives "udiv {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Msub(dest, mulLhs, mulRhs, minuend) gives "msub {arm64VregName(dest)}, {arm64VregName(mulLhs)}, {arm64VregName(mulRhs)}, {arm64VregName(minuend)}"
		arm64And(dest, lhs, rhs) gives "and {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Orr(dest, lhs, rhs) gives "orr {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Eor(dest, lhs, rhs) gives "eor {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Lslv(dest, lhs, rhs) gives "lslv {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Asrv(dest, lhs, rhs) gives "asrv {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Lsrv(dest, lhs, rhs) gives "lsrv {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Neg(dest, src) gives "neg {arm64VregName(dest)}, {arm64VregName(src)}"
		arm64Mvn(dest, src) gives "mvn {arm64VregName(dest)}, {arm64VregName(src)}"
		arm64AddImm(dest, src, imm) gives "add {arm64VregName(dest)}, {arm64VregName(src)}, {imm}"
		arm64SubImm(dest, src, imm) gives "sub {arm64VregName(dest)}, {arm64VregName(src)}, {imm}"
		arm64AndImm(dest, src, imm) gives "and {arm64VregName(dest)}, {arm64VregName(src)}, {imm}"
		arm64OrrImm(dest, src, imm) gives "orr {arm64VregName(dest)}, {arm64VregName(src)}, {imm}"
		arm64EorImm(dest, src, imm) gives "eor {arm64VregName(dest)}, {arm64VregName(src)}, {imm}"
		arm64LslImm(dest, src, imm) gives "lsl {arm64VregName(dest)}, {arm64VregName(src)}, {imm}"
		arm64AsrImm(dest, src, imm) gives "asr {arm64VregName(dest)}, {arm64VregName(src)}, {imm}"
		arm64LsrImm(dest, src, imm) gives "lsr {arm64VregName(dest)}, {arm64VregName(src)}, {imm}"
		arm64Cmp(lhs, rhs) gives "cmp {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64CmpImm(reg, imm) gives "cmp {arm64VregName(reg)}, {imm}"
		arm64Cset(dest, cond) gives "cset {arm64VregName(dest)}, {cond.name}"
		arm64LeaFuncAddr(dest, funcName) gives "leaFuncAddr {arm64VregName(dest)}, {String.from(funcName)}"
		arm64LeaRdata(dest, label) gives "leaRdata {arm64VregName(dest)}, {String.from(label)}"
		arm64LeaGlobal(dest, label) gives "leaGlobal {arm64VregName(dest)}, {String.from(label)}"
		arm64BranchLink(targetName) gives "bl {String.from(targetName)}"
		arm64BranchLinkReg(reg) gives "blr {arm64VregName(reg)}"
		arm64Fadd(dest, lhs, rhs) gives "fadd {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Fsub(dest, lhs, rhs) gives "fsub {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Fmul(dest, lhs, rhs) gives "fmul {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Fdiv(dest, lhs, rhs) gives "fdiv {arm64VregName(dest)}, {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Fcmp(lhs, rhs) gives "fcmp {arm64VregName(lhs)}, {arm64VregName(rhs)}"
		arm64Scvtf(dest, src) gives "scvtf {arm64VregName(dest)}, {arm64VregName(src)}"
		arm64Fcvtzs(dest, src) gives "fcvtzs {arm64VregName(dest)}, {arm64VregName(src)}"
		arm64Fsqrt(dest, src) gives "fsqrt {arm64VregName(dest)}, {arm64VregName(src)}"
		// The arm64 arms print REAL MNEMONICS (`fcvtzs`, `scvtf`, …), and `FRINT<r>`'s rounding is part
		// of its mnemonic rather than a printed operand — so the mode resolves to the letter the
		// assembler would show.
		arm64Frint(dest, src, mode) gives "{arm64FrintMnemonic(mode)} {arm64VregName(dest)}, {arm64VregName(src)}"
		arm64FpLoadRdata(dest, label) gives "fpLoadRdata {arm64VregName(dest)}, [rdata + {String.from(label)}]"
		arm64ImportCall(slotIndex) gives "importCall {slotIndex}"
		arm64Syscall(number) gives "syscall {number}"
		leaRegFunc(dest, funcName) gives "leaRegFunc {vregName(dest)}, [rip + {String.from(funcName)}]"
		callReg(reg) gives "callReg {vregName(reg)}"
		x64Syscall(number) gives "x64Syscall {number}"
		// The jump tables render the biased index, the default, and the slot→target table run-length
		// encoded (`[lo..hi]=label`), so a range/`or` arm's several identical slots collapse to one entry
		// and the table stays readable even at the span cap.
		x64JumpTable(indexReg, defaultTarget, caseTargets, tableLabel) gives "jumpTable {sharedVregName(indexReg, cpu: cpu)}, default={String.from(resolveBlockLabel(defaultTarget, blocks: blocks))} [{formatJumpTableSlots(caseTargets, blocks: blocks)}] @{String.from(tableLabel)}"
		arm64JumpTable(indexReg, defaultTarget, caseTargets, tableLabel) gives "jumpTable {sharedVregName(indexReg, cpu: cpu)}, default={String.from(resolveBlockLabel(defaultTarget, blocks: blocks))} [{formatJumpTableSlots(caseTargets, blocks: blocks)}] @{String.from(tableLabel)}"
		callMem(baseReg, disp) gives "callMem [{vregName(baseReg)} + {disp}]"
		// The arm64 stack-argument pair renders the SLOT, not an address, because a slot is all either op
		// carries — the address is a frame fact the encoder (outgoing) or the prologue pass (incoming) adds.
		arm64StoreOutgoingArg(slot, srcReg) gives "storeOutgoingArg [sp + arg{slot}], {arm64VregName(srcReg)}"
		arm64LoadIncomingArg(dest, slot) gives "loadIncomingArg {arm64VregName(dest)}, [arg{slot}]"
		// The arm64 BIT REINTERPRETATION. Printed `fmov` — the real mnemonic, as every arm64 arm here
		// is — and the operand NAMES disambiguate it from the FP→FP `fmov` the shared `movRegReg`
		// emits: `arm64VregName` renders a GPR `x<n>` and an FP register `d<n>`, so `fmov x0, d1` and
		// `fmov d0, d1` read as the two different instructions they are.
		arm64FmovGprFp(dest, src) gives "fmov {arm64VregName(dest)}, {arm64VregName(src)}"
	end 'op'
end 'formatTargetOp'

// Render a jump table's slot→target array run-length encoded: consecutive slots with the same target
// become one `[lo..hi]=label` entry (or `[i]=label` for a single slot), so a range arm's several slots
// read as one span and an all-distinct table reads as one entry per slot. Keeps the dump legible without
// losing which slot routes where.
function formatJumpTableSlots(caseTargets BlockIdArray, blocks IrBlockArray) returns String
	if caseTargets.count() == 0 'empty'
		return ""
	end 'empty'

	var out = StringBuilder.create()
	var afterFirst = false
	var runStart = 0 as ElementCount
	var runTarget = try caseTargets.get(0) otherwise panic("formatJumpTableSlots: caseTargets.get(0) on non-empty")
	for i in 1 upto caseTargets.count() 'each'
		let target = try caseTargets.get(i) otherwise panic("formatJumpTableSlots: caseTargets.get OOB at {i}")
		if target != runTarget 'runEnd'
			appendJumpTableRun(out, afterFirst: afterFirst, runStart: runStart, runEnd: i - 1, target: runTarget, blocks: blocks)
			afterFirst = true
			runStart = i
			runTarget = target
		end 'runEnd'
	end 'each'
	appendJumpTableRun(out, afterFirst: afterFirst, runStart: runStart, runEnd: caseTargets.count() - 1, target: runTarget, blocks: blocks)

	return out.build()
end 'formatJumpTableSlots'

function appendJumpTableRun(out StringBuilder, afterFirst bool, runStart ElementCount, runEnd ElementCount, target BlockId, blocks IrBlockArray)
	if afterFirst 'separator'
		out.append(", ")
	end 'separator'
	let label = String.from(resolveBlockLabel(target, blocks: blocks))
	if runStart == runEnd 'single'
		out.append("[{runStart}]={label}")
	end 'single' else 'span'
		out.append("[{runStart}..{runEnd}]={label}")
	end 'span'
end 'appendJumpTableRun'

// The printed form of a SHARED op's operand — one that appears in BOTH ISAs (movRegReg, the
// spill/reload and base+disp forms, xchgRegReg) and so carries a neutral `RegNum` with no ISA of its
// own. It names the operand against the MODULE's register file: the x64 names in an x64 module, the
// arm64 names in an arm64 module. Without this a shared op in an arm64 module would print `rax` for
// RegNum 0 where it means `x0` — the register file is right, only the naming table was wrong.
function sharedVregName(vreg TargetVReg, cpu CpuArch) returns String
	return match cpu 'c'
		x64 gives vregName(vreg)
		arm64 gives arm64VregName(vreg)
		wasm32 panic("sharedVregName: maxon-shv2 has no wasm Target printer")
	end 'c'
end 'sharedVregName'

// The printed form of an arm64 operand: a colored physical register by its arm64 name (`x0`, `d5`,
// …) or a still-virtual value by its SSA id. `TargetVReg.physical` carries a neutral `RegNum`, which
// the printer — one tier above the neutral op — maps back through `Arm64Register`, exactly as the
// arm64 encoder will. The x64 twin is `vregName`.
function arm64VregName(vreg TargetVReg) returns String
	return match vreg 'v'
		physical(reg) gives arm64RegName(reg)
		virtual(id) gives "v{id}"
	end 'v'
end 'arm64VregName'

// The arm64 register name for a colored `RegNum` — the `Arm64Register` member name (x0..x30 for
// 0..30, d0..d31 for 31..62). The enum's own names ARE the register names, so no second table.
function arm64RegName(reg RegNum) returns String
	let r = try Arm64Register.fromRawValue(reg) otherwise panic("arm64RegName: register number {reg} names no arm64 register (0..62)")
	return r.name
end 'arm64RegName'

// A machine-register operand: a colored physical GPR by its ISA name (`rax`,
// `r8`, …) or a still-virtual value by its SSA id (`v<id>`). A fully lowered
// module (what CodeResult.targetModule holds) has only `physical`; `virtual`
// appears only when printing pre-regalloc IR for debugging.
// The printed form of an x64 operand: a colored physical register by its x64 name, or a still-
// virtual value by its SSA id. `TargetVReg.physical` now carries a neutral `RegNum`, so the printer
// — a per-ISA reader, one tier above the neutral op — maps it back through `X64Register` exactly as
// the x64 encoder does. arm64 ops print through `arm64VregName` instead (their operands name arm64
// registers), which is why this stays x64-specific rather than taking an ISA parameter.
function vregName(vreg TargetVReg) returns String
	return match vreg 'v'
		physical(reg) gives registerName(try X64Register.fromRawValue(reg) otherwise panic("vregName: colored register number {reg} is not a valid X64Register"))
		virtual(id) gives "v{id}"
	end 'v'
end 'vregName'

// The ISA name of each general-purpose register. Exhaustive over X64Register so a
// register-file change (e.g. adding the XMM file as its own enum) does not
// silently misname a register.
function registerName(reg X64Register) returns String
	return match reg 'r'
		rax gives "rax"
		rcx gives "rcx"
		rdx gives "rdx"
		rbx gives "rbx"
		rsp gives "rsp"
		rbp gives "rbp"
		rsi gives "rsi"
		rdi gives "rdi"
		r8 gives "r8"
		r9 gives "r9"
		r10 gives "r10"
		r11 gives "r11"
		r12 gives "r12"
		r13 gives "r13"
		r14 gives "r14"
		r15 gives "r15"
		xmm0 gives "xmm0"
		xmm1 gives "xmm1"
		xmm2 gives "xmm2"
		xmm3 gives "xmm3"
		xmm4 gives "xmm4"
		xmm5 gives "xmm5"
		xmm6 gives "xmm6"
		xmm7 gives "xmm7"
		xmm8 gives "xmm8"
		xmm9 gives "xmm9"
		xmm10 gives "xmm10"
		xmm11 gives "xmm11"
		xmm12 gives "xmm12"
		xmm13 gives "xmm13"
		xmm14 gives "xmm14"
		xmm15 gives "xmm15"
	end 'r'
end 'registerName'

// The printed suffix of a memory access's width — what makes a golden fragment show that a bool
// global moved ONE byte and an int moved eight. Without it the two loads print identically and the
// one gate that could catch a wrong-width access says nothing.
function accessWidthName(width X64AccessWidth) returns String
	return match width 'w'
		byte gives "byte"
		word64 gives "word64"
	end 'w'
end 'accessWidthName'

// The arm64 mnemonic for each rounding mode `arm64Frint` can carry. Unlike x64's `roundsd`, whose
// mode is a printed imm8 operand, arm64 spells the rounding INTO the mnemonic — so a golden reads
// `frintm` where the x64 golden reads `roundsdRegReg.towardNegative`, and each matches what its own
// assembler would show.
function arm64FrintMnemonic(mode FloatRoundMode) returns String
	return match mode 'm'
		nearestTiesToEven gives "frintn"
		towardNegative gives "frintm"
		towardPositive gives "frintp"
	end 'm'
end 'arm64FrintMnemonic'

// The mnemonic name of each condition code a fused `jcc` can carry. Exhaustive
// over X64CondCode so a new comparison predicate forces a printable name.
function condCodeName(cond X64CondCode) returns String
	return match cond 'c'
		below gives "below"
		aboveEqual gives "aboveEqual"
		equal gives "equal"
		notEqual gives "notEqual"
		belowEqual gives "belowEqual"
		above gives "above"
		parity gives "parity"
		noParity gives "noParity"
		less gives "less"
		greaterEqual gives "greaterEqual"
		lessEqual gives "lessEqual"
		greater gives "greater"
	end 'c'
end 'condCodeName'
