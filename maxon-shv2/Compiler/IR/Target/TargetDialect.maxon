// Target Dialect — target-specific (x64) machine instructions, the lowest IR
// tier before machine-code emission. The Std→Target lowering (StdToX64Conversion)
// emits these ops; the register allocator colors their virtual registers into
// physical GPRs.
//
// THIN for maxon-shv2 M1: carries exactly the x64 ops the `return 42` slice
// needs — materialize a constant into a register (movRegImm / movRegImm32),
// move a value between registers (movRegReg, for the R8 return move + regalloc
// copies), the frame/return control ops (prologue / epilogue / ret), and the
// three ops the runtime entry stub `mrt_start` is built from: a direct call to
// the user entry (callDirect), the custom-ABI→Win64 bridge move (movReg32Reg32,
// `mov ecx, r8d`), and an IAT-relative indirect call (iatCall, `call ExitProcess`
// through the import table). Later milestones GROW `TargetOp` with the ALU /
// compare-branch / general call / memory / FP (XMM) ops as features land, and
// GROW the register representation with the XMM register file. arm64 support
// arrives at its own milestone; M1 is x64-windows only, so `TargetModule`
// currently carries only x64 ops.
//
// v1 returns the primary value in R8 (NOT RAX) under its self-designed calling
// convention; the physical GPR enum here includes R8 so B2's regalloc + return
// move can target it. v1's per-variant `X64OpMeta` scheduling/regalloc metadata
// is preserved in thinned form (`TargetOpMeta`) so a new op cannot be added
// without declaring its memory/store/call/flags semantics; B2 GROWS it with the
// register-allocator `OpPattern` + implicit-register masks when it ports the
// allocator (deferred here because they drag in the whole regalloc scaffold).

// The 16 general-purpose registers of x86-64, in encoding order (0=rax .. 15=r15).
// B2's register allocator colors virtual registers into this set; the return
// value lands in R8 per Maxon's internal calling convention.
export enum X64Register
	rax
	rcx
	rdx
	rbx
	rsp
	rbp
	rsi
	rdi
	r8
	r9
	r10
	r11
	r12
	r13
	r14
	r15
end 'X64Register'

// A machine register operand: either a concrete physical GPR or a virtual
// register identified by the SSA ValueId that defined it. Every `movImm`
// result arrives as a `virtual`; B2's register allocator rewrites each into a
// `physical` during coloring.
export union X64VReg
	physical(reg X64Register)
	virtual(id ValueId)
end 'X64VReg'

// x64 condition codes — the `tttn` nibble of a `jcc`/`setcc` opcode. The backing
// value IS the nibble, so the `jcc` encoder forms its opcode as `0x80 | rawValue`
// (e.g. `equal` = 0x4 → `0F 84` = JE) with no separate lookup table. M4 emits only
// the SIGNED integer comparisons (`less`/`greater`/… are the signed JL/JG family,
// not the unsigned JB/JA family) — all Std integers are signed i64. StdToX64Conversion
// maps each `StdCmpPred` to one of these when it fuses a compare with its branch.
export enum X64CondCode
	equal = 0x4  // JE  / JZ
	notEqual = 0x5  // JNE / JNZ
	less = 0xC  // JL  (signed <)
	greaterEqual = 0xD  // JGE (signed >=)
	lessEqual = 0xE  // JLE (signed <=)
	greater = 0xF  // JG  (signed >)
end 'X64CondCode'

// A set of physical GPRs as a 16-bit mask: bit `i` is set iff `X64Register`
// number `i` (its `rawValue`) is in the set. Used for an op's implicit register
// reads/writes — the registers it touches WITHOUT naming them as an explicit
// operand. Picking / testing a register is a single bit op, no set iteration.
// A full machine word so bit-complement (`not pool`) never overflows the range.
export typealias RegMask = int(0 to u64.max)

// Per-variant static metadata backing for TargetOp (read via `op.rawValue`),
// consumed by the instruction scheduler + register allocator. The scheduling
// flags plus the implicit-GPR read/def masks the register allocator's liveness
// and AllocChecker consume — same "you cannot add an op without declaring its
// facts" discipline `StdOpMeta` enforces.
export type TargetOpMeta
	// Accesses memory / has a side effect the scheduler must order as a barrier.
	export let isMemory as bool
	// Writes memory / has an externally-observable side effect (pure loads are
	// memory but not stores).
	export let isStore as bool
	// Full call-barrier semantics (clobbers caller-saved registers).
	export let isCall as bool
	// May clobber x64 EFLAGS when lowered.
	export let setsFlags as bool
	// Registers this op READS without naming them as an explicit operand: R8 for
	// `ret` today; the volatile set a `call` reads/clobbers grows in when M5
	// colors calls. Liveness folds these into `forbiddenPhys`; the AllocChecker
	// asserts each is defined at the op.
	export let implicitUses as RegMask
	// Registers this op WRITES without an explicit operand — a `call`'s
	// caller-saved clobber set (M5). 0 for every op the M5.1 spine colors, so a
	// value live across such an op must avoid these registers.
	export let implicitDefs as RegMask
end 'TargetOpMeta'

export union TargetOp
	// Frame setup: reserve `stackSize` bytes of stack (`sub rsp, stackSize`).
	// shv2 M1 uses a frame-pointer-omitted (rsp-only) frame — no `push rbp` — so
	// the entry stub's `sub rsp, 0x28` shadow-space reservation IS a `prologue`.
	// `setsFlags` is true because `sub` writes EFLAGS. Callee-saved pushes GROW
	// in when the register allocator first promotes into callee-saved regs (none
	// at M1). Inserted by B2's prologue/epilogue pass at a function's entry block.
	prologue(stackSize StackSize) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// Frame teardown (`add rsp, stackSize`), the exact mirror of `prologue`.
	// Placed just before `ret` on a return block. Carries its own `stackSize` so
	// the encoder is self-contained (no frame tracker threaded through emit).
	epilogue(stackSize StackSize) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// `ret` instruction — return control to the caller.
	// implicitUses = 0x100 = the R8 bit (`X64Register.r8.rawValue` == 8, so 1<<8):
	// `ret` reads the primary-return register. This is what lets the register
	// allocator ADMIT R8 into the pool safely — forbiddenPhys proves nothing is live
	// across the `mov r8, retval` return move, and the AllocChecker verifies R8 holds
	// a value at every `ret`. (A union-backing literal cannot reference a named `let`,
	// so the mask is written inline.)
	ret = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0x100, implicitDefs: 0}
	// Unconditional near jump to a block (`jmp rel32`, 0xE9). `targetBlockId` names a
	// function-local block; emitFunctionChunk resolves it to a chunk-local rel32 (a
	// function's blocks are contiguous, so intra-function jumps never cross a chunk
	// boundary). Reads/sets no flags. Placed in the control band next to `ret`.
	jmp(targetBlockId BlockId) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// Conditional near jump (`jcc rel32`, 0F 80+cc). Taken to `targetBlockId` when the
	// EFLAGS the preceding `cmpRegReg` set satisfy `cond`, else falls through. `setsFlags`
	// is false — `jcc` READS flags, it does not write them.
	jcc(cond X64CondCode, targetBlockId BlockId) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// Materialize a 64-bit immediate into `dest` (`mov reg, imm64`).
	movRegImm(dest X64VReg, value MachineWord) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// Materialize a 32-bit immediate into `dest` (`mov reg32, imm32`, which
	// zero-extends to the full 64-bit register). B2 picks this over movRegImm
	// for values that fit 32 bits (e.g. the literal 42) — the encoding is shorter.
	movRegImm32(dest X64VReg, value MachineWord) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// 64-bit register-to-register move (`mov dest, src`). B2 emits this for the
	// primary-return move (value → R8) and for register-allocation copies.
	movRegReg(destReg X64VReg, srcReg X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// 32-bit register-to-register move (`mov dest32, src32`, zero-extending to
	// 64 bits). B2 emits exactly one at M1: the custom-ABI→Win64 bridge in
	// `mrt_start` (`mov ecx, r8d`) that hands main's R8 return value to
	// ExitProcess's ECX argument slot.
	movReg32Reg32(destReg X64VReg, srcReg X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// 64-bit register-to-register subtract (`sub dest, rhs`, i.e. `dest = lhs - rhs`).
	// GENUINELY two-address on x64 (SUB has no 3-operand form), so the operand model
	// declares `dest` a REUSE-of-`lhs` def: the allocator gives `dest` `lhs`'s register
	// when `lhs` dies here (no copy — the common case), else materializes `mov dest, lhs`
	// before the op. The encoder emits only `sub dest, rhs` (dest already holds lhs). The
	// three explicit operands `(dest, lhs, rhs)` let liveness see that `lhs` is read here
	// even when it also outlives — the old two-field `subRegReg(destReg, srcReg)` hid the
	// pre-emitted seed `mov` and assumed distinct registers, false under reuse.
	// `setsFlags` (SUB writes EFLAGS). ALU band; appended before `cmpRegReg`.
	subRegReg(dest X64VReg, lhs X64VReg, rhs X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// 64-bit register-to-register signed multiply (`imul dest, rhs`, i.e.
	// `dest = lhs * rhs`). Two-operand form `imul r64, r/m64` (0F AF /r), genuinely
	// two-address, so like `subRegReg` its `dest` is a REUSE-of-`lhs` def. The encoder
	// emits `imul dest, rhs` (dest already holds lhs; its reg field is the DESTINATION —
	// see X64Backend.encodeImulRegReg). `setsFlags` (IMUL writes OF/CF).
	imulRegReg(dest X64VReg, lhs X64VReg, rhs X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// 64-bit register negate (`neg dest`, i.e. `dest = -src`). Group-3 opcode-extension
	// form (`F7 /3`), genuinely two-address (one in-place operand), so `dest` is a
	// REUSE-of-`src` def. The encoder emits `neg dest` (dest already holds src).
	// `setsFlags` (NEG writes EFLAGS).
	negReg(dest X64VReg, src X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// 64-bit register-to-register compare (`cmp lhs, rhs`, 0x39, i.e. `lhs - rhs`
	// discarding the result, keeping the flags). The `r/m, r` shape shared with
	// `mov`/`sub` (reg field = the SUBTRAHEND `rhsReg`, r/m field = `lhsReg`), so
	// after it a signed `jcc` tests `lhs <cond> rhs`. `setsFlags` (CMP writes EFLAGS).
	cmpRegReg(lhsReg X64VReg, rhsReg X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// 64-bit address ADD via `lea dest, [base + index]` (REX.W 8D /r + SIB, scale 1).
	// The 3-operand form of `+`: `dest`, `base`, `index` are THREE independent operands
	// (NO reuse), so `+` needs no seed copy at all and — because `lea` computes an
	// address rather than an arithmetic result — sets NO flags (`setsFlags: false`).
	// This is what makes `sum = sum + i` in a loop a single copy-free instruction. SIB
	// base low-3-bits 101 (rbp/r13) and index == rsp are the encoding traps the backend
	// asserts/handles (see X64Backend.encodeLeaRegRegReg). ALU band, appended after
	// `cmpRegReg`.
	leaRegRegReg(dest X64VReg, base X64VReg, index X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// 64-bit `a + imm` / `a - imm` via `lea dest, [base + disp32]` (REX.W 8D /r, signed
	// disp; `a - imm` uses a negative displacement). `dest` and `base` are independent
	// (NO reuse), and the immediate needs NO register. Sets no flags, like every `lea`.
	// Produced from a `binOpImm(add|sub, ...)`. Appended after `leaRegRegReg`.
	leaRegRegImm32(dest X64VReg, base X64VReg, disp Imm32) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// 64-bit `a * imm` via `imul dest, src, imm32` (REX.W 69 /r id) — the THREE-operand
	// signed multiply: `dest` and `src` are independent (NO reuse), the multiplier is an
	// immediate needing no register. `setsFlags` (IMUL writes OF/CF). Produced from a
	// `binOpImm(mul, ...)`. Appended after `leaRegRegImm32`.
	imulRegRegImm32(dest X64VReg, src X64VReg, imm Imm32) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// 64-bit compare against an immediate (`cmp reg, imm32`, REX.W 81 /7 id — the sign-
	// extended group-1 form). The literal occupies no register; a following signed `jcc`
	// tests `reg <cond> imm`. `setsFlags` (CMP writes EFLAGS). Produced from a
	// `cmpImm(...)`. Appended after `imulRegRegImm32`, at the END of the ALU band.
	cmpRegImm32(reg X64VReg, imm Imm32) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// Exchange the contents of two physical registers (`xchg a, b`, REX.W 87 /r).
	// POST-COLORING and physical-only: the register allocator's SSA-destruction step
	// emits it to break a parallel-copy CYCLE on a CFG edge with no scratch register
	// (regalloc2's trick). It has TWO defs, so it would violate the single-def SSA
	// rule the colorer relies on — legal precisely because the allocator never sees
	// it (it is spliced in AFTER coloring, so it is invisible to liveness/coloring).
	// `xchg` does NOT set flags. Appended at the END of the reg-operand ALU band.
	xchgRegReg(a X64VReg, b X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0, implicitDefs: 0}
	// Direct near call to a named function (`call rel32`). The concat step
	// resolves `targetName` to the callee's `.text` placement as a rel32
	// displacement. `mrt_start` uses this to `call main`. Full call-barrier
	// semantics (clobbers caller-saved registers).
	callDirect(targetName String) = TargetOpMeta{isMemory: true, isStore: true, isCall: true, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// Indirect call through an Import Address Table slot (`call [rip+disp32]`).
	// `slotIndex` names the IAT entry the PE writer patches to. `mrt_start` uses
	// this to `call ExitProcess`. Full call-barrier semantics.
	iatCall(slotIndex RelocSlotIndex) = TargetOpMeta{isMemory: true, isStore: true, isCall: true, setsFlags: true, implicitUses: 0, implicitDefs: 0}
	// Sign-extend RAX into RDX:RAX (`cqo`, REX.W 99) so the following `idiv` divides the
	// full 128-bit RDX:RAX by its operand. Both registers are IMPLICIT (no explicit
	// operand): implicitUses = 0x1 (the RAX bit — `X64Register.rax.rawValue` == 0, so
	// 1<<0 — it READS RAX), implicitDefs = 0x4 (the RDX bit — `rdx.rawValue` == 2, so
	// 1<<2 — it WRITES RDX). Liveness folds implicitDefs into `forbiddenPhys` (a value
	// live across `cqo` must avoid RDX); the AllocChecker asserts RAX holds a value here
	// (the dividend the div lowering moved in). setsFlags is false — `cqo` leaves EFLAGS
	// untouched. (A union-backing literal cannot reference a named `let`, so the masks
	// are written inline.) APPENDED at the END of the union (after the call band) so no
	// existing `… to iatCall` range arm can SILENTLY swallow it — each such arm instead
	// fails to compile until it is consciously extended (the band-append invariant).
	cqo = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: false, implicitUses: 0x1, implicitDefs: 0x4}
	// Signed divide RDX:RAX by `divisor` (`idiv r/m64`, REX.W F7 /7): QUOTIENT → RAX,
	// REMAINDER → RDX. `divisor` is the ONE explicit virtual USE (any GPR the allocator
	// keeps out of RAX/RDX). implicitUses = 0x1 (reads RAX — the dividend low half; it
	// also reads RDX, but that is EXCLUDED from implicitUses because `cqo` set RDX to the
	// AllocChecker's untracked `noValue`, so asserting a tracked value there would false-
	// positive — RDX's role is captured entirely by implicitDefs). implicitDefs = 0x5
	// (the RAX bit 0x1 OR the RDX bit 0x4 — it WRITES both), which the clobber→forbidden
	// path uses to keep every value live across the idiv, AND the divisor operand itself,
	// out of RAX/RDX. idiv TRAPS (#DE) on divide-by-zero and INT_MIN / -1; the trap is a
	// runtime-fault-handler concern (Workstream-R / M6), so there is no compiler guard.
	// `setsFlags: true` (idiv leaves EFLAGS undefined — a "may clobber" barrier).
	// APPENDED at the END of the union, after `cqo`.
	idivReg(divisor X64VReg) = TargetOpMeta{isMemory: false, isStore: false, isCall: false, setsFlags: true, implicitUses: 0x1, implicitDefs: 0x5}
end 'TargetOp'

export typealias TargetOpArray = Array with TargetOp

// TargetModule — the Target-dialect instantiation of the generic IrModule
// container; holds a whole program's Target-tier ops/blocks/functions. Unlike
// v1's bespoke TargetModule struct (which carried BOTH an x64 and an arm64 op
// array behind a `cpu` discriminator), shv2 makes the Target tier a plain
// `IrModule with TargetOp` — consistent with MaxonModule/StdModule —
// so the shared IrModule machinery (appendOp/setTerminator/compactOps) is
// reused with no bespoke duplicate. arm64 grows as additional `TargetOp` arms
// (or its own dialect) at the arm64 milestone.
export typealias TargetModule = IrModule with TargetOp
