// IrBlock: a basic block shared across all IR phases (Maxon, Std, Target).
//
// Stores op indices into the owning module's flat ops array, exactly one
// terminator, block arguments (phi nodes), and outgoing branch edges.
//
// THE PHI MODEL AND ITS LIFECYCLE. `blockArgs` (the phis) and `branchEdges` (each
// predecessor's per-phi incoming values) are one positional pair: `blockArgs[k]` of a
// block is fed by slot `k` of every incoming edge's `argIds`. `PhiEdgeView.resolve`
// is the one place that arity is checked.
//
//   Maxon phase — BORN HERE. The parser's on-the-fly SSA mints them (`Parser.mintPhi`
//     / `recordBranchEdge`), so they are NOT empty at this phase. A block whose
//     successor carries no phis gets no edge recorded at all, so `branchEdges` is not
//     a successor list — the CFG is derived from the ops (see `TargetLiveness`).
//   Std phase — `lowerMaxonToStd` carries them across, then `pruneDeadBlockArgs` DROPS
//     the phis nothing reads, rebuilding both lists in lockstep.
//   Target phase — `StdToX64Conversion.prepareSkeleton` carries them across, and the
//     register allocator consumes them DIRECTLY (it does SSA destruction after
//     coloring; M5 retired the EliminatePhis pass that used to clear them beforehand).
//     They ARE rewritten here: the live-range splitter repoints edge args at reloads
//     (`rewriteEdgeArgsIn`), critical-edge splitting moves edges onto new blocks, and
//     `clearPhiModel` finally empties the model once the edge moves are committed.
//
// WHO OWNS WHAT — the rule every pass must respect.
//
// The phi model is tier-independent data, so the three tiers SHARE ONE COPY of it
// rather than deep-copying it at each boundary. Concretely: a Std block's `blockArgs`
// and `branchEdges` are the Maxon block's arrays; a Target block gets its own
// `BranchEdgeArray` and `BranchEdge` objects (it replaces those) but SHARES the
// `ValueIdArray` inside each edge and the `blockArgs` list.
//
// That sharing reaches all the way back into the PARSE MEMO: `queryAllModule` hands
// out the same MaxonModule object on every cache hit, and `relocateIrBlock` aliases
// its phi arrays into the merged module. So a pass that mutates one of these arrays
// IN PLACE corrupts the memo for every later compile of the project — and nothing
// downstream re-reads the Maxon or Std phi model, so no test would catch it.
//
// Hence the rule:
//
//   A pass MUST NOT mutate `blockArgs`, `branchEdges`, or an edge's `argIds` in place.
//   To change the phi model, BUILD A FRESH ARRAY AND ASSIGN THE FIELD.
//
// Every pass already obeys it. `pruneDeadBlockArgs` (Std) rebuilds both lists and
// field-assigns them onto the Std block. `extractPredEdge` / `clearPhiModel` (Target)
// field-assign a rebuilt `BranchEdgeArray`. The ONE in-place writer in the whole
// compiler is `rewriteEdgeArgsIn` (Target), and it de-aliases — it clones an edge's
// `argIds` before its first write to it. A pass that CREATES phis (mem2reg, when it
// lands) must follow the same discipline.

// Role tag for an IrBlockArg: that a continuation-block arg stands in for what would
// otherwise be a value captured from a multi-value-return register, so a coalescer
// could seed a physical-register hint on it in place of the hint anchor the post-call
// capture mov provided before the callee was inlined.
//
// ⛔ **NOTHING IN shv2 PRODUCES A NON-`none` VALUE AND NOTHING READS THE FIELD** (measured
// 2026-08-26: `returnRole` has no reader outside this file). Both splicing passes leave it
// at `none` — `inlineManagedPrimitives` and `inlineLeaves` alike — and no backend consults
// it, so the hint it describes is one the allocator currently arrives at on its own or not
// at all. It is v1's design carried across with the phi model; wiring a producer here
// before there is a consumer would be a producer with no consumer, which is why neither
// pass does. Kept because the register-hint rung is what gives it its reader; the moment
// that lands, this note is what it replaces.
//
//   none           — normal phi (the parser's SSA, a branch arg). The only value in use.
//   primaryReturn  — primary return value: R8 (x64) / X0 (arm64).
//   errorFlag      — multi-value-return error flag: RDX / X1.
export enum BlockArgReturnRole
	none
	primaryReturn
	errorFlag
end 'BlockArgReturnRole'

// A block argument (phi node): a value defined at block entry, bound by
// the branch op that transfers control to this block. Minted by the
// parser's on-the-fly SSA at the Maxon phase (see this file's header) and
// carried down through the Std and Target phases.
export type IrBlockArg
	export var valueId as ValueId
	export var argType as StdType
	// `none` from every producer there is — see `BlockArgReturnRole`, which
	// records that shv2 has neither a producer of another value nor a reader.
	export var returnRole as BlockArgReturnRole

	export static function create(valueId ValueId, argType StdType, returnRole BlockArgReturnRole = BlockArgReturnRole.none) returns IrBlockArg
		return Self{valueId: valueId, argType: argType, returnRole: returnRole}
	end 'create'
end 'IrBlockArg'

export typealias IrBlockArgArray = Array with IrBlockArg

// An outgoing branch arg list paired with its successor block id: the values a
// predecessor passes to the successor's block-args (phis) on that edge. Recorded by
// the parser at the Maxon phase (`recordBranchEdge`) and carried down to the Target
// phase, where the register allocator's SSA destruction reads it AFTER coloring to
// emit the parallel edge copies. The physical terminators (x64 jmp, arm64 branch)
// carry only the target block id, so this metadata lives on the predecessor's
// IrBlock instead.
export type BranchEdge
	export var targetBlockId as BlockId
	export var argIds as ValueIdArray

	export static function create(targetBlockId BlockId, argIds ValueIdArray) returns BranchEdge
		return Self{targetBlockId: targetBlockId, argIds: argIds}
	end 'create'
end 'BranchEdge'

export typealias BranchEdgeArray = Array with BranchEdge

// A block's terminator status.
//   unset — no terminator op is currently attached. The parser starts
//     every block here and assertTerminated forbids any block from
//     leaving the parsing phase still in this state.
//   dead — block is unreachable (produced by parser for code after a
//     fully-terminated if/else); treated as implicitly terminated.
//   fallthrough — terminator was deliberately elided at the target phase
//     because the block falls straight through to the next block in
//     layout order. branchEdges still carry parallel-copy info for the
//     fallthrough edge.
//   opIndex(index) — a terminator op lives at this index in the
//     module's ops array.
export union Terminator
	unset
	dead
	fallthrough
	opIndex(index OpIndex)
end 'Terminator'

// ⭐ **THE TWO QUESTIONS ABOUT A TERMINATOR SLOT, ASKED OF THE SLOT ITSELF.** `IrBlock.hasTerminatorOp` /
// `terminatorIndex` are these read off `self.terminator`, and they delegate rather than restate — one rule,
// one place, whichever half a caller holds. A caller that may NOT hold the block is why they exist: reading
// a block out of `module.blocks` is a BORROW of that module (E3070), so a pass that writes while it walks
// copies the slot out and asks these (see `LowerMaxonToStd`'s block walk).
module function terminatorNamesAnOp(terminator Terminator) returns bool
	return match terminator 'check'
		unset to fallthrough gives false
		opIndex gives true
	end 'check'
end 'terminatorNamesAnOp'

// The op index a terminator slot names. Panics for a slot that names none — guard with
// `terminatorNamesAnOp`, exactly as `IrBlock.terminatorIndex` asks its callers to.
module function terminatorOpIndexOf(terminator Terminator) returns OpIndex
	match terminator 'unwrap'
		opIndex(index) then return index
		default panic("terminatorOpIndexOf: this terminator slot names no op")
	end 'unwrap'
end 'terminatorOpIndexOf'

// Where a block's CONDITIONAL branch lives — the second half of the terminator, for
// the tiers whose two-way branch does not fit one terminator slot.
//
//   none           — the block has no conditional branch. Every Maxon- and Std-tier
//     block (their two-way branch IS the single `condBranch` terminator op), and every
//     Target-tier block that ends in `ret`, an unconditional `jmp`, or nothing.
//   opIndex(index) — the block's conditional-branch op lives at this index in the
//     module's ops array. On x64 that is the `jcc`: a two-way branch lowers to a `jcc`
//     BODY op naming the then-target, paired with a `jmp` TERMINATOR naming the
//     else-target, so the block's SECOND successor is named by a body op.
//
// This records only WHERE the op is, never what it targets: every reader dereferences
// the op itself, so the ops stay the single source of truth for the CFG and an
// in-place retarget (`retargetJcc`) has no cache to invalidate. What it buys is the
// end of the O(ops-in-block) SEARCH for that one op — finding a block's successors was
// a scan of every op of every block, and the register allocator builds the CFG
// skeleton twice per function (the critical-edge split, then the RPO reorder), making
// CFG construction O(total ops) instead of O(blocks + edges).
export union CondBranch
	none
	opIndex(index OpIndex)
end 'CondBranch'

export type IrBlock
	export var id as BlockId
	export var label as ByteArray
	export var opRefs as OpIndexArray
	export var terminator as Terminator
	// The block's conditional-branch body op, when it has one. Set ONLY by
	// `IrModule.appendCondBranch`, which is the only way a conditional branch may enter
	// a block; `appendOp` refuses to append past it. See `CondBranch`.
	export var condBranch as CondBranch
	export var blockArgs as IrBlockArgArray
	// Outgoing branch-argument lists — the values each successor edge passes to
	// that successor's block-args (phis). Populated by the PARSER (M4b on-the-fly
	// SSA, `recordBranchEdge`), carried verbatim through `lowerMaxonToStd` and
	// `prepareSkeleton`, and consumed by the register allocator's SSA destruction
	// (after coloring). Empty for a block whose successors carry no phis.
	//
	// NOT a successor list: an edge exists here only when it CARRIES PHIS, so a block
	// whose successors take no block-args has none. Deriving the CFG from these would
	// silently drop every non-phi edge — which is why successors come from the ops.
	export var branchEdges as BranchEdgeArray

	export static function create(id BlockId, label ByteArray) returns IrBlock
		return Self{
			id: id,
			label: label,
			opRefs: OpIndexArray.create(),
			terminator: Terminator.unset,
			condBranch: CondBranch.none,
			blockArgs: IrBlockArgArray.create(),
			branchEdges: BranchEdgeArray.create()
		}
	end 'create'

	// True when the block has a real terminator op (returns / branches).
	// Dead and fallthrough blocks return false — they have no op to
	// reference even though they are effectively terminated.
	export function hasTerminatorOp() returns bool
		return terminatorNamesAnOp(self.terminator)
	end 'hasTerminatorOp'

	// True when control cannot flow off the end of this block — it has a
	// terminator op, is dead (unreachable), or intentionally falls through
	// to the next block in layout order. Passes that only care whether to
	// append an implicit branch/return use this.
	export function isTerminated() returns bool
		return match self.terminator 'check'
			unset gives false
			dead gives true
			fallthrough gives true
			opIndex gives true
		end 'check'
	end 'isTerminated'

	// Returns the op index of the block's terminator. Panics if the
	// terminator is not opIndex(_); callers must guard with hasTerminatorOp.
	export function terminatorIndex() returns OpIndex
		if not terminatorNamesAnOp(self.terminator) 'noTerminatorOp'
			panic("terminatorIndex: block '{String.from(self.label)}' has no terminator op")
		end 'noTerminatorOp'

		return terminatorOpIndexOf(self.terminator)
	end 'terminatorIndex'

	// True when the block has a conditional-branch body op (a second successor named by
	// something other than the terminator). See `CondBranch`.
	export function hasCondBranchOp() returns bool
		return match self.condBranch 'check'
			none gives false
			opIndex gives true
		end 'check'
	end 'hasCondBranchOp'

	// The op index of the block's conditional branch. Panics when it has none; callers
	// must guard with `hasCondBranchOp` or match on `condBranch` directly.
	export function condBranchIndex() returns OpIndex
		match self.condBranch 'unwrap'
			opIndex(index) then return index
			none then panic("condBranchIndex: block '{String.from(self.label)}' has no conditional-branch op")
		end 'unwrap'
	end 'condBranchIndex'

	// Panic if the block was never given a terminator. Called at the end
	// of the parsing phase to enforce the invariant that every IR block
	// commits to one of: dead (unreachable), fallthrough (target phase
	// only), or a concrete terminator op.
	export function assertTerminated()
		match self.terminator 'check'
			unset then panic("IrBlock '{String.from(self.label)}' (id={self.id}) has no terminator — parser left it in Terminator.unset")
			dead then break 'check'
			fallthrough then break 'check'
			opIndex then break 'check'
		end 'check'
	end 'assertTerminated'
end 'IrBlock'

export typealias IrBlockArray = Array with IrBlock

// ⛔ There is deliberately NO `resolveBlockLabel(blockId, blocks)` here any more.
//
// It answered a branch target with the target block's `label`, which is NOT a block's identity: a
// label is minted per CONSTRUCT (`ifcont`, `tryerr`, `__rc_panic`), so one function holds several
// blocks of one name and the answer could not name which. Naming a block for PRINTING is the
// printer's own concern and needs the whole function in view to disambiguate — it lives in
// `TargetPrinter.buildBlockPrintNames`, which builds one injective table per function and is read by
// the block header and every branch operand alike. That also retired this scan, which ran once per
// branch operand and made printing a function quadratic in its own block count.

// Insert ONE op reference at `at`, which must name a position INSIDE the block or one
// past its end.
//
// This exists because `Array.insert` CLAMPS an out-of-range index to the tail, and every
// caller here computes `at` from a live-range position or an op's index within the block
// — so a position past the end is a bug in the caller, not a request to append. Clamping
// would put a spill store or a reload at the wrong place and miscompile silently; the
// `List` this used to be threw instead, and that guard is worth keeping.
//
// ⚠ IT SHIFTS A SUFFIX OF `opRefs`, SO IT IS FOR ONE OP AND NOT FOR K OF THEM. A caller
// placing several ops into one block must use `spliceOpRefs` below — a loop here costs
// Θ(K × block) and it also forces each iteration to re-derive its position in coordinates
// the previous iteration has already moved. That is not a style preference: it is the
// quadratic the register allocator's splitter was measured paying, and the reason its
// positions can now be read out of an index instead of searched for.
export function insertOpRef(block IrBlock, at BlockOpPos, opIdx OpIndex)
	if at > block.opRefs.count() 'oob'
		panic("insertOpRef: position {at} is past the end of block '{String.from(block.label)}' (opRefs count={block.opRefs.count()})")
	end 'oob'

	block.opRefs.insert(at, value: opIdx)
end 'insertOpRef'

// An index into a BATCH of pending splices — a position in the caller's parallel (position, opIndex)
// arrays. Deliberately not a `BlockOpPos`: it addresses the batch, never the block.
export typealias SpliceBatchIndex = int(0 to u64.max)

// Insert a whole BATCH of op references in ONE pass — `opIdxs[k]` at position `positions[k]`, for k in
// `[from, to)`.
//
// EVERY POSITION IS STATED IN THE BLOCK'S PRE-BATCH COORDINATES, and they must be ASCENDING. Entry `k`
// lands immediately before whatever sat at `positions[k]` before any of this batch went in, and after
// every earlier entry of the batch — which is exactly the layout `to - from` separate `insertOpRef`
// calls produce when each one re-derives its own position from the anchor op it must follow.
//
// WHY IT EXISTS. `insertOpRef` shifts a suffix of `opRefs` on every call, so a caller placing K ops
// into a block of M paid Θ(K × M) — and the register allocator's splitter is exactly that caller: two
// f64 locals read after each of N calls put ~2N reloads into one straight-line block of ~10N ops. This
// pays Θ(M + K) instead, and it allocates nothing beyond the one growth. The insertions being held back
// until the batch is complete is also what keeps every position in one coordinate system, which is what
// lets the splitter read a position out of its use index rather than search for it.
export function spliceOpRefs(block IrBlock, positions BlockOpPosArray, opIdxs OpIndexArray, from SpliceBatchIndex, to SpliceBatchIndex)
	let pending = to - from
	if pending == 0 'nothingToSplice'
		return
	end 'nothingToSplice'

	let oldCount = block.opRefs.count()
	// Grow FIRST and fill BACKWARD: every slot written is either one already copied out or one the
	// growth just added, so no original op ref is clobbered before it has been moved.
	//
	// `growFilled`, not `resize`, and the difference is asymptotic rather than cosmetic: `resize` grows
	// capacity to EXACTLY the length asked for, so a block spliced into by several splits in turn is
	// reallocated and copied in full every time — Θ(splits × block) bytes (see `Array.growFilled`, which
	// documents that trap). Geometric growth makes the same sequence amortized linear. The zeros it
	// writes into the added tail are all overwritten by the pass below; that fill is the price of using
	// the one extension operation rather than a second one.
	block.opRefs.growFilled(oldCount + pending, value: 0)

	var write = oldCount + pending
	var read = oldCount
	var k = to
	while k > from 'eachPendingSplice'
		let at = try positions.get(k - 1) otherwise panic("spliceOpRefs: positions.get OOB at {k - 1}")
		if at > oldCount 'pastTheEnd'
			panic("spliceOpRefs: position {at} is past the end of block '{String.from(block.label)}' (opRefs count={oldCount})")
		end 'pastTheEnd'
		if at > read 'outOfOrder'
			panic("spliceOpRefs: entry {k - 1} of this batch asks for position {at} of block '{String.from(block.label)}', but the entry after it already claimed position {read} or lower — a batch must be ASCENDING by position, because it is materialized in ONE backward pass")
		end 'outOfOrder'

		while read > at 'shiftTail'
			write = write - 1
			read = read - 1
			let moved = try block.opRefs.get(read) otherwise panic("spliceOpRefs: opRefs.get OOB at {read}")
			try block.opRefs.set(write, value: moved) otherwise panic("spliceOpRefs: opRefs.set OOB at {write}")
		end 'shiftTail'

		let spliced = try opIdxs.get(k - 1) otherwise panic("spliceOpRefs: opIdxs.get OOB at {k - 1}")
		write = write - 1
		try block.opRefs.set(write, value: spliced) otherwise panic("spliceOpRefs: opRefs.set OOB at {write}")
		k = k - 1
	end 'eachPendingSplice'
end 'spliceOpRefs'

// Collect the IrBlocks referenced by a function's blockRefs list.
// Used by IR printers across all phases to iterate a function's blocks.
module function resolveFuncBlocks(blocks IrBlockArray, blockRefs BlockRefArray) returns IrBlockArray
	var result = IrBlockArray.create()
	for blockRef in blockRefs 'each'
		let block = try blocks.get(blockRef) otherwise panic("invariant: blockRef from blockRefs not in blocks")
		result.push(block)
	end 'each'
	return result
end 'resolveFuncBlocks'
