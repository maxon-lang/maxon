// LayoutDescriptor (P1.6-B1) — the per-generic-instance runtime "dictionary".
//
// ⭐ **shv2 does NOT monomorphize a generic body.** `Sizer.typeSize` compiles ONCE against an
// opaque `T` (an i64), and everything the body needs to know about the concrete `T` at a given
// call site arrives at RUNTIME through a hidden trailing parameter: the address of a fixed-shape
// 64-byte descriptor blob in `.rdata`. `sizeof(T)` inside the shared body is a LOAD of this blob's
// `elementLogicalSize@56` slot; the caller passes the address of the descriptor for its concrete
// instance (`__layout_Sizer_bool`). This is the "dictionary-passing" model the self-hosted compiler
// uses; the C# bootstrap, which fully monomorphizes, folds the same `sizeof(T)` to a literal.
//
// ⚠ **The byte shape is an ABI between two ends** — `LowerMaxonToStd` WRITES the blob
// (`encodeLayoutDescriptor`) and READS it back (`sizeof(T)` → a load at a constant offset). It is
// byte-identical to the self-hosted compiler's `LayoutDescriptor` (its 219-line original) so the
// two agree field-for-field, and B2/P1.7 (managed args, drop-through-`destroyFunc@40`, Array
// copy-thunks) can populate the currently-zero slots without moving anything:
//
//   +0   size               u64   base generic type's own box byteSize (`StructLayout.sizeBytes`)
//   +8   alignment          u64   8 (the machine word every trivial box is aligned to)
//   +16  elementSize        u64   storage width of the single type arg in the box (an opaque
//                                 8-byte `T` slot); DISTINCT from elementLogicalSize below
//   +24  flags              u64   0 in B1 (bit0=hasHeapRefs, bit1=bitPacked — B2/P1.7)
//   +32  copyFunc           u64   0 in B1 (a trivial instance has no copy thunk — B2)
//   +40  destroyFunc        u64   0 in B1 (a trivial instance has no destroy thunk — B2/drop)
//   +48  fieldOffsetsPtr    u64   0 in B1 (no per-field-offset blob — P1.7)
//   +56  elementLogicalSize u64   source-level `sizeof` of the single type arg (bool=1, a 2-int
//                                 Pair=16); the ONE slot `sizeof(T)` reads
//
// ⚠ **A B1 DESCRIPTOR IS PURE DATA — every function-pointer slot is 0, so NO relocation is emitted
// or needed.** The moment a slot at +32/+40 must hold a `.text` address, that is B2's
// `funcAbs64InRdata` machinery, not B1's.

// The fixed on-disk size of one descriptor blob. Every field is a machine word (8 bytes), and there
// are eight of them.
export let LAYOUT_DESCRIPTOR_BYTE_SIZE = 64 as ByteOffset

// The byte offset of the `elementLogicalSize` slot — the source-level `sizeof` of the single type
// arg. `sizeof(T)` inside a shared generic body lowers to a load of `[descriptor + this]`. It is the
// ONE offset a reader needs at this slice, so it is the only one exported; B2 exports `destroyFunc@40`
// when the drop path reads it.
export let LAYOUT_OFFSET_ELEMENT_LOGICAL_SIZE = 56 as ByteOffset

// The byte offset of the `copyFunc` slot — the DEEP-CLONE function for the instance's single type
// argument (the "dictionary" entry a shared generic body reads to COPY an opaque `T`). It is the exact
// dual of `destroyFunc@40`: an opaque-`T` `Array with T` field copied inside a generic body
// (`Container with String`, `.clone()`/`.slice()`/`.append()`, P1.7 slice 3b-vi-b) reads this slot at run
// time and `callIndirect`s it per element, so the ONE compiled copy serves every concrete instance. The
// slot is 0 on disk for a TRIVIAL type argument (no cloner — the opaque-copy wrapper then takes the
// byte-blit/COW path, never `callIndirect(0)`); a `funcAbs64InRdata` relocation fills it with the element
// cloner's `.text` VA for a MANAGED, direct-clonable argument (`__str_clone` / `__clone_<T>` / `__arr_clone`),
// exactly as the drop stamp fills `destroyFunc@40`. `encodeLayoutDescriptor` already zero-fills it.
export let LAYOUT_OFFSET_COPY_FUNC = 32 as ByteOffset

// The byte offset of the `destroyFunc` slot — the destroy function for the instance's single type
// argument (the "dictionary" entry a shared generic body reads to release an opaque `T`). An opaque-`T`
// `Array with T` created inside a generic body stamps its record's `element_destroy@40` from a runtime
// load of `[descriptor + this]` (P1.7 slice 3b-i): the shared body compiles ONCE and reads the element's
// destructor at run time, so the ONE compiled create serves every concrete instance. The slot is 0 on
// disk for every instance at this slice (a TRIVIAL type argument has no destructor, and a relocation
// filling it for a MANAGED argument is P1.7 slice 3b-ii), so the load yields 0 and the array's drop walk
// is skipped — exactly the trivial-element behaviour. `encodeLayoutDescriptor` already zero-fills it.
export let LAYOUT_OFFSET_DESTROY_FUNC = 40 as ByteOffset

// The number of little-endian bytes in one descriptor field.
let LAYOUT_FIELD_BYTES = 8 as ByteOffset

// The alignment (`alignment@8`) every trivial-arg generic box takes — one machine word. A B1 box is a
// row of 8-byte slots (`StructLayout` lays fields out at 8-byte strides), so the box aligns to 8.
export let LAYOUT_MIN_ALIGNMENT = 8 as MachineWord

// The storage width of the single type argument in the box (`elementSize@16`) — an opaque `T` slot is
// one machine word whatever the argument, which is DISTINCT from `elementLogicalSize@56` (the argument's
// full SOURCE size). For a `bool` argument they diverge (8 vs 1), exactly where the descriptor header
// says the two concepts must stay separate.
export let LAYOUT_TYPE_PARAM_SLOT_BYTES = 8 as MachineWord

// The MACHINE WORD every value with no narrower home occupies — a bare `int`, a `float`, a function
// pointer, a managed box's pointer, and a ranged alias whose range does not fit a narrower slot. Named
// because `rangedAliasStorageBytes` returns it as an ANSWER ("nothing narrower holds this range") rather
// than as the size of any particular thing, and a bare `8` there would read as one of the ladder's rungs.
export let MachineWordBytes = 8 as ByteOffset

// ⭐ **THE STORAGE WIDTH OF A RANGED-INT ALIAS — the smallest slot that holds every value its declared
// range admits**, and the SINGLE producer of a narrow element stride. `Byte = int(0 to u8.max)` ⇒ 1;
// `HashValue = int(0 to u32.max)` ⇒ 4; `int(i64.min to i64.max)` ⇒ 8. Both reference compilers draw the
// same ladder — `MlirType.cs:472 ComputeOptimalIntType`, `maxon-selfhosted/Compiler/Parser.maxon:21227
// computeOptimalIntType` — and this is where shv2 draws it.
//
// `high` rides as the raw 64-bit pattern `ParsedInt` holds (`RangedTypeAlias`'s header), so a `u64.max`
// upper bound arrives NEGATIVE. That is tested first, ahead of the ladder, exactly as v1's `wrappedU64`
// arm is: read as a signed number it would look like the narrowest rung and truncate the widest range
// there is.
//
// ⚠⚠ **IT IS THE UNSIGNED LADDER ONLY. A NEGATIVE LOWER BOUND KEEPS THE MACHINE WORD — a DELIBERATE
// divergence from both references, forced by shv2's own storage and not by taste.** The references
// narrow `int(-5 to 5)` to a SIGNED byte (i8) because they carry a static, signed element type into the
// load: the bootstrap monomorphizes the accessor, and v1 stamps a `StoreWidth` + signedness. shv2 does
// neither — `ArrayRuntime.emitLoadElem` is ONE compiled byte loop shared by every array instance, strided
// by the record's runtime `element_size@24` and **zero-extending** (`loadIndirect … StdType.u8`,
// shift-and-OR), with no signedness anywhere in the record to consult. Narrow a signed element under it
// and the value does not survive the round trip: measured, `int(-5 to 5)` storing `-5` reads back `251`.
// So the honest question here is *"what is the smallest slot whose UNSIGNED value set contains this
// range?"*, and for a negative lower bound the answer is the full word. Narrow signed storage needs the
// element's signedness to reach the load — a runtime/ABI slice, not a stamp — and is its own rung.
export function rangedAliasStorageBytes(low ParsedInt, high ParsedInt) returns ByteOffset
	if low < 0 or high < 0 'noNarrowUnsignedSlotHoldsIt'
		return MachineWordBytes
	end 'noNarrowUnsignedSlotHoldsIt'

	if high <= u8.max 'oneByte'
		return 1
	end 'oneByte'

	if high <= u16.max 'twoBytes'
		return 2
	end 'twoBytes'

	if high <= u32.max 'fourBytes'
		return 4
	end 'fourBytes'

	return MachineWordBytes
end 'rangedAliasStorageBytes'

// The full source-level `sizeof` of a NON-AGGREGATE type — the one shared by the parser's concrete-sizeof
// fold and the descriptor's `elementLogicalSize` (an aggregate arg is sized by its caller through
// `StructLayout.sizeBytes`, which needs an interner this tag-only helper cannot see). A machine word
// (int/float/function) is 8; a `bool` is 1; an `ExitCode` (`u32`) is 4.
//
// ⚠ The `named` arm is the FALLBACK for a name this compiler cannot size from a range — an enum or a union.
// A ranged ARRAY ELEMENT never reaches it: `ProgramSignatures.trivialElementStorageBytes` answers those from
// `rangedAliasStorageBytes` above, because sizing one needs the declared bounds a tag-only helper cannot see,
// and `undeclaredNamedElementStorageBytes` owns the rest of that door's miss arm. A ranged alias DOES reach
// it as a LOGICAL size (`typeLogicalByteSize`), where a machine word is the right answer and the two
// questions deliberately part ways.
//
// ⭐ A managed `String` is its FULL 48-byte record, NOT its 8-byte pointer — the oracle's rule
// (`sizeof(managed T)` = the value record), which B2's managed args inherit unchanged.
//
// It PANICS on the aggregate and non-value tags (`structRef`/`genericInstance` are the caller's to size by
// layout; `typeParameter` is the descriptor-read path; `unresolved`/`void` are never valid `sizeof`
// operands) rather than returning a default — a caller reaching those has already mis-routed.
export function primitiveTypeByteSize(tag ValueTypeTag) returns ByteOffset
	match tag 'size'
		boolean then return 1
		integer then return 8
		float then return 8
		exitCode then return 4
		named then return 8
		string then return 48
		function then return 8
		structRef then panic("primitiveTypeByteSize: a `structRef` is an aggregate — size it through StructLayout.sizeBytes, not this helper")
		genericInstance then panic("primitiveTypeByteSize: a `genericInstance` is an aggregate — size it through its base StructLayout.sizeBytes, not this helper")
		// A Character is a POINTER to the fused byte record — one machine word in a slot, exactly as a
		// String is. `sizeof(Character)` is therefore the pointer, not the record.
		character then return MachineWordBytes
		typeParameter then panic("primitiveTypeByteSize: a `typeParameter`'s size is a runtime layout-descriptor read, not a compile-time constant")
		unresolved then panic("primitiveTypeByteSize: an `unresolved` type reached sizeof — TypeResolution should have eliminated it or SemanticCheck rejected the reference")
		void then panic("primitiveTypeByteSize: `void` is not a value type and has no size")
	end 'size'
end 'primitiveTypeByteSize'

// A stable spelling of a NON-aggregate type tag, for a descriptor's `.rdata` label — `bool`, `int`,
// `float`, … A struct or generic-instance argument is mangled by its NAME (its interner-owning
// registry does that); this covers only the tags whose identity is the tag itself. It panics on the
// aggregate / non-value tags for the same reason `primitiveTypeByteSize` does: reaching one is a
// mis-route (the caller mangles those by name), not a case to invent a spelling for.
export function primitiveTypeTagName(tag ValueTypeTag) returns String
	match tag 'name'
		boolean then return "bool"
		integer then return "int"
		float then return "float"
		exitCode then return "ExitCode"
		string then return "String"
		character then return "Character"
		function then return "function"
		named then panic("primitiveTypeTagName: a `named` type is mangled by its interned NAME, not this tag speller")
		structRef then panic("primitiveTypeTagName: a `structRef` is mangled by its struct NAME, not this tag speller")
		genericInstance then panic("primitiveTypeTagName: a `genericInstance` is mangled by its structural name, not this tag speller")
		typeParameter then panic("primitiveTypeTagName: a `typeParameter` is never a concrete instance's argument, so it never reaches a descriptor label")
		unresolved then panic("primitiveTypeTagName: an `unresolved` type reached descriptor labelling — TypeResolution should have eliminated it")
		void then panic("primitiveTypeTagName: `void` is not a value type and names no descriptor")
	end 'name'
end 'primitiveTypeTagName'

// The number of zero-filled slots between `elementSize@16` and `elementLogicalSize@56`: flags@24,
// copyFunc@32, destroyFunc@40, fieldOffsetsPtr@48. All four are 0 for a B1 (pure-data) descriptor.
let LAYOUT_ZERO_SLOTS_MID = 4 as ByteOffset

// The data model for one instance's descriptor. Only the four slots B1 populates are fields; the
// four zero slots are supplied by the encoder (they carry no B1 information, and inventing fields to
// hold a constant 0 would be a place for the encoder and the model to disagree).
//
// ⚠ `elementSize` and `elementLogicalSize` are DISTINCT and must stay so through B2/P1.7: the first
// is the arg's STORAGE width in the box (8 for an opaque `T` slot, whatever the arg), the second is
// the arg's full SOURCE size (bool=1, Pair=16). For a trivial arg they diverge (8 vs 1) exactly where
// the header says they must.
export type LayoutDescriptor
	export var size as MachineWord
	export var alignment as MachineWord
	export var elementSize as MachineWord
	export var elementLogicalSize as MachineWord

	export static function create(size MachineWord, alignment MachineWord, elementSize MachineWord, elementLogicalSize MachineWord) returns LayoutDescriptor
		return Self{size: size, alignment: alignment, elementSize: elementSize, elementLogicalSize: elementLogicalSize}
	end 'create'
end 'LayoutDescriptor'

// Encode a LayoutDescriptor into its fixed 64-byte `.rdata` image — eight little-endian machine
// words. The two function-pointer slots (+32 copyFunc, +40 destroyFunc) and the field-offsets slot
// (+48) are zero on disk in B1: a trivial instance has no thunk and no field-offset blob, so nothing
// patches them and the blob needs no relocation.
export function encodeLayoutDescriptor(d LayoutDescriptor) returns ByteArray
	var buf = ByteArray.create()
	buf.reserve(LAYOUT_DESCRIPTOR_BYTE_SIZE)
	writeLayoutWord(buf, value: d.size)
	writeLayoutWord(buf, value: d.alignment)
	writeLayoutWord(buf, value: d.elementSize)
	for _ in 0 upto LAYOUT_ZERO_SLOTS_MID 'zeroSlots'
		writeLayoutWord(buf, value: 0)
	end 'zeroSlots'
	writeLayoutWord(buf, value: d.elementLogicalSize)
	return buf
end 'encodeLayoutDescriptor'

// Append one machine word as `LAYOUT_FIELD_BYTES` little-endian bytes — the same shift-and-mask the
// `.data`/`.rdata` scalar serializer uses, restated here because that one lives in the Targets layer
// (`GlobalDataTable.appendScalar`) and a descriptor is encoded a tier up, in the IR layer, before the
// bytes ever reach the data table.
function writeLayoutWord(buf ByteArray, value MachineWord)
	for i in 0 upto LAYOUT_FIELD_BYTES 'eachByte'
		buf.push((value shr (i * 8)) and 0xFF)
	end 'eachByte'
end 'writeLayoutWord'

// The per-`GenericInstanceId` descriptor-label registry — `Box with Integer`'s gid ⇒ the `.rdata`
// label `__layout_Box_Integer` that names its blob. It is what threads the two ends of the ABI: the
// descriptor EMITTER records the label it registered, and a CALL SITE reads it back to emit the
// `rdataAddr` it appends as the hidden descriptor argument.
//
// ⚠ **A MAP (O(1)), not the self-hosted compiler's parallel-array linear scan.** v1's
// `LayoutDescriptorRegistry` (`maxon-selfhosted/.../LayoutDescriptor.maxon:173-218`) walks every prior
// entry on `contains`/`labelFor`/`intern`; here a gid-keyed map answers each in amortized O(1),
// mirroring shv2's own composite-key `GenericInstanceRegistry`.
export typealias LayoutLabelMap = Map with (GenericInstanceId, String)

export type LayoutDescriptorRegistry
	var labels as LayoutLabelMap

	export static function create() returns LayoutDescriptorRegistry
		return Self{labels: LayoutLabelMap.create()}
	end 'create'

	// Has a descriptor already been emitted for `gid`? Callers gate `record` on this so the blob is
	// registered exactly once per instance.
	export function contains(gid GenericInstanceId) returns bool
		return self.labels.contains(gid)
	end 'contains'

	// The `.rdata` label naming `gid`'s descriptor blob. Precondition: a descriptor was emitted for it
	// (`contains(gid)`) — a miss is a lowering-order bug (a call site reached before the emitter ran),
	// not a state to paper over with a sentinel label.
	export function labelFor(gid GenericInstanceId) returns String
		return try self.labels.get(gid) otherwise panic("LayoutDescriptorRegistry.labelFor: no descriptor emitted for generic instance {gid} — the descriptor emitter must run before a call site references it")
	end 'labelFor'

	// Record that `gid`'s descriptor blob is registered under `label`. Idempotent by construction:
	// callers gate on `contains`, so a gid is recorded once.
	export function record(gid GenericInstanceId, label String)
		self.labels.upsert(gid, value: label)
	end 'record'
end 'LayoutDescriptorRegistry'
