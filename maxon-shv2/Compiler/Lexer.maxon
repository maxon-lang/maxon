// Table-driven DFA lexer for Maxon source code.
// Accepts a String source, converts to ByteArray internally for efficient byte-level scanning,
// and produces tokens with String values sliced from the original source.

export typealias LineNumber = int(0 to u64.max)
export typealias ColumnNumber = int(0 to u64.max)
export typealias CharOffset = int(0 to u64.max)

// Dense columns of line/column positions. Homed here, next to their element
// types, because two unrelated consumers need them: `SourceRangeTable` (the
// op-parallel span store) and `BlockSourceInfo` (the per-block coverage
// footprint).
export typealias LineNumberArray = Array with LineNumber
export typealias ColumnNumberArray = Array with ColumnNumber

typealias ByteCursor = ArrayIterator with Byte

export union LexerError implements Error
	unexpectedEof(line LineNumber, column ColumnNumber)
	unterminatedString(line LineNumber, column ColumnNumber)
	unterminatedBlockComment(line LineNumber, column ColumnNumber)
	// An opening `{` inside a double-quoted string didn't close before the
	// string did. The (line, column) point at the offending `{` so the
	// diagnostic underlines the brace itself rather than the EOF position.
	// Use `\{` to embed a literal `{` in a string literal.
	unescapedBrace(line LineNumber, column ColumnNumber)
	// A `#`-prefixed directive whose name is not one of the recognized
	// directive keywords (`if`, `else`, `endif`). Carries the bare name so
	// the surfacing diagnostic can quote the offending text.
	unknownDirective(name String, line LineNumber, column ColumnNumber)
end 'LexerError'

// --- Character classes ---
enum CharClass
	other
	space
	tab
	cr
	lf
	lParen
	rParen
	lBrace
	rBrace
	lBracket
	rBracket
	equals
	bang
	less
	greater
	plus
	minus
	star
	colon
	slash
	squote
	dquote
	backslash
	dot
	digit
	alpha
	eof
	comma
	COUNT
end 'CharClass'

// --- DFA states ---
enum DfaState
	// Live states (need more input)
	start
	sawEq
	sawBang
	sawLt
	sawGt
	sawSlash
	// Terminal states
	skipWs
	skipCr
	newline
	lParen
	rParen
	lBrace
	rBrace
	plus
	minus
	star
	colon
	eq
	eqEq
	bangEq
	lt
	ltEq
	gt
	gtEq
	bang
	enterSquote
	enterDquote
	enterDigit
	enterAlpha
	enterComment
	enterBlockComment
	slash
	skipOther
	dot
	lBracket
	rBracket
	emitBackslash
	comma
	COUNT
end 'DfaState'

// --- Action codes ---
// Start at 1 so 0 is never a valid action (catches uninitialized table entries)
enum Action
	skip = 1
	skipCr
	newline
	emit
	emit2
	enterStrSq
	enterStrDq
	enterNumber
	enterIdent
	enterComment
	enterBlockComment
end 'Action'

// --- Token kind enum ---
// String-backed: each variant carries its diagnostic display text as
// `.rawValue`, so error messages can stringify a kind directly without
// needing a separate display lookup. Comparisons remain ordinal-based.
// Backing strings carry no surrounding quotes — callers that want the
// quoted form (e.g. `'function'` in expected-token diagnostics) wrap
// the value at the use site.
export enum TokenKind
	// Top level
	function = "function"
	let = "let"
	typealias = "typealias"
	export = "export"
	public = "public"
	// Control flow
	if = "if"
	else = "else"
	while = "while"
	for = "for"
	in = "in"
	break = "break"
	continue = "continue"
	return = "return"
	panic = "panic"
	end = "end"
	match = "match"
	then = "then"
	fallthrough = "fallthrough"
	default = "default"
	upto = "upto"
	gives = "gives"
	try = "try"
	otherwise = "otherwise"
	throw = "throw"
	ignore = "ignore"
	// Cooperative concurrency: `async f()` spawns a green thread returning a
	// promise; `await p` suspends until it completes. See specs/async-await.md.
	async = "async"
	await = "await"
	// Declarations
	returns = "returns"
	var = "var"
	type = "type"
	union = "union"
	enum = "enum"
	static = "static"
	interface = "interface"
	extension = "extension"
	extends = "extends"
	implements = "implements"
	uses = "uses"
	with = "with"
	where = "where"
	self = "self"
	selfType = "Self"
	throws = "throws"
	from = "from"
	to = "to"
	mod = "mod"
	// Logical / bitwise operators
	and = "and"
	or = "or"
	not = "not"
	xor = "xor"
	shl = "shl"
	shr = "shr"
	as = "as"
	is = "is"
	// `sizeof(Type)` — a compile-time-or-descriptor intrinsic yielding a type's byte size (P1.6-B1).
	// Its own keyword so `sizeof(T)` parses its parenthesized operand as a TYPE (recovering `T` as the
	// enclosing generic type's parameter), not as a value-position call to a function named `sizeof`.
	sizeof = "sizeof"
	// `countof(Type)` — `sizeof`'s twin for a SIZED container type: how many ELEMENTS the type holds
	// (`Vector with 3 Int` ⇒ 3), rather than how many bytes one value of it occupies (W190). Its own keyword
	// for `sizeof`'s reason — the parenthesized operand is a TYPE, and an identifier-arm read would make
	// `countof(Self)` a value-position call to a function nobody declared.
	countof = "countof"
	// Literals
	true = "true"
	false = "false"
	// Primitive types
	int = "int"
	float = "float"
	bool = "bool"
	cstring = "cstring"
	// Literals
	intLiteral = "integer literal"
	floatLiteral = "float literal"
	charLiteral = "character literal"
	stringLiteral = "string literal"
	byteStringLiteral = "byte string literal"
	// Delimiters for pre-lexed interpolation expressions. A double-quoted
	// string containing `{...}` interpolations emits as:
	//   stringLiteral("fragment0") stringInterpStart <expr tokens> stringInterpEnd
	//   stringLiteral("fragment1") stringInterpStart <expr tokens> stringInterpEnd
	//   ...
	//   stringLiteral("fragmentN")
	// Strings without interpolations emit a single stringLiteral as
	// before. This lets the parser consume interpolated expressions inline
	// from the main token stream instead of re-lexing the expression bytes
	// through a sub-parser for every `{...}` segment.
	stringInterpStart = "interpolation start"
	stringInterpEnd = "interpolation end"
	// ⭐ **A FORMAT SPECIFIER IS ONE TOKEN OF RAW SOURCE — `"{n:08x}"` emits
	//   stringInterpStart intLiteral(n) stringFormatSpec("08x") stringInterpEnd.**
	// It is captured by the LEXER rather than reassembled by the parser from the tokens
	// the DFA would otherwise make of it, because those tokens do not carry the text
	// back: `08x` lexes as `intLiteral("08") identifier("x")` and `.2` as `dot`
	// `intLiteral("2")`, and a `dot` carries `EmptySourceText` (its kind implies its
	// text), so a reassembly would silently drop every punctuator the spec contains.
	// (v1's `Parser.parseInterpFormatSpec` concatenates token values for exactly this
	// job and can only do so because v1's lexer gives every token a source-aligned
	// value; shv2's does not, by design.) The bytes between the `:` and the closing `}`
	// are therefore taken verbatim, once, by `scanInterpFormatSpec`.
	stringFormatSpec = "format specifier"
	// Identifiers
	identifier = "identifier"
	// Punctuation
	leftParen = "("
	rightParen = ")"
	leftBrace = "\{"
	rightBrace = "}"
	leftBracket = "["
	rightBracket = "]"
	equals = "="
	equalsEquals = "=="
	bangEquals = "!="
	lessThan = "<"
	lessEquals = "<="
	greaterThan = ">"
	greaterEquals = ">="
	plus = "+"
	minus = "-"
	star = "*"
	slash = "/"
	dot = "."
	colon = ":"
	comma = ","
	// `@` prefixes a compiler annotation (currently only `@heap`). Emitted as a
	// standalone token; the parser consumes it together with the following
	// annotation identifier (e.g. `heap`) and the `var`/`let` it decorates.
	at = "@"
	// Conditional-compilation directives. Emitted as standalone tokens by the
	// lexer; the parser consults the build target to decide which branch to
	// keep and skips the others at the token-stream level.
	hashIf = "#if"
	hashElse = "#else"
	hashEndif = "#endif"
	newline = "newline"
	eof = "end of file"
end 'TokenKind'

export type Token
	export let kind as TokenKind
	// The token's text, as a ZERO-COPY slice of the source buffer — a pointer and a
	// length, not a copy. Nothing is materialized per token, and a `String` is built
	// from it only at the boundaries that genuinely need one (a symbol name that
	// outlives the parse, a diagnostic). Comparisons stay on the bytes: `ByteArray`
	// hashes and compares by content (see Array's Hashable/Equatable extension), so
	// it keys the scope and the interners directly.
	//
	// A token whose text is implied by its KIND — every punctuator, `newline`, EOF —
	// carries `EmptySourceText`, one shared empty slice, and so costs no allocation at
	// all. Identifiers, numbers, string literals and directives carry a span — and so do
	// KEYWORDS, which are lexed as identifiers and only then classified, so they reach
	// `emitWithSource` carrying their own bytes exactly like any other word token.
	// ⇒ `tokenDisplayText` is the one reader that resolves which of the two a caller wants.
	export let value as ByteArray
	export let line as LineNumber
	export let column as ColumnNumber
	// Byte offsets into the source buffer bracketing this token's span, used
	// by the parser to compute op source ranges and by the LSP to map cursor
	// positions back to ops. Both fields are 0 on EOF and synthetic tokens.
	export let startByte as ByteOffset
	export let endByte as ByteOffset

	// `value` defaults to the shared empty slice, so a caller emitting a token whose
	// text its kind already implies simply omits it — and allocates nothing.
	export static function create(kind TokenKind, line LineNumber, column ColumnNumber, value ByteArray = EmptySourceText, startByte ByteOffset = 0, endByte ByteOffset = 0) returns Token
		return Self{kind: kind, value: value, line: line, column: column, startByte: startByte, endByte: endByte}
	end 'create'

	export static function eof() returns Token
		return Self{kind: TokenKind.eof, value: EmptySourceText, line: 0, column: 0, startByte: 0, endByte: 0}
	end 'eof'
end 'Token'

// The text of a token whose kind already says what it is: every punctuator and
// operator, `newline`, and EOF. ONE shared empty slice for the whole compile rather
// than a fresh heap String per token — the allocation this type exists to not make.
// Exported because every name-shaped field downstream wants the same "no source text"
// value rather than minting its own empty.
export let EmptySourceText = b""

// How a DIAGNOSTIC names one token. A word or literal token carries its own source text
// (`int`, `Integer`, `42`) and that is what the reader has to find in the file; a token whose
// text its KIND already implies carries `EmptySourceText`, and for those the kind's own
// spelling IS the text (`TokenKind.leftParen` is `"("`).
//
// ⚠ "the kind's own spelling" holds for every PUNCTUATOR and OPERATOR, and NOT for the two
// LAYOUT kinds that also carry `EmptySourceText`: `TokenKind.newline`.rawValue is the NAME
// `"newline"` and `eof`'s is the phrase `"end of file"`, neither of which appears in the source.
// That is correct for the E2001 sites this fills — they name a token that IS there — and wrong for
// an operand position, which is the whole reason `expressionOperandDisplayText` below exists. Do
// not "unify" the two on the strength of the sentence above; it describes the majority, not the set.
//
// ⚠ It is ONE definition because `EmptySourceText`'s contract — "an empty value means the kind
// says the text" — is a fact about `Token`, and a second copy of it does not fail loudly if it
// drifts: it quietly names the offending token something the source never wrote. It had two
// readers before it had a name (`tokenTextFrom`'s span renderer, and the E2001 `unexpected
// token: '<x>'` sites, whose `got` field this fills).
export function tokenDisplayText(token Token) returns String
	if token.value.isEmpty() 'kindImpliesTheText'
		return token.kind.rawValue
	end 'kindImpliesTheText'

	return String.from(token.value)
end 'tokenDisplayText'

// ⭐ **THE TOKEN AS THE SOURCE WROTE IT — `tokenDisplayText` PLUS THE DELIMITERS THE LEXER STRIPPED.**
// A quoted literal's `value` is its BODY: `'a'` carries `a`, `"hi"` carries `hi`, `b"hi"` carries `hi`.
// That is what a diagnostic naming ONE token wants — the message supplies its own quotes — and it is
// exactly wrong for a diagnostic that reproduces a SPAN of source. `'a' upto 'b'` would read
// `a upto b`, naming bounds the reader will not find in the file, which is the very failure
// `tokenDisplayText`'s header names; and a span laid out by COLUMN drifts by the two characters the
// spelling did not write (`tokenTextFrom` used to carry that under-advance as a known inexactness).
//
// ⚠ It is a SECOND function rather than a widening of `tokenDisplayText`, for the reason
// `expressionOperandDisplayText` is one too: the QUESTION differs, not the answer. That one names a
// token in PROSE, inside a message that quotes it; this one reconstructs SOURCE.
export function tokenSourceSpelling(token Token) returns String
	if token.kind == TokenKind.charLiteral 'singleQuoted'
		return "'{String.from(token.value)}'"
	end 'singleQuoted'

	if token.kind == TokenKind.stringLiteral 'doubleQuoted'
		return "\"{String.from(token.value)}\""
	end 'doubleQuoted'

	if token.kind == TokenKind.byteStringLiteral 'bytePrefixed'
		return "b\"{String.from(token.value)}\""
	end 'bytePrefixed'

	return tokenDisplayText(token)
end 'tokenSourceSpelling'

// What E2004 prints in place of a token when the source wrote no operand AT ALL. A cross-compiler
// WIRE VALUE rather than a phrasing choice: `specs/expected-expression-error.md` pins these exact
// bytes, and each compiler is tested against its own copy of that file (shv2's is
// `specs-shv2/expected-expression-error.md`, byte-identical to it).
let AbsentOperandText = "(empty)"

// How the E2004 EXPRESSION path names the token standing where an operand belongs. A SECOND renderer
// beside `tokenDisplayText`, which is what both references keep for this path too
// (`formatExpressionTokenValue`, maxon-selfhosted/Compiler/Parser.maxon:20922;
// `FormatTokenValueForError`, maxon-sharp/Compiler/2-Parser.cs:18076) — and it is second because the
// QUESTION is different, not because the answer is. Everywhere else a diagnostic names a token the
// author WROTE; here it may have to name the fact that the author wrote NOTHING. `let x =` has no
// operand at all, and quoting the layout token that closed the line ("newline") names something the
// reader will not find in the file.
//
// ⚠ THE TWO REFERENCES KEY ON THE TOKEN'S VALUE BEING EMPTY AND shv2 CANNOT, because in shv2 every
// punctuator and operator carries `EmptySourceText` as well (see `Token.value`) — so `- -x` would
// report `(empty)` for its second `-`. shv2 keys on the KIND, which is the thing that actually
// decides whether `rawValue` is the source spelling (`TokenKind.star` is `"*"`) or a NAME for a
// position in the stream (`TokenKind.newline` is `"newline"`).
//
// ⚠ EOF IS DELIBERATELY NOT IN THAT SET, and the references agree with that by CONSTRUCTION rather
// than by omission: the bootstrap raises its own `ParserUnexpectedEof` before this renderer is ever
// reached (2-Parser.cs:18070), so `(empty)` was never EOF's answer there and there is no convention
// to mirror. What shv2 should report when an operand runs into the end of the file is a separate
// open question — see maxon-shv2/PLAN.md:2423 — and not this renderer's to settle.
//
// ⚠ THE REST OF THE "rawValue IS A NAME" FAMILY IS OUT ON PURPOSE, and for a reason that is NOT
// "no red case reached it": `AbsentOperandText` asserts THE AUTHOR WROTE NOTHING THERE, which is
// true of a line that ended and false of every other member. `stringInterpStart`/`stringInterpEnd`
// (`"interpolation start"`) stand for real bytes the author typed; so do `identifier` and the five
// literal kinds (`intLiteral` is `"integer literal"`). Reporting `(empty)` for any of them would be
// a WRONG ANSWER, not a missing one — so this is one exception, not the first arm of a table.
// What those kinds *should* print is a separate question this renderer does not answer: they render
// as their category NAME, where both references render the token's TEXT (`'5'`, not
// `'integer literal'`) because their renderers pass the token VALUE through. Reachable at
// `resolveEnumArmCase` — and NO spec on either side pins it, which is what makes it a corner the
// language has not specified rather than a divergence from it. It needs no note and no rung: the
// spec that settles it will say so when the port order reaches it, and that is the only backlog.
export function expressionOperandDisplayText(token Token) returns String
	if token.kind == TokenKind.newline 'lineEndedWithNoOperand'
		return AbsentOperandText
	end 'lineEndedWithNoOperand'

	return token.kind.rawValue
end 'expressionOperandDisplayText'

// ⭐⭐ **HOW A DIAGNOSTIC NAMES WHAT THE GRAMMAR REQUIRED — the `expected` half of E2010.**
// `tokenDisplayText` above answers the `got` half; this answers the other, and they are not the same
// question — `got` names a token that IS in the file, `expected` names something the source has yet to
// supply, so it is not routed through that helper (see `ParseError.unexpectedToken`).
//
// **THE RULE IS THE REFERENCE'S, AND IT IS ABOUT SPELLINGS AND NOTHING ELSE: a token SPELLING is
// QUOTED; a CLASS is BARE.** `1-Lexer.cs:135-153` builds its display table by quoting every entry of
// `KeywordMap` and `OperatorMap` plus the punctuators — exactly the strings an author has to TYPE — and
// leaves everything else bare (`identifier`, `characterliteral`, `newline`, `end of file`). So the
// quotes are a QUOTATION, symmetric with the `got` half quoting what the author did type, and that is
// their whole job.
//
// ⛔⛔ **THEY ARE *NOT* A DELIMITER, AND "a PHRASE is quoted so the reader can see where it stops" IS
// REFUTED — canonical writes a multi-word expectation BARE in this very message family:**
//   `specs/lexer-parser-robustness.md:57,81`  `Unexpected end of input, expected type name`
//   `specs/lexer-parser-robustness.md:181`    `Unexpected end of input, expected characterliteral`
// The three quoted PHRASES canonical does carry (`'interpolation end'`, `'end of default value'`,
// `'end of global initializer'`) are hand-typed literals at three call sites, sitting beside that bare
// `type name` — the exception, not the rule. ⚠ Both framings were believed in this loop before they
// were measured; neither survived. What is structurally unfakeable is the PROVENANCE, not the text: in
// the reference every QUOTED expectation arrives from `Token.DisplayName` for a keyword or operator
// token type, and every BARE one does not.
//
// ⛔ **THE SPELLING TEST IS THEREFORE `classifyIdentifier`'s — THE LEXER'S OWN KEYWORD TABLE — AND NOT
// A LIST OF WORDS.** No property of the TEXT can separate `identifier` from `function`: both are one
// lowercase word, and `identifier` is itself a legal identifier. What separates them is that the lexer
// reads `function` as a keyword and `identifier` as no token at all. A word list here would fail OPEN —
// the next keyword added would silently start rendering bare — which is the shape this project keeps
// paying for, so the question is asked of the table that already knows the answer.
//
// ⚠⚠ **TWO KNOWN DIVERGENCES ARE LEFT STANDING HERE, DELIBERATELY.** Under the rule above a CLASS is
// bare whether or not it is one word, so `Expected 'a type'` (12 pins) and `Expected 'character
// literal'` (8 pins) are on the wrong side of it — the reference spells the second `characterliteral`
// and bare. This function quotes them because it only asks the SPELLING question and treats every
// multi-word expectation as quoted, which is right for the three phrase pins above and wrong for these
// two. Moving them is 20 pins, needs the bootstrap's live output as the oracle for the exact wording
// (`type name`? `a type`? `characterliteral`?), and is its own decision — NOT a ride-along on the tick
// that unquoted `identifier`. (E2004 hardcodes the bare `expression` in its own template: a different
// CODE with a different sentence, which agrees with the rule rather than being decided by it.)
export function expectationDisplayText(expected String) returns String
	if expectationNamesATokenClass(expected) 'aClassNoSourceSpells'
		return expected
	end 'aClassNoSourceSpells'

	return "'{expected}'"
end 'expectationDisplayText'

// Is `expected` a CLASS of token rather than a spelling of one? Answered for the single-word case only,
// which is where the two are genuinely indistinguishable by text — see `expectationDisplayText` for the
// rule, for why the keyword table and not a list, and for the multi-word classes this leaves quoted.
function expectationNamesATokenClass(expected String) returns bool
	let word = expected.toByteArray()
	if word.isEmpty() 'namesNothingAtAll'
		return false
	end 'namesNothingAtAll'

	for b in word 'eachByte'
		if not isAlpha(b) 'notOneIdentifierShapedWord'
			return false
		end 'notOneIdentifierShapedWord'
	end 'eachByte'

	return classifyIdentifier(word) == TokenKind.identifier
end 'expectationNamesATokenClass'

// The two characters the lexer hands to the parser as IDENTIFIERS so that it, not the
// lexer, reports them: neither is legal Maxon, and the parser quotes the offending text
// back in its diagnostic.
let BangTokenText = b"!"
let BackslashTokenText = b"\\"

export typealias TokenArray = Array with Token

// --- Table variables ---
// Static lookup: byte value -> character class (256 entries, O(1) index)
let charClassTable = [
	// 0-15:                                                                       \t                \n                      \r
	CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.tab, CharClass.lf, CharClass.other, CharClass.other, CharClass.cr, CharClass.other, CharClass.other,
	// 16-31
	CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other,
	// 32-47:  sp              !               "               #               $               %               &               '               (               )               *               +               ,               -               .               /
	CharClass.space, CharClass.bang, CharClass.dquote, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.squote, CharClass.lParen, CharClass.rParen, CharClass.star, CharClass.plus, CharClass.comma, CharClass.minus, CharClass.dot, CharClass.slash,
	// 48-63:  0-9                                                                                                           :               ;               <               =               >               ?
	CharClass.digit, CharClass.digit, CharClass.digit, CharClass.digit, CharClass.digit, CharClass.digit, CharClass.digit, CharClass.digit, CharClass.digit, CharClass.digit, CharClass.colon, CharClass.other, CharClass.less, CharClass.equals, CharClass.greater, CharClass.other,
	// 64-79:  @               A-O
	CharClass.other, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha,
	// 80-95:  P-Z                                                                             [               \               ]               ^               _
	CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.lBracket, CharClass.backslash, CharClass.rBracket, CharClass.other, CharClass.alpha,
	// 96-111: `               a-o
	CharClass.other, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha,
	// 112-127: p-z                                                                             {               |               }               ~               DEL
	CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.alpha, CharClass.lBrace, CharClass.other, CharClass.rBrace, CharClass.other, CharClass.other,
	// 128-255: extended ASCII (all other)
	CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other,
	CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other,
	CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other,
	CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other,
	CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other,
	CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other, CharClass.other,
