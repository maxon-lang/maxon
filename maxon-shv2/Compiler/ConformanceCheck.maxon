// ConformanceCheck.maxon — the whole-program `implements`-conformance pass (P1.7a slice 1).
//
// ⭐ **IT RUNS BEFORE `resolveTypes`, and that placement IS the design.** A conformance diagnostic
// prints SOURCE type spellings — `is missing 1 method(s):\n  - increment() returns void`,
// `process(value Float) returns Integer (expected process(value Integer) returns Integer)` — and
// `resolveTypes` erases `Integer` to `int` and `Float` to `float`. So the check runs alongside
// `checkValueMergeSignatures` (`compileToCodeResult`, before the pipeline), reading the still-unresolved
// signatures; any diagnostic it records is caught by the pipeline's own error gate after `resolveTypes`.
//
// ⭐ **THE MESSAGE PRINTS SOURCE STRINGS; THE COMPARISON CANONICALIZES ALIASES.** An interface method
// carries its types as rendered strings (see IrInterface); a type's method carries them as `MaxonType`s in
// the merged module — rendered here through `maxonTypeName` off the same project interner. A `Self` in the
// interface substitutes the conforming type (`Movable.move returns Self` matches `Point.move returns Point`).
// The E3016 MESSAGE prints those source spellings, but the agreement TEST runs them through
// `canonicalTypeName` first, so a ranged typealias collapses to its underlying primitive exactly as
// `resolveTypes` erases it — two aliases over the same primitive are one type here, as they are everywhere
// else in shv2 (`takesA(makeB())` compiles). That is the reference oracle's resolved model; comparing raw
// source spellings would false-reject a valid conformance that reaches a shared type through two alias names.
//
// ⭐ **DIVERGENCE FROM THE BOOTSTRAP (toward v1): an UNKNOWN interface is E3015.** The C# bootstrap
// SILENTLY accepts `implements Bogus`; v1 emits E3015, and so does shv2 — a typo'd interface name should
// not pass. See the rung report.
//
// ⭐⭐ **AN ASSOCIATED TYPE IS SUBSTITUTED ONCE, AT COLLECTION, AND EVERY LATER READER SEES ONLY THE RESULT
// (R5).** `type Box implements Container with Score` binds `Element := Score` before a single requirement is
// compared, so the requirement a verdict is computed from and the requirement a diagnostic prints ARE THE
// SAME STRING. `collectInterfaceMethods` is that one site; `signatureMatches` and
// `formatInterfaceMethodSignature` do no binding of their own. See that function's header for why this is
// v1's shape and not the bootstrap's two.

// One interface method paired with the interface it was DECLARED on — the source interface, so a method
// inherited via `extends` can be tagged `(from BaseInterface)` in a missing-method report.
type CollectedInterfaceMethod
	export let method as InterfaceMethodSig
	export let sourceInterfaceName as ByteArray

	export static function create(method InterfaceMethodSig, sourceInterfaceName ByteArray) returns CollectedInterfaceMethod
		return Self{method: method, sourceInterfaceName: sourceInterfaceName}
	end 'create'
end 'CollectedInterfaceMethod'

typealias CollectedInterfaceMethodArray = Array with CollectedInterfaceMethod

typealias InterfaceNameSet = Set with ByteArray

// Validate every `type X implements …` conformance whole-program (P1.7a slice 1). Records E3015 (unknown
// interface) / E3016 (partial or wrong-signature implementation); the pipeline's error gate stops the
// build. A conformance-free program short-circuits before building the function index — the same
// allocation-free gate `checkLinearAwait`/`buildEscapeSummary` use.
//
// ⚠ This used to say *"a conformance-free program (the whole scale corpus)"*, and the parenthesis was
// STALE: the generated corpus carries `y_iface_0.maxon` and `y_ifdisp.maxon`, four `implements` clauses each,
// so this check runs on every rung of the ladder (measured while attributing A1w's +3 allocations, one of
// which lands here). Do not use it as an example of the gate being taken.
export function checkConformance(project Project, module MaxonModule, signatures ProgramSignatures)
	if project.conformances.count() == 0 'noConformances'
		return
	end 'noConformances'

	// A duplicate-named method is E3006 (recorded by `commitFuncSignatures` during `queryAllModule`, so it
	// already sits in `project.diagnostics` here). It leaves the module's function table and the
	// `funcSignatures` registry resolving that collision independently, disagreeing on the method's arity —
	// and this check reads a method's param TYPES from the module but its param NAMES from `funcSignatures`
	// (see `checkOneMethod`), so on a disagreement it would index one column by the other's count and PANIC.
	// The E3006 already fails the build (the pipeline's error gate throws before lowering), so any E3015/E3016
	// here would be moot; refuse to read a malformed table, exactly as `PassPipeline.run` refuses to lower a
	// module that already has errors.
	if projectHasErrors(project) 'malformedModule'
		return
	end 'malformedModule'

	// The index is keyed by the REGISTRATION name (`func.name`): `qualifiedMethodName(typeName, methodName)`
	// for the first declaration of a method name, and the mangled `Type.method#Suffix` for every later overload
	// of it (D7) — which is exactly why `checkOneMethod` asks `project.overloadSets` for the whole set rather
	// than the bare key alone (R10).
	//
	// ⭐ **THE SHARED, CHECKED NAME INDEX (`FunctionNameIndex`, A1w) — THOUGH THIS IS THE ONE OF ITS FOUR
	// SITES THAT CANNOT MEET A DUPLICATE, AND THAT IS WORTH STATING RATHER THAN INHERITING.** Two bars, either
	// sufficient: the only cause available at this point is two PARSED declarations, which is E3006 at merge
	// and which the refusal four lines above has already turned into a `return`; and every synthesizer that
	// appends to a Maxon module runs LATER (`installManagedGlobalInit` is below this call in
	// `compileToCodeResult`), so there is no synthesized side for a declaration to collide with yet. It builds
	// its index here anyway: a fourth spelling of the loop costs more than the one integer compare does, and
	// if either bar ever moves this site says so instead of silently keeping one of two functions.
	let functionsByName = try FunctionNameIndex.create(module.functions, project: project) otherwise 'duplicateFunctionName'
		return
	end 'duplicateFunctionName'
	for conformance in project.conformances 'eachDecl'
		checkOneConformance(project, functionsByName: functionsByName, conformance: conformance, signatures: signatures)
	end 'eachDecl'
end 'checkConformance'

// The interfaces a type is DECLARED to implement — `Point` -> {`Digest`}. Built from `project.conformances`
// for the E3017 where-constraint check: an instantiation `Box with Point where T is Digest` is legal iff
// `Point` declares `implements Digest`. Conformance is DECLARED (nominal), matching `checkConformance`'s model.
typealias DeclaredConformanceMap = Map with (ByteArray, InterfaceNameSet)

// ⭐ **WHERE-CONSTRAINT VALIDATION AT INSTANTIATION (P1.7a slice 2a — E3017).** For every `typealias X = Base
// with Args` whose base declares `where T is <Interface>` constraints, each concrete argument must conform to
// (declare `implements`) the interface its parameter is constrained to — else E3017, anchored on the
// instantiation. Runs AFTER `queryProgramSignatures` (the instances are interned by then) and reads the
// DECLARED conformances `checkConformance` already validated (E3016), so a type reaching here as conforming has
// a complete, correct implementation. A program with no constrained instantiation short-circuits allocation-free.
export function checkWhereConstraints(project Project, signatures ProgramSignatures)
	let sites = signatures.instantiationSites()
	if sites.count() == 0 'noSites'
		return
	end 'noSites'

	// A prior diagnostic (a parse error, an E3006 duplicate) leaves `project.conformances` possibly INCOMPLETE
	// — a file whose parse failed may not have merged its `implements` clauses — so a conforming type could
	// read as non-conforming and yield a SPURIOUS E3017. Refuse to check a malformed program, exactly as
	// `checkConformance` does: the real diagnostic already fails the build, and this one would only be noise.
	if projectHasErrors(project) 'malformedProject'
		return
	end 'malformedProject'

	let declared = buildDeclaredConformanceMap(project)
	for site in sites 'eachSite'
		checkOneInstantiation(project, signatures: signatures, declared: declared, site: site)
	end 'eachSite'
end 'checkWhereConstraints'

// Validate one instantiation site's every `where` constraint (P1.7a slice 2a). A base with no constraints
// (the whole non-generic-witness corpus) iterates zero times.
function checkOneInstantiation(project Project, signatures ProgramSignatures, declared DeclaredConformanceMap, site GenericInstantiationSite)
	let baseName = signatures.genericInstanceBaseName(site.gid)
	let constraints = signatures.structWhereConstraints(baseName)
	for i in 0 upto constraints.count() 'eachConstraint'
		let constraint = try constraints.get(i) otherwise panic("checkOneInstantiation: whereConstraints.get OOB at {i}")
		// The CANONICAL conformer name (`Integer` -> `int`) is what the conformance test compares by — the same
		// name the witness table is keyed by — while the E3017 MESSAGE still prints the source spelling. This is
		// `signatureMatches`/`canonicalTypeName`'s split, applied to a `where`-constraint argument.
		let conformerType = signatures.conformerTypeArgName(site.gid, position: constraint.typeParamIndex).toByteArray()
		if not typeConformsTo(declared, typeName: conformerType, interfaceName: constraint.interfaceName) 'violates'
			let sourceType = signatures.instanceArgTypeName(site.gid, position: constraint.typeParamIndex)
			reportPositioned(project, code: ErrorCode.semanticWhereConstraintViolation, message: "Type '{String.from(sourceType)}' does not satisfy constraint '{String.from(constraint.interfaceName)}' required by type parameter '{String.from(constrainedTypeParamName(signatures, baseName: baseName, position: constraint.typeParamIndex))}' of '{String.from(baseName)}'", line: site.nameLine, column: site.nameColumn, filePath: site.filePath)
		end 'violates'
	end 'eachConstraint'
end 'checkOneInstantiation'

// The NAME of the constrained type parameter — the `T` of `where T is Bar` — for the E3017 sentence, which
// the canonical corpus spells naming it (`specs/where-clauses.md`'s `and-violation`). It lives on the SAME
// layout `structWhereConstraints` read the constraint off, so the position is an index into that
// declaration's own `uses` list by construction.
//
// Read only on the VIOLATION path, and that is deliberate: `structOf` boxes a `DeclaredStruct` per call
// (a Maxon union value is a heap object in every case), and a conforming instantiation — every one in a
// program that compiles — must not pay for a diagnostic it does not produce.
function constrainedTypeParamName(signatures ProgramSignatures, baseName ByteArray, position FieldIndex) returns ByteArray
	match signatures.structOf(baseName) 'base'
		declared(layout) then return try layout.typeParamNames.get(position) otherwise panic("constrainedTypeParamName: '{String.from(baseName)}' constrains type-parameter position {position}, outside its own `uses` list of {layout.typeParamNames.count()} — a `where` constraint is recorded against that list")
		undeclared then panic("constrainedTypeParamName: '{String.from(baseName)}' carries a `where` constraint but is in no struct registry — `structWhereConstraints` read that constraint off the very layout this lookup misses")
	end 'base'
end 'constrainedTypeParamName'

// ⭐ **DOES `typeName` CONFORM TO `interfaceName`? THE ONE predicate every conformance site consults (P1.7a
// slice 2b + P1.7b).** An intrinsic builtin-type conformance (`int`/`String` implements `Hashable`/`Equatable`,
// synthesized natively) ORed with the user-declared registry — so "int conforms to Hashable" is decided in
// exactly one place, never split between an intrinsic answer and a registry answer that could drift. `typeName`
// is the CANONICAL conformer name (`conformerTypeArgName`); the registry is keyed by the declared struct name,
// which a ranged-int alias's `int` or a `String` argument's `String` never collides with, so the OR is
// unambiguous.
function typeConformsTo(declared DeclaredConformanceMap, typeName ByteArray, interfaceName ByteArray) returns bool
	if isIntrinsicBuiltinConformance(typeName, interfaceName: interfaceName) 'intrinsic'
		return true
	end 'intrinsic'
	return typeDeclaresInterface(declared, typeName: typeName, interfaceName: interfaceName)
end 'typeConformsTo'

// Build the DECLARED-conformance index from `project.conformances` — a type NAME to the set of interfaces it
// declares `implements`. The E3017 check's `Point declares Digest?` lookup, built once per constrained program.
function buildDeclaredConformanceMap(project Project) returns DeclaredConformanceMap
	var declared = DeclaredConformanceMap.create()
	// One `type X implements A, B` clause is ONE ConformanceDecl, so a fresh set per decl needs no
	// accumulate-into-existing (which would borrow the map across its own `upsert`). A duplicate `implements`
	// on one type is E3006, reported before this runs.
	for conformance in project.conformances 'eachDecl'
		var interfaces = InterfaceNameSet.create()
		for i in 0 upto conformance.interfaces.count() 'eachIface'
			interfaces.insert((try conformance.interfaces.get(i) otherwise panic("buildDeclaredConformanceMap: interfaces.get OOB at {i}")).interfaceName)
		end 'eachIface'
		declared.upsert(conformance.typeName, value: interfaces)
	end 'eachDecl'
	return declared
end 'buildDeclaredConformanceMap'

// Does `typeName` declare `implements interfaceName` (P1.7a slice 2a)? A type with no conformance declaration
// answers false — the E3017 case.
function typeDeclaresInterface(declared DeclaredConformanceMap, typeName ByteArray, interfaceName ByteArray) returns bool
	if let interfaces = try declared.get(typeName) 'hasDecl'
		return interfaces.contains(interfaceName)
	end 'hasDecl'
	return false
end 'typeDeclaresInterface'

// Check one `type X implements I1, I2` declaration against each named interface.
//
// The conforming type's `uses` names are read ONCE per declaration rather than per rendered type: they
// depend only on the conforming type, and `project.structTypes` is a map lookup that would otherwise run
// per rendered parameter.
function checkOneConformance(project Project, functionsByName FunctionNameIndex, conformance ConformanceDecl, signatures ProgramSignatures)
	// The conforming type's own `uses` names — the list a `typeParameter(pos)` in one of its methods indexes,
	// read ONCE per declaration rather than per rendered type (it is a map lookup, and it does not vary).
	//
	// Only a `type` declaration records a ConformanceDecl (`Parser.parseTypeDeclaration` is the sole caller
	// of `parseTypeImplementsClause`) and every parsed `type` commits its layout (`commitStructTypes`), so a
	// conformer with no layout is a merge-invariant violation exactly as a signature-less module function is.
	let layout = try project.structTypes.get(conformance.typeName) otherwise panic("checkOneConformance: conforming type '{String.from(conformance.typeName)}' declares `implements` but is in no struct registry — only a declared `type` records a ConformanceDecl, and every declared `type` commits a StructLayout")
	let typeParamNames = layout.typeParamNames

	for i in 0 upto conformance.interfaces.count() 'eachIface'
		let entry = try conformance.interfaces.get(i) otherwise panic("checkOneConformance: interfaces.get OOB at {i}")
		match lookupInterface(project.interfaces, name: entry.interfaceName) 'resolve'
			notFound then reportPositioned(project, code: ErrorCode.semanticUnknownInterface, message: "type '{String.from(conformance.typeName)}' implements unknown interface '{String.from(entry.interfaceName)}'", line: conformance.nameLine, column: conformance.nameColumn, filePath: conformance.filePath)
			found(iface) then checkOneInterfaceConformance(project, functionsByName: functionsByName, conformance: conformance, entry: entry, iface: iface, typeParamNames: typeParamNames, signatures: signatures)
		end 'resolve'
	end 'eachIface'
end 'checkOneConformance'

// ⭐ **EVERY ASSOCIATED TYPE THE INTERFACE DECLARES MUST BE BOUND, AND THAT IS ASKED BEFORE ANY SIGNATURE
// IS COMPARED (R5).** `type Broken implements HasElement` against `interface HasElement uses Element`
// leaves `Element` denoting nothing, so every requirement mentioning it would be reported as a WRONG
// SIGNATURE — the consequence of the mistake rather than the mistake, and a message telling the author to
// change a method that is already right. Both references diagnose it first and by name (bootstrap
// `2-Parser.cs:3401-3407`, v1 `TypeResolution.maxon:1161-1164`) and the spec pins the sentence.
//
// Bindings are POSITIONAL — `withArgs[i]` binds `associatedTypeNames[i]` — so "unbound" is exactly "at an
// index the argument list does not reach", and the FIRST such name is the one reported. Naming one rather
// than listing all of them is the references' shape, and it is the right one: a missing binding is written
// at a single site the author fixes in one edit.
//
// ⚖ **A SURPLUS ARGUMENT IS NOT DIAGNOSED *HERE*, AND AFTER R6 THAT IS A STATEMENT ABOUT THE TIER RATHER
// THAN ABOUT THE RULE.** The rule now splits on the SPELLING — `implements One with (Integer, Float)` against
// `interface One uses A` is refused (**E2066**, `Parser.checkParenthesizedConformanceArgs`), while the same
// surplus written WITHOUT parentheses is still ignored. That split cannot be made at this tier and never
// could: `InterfaceConformance` carries a `ByteArrayArray`, so by the time a conformance reaches this
// function the parentheses are gone and the two spellings are one value. Whether the list was written
// explicitly is a fact only the token stream holds, which is why the refusal lives in the parser.
//
// The two references disagree about the surplus, and shv2 takes NEITHER wholesale. The bootstrap binds
// `min(names, args)` and ignores the rest (`ResolveWithTypeParams`, `2-Parser.cs:2947-2953`); v1 rejects an
// arity mismatch in either direction (`TypeResolution.maxon:1152-1168`, as an E3015). shv2 keeps the
// bootstrap's silence for the UNPARENTHESIZED form, for two reasons and not as a coin flip:
//
//   • ONE rule then covers both shapes a conformance can get wrong. An argument list that is too SHORT is a
//     NAMED missing binding whatever its length, so `Pair with Integer` against `uses First, Second` says
//     `Second` — where v1 reaches its arity arm and reports a count instead, needing a second wording.
//     **This half is UNCHANGED by R6**: a deficit is still reported by name, in either spelling, right below.
//   • Unparenthesized, the LENGTH is not the author's assertion — it is decided by the interface's arity,
//     and a trailing comma legitimately belongs to the outer `implements` list (which is why both references
//     consume exactly `arity` items there, and why `surplus-conformance-argument-is-ignored` pins it).
//     Parenthesized, the length IS asserted, and an assertion can be wrong.
//
// ⚠ **THE INHERITED-`uses` ARGUMENT SURVIVES R6, NARROWED.** `interface Sub extends Base` where
// `Base uses Element` leaves `Sub` with an empty `associatedTypeNames` here, so `implements Sub with Score`
// — a shape v1 supports outright (`findInheritedBindings`) — has "too many" arguments against an interface
// that transitively requires exactly that one. That program is REJECTED TODAY EITHER WAY, and only v1 is the
// outlier: shv2 AND the bootstrap give the identical sentence, character for character,
// `E3016 … get() returns Integer (expected get() returns Element)`, because shv2 does not inherit the
// binding either. So R6 changes which sentence the parenthesized spelling gets, never accept into reject.
// The forward-compatibility obligation is recorded where it can be acted on — `Parser.conformanceUsesArity`,
// which also states why the transitive count cannot simply be walked at parse time today.
function checkOneInterfaceConformance(project Project, functionsByName FunctionNameIndex, conformance ConformanceDecl, entry InterfaceConformance, iface IrInterface, typeParamNames ByteArrayArray, signatures ProgramSignatures)
	if entry.withArgs.count() < iface.associatedTypeNames.count() 'unboundAssociatedType'
		let unbound = try iface.associatedTypeNames.get(entry.withArgs.count()) otherwise panic("checkOneInterfaceConformance: associatedTypeNames.get OOB at {entry.withArgs.count()} below count {iface.associatedTypeNames.count()}")
		reportPositioned(project, code: ErrorCode.semanticPartialInterfaceImpl, message: "Type '{String.from(conformance.typeName)}' does not define required associated type '{String.from(unbound)}' from interface '{String.from(entry.interfaceName)}'", line: conformance.nameLine, column: conformance.nameColumn, filePath: conformance.filePath)
		return
	end 'unboundAssociatedType'

	checkInterfaceMethods(project, functionsByName: functionsByName, conformance: conformance, entry: entry, iface: iface, typeParamNames: typeParamNames, signatures: signatures)
end 'checkOneInterfaceConformance'

// Validate that a conforming type supplies every method the interface requires (its own AND its
// `extends`-inherited), each with a matching signature. Reports E3016 with the MISSING methods, else with
// the WRONG-SIGNATURE ones — missing first and mutually exclusive, mirroring the oracle's throw-on-first.
//
// ⭐⭐ **A `static` REQUIREMENT IS A REQUIREMENT (R9), AND SKIPPING IT WAS A REACHABLE COMPILER PANIC.**
// This loop used to `continue` on `method.isStatic`, so a conformer that supplied nothing for
// `static function tag()` was accepted — while `ensureWitnessTable` still reserved that method's slot and
// stamped a `funcAbs64InRdata` relocation naming `Point.tag`, a symbol no function installs. Two components
// disagreeing about whether the requirement exists, and the disagreement surfaced as
// `bakeFuncAbs64Relocs: … references .text function 'Point.tag', which is in no debug symbol`. The witness
// slot is the reason the skip cannot simply be narrowed to "only when a table is built": whether a table
// HAPPENS to be built must not decide whether a type conforms, so the check is unconditional and a program
// with no generic instantiation is now rejected too.
//
// ⚠ **THE TWO REFERENCES DISAGREE HERE, AND v1 IS THE ONE shv2 FOLLOWS — HALFWAY.** The bootstrap
// `continue`s before its `func == null` test (`2-Parser.cs:3428-3432`), so a MISSING static is silently
// accepted; v1 pushes the missing entry first and only then skips (`SemanticCheck.maxon:412-430`), so a
// missing static IS reported. shv2 takes v1's answer for the missing case and diverges from BOTH for the
// present one: v1 skips a present static's SIGNATURE because *"no runtime witness is dispatched against
// them"*, which is exactly the sentence shv2's dictionary-passing falsifies — the table carries one slot per
// interface method, statics included, so a static whose shape disagrees with the requirement is an ABI
// disagreement in a slot, the same argument `validateThrowsConformance` already makes for shv2's own
// throws rules. The skip's original comment was right about WHY it existed (`checkOneMethod` reads an
// INSTANCE method) and wrong about how far that reaches: the fix is to make the lookup receiver-aware
// (`signatureMatches`' staticness test), not to stop asking.
function checkInterfaceMethods(project Project, functionsByName FunctionNameIndex, conformance ConformanceDecl, entry InterfaceConformance, iface IrInterface, typeParamNames ByteArrayArray, signatures ProgramSignatures)
	var collected = CollectedInterfaceMethodArray.create()
	var visited = InterfaceNameSet.create()
	collectInterfaceMethods(project, iface: iface, ifaceName: entry.interfaceName, associatedTypeNames: iface.associatedTypeNames, boundTypeNames: entry.withArgs, out: collected, visited: visited)

	var missing = StringArray.create()
	var wrongSignature = StringArray.create()
	for i in 0 upto collected.count() 'eachMethod'
		let collectedMethod = try collected.get(i) otherwise panic("checkInterfaceMethods: collected.get OOB at {i}")
		checkOneMethod(project, functionsByName: functionsByName, conformance: conformance, collectedMethod: collectedMethod, rootInterfaceName: entry.interfaceName, typeParamNames: typeParamNames, signatures: signatures, missing: missing, wrongSignature: wrongSignature)
	end 'eachMethod'

	if missing.count() > 0 'hasMissing'
		reportPositioned(project, code: ErrorCode.semanticPartialInterfaceImpl, message: "Partial interface implementation: type '{String.from(conformance.typeName)}' is missing {missing.count()} method(s):\n{joinBulletedLines(missing)}", line: conformance.nameLine, column: conformance.nameColumn, filePath: conformance.filePath)
		return
	end 'hasMissing'

	if wrongSignature.count() > 0 'hasWrongSignature'
		reportPositioned(project, code: ErrorCode.semanticPartialInterfaceImpl, message: "Partial interface implementation: type '{String.from(conformance.typeName)}' has {wrongSignature.count()} method(s) with wrong signature:\n{joinBulletedLines(wrongSignature)}", line: conformance.nameLine, column: conformance.nameColumn, filePath: conformance.filePath)
	end 'hasWrongSignature'
end 'checkInterfaceMethods'

// Collect an interface's methods and, recursively, its `extends` parents' — each tagged with the interface
// it was DECLARED on (so a missing inherited method reports `(from Parent)`). `visited` guards against a
// cyclic `extends` chain (a parent already seen contributes nothing). Own methods precede inherited ones,
// matching the oracle's `CollectInterfaceMethods` order.
//
// ⭐⭐ **THIS IS WHERE ASSOCIATED TYPES ARE SUBSTITUTED, AND IT IS THE ONLY PLACE THEY ARE (R5).** A
// collected requirement is ALREADY substituted, so the two things that read one — `signatureMatches`, which
// decides the verdict, and `formatInterfaceMethodSignature`, which writes the sentence — are reading one
// string rather than each deriving their own. That is v1's shape (`substituteMethodSig` builds
// `expectedMethods` once, `TypeResolution.maxon:1253+`, and `checkConformanceForType` +
// `formatMethodSig` both read it) and deliberately NOT the bootstrap's, which substitutes twice off one
// dict — `ResolveInterfaceTypeName` inside `SignatureMatches` and `FormatResolved` at the message
// (`2-Parser.cs:3577`, `MlirType.cs`). Under the two-site shape a substitution that reaches the comparison
// and misses the message yields a CORRECT VERDICT WITH A WRONG SENTENCE, which no positive test can see.
//
// The binding pair is the ROOT conformance's, threaded unchanged into every parent: an `extends` parent
// that re-declares the same `uses` NAME is substituted by it (substitution is by name, which is the only
// vocabulary the two interfaces share), and a parent declaring a name of its own is left denoting itself —
// exactly as before this rung. `boundTypeNames` is indexable at every position `associatedTypeNames` has,
// because `checkOneInterfaceConformance` returned early otherwise.
function collectInterfaceMethods(project Project, iface IrInterface, ifaceName ByteArray, associatedTypeNames ByteArrayArray, boundTypeNames ByteArrayArray, out CollectedInterfaceMethodArray, visited InterfaceNameSet)
	if visited.contains(ifaceName) 'alreadySeen'
		return
	end 'alreadySeen'
	visited.insert(ifaceName)

	for i in 0 upto iface.methods.count() 'eachMethod'
		let declared = try iface.methods.get(i) otherwise panic("collectInterfaceMethods: methods.get OOB at {i}")
		out.push(CollectedInterfaceMethod.create(substituteAssociatedTypes(declared, associatedTypeNames: associatedTypeNames, boundTypeNames: boundTypeNames), sourceInterfaceName: ifaceName))
	end 'eachMethod'

	for j in 0 upto iface.extendsInterfaces.count() 'eachParent'
		let parentName = try iface.extendsInterfaces.get(j) otherwise panic("collectInterfaceMethods: extendsInterfaces.get OOB at {j}")
		match lookupInterface(project.interfaces, name: parentName) 'parent'
			found(parentIface) then collectInterfaceMethods(project, iface: parentIface, ifaceName: parentName, associatedTypeNames: associatedTypeNames, boundTypeNames: boundTypeNames, out: out, visited: visited)
			// A parent named by `extends` that does not resolve is not diagnosed here (slice 1 does not
			// report a bad `extends` target); its methods simply cannot be projected.
			notFound then break 'parent'
		end 'parent'
	end 'eachParent'
end 'collectInterfaceMethods'

// One requirement with every associated type replaced by what the conformance bound it to (R5) — the
// substitution the header above says happens exactly once. An interface that declares no associated type
// (every conformance in the corpus outside `specs-shv2/associated-types.md`) hands its own signature
// straight back, so the common path allocates nothing at all.
function substituteAssociatedTypes(method InterfaceMethodSig, associatedTypeNames ByteArrayArray, boundTypeNames ByteArrayArray) returns InterfaceMethodSig
	if associatedTypeNames.count() == 0 'noAssociatedTypes'
		return method
	end 'noAssociatedTypes'

	var paramTypeNames = ByteArrayArray.create()
	for i in 0 upto method.paramTypeNames.count() 'eachParam'
		paramTypeNames.push(boundTypeName(try method.paramTypeNames.get(i) otherwise panic("substituteAssociatedTypes: paramTypeNames.get OOB at {i}"), associatedTypeNames: associatedTypeNames, boundTypeNames: boundTypeNames))
	end 'eachParam'

	return InterfaceMethodSig.create(method.name, paramNames: method.paramNames, paramTypeNames: paramTypeNames, returnTypeName: boundTypeName(method.returnTypeName, associatedTypeNames: associatedTypeNames, boundTypeNames: boundTypeNames), isStatic: method.isStatic, throwsClause: substituteThrowsClause(method.throwsClause, associatedTypeNames: associatedTypeNames, boundTypeNames: boundTypeNames))
end 'substituteAssociatedTypes'

// What ONE written type name in a requirement denotes under this conformance's bindings: the argument bound
// at the associated type's position, or the name itself when it names no associated type. A linear scan and
// not a map — an interface declares a handful of `uses` names at most, so the scan is cheaper than building
// a map would be, and it needs no allocation on a path the whole corpus walks.
function boundTypeName(name ByteArray, associatedTypeNames ByteArrayArray, boundTypeNames ByteArrayArray) returns ByteArray
	for i in 0 upto associatedTypeNames.count() 'eachAssociatedType'
		if (try associatedTypeNames.get(i) otherwise panic("boundTypeName: associatedTypeNames.get OOB at {i}")).equals(name) 'isAssociatedType'
			return try boundTypeNames.get(i) otherwise panic("boundTypeName: boundTypeNames.get OOB at {i} below associated-type count {associatedTypeNames.count()} — `checkOneInterfaceConformance` reports a short argument list and returns before any requirement is collected")
		end 'isAssociatedType'
	end 'eachAssociatedType'
	return name
end 'boundTypeName'

// The `throws E` clause under the same bindings. It substitutes for the reason every other position does —
// `function next() throws Element` is as much an associated-type USE as a parameter is, and the throws
// relation is compared by NAME (`requireSameErrorType`), so an unsubstituted clause would reject a
// conforming impl. v1 substitutes it too, and says why in one line (`substituteThrowsName`,
// `TypeResolution.maxon:1249-1252`).
function substituteThrowsClause(clause ThrowsClause, associatedTypeNames ByteArrayArray, boundTypeNames ByteArrayArray) returns ThrowsClause
	match clause 'declared'
		none then return ThrowsClause.none
		throwing(name) then return ThrowsClause.throwing(String.from(boundTypeName(name.toByteArray(), associatedTypeNames: associatedTypeNames, boundTypeNames: boundTypeNames)))
	end 'declared'
end 'substituteThrowsClause'

// Check ONE interface method against the conforming type: absent -> `missing`, present but mismatched ->
// `wrongSignature`. A missing method's expected signature is tagged `(from Parent)` when it was inherited.
//
// ⭐⭐ **A REQUIREMENT IS MATCHED AGAINST EVERY MEMBER DECLARED UNDER ITS NAME, NOT AGAINST WHICHEVER ONE
// HOLDS THE BARE KEY (R10).** Under D7 only the FIRST declaration of a name registers as `Type.method`; a
// later overload is `Type.method#Suffix`. A lookup by the bare name alone therefore made CONFORMANCE DEPEND
// ON MEMBER DECLARATION ORDER — `label()` beside `label(extra Code)` satisfied `Named.label()` when it was
// written first and was rejected as a wrong signature when it was written second, with a message naming the
// member that is not even the candidate.
//
// ⚠ **THE OVERLOADED CASE IS SPLIT OFF AND PAYS FOR ITSELF ALONE, and that is measured rather than tidy.**
// Materializing a candidate list and a match list for EVERY requirement would allocate two arrays per
// conforming method of every program that declares any conformance — the same per-conforming-method cost
// `validateThrowsConformance`'s header records scale-test reading straight off a 16-byte union box
// (+16 … +264 allocations across the six rungs). A name that is not in `overloadSets` — every method in the
// corpus outside this rung's cases — takes the arm below and allocates nothing it did not allocate before.
function checkOneMethod(project Project, functionsByName FunctionNameIndex, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, rootInterfaceName ByteArray, typeParamNames ByteArrayArray, signatures ProgramSignatures, missing StringArray, wrongSignature StringArray)
	let method = collectedMethod.method
	let qualifiedName = qualifiedMethodName(conformance.typeName, methodName: method.name)

	if let members = try project.overloadSets.get(qualifiedName) 'overloaded'
		checkOverloadedMembers(project, functionsByName: functionsByName, conformance: conformance, collectedMethod: collectedMethod, rootInterfaceName: rootInterfaceName, typeParamNames: typeParamNames, signatures: signatures, members: members, missing: missing, wrongSignature: wrongSignature)
		return
	end 'overloaded'

	if let implFunc = try functionsByName.funcNamed(qualifiedName) 'present'
		let implSig = conformanceImplSignature(project, name: qualifiedName)
		if not signatureMatches(project, method: method, conformingType: conformance.typeName, implFunc: implFunc, implSig: implSig, typeParamNames: typeParamNames, signatures: signatures) 'mismatch'
			wrongSignature.push("{formatActualSignature(project, methodName: method.name, conformingType: conformance.typeName, implFunc: implFunc, implSig: implSig, typeParamNames: typeParamNames, signatures: signatures)} (expected {formatInterfaceMethodSignature(method)})")
		end 'mismatch' else 'signatureOk'
			acceptConformingMember(project, functionsByName: functionsByName, conformance: conformance, collectedMethod: collectedMethod, selected: qualifiedName, implFunc: implFunc, typeParamNames: typeParamNames, signatures: signatures)
		end 'signatureOk'
		return
	end 'present'

	pushMissingRequirement(missing, collectedMethod: collectedMethod, rootInterfaceName: rootInterfaceName)
end 'checkOneMethod'

// The requirement's name is OVERLOADED: match it against every live member of the set and accept it when
// EXACTLY ONE matches (R10).
//
// ⚠ **EXACTLY ONE, because a witness slot holds exactly one address.** Two members can genuinely match one
// requirement — `signatureMatches` compares CANONICALIZED type names, so two ranged aliases over one
// primitive are one type here (see `canonicalTypeName`) — and taking the first would be the bare key's
// order-dependence restored under a different name. The call-site resolver already refuses that same pair as
// E3007, so refusing it here says the same thing at the declaration.
//
// The candidate list comes from `SemanticCheck.overloadCandidates` — the ONE staleness filter over
// `overloadSets` — so a member left behind by a previous fold is inert here exactly as it is at a call.
// An empty list is a requirement the type declares nothing for: the set holds only names this project no
// longer registers, which is the MISSING case and not a mismatch.
function checkOverloadedMembers(project Project, functionsByName FunctionNameIndex, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, rootInterfaceName ByteArray, typeParamNames ByteArrayArray, signatures ProgramSignatures, members ByteArrayArray, missing StringArray, wrongSignature StringArray)
	let candidates = overloadCandidates(project, members: members)
	if candidates.count() == 0 'noMemberSurvives'
		pushMissingRequirement(missing, collectedMethod: collectedMethod, rootInterfaceName: rootInterfaceName)
		return
	end 'noMemberSurvives'

	var matched = ByteArrayArray.create()
	for candidate in candidates 'eachCandidate'
		if signatureMatches(project, method: collectedMethod.method, conformingType: conformance.typeName, implFunc: conformanceImplFunction(functionsByName, name: candidate), implSig: conformanceImplSignature(project, name: candidate), typeParamNames: typeParamNames, signatures: signatures) 'matches'
			matched.push(candidate)
		end 'matches'
	end 'eachCandidate'

	if matched.count() != 1 'notExactlyOne'
		wrongSignature.push(overloadMismatchLine(project, conformance: conformance, method: collectedMethod.method, functionsByName: functionsByName, candidates: candidates, matched: matched, typeParamNames: typeParamNames, signatures: signatures))
		return
	end 'notExactlyOne'

	let selected = try matched.get(0) otherwise panic("checkOverloadedMembers: matched.count() is 1 but get(0) failed")
	acceptConformingMember(project, functionsByName: functionsByName, conformance: conformance, collectedMethod: collectedMethod, selected: selected, implFunc: conformanceImplFunction(functionsByName, name: selected), typeParamNames: typeParamNames, signatures: signatures)
end 'checkOverloadedMembers'

// ⭐⭐ **THE ONE PLACE A REQUIREMENT IS DECLARED SATISFIED — and the place the WITNESS TABLE learns by which
// member (R10).** The selection is filed under the slot's own key so `ensureWitnessTable` stamps the
// relocation from THIS answer rather than re-joining `<Type>.<method>` for itself; see `WitnessSlotImplMap`
// for the silent wrong dispatch that second derivation was.
//
// The THROWS relation is checked only once the structural signature agrees, mirroring the oracle's
// `else if (method.ThrowsTypeName != null)` branch: on a shape mismatch the throws question is noise. It is
// asked of the SELECTED member's function, which under an overload set is not necessarily the bare-named one.
function acceptConformingMember(project Project, functionsByName FunctionNameIndex, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, selected ByteArray, implFunc IrFunction, typeParamNames ByteArrayArray, signatures ProgramSignatures)
	recordWitnessSlotImpl(project, functionsByName: functionsByName, conformance: conformance, collectedMethod: collectedMethod, selected: selected, typeParamNames: typeParamNames, signatures: signatures)
	validateThrowsConformance(project, signatures: signatures, conformance: conformance, collectedMethod: collectedMethod, implFunc: implFunc)
end 'acceptConformingMember'

// File the accepted member under its witness slot's key (R10). An entry already present must AGREE: two
// conformances of one type routinely reach the same `(conformer, interface, method)` slot — `implements Sub,
// Base` where `Sub extends Base` collects Base's requirements twice — and they normally select identically,
// because the selection is a function of the conformer and the requirement's SUBSTITUTED signature alone.
//
// ⭐⭐ **A DISAGREEMENT IS THE AUTHOR'S, NOT THE COMPILER'S, AND IT PANICKED UNTIL THE R10 REVIEW.** The
// substituted signature is exactly what an associated-type binding varies, so two routes to one slot that
// bind that interface's `uses` names differently compare DIFFERENT requirements under one key and can select
// different members. Both spellings are ordinary source and both were rejected cleanly as E3016 before R10
// (the bare key could satisfy only one of the two requirements, so the other reported a wrong signature) —
// matching a requirement against the whole overload set is what lets both routes SUCCEED and disagree:
//
//   • `implements Conv with Whole, Conv with Real` — one interface named twice, bound two ways.
//   • `implements Child with Whole, Parent with Real`, `interface Child extends Parent uses Item` — reaches
//     `Parent` twice while naming no interface twice, so no rule about the SHAPE of an `implements` clause
//     could have caught it. This is why the condition is detected where the two selections MEET.
//
// ⚠ **THE SLOT IS THE UNIT OF THE CONTRADICTION, so the diagnostic is filed against the slot rather than
// against the clause.** One witness table per (conformer, interface) with one address per method slot is the
// dictionary's shape, so an interface has to be conformed to exactly one way; there is nothing to choose by
// and nothing the lowering could do with two answers but flip a coin.
function recordWitnessSlotImpl(project Project, functionsByName FunctionNameIndex, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, selected ByteArray, typeParamNames ByteArrayArray, signatures ProgramSignatures)
	let key = witnessSlotImplKey(conformance.typeName, interfaceName: collectedMethod.sourceInterfaceName, methodName: collectedMethod.method.name)
	if let existing = try project.witnessSlotImpls.get(key) 'alreadySelected'
		if not existing.equals(selected) 'disagrees'
			reportConflictingConformance(project, functionsByName: functionsByName, conformance: conformance, collectedMethod: collectedMethod, existing: existing, selected: selected, typeParamNames: typeParamNames, signatures: signatures)
		end 'disagrees'
		return
	end 'alreadySelected'

	project.witnessSlotImpls.upsert(key, value: selected)
end 'recordWitnessSlotImpl'

// E3111's sentence, anchored on the conforming type's NAME token like every other conformance diagnostic in
// this file. The two members are rendered through the SAME `renderMemberSignatures` an overload mismatch
// prints, for its reason: a registration name (`convert#Real`) is a key this compiler mints, and telling an
// author to go and look at it names something their source does not contain.
function reportConflictingConformance(project Project, functionsByName FunctionNameIndex, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, existing ByteArray, selected ByteArray, typeParamNames ByteArrayArray, signatures ProgramSignatures)
	var conflicting = ByteArrayArray.create()
	conflicting.push(existing)
	conflicting.push(selected)

	let interfaceName = String.from(collectedMethod.sourceInterfaceName)
	let rendered = renderMemberSignatures(project, conformance: conformance, method: collectedMethod.method, functionsByName: functionsByName, members: conflicting, typeParamNames: typeParamNames, signatures: signatures)
	reportPositioned(project, code: ErrorCode.semanticConflictingInterfaceConformance, message: "Type '{String.from(conformance.typeName)}' reaches interface '{interfaceName}''s requirement '{String.from(collectedMethod.method.name)}' by two routes that select different members: {rendered}. A conforming type has ONE witness table per interface and ONE address per method slot, so '{interfaceName}' must be conformed to exactly one way — bind its associated types once, either by removing the duplicate '{interfaceName}' entry or by not also reaching it through an interface that '{String.from(conformance.typeName)}' already implements", line: conformance.nameLine, column: conformance.nameColumn, filePath: conformance.filePath)
end 'reportConflictingConformance'

// The MISSING-method line for a requirement the conforming type declares nothing under, tagged
// `(from Parent)` when the requirement was inherited rather than the root interface's own. One home because
// two arms reach it — a name in no registry at all, and an overload set none of whose members this project
// still registers.
function pushMissingRequirement(missing StringArray, collectedMethod CollectedInterfaceMethod, rootInterfaceName ByteArray)
	let expected = formatInterfaceMethodSignature(collectedMethod.method)
	if collectedMethod.sourceInterfaceName.equals(rootInterfaceName) 'ownMethod'
		missing.push(expected)
		return
	end 'ownMethod'

	missing.push("{expected} (from {String.from(collectedMethod.sourceInterfaceName)})")
end 'pushMissingRequirement'

// The merged module's function for a member of an overload set. Every registration is followed by a module
// function AND a `funcSignatures` entry in the same `parseFunction`, and `overloadCandidates` has already
// dropped anything absent from the latter — so a member missing from the module is a merge-invariant
// violation, not a conformance miss.
//
// ⚠ **WHY THE IMPL SIDE IS READ OFF THE MODULE AND NOT OFF `funcSignatures`, WHICH THIS CHECK ALSO HOLDS.**
// The module function's `maxonParamTypes` / `maxonReturnType` are the REMAPPED (project-interner) types,
// while `funcSignatures`' param TYPES are deliberately left file-local until `resolveTypes` overwrites them
// (`ParseStaging.remapArtifact`) and so are not safe to render across files. Param NAMES go the other way:
// they are interner-free `ByteArray`s and are the one thing the module's `IrFunction` does not carry, which
// is why `conformanceImplSignature` below exists beside this and neither one subsumes the other.
function conformanceImplFunction(functionsByName FunctionNameIndex, name ByteArray) returns IrFunction
	return try functionsByName.funcNamed(name) otherwise panic("conformanceImplFunction: overload-set member '{String.from(name)}' is in funcSignatures but the merged module declares no function under that name")
end 'conformanceImplFunction'

// Every method records BOTH a module function and a `funcSignatures` entry (parseFunction), so a function
// present in the module without a signature is a merge-invariant violation, not a miss.
function conformanceImplSignature(project Project, name ByteArray) returns FuncSignature
	return try project.funcSignatures.get(name) otherwise panic("conformanceImplSignature: '{String.from(name)}' is in the module but has no funcSignatures entry")
end 'conformanceImplSignature'

// ⭐ **THE WRONG-SIGNATURE LINE FOR AN OVERLOADED NAME MUST NOT SPEAK AS THOUGH ONE CANDIDATE EXISTED
// (R10).** E3016's line is `<actual> (expected <required>)`, which is exactly right for a name declared
// once — and a lie for a set of two, where naming whichever member held the bare key told the author to
// change a method that may be perfectly correct. Both arms therefore say HOW MANY members carry the name and
// render all of the ones that matter: every candidate when none matches, and only the tied ones when several
// do (the others are irrelevant to an ambiguity).
function overloadMismatchLine(project Project, conformance ConformanceDecl, method InterfaceMethodSig, functionsByName FunctionNameIndex, candidates ByteArrayArray, matched ByteArrayArray, typeParamNames ByteArrayArray, signatures ProgramSignatures) returns String
	let expected = formatInterfaceMethodSignature(method)
	if matched.count() == 0 'noneMatches'
		return "no member named '{String.from(method.name)}' matches: {renderMemberSignatures(project, conformance: conformance, method: method, functionsByName: functionsByName, members: candidates, typeParamNames: typeParamNames, signatures: signatures)} (expected {expected})"
	end 'noneMatches'

	return "{matched.count()} members named '{String.from(method.name)}' match: {renderMemberSignatures(project, conformance: conformance, method: method, functionsByName: functionsByName, members: matched, typeParamNames: typeParamNames, signatures: signatures)} (expected {expected})"
end 'overloadMismatchLine'

// `members`' signatures as one comma-separated source string, each through the SAME `formatActualSignature`
// a single member's mismatch prints — so a set's line and a lone member's line cannot drift in format. Each
// is rendered under the REQUIREMENT's method name rather than its own registration name: `label#Code` is a
// key, not something an author wrote.
//
// The join is `Parser.appendCommaSeparated`, the ONE `", "` a diagnostic's list is punctuated with — a
// second accumulator here is how two messages listing the same kind of thing come to look different.
function renderMemberSignatures(project Project, conformance ConformanceDecl, method InterfaceMethodSig, functionsByName FunctionNameIndex, members ByteArrayArray, typeParamNames ByteArrayArray, signatures ProgramSignatures) returns String
	var rendered = ""
	for member in members 'each'
		rendered = appendCommaSeparated(rendered, item: formatActualSignature(project, methodName: method.name, conformingType: conformance.typeName, implFunc: conformanceImplFunction(functionsByName, name: member), implSig: conformanceImplSignature(project, name: member), typeParamNames: typeParamNames, signatures: signatures))
	end 'each'
	return rendered
end 'renderMemberSignatures'

// ⭐⭐ **THE THROWS RELATION BETWEEN AN INTERFACE METHOD AND ITS IMPL, CHECKED IN BOTH DIRECTIONS (P1.7a
// slice 2b-v).** A witness dispatch picks its ABI from the INTERFACE — a `throws` method is dispatched as
// the dual-register `witnessTryCall`, a non-throwing one as the single-register `witnessCall` — while the
// callee returns through the ABI its OWN declaration chose. The two must agree, and only this check can
// make them:
//
//   • **impl does not throw where the interface does** — the reference oracles' rule, wording and all
//     (`ValidateThrowsConformance` / v1's `validateThrowsConformance`). The `try` at the dispatch would
//     branch on an error-flag register the callee never wrote, i.e. on whatever the ABI left in R10.
//   • **impl throws where the interface does not** — ⚠ **shv2's OWN rule; NEITHER reference has it**, and
//     the divergence is deliberate. Both oracles check the relation only when the interface method declares
//     `throws`, so an impl that throws under a non-throwing interface method is accepted by both. In shv2
//     that program dispatches through the single-register `witnessCall` — the caller reads the primary
//     register and nothing reads the flag — so a thrown error is SILENTLY DISCARDED and the impl's
//     throw-path primary comes back as a real answer. That is precisely the defect this slice exists to fix,
//     arriving from the other side, and it is not diagnosable anywhere else: at the dispatch the compiler
//     sees only the interface, and at the impl it sees only the type.
//
//   • **the two thrown TYPES differ, UNLESS THE REQUIREMENT IS ABSTRACT** — ⚠ **shv2's OWN rule too;
//     NEITHER reference has it** (the bootstrap's
//     `ValidateThrowsConformance` asks only that the impl throws SOMETHING conforming to `Error`), and it is
//     the same divergence for the third time. Under MONOMORPHIZATION, which is what both oracles do, a `try`
//     is typed off the CALLEE's own clause, so a differing impl type is harmless — the caught error is
//     whatever the impl actually throws. Under shv2's DICTIONARY-PASSING there is no callee to ask: the `try`
//     at the dispatch types its `(e)` binding off the INTERFACE, so an impl throwing a different enum has its
//     ordinals decoded as the interface's. MEASURED, both halves: an impl throwing `OtherError.one` under an
//     interface declaring `throws DigestError` was caught as `DigestError.beta` (a silent wrong answer), and a
//     SCALAR-throwing impl under a BOXED-union interface clause made the `try` treat the ordinal as a box
//     pointer and SEGFAULT. `checkPropagateType`'s E3059 cannot see it — that check compares the INTERFACE's
//     clause against the enclosing function's, and those two agree in exactly this program.
//
// ⭐⭐ **THE THIRD RULE HAS ONE EXEMPTION, AND IT IS THE ONE `Error` EXISTS FOR (A1s).** `stdlib`'s own
// `interface Parsable` declares `static function fromString(input String) returns Self throws Error`, and
// every conformer in the corpus throws its own concrete error enum — an impl being MORE SPECIFIC than the
// requirement. The rule above is stated as "the same NAME", but the fact it protects is "the same DECODE":
// the `try` at the dispatch types its `(e)` binding off the requirement, so the impl's flag must be exactly
// what that binding reads back. For a requirement naming a concrete enum, same-decode IS same-name — one
// enum's ordinals are not another's. For a requirement naming an INTERFACE it is not: a marker interface
// declares no case, `match e` over it is E2015, and the binding is an opaque scalar with no ordinal to get
// wrong. `throwsRequirementIsAbstract` is where same-name stops standing in for same-decode.
//
// ⚠ **THE FLAG SHAPE STILL HAS TO AGREE, so the exemption reaches only a SCALAR impl error**
// (`requireImplErrorIsANarrowableError`). An abstract requirement is caught through the `ordinal + ErrorFlagOrdinalBias`
// ABI — `Parser.throwsTypeIsBoxedUnion` answers `false` for a name in no enum registry — while a
// payload-carrying union hands its error over as a heap BOX POINTER. MEASURED on the plain direct-call
// spelling of that pair (`function f() returns Code throws Error` throwing a boxed union): **exit 101, a
// leaked box, in shv2 AND in the C# oracle.** This rung refused the witness-dispatch route into it rather
// than opening a second door to it; the FIRST door was shut by A1s-throwsbox, whose E3113
// (`SemanticCheck.checkThrowsClausesNameDeclaredErrors`) requires a FUNCTION's own clause to name a declared
// enum or union. The two checks own disjoint sides — this one the relation between a requirement and its
// impl, that one a function's own clause — so an impl method reaches both, and reaches THIS one first
// (`checkConformance` runs before the pipeline) because only it can name the requirement being violated.
//
// Split on the INTERFACE's clause first: each side then asks a different question of the impl's, and both
// answers come out of a `match` on it rather than a boolean pair, so a clause is never re-extracted behind an
// `otherwise panic` that has to argue it cannot fire.
//
// ⚠ **THE AGREEING PATH ALLOCATES NOTHING, AND THAT IS WHY THE DECISION REPORTS RATHER THAN RETURNS.** The
// obvious shape here is a `ThrowsConformanceVerdict{agree, violated(message)}` returned up to one report site.
// It was written that way and MEASURED: the `agree` box is 16 bytes, paid once per CONFORMING METHOD of every
// program that declares any conformance, and scale-test read it straight off — +16 / +24 / +40 / +72 / +136 /
// +264 allocations across the six rungs (exactly 16 bytes each), landing OUTSIDE every per-phase bucket
// because `checkConformance` runs before the pipeline. Passing `project` down and reporting in the arm that
// decides costs one extra parameter and allocates only when a diagnostic is actually produced.
function validateThrowsConformance(project Project, signatures ProgramSignatures, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, implFunc IrFunction)
	match collectedMethod.method.throwsClause 'iface'
		none then requireImplDoesNotThrow(project, conformance: conformance, collectedMethod: collectedMethod, implClause: implFunc.throwsTypeName)
		throwing(required) then requireImplThrowsSameType(project, signatures: signatures, conformance: conformance, collectedMethod: collectedMethod, required: required, implClause: implFunc.throwsTypeName)
	end 'iface'
end 'validateThrowsConformance'

// The interface method declares NO throws clause: the impl may not declare one either (shv2's own rule).
function requireImplDoesNotThrow(project Project, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, implClause ThrowsClause)
	match implClause 'impl'
		none then break 'impl'
		throwing(declared) then reportThrowsViolation(project, conformance: conformance, message: "{throwsConformanceSubject(conformance.typeName, collectedMethod: collectedMethod)} throws '{declared}' but interface '{String.from(collectedMethod.sourceInterfaceName)}' declares it non-throwing — a witness dispatch of a non-throwing interface method reads no error flag, so the error would be silently dropped")
	end 'impl'
end 'requireImplDoesNotThrow'

// The interface method declares `throws required`: the impl must declare a throws clause, and it must name
// the SAME error type — the dispatch site types its caught error off `required`, whatever the impl throws.
function requireImplThrowsSameType(project Project, signatures ProgramSignatures, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, required String, implClause ThrowsClause)
	match implClause 'impl'
		// The oracles' wording verbatim.
		none then reportThrowsViolation(project, conformance: conformance, message: "{throwsConformanceSubject(conformance.typeName, collectedMethod: collectedMethod)} must throw '{required}' as required by interface '{String.from(collectedMethod.sourceInterfaceName)}'")
		throwing(declared) then requireSameErrorType(project, signatures: signatures, conformance: conformance, collectedMethod: collectedMethod, required: required, declared: declared)
	end 'impl'
end 'requireImplThrowsSameType'

// Both sides throw: they must name the same error type — unless the REQUIREMENT is ABSTRACT, which is the
// one narrowing the header above exempts (A1s). Split out because the comparison is a labelled `if`, which a
// `match` arm cannot hold inline (the shape `rejectIfDifferentThrows` is split for).
//
// ⚠ **THE EXEMPTION IS ASKED ONLY AFTER THE NAMES DISAGREE, and that placement is the whole of its cost.**
// An agreeing pair — every conformance in the corpus that does not narrow, and every one in the scale ladder
// — returns above without asking either question, so this rung adds no allocation to any program that
// compiled before it. Both questions below box a union (`InterfaceLookup`, `DeclaredEnum`), which the header
// of `validateThrowsConformance` records scale-test reading straight off a per-conforming-method box; here
// they are paid only where the old rule was about to produce a diagnostic.
function requireSameErrorType(project Project, signatures ProgramSignatures, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, required String, declared String)
	if declared.equals(required) 'sameErrorType'
		return
	end 'sameErrorType'

	if throwsRequirementIsAbstract(project, signatures: signatures, required: required) 'abstractRequirement'
		requireImplErrorIsANarrowableError(project, signatures: signatures, conformance: conformance, collectedMethod: collectedMethod, required: required, declared: declared)
		return
	end 'abstractRequirement'

	reportThrowsViolation(project, conformance: conformance, message: "{throwsConformanceSubject(conformance.typeName, collectedMethod: collectedMethod)} throws '{declared}' but interface '{String.from(collectedMethod.sourceInterfaceName)}' declares it 'throws {required}' — a witness dispatch types its caught error off the INTERFACE, so the impl's error would be decoded as '{required}'")
end 'requireSameErrorType'

// ⭐⭐ **DOES THE REQUIREMENT'S `throws` TYPE NAME AN INTERFACE RATHER THAN A CONCRETE ERROR — i.e. is there
// anything for the dispatch's `(e)` binding to decode WRONG (A1s)?** The sorting is
// `classifyThrowsClauseName`'s, below, where the reason each of its three answers exists is written down
// ONCE; what belongs here is only what this caller does with them. `undeclared` reads as NOT abstract, which
// is the whole point of the classifier's third box: a typo'd requirement must not buy the abstract
// requirement's narrowing, so it falls to the strict same-name rule and is refused by it.
function throwsRequirementIsAbstract(project Project, signatures ProgramSignatures, required String) returns bool
	return match classifyThrowsClauseName(project, signatures: signatures, name: required) 'kind'
		concreteError gives false
		abstractInterface gives true
		undeclared gives false
	end 'kind'
end 'throwsRequirementIsAbstract'

// ⭐⭐ **WHAT A `throws` CLAUSE NAME DENOTES — ONE CLASSIFIER, FOR THE TWO RULES THAT ASK (A1s-throwsbox
// review).** The two questions above and `SemanticCheck.requireThrowsClauseNamesADeclaredError`'s E3113 are
// about DIFFERENT things — this file owns the relation between a requirement's clause and its impl's, that
// one owns a function's own clause — but both begin by sorting one name into the SAME three boxes, and both
// were sorting it with their own copy of the two lookups. Nothing made the copies agree, and the way they
// would have come apart is silent: teach one of them that a `typealias` to an enum is concrete too, or that
// a user's own `enum Error` is special, and the impl side and the plain-function side would disagree about
// what an error type IS, with no compile error anywhere to say so. This project's signature bug, in the exact
// place A1s-throwsbox was written to remove one instance of it.
//
// The three boxes are exhaustive by construction, and each of the two conditions rules out a wrong answer the
// other cannot:
//
//   • **`concreteError` — it names a declared enum/union**, asked of the registry the catch DECODE itself
//     consults (`Parser.throwsTypeIsBoxedUnion` → `enumOf(name)`), so it is the only honest answer to "can
//     this be discriminated?". Asking that rather than testing the literal name `Error` is what keeps a
//     user's own `enum Error` — which the language accepts — from being read as abstract: for that program
//     the clause IS concrete. `containsEnum` and not `enumOf`, because no caller here needs a layout and
//     `enumOf` would box one to throw it away.
//   • **`abstractInterface` — it names an INTERFACE.** "Decodes nothing" alone would have made a TYPO
//     (`throws Bogus`, a name in no registry at all) indistinguishable from a deliberate abstract channel,
//     and the author's mistake would read as a licence. Abstractness is something a clause DECLARES, not
//     something it fails to be. `lookupInterface` answers for the synthesized `Error` and for a user
//     interface alike, off the one door every other conformance question in this file already asks through.
//   • **`undeclared` — neither**, which is a THIRD answer and not a shading of the second: a struct, a
//     ranged alias, a generic type parameter, a stdlib type shv2 does not declare, or a typo.
// The three — and only three — things a `throws` clause name can denote. See `classifyThrowsClauseName`.
export enum ThrowsClauseKind
	// A declared enum or union: the catch decode can discriminate its cases.
	concreteError
	// An interface: an abstract error channel, declaring no case to decode.
	abstractInterface
	// Neither — a struct, a ranged alias, a type parameter, a type shv2 does not declare, or a typo.
	undeclared
end 'ThrowsClauseKind'

export function classifyThrowsClauseName(project Project, signatures ProgramSignatures, name String) returns ThrowsClauseKind
	let key = name.toByteArray()
	if signatures.containsEnum(key) 'namesAConcreteError'
		return ThrowsClauseKind.concreteError
	end 'namesAConcreteError'

	return match lookupInterface(project.interfaces, name: key) 'iface'
		found gives ThrowsClauseKind.abstractInterface
		notFound gives ThrowsClauseKind.undeclared
	end 'iface'
end 'classifyThrowsClauseName'

// The impl's error must reach the dispatch through the ABI an abstract requirement is CAUGHT with — the
// scalar `ordinal + ErrorFlagOrdinalBias` flag. A payload-carrying union's flag is the heap box pointer
// itself (`Parser.emitThrowError` stamps `errorIsBoxed` off the thrown value and `lowerThrowError` writes the
// pointer verbatim), so under an abstract requirement the handler would subtract the bias from a pointer and
// never release the box. Read through the SAME `enumOf(name).isBoxed()` the catch decode reads, for that
// function's own reason: a boxed union must not be encoded as a pointer at one end and decoded as an ordinal
// at the other, and two spellings of "is it boxed?" is exactly how that comes to be true.
//
// ⚠⚠ **"NOT FOUND IN THE ENUM REGISTRY" IS NOT EVIDENCE THE FLAG IS SCALAR — IT IS THE COMPILER HAVING NO
// ANSWER, AND IT GETS ITS OWN REFUSAL (A1s review).** As first written this asked `enumOf(declared)` and
// read the `undeclared` arm as `false`, i.e. as "not boxed, therefore fine" — the PERMISSIVE reading of a
// memory-safety question, taken for a name the compiler could not resolve. MEASURED on the shipped rung:
// an impl declaring `throws Bogus`, a name in no registry at all, was ACCEPTED under `throws Error` and
// linked and ran, where the strict same-name rule this exemption relaxes had refused it.
//
// It is the same hazard `throwsRequirementIsAbstract`'s SECOND conjunct exists for, one side over: there
// the argument is that abstractness is something a requirement DECLARES rather than something it fails to
// be, so a typo must not read as a licence. The impl side owes the identical argument — a resolvable error
// type is something an implementation DECLARES — and did not make it. Both arms below therefore report;
// neither is silent, which is what CLAUDE.md's "no silent unhandled cases" asks of a `match` like this one.
//
// ⚠ It refuses only pairs the OLD rule already refused: a same-named pair returns from `requireSameErrorType`
// before either question is asked, so nothing that compiled before A1s can reach here. (`throws Bogus` on a
// PLAIN function was accepted when this was written; A1s-throwsbox's E3113 closed that gap, and this arm
// still owns the IMPL-side spelling because it alone can name the requirement the impl is violating.)
function requireImplErrorIsANarrowableError(project Project, signatures ProgramSignatures, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, required String, declared String)
	match signatures.enumOf(declared.toByteArray()) 'implError'
		declared(layout) then requireImplErrorConformsAndIsScalar(project, conformance: conformance, collectedMethod: collectedMethod, required: required, declared: declared, layout: layout)
		undeclared then reportThrowsViolation(project, conformance: conformance, message: "{throwsConformanceSubject(conformance.typeName, collectedMethod: collectedMethod)} throws '{declared}' but interface '{String.from(collectedMethod.sourceInterfaceName)}' declares it 'throws {required}', and '{declared}' names no declared enum or union — the narrowing an abstract requirement permits is granted only to an error type whose flag SHAPE the compiler can see, and an unresolvable name is a mistake rather than a licence. Declare '{declared}', or name '{required}' itself")
	end 'implError'
end 'requireImplErrorIsANarrowableError'

// ⭐⭐ **AN ABSTRACT REQUIREMENT NARROWS TO A CONFORMER, NOT TO ANY ENUM AT ALL (A1s wave 2).** The narrowing
// an abstract `throws Error` permits is "an error type", and this is the half that says WHICH: the impl's
// enum must DECLARE `implements <the requirement's interface>`. Without it the exemption read `throws Error`
// as `throws anything`, a strictly weaker rule than the same-name one it replaced.
//
// ⚠ **MEASURED AGAINST THE ORACLE, NOT ARGUED**: `enum NotAnError { Bad = 1 }`, declaring no conformance,
// used as a `Parsable.fromString`'s `throws` type is refused by the bootstrap with **`error E3016: … Method
// 'Value.fromString' throws 'NotAnError' which does not conform to Error`**, and was ACCEPTED here — it
// compiled, linked and ran. `specs-shv2/parsable-interface.md`'s `error.throws-non-error-type` is the pin,
// and it names why the gap shipped with wave 1: the case that catches it could not be enabled until the
// stdlib module declaring `interface Parsable` was loadable.
//
// ⚠ **THE ANSWER COMES OFF THE ENUM'S OWN LAYOUT, NOT OFF `project.conformances`.** A `ConformanceDecl` is
// recorded only by `Parser.parseTypeDeclaration`; an `enum`/`union` `implements` clause is a different door
// (`readOptionalImplementsClause`) and files its names on the layout instead, because an enum has no METHODS
// for `checkConformance` to check against a requirement. Asking `project.conformances` here answers `false`
// for EVERY error enum in the corpus — measured, on the first cut of this check: all five `Parsable`
// conformers were refused, each naming its own `implements Error`.
//
// ⚠ **AND IT IS ASKED AFTER RESOLVABILITY, WHICH IS THE DIAGNOSTIC AND NOT AN ORDERING PREFERENCE.** A name
// in no registry is refused by the arm above with the message that says exactly that; telling that author
// their type "does not conform to Error" would blame the wrong thing about a type that does not exist.
// `error.throws-unresolvable-impl-type-under-abstract-requirement` is the pin, and it caught this order
// being wrong.
//
// The wording is the oracles' verbatim, exactly as `requireImplThrowsSameType`'s missing-clause arm is.
function requireImplErrorConformsAndIsScalar(project Project, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, required String, declared String, layout EnumLayout)
	if not layout.declaresConformanceTo(required.toByteArray()) 'doesNotConform'
		reportThrowsViolation(project, conformance: conformance, message: "{throwsConformanceSubject(conformance.typeName, collectedMethod: collectedMethod)} throws '{declared}' which does not conform to {required}")
		return
	end 'doesNotConform'

	refuseBoxedImplError(project, conformance: conformance, collectedMethod: collectedMethod, required: required, declared: declared, implIsBoxed: layout.isBoxed())
end 'requireImplErrorConformsAndIsScalar'

// The boxed half of the question above, split out because the verdict is a labelled `if` — the shape a
// `match` arm cannot hold inline, and the same reason `requireSameErrorType` is split out of
// `requireImplThrowsSameType`. Takes the ANSWER rather than the layout so the payload binding stays in the
// one arm that produced it.
function refuseBoxedImplError(project Project, conformance ConformanceDecl, collectedMethod CollectedInterfaceMethod, required String, declared String, implIsBoxed bool)
	if not implIsBoxed 'scalarFlag'
		return
	end 'scalarFlag'

	reportThrowsViolation(project, conformance: conformance, message: "{throwsConformanceSubject(conformance.typeName, collectedMethod: collectedMethod)} throws '{declared}' but interface '{String.from(collectedMethod.sourceInterfaceName)}' declares it 'throws {required}', which declares no case to decode — a witness dispatch catches such a requirement through the SCALAR error-flag ABI, while a payload-carrying union is handed over as a heap box pointer that would be decoded as an ordinal and never released. Throw a payload-free enum, or declare the requirement as '{declared}' itself")
end 'refuseBoxedImplError'

// The ONE report site for every throws-conformance violation. Not a pass-through: it derives four of
// `reportPositioned`'s six arguments from `conformance` (the code, and the position the `implements` clause
// anchors on), which each arm would otherwise spell out separately — and it has already earned that once:
// A1s added a FOURTH violation (a boxed impl error under an abstract requirement) and spelled none of them.
function reportThrowsViolation(project Project, conformance ConformanceDecl, message String)
	reportPositioned(project, code: ErrorCode.semanticPartialInterfaceImpl, message: message, line: conformance.nameLine, column: conformance.nameColumn, filePath: conformance.filePath)
end 'reportThrowsViolation'

// `Method 'Type.method'` — the subject all three throws-conformance diagnostics open with, spelled once.
function throwsConformanceSubject(typeName ByteArray, collectedMethod CollectedInterfaceMethod) returns String
	return "Method '{String.from(typeName)}.{String.from(collectedMethod.method.name)}'"
end 'throwsConformanceSubject'

// Does the impl method's signature match the interface method's? Instance methods carry `__self` at
// position 0, dropped on both sides; a `Self` in the interface substitutes the conforming type. Each side's
// type is run through `canonicalTypeName` before comparing, so a ranged alias matches by its underlying
// primitive (shv2's actual type identity) rather than by its source name — the message still prints the name.
//
// ⚠ **`method` IS ALREADY ASSOCIATED-TYPE-SUBSTITUTED and this function must not do it again** — see
// `collectInterfaceMethods`. What it still substitutes is `Self`, and that ASYMMETRY WITH THE MESSAGE IS
// DELIBERATE AND PINNED: a `Self` requirement compares against the conforming type but PRINTS as `Self`
// (`specs-shv2/comparable.md` pins `- compare(other Self) returns Ordering` and
// `(expected compare(other Self) returns Ordering)`), which is the bootstrap's split too — its comparison
// maps the interface name through `ResolveInterfaceTypeName` while its message formatter is handed only the
// associated-type dict. `Self` reads better in a diagnostic than the reader's own type name repeated back;
// an associated type does not, because its name is meaningless outside the interface that declared it.
function signatureMatches(project Project, method InterfaceMethodSig, conformingType ByteArray, implFunc IrFunction, implSig FuncSignature, typeParamNames ByteArrayArray, signatures ProgramSignatures) returns bool
	// ⭐ **A `static` REQUIREMENT IS MET BY A STATIC MEMBER, AND AN INSTANCE ONE BY AN INSTANCE MEMBER (R9).**
	// The two have different ABIs — an instance method takes `__self` at position 0 — and the witness slot is
	// stamped with whichever the type declared, so an instance impl under a static requirement would be
	// dispatched with no receiver in the register it reads `self` from. Neither reference has this rule: both
	// skip a present static outright, so neither can see the disagreement. `takesReceiver()` (does the
	// signature declare `__self`?) is exactly "is an instance method", so it is also what the parameter
	// comparison below indexes by — one fact, asked once.
	let implIsStatic = not implSig.takesReceiver()
	if method.isStatic != implIsStatic 'receiverKindDiffers'
		return false
	end 'receiverKindDiffers'

	let selfOffset = 0 if implIsStatic else 1
	if method.paramNames.count() != implFunc.maxonParamTypes.count() - selfOffset 'arityDiffers'
		return false
	end 'arityDiffers'

	for i in 0 upto method.paramNames.count() 'eachParam'
		let expected = substituteSelf(try method.paramTypeNames.get(i) otherwise panic("signatureMatches: paramTypeNames.get OOB at {i}"), conformingType: conformingType)
		let actual = renderDeclaredTypeName(try implFunc.maxonParamTypes.get(i + selfOffset) otherwise panic("signatureMatches: maxonParamTypes.get OOB at {i + selfOffset}"), declarationName: conformingType, typeParamNames: typeParamNames, typeNames: project.typeNames, signatures: signatures)
		if not canonicalTypeName(project, name: expected).equals(canonicalTypeName(project, name: actual)) 'paramDiffers'
			return false
		end 'paramDiffers'
	end 'eachParam'

	let expectedReturn = substituteSelf(method.returnTypeName, conformingType: conformingType)
	return canonicalTypeName(project, name: expectedReturn).equals(canonicalTypeName(project, name: renderReturnType(project, returnType: implFunc.maxonReturnType, conformingType: conformingType, typeParamNames: typeParamNames, signatures: signatures)))
end 'signatureMatches'

// ⭐ **COLLAPSE A RENDERED TYPE-NAME TO THE IDENTITY shv2'S TYPE SYSTEM ACTUALLY COMPARES BY.** A ranged
// typealias resolves to its UNDERLYING primitive — `resolveNamedType` returns `alias.underlying` and DROPS
// the range, so two aliases over the same primitive (even over different RANGES) are one type: `takesA` with
// a `int(0 to 100)` parameter accepts a `int(0 to 200)` argument. The E3016 message still prints the SOURCE
// spelling (only this COMPARISON canonicalizes), so a valid conformance whose interface and impl reach a
// shared type through DIFFERENT alias names is not a spurious wrong-signature. Reads the SAME
// `project.typeAliases`/`.underlying` `resolveNamedType` reads, so it cannot diverge from resolution for the
// plain-alias case — the concrete parameter/return types this slice supports. A non-alias name (a struct, a
// primitive keyword, `Self`-substituted, `void`) is not in the registry and passes through unchanged.
// ⚠ Bare-name for `resolveNamedType`'s reason, and it must MATCH `resolveNamedType`: this comparison
// exists to agree with resolution, and it asks through the same door — which hands back `underlying`
// and cannot hand back the range. Scoping it here while resolution stayed bare is precisely the
// divergence the header above says must not happen.
function canonicalTypeName(project Project, name ByteArray) returns ByteArray
	if let underlying = try project.typeAliases.underlyingInAnyFile(name) 'rangedAlias'
		return maxonTypeName(underlying, typeNames: project.typeNames).toByteArray()
	end 'rangedAlias'

	return name
end 'canonicalTypeName'

// The impl method's signature as a source string — `process(value Float) returns Integer`. Param NAMES
// come from `funcSignatures` (interner-free); param TYPES from the module's REMAPPED `maxonParamTypes`.
// Both are rendered to the same source-string columns the interface stores, then handed to the ONE
// signature assembler — so an actual and an expected signature cannot drift in format.
function formatActualSignature(project Project, methodName ByteArray, conformingType ByteArray, implFunc IrFunction, implSig FuncSignature, typeParamNames ByteArrayArray, signatures ProgramSignatures) returns String
	let implIsStatic = not implSig.takesReceiver()
	let selfOffset = 0 if implIsStatic else 1
	var paramNames = ByteArrayArray.create()
	var paramTypes = ByteArrayArray.create()
	for i in selfOffset upto implFunc.maxonParamTypes.count() 'eachParam'
		paramNames.push(try implSig.paramNames.get(i) otherwise panic("formatActualSignature: paramNames.get OOB at {i}"))
		paramTypes.push(renderDeclaredTypeName(try implFunc.maxonParamTypes.get(i) otherwise panic("formatActualSignature: maxonParamTypes.get OOB at {i}"), declarationName: conformingType, typeParamNames: typeParamNames, typeNames: project.typeNames, signatures: signatures))
	end 'eachParam'
	return assembleMethodSignature(methodName, paramNames: paramNames, paramTypes: paramTypes, returnType: renderReturnType(project, returnType: implFunc.maxonReturnType, conformingType: conformingType, typeParamNames: typeParamNames, signatures: signatures), isStatic: implIsStatic)
end 'formatActualSignature'

// An interface method's signature as a source string — `process(value Integer) returns Integer` — from
// its stored (already source-rendered, already associated-type-substituted) columns, through the same
// assembler the impl side uses. It performs NO substitution of its own, which is the whole point: the
// sentence and the verdict read one string (`collectInterfaceMethods`).
function formatInterfaceMethodSignature(method InterfaceMethodSig) returns String
	return assembleMethodSignature(method.name, paramNames: method.paramNames, paramTypes: method.paramTypeNames, returnType: method.returnTypeName, isStatic: method.isStatic)
end 'formatInterfaceMethodSignature'

// ⭐ **THE ONE `[static ]name(p0 t0, p1 t1) returns ret` SPELLING**, shared by the interface (expected) and
// impl (actual) renderers so the two halves of a wrong-signature message cannot drift in format.
// `paramNames` and `paramTypes` are parallel source-string columns.
//
// The `static ` prefix is what makes a RECEIVER-KIND disagreement readable (R9): without it a static
// requirement met by an instance method of the same shape renders `tag() returns Code (expected tag()
// returns Code)` — a rejection whose two halves are the identical string, telling the author to change
// something that already looks right. It costs nothing on every other message, because until R9 no static
// requirement could reach a diagnostic at all.
function assembleMethodSignature(name ByteArray, paramNames ByteArrayArray, paramTypes ByteArrayArray, returnType ByteArray, isStatic bool) returns String
	var rendered = "static {String.from(name)}(" if isStatic else "{String.from(name)}("
	for i in 0 upto paramNames.count() 'eachParam'
		if i > 0 'separator'
			rendered = "{rendered}, "
		end 'separator'
		let paramName = try paramNames.get(i) otherwise panic("assembleMethodSignature: paramNames.get OOB at {i}")
		let paramType = try paramTypes.get(i) otherwise panic("assembleMethodSignature: paramTypes.get OOB at {i}")
		rendered = "{rendered}{String.from(paramName)} {String.from(paramType)}"
	end 'eachParam'
	return "{rendered}) returns {String.from(returnType)}"
end 'assembleMethodSignature'

// Render an impl method's RETURN as a source string — `void` for a void return, else the type through the
// shared renderer. Returns a ByteArray so it feeds BOTH the string comparison in `signatureMatches` and
// the message assembly in `formatActualSignature` without a re-conversion at either.
function renderReturnType(project Project, returnType MaxonReturnType, conformingType ByteArray, typeParamNames ByteArrayArray, signatures ProgramSignatures) returns ByteArray
	return match returnType 'r'
		void gives InterfaceVoidTypeName
		value(inner) gives renderDeclaredTypeName(inner, declarationName: conformingType, typeParamNames: typeParamNames, typeNames: project.typeNames, signatures: signatures)
	end 'r'
end 'renderReturnType'

// Substitute the conforming type for an interface's `Self` — every other spelling passes through. The
// interface renders `Self` for a receiver-typed result/parameter; the conforming type's own method spells
// the concrete type, so this is what lets `returns Self` match `returns Point`.
function substituteSelf(typeName ByteArray, conformingType ByteArray) returns ByteArray
	if typeName.equals(InterfaceSelfTypeName) 'isSelf'
		return conformingType
	end 'isSelf'
	return typeName
end 'substituteSelf'

// Join `  - item` lines with newlines — the bulleted detail block of an E3016 message.
function joinBulletedLines(items StringArray) returns String
	var rendered = ""
	for i in 0 upto items.count() 'each'
		if i > 0 'separator'
			rendered = "{rendered}\n"
		end 'separator'
		rendered = "{rendered}  - {try items.get(i) otherwise panic("joinBulletedLines: items.get OOB at {i}")}"
	end 'each'
	return rendered
end 'joinBulletedLines'
