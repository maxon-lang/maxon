// Debug/DebugStreamDecoder.maxon — the DebugStream ring CONSUMER: create the segment, seed it, and turn
// the bytes a traced child writes into it back into lines.
//
// ⭐⭐ **IT IS THE OTHER END OF ONE FROZEN FORMAT, AND IT SPELLS NO NUMBER OF ITS OWN.** Every offset,
// shift, mask and event code is imported from `Compiler/Runtime/DebugStreamRuntime`, which is where the
// PRODUCER reads them too — one registry, two ends. A restated constant here would not fail to build; it
// would make the trace LIE, which is the failure the single registry exists to make impossible.
//
// ⚠ **IT DECODES CODES shv2 HAS NO PRODUCER FOR** — the sched and dbg families, the raw-allocation pair,
// the transfer/realloc/COW distinctions. The binary in front of it may have been built by the BOOTSTRAP,
// whose memory manager and scheduler write all of them, so a decoder that only knew shv2's four mm codes
// would refuse a trace it was pointed at rather than read it.
//
// ⭐⭐ **THE COMMIT PROTOCOL IS WHY THE SCAN AND THE COPY ARE TWO STEPS.** An entry becomes VISIBLE (below
// `write_cursor`) when `__ds_reserve` publishes it, and READABLE (carrying `DsEntryCommittedBit`) only
// after its payload has been written outside the ring lock. So "below write_cursor" does not mean
// "readable": the scan stops at the first entry without the bit and never looks past it, because entries
// are consumed in ring order and skipping an uncommitted head would lose it. Without that distinction the
// reference measured 0 events decoded, 283221 dropped and 5290 abandoned from a producer that had exited
// cleanly — every number of it a fiction.
//
// ⚠⚠ **NO MEMORY BARRIER OP EXISTS AT THIS TIER, AND ON A WEAKLY-ORDERED HOST THAT IS A REAL GAP.** On
// x64 a plain store IS a release store and the commit bit cannot be observed before the payload under it.
// AArch64 gives no such guarantee, so a producer and a consumer on two CORES could in principle see the
// bit before the bytes. What holds here is narrower and worth stating rather than assuming: the reserve
// and the commit are separated by the ring LOCK the producer takes, and the consumer re-reads
// `write_cursor` on every drain — so the window is a single entry, and the scan already stops dead at the
// first uncommitted one. A fence is owed at BOTH ends the day this is driven hard enough to matter.
//
// ⛔ **THE SEGMENT MUST BE FULLY SEEDED BEFORE THE CHILD IS SPAWNED.** `__ds_init` checks the magic,
// compares the monitor's version, and caches `buffer_size` and `start_timestamp` before it arms
// `__ds_base` — so a child that starts against a half-written header attaches to nothing and traces
// nothing, silently. `create` seeds; `MonitorCommand` spawns after it returns.
#if compiler(shv2) and (os(Windows) or os(Macos))

	// One byte of the wire's `event_type` field.
	typealias EventCode = int(0 to 255)

	// An index into one of the two interned-name tables. u16 on the wire, which is what bounds it.
	typealias NameIndex = int(0 to 65535)

	// A table's declared entry count — the same width as an index into it, and the reason a blob cannot
	// describe more names than an event can point at.
	typealias NameCount = int(0 to 65535)

	// An ABSOLUTE byte position in the ring's write sequence — not a position inside the 2 MB buffer, which
	// wraps. The producer's cursors are this, and the difference between two of them is what is pending.
	typealias RingPosition = int(0 to i64.max)

	// How many bytes one drain takes out of the ring: the distance from the read cursor to the end of the
	// committed prefix. A LENGTH and never a position — the two meet only at the subtraction that makes it.
	typealias SpanByteCount = int(0 to i64.max)

	// One entry's total size, header included. Never zero: `__ds_reserve` never reserves one and every family
	// has at least a header, so a zero is ring corruption rather than an empty entry.
	typealias EntryByteCount = int(1 to 65535)

	// How deeply the DEPTH_INC / DEPTH_DEC markers have nested the trace at this event.
	module typealias TraceDepth = int(0 to u32.max)

	// Milliseconds since the header's `start_timestamp`, the delta each entry carries.
	typealias TraceTimestampMs = int(0 to u32.max)

	// A count of events or entries. The producer's own counters are i64 words in the segment header.
	module typealias EventTally = int(0 to i64.max)

	module typealias DecodedEventArray = Array with DecodedEvent

	// ⭐ **WHICH PAIR OF HOST CALLS BACKS A SEGMENT HERE — for the refusal message and for nothing else.**
	// `stdlib/SharedMemory.maxon` is the door and it says the same thing in its own vocabulary; this is the
	// spelling a reader has to go and look up, which is a per-HOST fact.
	#if os(Windows)
		let SegmentCreateCallName = "CreateFileMappingA"
		let SegmentMapCallName = "MapViewOfFile"
	#else
		let SegmentCreateCallName = "shm_open"
		let SegmentMapCallName = "mmap"
	#endif

	// The stem of the segment name. It carries this process's id and a nonce, because twelve spec-test workers
	// each spawn a monitor and a colliding name would map two of them onto ONE ring — `CreateFileMappingA`
	// hands back the existing section rather than failing, and a POSIX create unlinks the name first.
	//
	// ⚠ **THE WHOLE NAME MUST FIT 31 BYTES**, which is Darwin's `PSHMNAMLEN` (measured: a 32-byte name is
	// ENAMETOOLONG). This stem plus a five-digit pid, an underscore and eight hex digits is 23.
	let SegmentNamePrefix = "maxon_ds_"

	// The nonce's width: the low 32 bits of the high-resolution counter, rendered as 8 hex digits. It is
	// belt-and-braces beside the process id, which is already unique among LIVING processes — a monitor whose
	// child outlives it is the case the id alone would not cover.
	let SegmentNonceMask = 0xFFFFFFFF

	// How many bytes of the mapping the ring's own buffer occupies, and the AND that takes a ring position
	// down to an offset within it. The ring is a power of two, which is what makes the modulo one instruction
	// at both ends.
	let RingByteMask = DsRingBytes - 1

	// The two interned-name fields an event carries, and what an unresolvable index renders as. MXDS_TAGS
	// holds mm allocation TYPE names; MXDS_STRS holds the names `__DebugStream` interned at compile time.
	let TagFieldName = "tag"
	let LogNameFieldName = "name"

	// The bytes a LOG_TEXT payload is trimmed of. A logging call site writes its own terminator and the wire
	// carries it; a line the consumer prints supplies its own.
	let CarriageReturnByte = 13 as Byte
	let LineFeedByte = 10 as Byte

	// What separates the family names in the usage line's `mm|sched|log`.
	let FamilyChoiceSeparator = "|"

	// ⭐ What every line this consumer authors ABOUT THE RING carries — the schema refusal and the closing
	// summary — so a reader can split them from the child's own stderr, which is exactly what the spec
	// harness does (`SpecTestRunner.childStderrOf`).
	module let DebugStreamLinePrefix = "[debugstream]"

	// ⭐ **THE THREE SELECTABLE FAMILIES, AND THE ENUM *IS* BOTH THE ACCEPTED SET AND ITS SPELLING.** A case's
	// `.name` is the `--filter=` value, and `allCases` is the usage line's list in this order — so accepting a
	// family, advertising it and naming it in a report are one fact. They are CONTIGUOUS code ranges (see the
	// event table in `DebugStreamRuntime`), which is what lets `familyOf` be a pair of comparisons rather than
	// a roster kept in step with that table by hand.
	module enum EventFamily
		mm
		sched
		log
	end 'EventFamily'

	// Which family a consumer asked for. A union rather than an empty-string default, because "every family"
	// and "a family whose name I could not resolve" are different answers and only one of them is legal.
	module union FamilyFilter
		all
		only(family EventFamily)
		unknown(spelling String)
	end 'FamilyFilter'

	// One decoded entry. The timestamp and the depth travel as DATA rather than baked into `text`, because
	// what a FACE puts around a line is its own: the monitor prefixes the delta and indents by depth.
	module type DecodedEvent
		module let timestampMs as TraceTimestampMs
		module let depth as TraceDepth
		module let text as String

		module static function create(timestampMs TraceTimestampMs, depth TraceDepth, text String) returns DecodedEvent
			return Self{timestampMs: timestampMs, depth: depth, text: text}
		end 'create'
	end 'DecodedEvent'

	// ⭐ How a `drain` ended. The four are DISTINCT because they demand different next moves, and conflating
	// the last two is what lets a consumer spin forever on an entry nobody will ever commit.
	module union DrainOutcome
		// Entries were decoded, or an abandoned one was stepped over. Call again immediately.
		decoded(events DecodedEventArray)
		// Nothing is decodable and the producer is still alive: either the ring is empty, or its head entry is
		// reserved and its producer is mid-payload. Waiting is the only correct move.
		idle
		// Nothing is decodable and the producer is GONE with the ring drained. There will be no more.
		finished
		// The producer does not speak this schema. Nothing was decoded and nothing ever will be.
		schemaMismatch(message String)
	end 'DrainOutcome'

	// Why a decoder could not be built. Both arms stop the run before a child is ever spawned.
	module union DecoderError implements Error
		segmentUnavailable(reason SharedMemoryError)
		nameTablesUnreadable(reason DataSectionReadError)

		/// Follows `PeReadError.displayReason`'s convention so every refusal this command prints reads the
		/// same way whatever went wrong.
		module function displayReason() returns String
			return match self 'k'
				segmentUnavailable(reason) gives "could not create the shared segment the trace travels in ({sharedMemoryReason(reason)})"
				nameTablesUnreadable(reason) gives "could not read the interned name tables out of the target ({reason.displayReason()})"
			end 'k'
		end 'displayReason'
	end 'DecoderError'

	// `SharedMemoryError` carries no renderer of its own — it is two arms and no payload — so the sentence is
	// written here, where the refusal is.
	//
	// ⛔ **IT NAMES THE CALL THAT ACTUALLY REFUSED, AND THE TWO HOSTS DO NOT MAKE THE SAME ONE.** The whole
	// value of this line is that a reader knows which manual page to open; a host lane reporting Win32's
	// spelling would send them to the wrong one.
	function sharedMemoryReason(reason SharedMemoryError) returns String
		return match reason 'k'
			createFailed gives "{SegmentCreateCallName} refused the section"
			mapFailed gives "{SegmentMapCallName} refused the view"
		end 'k'
	end 'sharedMemoryReason'

	module type DebugStreamDecoder
		var segment as SharedSegment
		let filter as FamilyFilter
		// The two interned-name tables, read out of the TARGET's `.symtab` at creation. They travel in the
		// executable rather than in the ring, which is what keeps an mm event 24 fixed bytes.
		let tagNames as StringArray
		let logNames as StringArray
		// How far the ring has been consumed, as an absolute position. Everything emitted started below it.
		var readCursor as RingPosition
		// The DEPTH_INC / DEPTH_DEC nesting level, carried ACROSS drains: the markers that opened a level and
		// the events inside it need not arrive in one batch.
		var depth as TraceDepth
		// Entries whose producer died between `__ds_reserve` and `__ds_commit`. Their payload will never be
		// written, so they are unreadable — but they are counted and reported, never silently dropped, because
		// a missing event is exactly the lie the commit protocol prevents.
		var abandonedEntries as EventTally

		/// Create the ring segment, seed its header, and read `target`'s interned name tables.
		///
		/// The caller hands `segmentName()` to the child through `DsActivationEnvVar`. The name tables are read
		/// HERE rather than lazily: an executable whose tables cannot be located is not one with no names in
		/// it, it is a run that would print `tag=1` for every event and a golden that would fail without ever
		/// saying why.
		module static function create(target FilePath, filter FamilyFilter) returns DebugStreamDecoder throws DecoderError
			let segment = try SharedSegment.create(mintSegmentName(), bytes: DsSharedMemoryBytes) otherwise (e) 'noSegment'
				throw DecoderError.segmentUnavailable(e)
			end 'noSegment'

			seedHeader(segment)

			// ⭐ **THE FORMAT IS THE HOST'S, BECAUSE THIS COMMAND IS ABOUT TO RUN THE FILE.** `readLinkedSection`
			// keys off the target a binary was BUILT for, which the monitor is never told; what it is told is that
			// the child must be spawnable here, and a spawnable binary is in this host's format.
			let symdata = try readLinkedSection(target, target: detectHostTarget(), section: LinkedSectionKind.internedNames) otherwise (e) 'noTables'
				segment.close()
				throw DecoderError.nameTablesUnreadable(e)
			end 'noTables'

			return Self{segment: segment, filter: filter, tagNames: nameBlobIn(symdata, magic: DsTagBlobMagic), logNames: nameBlobIn(symdata, magic: DsStrBlobMagic), readCursor: 0, depth: 0, abandonedEntries: 0}
		end 'create'

		/// The value the child reads from `DsActivationEnvVar` to find this ring.
		module function segmentName() returns String
			return segment.segmentName()
		end 'segmentName'

		/// The producer's own counters, read straight from the segment header — valid at any time, and final
		/// once the producer has exited.
		module function totalEvents() returns EventTally
			return headerCounterAt(DsOffTotalEvents)
		end 'totalEvents'

		module function droppedEvents() returns EventTally
			return headerCounterAt(DsOffDroppedEvents)
		end 'droppedEvents'

		module function peakUsed() returns EventTally
			return headerCounterAt(DsOffPeakUsed)
		end 'peakUsed'

		/// Entries the producer reserved and died before committing. The decoder's OWN count — the producer
		/// cannot report an entry it never finished.
		module function abandonedCount() returns EventTally
			return abandonedEntries
		end 'abandonedCount'

		/// Unmap the view and release the section.
		module function close()
			segment.close()
		end 'close'

		/// ⭐ Decode the committed prefix of the ring and release the consumed span back to the producer.
		///
		/// ⛔ `producerExited` MUST be sampled BEFORE this call reads the cursors. If the producer is already
		/// gone by that sample, every store it will ever make is in the ring and the cursors read here are
		/// FINAL. The other order lets a last event land after the check and be lost.
		module function drain(producerExited bool) returns DrainOutcome
			let writeCursor = segment.readWord(DsOffWriteCursor as SegmentOffset) as RingPosition

			// Before a single entry is decoded: does the target even speak this schema? A mismatch is not a
			// trace with a gap in it, it is a trace that is quietly and entirely fictional.
			match producerSchema(segment, writeCursor: writeCursor) 'schema'
				agreed then break 'schema'
				refused(message) then return DrainOutcome.schemaMismatch(message)
			end 'schema'

			let committedEnd = scanCommittedPrefix(writeCursor)
			if committedEnd == readCursor 'nothingReadable'
				return stalledOutcome(producerExited, writeCursor: writeCursor)
			end 'nothingReadable'

			let pending = (committedEnd - readCursor) as SpanByteCount
			let copy = copyRingSpan(readCursor, byteCount: pending)

			// Published the instant the copy is taken: the span is the producer's again, and holding it back
			// is how a producer starts DROPPING events into a ring the consumer has already read.
			readCursor = committedEnd
			segment.writeWord(DsOffReadCursor as SegmentOffset, value: readCursor as SegmentWord)

			return DrainOutcome.decoded(walkEntries(copy, byteCount: pending))
		end 'drain'

		// What a drain answers when the committed prefix is empty. Three different facts, and the last is the
		// one a naive reader hangs on.
		function stalledOutcome(producerExited bool, writeCursor RingPosition) returns DrainOutcome
			if not producerExited 'stillWriting'
				return DrainOutcome.idle
			end 'stillWriting'

			if readCursor >= writeCursor 'ringDrained'
				return DrainOutcome.finished
			end 'ringDrained'

			// The producer died between reserving the head entry and committing it. Nothing will ever fill that
			// payload, so waiting for it is a HANG. Its HEADER is intact — reserve wrote it before releasing
			// `write_cursor` — so step over it and keep draining what is behind it, which may well be whole.
			abandonedEntries = abandonedEntries + 1
			readCursor = readCursor + (entrySizeOf(entryHeaderAt(readCursor), at: readCursor) as RingPosition)
			segment.writeWord(DsOffReadCursor as SegmentOffset, value: readCursor as SegmentWord)

			return DrainOutcome.decoded(DecodedEventArray.create())
		end 'stalledOutcome'

		// How far below `writeCursor` the ring is actually READABLE: the end of the run of entries, from
		// `readCursor` on, that carry the commit bit. It stops at the first that does not and never looks past.
		function scanCommittedPrefix(writeCursor RingPosition) returns RingPosition
			var cursor = readCursor
			while cursor < writeCursor 'eachEntry'
				let header = entryHeaderAt(cursor)
				if (header and DsEntryCommittedBit) == 0 'reservedNotCommitted'
					break
				end 'reservedNotCommitted'

				cursor = cursor + (entrySizeOf(header, at: cursor) as RingPosition)
			end 'eachEntry'

			return cursor
		end 'scanCommittedPrefix'

		// The packed header of the entry at `cursor`. An entry never straddles the end of the ring —
		// `__ds_reserve` writes a padding entry rather than let one wrap — so this single read is contiguous.
		function entryHeaderAt(cursor RingPosition) returns MachineWord
			return segment.readWord(ringSlotOf(cursor)) as MachineWord
		end 'entryHeaderAt'

		// ⭐ The committed span, copied out of the ring in at most two pieces. The second exists because the
		// span may WRAP: the ring is a circle and the copy is a line.
		function copyRingSpan(from RingPosition, byteCount SpanByteCount) returns ByteArray
			let start = from and RingByteMask
			let toEnd = (DsRingBytes - start) as SpanByteCount
			let firstChunk = byteCount if byteCount < toEnd else toEnd

			var copy = segment.copyOut(ringSlotOf(from), byteCount: firstChunk as SegmentByteCount)
			if firstChunk < byteCount 'wrapped'
				copy.append(segment.copyOut(DsHeaderBytes as SegmentOffset, byteCount: (byteCount - firstChunk) as SegmentByteCount))
			end 'wrapped'

			return copy
		end 'copyRingSpan'

		// Where in the MAPPING the entry at `cursor` sits: past the header, at the cursor's position modulo the
		// ring. Both readers of a ring position go through this, so the header offset cannot be forgotten at one
		// of them.
		function ringSlotOf(cursor RingPosition) returns SegmentOffset
			return (DsHeaderBytes + (cursor and RingByteMask)) as SegmentOffset
		end 'ringSlotOf'

		// One of the producer's i64 header counters.
		function headerCounterAt(offset ByteOffset) returns EventTally
			return segment.readWord(offset as SegmentOffset) as EventTally
		end 'headerCounterAt'

		// ⭐ Walk the private copy, which holds only COMMITTED entries — so every payload here is whole.
		//
		// ⚠ **ONE ADVANCE FOR THE WHOLE WALK.** Padding, the depth markers, the heartbeat and every filtered-out
		// family step over an entry by exactly the same amount; spelling that out per branch is five chances to
		// step by the wrong one and land the walk mid-payload.
		function walkEntries(copy ByteArray, byteCount SpanByteCount) returns DecodedEventArray
			var events = DecodedEventArray.create()
			var offset = 0 as ByteOffset
			let spanEnd = byteCount as ByteOffset

			while offset < spanEnd 'eachEntry'
				let header = imageReadU64(copy, at: offset)
				let eventType = (header and DsEntryTypeMask) as EventCode

				if eventType == DsEvDepthInc 'opensALevel'
					depth = depth + 1
				end 'opensALevel' else if eventType == DsEvDepthDec 'closesALevel'
					// Floored rather than trusted: a trace may begin mid-nesting, having been drained from a ring
					// whose opening marker was overwritten before this consumer attached.
					if depth > 0 'notAtRoot'
						depth = depth - 1
					end 'notAtRoot'
				end 'closesALevel' else if rendersALine(eventType) and passesFilter(eventType) 'anEvent'
					let timestampMs = ((header shr DsEntryTimestampShift) and DsEntryTimestampMask) as TraceTimestampMs
					events.push(DecodedEvent.create(timestampMs, depth: depth, text: formatEvent(eventType, entry: copy, at: offset, tagNames: tagNames, logNames: logNames)))
				end 'anEvent'

				offset = offset + (entrySizeOf(header, at: offset as RingPosition) as ByteOffset)
			end 'eachEntry'

			return events
		end 'walkEntries'

		// Does this event belong to the family the caller asked for? `unknown` is refused at the command line,
		// so it cannot reach a running decoder and its arm passes nothing.
		function passesFilter(eventType EventCode) returns bool
			match filter 'which'
				all then return true
				only(family) then return familyOf(eventType) == family
				unknown(spelling) then panic("DebugStreamDecoder: the filter '{spelling}' was never resolved to a family; an unknown one is refused at the command line and cannot reach a drain")
			end 'which'

			panic("DebugStreamDecoder.passesFilter: every FamilyFilter arm above answers or panics")
		end 'passesFilter'
	end 'DebugStreamDecoder'

	// ============================================================================
	// The segment: naming and seeding
	// ============================================================================

	// A fresh ring name for this monitor. The process id is unique among living processes and the nonce
	// covers the rest — see `SegmentNamePrefix`.
	function mintSegmentName() returns String
		let nonce = Clock.nowNanos() and SegmentNonceMask
		return "{SegmentNamePrefix}{__Builtins.currentProcessId()}_{nonce:08x}"
	end 'mintSegmentName'

	// ⭐ Every header field the producer reads, written before it can read any of them.
	//
	// ⛔⛔ **`DsOffStartTimestamp` MUST BE THE COUNTER THE PRODUCER SUBTRACTS FROM, AND ONLY ONE EXPRESSION IS
	// IT.** Every entry is stamped `osTickCountMs() - start`, so the field is not "a time" — it is a reading of
	// `GetTickCount64`, and `__Builtins.tickCountMs()` is the door onto that same Std op. ⚠ `Clock.nowMs()`
	// looks like a substitute and is NOT: it is `__gt_now_ns` scaled (see `Parser.emitMonotonicMs`), QPC-ms
	// LEADS the tick, and the producer's subtraction then UNDERFLOWS — measured, every event printed
	// `[+4294967.244]`. A zero seed does not underflow but makes every delta the raw tick, so each line reports
	// SYSTEM UPTIME where it claims elapsed time since this monitor attached.
	//
	// The order below is the reference's own, field for field.
	function seedHeader(segment SharedSegment)
		segment.writeWord(DsOffMagic as SegmentOffset, value: DsMagic)
		segment.writeWord(DsOffVersion as SegmentOffset, value: DsSchemaVersion)
		segment.writeWord(DsOffBufferSize as SegmentOffset, value: DsRingBytes)
		segment.writeWord(DsOffWriteCursor as SegmentOffset, value: 0)
		segment.writeWord(DsOffReadCursor as SegmentOffset, value: 0)
		segment.writeWord(DsOffFlags as SegmentOffset, value: 0)
		segment.writeWord(DsOffProcessId as SegmentOffset, value: 0)
		segment.writeWord(DsOffStartTimestamp as SegmentOffset, value: __Builtins.tickCountMs())
		segment.writeWord(DsOffTotalEvents as SegmentOffset, value: 0)
		segment.writeWord(DsOffDroppedEvents as SegmentOffset, value: 0)
		segment.writeWord(DsOffTagTableOffset as SegmentOffset, value: DsSharedMemoryBytes - DsTagReserveBytes)
		segment.writeWord(DsOffTagTableCount as SegmentOffset, value: 0)
		segment.writeWord(DsOffPeakUsed as SegmentOffset, value: 0)
		// Seeded to "nobody has spoken". Only the producer writes here, and one too old to know the slot exists
		// leaves it exactly at this value — which is what makes such a producer DETECTABLE rather than merely
		// broken. See `producerSchema`.
		segment.writeWord(DsOffProducerVersion as SegmentOffset, value: DsProducerVersionUnset)
	end 'seedHeader'

	// ============================================================================
	// The schema handshake
	// ============================================================================

	// Whether the target speaks this consumer's wire schema.
	union SchemaVerdict
		agreed
		refused(message String)
	end 'SchemaVerdict'

	// ⭐⭐ **THREE CASES, AND THEY ARE EXHAUSTIVE.** The producer announces its version in `__ds_init` before it
	// can emit anything, and `write_cursor` is stored after that announcement — so a consumer that can see any
	// entry at all can see the version that produced it. There is no window in which a current producer looks
	// like an old one.
	//
	//   • the announced version is ours — decode.
	//   • NOTHING announced and the ring is empty — nothing ever attached. A binary built without
	//     `--debugstream` never opens the segment, and monitoring one is not an error; it simply has no events.
	//   • anything else — a foreign schema. REFUSE, and say so.
	//
	// ⛔ **THE LAST CASE EXISTS BECAUSE ITS SILENT FORM IS SO CONVINCING.** A v1 producer never sets the commit
	// bit, so a decoder waits for a commit that never comes, lets the ring fill until the producer is dropping
	// ~98% of its events, and then steps over every entry as "abandoned (producer died mid-entry)" — measured
	// at 0 decoded, 283221 dropped, 5290 abandoned, from a producer that had exited cleanly. An instrument that
	// lies is worse than no instrument; this is the check that makes it merely refuse.
	function producerSchema(segment SharedSegment, writeCursor RingPosition) returns SchemaVerdict
		let announced = segment.readWord(DsOffProducerVersion as SegmentOffset)
		if announced == DsSchemaVersion 'agrees'
			return SchemaVerdict.agreed
		end 'agrees'

		if announced == DsProducerVersionUnset and writeCursor == 0 'nothingAttached'
			return SchemaVerdict.agreed
		end 'nothingAttached'

		let speaks = "a schema older than v{DsSchemaVersion} (it wrote {writeCursor} bytes of entries without ever announcing a version)" if announced == DsProducerVersionUnset else "schema v{announced}"

		return SchemaVerdict.refused("{DebugStreamLinePrefix} SCHEMA MISMATCH — refusing to decode.\n{DebugStreamLinePrefix}   this consumer speaks v{DsSchemaVersion}; the target speaks {speaks}.\n{DebugStreamLinePrefix}   The two disagree about the entry COMMIT BIT, so every event in this trace\n{DebugStreamLinePrefix}   would be wrong: payloads decoded before they were written, or — more\n{DebugStreamLinePrefix}   likely — nothing decoded at all and the loss blamed on a producer crash\n{DebugStreamLinePrefix}   that never happened.\n{DebugStreamLinePrefix}   Rebuild the target with this compiler and run it again.")
	end 'producerSchema'

	// ============================================================================
	// Entry structure
	// ============================================================================

	// Total bytes of an entry, header included. ZERO IS NOT A LEGAL SIZE — see `EntryByteCount` — and a walk
	// keyed off it would spin on this offset for ever, so it panics naming both the position and the word.
	function entrySizeOf(header MachineWord, at RingPosition) returns EntryByteCount
		let size = (header shr DsEntrySizeShift) and DsEntrySizeMask
		if size == 0 'ringCorrupt'
			panic("DebugStream ring corrupt: the entry at cursor {at} declares size 0 (header 0x{header:016x})")
		end 'ringCorrupt'

		return size as EntryByteCount
	end 'entrySizeOf'

	// Does this code stand for a LINE? Padding fills the ring's tail so the next entry need not straddle the
	// wrap, and a heartbeat is a liveness tick — neither is a sentence about the program, so neither reaches a
	// formatter. The two DEPTH markers are structural too and are handled by the walk, which owns the counter.
	function rendersALine(eventType EventCode) returns bool
		return eventType != DsEvPadding and eventType != DsEvHeartbeat
	end 'rendersALine'

	// ⭐ The family a code belongs to. The bands are CONTIGUOUS, so this is two comparisons rather than a
	// roster that has to be kept in step with the event table.
	function familyOf(eventType EventCode) returns EventFamily
		if eventType < DsEvSchedSpawn 'theMmBand'
			return EventFamily.mm
		end 'theMmBand'

		if eventType >= DsEvLogPhaseBegin and eventType <= DsEvLogText 'theLogBand'
			return EventFamily.log
		end 'theLogBand'

		return EventFamily.sched
	end 'familyOf'

	/// Resolve a `--filter=` value. Refused HERE rather than in the decode loop, where the only available
	/// behaviours would be to throw or to silently show everything — which is the opposite of what was asked.
	module function parseFamilyFilter(spelling String) returns FamilyFilter
		if spelling.isEmpty() 'noneGiven'
			return FamilyFilter.all
		end 'noneGiven'

		let family = try EventFamily.fromName(spelling) otherwise return FamilyFilter.unknown(spelling)
		return FamilyFilter.only(family)
	end 'parseFamilyFilter'

	/// The families a usage line offers, in declaration order. Derived from the enum, so accepting a family and
	/// advertising it are one fact.
	module function familyChoiceList() returns String
		var choices = ""
		for family in EventFamily.allCases 'each'
			choices.append(family.name if choices.isEmpty() else "{FamilyChoiceSeparator}{family.name}")
		end 'each'

		return choices
	end 'familyChoiceList'

	// ============================================================================
	// The interned name tables
	// ============================================================================

	// ⭐ One packed name table out of already-read symdata: the magic, a u16 count, then each name behind its
	// own u16 byte length. BOTH blobs come out of ONE section and ONE parse, which is what keeps the two tables
	// from drifting apart on the format.
	//
	// A blob that is absent, truncated, or claims more than the section holds yields the names read so far
	// rather than throwing: an unresolvable index renders as `tag=<n>`, and a trace with one raw number in it
	// is still worth reading.
	function nameBlobIn(symdata ByteArray, magic ByteArray) returns StringArray
		var names = StringArray.create()

		var cursor = 0 as ByteOffset
		match findByteRun(symdata, needle: magic, from: 0) 'located'
			found(offset) then cursor = offset + magic.count()
			absent then return names
		end 'located'

		let count = readBlobField(symdata, at: cursor) as NameCount
		cursor = cursor + DsNameBlobFieldBytes

		for _ in 0 upto count 'eachName'
			let length = readBlobField(symdata, at: cursor)
			cursor = cursor + DsNameBlobFieldBytes
			if not imageRangeFits(symdata, start: cursor, count: length) 'runsPastTheSection'
				break
			end 'runsPastTheSection'

			names.push(String.from(imageSlice(symdata, start: cursor, count: length)))
			cursor = cursor + (length as ByteOffset)
		end 'eachName'

		return names
	end 'nameBlobIn'

	// One blob field — the table's count and each name's length are the same little-endian u16, so they are
	// read by the same call and cannot come to disagree about width. A field running past the section reads 0,
	// which ends the walk at the next bound check.
	function readBlobField(symdata ByteArray, at ByteOffset) returns BytePos
		if not imageRangeFits(symdata, start: at, count: DsNameBlobFieldBytes) 'runsPastTheSection'
			return 0
		end 'runsPastTheSection'

		return imageReadU16(symdata, at: at) as BytePos
	end 'readBlobField'

	// ⭐ An interned index back to the name the compiler embedded in the executable. Index 0 means "no name" in
	// both tables, and a name may legitimately be missing (an executable built by an older compiler), so an
	// unresolvable index renders as `<field>=<n>` rather than throwing.
	function resolveInternedName(index NameIndex, names StringArray, fieldName String) returns String
		let name = try names.get(index) otherwise ""
		if index == 0 or name.isEmpty() 'unresolvable'
			return "{fieldName}={index}"
		end 'unresolvable'

		return name
	end 'resolveInternedName'

	// ============================================================================
	// The formatters — one line per event, and the bytes of every one are the reference's
	// ============================================================================

	// ⚠ **EVERY STRING BELOW IS PINNED BY COMMITTED GOLDENS MINTED THROUGH THE REFERENCE DECODER**
	// (`specs-shv2/mm-trace.md`, `tuples.md`, `debugstream-log-events.md`). A "better" spelling here is the
	// failure, not a fix — including the DOUBLE space in `dbg_free_pop` and `dbg_csx_exit`, which is the
	// reference's own column alignment against its longer siblings.

	function formatEvent(eventType EventCode, entry ByteArray, at ByteOffset, tagNames StringArray, logNames StringArray) returns String
		return match familyOf(eventType) 'band'
			mm gives formatMmEvent(eventType, entry: entry, at: at, tagNames: tagNames)
			log gives formatLogEvent(eventType, entry: entry, at: at, logNames: logNames)
			sched gives formatSchedBandEvent(eventType, entry: entry, at: at)
		end 'band'
	end 'formatEvent'

	// The mm family. Three shapes over one payload: an allocation reports its SIZE, a refcount transition
	// reports the NEW COUNT, and a free has neither to report — the value slot is unused by it.
	function formatMmEvent(eventType EventCode, entry ByteArray, at ByteOffset, tagNames StringArray) returns String
		if eventType == DsEvMmRawAlloc 'rawAlloc'
			return "mm_raw_alloc #{imageReadU64(entry, at: at + DsMmOffAllocId)} size={imageReadU64(entry, at: at + DsMmOffRawSize)}"
		end 'rawAlloc' else if eventType == DsEvMmRawFree 'rawFree'
			return "mm_raw_free #{imageReadU64(entry, at: at + DsMmOffAllocId)}"
		end 'rawFree'

		let allocId = imageReadU64(entry, at: at + DsMmOffAllocId)
		let packed = imageReadU64(entry, at: at + DsMmOffPacked)
		let tag = resolveInternedName((packed and DsMmTagIndexMask) as NameIndex, names: tagNames, fieldName: TagFieldName)
		let value = (packed shr DsMmValueShift) and DsMmValueMask

		if eventType == DsEvMmAlloc or eventType == DsEvMmRealloc or eventType == DsEvMmCow 'allocated'
			return "{mmVerbOf(eventType)} {tag} #{allocId} size={value}"
		end 'allocated' else if eventType == DsEvMmFree 'freed'
			return "{mmVerbOf(eventType)} {tag} #{allocId}"
		end 'freed'

		return "{mmVerbOf(eventType)} {tag} #{allocId} rc={value}"
	end 'formatMmEvent'

	function mmVerbOf(eventType EventCode) returns String
		if eventType == DsEvMmAlloc 'alloc'
			return "mm_alloc"
		end 'alloc' else if eventType == DsEvMmRealloc 'realloc'
			return "mm_realloc"
		end 'realloc' else if eventType == DsEvMmCow 'cow'
			return "mm_cow"
		end 'cow' else if eventType == DsEvMmFree 'free'
			return "mm_free"
		end 'free' else if eventType == DsEvMmIncref 'incref'
			return "mm_incref"
		end 'incref' else if eventType == DsEvMmDecref 'decref'
			return "mm_decref"
		end 'decref' else if eventType == DsEvMmTransfer 'transfer'
			return "mm_transfer"
		end 'transfer'

		panic("DebugStream: unknown mm event type 0x{eventType:02x}")
	end 'mmVerbOf'

	// Everything the mm and log bands do not claim: the six SCHED transitions, the fifteen DBG events, and no
	// third thing — an unknown code here is a trace this decoder cannot read, not a line to guess at.
	function formatSchedBandEvent(eventType EventCode, entry ByteArray, at ByteOffset) returns String
		if isSchedTransition(eventType) 'aTransition'
			return "{schedVerbOf(eventType)} #{imageReadU64(entry, at: at + DsSchedOffTraceId)}"
		end 'aTransition'

		if eventType >= DsEvDbgEnqueue and eventType <= DsEvDbgCsxExit 'schedulerInternals'
			return formatDbgEvent(eventType, entry: entry, at: at)
		end 'schedulerInternals'

		panic("DebugStream: unknown event type 0x{eventType:02x}")
	end 'formatSchedBandEvent'

	// The six transitions are two runs rather than one, which is why membership is asked here rather than as a
	// single range test: `0x24`-`0x2A` belong to neither.
	function isSchedTransition(eventType EventCode) returns bool
		if eventType >= DsEvSchedSpawn and eventType <= DsEvSchedResume 'greenThreadLife'
			return true
		end 'greenThreadLife'

		return eventType == DsEvIoYield or eventType == DsEvIoResume
	end 'isSchedTransition'

	function schedVerbOf(eventType EventCode) returns String
		if eventType == DsEvSchedSpawn 'spawn'
			return "sched_spawn"
		end 'spawn' else if eventType == DsEvSchedAwait 'await'
			return "sched_await"
		end 'await' else if eventType == DsEvSchedYield 'yield'
			return "sched_yield"
		end 'yield' else if eventType == DsEvSchedResume 'resume'
			return "sched_resume"
		end 'resume' else if eventType == DsEvIoYield 'ioYield'
			return "io_yield"
		end 'ioYield' else if eventType == DsEvIoResume 'ioResume'
			return "io_resume"
		end 'ioResume'

		panic("DebugStream: 0x{eventType:02x} is not a sched transition — `isSchedTransition` is the gate this function trusts, and the two have drifted")
	end 'schedVerbOf'

	// The scheduler's internals. Five payload words whose meaning is per code, which is why they arrive
	// numbered and each arm names them.
	function formatDbgEvent(eventType EventCode, entry ByteArray, at ByteOffset) returns String
		let gt = "gt=0x{imageReadU64(entry, at: at + DsDbgOffGt):x}"
		let worker = "P{imageReadU64(entry, at: at + DsDbgOffPid)}"
		let arg2 = imageReadU64(entry, at: at + DsDbgOffArg2)
		let arg3 = imageReadU64(entry, at: at + DsDbgOffArg3)
		let arg4 = imageReadU64(entry, at: at + DsDbgOffArg4)

		if eventType == DsEvDbgEnqueue 'enqueue'
			return "dbg_enqueue {gt} {worker} kind={queueKindOf(arg2, entering: true)} owner=P{arg3}"
		end 'enqueue' else if eventType == DsEvDbgDequeue 'dequeue'
			return "dbg_dequeue {gt} {worker} kind={queueKindOf(arg2, entering: false)} from=P{arg3}"
		end 'dequeue' else if eventType == DsEvDbgRunnextSet 'runnextSet'
			return "dbg_runnext_set {gt} {worker}"
		end 'runnextSet' else if eventType == DsEvDbgRunnextTake 'runnextTake'
			return "dbg_runnext_take {gt} {worker}"
		end 'runnextTake' else if eventType == DsEvDbgRunnextDisplace 'runnextDisplace'
			return "dbg_runnext_displace displaced={gt} new_gt=0x{arg2:x} {worker}"
		end 'runnextDisplace' else if eventType == DsEvDbgStatusStore 'statusStore'
			return "dbg_status {gt} {worker} {arg2}->{arg3} site={arg4}"
		end 'statusStore' else if eventType == DsEvDbgIoComplete 'ioComplete'
			return "dbg_io_complete {gt} phase={ioPhaseOf(arg2)}"
		end 'ioComplete' else if eventType == DsEvDbgFreeListPush 'freePush'
			return "dbg_free_push {gt} {worker} new_len={arg2}"
		end 'freePush' else if eventType == DsEvDbgFreeListPop 'freePop'
			return "dbg_free_pop  {gt} {worker} new_len={arg2}"
		end 'freePop' else if eventType == DsEvDbgWloopRunGt 'workerLoopRun'
			return "dbg_wloop_run {gt} {worker}"
		end 'workerLoopRun' else if eventType == DsEvDbgAwaitDeqRun 'awaitRun'
			return "dbg_await_run {gt} {worker}"
		end 'awaitRun' else if eventType == DsEvDbgTrampolineCompleted 'trampolineCompleted'
			return "dbg_tramp_completed {gt}"
		end 'trampolineCompleted' else if eventType == DsEvDbgTimerFire 'timerFire'
			return "dbg_timer_fire {gt}"
		end 'timerFire' else if eventType == DsEvDbgCsxEntry 'contextSwitchIn'
			return "dbg_csx_entry from={gt} to=0x{arg2:x} from_rsp=0x{arg3:x} from_rbp=0x{arg4:x}"
		end 'contextSwitchIn' else if eventType == DsEvDbgCsxExit 'contextSwitchOut'
			return "dbg_csx_exit  from={gt} to=0x{arg2:x} to_rsp=0x{arg3:x} to_rbp=0x{arg4:x}"
		end 'contextSwitchOut'

		panic("DebugStream: 0x{eventType:02x} is inside the dbg band and has no formatter — a code was added to the registry and not to this chain")
	end 'formatDbgEvent'

	// Which queue an enqueue or dequeue moved a green thread through. A steal is a CHAIN going in and a FIRST
	// coming out — one wire code, read by direction, which is why `entering` is a parameter here rather than
	// two near-identical chains. A code the producer never writes is a corrupt trace, not an unknown kind.
	function queueKindOf(kind MachineWord, entering bool) returns String
		if kind == DsDbgQueueLocal 'local'
			return "local"
		end 'local' else if kind == DsDbgQueueGlobal 'global'
			return "global"
		end 'global' else if kind == DsDbgQueueSteal 'stolen'
			return "steal_chain" if entering else "steal_first"
		end 'stolen' else if kind == DsDbgQueueRunnext 'runnext'
			return "runnext"
		end 'runnext'

		panic("DebugStream: unknown dbg queue kind {kind}")
	end 'queueKindOf'

	// How far the I/O completion path had got. A code the producer never writes is a corrupt trace.
	function ioPhaseOf(phase MachineWord) returns String
		if phase == DsDbgIoPhaseStatusSet 'statusSet'
			return "status_set"
		end 'statusSet' else if phase == DsDbgIoPhaseSpinDone 'spinDone'
			return "spin_done"
		end 'spinDone' else if phase == DsDbgIoPhaseEnqueueing 'enqueueing'
			return "enqueueing"
		end 'enqueueing'

		panic("DebugStream: unknown dbg io phase {phase}")
	end 'ioPhaseOf'

	// ⭐ The Log family — the events USER SOURCE authored through `__DebugStream`. Every one carries gt, p_id
	// and unit_id, which is what lets N interleaved workers be demuxed back into per-worker timelines.
	//
	// `cat` and `lvl` print NUMERICALLY: the wire fixes them as raw bytes and their meaning belongs to the
	// emitting program's own category and level enums, which this decoder deliberately does not know.
	//
	// ⚠⚠ **A PHASE PACKS ITS NAME INDEX UNSHIFTED AND THE OTHER TWO DO NOT.** The producer's own note carries
	// the measurement: a phase entry whose name went through the shared shift decodes as `name=0` at every
	// site, an event the instrument cannot name. Two layouts, two reads.
	function formatLogEvent(eventType EventCode, entry ByteArray, at ByteOffset, logNames StringArray) returns String
		let fields = imageReadU64(entry, at: at + DsLogOffFields)
		let unitId = (fields shr DsLogUnitIdShift) and DsLogUnitIdMask
		let who = "gt=0x{imageReadU64(entry, at: at + DsLogOffGt):x} P{imageReadU64(entry, at: at + DsLogOffPid)} unit={unitId}"

		if eventType == DsEvLogPhaseBegin or eventType == DsEvLogPhaseEnd 'aPhase'
			let phase = resolveInternedName((fields and DsLogU16FieldMask) as NameIndex, names: logNames, fieldName: LogNameFieldName)
			return "{"log_phase_begin" if eventType == DsEvLogPhaseBegin else "log_phase_end"} {phase} {who}"
		end 'aPhase'

		let category = fields and DsLogCatMask
		let level = (fields shr DsLogLvlShift) and DsLogLvlMask
		let u16Field = (fields shr DsLogU16FieldShift) and DsLogU16FieldMask

		if eventType == DsEvLogEvent 'anEvent'
			let named = resolveInternedName(u16Field as NameIndex, names: logNames, fieldName: LogNameFieldName)
			return "log_event {named} cat={category} lvl={level} {who} a0={imageReadU64(entry, at: at + DsLogOffArg0)} a1={imageReadU64(entry, at: at + DsLogOffArg1)}"
		end 'anEvent'

		if eventType == DsEvLogText 'someText'
			return "log_text cat={category} lvl={level} {who} {logTextIn(entry, at: at + DsLogOffText, byteCount: u16Field as BytePos)}"
		end 'someText'

		panic("DebugStream: unknown log event type 0x{eventType:02x}")
	end 'formatLogEvent'

	// A LOG_TEXT's UTF-8 tail, without the terminator the emitting call site wrote: a line this consumer prints
	// supplies its own, and a doubled one would put a blank line into every golden.
	function logTextIn(entry ByteArray, at ByteOffset, byteCount BytePos) returns String
		if not imageRangeFits(entry, start: at, count: byteCount) 'runsPastTheEntry'
			panic("DebugStream: a log_text entry claims {byteCount} text bytes at {at}, past the {entry.count()} bytes of the drained span — its entry_size and its length field disagree")
		end 'runsPastTheEntry'

		var text = imageSlice(entry, start: at, count: byteCount)
		while text.count() > 0 'trimTerminator'
			let last = try text.get(text.count() - 1) otherwise break
			if last != CarriageReturnByte and last != LineFeedByte 'notATerminator'
				break
			end 'notATerminator'

			_ = try text.pop() otherwise break
		end 'trimTerminator'

		return String.from(text)
	end 'logTextIn'
#endif
