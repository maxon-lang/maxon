/// The root certificates the operating system trusts, as DER bytes, on Windows, macOS and Linux.
/// @category System

/// Why `TrustStore.systemRoots` could not answer.
public enum TrustStoreError implements Error
	/// The machine's certificate store cannot be opened or read to its end.
	unavailable

	/// A store was found, but it holds no certificates, holds a certificate with no bytes, or is not
	/// valid PEM.
	malformed
end 'TrustStoreError'

/// DER-encoded certificates, one `ByteArray` each.
public typealias RootCertificates = Array with ByteArray

#if os(Linux)
	let TrustBundleLocations = ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/ssl/ca-bundle.pem", "/etc/pki/tls/cacert.pem", "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem", "/etc/ssl/cert.pem"]
	let TrustBundleCertificateLabel = "CERTIFICATE"

	function bundleRoots() returns RootCertificates throws TrustStoreError
		for location in TrustBundleLocations 'eachLocation'
			let path = try FilePath.from(location) otherwise panic("TrustStore: the fixed bundle location '{location}' is not a path")

			if not File.exists(path) 'absent'
				continue
			end 'absent'

			let text = try File.readText(path) otherwise continue

			return try certificatesIn(text)
		end 'eachLocation'

		throw TrustStoreError.unavailable
	end 'bundleRoots'

	function certificatesIn(text String) returns RootCertificates throws TrustStoreError
		let blocks = try Pem.decode(text) otherwise throw TrustStoreError.malformed
		var roots = RootCertificates.create()

		for block in blocks 'eachBlock'
			if block.label() == TrustBundleCertificateLabel 'isCertificate'
				roots.push(block.bytes().clone())
			end 'isCertificate'
		end 'eachBlock'

		if roots.isEmpty() 'noCertificates'
			throw TrustStoreError.malformed
		end 'noCertificates'

		return roots
	end 'certificatesIn'
#else
	typealias TrustStoreWord = int(i64.min to i64.max)

	let TrustStoreNoHandle = 0
	let TrustStoreNoCursor = 0
	let TrustStoreWalkFailed = -1

	// Restated from `TrustStoreRuntime.maxon`, which owns what each verdict means.
	let TrustVerdictIgnored = 0
	let TrustVerdictRoot = 2
	let TrustVerdictNonRoot = 3
	let TrustVerdictDenied = 4

	function hostRoots() returns RootCertificates throws TrustStoreError
		let store = __Builtins.trustStoreOpen() as TrustStoreWord

		if store == TrustStoreNoHandle 'unavailable'
			throw TrustStoreError.unavailable
		end 'unavailable'

		var trusted = RootCertificates.create()
		var denied = RootCertificates.create()

		try walkStore(store, trusted: trusted, denied: denied) otherwise (reason) 'unreadable'
			__Builtins.trustStoreClose(store)

			throw reason
		end 'unreadable'

		__Builtins.trustStoreClose(store)

		let roots = withoutDenied(trusted, denied: denied)

		if roots.isEmpty() 'noCertificates'
			throw TrustStoreError.malformed
		end 'noCertificates'

		return roots
	end 'hostRoots'

	function walkStore(store TrustStoreWord, trusted RootCertificates, denied RootCertificates) throws TrustStoreError
		var cursor = __Builtins.trustStoreNext(store, TrustStoreNoCursor) as TrustStoreWord

		while cursor != TrustStoreNoCursor 'eachCertificate'
			if cursor == TrustStoreWalkFailed 'walkFailed'
				throw TrustStoreError.unavailable
			end 'walkFailed'

			let verdict = __Builtins.trustStoreVerdict(store, cursor) as TrustStoreWord

			if verdict != TrustVerdictIgnored 'decided'
				let certificate = ByteArray.init(__Builtins.trustStoreCertificate(store, cursor))

				if certificate.isEmpty() 'emptyCertificate'
					throw TrustStoreError.malformed
				end 'emptyCertificate'

				if verdict == TrustVerdictDenied 'refused'
					denied.push(certificate)
				end 'refused' else if fitsVerdict(certificate, verdict: verdict) 'fits'
					trusted.push(certificate)
				end 'fits'
			end 'decided'

			cursor = __Builtins.trustStoreNext(store, cursor) as TrustStoreWord
		end 'eachCertificate'
	end 'walkStore'

	function fitsVerdict(certificate ByteArray, verdict TrustStoreWord) returns bool
		if verdict != TrustVerdictRoot and verdict != TrustVerdictNonRoot 'unconstrained'
			return true
		end 'unconstrained'

		// A certificate that does not parse fits neither root verdict.
		let selfIssued = try isSelfIssued(certificate) otherwise return false

		return selfIssued if verdict == TrustVerdictRoot else not selfIssued
	end 'fitsVerdict'

	function isSelfIssued(certificate ByteArray) returns bool throws DerError
		var reader = DerReader.create(certificate.clone())
		var signed = try reader.enterSequence()
		var tbs = try signed.enterSequence()
		let leading = try tbs.peekHeader()

		if leading.tagClass() == DerTagClass.contextSpecific 'versioned'
			_ = try tbs.readElement()
		end 'versioned'

		_ = try tbs.readElement()
		_ = try tbs.readElement()
		let issuer = try tbs.readElement()
		_ = try tbs.readElement()
		let subject = try tbs.readElement()

		return issuer.equals(subject)
	end 'isSelfIssued'

	function withoutDenied(trusted RootCertificates, denied RootCertificates) returns RootCertificates
		var kept = RootCertificates.create()

		for root in trusted 'eachTrusted'
			var refused = false

			for candidate in denied 'eachDenied'
				if root.equals(candidate) 'same'
					refused = true
				end 'same'
			end 'eachDenied'

			if not refused 'keep'
				kept.push(root.clone())
			end 'keep'
		end 'eachTrusted'

		return kept
	end 'withoutDenied'
#endif

public type TrustStore
	/// The DER bytes of every root certificate the operating system's store holds, one `ByteArray`
	/// each. Windows reads the `ROOT` system store, macOS the system, admin and user trust-settings
	/// domains as their SSL trust settings leave them, and Linux the first existing distribution CA
	/// bundle. Refused at compile time (E3104) on wasm32-wasi.
	public static function systemRoots() returns RootCertificates throws TrustStoreError
		#if os(Linux)
			return try bundleRoots()
		#else
			return try hostRoots()
		#endif
	end 'systemRoots'
end 'TrustStore'
