/// ChaCha20-Poly1305 authenticated encryption (RFC 8439) with a 12-byte nonce and a 16-byte tag.
/// @category Crypto
let chaCha20Poly1305KeyBytes = 32
let chaCha20Poly1305NonceBytes = 12
let chaCha20Poly1305TagBytes = 16
let chaCha20Poly1305PaddingBlockBytes = 16
let chaCha20Poly1305LengthFieldBytes = 8
let chaCha20Poly1305OneTimeKeyBlock = 0
let chaCha20Poly1305FirstDataBlock = 1

// 2^32 − 1 blocks of 64 bytes: the most the 32-bit counter covers from `chaCha20Poly1305FirstDataBlock` on.
let chaCha20Poly1305MaxPlaintextBytes = 274877906880
let chaCha20Poly1305ZeroByte = 0 as Byte

function chaCha20Poly1305PadToBlock(buffer ByteArray)
	while buffer.count() mod chaCha20Poly1305PaddingBlockBytes != 0 'padding'
		buffer.push(chaCha20Poly1305ZeroByte)
	end 'padding'
end 'chaCha20Poly1305PadToBlock'

/// ChaCha20-Poly1305 under one 32-byte key.
public type ChaCha20Poly1305 implements Aead
	// Not zeroed when the cipher is dropped: there is no destructor hook to do it.
	var key as ByteArray

	/// The cipher for a copy of `key`, or `invalidKeyLength`.
	public static function create(key ByteArray) returns ChaCha20Poly1305 throws AeadError
		if key.count() != chaCha20Poly1305KeyBytes 'keyLength'
			throw AeadError.invalidKeyLength
		end 'keyLength'

		return Self{key: key.clone()}
	end 'create'

	public function seal(nonce ByteArray, plaintext ByteArray, additionalData ByteArray) returns ByteArray throws AeadError
		try aeadRequireNonce(nonce, nonceBytes: chaCha20Poly1305NonceBytes)
		try aeadRequirePlaintextLength(plaintext, limit: chaCha20Poly1305MaxPlaintextBytes)

		var sealed = apply(nonce, counter: chaCha20Poly1305FirstDataBlock, data: plaintext)
		let tag = authenticate(nonce, additionalData: additionalData, ciphertext: sealed)
		sealed.append(tag)

		return sealed
	end 'seal'

	public function open(nonce ByteArray, sealed ByteArray, additionalData ByteArray) returns ByteArray throws AeadError
		try aeadRequireNonce(nonce, nonceBytes: chaCha20Poly1305NonceBytes)

		let parts = try aeadSplitSealed(sealed, tagBytes: chaCha20Poly1305TagBytes, plaintextLimit: chaCha20Poly1305MaxPlaintextBytes)
		let expected = authenticate(nonce, additionalData: additionalData, ciphertext: parts.ciphertext)
		try aeadRequireTag(expected, received: parts.tag)

		return apply(nonce, counter: chaCha20Poly1305FirstDataBlock, data: parts.ciphertext)
	end 'open'

	function apply(nonce ByteArray, counter ChaCha20Counter, data ByteArray) returns ByteArray
		let transformed = try ChaCha20.xorKeyStream(key, nonce: nonce, counter: counter, data: data) otherwise (failure) 'refused'
			match failure 'reason'
				invalidKeyLength then panic("ChaCha20Poly1305: xorKeyStream refused a key that create accepted")
				invalidNonceLength then panic("ChaCha20Poly1305: xorKeyStream refused a nonce that aeadRequireNonce accepted")
				counterOverflow then panic("ChaCha20Poly1305: xorKeyStream wrapped the block counter for data no longer than 2^38 - 64 bytes")
			end 'reason'
		end 'refused'

		return transformed
	end 'apply'

	function authenticate(nonce ByteArray, additionalData ByteArray, ciphertext ByteArray) returns ByteArray
		var zeros = ByteArray.create()
		zeros.resize(chaCha20Poly1305KeyBytes)
		let oneTimeKey = apply(nonce, counter: chaCha20Poly1305OneTimeKeyBlock, data: zeros)

		var input = ByteArray.create()
		input.reserve(additionalData.count() + ciphertext.count() + chaCha20Poly1305PaddingBlockBytes * 2 + chaCha20Poly1305LengthFieldBytes * 2)
		input.append(additionalData)
		chaCha20Poly1305PadToBlock(input)
		input.append(ciphertext)
		chaCha20Poly1305PadToBlock(input)
		appendOrderedWord(input, word: additionalData.count() as ByteWord, width: chaCha20Poly1305LengthFieldBytes, order: ByteOrder.littleEndian)
		appendOrderedWord(input, word: ciphertext.count() as ByteWord, width: chaCha20Poly1305LengthFieldBytes, order: ByteOrder.littleEndian)

		return try Poly1305.mac(oneTimeKey, message: input) otherwise panic("ChaCha20Poly1305: Poly1305 refused a 32-byte key")
	end 'authenticate'
end 'ChaCha20Poly1305'
