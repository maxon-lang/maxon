/// NIST P-256 and P-384 elliptic curves: ECDH key agreement, ECDSA verification and deterministic ECDSA signing.
/// @category Crypto
typealias NistAffinePoint = (WorkspaceLimbs, WorkspaceLimbs)
typealias NistTerm = (WorkspaceLimbs, Count)
typealias NistTerms = Array with NistTerm
typealias NistScalarBytes = int(32 to 48) implements Count
typealias NistSpan = (ElementIndex, ElementIndex)

let nistLimbBits = 32
let nistLimbBytes = 4
let nistBitsPerByte = 8
let nistWindowBits = 4
let nistWindowsPerLimb = 8
let nistWindowsPerLimbShift = 3
let nistTableSize = 16
let nistInverseRefinements = 4
let nistTopBit = 63
let nistSlotWidth = 14
let nistCoordinates = 3
let nistProductSlot = 0
let nistRemainderSlot = 1
let nistOneSlot = 2
let nistSquaredSlot = 3
let nistUnitSlot = 4
let nistDoubledSlot = 5
let nistCurveBSlot = 6
let nistFirstFreeSlot = 7
let nistPointASlot = 7
let nistPointBSlot = 10
let nistPointCSlot = 13
let nistLookedSlot = 16
let nistTableSlot = 19
let nistTableSlots = 48
let nistMaxTerms = 2
let nistTemporarySlot = nistTableSlot + nistMaxTerms * nistTableSlots
let nistTemporarySlots = 32
let nistCurveSlots = nistTemporarySlot + nistTemporarySlots
let nistFieldSlots = 16

let nistLimbMask = 0xFFFFFFFF as WorkspaceLimb
let nistWindowMask = 0xF as WorkspaceLimb
let nistWindowsPerLimbMask = 0x7 as WorkspaceLimb
let nistAllOnes = u64.max as WorkspaceLimb
let nistZero = 0 as WorkspaceLimb
let nistOne = 1 as WorkspaceLimb
let nistTwo = 2
let nistByteMask = 0xFF as WorkspaceLimb

let nistUncompressedTag = 0x04 as Byte
let nistDerSequenceTag = 0x30
let nistDerIntegerTag = 0x02
let nistDerLongForm = 0x80
let nistDerSignBit = 0x80
let nistDerLengthBytesLimit = 4
let nistPointTagBytes = 1
let nistPointCoordinates = 2
let p256ScalarBytes = 32
let p384ScalarBytes = 48
let nistByteRadix = 256
let nistZeroByte = 0 as Byte
let nistNonceOneByte = 0x01 as Byte

let nistHexLetterStart = 0x61
let nistHexLetterBase = 0x57
let nistHexDigitBase = 0x30
let nistHexDigitsPerByte = 2
let nistHexDigitBits = 4

let p256PrimeHex = "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"
let p256OrderHex = "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"
let p256BHex = "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"
let p256GxHex = "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
let p256GyHex = "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"

let p384PrimeHex = "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff"
let p384OrderHex = "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"
let p384BHex = "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef"
let p384GxHex = "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7"
let p384GyHex = "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"

enum NistRefusal implements Error
	invalidEncoding
	rejectedNonce
end 'NistRefusal'

function nistByte(bytes ByteArray, index ElementIndex) returns Byte throws NistRefusal
	return try bytes.get(index) otherwise throw NistRefusal.invalidEncoding
end 'nistByte'

function nistSmall(count Count, value WorkspaceLimb) returns WorkspaceLimbs
	var limbs = zeroLimbs(count)
	workspaceLimbPut(limbs, index: 0, value: value)
	return limbs
end 'nistSmall'

function nistMask(bit WorkspaceLimb) returns WorkspaceLimb
	return bit * nistAllOnes
end 'nistMask'

function nistEqualMask(a WorkspaceLimb, b WorkspaceLimb) returns WorkspaceLimb
	return nistMask(((a xor b) - nistOne) shr nistTopBit)
end 'nistEqualMask'

function nistBorrowChain(dst WorkspaceLimbs, dstBase ElementIndex, a WorkspaceLimbs, aBase ElementIndex, b WorkspaceLimbs, bBase ElementIndex, count Count) returns WorkspaceLimb
	var borrow = nistZero

	for index in 0 upto count 'eachLimb'
		let total = workspaceLimbAt(a, index: aBase + index) - workspaceLimbAt(b, index: bBase + index) - borrow
		workspaceLimbPut(dst, index: dstBase + index, value: total and nistLimbMask)
		borrow = total shr nistTopBit
	end 'eachLimb'

	return borrow
end 'nistBorrowChain'

function nistCarryChain(dst WorkspaceLimbs, dstBase ElementIndex, a WorkspaceLimbs, aBase ElementIndex, b WorkspaceLimbs, bBase ElementIndex, bMask WorkspaceLimb, count Count) returns WorkspaceLimb
	var carry = nistZero

	for index in 0 upto count 'eachLimb'
		let total = workspaceLimbAt(a, index: aBase + index) + (workspaceLimbAt(b, index: bBase + index) and bMask) + carry
		workspaceLimbPut(dst, index: dstBase + index, value: total and nistLimbMask)
		carry = total shr nistLimbBits
	end 'eachLimb'

	return carry
end 'nistCarryChain'

function nistSubtract(a WorkspaceLimbs, b WorkspaceLimbs) returns (WorkspaceLimbs, WorkspaceLimb)
	var difference = zeroLimbs(a.count())
	let borrow = nistBorrowChain(difference, dstBase: 0, a: a, aBase: 0, b: b, bBase: 0, count: a.count())
	return (difference, borrow)
end 'nistSubtract'

function nistIsZero(limbs WorkspaceLimbs) returns bool
	var accumulated = nistZero

	for limb in limbs 'eachLimb'
		accumulated = accumulated or limb
	end 'eachLimb'

	return accumulated == nistZero
end 'nistIsZero'

function nistEqual(a WorkspaceLimbs, b WorkspaceLimbs) returns bool
	var difference = nistZero

	for (iter, limb) in a.withIterator() 'eachLimb'
		difference = difference or (limb xor workspaceLimbAt(b, index: iter.index()))
	end 'eachLimb'

	return difference == nistZero
end 'nistEqual'

function nistLimbsFromBytes(bytes ByteArray, start ElementIndex, count Count) returns WorkspaceLimbs
	let limbCount = count / nistLimbBytes
	var limbs = WorkspaceLimbs.create()
	limbs.reserve(limbCount)

	for index in 0 upto limbCount 'eachLimb'
		let first = start + count - (index + 1) * nistLimbBytes
		var word = nistZero

		for offset in 0 upto nistLimbBytes 'eachByte'
			let byte = try bytes.get(first + offset) otherwise panic("nist: byte index past the checked length")
			word = (word shl nistBitsPerByte) or (byte as WorkspaceLimb)
		end 'eachByte'

		limbs.push(word)
	end 'eachLimb'

	return limbs
end 'nistLimbsFromBytes'

function nistBytesFromLimbs(limbs WorkspaceLimbs) returns ByteArray
	var bytes = ByteArray.create()
	bytes.reserve(limbs.count() * nistLimbBytes)

	for step in 0 upto limbs.count() 'eachLimb'
		let limb = workspaceLimbAt(limbs, index: limbs.count() - 1 - step)

		for offset in 0 upto nistLimbBytes 'eachByte'
			let shift = (nistLimbBytes - 1 - offset) * nistBitsPerByte
			bytes.push(((limb shr shift) and nistByteMask) as Byte)
		end 'eachByte'
	end 'eachLimb'

	return bytes
end 'nistBytesFromLimbs'

function nistHexDigit(symbol Byte) returns Byte
	if symbol >= nistHexLetterStart 'letter'
		return symbol - nistHexLetterBase
	end 'letter'

	return symbol - nistHexDigitBase
end 'nistHexDigit'

function nistLimbsFromHex(hex String) returns WorkspaceLimbs
	var bytes = ByteArray.create()
	bytes.reserve(hex.byteLength() / nistHexDigitsPerByte)
	var high = nistZeroByte
	var isHigh = true

	for symbol in hex.bytes() 'eachSymbol'
		if isHigh 'first'
			high = nistHexDigit(symbol)
		end 'first' else 'second'
			bytes.push((high shl nistHexDigitBits) or nistHexDigit(symbol))
		end 'second'

		isHigh = not isHigh
	end 'eachSymbol'

	return nistLimbsFromBytes(bytes, start: 0, count: bytes.count())
end 'nistLimbsFromHex'

function nistMontgomeryInverse(low WorkspaceLimb) returns WorkspaceLimb
	var inverse = low

	for _ in 0 upto nistInverseRefinements 'eachRefinement'
		inverse = (inverse * (nistTwo - low * inverse)) and nistLimbMask
	end 'eachRefinement'

	return (nistZero - inverse) and nistLimbMask
end 'nistMontgomeryInverse'

function nistTableAt(term ElementIndex) returns Count
	return nistTableSlot + (term as Count) * nistTableSlots
end 'nistTableAt'

function nistDerSpan(der ByteArray, position ElementIndex, tag Byte) returns NistSpan throws NistRefusal
	let found = try nistByte(der, index: position)

	if found != tag 'wrongTag'
		throw NistRefusal.invalidEncoding
	end 'wrongTag'

	let lengthStart = position + 1
	let first = try nistByte(der, index: lengthStart)

	if first < nistDerLongForm 'shortForm'
		return try nistDerBounded(der, start: lengthStart + 1, length: first as ElementIndex)
	end 'shortForm'

	let lengthBytes = (first - nistDerLongForm) as ElementIndex

	if lengthBytes == 0 or lengthBytes > nistDerLengthBytesLimit 'unsupportedLength'
		throw NistRefusal.invalidEncoding
	end 'unsupportedLength'

	var length = 0 as ElementIndex

	for offset in 1 to lengthBytes 'eachLengthByte'
		let byte = try nistByte(der, index: lengthStart + offset)
		length = length * nistByteRadix + (byte as ElementIndex)
	end 'eachLengthByte'

	if length < nistDerLongForm or length shr ((lengthBytes - 1) * nistBitsPerByte) == 0 'nonMinimalLength'
		throw NistRefusal.invalidEncoding
	end 'nonMinimalLength'

	return try nistDerBounded(der, start: lengthStart + 1 + lengthBytes, length: length)
end 'nistDerSpan'

function nistDerBounded(der ByteArray, start ElementIndex, length ElementIndex) returns NistSpan throws NistRefusal
	if start + length > der.count() 'truncated'
		throw NistRefusal.invalidEncoding
	end 'truncated'

	return (start, start + length)
end 'nistDerBounded'

function nistDerInteger(der ByteArray, position ElementIndex) returns NistSpan throws NistRefusal
	let (start, limit) = try nistDerSpan(der, position: position, tag: nistDerIntegerTag)

	if start == limit 'empty'
		throw NistRefusal.invalidEncoding
	end 'empty'

	let lead = try nistByte(der, index: start)

	if lead >= nistDerSignBit 'negative'
		throw NistRefusal.invalidEncoding
	end 'negative'

	if lead == nistZeroByte and limit - start > 1 'leadingZero'
		let next = try nistByte(der, index: start + 1)

		if next < nistDerSignBit 'paddedInteger'
			throw NistRefusal.invalidEncoding
		end 'paddedInteger'
	end 'leadingZero'

	return (start, limit)
end 'nistDerInteger'

function nistParseSignature(der ByteArray) returns (ByteArray, ByteArray) throws NistRefusal
	let (start, limit) = try nistDerSpan(der, position: 0, tag: nistDerSequenceTag)

	if limit != der.count() 'trailingBytes'
		throw NistRefusal.invalidEncoding
	end 'trailingBytes'

	let (rStart, rEnd) = try nistDerInteger(der, position: start)
	let (sStart, sEnd) = try nistDerInteger(der, position: rEnd)

	if sEnd != limit 'extraElements'
		throw NistRefusal.invalidEncoding
	end 'extraElements'

	let r = try der.slice(rStart, endIndex: rEnd) otherwise panic("nist: integer span checked against the input")
	let s = try der.slice(sStart, endIndex: sEnd) otherwise panic("nist: integer span checked against the input")
	return (r, s)
end 'nistParseSignature'

function nistDerEncodedInteger(value WorkspaceLimbs) returns ByteArray
	var content = ByteArray.create()

	for byte in nistBytesFromLimbs(value) 'eachByte'
		if content.isEmpty() and byte == nistZeroByte 'leadingZero'
			continue
		end 'leadingZero'

		if content.isEmpty() and byte >= nistDerSignBit 'signPad'
			content.push(nistZeroByte)
		end 'signPad'

		content.push(byte)
	end 'eachByte'

	return derElement(nistDerIntegerTag, contents: content)
end 'nistDerEncodedInteger'

function nistNonceStep(hash HashAlgorithm, key ByteArray, value ByteArray, suffix ByteArray) returns (ByteArray, ByteArray)
	var keyed = value.clone()
	keyed.append(suffix)
	let nextKey = hmac(hash, key: key, message: keyed)
	return (nextKey, hmac(hash, key: nextKey, message: value))
end 'nistNonceStep'

type NistModulus
	let limbs as WorkspaceLimbs
	let inverse as WorkspaceLimb
	export let slots as LimbSlots
	let one as WorkspaceLimbs
	var squared = WorkspaceLimbs.create()
	let exponent as WorkspaceLimbs

	static function create(hex String) returns NistModulus
		let limbs = nistLimbsFromHex(hex)
		let count = limbs.count()
		let (one, _) = nistSubtract(zeroLimbs(count), b: limbs)
		let (exponent, _) = nistSubtract(limbs, b: nistSmall(count, value: nistTwo))
		let inverse = nistMontgomeryInverse(workspaceLimbAt(limbs, index: 0))
		var modulus = NistModulus{limbs: limbs, inverse: inverse, slots: LimbSlots.create(nistSlotWidth, limbCount: count), one: one, exponent: exponent}
		modulus.squared = modulus.computeSquared()
		return modulus
	end 'create'

	function blankWorkspace(slotCount Count) returns WorkspaceLimbs
		var ws = self.slots.workspace(slotCount)
		self.slots.load(ws, slot: nistOneSlot, value: self.one)
		self.slots.load(ws, slot: nistUnitSlot, value: nistSmall(self.slots.limbCount, value: nistOne))
		return ws
	end 'blankWorkspace'

	function workspace(slotCount Count) returns WorkspaceLimbs
		var ws = blankWorkspace(slotCount)
		self.slots.load(ws, slot: nistSquaredSlot, value: self.squared)
		return ws
	end 'workspace'

	function computeSquared() returns WorkspaceLimbs
		var ws = blankWorkspace(nistFieldSlots)
		self.slots.load(ws, slot: nistFirstFreeSlot, value: self.one)

		for _ in 0 upto self.slots.limbCount * nistLimbBits 'eachDoubling'
			add(ws, dst: nistFirstFreeSlot, a: nistFirstFreeSlot, b: nistFirstFreeSlot)
		end 'eachDoubling'

		return self.slots.read(ws, slot: nistFirstFreeSlot)
	end 'computeSquared'

	function isBelow(value WorkspaceLimbs) returns bool
		let (_, borrow) = nistSubtract(value, b: self.limbs)
		return borrow == nistOne
	end 'isBelow'

	function settle(ws WorkspaceLimbs, dst Count)
		let width = self.slots.limbCount
		let sum = self.slots.offset(nistProductSlot)
		let borrow = nistBorrowChain(ws, dstBase: self.slots.offset(nistRemainderSlot), a: ws, aBase: sum, b: self.limbs, bBase: 0, count: width)
		let replace = nistMask(workspaceLimbAt(ws, index: sum + width) or (borrow xor nistOne))
		self.slots.select(ws, dst: dst, kept: nistProductSlot, replacement: nistRemainderSlot, mask: replace)
	end 'settle'

	function reduceOnce(value WorkspaceLimbs) returns WorkspaceLimbs
		let (difference, borrow) = nistSubtract(value, b: self.limbs)
		let replace = nistMask(borrow xor nistOne)
		var reduced = WorkspaceLimbs.create()
		reduced.reserve(value.count())

		for (iter, limb) in value.withIterator() 'eachLimb'
			reduced.push(selectByMask(limb, replacement: workspaceLimbAt(difference, index: iter.index()), mask: replace))
		end 'eachLimb'

		return reduced
	end 'reduceOnce'

	function add(ws WorkspaceLimbs, dst Count, a Count, b Count)
		let sum = self.slots.offset(nistProductSlot)
		let carry = nistCarryChain(ws, dstBase: sum, a: ws, aBase: self.slots.offset(a), b: ws, bBase: self.slots.offset(b), bMask: nistAllOnes, count: self.slots.limbCount)
		workspaceLimbPut(ws, index: sum + self.slots.limbCount, value: carry)
		settle(ws, dst: dst)
	end 'add'

	function triple(ws WorkspaceLimbs, dst Count, a Count)
		add(ws, dst: nistDoubledSlot, a: a, b: a)
		add(ws, dst: dst, a: nistDoubledSlot, b: a)
	end 'triple'

	function subtract(ws WorkspaceLimbs, dst Count, a Count, b Count)
		let difference = self.slots.offset(nistProductSlot)
		let borrow = nistBorrowChain(ws, dstBase: difference, a: ws, aBase: self.slots.offset(a), b: ws, bBase: self.slots.offset(b), count: self.slots.limbCount)
		_ = nistCarryChain(ws, dstBase: self.slots.offset(dst), a: ws, aBase: difference, b: self.limbs, bBase: 0, bMask: nistMask(borrow), count: self.slots.limbCount)
	end 'subtract'

	function multiply(ws WorkspaceLimbs, dst Count, a Count, b Count)
		let width = self.slots.limbCount
		let accumulator = self.slots.offset(nistProductSlot)
		let left = self.slots.offset(a)
		let right = self.slots.offset(b)
		let modulus = self.limbs
		let factor = self.inverse
		let first = workspaceLimbAt(modulus, index: 0)

		for index in 0 upto width + 2 'eachClear'
			workspaceLimbPut(ws, index: accumulator + index, value: nistZero)
		end 'eachClear'

		for step in 0 upto width 'eachWord'
			let word = workspaceLimbAt(ws, index: right + step)
			var carry = nistZero

			for index in 0 upto width 'eachProduct'
				let total = workspaceLimbAt(ws, index: accumulator + index) + workspaceLimbAt(ws, index: left + index) * word + carry
				workspaceLimbPut(ws, index: accumulator + index, value: total and nistLimbMask)
				carry = total shr nistLimbBits
			end 'eachProduct'

			let top = workspaceLimbAt(ws, index: accumulator + width) + carry
			workspaceLimbPut(ws, index: accumulator + width, value: top and nistLimbMask)
			workspaceLimbPut(ws, index: accumulator + width + 1, value: top shr nistLimbBits)

			let low = workspaceLimbAt(ws, index: accumulator)
			let quotient = (low * factor) and nistLimbMask
			var shifted = (low + quotient * first) shr nistLimbBits

			for index in 1 upto width 'eachReduction'
				let total = workspaceLimbAt(ws, index: accumulator + index) + quotient * workspaceLimbAt(modulus, index: index) + shifted
				workspaceLimbPut(ws, index: accumulator + index - 1, value: total and nistLimbMask)
				shifted = total shr nistLimbBits
			end 'eachReduction'

			let reducedTop = workspaceLimbAt(ws, index: accumulator + width) + shifted
			workspaceLimbPut(ws, index: accumulator + width - 1, value: reducedTop and nistLimbMask)
			workspaceLimbPut(ws, index: accumulator + width, value: workspaceLimbAt(ws, index: accumulator + width + 1) + (reducedTop shr nistLimbBits))
		end 'eachWord'

		settle(ws, dst: dst)
	end 'multiply'

	function loadMontgomery(ws WorkspaceLimbs, slot Count, value WorkspaceLimbs)
		self.slots.load(ws, slot: slot, value: value)
		multiply(ws, dst: slot, a: slot, b: nistSquaredSlot)
	end 'loadMontgomery'

	function inverted(ws WorkspaceLimbs, dst Count, a Count)
		self.slots.copy(ws, dst: dst, src: nistOneSlot)

		for step in 0 upto self.exponent.count() 'eachLimb'
			let limb = workspaceLimbAt(self.exponent, index: self.exponent.count() - 1 - step)

			for offset in 1 to nistLimbBits 'eachBit'
				multiply(ws, dst: dst, a: dst, b: dst)

				if ((limb shr (nistLimbBits - offset)) and nistOne) == nistOne 'setBit'
					multiply(ws, dst: dst, a: dst, b: a)
				end 'setBit'
			end 'eachBit'
		end 'eachLimb'
	end 'inverted'
end 'NistModulus'

type NistCurve
	let primeField as NistModulus
	let scalarField as NistModulus
	let b as WorkspaceLimbs
	module let generator as NistAffinePoint
	let scalarBytes as NistScalarBytes
	let hash as HashAlgorithm

	static function create(prime String, order String, b String, gx String, gy String, scalarBytes NistScalarBytes, hash HashAlgorithm) returns NistCurve
		let generator = (nistLimbsFromHex(gx), nistLimbsFromHex(gy))
		return NistCurve{primeField: NistModulus.create(prime), scalarField: NistModulus.create(order), b: nistLimbsFromHex(b), generator: generator, scalarBytes: scalarBytes, hash: hash}
	end 'create'

	static function of(curve EcdsaCurve) returns NistCurve
		return match curve 'parameters'
			p256 gives NistCurve.create(p256PrimeHex, order: p256OrderHex, b: p256BHex, gx: p256GxHex, gy: p256GyHex, scalarBytes: p256ScalarBytes, hash: HashAlgorithm.sha256)
			p384 gives NistCurve.create(p384PrimeHex, order: p384OrderHex, b: p384BHex, gx: p384GxHex, gy: p384GyHex, scalarBytes: p384ScalarBytes, hash: HashAlgorithm.sha384)
		end 'parameters'
	end 'of'

	function workspace() returns WorkspaceLimbs
		var ws = self.primeField.workspace(nistCurveSlots)
		self.primeField.loadMontgomery(ws, slot: nistCurveBSlot, value: self.b)
		return ws
	end 'workspace'

	function loadPoint(ws WorkspaceLimbs, slot Count, point NistAffinePoint)
		self.primeField.loadMontgomery(ws, slot: slot, value: point.0)
		self.primeField.loadMontgomery(ws, slot: slot + 1, value: point.1)
		self.primeField.slots.copy(ws, dst: slot + 2, src: nistOneSlot)
	end 'loadPoint'

	function loadIdentity(ws WorkspaceLimbs, slot Count)
		self.primeField.slots.clear(ws, slot: slot)
		self.primeField.slots.copy(ws, dst: slot + 1, src: nistOneSlot)
		self.primeField.slots.clear(ws, slot: slot + 2)
	end 'loadIdentity'

	function copyPoint(ws WorkspaceLimbs, dst Count, src Count)
		for coordinate in 0 upto nistCoordinates 'eachCoordinate'
			self.primeField.slots.copy(ws, dst: dst + coordinate, src: src + coordinate)
		end 'eachCoordinate'
	end 'copyPoint'

	function addPoints(ws WorkspaceLimbs, result Count, p Count, q Count)
		let field = self.primeField
		let t0 = nistTemporarySlot
		let t1 = nistTemporarySlot + 1
		let t2 = nistTemporarySlot + 2
		let t3 = nistTemporarySlot + 3
		let t4 = nistTemporarySlot + 4
		let sumLeft = nistTemporarySlot + 5
		let sumRight = nistTemporarySlot + 6
		let sumBoth = nistTemporarySlot + 7
		let xz = nistTemporarySlot + 8
		let y3a = nistTemporarySlot + 9
		let scaled = nistTemporarySlot + 10
		let x3a = nistTemporarySlot + 11
		let z3a = nistTemporarySlot + 12
		let x3b = nistTemporarySlot + 13
		let t2b = nistTemporarySlot + 14
		let y3b = nistTemporarySlot + 15
		let t0b = nistTemporarySlot + 16
		let other = nistTemporarySlot + 17

		field.multiply(ws, dst: t0, a: p, b: q)
		field.multiply(ws, dst: t1, a: p + 1, b: q + 1)
		field.multiply(ws, dst: t2, a: p + 2, b: q + 2)

		field.add(ws, dst: sumLeft, a: p, b: p + 1)
		field.add(ws, dst: sumRight, a: q, b: q + 1)
		field.multiply(ws, dst: t3, a: sumLeft, b: sumRight)
		field.add(ws, dst: sumBoth, a: t0, b: t1)
		field.subtract(ws, dst: t3, a: t3, b: sumBoth)

		field.add(ws, dst: sumLeft, a: p + 1, b: p + 2)
		field.add(ws, dst: sumRight, a: q + 1, b: q + 2)
		field.multiply(ws, dst: t4, a: sumLeft, b: sumRight)
		field.add(ws, dst: sumBoth, a: t1, b: t2)
		field.subtract(ws, dst: t4, a: t4, b: sumBoth)

		field.add(ws, dst: sumLeft, a: p, b: p + 2)
		field.add(ws, dst: sumRight, a: q, b: q + 2)
		field.multiply(ws, dst: xz, a: sumLeft, b: sumRight)
		field.add(ws, dst: sumBoth, a: t0, b: t2)
		field.subtract(ws, dst: y3a, a: xz, b: sumBoth)

		field.multiply(ws, dst: scaled, a: nistCurveBSlot, b: t2)
		field.subtract(ws, dst: x3a, a: y3a, b: scaled)
		field.triple(ws, dst: x3a, a: x3a)
		field.subtract(ws, dst: z3a, a: t1, b: x3a)
		field.add(ws, dst: x3b, a: t1, b: x3a)
		field.triple(ws, dst: t2b, a: t2)

		field.multiply(ws, dst: scaled, a: nistCurveBSlot, b: y3a)
		field.subtract(ws, dst: y3b, a: scaled, b: t2b)
		field.subtract(ws, dst: y3b, a: y3b, b: t0)
		field.triple(ws, dst: y3b, a: y3b)
		field.triple(ws, dst: t0b, a: t0)
		field.subtract(ws, dst: t0b, a: t0b, b: t2b)

		field.multiply(ws, dst: scaled, a: x3b, b: z3a)
		field.multiply(ws, dst: other, a: t0b, b: y3b)
		field.add(ws, dst: result + 1, a: scaled, b: other)
		field.multiply(ws, dst: scaled, a: t3, b: x3b)
		field.multiply(ws, dst: other, a: t4, b: y3b)
		field.subtract(ws, dst: result, a: scaled, b: other)
		field.multiply(ws, dst: scaled, a: t4, b: z3a)
		field.multiply(ws, dst: other, a: t3, b: t0b)
		field.add(ws, dst: result + 2, a: scaled, b: other)
	end 'addPoints'

	function doublePoint(ws WorkspaceLimbs, result Count, p Count)
		let field = self.primeField
		let t0 = nistTemporarySlot
		let t1 = nistTemporarySlot + 1
		let t2 = nistTemporarySlot + 2
		let t3 = nistTemporarySlot + 3
		let z3a = nistTemporarySlot + 4
		let y3a = nistTemporarySlot + 5
		let x3a = nistTemporarySlot + 6
		let y3b = nistTemporarySlot + 7
		let x3b = nistTemporarySlot + 8
		let t2b = nistTemporarySlot + 9
		let z3b = nistTemporarySlot + 10
		let t0b = nistTemporarySlot + 11
		let scaled = nistTemporarySlot + 12
		let other = nistTemporarySlot + 13

		field.multiply(ws, dst: t0, a: p, b: p)
		field.multiply(ws, dst: t1, a: p + 1, b: p + 1)
		field.multiply(ws, dst: t2, a: p + 2, b: p + 2)
		field.multiply(ws, dst: other, a: p, b: p + 1)
		field.add(ws, dst: t3, a: other, b: other)
		field.multiply(ws, dst: other, a: p, b: p + 2)
		field.add(ws, dst: z3a, a: other, b: other)
		field.multiply(ws, dst: other, a: p + 1, b: p + 2)
		field.add(ws, dst: t0b, a: other, b: other)

		field.multiply(ws, dst: scaled, a: nistCurveBSlot, b: t2)
		field.subtract(ws, dst: y3a, a: scaled, b: z3a)
		field.triple(ws, dst: y3a, a: y3a)
		field.subtract(ws, dst: x3a, a: t1, b: y3a)
		field.add(ws, dst: scaled, a: t1, b: y3a)
		field.multiply(ws, dst: y3b, a: x3a, b: scaled)
		field.multiply(ws, dst: x3b, a: x3a, b: t3)
		field.triple(ws, dst: t2b, a: t2)

		field.multiply(ws, dst: scaled, a: nistCurveBSlot, b: z3a)
		field.subtract(ws, dst: z3b, a: scaled, b: t2b)
		field.subtract(ws, dst: z3b, a: z3b, b: t0)
		field.triple(ws, dst: z3b, a: z3b)

		field.triple(ws, dst: scaled, a: t0)
		field.subtract(ws, dst: scaled, a: scaled, b: t2b)
		field.multiply(ws, dst: other, a: scaled, b: z3b)
		field.add(ws, dst: result + 1, a: y3b, b: other)
		field.multiply(ws, dst: other, a: t0b, b: z3b)
		field.subtract(ws, dst: result, a: x3b, b: other)
		field.multiply(ws, dst: scaled, a: t0b, b: t1)
		field.add(ws, dst: other, a: scaled, b: scaled)
		field.add(ws, dst: result + 2, a: other, b: other)
	end 'doublePoint'

	// Every entry is read and masked: the digit can be a private key's or a nonce's, and indexing the
	// table by it would leak that scalar through cache timing.
	function selectEntry(ws WorkspaceLimbs, table Count, digit WorkspaceLimb)
		let slots = self.primeField.slots

		for coordinate in 0 upto nistCoordinates 'eachClear'
			slots.clear(ws, slot: nistLookedSlot + coordinate)
		end 'eachClear'

		for entry in 0 upto nistTableSize 'eachEntry'
			let mask = nistEqualMask(entry as WorkspaceLimb, b: digit)

			for coordinate in 0 upto nistCoordinates 'eachCoordinate'
				slots.accumulate(ws, dst: nistLookedSlot + coordinate, source: table + entry * nistCoordinates + coordinate, mask: mask)
			end 'eachCoordinate'
		end 'eachEntry'
	end 'selectEntry'

	function buildTable(ws WorkspaceLimbs, table Count, base Count)
		loadIdentity(ws, slot: table)
		copyPoint(ws, dst: table + nistCoordinates, src: base)

		for entry in 2 upto nistTableSize 'eachMultiple'
			addPoints(ws, result: table + entry * nistCoordinates, p: table + (entry - 1) * nistCoordinates, q: base)
		end 'eachMultiple'
	end 'buildTable'

	function scalarMultiply(ws WorkspaceLimbs, terms NistTerms, result Count)
		for (iter, term) in terms.withIterator() 'eachTable'
			buildTable(ws, table: nistTableAt(iter.index()), base: term.1)
		end 'eachTable'

		loadIdentity(ws, slot: result)
		let (leading, _) = try terms.first() otherwise panic("nist: a multiplication has a term")
		let windowCount = leading.count() * nistWindowsPerLimb

		for step in 0 upto windowCount 'eachWindow'
			let window = (windowCount - 1 - step) as WorkspaceLimb

			for _ in 0 upto nistWindowBits 'eachDoubling'
				doublePoint(ws, result: result, p: result)
			end 'eachDoubling'

			for (iter, term) in terms.withIterator() 'eachTerm'
				let limb = workspaceLimbAt(term.0, index: (window shr nistWindowsPerLimbShift) as ElementIndex)
				let digit = (limb shr ((window and nistWindowsPerLimbMask) * nistWindowBits)) and nistWindowMask
				selectEntry(ws, table: nistTableAt(iter.index()), digit: digit)
				addPoints(ws, result: result, p: result, q: nistLookedSlot)
			end 'eachTerm'
		end 'eachWindow'
	end 'scalarMultiply'

	function affine(ws WorkspaceLimbs, point Count) returns NistAffinePoint
		let field = self.primeField
		let inverse = nistTemporarySlot
		let x = nistTemporarySlot + 1
		let y = nistTemporarySlot + 2
		field.inverted(ws, dst: inverse, a: point + 2)
		field.multiply(ws, dst: x, a: point, b: inverse)
		field.multiply(ws, dst: y, a: point + 1, b: inverse)
		field.multiply(ws, dst: x, a: x, b: nistUnitSlot)
		field.multiply(ws, dst: y, a: y, b: nistUnitSlot)
		return (field.slots.read(ws, slot: x), field.slots.read(ws, slot: y))
	end 'affine'

	function multiplyAffine(scalar WorkspaceLimbs, point NistAffinePoint) returns NistAffinePoint
		var ws = workspace()
		loadPoint(ws, slot: nistPointBSlot, point: point)
		scalarMultiply(ws, terms: NistTerms from [(scalar.clone(), nistPointBSlot)], result: nistPointASlot)
		return affine(ws, point: nistPointASlot)
	end 'multiplyAffine'

	function scalar(value WorkspaceLimbs) returns WorkspaceLimbs throws NistRefusal
		if nistIsZero(value) or not self.scalarField.isBelow(value) 'outOfRange'
			throw NistRefusal.invalidEncoding
		end 'outOfRange'

		return value
	end 'scalar'

	function decodeScalar(bytes ByteArray) returns WorkspaceLimbs throws NistRefusal
		if bytes.count() != self.scalarBytes 'wrongLength'
			throw NistRefusal.invalidEncoding
		end 'wrongLength'

		return try scalar(nistLimbsFromBytes(bytes, start: 0, count: self.scalarBytes))
	end 'decodeScalar'

	function signatureScalar(content ByteArray) returns WorkspaceLimbs throws NistRefusal
		var padded = ByteArray.create()
		padded.reserve(self.scalarBytes)

		for byte in content 'eachByte'
			if padded.isEmpty() and byte == nistZeroByte 'leadingZero'
				continue
			end 'leadingZero'

			padded.push(byte)
		end 'eachByte'

		if padded.count() > self.scalarBytes 'tooLong'
			throw NistRefusal.invalidEncoding
		end 'tooLong'

		while padded.count() < self.scalarBytes 'eachPad'
			padded.insert(0, value: nistZeroByte)
		end 'eachPad'

		return try decodeScalar(padded)
	end 'signatureScalar'

	function decodePoint(bytes ByteArray) returns NistAffinePoint throws NistRefusal
		if bytes.count() != nistPointTagBytes + nistPointCoordinates * self.scalarBytes 'wrongLength'
			throw NistRefusal.invalidEncoding
		end 'wrongLength'

		let tag = try nistByte(bytes, index: 0)

		if tag != nistUncompressedTag 'notUncompressed'
			throw NistRefusal.invalidEncoding
		end 'notUncompressed'

		let x = nistLimbsFromBytes(bytes, start: nistPointTagBytes, count: self.scalarBytes)
		let y = nistLimbsFromBytes(bytes, start: nistPointTagBytes + self.scalarBytes, count: self.scalarBytes)

		if not self.primeField.isBelow(x) or not self.primeField.isBelow(y) 'nonCanonical'
			throw NistRefusal.invalidEncoding
		end 'nonCanonical'

		let field = self.primeField
		var ws = workspace()
		let xm = nistFirstFreeSlot
		let ym = nistFirstFreeSlot + 1
		let rightSide = nistFirstFreeSlot + 2
		let leftSide = nistFirstFreeSlot + 3
		field.loadMontgomery(ws, slot: xm, value: x)
		field.loadMontgomery(ws, slot: ym, value: y)
		field.multiply(ws, dst: rightSide, a: xm, b: xm)
		field.multiply(ws, dst: rightSide, a: rightSide, b: xm)
		field.triple(ws, dst: leftSide, a: xm)
		field.subtract(ws, dst: rightSide, a: rightSide, b: leftSide)
		field.add(ws, dst: rightSide, a: rightSide, b: nistCurveBSlot)
		field.multiply(ws, dst: leftSide, a: ym, b: ym)

		if not nistEqual(field.slots.read(ws, slot: leftSide), b: field.slots.read(ws, slot: rightSide)) 'offCurve'
			throw NistRefusal.invalidEncoding
		end 'offCurve'

		return (x, y)
	end 'decodePoint'

	function encodePoint(point NistAffinePoint) returns ByteArray
		var encoded = ByteArray.create()
		encoded.reserve(nistPointTagBytes + nistPointCoordinates * self.scalarBytes)
		encoded.push(nistUncompressedTag)
		encoded.append(nistBytesFromLimbs(point.0))
		encoded.append(nistBytesFromLimbs(point.1))
		return encoded
	end 'encodePoint'

	function digest(message ByteArray) returns WorkspaceLimbs
		var digest = Digest.create(self.hash)
		digest.update(message)
		return nistLimbsFromBytes(digest.finalize(), start: 0, count: self.scalarBytes)
	end 'digest'

	function verifies(q NistAffinePoint, message ByteArray, rContent ByteArray, sContent ByteArray) returns bool
		let r = try signatureScalar(rContent) otherwise return false
		let s = try signatureScalar(sContent) otherwise return false
		let order = self.scalarField
		var orderWs = order.workspace(nistFieldSlots)
		let sMontgomery = nistFirstFreeSlot
		let sInverse = nistFirstFreeSlot + 1
		let first = nistFirstFreeSlot + 2
		let second = nistFirstFreeSlot + 3
		order.loadMontgomery(orderWs, slot: sMontgomery, value: s)
		order.inverted(orderWs, dst: sInverse, a: sMontgomery)
		order.loadMontgomery(orderWs, slot: first, value: digest(message))
		order.multiply(orderWs, dst: first, a: first, b: sInverse)
		order.multiply(orderWs, dst: first, a: first, b: nistUnitSlot)
		order.loadMontgomery(orderWs, slot: second, value: r)
		order.multiply(orderWs, dst: second, a: second, b: sInverse)
		order.multiply(orderWs, dst: second, a: second, b: nistUnitSlot)

		var ws = workspace()
		loadPoint(ws, slot: nistPointBSlot, point: self.generator)
		loadPoint(ws, slot: nistPointCSlot, point: q)
		scalarMultiply(ws, terms: NistTerms from [(order.slots.read(orderWs, slot: first), nistPointBSlot), (order.slots.read(orderWs, slot: second), nistPointCSlot)], result: nistPointASlot)

		if nistIsZero(self.primeField.slots.read(ws, slot: nistPointASlot + 2)) 'infinity'
			return false
		end 'infinity'

		let (x, _) = affine(ws, point: nistPointASlot)
		return nistEqual(order.reduceOnce(x), b: r)
	end 'verifies'

	function signature(nonce WorkspaceLimbs, key WorkspaceLimbs, hashed WorkspaceLimbs) returns ByteArray throws NistRefusal
		let k = try scalar(nonce) otherwise throw NistRefusal.rejectedNonce
		let order = self.scalarField
		let (x, _) = multiplyAffine(k, point: self.generator)
		let r = order.reduceOnce(x)

		if nistIsZero(r) 'zeroR'
			throw NistRefusal.rejectedNonce
		end 'zeroR'

		var ws = order.workspace(nistFieldSlots)
		let kMontgomery = nistFirstFreeSlot
		let kInverse = nistFirstFreeSlot + 1
		let keyMontgomery = nistFirstFreeSlot + 2
		let rMontgomery = nistFirstFreeSlot + 3
		let hashMontgomery = nistFirstFreeSlot + 4
		order.loadMontgomery(ws, slot: kMontgomery, value: k)
		order.inverted(ws, dst: kInverse, a: kMontgomery)
		order.loadMontgomery(ws, slot: keyMontgomery, value: key)
		order.loadMontgomery(ws, slot: rMontgomery, value: r)
		order.loadMontgomery(ws, slot: hashMontgomery, value: hashed)
		order.multiply(ws, dst: keyMontgomery, a: keyMontgomery, b: rMontgomery)
		order.add(ws, dst: hashMontgomery, a: hashMontgomery, b: keyMontgomery)
		order.multiply(ws, dst: hashMontgomery, a: kInverse, b: hashMontgomery)
		order.multiply(ws, dst: hashMontgomery, a: hashMontgomery, b: nistUnitSlot)
		let s = order.slots.read(ws, slot: hashMontgomery)

		if nistIsZero(s) 'zeroS'
			throw NistRefusal.rejectedNonce
		end 'zeroS'

		var content = nistDerEncodedInteger(r)
		content.append(nistDerEncodedInteger(s))
		return derElement(nistDerSequenceTag, contents: content)
	end 'signature'

	function sign(privateKey ByteArray, message ByteArray) returns ByteArray throws EcdsaSignError
		let key = try decodeScalar(privateKey) otherwise throw EcdsaSignError.invalidPrivateKey
		return deterministicSignature(key, privateKey: privateKey, message: message)
	end 'sign'

	function deterministicSignature(key WorkspaceLimbs, privateKey ByteArray, message ByteArray) returns ByteArray
		let hashed = digest(message)
		let hashOctets = nistBytesFromLimbs(self.scalarField.reduceOnce(hashed))
		var nonceKey = ByteArray.create()
		nonceKey.growFilled(self.scalarBytes, value: nistZeroByte)
		var nonceValue = ByteArray.create()
		nonceValue.growFilled(self.scalarBytes, value: nistNonceOneByte)

		for separator in ByteArray from [nistZeroByte, nistNonceOneByte] 'eachSeed'
			var suffix = ByteArray from [separator]
			suffix.append(privateKey)
			suffix.append(hashOctets)
			(nonceKey, nonceValue) = nistNonceStep(self.hash, key: nonceKey, value: nonceValue, suffix: suffix)
		end 'eachSeed'

		while true 'eachCandidate'
			nonceValue = hmac(self.hash, key: nonceKey, message: nonceValue)
			let nonce = nistLimbsFromBytes(nonceValue, start: 0, count: self.scalarBytes)

			if let accepted = try signature(nonce, key: key, hashed: hashed) 'accepted'
				return accepted
			end 'accepted'

			(nonceKey, nonceValue) = nistNonceStep(self.hash, key: nonceKey, value: nonceValue, suffix: ByteArray from [nistZeroByte])
		end 'eachCandidate'
	end 'deterministicSignature'
end 'NistCurve'

module function nistPublicKey(curve EcdsaCurve, privateKey ByteArray) returns ByteArray throws EcdhError
	let nist = NistCurve.of(curve)
	let d = try nist.decodeScalar(privateKey) otherwise throw EcdhError.invalidPrivateKey

	return nist.encodePoint(nist.multiplyAffine(d, point: nist.generator))
end 'nistPublicKey'

/// Why `EcdhP256` refused a key.
public enum EcdhError implements Error
	invalidPrivateKey
	invalidPublicKey
end 'EcdhError'

/// Elliptic-curve Diffie-Hellman over NIST P-256 (SP 800-56A ECC CDH, cofactor 1).
public type EcdhP256
	/// The 65-byte uncompressed point `04 ‖ x ‖ y` of `d · G` for a 32-byte big-endian private key `d` in `[1, n - 1]`.
	public static function publicKey(privateKey ByteArray) returns ByteArray throws EcdhError
		return try nistPublicKey(EcdsaCurve.p256, privateKey: privateKey)
	end 'publicKey'

	/// The 32-byte x-coordinate of `d · Q` for a private key `d` and a validated uncompressed peer point `Q`.
	public static function sharedSecret(privateKey ByteArray, peerPublicKey ByteArray) returns ByteArray throws EcdhError
		let curve = NistCurve.of(EcdsaCurve.p256)
		let d = try curve.decodeScalar(privateKey) otherwise throw EcdhError.invalidPrivateKey
		let q = try curve.decodePoint(peerPublicKey) otherwise throw EcdhError.invalidPublicKey
		let (x, _) = curve.multiplyAffine(d, point: q)
		return nistBytesFromLimbs(x)
	end 'sharedSecret'
end 'EcdhP256'

/// A curve and hash pair `Ecdsa.verify` accepts: P-256 with SHA-256 or P-384 with SHA-384.
public enum EcdsaCurve
	p256
	p384
end 'EcdsaCurve'

/// Why `Ecdsa.verify` refused its input.
public enum EcdsaError implements Error
	invalidPublicKey
	invalidSignatureEncoding
end 'EcdsaError'

/// ECDSA signature verification (FIPS 186-5).
public type Ecdsa
	/// Whether the strict-DER `signature` is valid for `message` under the uncompressed point `publicKey`.
	public static function verify(curve EcdsaCurve, publicKey ByteArray, message ByteArray, signature ByteArray) returns bool throws EcdsaError
		let nist = NistCurve.of(curve)
		let q = try nist.decodePoint(publicKey) otherwise throw EcdsaError.invalidPublicKey
		let (r, s) = try nistParseSignature(signature) otherwise throw EcdsaError.invalidSignatureEncoding
		return nist.verifies(q, message: message, rContent: r, sContent: s)
	end 'verify'
end 'Ecdsa'

/// Why `EcdsaP256.sign` or `EcdsaP384.sign` refused a key.
public enum EcdsaSignError implements Error
	invalidPrivateKey
end 'EcdsaSignError'

/// Deterministic ECDSA signing on P-256 with SHA-256 (RFC 6979).
public type EcdsaP256
	/// The DER signature of `message` under a 32-byte private key, with the RFC 6979 nonce over HMAC-SHA-256.
	public static function sign(privateKey ByteArray, message ByteArray) returns ByteArray throws EcdsaSignError
		return try NistCurve.of(EcdsaCurve.p256).sign(privateKey, message: message)
	end 'sign'
end 'EcdsaP256'

/// Deterministic ECDSA signing on P-384 with SHA-384 (RFC 6979).
public type EcdsaP384
	/// The DER signature of `message` under a 48-byte private key, with the RFC 6979 nonce over
	/// HMAC-SHA-384.
	public static function sign(privateKey ByteArray, message ByteArray) returns ByteArray throws EcdsaSignError
		return try NistCurve.of(EcdsaCurve.p384).sign(privateKey, message: message)
	end 'sign'
end 'EcdsaP384'
