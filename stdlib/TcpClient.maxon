/// TCP client networking with automatic resource cleanup.
/// @category System
typealias NetworkPort = int(1 to 65535)

// Bytes sent or received in one call. Each is a length into a `ByteArray` the caller owns, so the
// backing `__ManagedMemory`'s signed machine-word length is the ceiling.
typealias BytePos = int(0 to u64.max)

// A deadline in milliseconds, `0` meaning none. The ceiling is a REAL bound and not a round number: the value
// becomes `now + milliseconds * 1_000_000` in signed 64-bit NANOSECONDS, so a count past about 9.2e12 ms wraps
// NEGATIVE and yields a deadline permanently in the past — every read would then time out instantly. 2^32 - 1
// ms is about 49 days, which is past any deadline a socket operation can mean and leaves four orders of
// magnitude of headroom under the wrap.
typealias Milliseconds = int(0 to 4294967295)

/// TCP networking errors
public enum NetworkError implements Error
	resolveFailed
	connectFailed
	sendFailed
	recvFailed
	connectionClosed
	timedOut
end 'NetworkError'

/// TCP client connection. Automatically closes when it goes out of scope.
public type TcpClient
	var socket as __ManagedSocket

	/// Connect to a TCP server by hostname and port.
	/// Resolves the hostname, creates a TCP socket, and connects.
	/// The returned TcpClient auto-closes when it goes out of scope.
	public static function connect(host String, port NetworkPort) returns TcpClient throws NetworkError
		let sock = try __ManagedSocket.tcpConnect(host.addressableBytes(), port: port) otherwise (e) 'connErr'
			match e 'matchConn'
				resolveFailed then throw NetworkError.resolveFailed
				default throws NetworkError.connectFailed
			end 'matchConn'
		end 'connErr'

		return TcpClient{socket: sock}
	end 'connect'

	/// Send all bytes of a string over this connection.
	/// Loops internally to handle partial sends.
	/// Returns the total number of bytes sent.
	public function send(data String) returns BytePos throws NetworkError
		// Materialized ONCE, outside the loop: a partial send drives this round again, and under
		// Stage 4b asking a short string for its bytes allocates and copies. Per-string, not per-send.
		let bytes = data.addressableBytes()
		var totalSent = 0
		var remaining = bytes.length()

		while remaining > 0 'send_loop'
			// bufferOutOfBounds is impossible here: remaining <= bytes.length() by loop invariant.
			let sent = try socket.sendFrom(bytes, totalSent, remaining) otherwise (e) 'sendErr'
				// The deadline is a PREDICATE on the socket, not a variant of the builtin error: it says
				// whether the call that just failed ran out of time rather than out of connection.
				if socket.timedOut() 'late'
					throw NetworkError.timedOut
				end 'late'

				match e 'matchSend'
					bufferOutOfBounds then panic("TcpClient.send: sendFrom OOB — loop invariant violated")
					default throws NetworkError.sendFailed
				end 'matchSend'
			end 'sendErr'

			if sent == 0 'closed'
				throw NetworkError.connectionClosed
			end 'closed'

			totalSent = totalSent + sent
			remaining = remaining - sent
		end 'send_loop'

		return totalSent
	end 'send'

	/// Receive data as a string (up to bufferSize bytes).
	/// Returns the received data. Throws connectionClosed if the peer closed.
	public function recv(bufferSize BytePos) returns String throws NetworkError
		var managed = try __ManagedMemory.create(bufferSize + 1, 1) otherwise 'createErr'
			panic("TcpClient.recv: create — bufferSize+1 >= 0 guaranteed")
		end 'createErr'

		let received = try socket.recv(managed) otherwise 'recvErr'
			// See `send` for why the deadline crosses as a predicate.
			if socket.timedOut() 'late'
				throw NetworkError.timedOut
			end 'late'

			throw NetworkError.recvFailed
		end 'recvErr'

		if received == 0 'closed'
			throw NetworkError.connectionClosed
		end 'closed'

		try managed.setLength(received) otherwise 'lenErr1'
			panic("TcpClient.recv: setLength(received) — received within buffer capacity")
		end 'lenErr1'

		// Null-terminate for C string compatibility
		try managed.setLength(received + 1) otherwise 'lenErr2'
			panic("TcpClient.recv: setLength(received+1) — extra byte allocated for null terminator")
		end 'lenErr2'

		try managed.setByte(received, 0) otherwise 'setErr'
			panic("TcpClient.recv: setByte at null terminator — length just extended to received+1")
		end 'setErr'

		try managed.setLength(received) otherwise 'lenErr3'
			panic("TcpClient.recv: setLength(received) — restoring original length always valid")
		end 'lenErr3'

		return String.init(managed)
	end 'recv'

	/// End a read that the peer leaves unanswered after `milliseconds`, with `NetworkError.timedOut`.
	/// `0` clears the deadline. It is measured from this call, not from the read that observes it.
	public function setReadDeadline(milliseconds Milliseconds) throws NetworkError
		// The only failure the setter has is a socket that is already closed.
		try socket.setReadDeadline(milliseconds) otherwise 'deadlineErr'
			throw NetworkError.connectionClosed
		end 'deadlineErr'
	end 'setReadDeadline'

	/// End a send that cannot make progress after `milliseconds`, with `NetworkError.timedOut`.
	/// `0` clears the deadline. It is measured from this call, not from the send that observes it.
	public function setWriteDeadline(milliseconds Milliseconds) throws NetworkError
		// See `setReadDeadline`.
		try socket.setWriteDeadline(milliseconds) otherwise 'deadlineErr'
			throw NetworkError.connectionClosed
		end 'deadlineErr'
	end 'setWriteDeadline'

	/// Explicitly close the connection.
	/// Safe to call multiple times (idempotent).
	/// Also called automatically when the last reference goes out of scope.
	public function close()
		socket.close()
	end 'close'
end 'TcpClient'
