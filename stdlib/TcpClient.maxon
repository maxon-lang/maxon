/// TCP client networking with automatic resource cleanup.
/// @category System
/// A TCP port number.
///
/// `0` is in range because it is what a `TcpListener.bind` asks for when it wants whichever free port the
/// kernel has; it is never the port of a live connection or of a bound listener, and `TcpClient.connect`
/// refuses it at the OS. ONE alias serves the bind, the connect and `TcpListener.port()` because a named
/// ranged alias is NOMINAL at a parameter (measured: an `int(1 to 65535)` argument is E3005 at an
/// `int(0 to 65535)` parameter, narrower or not) — and `port()`'s answer is passed to BOTH doors, so a
/// second, narrower alias would be a widening the language has no spelling for.
public typealias NetworkPort = int(0 to 65535)

/// The most bytes one `recv` returns. At least one: a read of zero bytes is how a closed peer is
/// reported.
public typealias RecvCapacity = int(1 to i64.max)

// A send goes to the OS in slices of this size. Windows takes one send of any size into the kernel at
// once, so an unsliced send to a peer that stops reading never waits and a write deadline never ends it.
let SendSliceBytes = 1048576

/// A socket deadline in milliseconds, `0` meaning none. The deadline is computed as
/// `now + milliseconds * 1_000_000` in signed 64-bit nanoseconds, which a count past about
/// 9.2e12 ms would wrap into the past, timing out every read at once; the ceiling of about 49 days
/// stays far below that.
public typealias SocketDeadlineMs = int(0 to 4294967295)

/// TCP networking errors
public enum NetworkError implements Error
	resolveFailed
	connectFailed
	sendFailed
	recvFailed
	connectionClosed
	timedOut
	bindFailed
	acceptFailed
	acceptInterrupted
end 'NetworkError'

/// TCP client connection. Automatically closes when it goes out of scope.
public type TcpClient
	var socket as __ManagedSocket

	/// Connect to a TCP server by hostname and port.
	/// Resolves the hostname, creates a TCP socket, and connects.
	/// The returned TcpClient auto-closes when it goes out of scope.
	public static function connect(host String, port NetworkPort) returns TcpClient throws NetworkError
		let sock = try __ManagedSocket.tcpConnect(host.addressableBytes(), port: port) otherwise (e) 'connErr'
			match e 'matchConn'
				resolveFailed then throw NetworkError.resolveFailed
				default throws NetworkError.connectFailed
			end 'matchConn'
		end 'connErr'

		return TcpClient{socket: sock}
	end 'connect'

	/// Adopt a socket that is already connected — the one `TcpListener.accept()` answers.
	/// The returned TcpClient auto-closes when it goes out of scope, exactly as a dialled one does.
	///
	/// It exists because a struct literal is only writable inside its own type (E3076), so the listener
	/// wrapper has no other way to hand back the peer type. The socket is the caller's to produce: the only
	/// producers are `tcpConnect` and `accept`, so no program can forge one.
	public static function adopt(socket __ManagedSocket) returns TcpClient
		return TcpClient{socket: socket}
	end 'adopt'

	/// Send all bytes of a string over this connection.
	/// Loops internally to handle partial sends.
	/// Returns the total number of bytes sent.
	public function send(data String) returns BytePos throws NetworkError
		// Materialized once, outside the loop: a partial send drives this round again, and asking a
		// short string for its bytes allocates and copies.
		let bytes = data.addressableBytes()
		var totalSent = 0
		var remaining = bytes.length()

		while remaining > 0 'send_loop'
			// bufferOutOfBounds is impossible here: remaining <= bytes.length() by loop invariant.
			let sent = try socket.sendFrom(bytes, totalSent, remaining if remaining < SendSliceBytes else SendSliceBytes) otherwise (e) 'sendErr'
				// The deadline is a PREDICATE on the socket, not a variant of the builtin error: it says
				// whether the call that just failed ran out of time rather than out of connection.
				if socket.timedOut() 'late'
					throw NetworkError.timedOut
				end 'late'

				match e 'matchSend'
					bufferOutOfBounds then panic("TcpClient.send: sendFrom OOB — loop invariant violated")
					default throws NetworkError.sendFailed
				end 'matchSend'
			end 'sendErr'

			if sent == 0 'closed'
				throw NetworkError.connectionClosed
			end 'closed'

			totalSent = totalSent + sent
			remaining = remaining - sent
		end 'send_loop'

		return totalSent
	end 'send'

	/// Receive data as a string (up to bufferSize bytes).
	/// Returns the received data. Throws connectionClosed if the peer closed.
	public function recv(bufferSize RecvCapacity) returns String throws NetworkError
		// Exactly `bufferSize`: `__ms_recv` fills the whole capacity, so any spare byte is a read that
		// may return more than the caller asked for.
		var managed = try __ManagedMemory.create(bufferSize, 1) otherwise 'createErr'
			panic("TcpClient.recv: create — bufferSize >= 0 guaranteed")
		end 'createErr'

		let received = try socket.recv(managed) otherwise 'recvErr'
			// See `send` for why the deadline crosses as a predicate.
			if socket.timedOut() 'late'
				throw NetworkError.timedOut
			end 'late'

			throw NetworkError.recvFailed
		end 'recvErr'

		if received == 0 'closed'
			throw NetworkError.connectionClosed
		end 'closed'

		try managed.setLength(received) otherwise 'lenErr'
			panic("TcpClient.recv: setLength(received) — received is within the buffer's capacity")
		end 'lenErr'

		return String.init(managed)
	end 'recv'

	/// End a read that the peer leaves unanswered after `milliseconds`, with `NetworkError.timedOut`.
	/// `0` clears the deadline. It is measured from this call, not from the read that observes it.
	public function setReadDeadline(milliseconds SocketDeadlineMs) throws NetworkError
		// The only failure the setter has is a socket that is already closed.
		try socket.setReadDeadline(milliseconds) otherwise 'deadlineErr'
			throw NetworkError.connectionClosed
		end 'deadlineErr'
	end 'setReadDeadline'

	/// End a send that cannot make progress after `milliseconds`, with `NetworkError.timedOut`.
	/// `0` clears the deadline. It is measured from this call, not from the send that observes it.
	public function setWriteDeadline(milliseconds SocketDeadlineMs) throws NetworkError
		// See `setReadDeadline`.
		try socket.setWriteDeadline(milliseconds) otherwise 'deadlineErr'
			throw NetworkError.connectionClosed
		end 'deadlineErr'
	end 'setWriteDeadline'

	/// Stop sending: the peer reads end-of-stream while this side can still `recv`. Throws
	/// `connectionClosed` when the socket is already closed.
	public function shutdownWrite() throws NetworkError
		try socket.shutdownWrite() otherwise (e) 'shutdownErr'
			match e 'why'
				closed then throw NetworkError.connectionClosed
				sendFailed then throw NetworkError.sendFailed
				default panic("TcpClient.shutdownWrite: `__ms_shutdown_write` raises only `closed` and `sendFailed`")
			end 'why'
		end 'shutdownErr'
	end 'shutdownWrite'

	/// Explicitly close the connection.
	/// Safe to call multiple times (idempotent).
	/// Also called automatically when the last reference goes out of scope.
	public function close()
		socket.close()
	end 'close'
end 'TcpClient'
