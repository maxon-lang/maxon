/// Structured logging. `Log.info("started")` writes through the program's default `LogSink`: a text
/// handler on standard error at INFO, stamping each record with its RFC 3339 UTC time to the
/// millisecond. A record is built only when its sink's level admits it. Replace the default with
/// `Log.setDefault(sink)`, or with a program's own `default LogSink = …` declaration.
/// @category System
public typealias LogInteger = int(i64.min to i64.max)
public typealias LogReal = float(f64.min to f64.max)
public typealias LogGroupPath = Array with String

public union LogValue
	text(value String)
	integer(value LogInteger)
	real(value LogReal)
	boolean(value bool)
end 'LogValue'

/// One attribute of a record: its key, the group path it sits under, and its value.
public type LogField
	public let groups as LogGroupPath
	public let key as String
	public let value as LogValue

	public static function create(key String, value LogValue, groups LogGroupPath) returns LogField
		return LogField{groups: groups, key: key, value: value}
	end 'create'

	/// The key behind its groups: `request.id` for `id` in group `request`.
	public function dottedKey() returns String
		var dotted = ""

		for group in self.groups 'eachGroup'
			dotted.append(group)
			dotted.append(".")
		end 'eachGroup'

		dotted.append(self.key)
		return dotted
	end 'dottedKey'

	function under(outer LogGroupPath) returns LogField
		var path = LogGroupPath.create()

		for group in outer 'eachOuter'
			path.push("{group}")
		end 'eachOuter'

		for group in self.groups 'eachInner'
			path.push("{group}")
		end 'eachInner'

		return LogField{groups: path, key: "{self.key}", value: self.value.clone()}
	end 'under'
end 'LogField'

public typealias LogFieldArray = Array with LogField

/// An attribute to attach to a record. `LogAttr.group` nests the attributes it is given under its
/// name.
public type LogAttr
	public let fields as LogFieldArray

	public static function string(key String, value String) returns LogAttr
		return LogAttr.single(key, value: LogValue.text(value))
	end 'string'

	public static function int(key String, value LogInteger) returns LogAttr
		return LogAttr.single(key, value: LogValue.integer(value))
	end 'int'

	public static function float(key String, value LogReal) returns LogAttr
		return LogAttr.single(key, value: LogValue.real(value))
	end 'float'

	public static function bool(key String, value bool) returns LogAttr
		return LogAttr.single(key, value: LogValue.boolean(value))
	end 'bool'

	public static function group(name String, attrs LogAttrArray) returns LogAttr
		var path = LogGroupPath.create()
		path.push(name)
		var collected = LogFieldArray.create()
		appendLogFields(attrs, groups: path, into: collected)
		return LogAttr{fields: collected}
	end 'group'

	static function single(key String, value LogValue) returns LogAttr
		var collected = LogFieldArray.create()
		collected.push(LogField.create(key, value: value, groups: LogGroupPath.create()))
		return LogAttr{fields: collected}
	end 'single'
end 'LogAttr'

public typealias LogAttrArray = Array with LogAttr

function appendLogFields(attrs LogAttrArray, groups LogGroupPath, into LogFieldArray)
	for attr in attrs 'eachAttr'
		for field in attr.fields 'eachField'
			into.push(field.under(groups))
		end 'eachField'
	end 'eachAttr'
end 'appendLogFields'

/// What a handler receives: the time, the level, the message, the attributes flattened by group,
/// and the file and line that logged it.
public type LogRecord
	public let time as UnixNanos
	public let level as LogLevel
	public let message as String
	public let attrs as LogFieldArray
	public let file as String
	public let line as SourceLineNumber

	public static function create(time UnixNanos, level LogLevel, message String, attrs LogFieldArray, file String, line SourceLineNumber) returns LogRecord
		return LogRecord{time: time, level: level, message: message, attrs: attrs, file: file, line: line}
	end 'create'
end 'LogRecord'

public typealias LogRank = int(i32.min to i32.max)

union LogLevelLabel
	named(text String)
	relative
end 'LogLevelLabel'

/// A severity, ordered by `rank`: `trace` -8, `debug` -4, `info` 0, `warn` 4, `error` 8. `create`
/// makes a level named relative to a standard one near it (`INFO+2`, `DEBUG-2`); `named` gives a
/// level its own name.
public type LogLevel
	public let rank as LogRank
	let label as LogLevelLabel

	public static let trace = LogLevel.create(-8)
	public static let debug = LogLevel.create(-4)
	public static let info = LogLevel.create(0)
	public static let warn = LogLevel.create(4)
	public static let error = LogLevel.create(8)

	public static function create(rank LogRank) returns LogLevel
		return LogLevel{rank: rank, label: LogLevelLabel.relative}
	end 'create'

	public static function named(name String, rank LogRank) returns LogLevel
		return LogLevel{rank: rank, label: LogLevelLabel.named(name)}
	end 'named'

	public function name() returns String
		return match self.label 'label'
			named(text) gives text
			relative gives relativeLevelName(self.rank)
		end 'label'
	end 'name'
end 'LogLevel'

function relativeLevelName(rank LogRank) returns String
	if rank >= LogLevel.error.rank 'error'
		return offsetLevelName("ERROR", offset: rank - LogLevel.error.rank)
	end 'error'

	if rank >= LogLevel.warn.rank 'warn'
		return offsetLevelName("WARN", offset: rank - LogLevel.warn.rank)
	end 'warn'

	if rank >= LogLevel.info.rank 'info'
		return offsetLevelName("INFO", offset: rank - LogLevel.info.rank)
	end 'info'

	if rank > LogLevel.trace.rank 'debug'
		return offsetLevelName("DEBUG", offset: rank - LogLevel.debug.rank)
	end 'debug'

	return offsetLevelName("TRACE", offset: rank - LogLevel.trace.rank)
end 'relativeLevelName'

function offsetLevelName(base String, offset LogRank) returns String
	if offset == 0 'exact'
		return base
	end 'exact'

	if offset > 0 'above'
		return "{base}+{offset}"
	end 'above'

	return "{base}{offset}"
end 'offsetLevelName'

typealias LogLevelOverrides = Map with (String, LogLevel)

union LogLevelChange
	minimum(level LogLevel)
	group(name String, level LogLevel)
	cleared(name String)
end 'LogLevelChange'

/// A minimum level and per-group overrides. Immutable: each `with…` method returns a changed copy.
public type LogLevels
	let floor as LogLevel
	let overrides as LogLevelOverrides

	public static function minimum(level LogLevel) returns LogLevels
		return LogLevels{floor: level, overrides: LogLevelOverrides.create()}
	end 'minimum'

	public function level() returns LogLevel
		return self.floor
	end 'level'

	public function groupLevel(group String) returns LogLevel
		return try self.overrides.get(group) otherwise self.floor
	end 'groupLevel'

	public function enables(level LogLevel) returns bool
		return level.rank >= self.floor.rank
	end 'enables'

	public function withLevel(level LogLevel) returns LogLevels
		return LogLevels{floor: level, overrides: self.overrides}
	end 'withLevel'

	public function withGroupLevel(group String, level LogLevel) returns LogLevels
		var changed = self.copiedOverrides()
		changed.upsert(group, value: level)
		return LogLevels{floor: self.floor, overrides: changed}
	end 'withGroupLevel'

	public function withoutGroupLevel(group String) returns LogLevels
		var changed = self.copiedOverrides()
		_ = changed.remove(group)
		return LogLevels{floor: self.floor, overrides: changed}
	end 'withoutGroupLevel'

	function copiedOverrides() returns LogLevelOverrides
		var copied = LogLevelOverrides.create()

		for (group, level) in self.overrides 'eachOverride'
			copied.upsert(group, value: level)
		end 'eachOverride'

		return copied
	end 'copiedOverrides'

	function enablesIn(level LogLevel, groupKeys LogGroupPath) returns bool
		for key in groupKeys 'mostSpecificFirst'
			if let override = try self.overrides.get(key) 'overridden'
				return level.rank >= override.rank
			end 'overridden'
		end 'mostSpecificFirst'

		return self.enables(level)
	end 'enablesIn'

	function applying(change LogLevelChange) returns LogLevels
		match change 'change'
			minimum(level) then return self.withLevel(level)
			group(name, level) then return self.withGroupLevel(name, level: level)
			cleared(name) then return self.withoutGroupLevel(name)
		end 'change'
	end 'applying'
end 'LogLevels'

/// The live levels one handler shares with every `Logger` built over it.
public typealias LogLevelVar = SharedValue with LogLevels

/// A handler and its levels, registered together as one `default`. A level set through a sink
/// applies to the next call on every thread and every `Logger` sharing it.
public type LogSink
	public let handler as LogHandler.handle
	public let levels as LogLevelVar

	public static function create(handler LogHandler.handle, levels LogLevelVar) returns LogSink
		return LogSink{handler: handler, levels: levels}
	end 'create'

	public function enabled(level LogLevel) returns bool
		return self.levels.current().enables(level)
	end 'enabled'

	public function level() returns LogLevel
		return self.levels.current().level()
	end 'level'

	public function groupLevel(group String) returns LogLevel
		return self.levels.current().groupLevel(group)
	end 'groupLevel'

	public function setLevel(level LogLevel)
		self.change(LogLevelChange.minimum(level))
	end 'setLevel'

	/// Overrides the level for records logged in `group` and in the groups nested under it.
	public function setGroupLevel(group String, level LogLevel)
		self.change(LogLevelChange.group(group, level: level))
	end 'setGroupLevel'

	public function clearGroupLevel(group String)
		self.change(LogLevelChange.cleared(group))
	end 'clearGroupLevel'

	// Read-copy-update: when another thread's change lands first, this one is applied again on top of
	// it. A plain `publish` would drop that change.
	function change(update LogLevelChange)
		while true 'untilItLands'
			let old = self.levels.current()

			if self.levels.publish(old.applying(update), replacing: old) 'landed'
				return
			end 'landed'
		end 'untilItLands'
	end 'change'

	function write(level LogLevel, message String, bound LogFieldArray, attrs LogAttrArray, groups LogGroupPath, file String, line SourceLineNumber)
		let record = ownedLogRecord(level, message: message, bound: bound, attrs: attrs, groups: groups, file: file, line: line)

		// An error waits for its own write. The handler's mailbox is first in, first out, so every
		// earlier record is written too, and a panic right after the call loses none of them.
		if level.rank >= LogLevel.error.rank 'waitsUntilWritten'
			try await self.handler.handle(record) otherwise ignore
		end 'waitsUntilWritten' else 'sendsAndForgets'
			_ = self.handler.handle(record)
		end 'sendsAndForgets'
	end 'write'
end 'LogSink'

function ownedLogRecord(level LogLevel, message String, bound LogFieldArray, attrs LogAttrArray, groups LogGroupPath, file String, line SourceLineNumber) returns LogRecord
	var fields = LogFieldArray.create()

	for field in bound 'eachBound'
		fields.push(field.clone())
	end 'eachBound'

	appendLogFields(attrs, groups: groups, into: fields)
	return LogRecord.create(WallClock.nowUnixNanos(), level: level.clone(), message: "{message}", attrs: fields, file: "{file}", line: line)
end 'ownedLogRecord'

default LogSink = LogSink.create(spawn TextLogHandler.create(LogHandlerOptions.standard()), levels: LogLevelVar.create(LogLevels.minimum(LogLevel.info)))

/// The program's default logger. Each call reads the current `LogSink`. `error`, and `log` at
/// `error` or above, returns once its line and every record logged before it are written.
public type Log
	/// Logs `message` at `level`. `file` and `line` default to the caller's; a wrapper forwards its
	/// own so the record names the wrapper's caller.
	public static function log(level LogLevel, message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		let sink = LogSink.current()

		if sink.enabled(level) 'enabled'
			sink.write(level, message: message, bound: LogFieldArray.create(), attrs: attrs, groups: LogGroupPath.create(), file: file, line: line)
		end 'enabled'
	end 'log'

	public static function trace(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		Log.log(LogLevel.trace, message: message, attrs: attrs, file: file, line: line)
	end 'trace'

	public static function debug(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		Log.log(LogLevel.debug, message: message, attrs: attrs, file: file, line: line)
	end 'debug'

	public static function info(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		Log.log(LogLevel.info, message: message, attrs: attrs, file: file, line: line)
	end 'info'

	public static function warn(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		Log.log(LogLevel.warn, message: message, attrs: attrs, file: file, line: line)
	end 'warn'

	public static function error(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		Log.log(LogLevel.error, message: message, attrs: attrs, file: file, line: line)
	end 'error'

	public static function enabled(level LogLevel) returns bool
		return LogSink.current().enabled(level)
	end 'enabled'

	/// Makes `sink` the default for every thread's next call; its handler brings its own levels.
	public static function setDefault(sink LogSink)
		LogSink.register(sink.clone())
	end 'setDefault'

	/// A `Logger` over the current sink. It keeps that sink when the default is replaced, and follows
	/// its level changes.
	public static function default() returns Logger
		return Logger.over(LogSink.current())
	end 'default'

	public static function level() returns LogLevel
		return LogSink.current().level()
	end 'level'

	public static function groupLevel(group String) returns LogLevel
		return LogSink.current().groupLevel(group)
	end 'groupLevel'

	public static function setLevel(level LogLevel)
		LogSink.current().setLevel(level)
	end 'setLevel'

	public static function setGroupLevel(group String, level LogLevel)
		LogSink.current().setGroupLevel(group, level: level)
	end 'setGroupLevel'

	public static function clearGroupLevel(group String)
		LogSink.current().clearGroupLevel(group)
	end 'clearGroupLevel'
end 'Log'

/// A logger over one sink that adds its bound attributes and group path to every record it writes.
public type Logger
	let sink as LogSink
	let bound as LogFieldArray
	let groups as LogGroupPath
	let levelKeys as LogGroupPath

	static function over(sink LogSink) returns Logger
		return Logger{sink: sink, bound: LogFieldArray.create(), groups: LogGroupPath.create(), levelKeys: LogGroupPath.create()}
	end 'over'

	/// A logger that adds `attrs` to every record.
	public function withAttrs(attrs LogAttrArray) returns Logger
		var extended = self.bound.clone()
		appendLogFields(attrs, groups: self.groups, into: extended)
		return Logger{sink: self.sink, bound: extended, groups: self.groups, levelKeys: self.levelKeys}
	end 'withAttrs'

	/// A logger that nests every later attribute under `name`. Its records obey the level set for that
	/// group, the most deeply nested override winning.
	public function withGroup(name String) returns Logger
		var nestedKeys = self.levelKeys.clone()

		if let outer = try self.levelKeys.get(0) 'insideAGroup'
			nestedKeys.insert(0, value: "{outer}.{name}")
		end 'insideAGroup' else 'outermost'
			nestedKeys.insert(0, value: name)
		end 'outermost'

		var nested = self.groups.clone()
		nested.push(name)
		return Logger{sink: self.sink, bound: self.bound, groups: nested, levelKeys: nestedKeys}
	end 'withGroup'

	public function enabled(level LogLevel) returns bool
		return self.sink.levels.current().enablesIn(level, groupKeys: self.levelKeys)
	end 'enabled'

	public function level() returns LogLevel
		return self.sink.level()
	end 'level'

	public function groupLevel(group String) returns LogLevel
		return self.sink.groupLevel(group)
	end 'groupLevel'

	public function setLevel(level LogLevel)
		self.sink.setLevel(level)
	end 'setLevel'

	public function setGroupLevel(group String, level LogLevel)
		self.sink.setGroupLevel(group, level: level)
	end 'setGroupLevel'

	public function clearGroupLevel(group String)
		self.sink.clearGroupLevel(group)
	end 'clearGroupLevel'

	public function log(level LogLevel, message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		if self.enabled(level) 'enabled'
			self.sink.write(level, message: message, bound: self.bound, attrs: attrs, groups: self.groups, file: file, line: line)
		end 'enabled'
	end 'log'

	public function trace(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		self.log(LogLevel.trace, message: message, attrs: attrs, file: file, line: line)
	end 'trace'

	public function debug(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		self.log(LogLevel.debug, message: message, attrs: attrs, file: file, line: line)
	end 'debug'

	public function info(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		self.log(LogLevel.info, message: message, attrs: attrs, file: file, line: line)
	end 'info'

	public function warn(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		self.log(LogLevel.warn, message: message, attrs: attrs, file: file, line: line)
	end 'warn'

	public function error(message String, attrs LogAttrArray = LogAttrArray.create(), file String = __file__, line SourceLineNumber = __line__)
		self.log(LogLevel.error, message: message, attrs: attrs, file: file, line: line)
	end 'error'
end 'Logger'
