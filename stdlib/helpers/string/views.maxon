// String iteration views for byte, codepoint, and UTF-16 access.
//
// Each view implements Iterable (factory): view.createIterator() returns a
// fresh Iterator positioned at the first element (or throws on empty).
// The view itself is cheap to construct — creating a view does not throw.
// All iterators maintain the Iterator invariant: current() is infallible;
// advance() throws IterationError.exhausted at end.
//
// A view and its iterator hold the `String`, not its `__ManagedMemory`, and this is the whole
// reason they were touched in Stage 4b-1b. A record reference here ESCAPES THE FRAME — the view
// outlives the `s.bytes()` call that made it — so under 4b-2, where a small `String` is a 16-byte
// VALUE with no record, the field would have to be MATERIALIZED to be stored, and the caller-frame
// spill that makes `byteAt` work cannot reach a field that outlives the frame. A `String` field is
// the value itself: 16 bytes, copied, nothing allocated. Same reasoning as `StringIterator`.
//
// The cost lands on `Character.bytes()` / `Character.codepoints()`, whose source is a Character —
// a record forever, unaffected by 4b-2 — and which now pay a `toString()` to be iterated. That is
// the right side to charge: a Character holds one grapheme and is rarely iterated byte-wise, while
// String iteration is everywhere and is exactly what SSO exists to make free.

// BytePos is exported by stdlib/String.maxon.
// Both are counts over ONE string's bytes: a codepoint spends 1-4 UTF-8 bytes, and the codepoints
// needing two UTF-16 units are exactly the ones spending four. So neither count can exceed the byte
// length, which is bounded by the string's `__ManagedMemory` length — a signed machine word.
typealias CodepointCount = int(0 to i64.max)
typealias Utf16UnitCount = int(0 to i64.max)
typealias Byte = int(0 to u8.max)

// ============================================
// ByteView / ByteIterator — iterate over raw UTF-8 bytes
// ============================================

public type ByteView implements Iterable with (Byte, ByteIterator)
	var s as String

	public static function create(s String) returns ByteView
		return ByteView{s: s}
	end 'create'

	public function createIterator() returns ByteIterator throws IterationError
		return try ByteIterator.create(s)
	end 'createIterator'

	/// Number of bytes
	public function count() returns BytePos
		return s.byteLength()
	end 'count'
end 'ByteView'

public type ByteIterator implements Iterator with Byte
	var s as String
	var pos as BytePos
	var currentByte as Byte

	public static function create(s String) returns Self throws IterationError
		if s.byteLength() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		let firstByte = try s.byteAt(0) otherwise 'byteErr'
			panic("ByteIterator.create: string empty after length check — impossible")
		end 'byteErr'
		return Self{s: s, pos: 0, currentByte: firstByte}
	end 'create'

	public function current() returns Byte
		return currentByte
	end 'current'

	public function advance() throws IterationError
		let nextPos = pos + 1
		if nextPos >= s.byteLength() 'done'
			throw IterationError.exhausted
		end 'done'
		pos = nextPos
		currentByte = try s.byteAt(pos) otherwise 'byteErr'
			panic("ByteIterator.advance: nextPos just validated as < length — impossible")
		end 'byteErr'
	end 'advance'
end 'ByteIterator'

// ============================================
// CodepointView / CodepointIterator — iterate over Unicode codepoints
// ============================================

public type CodepointView implements Iterable with (Codepoint, CodepointIterator)
	var s as String

	public static function create(s String) returns CodepointView
		return CodepointView{s: s}
	end 'create'

	public function createIterator() returns CodepointIterator throws IterationError
		return try CodepointIterator.create(s)
	end 'createIterator'

	/// Number of codepoints (linear scan)
	public function count() returns CodepointCount
		var count = 0
		var pos = 0
		let len = s.byteLength()
		while pos < len 'count_loop'
			let bytes = utf8ByteLengthAt(s, pos: pos)
			pos = pos + bytes
			count = count + 1
		end 'count_loop'
		return count
	end 'count'
end 'CodepointView'

public type CodepointIterator implements Iterator with Codepoint
	var s as String
	var pos as BytePos
	var cp as Codepoint
	var cpByteLen as ByteWidth

	public static function create(s String) returns Self throws IterationError
		if s.byteLength() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		let cp = utf8DecodeAt(s, pos: 0)
		let len = utf8ByteLengthAt(s, pos: 0)
		return Self{s: s, pos: 0, cp: cp, cpByteLen: len}
	end 'create'

	public function current() returns Codepoint
		return cp
	end 'current'

	public function advance() throws IterationError
		let nextPos = pos + (cpByteLen as BytePos)
		if nextPos >= s.byteLength() 'done'
			throw IterationError.exhausted
		end 'done'
		pos = nextPos
		cp = utf8DecodeAt(s, pos: pos)
		cpByteLen = utf8ByteLengthAt(s, pos: pos)
	end 'advance'
end 'CodepointIterator'

// ============================================
// UTF16View / UTF16Iterator — iterate over UTF-16 code units
// ============================================
// Supplementary codepoints (cp >= 0x10000) require two UTF-16 code units:
// a lead surrogate followed by a trail surrogate. The iterator tracks a
// two-state position:
//   onTrailSurrogate = false → current() returns the BMP cp or the lead surrogate
//   onTrailSurrogate = true  → current() returns the trail surrogate of the pending supplementary

public type UTF16View implements Iterable with (CodeUnit16, UTF16Iterator)
	var s as String

	public static function create(s String) returns UTF16View
		return UTF16View{s: s}
	end 'create'

	public function createIterator() returns UTF16Iterator throws IterationError
		return try UTF16Iterator.create(s)
	end 'createIterator'

	/// Number of UTF-16 code units (linear scan)
	public function count() returns Utf16UnitCount
		var count = 0
		var pos = 0
		let len = s.byteLength()
		while pos < len 'count_loop'
			let cp = utf8DecodeAt(s, pos: pos)
			let bytes = utf8ByteLengthAt(s, pos: pos)
			pos = pos + bytes
			if cp < 65536 'bmp'
				count = count + 1
			end 'bmp' else 'supplementary'
				count = count + 2
			end 'supplementary'
		end 'count_loop'
		return count
	end 'count'
end 'UTF16View'

public type UTF16Iterator implements Iterator with CodeUnit16
	var s as String
	var bytePos as BytePos
	var cp as Codepoint
	var cpByteLen as ByteWidth
	var onTrailSurrogate as bool

	public static function create(s String) returns Self throws IterationError
		if s.byteLength() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		let cp = utf8DecodeAt(s, pos: 0)
		let len = utf8ByteLengthAt(s, pos: 0)
		return Self{s: s, bytePos: 0, cp: cp, cpByteLen: len, onTrailSurrogate: false}
	end 'create'

	public function current() returns CodeUnit16
		if onTrailSurrogate 'trail'
			return utf16TrailSurrogate(cp)
		end 'trail'
		if cp < 65536 'bmp'
			return cp
		end 'bmp'
		return utf16LeadSurrogate(cp)
	end 'current'

	public function advance() throws IterationError
		if not onTrailSurrogate and cp >= 65536 'emitTrail'
			onTrailSurrogate = true
			return
		end 'emitTrail'
		let nextPos = bytePos + (cpByteLen as BytePos)
		if nextPos >= s.byteLength() 'done'
			throw IterationError.exhausted
		end 'done'
		bytePos = nextPos
		cp = utf8DecodeAt(s, pos: bytePos)
		cpByteLen = utf8ByteLengthAt(s, pos: bytePos)
		onTrailSurrogate = false
	end 'advance'
end 'UTF16Iterator'
