// UTF-8 utility functions for string processing

typealias Byte = int(0 to u8.max)
public typealias ByteWidth = int(1 to 4)

// BytePos exported by stdlib/String.maxon.

// UTF-8 encoding:
//   1-byte (ASCII):  0xxxxxxx         (0x00-0x7F)
//   2-byte:          110xxxxx 10xxxxxx (0x80-0x7FF)
//   3-byte:          1110xxxx 10xxxxxx 10xxxxxx (0x800-0xFFFF)
//   4-byte:          11110xxx 10xxxxxx 10xxxxxx 10xxxxxx (0x10000-0x10FFFF)

// ⭐ **THE PAYLOAD MASKS AND THE CONTINUATION SHIFT, NAMED — `utf8DecodeAt` USED TO SPELL THEM AS `mod`
// AND MULTIPLY, AND THAT COST AN INTEGER DIVISION PER BYTE.** `(b mod 64)` and `(b and 63)` are the same
// number for every `b` a `Byte` can hold (both operands non-negative, the divisor a power of two), and
// `* 64` and `shl 6` likewise — but a compiler cannot fold `mod` to a mask without proving the dividend
// non-negative, so the emitted code carried a `cqo`/`idiv` pair per continuation byte on a function every
// grapheme scan calls once per codepoint. The mask/shift spelling is what `stdlib/Character.maxon:134-140`
// already uses for this identical decode; these constants are so the two read as one algorithm.
let Utf8ContinuationShift = 6
let Utf8ContinuationMask = 63

// The payload bits each multi-byte LEAD byte carries, below its length tag: `110xxxxx`, `1110xxxx`,
// `11110xxx`.
let Utf8TwoByteLeadMask = 31
let Utf8ThreeByteLeadMask = 15
let Utf8FourByteLeadMask = 7

/// Get the number of bytes in a UTF-8 sequence from its lead byte
/// Returns 1-4 for valid lead bytes
public function utf8ByteLength(leadByte Byte) returns ByteWidth
	// ASCII (0xxxxxxx)
	if leadByte < 128 'ascii'
		return 1
	end 'ascii'

	// Invalid continuation byte or overlong encoding
	if leadByte < 192 'invalid'
		return 1
	end 'invalid'

	// 2-byte sequence (110xxxxx)
	if leadByte < 224 'two_byte'
		return 2
	end 'two_byte'

	// 3-byte sequence (1110xxxx)
	if leadByte < 240 'three_byte'
		return 3
	end 'three_byte'

	// 4-byte sequence (11110xxx)
	return 4
end 'utf8ByteLength'

/// Check if a byte is a UTF-8 continuation byte (10xxxxxx)
public function utf8IsContinuation(b Byte) returns bool
	return b >= 128 and b < 192
end 'utf8IsContinuation'

/// Check if a byte is a valid UTF-8 lead byte
public function utf8IsLead(b Byte) returns bool
	// Lead byte is either ASCII (< 128) or starts with 11xxxxxx (>= 192)
	return b < 128 or b >= 192
end 'utf8IsLead'

/// Check if a byte is ASCII (0-127)
public function utf8IsAscii(b Byte) returns bool
	return b < 128
end 'utf8IsAscii'

/// Get the number of bytes needed to encode a codepoint in UTF-8
public function utf8EncodeLength(codepoint Codepoint) returns ByteWidth
	if codepoint < 128 'ascii'
		return 1
	end 'ascii'

	if codepoint < 2048 'two_byte'
		return 2
	end 'two_byte'

	if codepoint < 65536 'three_byte'
		return 3
	end 'three_byte'

	return 4
end 'utf8EncodeLength'

/// Is this codepoint one UTF-8 may encode? Answers false for the surrogate pairs (0xD800-0xDFFF),
/// which are a UTF-16 encoding artefact and are not scalar values.
///
/// ⚠ **IT DOES NOT ANSWER FOR A VALUE OUTSIDE `Codepoint` — SUCH A VALUE CANNOT ARRIVE.** The doc
/// here used to promise *"returns false for negative values, values > 0x10FFFF"* and the body
/// carried `cp < 0 or cp > 1114111` to keep it. Neither half can run: `Codepoint` is
/// `int(0 to 1114111)` (`stdlib/Character.maxon`), a NARROWED range, so its parameter is guarded at
/// this function's own ENTRY — MEASURED, a laundered `-1` panics `Range check failed: value outside
/// typealias 'Codepoint'` in `utf8IsValidCodepoint`, uncatchably, before the first statement runs.
/// A promise the door makes unkeepable is worse than no promise, and a dead disjunct is not a guard
/// — the same reading that emptied `Array.isOutsideLiveRange`'s negative half.
///
/// ⇒ The bound `1114111` is therefore stated ONCE, on `Codepoint`. It used to be written here too,
/// in another file, with nothing comparing the two.
public function utf8IsValidCodepoint(cp Codepoint) returns bool
	// Exclude surrogate pairs
	if cp >= 55296 and cp <= 57343 'surrogate_check'
		return false
	end 'surrogate_check'

	return true
end 'utf8IsValidCodepoint'

// ============================================
// String helpers (for internal use by string views and grapheme scanning)
// ============================================
//
// These take the `String`, not its `__ManagedMemory`, and reach its bytes only through
// `String.byteAt` — the inline primitive. Stage 4b-2 makes a small `String` a 16-byte VALUE with no
// record to hand out, so a `__ManagedMemory` parameter here would force one to be MATERIALIZED per
// call: `utf8DecodeAt` is called once per codepoint by every grapheme scan in the stdlib, so that
// would be an allocation per codepoint. See `String.byteAt`'s doc for the whole rule.

// ⭐⭐ **A LEAD BYTE MAY NOT PROMISE MORE BYTES THAN THE BUFFER HOLDS.** `String.from(bytes)` is the one
// door arbitrary bytes reach these decoders through — every other producer of a `String` is well-formed by
// construction (a literal is lexer-validated, a slice is grapheme-aligned, `replace`/`split` rebuild from
// valid pieces) — so a truncated sequence is a REACHABLE input and not a corrupt-memory signal.
//
// **A sequence the buffer cannot complete decodes as its own lead byte and advances ONE**, so no read
// leaves the buffer and no legal program is refused. These two functions must agree on that rule to the
// byte: `utf8ByteLengthAt` is what advances the scan and `utf8DecodeAt` is what reads it, so a width one of
// them takes and the other declines would step INTO a sequence it had just declined to decode.
//
// ⚠ **THIS USED TO `panic`, AND THE PANIC WAS NOT A SAFETY PROPERTY — IT WAS THE ABSENCE OF ONE.** Reaching
// `byteAt(pos + 2)` on a two-byte buffer is already the out-of-bounds question being asked too late; the
// throw merely reported it. Asking about the WIDTH first means the read never happens.
// `specs-shv2/string-views.md`'s `truncated-sequences-stop-at-the-buffer-end` is the pin, and it exists
// because maxon-shv2's segmenter had this rule while this file did not.
function utf8WidthFits(s String, pos BytePos, width ByteWidth) returns bool
	return pos + (width as BytePos) <= s.byteLength()
end 'utf8WidthFits'

/// Get the UTF-8 sequence length from the lead byte at `pos`
public function utf8ByteLengthAt(s String, pos BytePos) returns ByteWidth
	let b0 = try s.byteAt(pos) otherwise 'b0Err'
		panic("utf8ByteLengthAt: pos out of bounds — caller guarantees valid position")
	end 'b0Err'
	if b0 < 128 'ascii'
		return 1
	end 'ascii'
	if b0 < 224 'two'
		if utf8WidthFits(s, pos: pos, width: 2) 'twoFits'
			return 2
		end 'twoFits'
		return 1
	end 'two'
	if b0 < 240 'three'
		if utf8WidthFits(s, pos: pos, width: 3) 'threeFits'
			return 3
		end 'threeFits'
		return 1
	end 'three'
	if utf8WidthFits(s, pos: pos, width: 4) 'fourFits'
		return 4
	end 'fourFits'
	return 1
end 'utf8ByteLengthAt'

/// Decode the UTF-8 codepoint at the given byte position
public function utf8DecodeAt(s String, pos BytePos) returns Codepoint
	let b0 = try s.byteAt(pos) otherwise 'b0Err'
		panic("utf8DecodeAt: pos out of bounds — caller guarantees valid position")
	end 'b0Err'
	if b0 < 128 'ascii'
		return b0
	end 'ascii'
	// A lead the buffer cannot complete decodes as ITSELF and the scan advances one — see `utf8WidthFits`.
	// The width test comes BEFORE the read, which is what makes the read unnecessary rather than merely
	// checked.
	if b0 < 224 'two'
		if not utf8WidthFits(s, pos: pos, width: 2) 'twoTruncated'
			return b0
		end 'twoTruncated'
		let b1 = try s.byteAt(pos + 1) otherwise 'b1Err'
			panic("utf8DecodeAt: 2-byte seq continuation out of bounds")
		end 'b1Err'
		return ((b0 and Utf8TwoByteLeadMask) shl Utf8ContinuationShift) or (b1 and Utf8ContinuationMask)
	end 'two'
	if b0 < 240 'three'
		if not utf8WidthFits(s, pos: pos, width: 3) 'threeTruncated'
			return b0
		end 'threeTruncated'
		let b1 = try s.byteAt(pos + 1) otherwise 'b1Err2'
			panic("utf8DecodeAt: 3-byte seq byte 1 out of bounds")
		end 'b1Err2'
		let b2 = try s.byteAt(pos + 2) otherwise 'b2Err'
			panic("utf8DecodeAt: 3-byte seq byte 2 out of bounds")
		end 'b2Err'
		return ((b0 and Utf8ThreeByteLeadMask) shl (Utf8ContinuationShift * 2)) or ((b1 and Utf8ContinuationMask) shl Utf8ContinuationShift) or (b2 and Utf8ContinuationMask)
	end 'three'
	if not utf8WidthFits(s, pos: pos, width: 4) 'fourTruncated'
		return b0
	end 'fourTruncated'
	let b1 = try s.byteAt(pos + 1) otherwise 'b1Err3'
		panic("utf8DecodeAt: 4-byte seq byte 1 out of bounds")
	end 'b1Err3'
	let b2 = try s.byteAt(pos + 2) otherwise 'b2Err2'
		panic("utf8DecodeAt: 4-byte seq byte 2 out of bounds")
	end 'b2Err2'
	let b3 = try s.byteAt(pos + 3) otherwise 'b3Err'
		panic("utf8DecodeAt: 4-byte seq byte 3 out of bounds")
	end 'b3Err'
	return ((b0 and Utf8FourByteLeadMask) shl (Utf8ContinuationShift * 3)) or ((b1 and Utf8ContinuationMask) shl (Utf8ContinuationShift * 2)) or ((b2 and Utf8ContinuationMask) shl Utf8ContinuationShift) or (b3 and Utf8ContinuationMask)
end 'utf8DecodeAt'
