/// The AES block cipher (FIPS 197) with 128-, 192- and 256-bit keys, and its counter-mode key stream.
/// @category Crypto
export typealias AesWord = bits(64)
export typealias AesPair = (AesWord, AesWord)

/// The 32-bit big-endian block counter of AES counter mode.
public typealias AesCounter = int(0 to u32.max)

/// Why `Aes` refused a key or a block.
public enum AesError implements Error
	invalidKeyLength
	invalidBlockLength
end 'AesError'

/// Why `Aes.xorKeyStream` refused a nonce or a length.
public enum AesKeyStreamError implements Error
	invalidNonceLength
	counterOverflow
end 'AesKeyStreamError'

union AesBacking
	bitsliced(cipher AesBitsliced)

	#if not arch(wasm32)
		hardware(schedule ByteArray)
	#endif
end 'AesBacking'

export function aesHardwareAvailable() returns bool
	#if not arch(wasm32)
		return __Builtins.cpuHasAes()
	#else
		return false
	#endif
end 'aesHardwareAvailable'

/// An AES key schedule, ready to encrypt and decrypt 16-byte blocks in constant time.
public type Aes
	let backing as AesBacking

	/// The cipher for a 16-, 24- or 32-byte `key` (AES-128, AES-192 or AES-256).
	public static function create(key ByteArray) returns Aes throws AesError
		#if not arch(wasm32)
			if aesHardwareAvailable() 'hardware'
				try aesRequireKeyLength(key)

				return Self{backing: AesBacking.hardware(aesHardwareSchedule(key))}
			end 'hardware'
		#endif

		return Self{backing: AesBacking.bitsliced(try AesBitsliced.create(key))}
	end 'create'

	/// The encryption of one 16-byte block.
	public function encryptBlock(block ByteArray) returns ByteArray throws AesError
		match backing 'backing'
			bitsliced(cipher) then return try cipher.encryptBlock(block)

			#if not arch(wasm32)
				hardware(schedule) then return try aesHardwareEncrypt(schedule, block: block)
			#endif
		end 'backing'
	end 'encryptBlock'

	/// The decryption of one 16-byte block.
	public function decryptBlock(block ByteArray) returns ByteArray throws AesError
		match backing 'backing'
			bitsliced(cipher) then return try cipher.decryptBlock(block)

			#if not arch(wasm32)
				hardware(schedule) then return try aesHardwareDecrypt(schedule, block: block)
			#endif
		end 'backing'
	end 'decryptBlock'

	/// `data` XORed with the counter-mode key stream of a 12-byte `nonce`, the first block's counter being
	/// `counter`. Encryption and decryption are the same call.
	public function xorKeyStream(nonce ByteArray, counter AesCounter, data ByteArray) returns ByteArray throws AesKeyStreamError
		match backing 'backing'
			bitsliced(cipher) then return try cipher.xorKeyStream(nonce, counter: counter, data: data)

			#if not arch(wasm32)
				hardware(schedule) then return try aesHardwareXorKeyStream(schedule, nonce: nonce, counter: counter, data: data)
			#endif
		end 'backing'
	end 'xorKeyStream'

	export function xorKeyStreamPastFirstBlock(nonce ByteArray, counter AesCounter, data ByteArray, output ByteArray) returns AesPair throws AesKeyStreamError
		match backing 'backing'
			bitsliced(cipher) then return try cipher.xorKeyStreamPastFirstBlock(nonce, counter: counter, data: data, output: output)

			#if not arch(wasm32)
				hardware(schedule) then return try aesHardwareXorKeyStreamPastFirstBlock(schedule, nonce: nonce, counter: counter, data: data, output: output)
			#endif
		end 'backing'
	end 'xorKeyStreamPastFirstBlock'
end 'Aes'
