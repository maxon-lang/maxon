#if arch(x64) or arch(arm64)
	// The table size restates `AesGcmTableBytes` in `CryptoRuntime.maxon`, which reads the round count
	// off the key block's length past it: another size is a wrong round count, and a guard ends the
	// program only when that length is not one the guards accept.
	let aesGcmHardwareTableBytes = 256
	let aesGcmHardwareTagBytes = 16
	let aesGcmHardwareScheduleHalfShift = 1

	export typealias AesGcmKeyBlock = FixedArray with Byte

	export function aesGcmHardwareKeys(schedule AesSchedule) returns AesGcmKeyBlock
		let keys = AesGcmKeyBlock.create(aesGcmHardwareTableBytes + (schedule.count() shr aesGcmHardwareScheduleHalfShift))
		__Builtins.aesGcmInit(keys, schedule)

		return keys
	end 'aesGcmHardwareKeys'

	export function aesGcmHardwareSealInto(output ByteArray, at ElementIndex, keys AesGcmKeyBlock, nonce ByteArray, plaintext ByteArray, additionalData ByteArray)
		let sealedEnd = at + plaintext.count() + aesGcmHardwareTagBytes

		if output.count() != sealedEnd 'resizes'
			output.resize(sealedEnd)
		end 'resizes'

		__Builtins.aesGcmSeal(output, at, keys, nonce, additionalData, plaintext)
	end 'aesGcmHardwareSealInto'

	export function aesGcmHardwareOpen(keys AesGcmKeyBlock, nonce ByteArray, sealed ByteArray, additionalData ByteArray, ciphertextBytes Count) returns ByteArray throws AeadError
		let plaintext = ByteArray.create(ciphertextBytes)

		if not __Builtins.aesGcmOpen(plaintext, aesHardwareFirstByte, keys, nonce, additionalData, sealed) 'forged'
			throw AeadError.authenticationFailed
		end 'forged'

		return plaintext
	end 'aesGcmHardwareOpen'
#endif
