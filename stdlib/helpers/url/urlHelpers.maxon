/// Internal helper functions for URL parsing and manipulation.
/// @category Internal
typealias Byte = int(0 to u8.max)

public function urlIsAlpha(b Byte) returns bool
	// A-Z: 65-90, a-z: 97-122
	if b >= 65 and b <= 90 'upper'
		return true
	end 'upper'
	if b >= 97 and b <= 122 'lower'
		return true
	end 'lower'
	return false
end 'urlIsAlpha'

public function urlIsDigit(b Byte) returns bool
	// 0-9: 48-57
	if b >= 48 and b <= 57 'digit'
		return true
	end 'digit'
	return false
end 'urlIsDigit'

public function urlIsHexDigit(b Byte) returns bool
	// 0-9: 48-57, A-F: 65-70, a-f: 97-102
	if b >= 48 and b <= 57 'digit'
		return true
	end 'digit'
	if b >= 65 and b <= 70 'upperHex'
		return true
	end 'upperHex'
	if b >= 97 and b <= 102 'lowerHex'
		return true
	end 'lowerHex'
	return false
end 'urlIsHexDigit'

/// Valid scheme characters after the first: ALPHA / DIGIT / "+" / "-" / "."
public function urlIsSchemeChar(b Byte) returns bool
	if urlIsAlpha(b) 'alpha'
		return true
	end 'alpha'
	if urlIsDigit(b) 'digit'
		return true
	end 'digit'
	// +: 43, -: 45, .: 46
	if b == 43 or b == 45 or b == 46 'special'
		return true
	end 'special'
	return false
end 'urlIsSchemeChar'

/// Validate percent-encoding in a string. Throws URLError.invalidEncoding on malformed sequences.
public function urlValidatePercentEncoding(input String) throws URLError
	let len = input.byteLength()
	var i = 0
	while i < len 'scan'
		let b = input.byteAtOrPanic(i)
		if b == 37 'percent'
			// '%' = 37, need two hex digits after
			if i + 2 >= len 'truncated'
				throw URLError.invalidEncoding
			end 'truncated'
			let h1 = input.byteAtOrPanic(i + 1)
			let h2 = input.byteAtOrPanic(i + 2)
			if not urlIsHexDigit(h1) 'badH1'
				throw URLError.invalidEncoding
			end 'badH1'
			if not urlIsHexDigit(h2) 'badH2'
				throw URLError.invalidEncoding
			end 'badH2'
			i = i + 3
		end 'percent' else 'notPercent'
			i = i + 1
		end 'notPercent'
	end 'scan'
end 'urlValidatePercentEncoding'

/// Remove dot segments from a path per RFC 3986 Section 5.2.4.
public function urlRemoveDotSegments(path String) returns String
	let len = path.byteLength()
	if len == 0 'empty'
		return ""
	end 'empty'

	// For the SLICE alone — the byte reads go through `path.byteAtOrPanic`, which needs no record.
	// `slice` hands back a buffer, so it is one of the few asks that genuinely needs one; hoisted
	// out of the loop so Stage 4b materializes it once per call rather than once per segment.
	let pathBytes = path.addressableBytes()
	var pos = 0
	var output = ""

	while pos < len 'loop'
		let remaining = len - pos

		// A: If input starts with "../" remove it
		if remaining >= 3 'checkDotDotSlash'
			if path.byteAtOrPanic(pos) == 46 'dot1'
				if path.byteAtOrPanic(pos + 1) == 46 'dot2'
					if path.byteAtOrPanic(pos + 2) == 47 'slash'
						pos = pos + 3
						continue
					end 'slash'
				end 'dot2'
			end 'dot1'
		end 'checkDotDotSlash'

		// A: If input starts with "./" remove it
		if remaining >= 2 'checkDotSlash'
			if path.byteAtOrPanic(pos) == 46 'dot1b'
				if path.byteAtOrPanic(pos + 1) == 47 'slash1b'
					pos = pos + 2
					continue
				end 'slash1b'
			end 'dot1b'
		end 'checkDotSlash'

		// B: If input starts with "/./" replace with "/"
		if remaining >= 3 'checkSlashDotSlash'
			if path.byteAtOrPanic(pos) == 47 'sl1'
				if path.byteAtOrPanic(pos + 1) == 46 'dt1'
					if path.byteAtOrPanic(pos + 2) == 47 'sl2'
						pos = pos + 2
						continue
					end 'sl2'
				end 'dt1'
			end 'sl1'
		end 'checkSlashDotSlash'

		// B: If input is exactly "/." replace with "/"
		if remaining == 2 'checkSlashDot'
			if path.byteAtOrPanic(pos) == 47 'sl1c'
				if path.byteAtOrPanic(pos + 1) == 46 'dt1c'
					output = "{output}/"
					pos = len
					continue
				end 'dt1c'
			end 'sl1c'
		end 'checkSlashDot'

		// C: If input starts with "/../" replace with "/" and remove last segment from output
		if remaining >= 4 'checkSlashDotDotSlash'
			if path.byteAtOrPanic(pos) == 47 'sl1d'
				if path.byteAtOrPanic(pos + 1) == 46 'dt1d'
					if path.byteAtOrPanic(pos + 2) == 46 'dt2d'
						if path.byteAtOrPanic(pos + 3) == 47 'sl2d'
							output = urlRemoveLastSegment(output)
							pos = pos + 3
							continue
						end 'sl2d'
					end 'dt2d'
				end 'dt1d'
			end 'sl1d'
		end 'checkSlashDotDotSlash'

		// C: If input is exactly "/.." replace with "/" and remove last segment from output
		if remaining == 3 'checkSlashDotDot'
			if path.byteAtOrPanic(pos) == 47 'sl1e'
				if path.byteAtOrPanic(pos + 1) == 46 'dt1e'
					if path.byteAtOrPanic(pos + 2) == 46 'dt2e'
						output = urlRemoveLastSegment(output)
						output = "{output}/"
						pos = len
						continue
					end 'dt2e'
				end 'dt1e'
			end 'sl1e'
		end 'checkSlashDotDot'

		// D: If input is exactly "." or ".." remove it
		if remaining == 1 'checkLoneDot'
			if path.byteAtOrPanic(pos) == 46 'isDot'
				pos = len
				continue
			end 'isDot'
		end 'checkLoneDot'
		if remaining == 2 'checkLoneDotDot'
			if path.byteAtOrPanic(pos) == 46 'isDot1'
				if path.byteAtOrPanic(pos + 1) == 46 'isDot2'
					pos = len
					continue
				end 'isDot2'
			end 'isDot1'
		end 'checkLoneDotDot'

		// E: Move first path segment (including initial "/" if any) to output
		var segEnd = pos
		if path.byteAtOrPanic(segEnd) == 47 'startsWithSlash'
			segEnd = segEnd + 1
		end 'startsWithSlash'
		// Find next "/" or end
		while segEnd < len 'findSlash'
			if path.byteAtOrPanic(segEnd) == 47 'foundSlash'
				break
			end 'foundSlash'
			segEnd = segEnd + 1
		end 'findSlash'
		let segManaged = try pathBytes.slice(pos, segEnd) otherwise 'sliceErr'
			panic("urlRemoveDotSegments: slice OOB — pos and segEnd are within bounds")
		end 'sliceErr'
		let seg = String.init(segManaged)
		output = "{output}{seg}"
		pos = segEnd
	end 'loop'

	return output
end 'urlRemoveDotSegments'

/// Remove the last path segment from output (everything after and including the last "/").
public function urlRemoveLastSegment(output String) returns String
	let len = output.byteLength()
	if len == 0 'empty'
		return ""
	end 'empty'
	// For the SLICE alone; the byte reads below go through `byteAtOrPanic`.
	let outputBytes = output.addressableBytes()
	var i = output.byteLength()
	while i > 0 'scan'
		i = i - 1
		if output.byteAtOrPanic(i) == 47 'foundSlash'
			if i == 0 'isRoot'
				return ""
			end 'isRoot'
			let sliced = try outputBytes.slice(0, i) otherwise 'sliceErr2'
				panic("urlRemoveLastSegment: slice OOB — i < len guaranteed")
			end 'sliceErr2'
			return String.init(sliced)
		end 'foundSlash'
	end 'scan'
	return ""
end 'urlRemoveLastSegment'

/// Merge base path with reference path per RFC 3986 Section 5.2.3.
public function urlMergeBasePath(basePath String, hasAuthority bool, refPath String) returns String
	if hasAuthority and basePath.isEmpty() 'emptyBase'
		return "/{refPath}"
	end 'emptyBase'
	// Find last "/" in basePath. `baseBytes` is for the SLICE alone; the scan uses `byteAtOrPanic`.
	let baseBytes = basePath.addressableBytes()
	var i = basePath.byteLength()
	while i > 0 'scan'
		i = i - 1
		if basePath.byteAtOrPanic(i) == 47 'foundSlash'
			let prefix = try baseBytes.slice(0, i + 1) otherwise 'sliceErr3'
				panic("urlMergeBasePath: slice OOB — i < len guaranteed")
			end 'sliceErr3'
			let prefixStr = String.init(prefix)
			return "{prefixStr}{refPath}"
		end 'foundSlash'
	end 'scan'
	return refPath
end 'urlMergeBasePath'
