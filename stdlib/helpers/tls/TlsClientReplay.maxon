type TlsUnauthenticatedPeer implements TlsPeerAuthenticator
	static function create() returns TlsUnauthenticatedPeer
		return Self{}
	end 'create'

	function verifyChain(leaf ByteArray, intermediates ByteArrays, host X509VerifyHost) throws TlsHandshakeError
		return
	end 'verifyChain'

	function verifySignature(scheme TlsSignatureScheme, key X509PublicKey, message ByteArray, signature ByteArray) throws TlsHandshakeError
		return
	end 'verifySignature'

	function authenticates() returns bool
		return false
	end 'authenticates'
end 'TlsUnauthenticatedPeer'

type TlsReplacedClientHello implements TlsClientHelloSource
	var firstReplacement as ByteArray
	var retryReplacements as ByteArrays

	static function create(first ByteArray, retry ByteArrays) returns TlsReplacedClientHello
		return Self{firstReplacement: first, retryReplacements: retry}
	end 'create'

	function first(built ByteArray) returns ByteArray
		return firstReplacement
	end 'first'

	function second(built ByteArray) returns ByteArray
		return try retryReplacements.first() otherwise built
	end 'second'
end 'TlsReplacedClientHello'

type TlsClientReplay
	static function run(config TlsClientConfig, entropy TlsClientEntropy, peer TlsPeerAuthenticator, helloSource TlsClientHelloSource, inbound ByteArrays, writes ByteArrays, closeNotify bool) returns TlsReplayTrace throws TlsHandshakeError
		let client = try TlsClientHandshake.create(config, entropy: entropy, peer: peer, helloSource: helloSource)

		return try TlsReplay.run(client, inbound: inbound, writes: writes, closeNotify: closeNotify)
	end 'run'
end 'TlsClientReplay'
