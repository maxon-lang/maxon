module type TlsServerReplay
	module static function run(config TlsServerConfig, entropy TlsServerEntropy, peer TlsPeerAuthenticator, inbound ByteArrays, writes ByteArrays, closeNotify bool) returns TlsReplayTrace throws TlsHandshakeError
		var server = try TlsServerHandshake.create(config, entropy: entropy, peer: peer)

		return try TlsReplay.run(server, inbound: inbound, writes: writes, closeNotify: closeNotify)
	end 'run'
end 'TlsServerReplay'
