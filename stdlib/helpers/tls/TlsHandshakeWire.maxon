typealias TlsWireValue = int(0 to u32.max)
typealias TlsVectorBytes = int(0 to 16777215) implements Count

enum TlsWireWidth
	uint8 = 1
	uint16 = 2
	uint24 = 3
	uint32 = 4
end 'TlsWireWidth'

enum TlsLengthPrefix
	uint8 = 1
	uint16 = 2
	uint24 = 3

	function width() returns ByteWordWidth
		return self.rawValue as ByteWordWidth
	end 'width'

	function maximum() returns TlsVectorBytes
		return match self 'prefix'
			uint8 gives tlsMaxUint8Vector
			uint16 gives tlsMaxUint16Vector
			uint24 gives tlsMaxUint24Vector
		end 'prefix'
	end 'maximum'
end 'TlsLengthPrefix'

let tlsMaxUint8Vector = 255
let tlsMaxUint16Vector = 65535
let tlsMaxUint24Vector = 16777215
let tlsCodePointBytes = 2
let tlsMaxCodePointCount = 32767
let tlsAnyLength = 0
let tlsNonEmpty = 1

type TlsReader
	var bytes as ByteArray
	var position as ElementIndex
	var limit as ElementIndex

	static function over(bytes ByteArray) returns TlsReader
		return Self{bytes: bytes.clone(), position: 0, limit: bytes.count()}
	end 'over'

	function remaining() returns Count
		return limit - position
	end 'remaining'

	function isAtEnd() returns bool
		return position == limit
	end 'isAtEnd'

	function finish() throws TlsCodecError
		if not isAtEnd() 'trailing'
			throw TlsCodecError.decodeError
		end 'trailing'
	end 'finish'

	function readUnsigned(width TlsWireWidth) returns TlsWireValue throws TlsCodecError
		return (try readWord(width.rawValue as ByteWordWidth)) as TlsWireValue
	end 'readUnsigned'

	function readWord(width ByteWordWidth) returns OrderedWord throws TlsCodecError
		if remaining() < width 'truncated'
			throw TlsCodecError.decodeError
		end 'truncated'

		let word = readOrderedWord(bytes, off: position, width: width, limit: limit, order: ByteOrder.bigEndian)
		position = position + width

		return word
	end 'readWord'

	function readBytes(count Count) returns ByteArray throws TlsCodecError
		if remaining() < count 'truncated'
			throw TlsCodecError.decodeError
		end 'truncated'

		let taken = try bytes.slice(position, endIndex: position + count) otherwise panic("TlsReader.readBytes: the range was checked against the limit")
		position = position + count

		return taken
	end 'readBytes'

	function readRemaining() returns ByteArray
		return try readBytes(remaining()) otherwise panic("TlsReader.readRemaining: the remaining bytes are available")
	end 'readRemaining'

	function readBoundedVector(prefix TlsLengthPrefix, minimum TlsVectorBytes, maximum TlsVectorBytes) returns TlsReader throws TlsCodecError
		let length = (try readWord(prefix.width())) as TlsVectorBytes

		if length < minimum or length > maximum or length > remaining() 'length'
			throw TlsCodecError.decodeError
		end 'length'

		let start = position
		position = position + length

		return Self{bytes: bytes, position: start, limit: start + length}
	end 'readBoundedVector'

	function readVector(prefix TlsLengthPrefix, minimum TlsVectorBytes) returns TlsReader throws TlsCodecError
		return try readBoundedVector(prefix, minimum: minimum, maximum: prefix.maximum())
	end 'readVector'

	function readBoundedVectorBytes(prefix TlsLengthPrefix, minimum TlsVectorBytes, maximum TlsVectorBytes) returns ByteArray throws TlsCodecError
		let window = try readBoundedVector(prefix, minimum: minimum, maximum: maximum)

		return window.readRemaining()
	end 'readBoundedVectorBytes'

	function readVectorBytes(prefix TlsLengthPrefix, minimum TlsVectorBytes) returns ByteArray throws TlsCodecError
		return try readBoundedVectorBytes(prefix, minimum: minimum, maximum: prefix.maximum())
	end 'readVectorBytes'

	function readCodePointList(prefix TlsLengthPrefix, minimum TlsVectorBytes, maximum TlsVectorBytes) returns TlsReader throws TlsCodecError
		let window = try readBoundedVector(prefix, minimum: (minimum * tlsCodePointBytes) as TlsVectorBytes, maximum: (maximum * tlsCodePointBytes) as TlsVectorBytes)

		if window.remaining() mod tlsCodePointBytes != 0 'odd'
			throw TlsCodecError.decodeError
		end 'odd'

		return window
	end 'readCodePointList'
end 'TlsReader'

function appendUnsigned(output ByteArray, value TlsWireValue, width TlsWireWidth)
	appendOrderedWord(output, word: value as OrderedWord, width: width.rawValue as ByteWordWidth, order: ByteOrder.bigEndian)
end 'appendUnsigned'

function appendVector(output ByteArray, prefix TlsLengthPrefix, contents ByteArray) throws TlsEncodeError
	if contents.count() > prefix.maximum() 'overflow'
		throw TlsEncodeError.vectorTooLong
	end 'overflow'

	appendOrderedWord(output, word: contents.count() as OrderedWord, width: prefix.width(), order: ByteOrder.bigEndian)
	output.append(contents)
end 'appendVector'
