type TlsTranscript
	var messages as ByteArray

	static function create() returns TlsTranscript
		return Self{messages: ByteArray.create(0)}
	end 'create'

	function append(message ByteArray)
		messages.append(message)
	end 'append'

	function restartAsMessageHash(suite Tls13CipherSuite)
		messages = Tls13KeySchedule.messageHash(suite, clientHello: messages)
	end 'restartAsMessageHash'

	function content() returns ByteArray
		return messages.clone()
	end 'content'

	function hash(algorithm HashAlgorithm) returns ByteArray
		return sha2Once(algorithm, data: messages)
	end 'hash'
end 'TlsTranscript'
