typealias TlsExtensionTypeTally = Set with TlsExtensionType

type TlsExtensionScan
	var types as TlsExtensionTypeTally
	var supportedVersions as TlsVersionCodeArray
	var selectedVersions as TlsVersionCodeArray
	var supportedGroups as TlsGroupCodeSet
	var signatureSchemes as TlsSignatureSchemeCodeArray
	var applicationProtocols as TlsProtocolNameArray
	var clientShares as TlsKeyShareArray
	var serverShares as TlsKeyShareArray
	var selectedGroups as TlsGroupCodeArray
	var cookies as ByteArrays
	var pointFormats as ByteArray
	var renegotiated as ByteArray

	static function ofBlock(block TlsExtensionBlock) returns TlsExtensionScan
		return match block 'block'
			absent gives TlsExtensionScan.ofExtensions(TlsExtensionArray.create(0))
			listed(extensions) gives TlsExtensionScan.ofExtensions(extensions)
		end 'block'
	end 'ofBlock'

	static function ofExtensions(extensions TlsExtensionArray) returns TlsExtensionScan
		let typeTally = TlsExtensionTypeTally.create()
		var offeredVersions = TlsVersionCodeArray.create(0)
		let chosenVersions = TlsVersionCodeArray.create(0)
		var offeredGroups = TlsGroupCodeSet.create()
		var offeredSchemes = TlsSignatureSchemeCodeArray.create(0)
		var offeredProtocols = TlsProtocolNameArray.create(0)
		var offeredShares = TlsKeyShareArray.create(0)
		let chosenShares = TlsKeyShareArray.create(0)
		let chosenGroups = TlsGroupCodeArray.create(0)
		let cookieList = ByteArrays.create(0)
		var offeredFormats = ByteArray.create(0)
		var offeredRenegotiation = ByteArray.create(0)

		for item in extensions 'eachExtension'
			typeTally.insert(item.extensionType())

			match item 'form'
				supportedVersions(versions) then offeredVersions = versions.clone()
				selectedVersion(version) then chosenVersions.push(version)
				supportedGroups(groups) then offeredGroups = TlsGroupCodeSet from groups
				signatureAlgorithms(schemes) then offeredSchemes = schemes.clone()
				applicationProtocols(protocols) then offeredProtocols = protocols.clone()
				clientKeyShares(shares) then offeredShares = shares.clone()
				serverKeyShare(share) then chosenShares.push(share)
				selectedGroup(group) then chosenGroups.push(group)
				cookie(value) then cookieList.push(value.clone())
				ecPointFormats(formats) then offeredFormats = formats.clone()
				renegotiationInfo(connection) then offeredRenegotiation = connection.clone()
				serverName or
				serverNameAcknowledgement or
				extendedMasterSecret or
				opaque then continue
			end 'form'
		end 'eachExtension'

		return Self{types: typeTally, supportedVersions: offeredVersions, selectedVersions: chosenVersions, supportedGroups: offeredGroups, signatureSchemes: offeredSchemes, applicationProtocols: offeredProtocols, clientShares: offeredShares, serverShares: chosenShares, selectedGroups: chosenGroups, cookies: cookieList, pointFormats: offeredFormats, renegotiated: offeredRenegotiation}
	end 'ofExtensions'
end 'TlsExtensionScan'
