/// Why a `Tls13KeySchedule` function refused its input: the first check that failed.
public enum Tls13KeyScheduleError implements Error
	invalidSecretLength
	invalidLabel
	contextTooLong
	outputTooLong
	invalidTranscriptHashLength
	invalidSharedSecretLength
end 'Tls13KeyScheduleError'

let tls13LabelPrefix = "tls13 "
let tls13MaxLabelBytes = 249
let tls13MaxContextBytes = 255
let tls13LengthFieldBytes = 2
let tls13MessageHashType = 0xFE
let tls13MessageHashLengthBytes = 3
let tls13DerivedLabel = "derived"
let tls13ClientHandshakeLabel = "c hs traffic"
let tls13ServerHandshakeLabel = "s hs traffic"
let tls13ClientApplicationLabel = "c ap traffic"
let tls13ServerApplicationLabel = "s ap traffic"
let tls13ExporterLabel = "exp master"
let tls13KeyLabel = "key"
let tls13IvLabel = "iv"
let tls13FinishedLabel = "finished"
let tls13KeyUpdateLabel = "traffic upd"

/// The secrets `Tls13KeySchedule.keySchedule` derives, each read by a function of its name.
public type Tls13Secrets
	var earlySecret as ByteArray
	var handshakeSecret as ByteArray
	var clientHandshakeTrafficSecret as ByteArray
	var serverHandshakeTrafficSecret as ByteArray
	var masterSecret as ByteArray
	var clientApplicationTrafficSecret0 as ByteArray
	var serverApplicationTrafficSecret0 as ByteArray
	var exporterMasterSecret as ByteArray

	/// The Early Secret, from a zero pre-shared key.
	public function earlySecret() returns ByteArray
		return earlySecret
	end 'earlySecret'

	/// The Handshake Secret.
	public function handshakeSecret() returns ByteArray
		return handshakeSecret
	end 'handshakeSecret'

	/// `client_handshake_traffic_secret`.
	public function clientHandshakeTrafficSecret() returns ByteArray
		return clientHandshakeTrafficSecret
	end 'clientHandshakeTrafficSecret'

	/// `server_handshake_traffic_secret`.
	public function serverHandshakeTrafficSecret() returns ByteArray
		return serverHandshakeTrafficSecret
	end 'serverHandshakeTrafficSecret'

	/// The Master Secret.
	public function masterSecret() returns ByteArray
		return masterSecret
	end 'masterSecret'

	/// `client_application_traffic_secret_0`.
	public function clientApplicationTrafficSecret0() returns ByteArray
		return clientApplicationTrafficSecret0
	end 'clientApplicationTrafficSecret0'

	/// `server_application_traffic_secret_0`.
	public function serverApplicationTrafficSecret0() returns ByteArray
		return serverApplicationTrafficSecret0
	end 'serverApplicationTrafficSecret0'

	/// `exporter_master_secret`.
	public function exporterMasterSecret() returns ByteArray
		return exporterMasterSecret
	end 'exporterMasterSecret'

	static function create(earlySecret ByteArray, handshakeSecret ByteArray, clientHandshakeTrafficSecret ByteArray, serverHandshakeTrafficSecret ByteArray, masterSecret ByteArray, clientApplicationTrafficSecret0 ByteArray, serverApplicationTrafficSecret0 ByteArray, exporterMasterSecret ByteArray) returns Tls13Secrets
		return Self{earlySecret: earlySecret, handshakeSecret: handshakeSecret, clientHandshakeTrafficSecret: clientHandshakeTrafficSecret, serverHandshakeTrafficSecret: serverHandshakeTrafficSecret, masterSecret: masterSecret, clientApplicationTrafficSecret0: clientApplicationTrafficSecret0, serverApplicationTrafficSecret0: serverApplicationTrafficSecret0, exporterMasterSecret: exporterMasterSecret}
	end 'create'
end 'Tls13Secrets'

module type Tls13HandshakeStage
	module var earlySecret as ByteArray
	module var handshakeSecret as ByteArray
	module var clientTrafficSecret as ByteArray
	module var serverTrafficSecret as ByteArray
	module var masterSecret as ByteArray

	module static function create(earlySecret ByteArray, handshakeSecret ByteArray, clientTrafficSecret ByteArray, serverTrafficSecret ByteArray, masterSecret ByteArray) returns Tls13HandshakeStage
		return Self{earlySecret: earlySecret, handshakeSecret: handshakeSecret, clientTrafficSecret: clientTrafficSecret, serverTrafficSecret: serverTrafficSecret, masterSecret: masterSecret}
	end 'create'
end 'Tls13HandshakeStage'

module type Tls13ApplicationStage
	module var clientTrafficSecret as ByteArray
	module var serverTrafficSecret as ByteArray
	module var exporterSecret as ByteArray

	module static function create(clientTrafficSecret ByteArray, serverTrafficSecret ByteArray, exporterSecret ByteArray) returns Tls13ApplicationStage
		return Self{clientTrafficSecret: clientTrafficSecret, serverTrafficSecret: serverTrafficSecret, exporterSecret: exporterSecret}
	end 'create'
end 'Tls13ApplicationStage'

/// The AEAD key and IV of one traffic secret, from `Tls13KeySchedule.trafficKeys`.
public type Tls13TrafficKeys
	var key as ByteArray
	var iv as ByteArray

	/// The AEAD key.
	public function key() returns ByteArray
		return key
	end 'key'

	/// The 12-byte IV.
	public function iv() returns ByteArray
		return iv
	end 'iv'

	static function create(key ByteArray, iv ByteArray) returns Tls13TrafficKeys
		return Self{key: key, iv: iv}
	end 'create'
end 'Tls13TrafficKeys'

/// The TLS 1.3 key schedule (RFC 8446 section 7) for a full (EC)DHE handshake without a
/// pre-shared key.
public type Tls13KeySchedule
	/// `HKDF-Expand-Label`: `length` bytes of `secret` expanded under `"tls13 "` + `label` and
	/// `context`.
	public static function expandLabel(suite Tls13CipherSuite, secret ByteArray, label String, context ByteArray, length HkdfOutputLength) returns ByteArray throws Tls13KeyScheduleError
		try tls13RequireSecret(suite, secret: secret)
		try tls13RequireLabel(label)

		if context.count() > tls13MaxContextBytes 'context'
			throw Tls13KeyScheduleError.contextTooLong
		end 'context'

		if length > hkdfMaxBlocks * suite.hashAlgorithm().digestBytes() 'length'
			throw Tls13KeyScheduleError.outputTooLong
		end 'length'

		return tls13Expand(suite.hashAlgorithm(), secret: secret, label: label, context: context, length: length)
	end 'expandLabel'

	/// `Derive-Secret`: `expandLabel` with `transcriptHash` as the context and the hash length as the
	/// length.
	public static function deriveSecret(suite Tls13CipherSuite, secret ByteArray, label String, transcriptHash ByteArray) returns ByteArray throws Tls13KeyScheduleError
		try tls13RequireSecret(suite, secret: secret)
		try tls13RequireLabel(label)
		try tls13RequireHash(suite, hash: transcriptHash)

		return tls13Derive(suite.hashAlgorithm(), secret: secret, label: label, transcriptHash: transcriptHash)
	end 'deriveSecret'

	/// The suite's hash of the handshake messages, each with its 4-byte header.
	public static function transcriptHash(suite Tls13CipherSuite, messages ByteArrays) returns ByteArray
		return sha2OfMessages(suite.hashAlgorithm(), messages: messages)
	end 'transcriptHash'

	/// The `message_hash` message that stands for the first ClientHello in the transcript after a
	/// HelloRetryRequest.
	public static function messageHash(suite Tls13CipherSuite, clientHello ByteArray) returns ByteArray
		let hash = suite.hashAlgorithm()

		var message = ByteArray.create()
		message.push(tls13MessageHashType as Byte)
		appendOrderedWord(message, word: hash.digestBytes() as OrderedWord, width: tls13MessageHashLengthBytes, order: ByteOrder.bigEndian)
		message.append(sha2Once(hash, data: clientHello))

		return message
	end 'messageHash'

	/// Every secret of the schedule: `helloHash` is the transcript hash through the ServerHello and
	/// `serverFinishedHash` the one through the server's Finished.
	public static function keySchedule(suite Tls13CipherSuite, sharedSecret ByteArray, helloHash ByteArray, serverFinishedHash ByteArray) returns Tls13Secrets throws Tls13KeyScheduleError
		let handshake = try Tls13KeySchedule.handshakeStage(suite, sharedSecret: sharedSecret, helloHash: helloHash)
		let application = try Tls13KeySchedule.applicationStage(suite, masterSecret: handshake.masterSecret, serverFinishedHash: serverFinishedHash)

		return Tls13Secrets.create(handshake.earlySecret, handshakeSecret: handshake.handshakeSecret, clientHandshakeTrafficSecret: handshake.clientTrafficSecret, serverHandshakeTrafficSecret: handshake.serverTrafficSecret, masterSecret: handshake.masterSecret, clientApplicationTrafficSecret0: application.clientTrafficSecret, serverApplicationTrafficSecret0: application.serverTrafficSecret, exporterMasterSecret: application.exporterSecret)
	end 'keySchedule'

	module static function handshakeStage(suite Tls13CipherSuite, sharedSecret ByteArray, helloHash ByteArray) returns Tls13HandshakeStage throws Tls13KeyScheduleError
		if sharedSecret.count() == 0 'sharedSecret'
			throw Tls13KeyScheduleError.invalidSharedSecretLength
		end 'sharedSecret'

		try tls13RequireHash(suite, hash: helloHash)

		let hash = suite.hashAlgorithm()
		var zeros = ByteArray.create()
		zeros.resize(hash.digestBytes())

		let emptyHash = sha2Once(hash, data: ByteArray.create())
		let earlySecret = hkdfExtract(hash, salt: zeros, inputKeyMaterial: zeros)
		let handshakeSalt = tls13Derive(hash, secret: earlySecret, label: tls13DerivedLabel, transcriptHash: emptyHash)
		let handshakeSecret = hkdfExtract(hash, salt: handshakeSalt, inputKeyMaterial: sharedSecret)
		let masterSalt = tls13Derive(hash, secret: handshakeSecret, label: tls13DerivedLabel, transcriptHash: emptyHash)
		let masterSecret = hkdfExtract(hash, salt: masterSalt, inputKeyMaterial: zeros)

		let clientHandshake = tls13Derive(hash, secret: handshakeSecret, label: tls13ClientHandshakeLabel, transcriptHash: helloHash)
		let serverHandshake = tls13Derive(hash, secret: handshakeSecret, label: tls13ServerHandshakeLabel, transcriptHash: helloHash)

		return Tls13HandshakeStage.create(earlySecret, handshakeSecret: handshakeSecret, clientTrafficSecret: clientHandshake, serverTrafficSecret: serverHandshake, masterSecret: masterSecret)
	end 'handshakeStage'

	module static function applicationStage(suite Tls13CipherSuite, masterSecret ByteArray, serverFinishedHash ByteArray) returns Tls13ApplicationStage throws Tls13KeyScheduleError
		try tls13RequireSecret(suite, secret: masterSecret)
		try tls13RequireHash(suite, hash: serverFinishedHash)

		let hash = suite.hashAlgorithm()
		let clientApplication = tls13Derive(hash, secret: masterSecret, label: tls13ClientApplicationLabel, transcriptHash: serverFinishedHash)
		let serverApplication = tls13Derive(hash, secret: masterSecret, label: tls13ServerApplicationLabel, transcriptHash: serverFinishedHash)
		let exporter = tls13Derive(hash, secret: masterSecret, label: tls13ExporterLabel, transcriptHash: serverFinishedHash)

		return Tls13ApplicationStage.create(clientApplication, serverTrafficSecret: serverApplication, exporterSecret: exporter)
	end 'applicationStage'

	/// The AEAD key and IV of a traffic secret.
	public static function trafficKeys(suite Tls13CipherSuite, trafficSecret ByteArray) returns Tls13TrafficKeys throws Tls13KeyScheduleError
		try tls13RequireSecret(suite, secret: trafficSecret)

		let hash = suite.hashAlgorithm()
		let key = tls13Expand(hash, secret: trafficSecret, label: tls13KeyLabel, context: ByteArray.create(), length: suite.keyBytes() as HkdfOutputLength)
		let iv = tls13Expand(hash, secret: trafficSecret, label: tls13IvLabel, context: ByteArray.create(), length: suite.ivBytes() as HkdfOutputLength)

		return Tls13TrafficKeys.create(key, iv: iv)
	end 'trafficKeys'

	/// The `verify_data` of a Finished message, under the finished key of `baseKey`, the sender's
	/// handshake traffic secret.
	public static function finishedVerifyData(suite Tls13CipherSuite, baseKey ByteArray, transcriptHash ByteArray) returns ByteArray throws Tls13KeyScheduleError
		try tls13RequireSecret(suite, secret: baseKey)
		try tls13RequireHash(suite, hash: transcriptHash)

		let hash = suite.hashAlgorithm()
		let finishedKey = tls13Expand(hash, secret: baseKey, label: tls13FinishedLabel, context: ByteArray.create(), length: hash.digestBytes() as HkdfOutputLength)

		return hmac(hash, key: finishedKey, message: transcriptHash)
	end 'finishedVerifyData'

	/// The KeyUpdate step: `application_traffic_secret_N+1` from `application_traffic_secret_N`.
	public static function nextApplicationTrafficSecret(suite Tls13CipherSuite, secret ByteArray) returns ByteArray throws Tls13KeyScheduleError
		try tls13RequireSecret(suite, secret: secret)

		return tls13Derive(suite.hashAlgorithm(), secret: secret, label: tls13KeyUpdateLabel, transcriptHash: ByteArray.create())
	end 'nextApplicationTrafficSecret'
end 'Tls13KeySchedule'

function tls13RequireSecret(suite Tls13CipherSuite, secret ByteArray) throws Tls13KeyScheduleError
	if secret.count() != suite.hashAlgorithm().digestBytes() 'length'
		throw Tls13KeyScheduleError.invalidSecretLength
	end 'length'
end 'tls13RequireSecret'

function tls13RequireHash(suite Tls13CipherSuite, hash ByteArray) throws Tls13KeyScheduleError
	if hash.count() != suite.hashAlgorithm().digestBytes() 'length'
		throw Tls13KeyScheduleError.invalidTranscriptHashLength
	end 'length'
end 'tls13RequireHash'

function tls13RequireLabel(label String) throws Tls13KeyScheduleError
	if not tlsIsPrintableAscii(label) or label.byteLength() > tls13MaxLabelBytes 'label'
		throw Tls13KeyScheduleError.invalidLabel
	end 'label'
end 'tls13RequireLabel'

function tls13Derive(hash HashAlgorithm, secret ByteArray, label String, transcriptHash ByteArray) returns ByteArray
	return tls13Expand(hash, secret: secret, label: label, context: transcriptHash, length: hash.digestBytes() as HkdfOutputLength)
end 'tls13Derive'

function tls13Expand(hash HashAlgorithm, secret ByteArray, label String, context ByteArray, length HkdfOutputLength) returns ByteArray
	let fullLabel = "{tls13LabelPrefix}{label}".toByteArray()

	var info = ByteArray.create()
	appendOrderedWord(info, word: length as OrderedWord, width: tls13LengthFieldBytes, order: ByteOrder.bigEndian)
	info.push(fullLabel.count() as Byte)
	info.append(fullLabel)
	info.push(context.count() as Byte)
	info.append(context)

	return try hkdfExpand(hash, pseudoRandomKey: secret, info: info, length: length) otherwise panic("tls13Expand: a length the callers bounded was refused")
end 'tls13Expand'
