interface TrustSource
	function read() returns RootCertificates throws TrustStoreError
end 'TrustSource'

type OperatingSystemTrust implements TrustSource
	static function create() returns OperatingSystemTrust
		return Self{}
	end 'create'

	function read() returns RootCertificates throws TrustStoreError
		return try TrustStore.systemRoots()
	end 'read'
end 'OperatingSystemTrust'
