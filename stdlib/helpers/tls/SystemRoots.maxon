module union SystemRootsOutcome
	unloaded
	loaded(anchors immutable X509RootPool)
	failed(error TrustStoreError)
end 'SystemRootsOutcome'

public type SystemRoots
	module let outcome as SystemRootsOutcome

	module static function unloaded() returns SystemRoots
		return Self{outcome: SystemRootsOutcome.unloaded}
	end 'unloaded'

	module static function loaded(anchors immutable X509RootPool) returns SystemRoots
		return Self{outcome: SystemRootsOutcome.loaded(anchors)}
	end 'loaded'

	module static function failed(error TrustStoreError) returns SystemRoots
		return Self{outcome: SystemRootsOutcome.failed(error)}
	end 'failed'

	public static function authenticator(purpose X509Purpose, now UnixSeconds) returns TlsX509Peer throws TrustStoreError
		try settle(OperatingSystemTrust.create())

		return try SystemRoots.current().authenticatorOver(purpose, now: now)
	end 'authenticator'

	module static function settle(source immutable TrustSource) throws TrustStoreError
		let seen = SystemRoots.current()

		if seen.isUnloaded() 'unclaimed'
			_ = SystemRoots.register(SystemRoots.read(source), replacing: seen)
		end 'unclaimed'

		match SystemRoots.current().outcome 'outcome'
			loaded then return
			failed(error) then throw error
			unloaded then panic("SystemRoots: a settled state was replaced by an unloaded one")
		end 'outcome'
	end 'settle'

	static function read(source immutable TrustSource) returns SystemRoots
		let roots = try source.read() otherwise (error) 'unread'
			return SystemRoots.failed(error)
		end 'unread'

		return SystemRoots.loaded(X509RootPool.create(tlsCertificates(roots)))
	end 'read'

	function isUnloaded() returns bool
		return match outcome 'outcome'
			unloaded gives true
			loaded or
			failed gives false
		end 'outcome'
	end 'isUnloaded'

	function authenticatorOver(purpose X509Purpose, now UnixSeconds) returns TlsX509Peer throws TrustStoreError
		match outcome 'outcome'
			loaded(anchors) then return TlsX509Peer.trusting(anchors, now: now, purpose: purpose)
			failed(error) then throw error
			unloaded then panic("SystemRoots: authenticator asked of an unsettled state")
		end 'outcome'
	end 'authenticatorOver'
end 'SystemRoots'

default SystemRoots = SystemRoots.unloaded()
