/// TLS client connections.
/// @category Network
module union TlsTrust
	system
	custom(roots ByteArrays)
end 'TlsTrust'

module union TlsServerName
	fromHost
	named(name String)
end 'TlsServerName'

/// What a client verifies and offers: roots, server name, versions, ALPN protocols and a client
/// certificate.
public type TlsClientOptions
	var settings as TlsClientConfig
	var trust as TlsTrust
	var serverName as TlsServerName
	var verificationTime as TlsVerificationTime
	module var handshakeDeadlineMs as SocketDeadlineMs

	/// The system roots, TLS 1.3 and 1.2, the dialled host as the name, no ALPN, no client certificate,
	/// a 30 s handshake deadline.
	public static function create() returns TlsClientOptions
		return Self{settings: TlsClientConfig.defaults(X509VerifyHost.none), trust: TlsTrust.system, serverName: TlsServerName.fromHost, verificationTime: TlsVerificationTime.current, handshakeDeadlineMs: DefaultHandshakeDeadlineMs}
	end 'create'

	/// The DER roots a server chain must end in, in place of the system's.
	public function setTrustedRoots(roots RootCertificates) throws TlsError
		if roots.isEmpty() 'none'
			throw TlsError.invalidConfiguration
		end 'none'

		trust = TlsTrust.custom(tlsCertificates(roots))
	end 'setTrustedRoots'

	/// The name to verify and send in place of the host.
	public function setServerName(name String) throws TlsError
		if name.byteLength() == 0 'empty'
			throw TlsError.invalidConfiguration
		end 'empty'

		serverName = TlsServerName.named(name)
	end 'setServerName'

	/// The Unix time certificates are checked at, in place of the clock.
	public function setVerificationTime(seconds UnixSeconds)
		verificationTime = TlsVerificationTime.fixed(seconds)
	end 'setVerificationTime'

	/// The TLS versions to offer; at least one.
	public function setProtocols(protocols TlsProtocolArray) throws TlsError
		settings.protocols = try tlsCheckedProtocols(protocols)
	end 'setProtocols'

	/// The ALPN protocol names to offer, in order.
	public function setApplicationProtocols(names StringArray) throws TlsError
		settings.applicationProtocols = try tlsCheckedProtocolNames(names)
	end 'setApplicationProtocols'

	/// The certificate chain and key to present when the server asks for a client certificate.
	public function setIdentity(identity TlsIdentity)
		settings.identity = TlsClientIdentity.certified(identity.chain.clone(), key: identity.key.clone())
	end 'setIdentity'

	/// How long the handshake may take, counted from when `connect` starts it, before `connect` throws
	/// `handshakeTimedOut`; `0` waits without a deadline. `connect`'s `dialDeadlineMs` bounds the dial.
	public function setHandshakeDeadline(milliseconds SocketDeadlineMs)
		handshakeDeadlineMs = milliseconds
	end 'setHandshakeDeadline'

	// A cap of `0` lifts the deadline instead of tightening it, because `0` means no deadline.
	module function capHandshakeDeadline(milliseconds SocketDeadlineMs)
		if handshakeDeadlineMs == NoDeadlineMs or handshakeDeadlineMs > milliseconds 'wider'
			handshakeDeadlineMs = milliseconds
		end 'wider'
	end 'capHandshakeDeadline'

	module function configFor(host String) returns TlsClientConfig
		var config = settings.clone()

		config.peerName = match serverName 'name'
			fromHost gives X509VerifyHost.named(host)
			named(override) gives X509VerifyHost.named(override)
		end 'name'

		config.cipherSuites = tlsEnabledSuites(config.cipherSuites, protocols: config.protocols)

		return config
	end 'configFor'

	module function authenticator() returns TlsX509Peer throws TlsError
		match trust 'trust'
			system then return try SystemRoots.authenticator(X509Purpose.serverAuth, now: verificationTime.seconds()) otherwise throw TlsError.trustStoreUnavailable
			custom(roots) then return TlsX509Peer.create(roots, now: verificationTime.seconds(), purpose: X509Purpose.serverAuth)
		end 'trust'
	end 'authenticator'
end 'TlsClientOptions'

/// Connects to TLS servers.
public type TlsClient
	/// Connect to `host` and run the handshake. `dialDeadlineMs` bounds the TCP connection, `0` waiting
	/// without one; the options' handshake deadline bounds the handshake. The dial comes first so a network
	/// failure is reported as one even when no roots can be loaded.
	public static function connect(host String, port NetworkPort, options TlsClientOptions = TlsClientOptions.create(), dialDeadlineMs SocketDeadlineMs = NoDeadlineMs) returns TlsStream throws TlsError
		let transport = try TcpClient.connect(host, port: port, deadlineMs: dialDeadlineMs) otherwise (failure) 'unreachable'
			throw tlsNetworkFailure(failure)
		end 'unreachable'

		return try over(transport, host: host, options: options)
	end 'connect'

	module static function over(transport TcpClient, host String, options TlsClientOptions) returns TlsStream throws TlsError
		let config = options.configFor(host)
		var peer = try options.authenticator()
		let entropy = try TlsClientEntropy.fresh(config) otherwise throw TlsError.entropyUnavailable
		var endpoint = try TlsClientHandshake.create(config, entropy: entropy, peer: peer, helloSource: TlsBuiltClientHello.create()) otherwise throw TlsError.invalidConfiguration

		return try TlsStream.establish(transport, endpoint: endpoint, peer: peer, deadlineMs: options.handshakeDeadlineMs)
	end 'over'
end 'TlsClient'
