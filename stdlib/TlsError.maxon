/// Failures of the TLS client, listener and stream.
/// @category Network

/// Why a TLS operation failed. Transport cases mirror `NetworkError`; `connectionClosed` is the
/// peer's close_notify, `truncated` a transport that ended without one, and `closed` a stream
/// already closed. `handshakeTimedOut` is a connection whose handshake missed its deadline, where
/// `timedOut` is a connect, accept, read or write deadline. `certificateRejected` is this side
/// refusing the peer's chain, `protocolError` the alert this side sent, `peerAlert` the alert the
/// peer sent. `handshakePending` is a query for what the handshake negotiated, made on a stream
/// whose handshake has not completed.
public union TlsError implements Error
	resolveFailed
	connectFailed
	bindFailed
	acceptFailed
	acceptInterrupted
	timedOut
	handshakeTimedOut
	sendFailed
	recvFailed
	connectionClosed
	truncated
	closed
	handshakePending
	trustStoreUnavailable
	entropyUnavailable
	invalidConfiguration
	invalidCertificate
	invalidPrivateKey
	invalidPem
	certificateRejected(reason X509VerifyError)
	protocolError(alert TlsAlert)
	peerAlert(alert TlsAlert)
	peerAlertUnrecognised(code Byte)
end 'TlsError'

function tlsNetworkFailure(failure NetworkError) returns TlsError
	return match failure 'failure'
		resolveFailed gives TlsError.resolveFailed
		connectFailed gives TlsError.connectFailed
		sendFailed gives TlsError.sendFailed
		connectionClosed gives TlsError.connectionClosed
		timedOut gives TlsError.timedOut
		bindFailed gives TlsError.bindFailed
		acceptFailed gives TlsError.acceptFailed
		acceptInterrupted gives TlsError.acceptInterrupted
	end 'failure'
end 'tlsNetworkFailure'

function streamFaultOfTls(error TlsError) returns StreamError
	return match error 'error'
		timedOut gives StreamError.timedOut
		closed gives StreamError.closed
		handshakeTimedOut or
		resolveFailed or
		connectFailed or
		bindFailed or
		acceptFailed or
		acceptInterrupted or
		sendFailed or
		recvFailed or
		connectionClosed or
		truncated or
		handshakePending or
		trustStoreUnavailable or
		entropyUnavailable or
		invalidConfiguration or
		invalidCertificate or
		invalidPrivateKey or
		invalidPem or
		certificateRejected or
		protocolError or
		peerAlert or
		peerAlertUnrecognised gives StreamError.secure(error)
	end 'error'
end 'streamFaultOfTls'

// A refusal is recorded only by the chain check, which ends the handshake, so a recorded one is
// the cause.
function tlsPublicFailure(failure TlsHandshakeError, session TlsSession, refusal TlsPeerRefusal) returns TlsError
	match refusal 'refusal'
		refused(reason) then return TlsError.certificateRejected(reason)
		none then return tlsSessionFailure(failure, session: session)
	end 'refusal'
end 'tlsPublicFailure'

function tlsSessionFailure(failure TlsHandshakeError, session TlsSession) returns TlsError
	if failure == TlsHandshakeError.alertReceived 'fromPeer'
		return tlsReceivedAlertFailure(session.input.receivedAlert)
	end 'fromPeer'

	let alert = try failure.sentAlert() otherwise panic("tlsSessionFailure: every failure but alertReceived names the alert it sent")

	return TlsError.protocolError(alert)
end 'tlsSessionFailure'

function tlsReceivedAlertFailure(received TlsReceivedAlert) returns TlsError
	match received 'received'
		described(code) then return tlsDescribedAlertFailure(code)
		none then panic("tlsReceivedAlertFailure: alertReceived is thrown only after the alert was recorded")
	end 'received'
end 'tlsReceivedAlertFailure'

function tlsDescribedAlertFailure(code Byte) returns TlsError
	let alert = try TlsAlert.fromRawValue(code) otherwise return TlsError.peerAlertUnrecognised(code)

	return TlsError.peerAlert(alert)
end 'tlsDescribedAlertFailure'
