/// Directory listing and existence checking operations.
/// @category System
/// Error for directory list operations
public enum DirectoryListError implements Error
	notFound
	accessDenied
	listFailed
end 'DirectoryListError'

/// Error for directory delete operations
public enum DirectoryDeleteError implements Error
	notFound
	notEmpty
	deleteFailed
end 'DirectoryDeleteError'

public typealias FilePathArray = Array with FilePath

/// Static directory operations.
public type Directory
	var dir as __ManagedDirectory

	/// List files and directories at a path
	public static function list(path FilePath) returns FilePathArray throws DirectoryListError
		let pattern = "{path.path}{FilePath.separator()}*"
		var search = Directory{
			dir: try __ManagedDirectory.openSearch(pattern.addressableBytes()) otherwise (opening) 'open'
				match opening 'why'
					notFound then throw DirectoryListError.notFound
					accessDenied then throw DirectoryListError.accessDenied
					openSearchFailed then throw DirectoryListError.listFailed
					default panic("__ManagedDirectory.openSearch answered an error it does not throw")
				end 'why'
			end 'open'
		}

		var result = FilePathArray.create(0)

		while (try search.dir.next() otherwise throw DirectoryListError.listFailed) != 0 'loop'
			let name = String.init(search.dir.filename())
			result.push(path.join(name))
		end 'loop'

		search.dir.close()
		return result
	end 'list'

	/// Check if a path exists and is a directory
	public static function exists(path FilePath) returns bool
		return __ManagedDirectory.exists(path.path.addressableBytes())
	end 'exists'

	/// Alternative name for discoverability
	public static function isDirectory(path FilePath) returns bool
		return Directory.exists(path)
	end 'isDirectory'

	/// Create a directory at the given path, including any missing parent
	/// directories (mkdir -p semantics). Returns true if the directory exists
	/// after the call.
	public static function create(path FilePath) returns bool
		if Directory.exists(path) 'already'
			return true
		end 'already'

		// A root has no parent, which is what ends the recursion.
		if let parent = try path.parent() 'hasParent'
			_ = Directory.create(parent)
		end 'hasParent'

		try __ManagedDirectory.create(path.path.addressableBytes()) otherwise 'createFailed'
			// The contract is about the directory EXISTING after the call, not about who made it: another
			// process can win the gap between the check above and this call, and a caller told `false` for a
			// directory that is plainly there refuses work it could have done.
			return Directory.exists(path)
		end 'createFailed'

		return true
	end 'create'

	/// Remove an EMPTY directory. A directory that still holds an entry is
	/// refused (`notEmpty`) rather than emptied, so nothing is removed that the
	/// caller did not name. `notFound` means nothing is at `path`; a file or a link there (a dangling
	/// one included) is `deleteFailed`, as is any other failed removal.
	public static function delete(path FilePath) throws DirectoryDeleteError
		try __ManagedDirectory.delete(path.path.addressableBytes()) otherwise (e) 'failed'
			match e 'classify'
				notFound then throw DirectoryDeleteError.notFound
				deleteNotEmpty then throw DirectoryDeleteError.notEmpty
				default throws DirectoryDeleteError.deleteFailed
			end 'classify'
		end 'failed'
	end 'delete'

	/// Remove `path` and everything below it, and answer the entries that could not be removed; an empty
	/// answer means nothing is left. A path that does not exist answers empty. A link is removed as one
	/// entry and never followed.
	public static function removeTree(path FilePath) returns FilePathArray
		let unremoved = FilePathArray.create(0)
		Directory.removeEntry(path, unremoved: unremoved)

		return unremoved
	end 'removeTree'

	/// Remove everything inside the directory `path` and keep the directory, answering the entries that
	/// could not be removed, as `removeTree` does.
	public static function removeContents(path FilePath) returns FilePathArray
		let unremoved = FilePathArray.create(0)

		if not Directory.exists(path) 'nothingThere'
			return unremoved
		end 'nothingThere'

		Directory.removeEntriesOf(path, unremoved: unremoved)

		return unremoved
	end 'removeContents'

	static function removeEntriesOf(directory FilePath, unremoved FilePathArray)
		let entries = try Directory.list(directory) otherwise (e) 'unlistable'
			match e 'why'
				notFound then return
				accessDenied or
				listFailed then unremoved.push(directory)
			end 'why'

			return
		end 'unlistable'

		for entry in entries 'eachEntry'
			Directory.removeEntry(entry, unremoved: unremoved)
		end 'eachEntry'
	end 'removeEntriesOf'

	// Deleted as a file first, and emptied only once `Directory.delete` refuses it as not empty: a link,
	// to a file or to a directory, goes in one of those two calls as one entry, so the walk never enters
	// a link and removes nothing outside the tree.
	static function removeEntry(entry FilePath, unremoved FilePathArray)
		try File.delete(entry) otherwise (notAFile) 'notDeletedAsAFile'
			match notAFile 'why'
				notFound then return
				accessDenied or
				busy or
				failed then Directory.removeDirectory(entry, unremoved: unremoved)
			end 'why'

			return
		end 'notDeletedAsAFile'
	end 'removeEntry'

	static function removeDirectory(directory FilePath, unremoved FilePathArray)
		try Directory.delete(directory) otherwise (refusal) 'notDeletedAsADirectory'
			match refusal 'why'
				notFound then return
				notEmpty then Directory.removeFilledDirectory(directory, unremoved: unremoved)
				deleteFailed then unremoved.push(directory)
			end 'why'
		end 'notDeletedAsADirectory'
	end 'removeDirectory'

	static function removeFilledDirectory(directory FilePath, unremoved FilePathArray)
		let before = unremoved.count()
		Directory.removeEntriesOf(directory, unremoved: unremoved)

		if unremoved.count() > before 'somethingInsideStays'
			return
		end 'somethingInsideStays'

		try Directory.delete(directory) otherwise (refusal) 'stays'
			match refusal 'why'
				notFound then return
				notEmpty or
				deleteFailed then unremoved.push(directory)
			end 'why'
		end 'stays'
	end 'removeFilledDirectory'

	/// Get the current working directory as a FilePath
	public static function currentPath() returns FilePath
		let managed = try __ManagedDirectory.currentPath() otherwise panic("Directory.currentPath: GetCurrentDirectory failed")
		let dirStr = String.init(managed)
		return try FilePath.from(dirStr) otherwise panic("Directory.currentPath: invalid path")
	end 'currentPath'
end 'Directory'
