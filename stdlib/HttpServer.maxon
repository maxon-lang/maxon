/// HTTP/1.1 server for answering requests over TCP and TLS connections.
/// @category Network
/// Server-side HTTP errors. `tlsFailed` carries the `TlsError` of a connection whose handshake or TLS session failed.
public union HttpServerError implements Error
	acceptFailed
	malformedRequest
	headersTooLarge
	bodyTooLarge
	unsupportedTransferEncoding
	readTimedOut
	connectionClosed
	sendFailed
	listenerClosed
	acceptTimedOut
	alreadyResponded
	unsupportedMethod
	unsupportedVersion
	acceptInterrupted
	invalidResponse
	tlsFailed(error TlsError)
end 'HttpServerError'

/// Why `serve` returned.
public enum HttpServeEnd
	closed
	listenerFailed
	acceptDeadlinePassed
end 'HttpServeEnd'

/// How long `serve` waits before it accepts again after an interrupted accept.
public typealias HttpAcceptRetryMs = int(0 to 1000)

/// What `serve` hands `HttpHandler.faulted`: an exchange it answered in its handler's place, or an
/// interrupted accept it is about to retry.
public union HttpHandlerFault
	threw(request HttpRequest, fault HttpServerError)
	threwAfterResponding(request HttpRequest, fault HttpServerError)
	threwAfterAFailedResponse(request HttpRequest, fault HttpServerError)
	threwWithoutAnyAnswer(request HttpRequest, fault HttpServerError)
	returnedWithoutResponding(request HttpRequest)
	returnedWithoutAnyAnswer(request HttpRequest)
	acceptInterrupted(retryMs HttpAcceptRetryMs)

	/// One line naming the request, the fault and what the peer was sent.
	public function describe() returns String
		return match self 'which'
			threw(request, fault) gives "{requestLabel(request)} failed with {fault.name} and was answered 500"
			threwAfterResponding(request, fault) gives "{requestLabel(request)} failed with {fault.name} after its answer was sent"
			threwAfterAFailedResponse(request, fault) gives "{requestLabel(request)} failed with {fault.name} after its answer could not be sent"
			threwWithoutAnyAnswer(request, fault) gives "{requestLabel(request)} failed with {fault.name}, and the 500 sent in its place could not be sent"
			returnedWithoutResponding(request) gives "{requestLabel(request)} ended without an answer and was answered 500"
			returnedWithoutAnyAnswer(request) gives "{requestLabel(request)} ended without an answer, and the 500 sent in its place could not be sent"
			acceptInterrupted(retryMs) gives "accepting a connection failed; the next attempt is in {retryMs} ms"
		end 'which'
	end 'describe'
end 'HttpHandlerFault'

function requestLabel(request HttpRequest) returns String
	return "{httpMethodToString(request.method())} {request.url().path}"
end 'requestLabel'

/// A byte count `HttpServerLimits` caps a request's head or body at.
public typealias HttpByteCap = int(0 to 1099511627776)

let DefaultMaxHeaderBytes = 16384
let DefaultMaxBodyBytes = 1048576
let DefaultReadDeadlineMs = 10000
let DefaultWriteDeadlineMs = 10000
let PlainTextContentType = "text/plain"
let AllowHeaderName = "allow"
let AllowedMethodSeparator = ", "
let NoAcceptRetryMs = 0 as HttpAcceptRetryMs
let FirstAcceptRetryMs = 5
let LastAcceptRetryMs = 1000
let AcceptRetryGrowth = 2
let ConnectionReapFloor = 64 as Count
let ConnectionReapGrowth = 2

/// The caps one server parses under.
public type HttpServerLimits
	public var maxHeaderBytes as HttpByteCap
	public var maxBodyBytes as HttpByteCap
	public var readDeadlineMs as SocketDeadlineMs
	public var writeDeadlineMs as SocketDeadlineMs

	public static function create() returns HttpServerLimits
		return HttpServerLimits{maxHeaderBytes: DefaultMaxHeaderBytes, maxBodyBytes: DefaultMaxBodyBytes, readDeadlineMs: DefaultReadDeadlineMs, writeDeadlineMs: DefaultWriteDeadlineMs}
	end 'create'
end 'HttpServerLimits'

enum ResponseStage
	awaiting
	answered
	abandoned
end 'ResponseStage'

type ExchangeProgress
	export var stage as ResponseStage

	static function create() returns ExchangeProgress
		return ExchangeProgress{stage: ResponseStage.awaiting}
	end 'create'
end 'ExchangeProgress'

/// What a handler can tell of the connection a request arrived on. A TLS connection reports the protocol and
/// cipher suite negotiated, the ALPN protocol, and the chain the client presented, empty when it presented none.
public union HttpConnectionSecurity
	plaintext
	tls(protocol TlsProtocol, cipherSuite TlsCipherSuite, applicationProtocol TlsApplicationProtocol, peerCertificates ByteArrays)
end 'HttpConnectionSecurity'

/// One accepted connection: the request that arrived and the response owed for it.
public type HttpExchange
	var inbound as HttpTransportReader
	let parsed as HttpRequest
	var progress as ExchangeProgress
	let writeDeadlineMs as SocketDeadlineMs
	let leftoverArrived as bool

	static function create(inbound HttpTransportReader, parsed HttpRequest, writeDeadlineMs SocketDeadlineMs, leftoverArrived bool) returns HttpExchange
		return HttpExchange{inbound: inbound, parsed: parsed, progress: ExchangeProgress.create(), writeDeadlineMs: writeDeadlineMs, leftoverArrived: leftoverArrived}
	end 'create'

	/// The request that arrived. Its `url()` is read from an absolute-form target, and otherwise built
	/// as `http://<Host><target>` (`https` on a TLS server), hostless for an HTTP/1.0 request that sent no `Host`.
	public function request() returns HttpRequest
		return self.parsed
	end 'request'

	/// Whether the request arrived over TLS, and what the handshake settled.
	public function security() returns HttpConnectionSecurity
		return try self.inbound.source.security() otherwise panic("HttpExchange.security: the request arrived over a connection whose handshake completed")
	end 'security'

	function stage() returns ResponseStage
		return self.progress.stage
	end 'stage'

	/// Write the response and close the connection. One connection carries one request. Throws
	/// `alreadyResponded` on a second answer, `invalidResponse` for a body on a 204 or 304 or an
	/// unsendable reason or header, and `sendFailed` when the write fails or outlasts the write deadline.
	public function respond(response HttpResponse) throws HttpServerError
		if self.progress.stage != ResponseStage.awaiting 'answeredAlready'
			throw HttpServerError.alreadyResponded
		end 'answeredAlready'

		let head = try httpBuildResponseHead(response)
		let sendsContent = self.parsed.method() != HttpMethod.head and httpStatusAllowsContent(response.statusCode())
		let wire = "{head}{response.body()}" if sendsContent else head

		try sendAndClose(self.inbound.source, wire: wire, writeDeadlineMs: self.writeDeadlineMs, lingering: self.leftoverArrived) otherwise 'writeFailed'
			self.progress.stage = ResponseStage.abandoned

			throw HttpServerError.sendFailed
		end 'writeFailed'

		self.progress.stage = ResponseStage.answered
	end 'respond'

	/// Answer a status, a body and its content type.
	public function respondWith(code StatusCode, body String, contentType String) throws HttpServerError
		try self.respond(httpResponseWith(code, body: body, contentType: contentType))
	end 'respondWith'
end 'HttpExchange'

/// What `serve` calls for each exchange. A handler that throws has its exchange answered `500`.
public interface HttpHandler
	function handle(exchange mutable HttpExchange) throws HttpServerError

	/// Told of each exchange `serve` answered in the handler's place, and of each interrupted accept.
	function faulted(fault HttpHandlerFault)
end 'HttpHandler'

union RequestArrival
	forResource(request HttpRequest, leftoverArrived bool)
	forTheServer(leftoverArrived bool)
end 'RequestArrival'

union ConnectionArrival
	ready(exchange HttpExchange)
	answered
end 'ConnectionArrival'

type ArrivedBody
	export let body as String
	export let leftoverArrived as bool

	static function create(body String, leftoverArrived bool) returns ArrivedBody
		return ArrivedBody{body: body, leftoverArrived: leftoverArrived}
	end 'create'
end 'ArrivedBody'

union ServerListener
	plain(listener TcpListener)
	secure(listener TlsListener)

	function port() returns NetworkPort
		match self 'which'
			plain(listener) then return listener.port()
			secure(listener) then return listener.port()
		end 'which'
	end 'port'

	function scheme() returns HttpUrlScheme
		return match self 'which'
			plain gives HttpUrlScheme.http
			secure gives HttpUrlScheme.https
		end 'which'
	end 'scheme'

	function accept() returns HttpTransport throws HttpServerError
		match self 'which'
			plain(listener) then return try plainConnectionFrom(listener)
			secure(listener) then return try secureConnectionFrom(listener)
		end 'which'
	end 'accept'

	function setAcceptDeadline(milliseconds SocketDeadlineMs) throws HttpServerError
		match self 'which'
			plain(listener) then try plainAcceptDeadline(listener, milliseconds: milliseconds)
			secure(listener) then try secureAcceptDeadline(listener, milliseconds: milliseconds)
		end 'which'
	end 'setAcceptDeadline'

	function close()
		match self 'which'
			plain(listener) then listener.close()
			secure(listener) then listener.close()
		end 'which'
	end 'close'
end 'ServerListener'

/// A bound listener that hands out one parsed request at a time.
public type HttpServer
	let listener as ServerListener
	var limits as HttpServerLimits
	var closed as bool
	let boundPort as NetworkPort

	/// Bind and begin listening. `port: 0` takes whichever free port the kernel gives.
	public static function bind(host String, port NetworkPort) returns HttpServer throws NetworkError
		let listener = try TcpListener.bind(host, port: port)

		return HttpServer.listening(ServerListener.plain(listener))
	end 'bind'

	/// Bind as `bind(host, port:)` does and serve HTTPS: each accepted connection runs the TLS handshake under
	/// `options`, offering the ALPN protocol `http/1.1`, before its request is read.
	public static function bindTls(host String, port NetworkPort, options TlsServerOptions) returns HttpServer throws TlsError
		let offering = options.clone()

		try offering.setApplicationProtocols([HttpApplicationProtocol]) otherwise panic("HttpServer: `{HttpApplicationProtocol}` is a usable ALPN protocol name")

		let listener = try TlsListener.bind(host, port: port, options: offering)

		return HttpServer.listening(ServerListener.secure(listener))
	end 'bindTls'

	static function listening(listener ServerListener) returns HttpServer
		return HttpServer{listener: listener, limits: HttpServerLimits.create(), closed: false, boundPort: listener.port()}
	end 'listening'

	/// The port this server is bound to — the one the kernel chose when `bind` was asked for `0`.
	public function port() returns NetworkPort
		return self.boundPort
	end 'port'

	/// Replace the caps later requests are parsed under.
	public function setLimits(caps HttpServerLimits)
		self.limits = caps
	end 'setLimits'

	/// Make an `accept()` still waiting `milliseconds` after this call throw `acceptTimedOut`, which
	/// ends `serve`. `0` clears it.
	public function setAcceptDeadline(milliseconds SocketDeadlineMs) throws HttpServerError
		try self.listener.setAcceptDeadline(milliseconds)
	end 'setAcceptDeadline'

	/// Take the next connection and the one request on it. A request this server refuses is answered
	/// on the connection with its status and then thrown, so the peer is not left waiting. An
	/// `OPTIONS *` is answered here, and the next connection taken. A connection whose TLS handshake
	/// fails is thrown as `tlsFailed`.
	public function accept() returns HttpExchange throws HttpServerError
		while true 'nextConnection'
			let transport = try self.nextTransport()
			let policy = self.connectionPolicy()
			let arrival = try policy.arrive(transport)

			match arrival 'arrival'
				ready(exchange) then return exchange
				answered then continue
			end 'arrival'
		end 'nextConnection'
	end 'accept'

	function nextTransport() returns HttpTransport throws HttpServerError
		if self.closed 'alreadyClosed'
			throw HttpServerError.listenerClosed
		end 'alreadyClosed'

		return try self.listener.accept()
	end 'nextTransport'

	function connectionPolicy() returns immutable ServerConnection
		return freeze ServerConnection.over(self.limits.clone(), scheme: self.listener.scheme())
	end 'connectionPolicy'

	/// Hand each accepted exchange to `handler` on a green thread of its own per connection, until
	/// a listener failure, the accept deadline or `.cancel()` on the promise of the `async` call that
	/// runs it; the answer says which, and is `closed` for a server already closed. A connection is
	/// read, and its handler run, on its own thread, so a client that stalls or a handler that
	/// computes delays only its own connection. `handler` is one value every connection reads at once,
	/// so it is `immutable` (build it with `freeze`): a handler whose methods write its fields is
	/// refused, and state that connections share lives in a service the handler holds a handle to.
	/// `serve` returns once every connection it took has finished. A refused request is skipped, and
	/// an interrupted accept is retried after a wait that doubles from 5 ms to 1 s.
	public function serve(handler immutable HttpHandler) returns HttpServeEnd
		var progress = ServeProgress.serving
		var retryMs = NoAcceptRetryMs
		let inFlight = ConnectionPromises.create(0)
		var reapAt = ConnectionReapFloor

		while stillServing(progress) 'acceptLoop'
			let transport = try self.nextTransport() otherwise (fault) 'refused'
				progress = progressAfter(fault)
				retryMs = acceptRetryAfter(fault, previous: retryMs)

				if retryMs != NoAcceptRetryMs 'backOff'
					handler.faulted(HttpHandlerFault.acceptInterrupted(retryMs))
					sleep(retryMs as Milliseconds)
				end 'backOff'

				continue
			end 'refused'

			retryMs = NoAcceptRetryMs

			let worker = spawn ConnectionWorker.create(self.connectionPolicy())

			inFlight.push(try worker.serve(handler, transport: transport) otherwise panic("HttpServer.serve: a connection worker that has just been spawned takes its first message"))

			if inFlight.count() >= reapAt 'reap'
				reapFinished(inFlight)
				reapAt = reapThresholdAfter(inFlight.count())
			end 'reap'
		end 'acceptLoop'

		awaitAll(inFlight)

		return servedUntil(progress)
	end 'serve'

	/// Stop listening and release the port. A later `accept()` throws `listenerClosed`, and a later `serve`
	/// returns `closed`.
	public function close()
		self.closed = true
		self.listener.close()
	end 'close'
end 'HttpServer'

type ServerConnection
	var limits as HttpServerLimits
	var scheme as HttpUrlScheme

	static function over(limits HttpServerLimits, scheme HttpUrlScheme) returns ServerConnection
		return ServerConnection{limits: limits, scheme: scheme}
	end 'over'

	function arrive(transport HttpTransport) returns ConnectionArrival throws HttpServerError
		let inbound = StreamReader.over(transport)

		let arrived = try self.readArrival(inbound) otherwise (fault) 'protocolFault'
			answerProtocolFault(inbound.source, fault: fault, writeDeadlineMs: self.limits.writeDeadlineMs)

			throw fault
		end 'protocolFault'

		match arrived 'arrival'
			forTheServer(leftoverArrived) then return self.answeredServerWide(inbound, leftoverArrived: leftoverArrived)
			forResource(request, leftoverArrived) then return ConnectionArrival.ready(HttpExchange.create(inbound, parsed: request, writeDeadlineMs: self.limits.writeDeadlineMs, leftoverArrived: leftoverArrived))
		end 'arrival'
	end 'arrive'

	function readArrival(inbound HttpTransportReader) returns RequestArrival throws HttpServerError
		try inbound.source.setReadDeadline(self.limits.readDeadlineMs) otherwise throw HttpServerError.connectionClosed

		let head = try httpParseRequestHead(try readRequestHead(inbound, cap: self.limits.maxHeaderBytes as LineCap), scheme: self.scheme)

		match head 'target'
			wholeServer(headers) then return RequestArrival.forTheServer((try self.bodyAfter(headers, inbound: inbound)).leftoverArrived)
			resource(method, url, headers) then return try self.resourceArrival(method, url: url, headers: headers, inbound: inbound)
		end 'target'
	end 'readArrival'

	function resourceArrival(method HttpMethod, url URL, headers HttpHeaders, inbound HttpTransportReader) returns RequestArrival throws HttpServerError
		let arrived = try self.bodyAfter(headers, inbound: inbound)
		let request = HttpRequest.parsed(method, url: url, headers: headers)
		request.setBody(arrived.body)

		return RequestArrival.forResource(request, leftoverArrived: arrived.leftoverArrived)
	end 'resourceArrival'

	function answeredServerWide(inbound HttpTransportReader, leftoverArrived bool) returns ConnectionArrival
		self.answerServerWideOptions(inbound.source, leftoverArrived: leftoverArrived)

		return ConnectionArrival.answered
	end 'answeredServerWide'

	function bodyAfter(headers HttpHeaders, inbound HttpTransportReader) returns ArrivedBody throws HttpServerError
		let declared = try httpDeclaredBodyLength(headers, cap: self.limits.maxBodyBytes)

		let body = try httpReadDeclared(inbound, length: declared) otherwise (cause) 'readFailed'
			throw serverReadFault(cause)
		end 'readFailed'

		return ArrivedBody.create(body, leftoverArrived: inbound.unreadBytes() > 0)
	end 'bodyAfter'

	function answerServerWideOptions(transport HttpTransport, leftoverArrived bool)
		let allowed = StringBuilder.create()

		for (iter, method) in HttpMethod.allCases.withIterator() 'eachMethod'
			if iter.index() > 0 'separated'
				allowed.append(AllowedMethodSeparator)
			end 'separated'

			allowed.append(httpMethodToString(method))
		end 'eachMethod'

		let headers = HttpHeaders.create()
		headers.set(AllowHeaderName, value: allowed.build())

		let answer = HttpResponse.create(StatusCode.ok, reasonPhrase: reasonPhraseOf(StatusCode.ok), responseHeaders: headers, responseBody: "")
		let head = try httpBuildResponseHead(answer) otherwise panic("answerServerWideOptions: the answer the server builds itself is always sendable")
		try sendAndClose(transport, wire: head, writeDeadlineMs: self.limits.writeDeadlineMs, lingering: leftoverArrived) otherwise ignore
	end 'answerServerWideOptions'
end 'ServerConnection'

enum ConnectionEnd
	refused
	served
end 'ConnectionEnd'

typealias ConnectionPromise = Promise with ConnectionEnd
typealias ConnectionPromises = Array with ConnectionPromise

// The handler travels in the message and is not kept in the state: a service cannot keep a value it
// shares with the sender, and the shared handler is read-only for every worker at once.
type ConnectionWorker
	var connection as immutable ServerConnection

	static function create(connection immutable ServerConnection) returns ConnectionWorker
		return ConnectionWorker{connection: connection}
	end 'create'

	export function serve(handler immutable HttpHandler, transport HttpTransport) returns ConnectionEnd
		let arrival = try self.connection.arrive(transport) otherwise return ConnectionEnd.refused

		match arrival 'arrival'
			ready(exchange) then dispatchExchange(exchange, handler: handler)
			answered then break
		end 'arrival'

		return ConnectionEnd.served
	end 'serve'
end 'ConnectionWorker'

function reapFinished(inFlight ConnectionPromises)
	var index = 0 as ElementIndex

	while index < inFlight.count() 'eachConnection'
		let finished = (try inFlight.get(index) otherwise panic("reapFinished: the index is inside the array")).isComplete()

		if finished 'collect'
			let promise = try inFlight.remove(index) otherwise panic("reapFinished: the index is inside the array")

			_ = await promise
		end 'collect' else 'running'
			index = index + 1
		end 'running'
	end 'eachConnection'
end 'reapFinished'

// A reap scans every promise, so the next one waits for the in-flight count to double.
function reapThresholdAfter(remaining Count) returns Count
	if remaining < ConnectionReapFloor 'fewRemain'
		return ConnectionReapFloor
	end 'fewRemain'

	return remaining * ConnectionReapGrowth
end 'reapThresholdAfter'

// A promise dropped before its coroutine finishes cancels it, so `serve` keeps each one until its
// connection is done.
function awaitAll(inFlight ConnectionPromises)
	for promise in inFlight 'eachConnection'
		_ = await promise
	end 'eachConnection'
end 'awaitAll'

function readRequestHead(inbound HttpTransportReader, cap LineCap) returns String throws HttpServerError
	let read = try httpReadHead(inbound, cap: cap) otherwise (cause) 'readFailed'
		throw serverReadFault(cause)
	end 'readFailed'

	match read 'head'
		line(text) then return text
		ended then throw HttpServerError.connectionClosed
		pastTheCap then throw HttpServerError.headersTooLarge
	end 'head'
end 'readRequestHead'

union ServeProgress
	serving
	ended(outcome HttpServeEnd)
end 'ServeProgress'

function stillServing(progress ServeProgress) returns bool
	return match progress 'which'
		serving gives true
		ended gives false
	end 'which'
end 'stillServing'

function servedUntil(progress ServeProgress) returns HttpServeEnd
	match progress 'which'
		serving then panic("HttpServer.serve: the accept loop ended while still serving")
		ended(outcome) then return outcome
	end 'which'
end 'servedUntil'

function progressAfter(fault HttpServerError) returns ServeProgress
	return match fault 'which'
		listenerClosed gives ServeProgress.ended(HttpServeEnd.closed)
		acceptFailed gives ServeProgress.ended(HttpServeEnd.listenerFailed)
		acceptTimedOut gives ServeProgress.ended(HttpServeEnd.acceptDeadlinePassed)
		acceptInterrupted or
		tlsFailed gives ServeProgress.serving
		malformedRequest or
		headersTooLarge or
		bodyTooLarge or
		unsupportedTransferEncoding or
		unsupportedMethod or
		unsupportedVersion or
		readTimedOut or
		connectionClosed or
		sendFailed or
		alreadyResponded or
		invalidResponse panic("HttpServer.serve: taking a connection does not throw `{fault.name}`")
	end 'which'
end 'progressAfter'

function acceptRetryAfter(fault HttpServerError, previous HttpAcceptRetryMs) returns HttpAcceptRetryMs
	return match fault 'which'
		acceptInterrupted gives longerRetryThan(previous)
		acceptFailed or
		malformedRequest or
		headersTooLarge or
		bodyTooLarge or
		unsupportedTransferEncoding or
		readTimedOut or
		connectionClosed or
		sendFailed or
		listenerClosed or
		acceptTimedOut or
		alreadyResponded or
		unsupportedMethod or
		unsupportedVersion or
		invalidResponse or
		tlsFailed gives NoAcceptRetryMs
	end 'which'
end 'acceptRetryAfter'

function longerRetryThan(previous HttpAcceptRetryMs) returns HttpAcceptRetryMs
	if previous == NoAcceptRetryMs 'firstRetry'
		return FirstAcceptRetryMs
	end 'firstRetry'

	if previous * AcceptRetryGrowth >= LastAcceptRetryMs 'atTheLongest'
		return LastAcceptRetryMs
	end 'atTheLongest'

	return previous * AcceptRetryGrowth
end 'longerRetryThan'

function plainConnectionFrom(listener TcpListener) returns HttpTransport throws HttpServerError
	let connection = try listener.accept() otherwise (cause) 'noConnection'
		throw listenerFaultOf(cause)
	end 'noConnection'

	return HttpTransport.plain(connection)
end 'plainConnectionFrom'

function secureConnectionFrom(listener TlsListener) returns HttpTransport throws HttpServerError
	let stream = try listener.accept() otherwise (error) 'noConnection'
		throw secureListenerFault(error)
	end 'noConnection'

	return HttpTransport.secure(stream)
end 'secureConnectionFrom'

function plainAcceptDeadline(listener TcpListener, milliseconds SocketDeadlineMs) throws HttpServerError
	try listener.setAcceptDeadline(milliseconds) otherwise 'noListener'
		throw HttpServerError.listenerClosed
	end 'noListener'
end 'plainAcceptDeadline'

function secureAcceptDeadline(listener TlsListener, milliseconds SocketDeadlineMs) throws HttpServerError
	try listener.setAcceptDeadline(milliseconds) otherwise 'noListener'
		throw HttpServerError.listenerClosed
	end 'noListener'
end 'secureAcceptDeadline'

function secureListenerFault(error TlsError) returns HttpServerError
	return match error 'error'
		timedOut gives listenerFaultOf(NetworkError.timedOut)
		acceptFailed gives listenerFaultOf(NetworkError.acceptFailed)
		acceptInterrupted gives listenerFaultOf(NetworkError.acceptInterrupted)
		handshakeTimedOut or
		resolveFailed or
		connectFailed or
		bindFailed or
		sendFailed or
		recvFailed or
		connectionClosed or
		truncated or
		closed or
		handshakePending or
		trustStoreUnavailable or
		entropyUnavailable or
		invalidConfiguration or
		invalidCertificate or
		invalidPrivateKey or
		invalidPem or
		certificateRejected or
		protocolError or
		peerAlert or
		peerAlertUnrecognised gives HttpServerError.tlsFailed(error)
	end 'error'
end 'secureListenerFault'

function listenerFaultOf(cause NetworkError) returns HttpServerError
	return match cause 'which'
		timedOut gives HttpServerError.acceptTimedOut
		acceptFailed gives HttpServerError.acceptFailed
		acceptInterrupted gives HttpServerError.acceptInterrupted
		default panic("HttpServer.accept: `TcpListener.accept` does not throw `{cause.name}`")
	end 'which'
end 'listenerFaultOf'

function dispatchExchange(exchange HttpExchange, handler HttpHandler)
	let request = exchange.request()

	try handler.handle(exchange) otherwise (fault) 'handlerThrew'
		handler.faulted(answerAThrow(exchange, request: request, fault: fault.clone()))

		return
	end 'handlerThrew'

	if exchange.stage() == ResponseStage.awaiting 'leftUnanswered'
		handler.faulted(answerInsteadOfTheHandler(exchange, answered: HttpHandlerFault.returnedWithoutResponding(request), unanswered: HttpHandlerFault.returnedWithoutAnyAnswer(request)))
	end 'leftUnanswered'
end 'dispatchExchange'

function answerAThrow(exchange HttpExchange, request HttpRequest, fault HttpServerError) returns HttpHandlerFault
	return match exchange.stage() 'stage'
		answered gives HttpHandlerFault.threwAfterResponding(request, fault: fault)
		abandoned gives HttpHandlerFault.threwAfterAFailedResponse(request, fault: fault)
		awaiting gives answerInsteadOfTheHandler(exchange, answered: HttpHandlerFault.threw(request, fault: fault), unanswered: HttpHandlerFault.threwWithoutAnyAnswer(request, fault: fault))
	end 'stage'
end 'answerAThrow'

function answerInsteadOfTheHandler(exchange HttpExchange, answered HttpHandlerFault, unanswered HttpHandlerFault) returns HttpHandlerFault
	try exchange.respondWith(StatusCode.internalServerError, body: "", contentType: PlainTextContentType) otherwise return unanswered

	return answered
end 'answerInsteadOfTheHandler'

union ProtocolAnswer
	status(code StatusCode, lingering bool)
	unanswerable
end 'ProtocolAnswer'

function protocolAnswerFor(fault HttpServerError) returns ProtocolAnswer
	return match fault 'which'
		connectionClosed gives ProtocolAnswer.status(StatusCode.badRequest, lingering: false)
		malformedRequest gives ProtocolAnswer.status(StatusCode.badRequest, lingering: true)
		headersTooLarge gives ProtocolAnswer.status(StatusCode.headerFieldsTooLarge, lingering: true)
		bodyTooLarge gives ProtocolAnswer.status(StatusCode.payloadTooLarge, lingering: true)
		unsupportedTransferEncoding or
		unsupportedMethod gives ProtocolAnswer.status(StatusCode.notImplemented, lingering: true)
		unsupportedVersion gives ProtocolAnswer.status(StatusCode.httpVersionNotSupported, lingering: true)
		readTimedOut gives ProtocolAnswer.status(StatusCode.requestTimeout, lingering: true)
		tlsFailed gives ProtocolAnswer.unanswerable
		acceptFailed or
		sendFailed or
		listenerClosed or
		acceptTimedOut or
		alreadyResponded or
		acceptInterrupted or
		invalidResponse panic("HttpServer.protocolAnswerFor: `{fault.name}` is not a fault reading a request can end in")
	end 'which'
end 'protocolAnswerFor'

// A failed send is ignored: the peer may already be gone, and the caller must see the fault the
// request was refused for.
function answerProtocolFault(connection HttpTransport, fault HttpServerError, writeDeadlineMs SocketDeadlineMs)
	match protocolAnswerFor(fault) 'answer'
		status(code, lingering) then sendProtocolStatus(connection, code: code, lingering: lingering, writeDeadlineMs: writeDeadlineMs)
		unanswerable then connection.close()
	end 'answer'
end 'answerProtocolFault'

function sendProtocolStatus(connection HttpTransport, code StatusCode, lingering bool, writeDeadlineMs SocketDeadlineMs)
	let answer = httpResponseWith(code, body: "", contentType: PlainTextContentType)
	let head = try httpBuildResponseHead(answer) otherwise panic("sendProtocolStatus: a refusal the server builds itself is always sendable")
	try sendAndClose(connection, wire: head, writeDeadlineMs: writeDeadlineMs, lingering: lingering) otherwise ignore
end 'sendProtocolStatus'

function sendAndClose(connection HttpTransport, wire String, writeDeadlineMs SocketDeadlineMs, lingering bool) throws HttpTransportFault
	try sendWithin(connection, wire: wire, writeDeadlineMs: writeDeadlineMs) otherwise (e) 'unsent'
		connection.close()

		throw e
	end 'unsent'

	closeConnection(connection, lingering: lingering)
end 'sendAndClose'

function sendWithin(connection HttpTransport, wire String, writeDeadlineMs SocketDeadlineMs) throws HttpTransportFault
	try connection.setWriteDeadline(writeDeadlineMs)
	try connection.send(wire)
end 'sendWithin'

function closeConnection(connection HttpTransport, lingering bool)
	if lingering 'peerMayStillSend'
		connection.closeAfterDraining()
	end 'peerMayStillSend' else 'peerHasSaidItAll'
		connection.close()
	end 'peerHasSaidItAll'
end 'closeConnection'

function serverReadFault(cause StreamError) returns HttpServerError
	return match cause 'which'
		timedOut gives HttpServerError.readTimedOut
		closed or
		failed gives HttpServerError.connectionClosed
		secure(error) gives HttpServerError.tlsFailed(error)
	end 'which'
end 'serverReadFault'
