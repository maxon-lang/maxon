/// Standard input as a `ByteSource`; `Console.stdin()` reads it through a `StreamReader`.
/// @category System
public type StdinSource implements ByteSource
	static function create() returns StdinSource
		return Self{}
	end 'create'

	public function readSome(most ReadCapacity) returns isolated ByteArray throws StreamError
		return ByteArray.init(__Builtins.readStdin(most))
	end 'readSome'
end 'StdinSource'

/// Convenience factory namespace. `Console.stdin()` is the typical entry point.
public type Console
	/// A reader over standard input with nothing buffered; keep one for the life of the program.
	public static function stdin() returns StdinReader
		return StreamReader.over(StdinSource.create())
	end 'stdin'

	/// Whether output written to stdout may carry ANSI color escape sequences. A target that cannot
	/// ask its host answers false.
	public static function stdoutWantsColor() returns bool
		return __Builtins.stdoutWantsAnsiColor()
	end 'stdoutWantsColor'
end 'Console'
