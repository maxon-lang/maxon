/// HTTP/1.1 client for making HTTP requests over TCP.
/// @category Network
/// HTTP client errors
public enum HttpError implements Error
	invalidUrl
	connectFailed
	sendFailed
	recvFailed
	invalidResponse
	unsupportedScheme
	timedOut
	bodyTooLarge
end 'HttpError'

/// HTTP request methods
public enum HttpMethod
	get
	post
	put
	delete
	head
	patch
	options
end 'HttpMethod'

/// Case-insensitive HTTP header map.
public type HttpHeaders
	typealias CaseInsensitiveHeaders = Map with String, String

	public var headers as CaseInsensitiveHeaders

	public static function create() returns HttpHeaders
		return HttpHeaders{headers: CaseInsensitiveHeaders.create()}
	end 'create'

	/// Set a header (name is lowercased for case-insensitive storage).
	public function set(name String, value String)
		var key = name
		headers.upsert(key.toLower(), value: value)
	end 'set'

	/// Get a header value by name. Throws if not present.
	public function get(name String) returns String throws HttpError
		var key = name
		let val = try headers.get(key.toLower()) otherwise 'notFound'
			throw HttpError.invalidResponse
		end 'notFound'

		return val
	end 'get'

	/// Check if a header is present.
	public function has(name String) returns bool
		var key = name
		return headers.contains(key.toLower())
	end 'has'
end 'HttpHeaders'

/// An HTTP request with method, URL, headers, and body.
public type HttpRequest
	var httpMethod as HttpMethod
	var requestUrl as URL
	var requestHeaders as HttpHeaders
	var requestBody as String

	/// Create a request from a method and URL string.
	public static function create(method HttpMethod, url String) returns HttpRequest throws HttpError
		let parsed = try URL.parse(url) otherwise 'badUrl'
			throw HttpError.invalidUrl
		end 'badUrl'

		return HttpRequest.parsed(method, url: parsed, headers: HttpHeaders.create())
	end 'create'

	module static function parsed(method HttpMethod, url URL, headers HttpHeaders) returns HttpRequest
		return HttpRequest{
			httpMethod: method,
			requestUrl: url,
			requestHeaders: headers,
			requestBody: ""
		}
	end 'parsed'

	/// Set a request header.
	public function setHeader(name String, value String)
		requestHeaders.set(name, value: value)
	end 'setHeader'

	/// Set the request body.
	public function setBody(body String)
		requestBody = body
	end 'setBody'

	public function url() returns URL
		return requestUrl
	end 'url'

	public function method() returns HttpMethod
		return httpMethod
	end 'method'

	public function headers() returns HttpHeaders
		return requestHeaders
	end 'headers'

	public function body() returns String
		return requestBody
	end 'body'
end 'HttpRequest'

/// A status code's three-digit number.
public typealias HttpStatusNumber = int(100 to 999)

/// HTTP status codes. A status with no named case is `other`, carrying its number.
public union StatusCode
	ok
	created
	accepted
	noContent
	movedPermanently
	found
	notModified
	badRequest
	unauthorized
	forbidden
	notFound
	methodNotAllowed
	requestTimeout
	conflict
	gone
	lengthRequired
	payloadTooLarge
	tooManyRequests
	headerFieldsTooLarge
	internalServerError
	notImplemented
	badGateway
	serviceUnavailable
	httpVersionNotSupported
	other(code HttpStatusNumber)

	public function number() returns HttpStatusNumber
		return match self 'which'
			ok gives 200
			created gives 201
			accepted gives 202
			noContent gives 204
			movedPermanently gives 301
			found gives 302
			notModified gives 304
			badRequest gives 400
			unauthorized gives 401
			forbidden gives 403
			notFound gives 404
			methodNotAllowed gives 405
			requestTimeout gives 408
			conflict gives 409
			gone gives 410
			lengthRequired gives 411
			payloadTooLarge gives 413
			tooManyRequests gives 429
			headerFieldsTooLarge gives 431
			internalServerError gives 500
			notImplemented gives 501
			badGateway gives 502
			serviceUnavailable gives 503
			httpVersionNotSupported gives 505
			other(code) gives code
		end 'which'
	end 'number'
end 'StatusCode'

/// The `StatusCode` for a status number: its named case, or `other(number)`.
public function statusCodeOf(number HttpStatusNumber) returns StatusCode
	return match number 'which'
		200 gives StatusCode.ok
		201 gives StatusCode.created
		202 gives StatusCode.accepted
		204 gives StatusCode.noContent
		301 gives StatusCode.movedPermanently
		302 gives StatusCode.found
		304 gives StatusCode.notModified
		400 gives StatusCode.badRequest
		401 gives StatusCode.unauthorized
		403 gives StatusCode.forbidden
		404 gives StatusCode.notFound
		405 gives StatusCode.methodNotAllowed
		408 gives StatusCode.requestTimeout
		409 gives StatusCode.conflict
		410 gives StatusCode.gone
		411 gives StatusCode.lengthRequired
		413 gives StatusCode.payloadTooLarge
		429 gives StatusCode.tooManyRequests
		431 gives StatusCode.headerFieldsTooLarge
		500 gives StatusCode.internalServerError
		501 gives StatusCode.notImplemented
		502 gives StatusCode.badGateway
		503 gives StatusCode.serviceUnavailable
		505 gives StatusCode.httpVersionNotSupported
		min upto 200 or
			203 or
			205 upto 301 or
			303 or
			305 upto 400 or
			402 or
			406 to 407 or
			412 or
			414 upto 429 or
			430 or
			432 upto 500 or
			504 or
			506 to max gives StatusCode.other(number)
		default panic("statusCodeOf: {number} fell outside every arm, which together cover every integer")
	end 'which'
end 'statusCodeOf'

/// The reason phrase HTTP/1.1 pairs with a status code; empty for `other`.
public function reasonPhraseOf(code StatusCode) returns String
	return match code 'which'
		other gives ""
		ok gives "OK"
		created gives "Created"
		accepted gives "Accepted"
		noContent gives "No Content"
		movedPermanently gives "Moved Permanently"
		found gives "Found"
		notModified gives "Not Modified"
		badRequest gives "Bad Request"
		unauthorized gives "Unauthorized"
		forbidden gives "Forbidden"
		notFound gives "Not Found"
		methodNotAllowed gives "Method Not Allowed"
		requestTimeout gives "Request Timeout"
		conflict gives "Conflict"
		gone gives "Gone"
		lengthRequired gives "Length Required"
		payloadTooLarge gives "Payload Too Large"
		tooManyRequests gives "Too Many Requests"
		headerFieldsTooLarge gives "Request Header Fields Too Large"
		internalServerError gives "Internal Server Error"
		notImplemented gives "Not Implemented"
		badGateway gives "Bad Gateway"
		serviceUnavailable gives "Service Unavailable"
		httpVersionNotSupported gives "HTTP Version Not Supported"
	end 'which'
end 'reasonPhraseOf'

/// An HTTP response with status code, headers, and body.
public type HttpResponse
	var code as StatusCode
	var reasonPhrase as String
	var responseHeaders as HttpHeaders
	var responseBody as String

	public static function create(code StatusCode, reasonPhrase String, responseHeaders HttpHeaders, responseBody String) returns HttpResponse
		return HttpResponse{code: code, reasonPhrase: reasonPhrase, responseHeaders: responseHeaders, responseBody: responseBody}
	end 'create'

	public function statusCode() returns StatusCode
		return code
	end 'statusCode'

	public function reason() returns String
		return reasonPhrase
	end 'reason'

	public function headers() returns HttpHeaders
		return responseHeaders
	end 'headers'

	public function body() returns String
		return responseBody
	end 'body'

	/// Get a response header by name. Throws if not present.
	public function header(name String) returns String throws HttpError
		return try responseHeaders.get(name)
	end 'header'
end 'HttpResponse'

let FormContentType = "application/x-www-form-urlencoded"

public typealias HttpExchangeDeadlineMs = int(1 to 4294967295)

let DefaultExchangeDeadlineMs = 30000

/// The largest response body `HttpClient.send` accepts.
public union HttpBodyCap
	unbounded
	atMost(bytes HttpByteCap)
end 'HttpBodyCap'

/// Bounds on one `HttpClient.send`. `timeoutMs` covers the whole exchange, connect included, and
/// defaults to 30000; `maxBodyBytes` defaults to `unbounded`.
public type HttpClientLimits
	public var timeoutMs as HttpExchangeDeadlineMs
	public var maxBodyBytes as HttpBodyCap

	public static function create() returns HttpClientLimits
		return HttpClientLimits{timeoutMs: DefaultExchangeDeadlineMs, maxBodyBytes: HttpBodyCap.unbounded}
	end 'create'
end 'HttpClientLimits'

/// Stateless HTTP/1.1 client. All methods are static.
/// HTTP only (no TLS). A response body is framed by `Transfer-Encoding`, then `Content-Length`, and
/// is otherwise read until the server closes the connection.
public type HttpClient
	/// Send an HTTP request and return the response. Throws `timedOut` past `limits.timeoutMs` and
	/// `bodyTooLarge` past `limits.maxBodyBytes`.
	public static function send(request HttpRequest, limits HttpClientLimits = HttpClientLimits.create()) returns HttpResponse throws HttpError
		let start = Clock.nowMs()
		let target = try httpConnectTargetOf(request.url())

		let rawRequest = httpBuildRequest(request, target: target)

		let connectBudgetMs = try remainingBudget(start, timeoutMs: limits.timeoutMs)

		var client = try TcpClient.connect(target.host, port: target.port, deadlineMs: connectBudgetMs) otherwise (cause) 'connFail'
			throw HttpError.timedOut if cause == NetworkError.timedOut else HttpError.connectFailed
		end 'connFail'

		try boundByTheDeadline(client, start: start, timeoutMs: limits.timeoutMs)

		_ = try client.send(rawRequest) otherwise (cause) 'sendFail'
			throw HttpError.timedOut if cause == NetworkError.timedOut else HttpError.sendFailed
		end 'sendFail'

		let response = try receiveResponse(client, method: request.method(), cap: limits.maxBodyBytes)
		client.close()

		return response
	end 'send'

	/// Perform an HTTP GET request.
	public static function get(url String) returns HttpResponse throws HttpError
		let request = try HttpRequest.create(HttpMethod.get, url: url)
		return try send(request)
	end 'get'

	/// Perform an HTTP POST request with a body.
	public static function post(url String, body String) returns HttpResponse throws HttpError
		var request = try HttpRequest.create(HttpMethod.post, url: url)
		request.setBody(body)
		request.setHeader(HttpContentTypeHeaderName, value: FormContentType)
		return try send(request)
	end 'post'

	/// Perform an HTTP PUT request with a body.
	public static function put(url String, body String) returns HttpResponse throws HttpError
		var request = try HttpRequest.create(HttpMethod.put, url: url)
		request.setBody(body)
		return try send(request)
	end 'put'

	/// Perform an HTTP DELETE request.
	public static function delete(url String) returns HttpResponse throws HttpError
		let request = try HttpRequest.create(HttpMethod.delete, url: url)
		return try send(request)
	end 'delete'
end 'HttpClient'

let MaxResponseHeadBytes = 65536 as BytePos
let MaxChunkLineBytes = 4096 as BytePos
let MostInterimResponses = 8
let HexBase = 16 as BytePos
let ChunkBlankBytes = " \t"
let ChunkExtensionIntroducer = ";"

// A close here ends a message before its framing does, so it is a truncated response. The close
// that ends a close-delimited body is taken by `receiveMoreBeforeTheClose` and never reaches this
// mapping.
function clientReadFault(cause NetworkError) returns HttpError
	return match cause 'which'
		connectionClosed gives HttpError.invalidResponse
		recvFailed gives HttpError.recvFailed
		timedOut gives HttpError.timedOut
		default panic("HttpClient: `TcpClient.recv` does not throw `{cause.name}`")
	end 'which'
end 'clientReadFault'

function remainingBudget(start InstantMs, timeoutMs HttpExchangeDeadlineMs) returns SocketDeadlineMs throws HttpError
	let spentMs = Clock.elapsedMs(start)
	let budgetMs = timeoutMs as DurationMs

	if spentMs >= budgetMs 'spent'
		throw HttpError.timedOut
	end 'spent'

	return (budgetMs - spentMs) as SocketDeadlineMs
end 'remainingBudget'

// A `TcpClient` deadline counts from the call that sets it, so both are set once, to what is left of the
// exchange's budget.
function boundByTheDeadline(client TcpClient, start InstantMs, timeoutMs HttpExchangeDeadlineMs) throws HttpError
	let remainingMs = try remainingBudget(start, timeoutMs: timeoutMs)

	try client.setReadDeadline(remainingMs) otherwise panic("HttpClient: a connection it just opened is not closed")
	try client.setWriteDeadline(remainingMs) otherwise panic("HttpClient: a connection it just opened is not closed")
end 'boundByTheDeadline'

function exceedsCap(cap HttpBodyCap, bodyBytes BytePos) returns bool
	return match cap 'which'
		unbounded gives false
		atMost(bytes) gives bodyBytes > bytes as BytePos
	end 'which'
end 'exceedsCap'

function receiveResponse(client TcpClient, method HttpMethod, cap HttpBodyCap) returns HttpResponse throws HttpError
	var inbound = HttpInbound.over(client)

	for _ in 0 to MostInterimResponses 'eachHead'
		let head = try readDelimited(inbound, delimiter: HttpDelimiter.head, cap: MaxResponseHeadBytes)

		match try httpResponseStatusOf(head) 'status'
			final(response) then return try withFramedBody(inbound, response: response, method: method, cap: cap)
			interim then continue
		end 'status'
	end 'eachHead'

	throw HttpError.invalidResponse
end 'receiveResponse'

function readDelimited(inbound HttpInbound, delimiter HttpDelimiter, cap BytePos) returns String throws HttpError
	let read = try httpReadDelimited(inbound, delimiter: delimiter, cap: cap) otherwise (cause) 'readFailed'
		throw clientReadFault(cause)
	end 'readFailed'

	match read 'delimited'
		delimited(text) then return text
		pastTheCap then throw HttpError.invalidResponse
	end 'delimited'
end 'readDelimited'

function withFramedBody(inbound HttpInbound, response HttpResponse, method HttpMethod, cap HttpBodyCap) returns HttpResponse throws HttpError
	let body = match try httpResponseFramingOf(response, method: method) 'framing'
		bodiless gives ""
		declared(length) gives try readCappedDeclaredBody(inbound, length: length, cap: cap)
		chunked gives try readChunkedBody(inbound, cap: cap)
		closeDelimited gives try readUntilClosed(inbound, cap: cap)
	end 'framing'

	return HttpResponse.create(response.statusCode(), reasonPhrase: response.reason(), responseHeaders: response.headers(), responseBody: body)
end 'withFramedBody'

function readDeclaredBody(inbound HttpInbound, length BytePos) returns String throws HttpError
	let body = try httpReadDeclared(inbound, length: length) otherwise (cause) 'readFailed'
		throw clientReadFault(cause)
	end 'readFailed'

	return body
end 'readDeclaredBody'

function readCappedDeclaredBody(inbound HttpInbound, length BytePos, cap HttpBodyCap) returns String throws HttpError
	if exceedsCap(cap, bodyBytes: length) 'pastTheCap'
		throw HttpError.bodyTooLarge
	end 'pastTheCap'

	return try readDeclaredBody(inbound, length: length)
end 'readCappedDeclaredBody'

function receiveMoreBeforeTheClose(inbound HttpInbound) returns bool throws HttpError
	try inbound.receiveMore() otherwise (cause) 'recvErr'
		if cause == NetworkError.connectionClosed 'serverFinished'
			return false
		end 'serverFinished'

		throw clientReadFault(cause)
	end 'recvErr'

	return true
end 'receiveMoreBeforeTheClose'

function readUntilClosed(inbound HttpInbound, cap HttpBodyCap) returns String throws HttpError
	var open = true

	while open 'drain'
		open = try receiveMoreBeforeTheClose(inbound)

		if inbound.unreadBytes() > HttpLargestBodyBytes 'pastTheLargestBody'
			throw HttpError.invalidResponse
		end 'pastTheLargestBody'

		if exceedsCap(cap, bodyBytes: inbound.unreadBytes()) 'pastTheCap'
			throw HttpError.bodyTooLarge
		end 'pastTheCap'
	end 'drain'

	return inbound.take(inbound.unreadBytes())
end 'readUntilClosed'

function readChunkedBody(inbound HttpInbound, cap HttpBodyCap) returns String throws HttpError
	var body = StringBuilder.create()
	var bodyBytes = 0 as BytePos
	var size = try chunkSizeOf(try readDelimited(inbound, delimiter: HttpDelimiter.line, cap: MaxChunkLineBytes))

	while size > 0 'eachChunk'
		if size > HttpLargestBodyBytes - bodyBytes 'pastTheLargestBody'
			throw HttpError.invalidResponse
		end 'pastTheLargestBody'

		bodyBytes = bodyBytes + size

		if exceedsCap(cap, bodyBytes: bodyBytes) 'pastTheCap'
			throw HttpError.bodyTooLarge
		end 'pastTheCap'

		body.append(try readDeclaredBody(inbound, length: size))

		let dataEnd = try readDelimited(inbound, delimiter: HttpDelimiter.line, cap: MaxChunkLineBytes)

		if not dataEnd.isEmpty() 'dataOverranItsSize'
			throw HttpError.invalidResponse
		end 'dataOverranItsSize'

		size = try chunkSizeOf(try readDelimited(inbound, delimiter: HttpDelimiter.line, cap: MaxChunkLineBytes))
	end 'eachChunk'

	try discardTrailerSection(inbound)

	return body.build()
end 'readChunkedBody'

function discardTrailerSection(inbound HttpInbound) throws HttpError
	var trailerBytes = 0 as BytePos
	var field = try readDelimited(inbound, delimiter: HttpDelimiter.line, cap: MaxChunkLineBytes)

	while not field.isEmpty() 'eachTrailerField'
		trailerBytes = trailerBytes + field.byteLength() + HttpLineBreak.byteLength()

		if trailerBytes > MaxResponseHeadBytes 'pastTheCap'
			throw HttpError.invalidResponse
		end 'pastTheCap'

		field = try readDelimited(inbound, delimiter: HttpDelimiter.line, cap: MaxChunkLineBytes)
	end 'eachTrailerField'
end 'discardTrailerSection'

function chunkSizeOf(line String) returns BytePos throws HttpError
	var size = 0 as BytePos
	var sizeEnd = 0 as BytePos

	while sizeEnd < line.byteLength() 'eachDigit'
		match urlHexDigitOf(line.byteAtOrPanic(sizeEnd)) 'reading'
			value(digit) then size = try withHexDigit(size, digit: digit as BytePos)
			notAHexDigit then break 'eachDigit'
		end 'reading'

		sizeEnd = sizeEnd + 1
	end 'eachDigit'

	if sizeEnd == 0 'noSize'
		throw HttpError.invalidResponse
	end 'noSize'

	if sizeEnd < line.byteLength() and not extensionFollows(line, from: sizeEnd) 'notAnExtension'
		throw HttpError.invalidResponse
	end 'notAnExtension'

	return size
end 'chunkSizeOf'

function withHexDigit(size BytePos, digit BytePos) returns BytePos throws HttpError
	if size > (HttpLargestBodyBytes - digit) / HexBase 'pastTheLargest'
		throw HttpError.invalidResponse
	end 'pastTheLargest'

	return size * HexBase + digit
end 'withHexDigit'

function extensionFollows(line String, from BytePos) returns bool
	var pos = from

	while pos < line.byteLength() and urlByteIsOneOf(line.byteAtOrPanic(pos), bytes: ChunkBlankBytes) 'eachBlank'
		pos = pos + 1
	end 'eachBlank'

	return pos < line.byteLength() and urlByteIsOneOf(line.byteAtOrPanic(pos), bytes: ChunkExtensionIntroducer)
end 'extensionFollows'
