/// UTF-8 encoded immutable string with Unicode grapheme cluster iteration.
/// @category Text
// String receives __ManagedMemory directly for literal initialization via BuiltinStringLiteral.

// StringError - errors for string operations
export enum StringError implements Error
	notFound
	invalidIndex
end 'StringError'

export typealias ByteCount = int(0 to u64.max)
export typealias GraphemeCount = int(0 to u64.max)
export typealias BytePos = int(0 to u64.max)
export typealias GraphemeIndex = int(0 to u64.max)

// File-private. The stdlib's canonical declarations of `Byte` and
// `ByteArray` live in `stdlib/File.maxon`, which the self-hosted compiler
// can't yet whitelist. Until then, declaring them here as file-private gets
// the names into scope for `String.from(bytes ByteArray)` and the
// `__ManagedMemory with Byte` aliases without colliding with user code that
// declares its own file-private `typealias Byte` / `typealias ByteArray`.
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

// The UTF-8 bytes behind a `String`, nameable at FILE scope — `String.ByteMemory` is not, and a
// generic cannot be instantiated inline in a parameter type. `StringBuilder.appendBytes` needs to say
// it, so it is said once here.
typealias ByteBuffer = __ManagedMemory with Byte

// The signed shift between an ASCII letter and its opposite case: +32 upper->lower, -32 lower->upper.
// `String.mapAsciiCase` adds it to a byte in the A-Z / a-z range.
typealias AsciiCaseDelta = int(-32 to 32)

export type String implements BuiltinStringLiteral, Hashable, Equatable, Iterable with (Character, StringIterator), Cloneable
	typealias ByteMemory = __ManagedMemory with Byte

	/// The raw bytes. Since the envelope collapse a `String` IS its `__ManagedMemory`, so this is not
	/// a view of the string, it is the string — which is exactly why nobody outside `String` may hold
	/// it. Reaching the bytes from elsewhere in the stdlib goes through `addressableBytes()`.
	///
	/// This was `export var` until Stage 4c. Exported, it was a WRITE door that reached past every
	/// guarantee this type makes: it was the one way to break `toByteArray`'s independence, since a
	/// view that has not yet been written is still sharing these bytes and a write here would show
	/// through it. Unexporting removed the spelling a caller would reach for by accident, and left
	/// `toByteArray()` — which copies on write — as the route user code is offered.
	///
	/// The field is now genuinely unreachable from user code (E3014), and `addressableBytes()` —
	/// the stdlib's replacement door — is genuinely internal (E3008). Both took removing the
	/// stdlib force-export; see that method's doc.
	///
	/// The field STAYS, and stays first: field order is the ABI, and literal initialization writes
	/// these two fields directly.
	var managed as ByteMemory
	var isAsciiFlag as bool

	/// Check whether this string contains only ASCII bytes
	export function isAscii() returns bool
		return isAsciiFlag
	end 'isAscii'

	// Default type for string literals - compiler discovers this via BuiltinStringLiteral interface.
	// The C# compiler bypasses this for literals and writes fields directly (including isAsciiFlag).
	// For runtime-created strings, scan the bytes to determine ASCII status.
	export static function init(managed ByteMemory) returns String
		return String{managed: managed, isAsciiFlag: scanIsAscii(managed)}
	end 'init'

	/// Create a String from a byte array (zero-copy slice of the array's backing memory)
	export static function from (bytes ByteArray) returns String
		return String{managed: bytes.managed, isAsciiFlag: scanIsAscii(bytes.managed)}
	end 'from'

	// `from`, for a caller that ALREADY KNOWS whether the bytes are ASCII and is handing over a
	// buffer it will never touch again. `StringBuilder.build` is the only caller, and both halves
	// matter to it: it watched every byte go in, so re-scanning them here (`from` does) would make
	// finishing a build O(n) for an answer already in hand — and it gives the buffer UP, which is
	// what makes taking it rather than copying it sound.
	//
	// Not exported: "take these bytes and trust me about them" is not a promise the stdlib can let
	// arbitrary code make.
	//
	// And the compiler holds us to it: E3008. It did not until the static-call path learned to
	// re-apply a function's own visibility — a type-qualified name skips the filter on purpose, so
	// that a hidden TYPE reports E4006 rather than a confusing not-exported about its method, and
	// only the instance path had been re-checking afterwards.
	static function fromOwnedBytes(bytes ByteArray, isAscii bool) returns String
		return String{managed: bytes.managed, isAsciiFlag: isAscii}
	end 'fromOwnedBytes'

	/// The UTF-8 bytes as a NEW, INDEPENDENT `ByteArray`. Writing to it never touches this string,
	/// and this string growing never touches it.
	///
	/// The independence is the CONTRACT; the copy-on-write view behind it is an optimisation and
	/// nothing more. Reads cost nothing and share the bytes; the first write detaches to a private
	/// buffer. So the source can be ANYTHING — a `.rodata` literal, a fused string, a slice — and
	/// the answer is the same, which is the point: there is one rule, not a rule per representation.
	/// (A literal could not share for writes even if we wanted it to: literals are interned, so one
	/// write through a shared literal would rewrite every other occurrence of it in the program.)
	///
	/// This comment used to read "zero-copy, shares backing memory", unqualified, and that stopped
	/// being true when the envelope collapse made construction a slice-VIEW — a slice copies on
	/// write. Nothing caught it because nothing pinned it. `specs/string-type-2` does now.
	export function toByteArray() returns ByteArray
		return ByteArray.init(managed)
	end 'toByteArray'

	/// The UTF-8 bytes as a `__ManagedMemory` an intrinsic can take: a real record, at a real address,
	/// that stays put for the duration of the call. Use it when the intrinsic's parameter is declared
	/// `__ManagedMemory`; when it is declared `cstring`, use `cstr()`.
	///
	/// `module`, not `export`, and deliberately so: this is meant to be the stdlib's own door to the
	/// bytes — open to `stdlib/` and its subdirectories, shut to everyone else. The marker is
	/// load-bearing already, and not decoration: `helpers/http` and `helpers/url` live in
	/// SUBDIRECTORIES of `stdlib/` and reach this, which file-private visibility would refuse.
	///
	/// This is ENFORCED. It was not, when this method was first written: `StdlibLoader` used to
	/// force-export EVERY stdlib function after the stdlib's own compile, so no stdlib function
	/// could be internal whatever it declared, and this door was de-facto public — the raw-write
	/// hole rebuilt under a new name. Removing that force-export cost exactly TEN `export` keywords
	/// across the whole stdlib — `Iterable.map`/`filter`/`contains`, `Stdin.readLine`, and six
	/// `JsonDoc` accessors — all genuine public API that had been riding it rather than declaring
	/// itself. Nothing else in the stdlib wanted to be public. No single gate saw them all: the C#
	/// suite found three, `build shv2` found one, the MCP server found six.
	///
	module function addressableBytes() returns ByteMemory
		return managed
	end 'addressableBytes'

	/// Return a NUL-terminated `cstring` view of the UTF-8 bytes. Use this when
	/// passing the string to a `__Builtins.*` runtime intrinsic whose parameter
	/// is declared `cstring` (the runtime sizes the buffer via `strlen`).
	///
	/// The conversion checks `buffer[length] == 0` and copies if not, so the
	/// returned pointer is always safely NUL-terminated even when the underlying
	/// `__ManagedMemory` happens to be packed tight against its allocated
	/// capacity (where `strlen` would otherwise walk past the end into adjacent
	/// heap).
	export function cstr() returns cstring
		return managed.toCString()
	end 'cstr'

	/// An independent `String` holding this one's bytes: writing to either never shows through the
	/// other. The copy-on-write view behind it is an optimisation — see `toByteArray`, which makes
	/// the same promise the same way.
	///
	/// ALSO THE ANSWER TO "return self, unchanged". Nine places used to spell out
	/// `String{managed: managed, isAsciiFlag: isAsciiFlag}` for that — `replace` with no match,
	/// `split` on an empty delimiter, each `trim` of an empty string — and every one of them was
	/// this method, written out. They call it now.
	///
	/// It cannot be `return self`, and that is not a subtlety to optimise away later: `self` is the
	/// same record, so the caller's `append` would mutate the original. That was the Stage 0 bug —
	/// `let b = a.toLower()` lowercased `a`.
	///
	/// This used to slice first (`String{managed: managed.slice(0, len), ...}`), which built the view
	/// TWICE — a slice record, then a String viewing the slice — for one COW view of the same bytes.
	/// Constructing straight from `managed` is the same thing in one allocation.
	export function clone() returns String
		return String{managed: managed, isAsciiFlag: isAsciiFlag}
	end 'clone'

	/// THE byte-access primitives, and the only way anything inside `String` is allowed to read a
	/// byte. `hash`, `equals`, `startsWith`, `endsWith`, `find`, `replace`, `split` and `scanIsAscii`
	/// all walk bytes through these and through nothing else — as do the grapheme scans in
	/// `helpers/string/`, which take the `String` for exactly this reason.
	///
	/// WHY, AND IT IS NOT TIDINESS: Stage 4b-2 makes a SMALL `String` a 16-byte VALUE carrying up to
	/// 15 bytes INLINE — and nothing can index a register. These are the seam where that is
	/// absorbed: their lowering becomes discriminant-aware (inline bytes vs. heap buffer), and every
	/// byte-walker above them keeps working without being touched. That is the whole point of routing
	/// through them now, while `String` is still unchanged.
	///
	/// ⚠ REACHING THE BYTES ANY OTHER WAY FROM INSIDE `String` WILL ALLOCATE UNDER 4b-2. `managed`,
	/// and `addressableBytes()` handed to a byte loop, both need a real `__ManagedMemory` record at a
	/// real address — which a small string will not have, so one would be MATERIALIZED per call. That
	/// is precisely the cost Stage 4 exists to remove: route `hash` that way and a
	/// `Map with (String, V)` allocates once per key lookup, and the stage is a net loss.
	/// `addressableBytes()` is for genuine intrinsic boundaries only — see its doc.
	///
	/// ⚠ ALL THREE ARE INLINED BY THE COMPILER AND NEVER CALLED. The bootstrap has no inliner, so a
	/// forwarding method here would be a real call PER BYTE — measured at +58% on a byte-walk
	/// workload, with mm-trace byte-identical, so no allocation gate could see it. The bodies below
	/// stay as the NORMATIVE definition of what the compiler emits for them (2-Parser.cs,
	/// TryEmitBuiltinStringMethod), and are what any future compiler must reproduce.
	export function byteLength() returns ByteCount
		return managed.length()
	end 'byteLength'

	/// Throws rather than panicking so the bounds contract stays the CALLER's to state: every caller
	/// has already established `index < byteLength()` and says so with `otherwise panic`.
	///
	/// `__ManagedMemoryError` because that is what this ACTUALLY RAISES. The bootstrap inlines this
	/// method to the `managed.byteAt` it forwards to (2-Parser.cs, TryEmitBuiltinStringMethod), so
	/// declaring a `StringError` here would be a signature the emitted code does not honour — and
	/// translating the error would mean a second copy of the bounds-check-and-load lowering, which
	/// is the duplication this project's rules exist to prevent. 4b-2 rewrites that lowering; the
	/// error type is its to revisit, honestly, then.
	module function byteAt(index BytePos) returns Byte throws __ManagedMemoryError
		return try managed.byteAt(index)
	end 'byteAt'

	/// `byteAt` for a caller that has ALREADY bounds-checked and has no meaningful answer to an
	/// out-of-range index — which is every byte-walker in the stdlib outside this file.
	///
	/// This existed THREE times before this rung — `fpByteAt` in `FilePath`, `urlByteAt` in `URL`,
	/// `safeByteAt` in `helpers/url` — each an identical `try managed.byteAt(i) otherwise panic`.
	/// Three copies of a wrapper is the tell that the wrapper belonged next to the thing it wraps.
	///
	/// It exists rather than `try s.byteAt(i) otherwise panic(...)` at each site because those sites
	/// read bytes inside NESTED CONDITIONS (`if s.byteAtOrPanic(pos) == 46`), and a `try` cannot go
	/// there. Unlike `byteAt` this is a real CALL, so a loop that CAN phrase its bounds inline should
	/// use `byteAt` directly — String's own helpers do.
	module function byteAtOrPanic(index BytePos) returns Byte
		return try byteAt(index) otherwise panic("String.byteAtOrPanic: index out of bounds — caller guarantees index < byteLength()")
	end 'byteAtOrPanic'

	/// The third byte primitive, and the only one whose result is an OBJECT: a `Character` owning a
	/// private copy of the `len` bytes at `pos`. Every Character the language derives from a string
	/// comes through here — `charAt`, the three `trim`s, and every step of `for c in s`.
	///
	/// Inlined like `byteAt`, and for both of its reasons: `String.maxon` may not reach `managed` to
	/// build a Character (4b-2 leaves a small String with no record to reach), and a forwarding
	/// method would put a real call on the per-grapheme path.
	///
	/// It COPIES the bytes. It replaced `makeCharacterFromManagedRange`, which sliced a VIEW —
	/// `Character.init(source.slice(pos, pos + len))` — and a view cannot point into a register, so
	/// the view could not survive 4b-2 whatever it was spelled. The copy is not the price of the
	/// move, it is a discount: the view was TWO records (the slice, then the Character viewing it)
	/// plus an incref, and it PINNED the entire source string alive behind one grapheme. This is one
	/// allocation that owns its bytes and references nothing.
	///
	/// Callers must guarantee `pos + len <= byteLength()`; the lowering's bounds check panics.
	module function makeCharFromBytes(pos BytePos, len ByteCount) returns Character
		return managed.makeCharFromBytes(pos, len)
	end 'makeCharFromBytes'

	/// The one byte primitive that WRITES, and the only mutation `String` performs on itself besides
	/// `append`. `mapAsciiCase` is the only caller: it takes a private copy of the bytes and maps it.
	///
	/// Writing through a string that is SHARING its bytes is safe — copy-on-write detaches the buffer
	/// on the first write, so a literal, a slice, or a buffer another String is viewing is never
	/// written through. That is what makes `toLower()` on a `let` sound.
	///
	/// Inlined for the same reason as the others, and it is the reason `toLower` can keep its SSO:
	/// under 4b-2 this writes a small string's INLINE bytes in place, so `sliceBytes` + `setByte`
	/// maps a short string with no record and no allocation at all. Reaching a mutable buffer via
	/// `addressableBytes()` instead would materialize one per call.
	module function setByte(index BytePos, value Byte) throws __ManagedMemoryError
		try managed.setByte(index, value)
	end 'setByte'

	/// A new `String` over the bytes in [start, end) of this one — THE way this type derives a string
	/// from part of itself. `slice`, `split`, `trim`/`trimStart`/`trimEnd` and `mapAsciiCase` all come
	/// through here.
	///
	/// `isAscii` is the CALLER's to state, because the caller always knows and re-deriving it would
	/// cost O(n) for an answer already in hand: any slice of an ASCII string is ASCII, and an empty
	/// slice is ASCII whatever the source was. (`String.from` pays that scan; `fromOwnedBytes` exists
	/// precisely to let a caller who knows skip it.)
	///
	/// THE ONLY `managed.slice` LEFT INSIDE `String`, and deliberately so: FOURTEEN sites used to
	/// spell this out, which meant fourteen separate reach-throughs for Stage 4b-2 to teach the
	/// discriminant. Now there is one. Under 4b-2 a range of 15 bytes or fewer becomes a SMALL String
	/// with those bytes copied inline and no reference to `self` at all — which is exactly why
	/// "always build large" was refused: `split` and `trim` are how strings get short.
	function sliceBytes(start BytePos, endPos BytePos, isAscii bool) returns String
		let result = try managed.slice(start, endPos) otherwise panic("String.sliceBytes: caller guarantees 0 <= start <= end <= byteLength()")
		return String{managed: result, isAsciiFlag: isAscii}
	end 'sliceBytes'

	export function isEmpty() returns bool
		return byteLength() == 0
	end 'isEmpty'

	/// Get grapheme cluster count (number of user-perceived characters).
	/// Cost is O(n) in the byte length for non-ASCII strings; callers that
	/// need the count repeatedly should cache it themselves.
	export function count() returns GraphemeCount
		return countGraphemes(self)
	end 'count'

	export function hash() returns HashValue
		return hashString(self)
	end 'hash'

	export function equals(other String) returns bool
		let len = byteLength()
		if len != other.byteLength() 'lenMismatch'
			return false
		end 'lenMismatch'
		return bytesEqual(self, aOffset: 0, b: other, bOffset: 0, len: len)
	end 'equals'

	/// Create a fresh iterator for grapheme cluster traversal.
	/// Throws IterationError.exhausted if the string is empty.
	export function createIterator() returns StringIterator throws IterationError
		return try StringIterator.create(self, isAsciiFlag: isAsciiFlag)
	end 'createIterator'

	// String index methods
	export function startIndex() returns StringIndex
		return StringIndex.create(0, bytePos: 0)
	end 'startIndex'

	export function endIndex() returns StringIndex
		let charCount = count()
		return StringIndex.create(charCount, bytePos: byteLength())
	end 'endIndex'

	/// Get character at the given index. Returns the grapheme cluster at that position.
	export function charAt(idx StringIndex) returns Character
		if isAsciiFlag 'asciiPath'
			return makeCharFromBytes(idx.bytePos(), len: 1)
		end 'asciiPath'
		// Calculate the byte length of this grapheme at the given byte position
		let byteStart = idx.bytePos()
		let endPos = findGraphemeEnd(self, startPos: byteStart)
		return makeCharFromBytes(byteStart, len: endPos - byteStart)
	end 'charAt'

	/// Get the index after the given position (for iteration)
	export function indexAfter(idx StringIndex) returns StringIndex throws StringError
		let len = byteLength()
		if idx.bytePos() >= len 'atEnd'
			throw StringError.invalidIndex
		end 'atEnd'
		if isAsciiFlag 'asciiPath'
			return StringIndex.create(idx.charIndex() + 1, bytePos: idx.bytePos() + 1)
		end 'asciiPath'
		let byteStart = idx.bytePos()
		let endPos = findGraphemeEnd(self, startPos: byteStart)
		let byteLen = endPos - byteStart
		return StringIndex.create(idx.charIndex() + 1, bytePos: byteStart + byteLen)
	end 'indexAfter'

	/// Get the index before the given position (for reverse iteration).
	/// Mirror of indexAfter: stepping backward from `idx` to the previous
	/// grapheme boundary. Throws when called on `startIndex()` since there
	/// is no prior grapheme.
	export function indexBefore(idx StringIndex) returns StringIndex throws StringError
		if idx.bytePos() == 0 'atStart'
			throw StringError.invalidIndex
		end 'atStart'
		if isAsciiFlag 'asciiPath'
			return StringIndex.create(idx.charIndex() - 1, bytePos: idx.bytePos() - 1)
		end 'asciiPath'
		let graphemeStart = findGraphemeStart(self, beforePos: idx.bytePos())
		return StringIndex.create(idx.charIndex() - 1, bytePos: graphemeStart)
	end 'indexBefore'

	/// Append another string's content to this string in place.
	///
	/// `other.managed`, NOT `other.addressableBytes()`, and this is not an oversight to tidy up.
	/// A bulk `append` copies the bytes with a memcpy, so it needs a real record whichever spelling
	/// is used — `addressableBytes()` buys no encapsulation here (same type, its own field) and is
	/// not free: it is a CALL RETURNING A MANAGED VALUE, so the returned-value ownership convention
	/// makes the caller retain it. Routing this one line through it added an `mm_incref`/`mm_decref`
	/// pair around the RECEIVER at every `String.append` call site in user code — visible as a moved
	/// golden in `specs/fragments-x64-windows/static-variables/`. A field read costs nothing.
	export function append(other String)
		managed.append(other.managed)
		if not other.isAsciiFlag 'clearAscii'
			isAsciiFlag = false
		end 'clearAscii'
	end 'append'

	// Search methods
	export function startsWith(prefix String) returns bool
		let prefixLen = prefix.byteLength()
		if prefixLen > byteLength() 'tooLong'
			return false
		end 'tooLong'
		return bytesEqual(self, aOffset: 0, b: prefix, bOffset: 0, len: prefixLen)
	end 'startsWith'

	export function endsWith(suffix String) returns bool
		let suffixLen = suffix.byteLength()
		let len = byteLength()
		if suffixLen > len 'tooLong'
			return false
		end 'tooLong'
		return bytesEqual(self, aOffset: len - suffixLen, b: suffix, bOffset: 0, len: suffixLen)
	end 'endsWith'

	export function contains(needle String) returns bool
		if try findIn(self, offset: 0, len: byteLength(), needle: needle) 'found'
			return true
		end 'found'
		return false
	end 'contains'

	export function contains(character Character) returns bool
		let charStr = character.toString()
		if try findIn(self, offset: 0, len: byteLength(), needle: charStr) 'found'
			return true
		end 'found'
		return false
	end 'contains'

	export function findFirst(needle String) returns StringIndex throws StringError
		let byteIdx = try findIn(self, offset: 0, len: byteLength(), needle: needle)
		if isAsciiFlag 'asciiPath'
			return StringIndex.create(byteIdx, bytePos: byteIdx)
		end 'asciiPath'
		let charIdx = byteIndexToGraphemeIndex(self, byteIdx: byteIdx)
		return StringIndex.create(charIdx, bytePos: byteIdx)
	end 'findFirst'

	export function findLast(needle String) returns StringIndex throws StringError
		let byteIdx = try findLastIn(self, needle: needle)
		if isAsciiFlag 'asciiPath'
			return StringIndex.create(byteIdx, bytePos: byteIdx)
		end 'asciiPath'
		let charIdx = byteIndexToGraphemeIndex(self, byteIdx: byteIdx)
		return StringIndex.create(charIdx, bytePos: byteIdx)
	end 'findLast'

	// Slicing - returns a new String backed by slice into this string's buffer
	// Use endIndex for end position, or length for character count
	export function slice(start StringIndex, endIndex StringIndex) returns String
		return sliceBytes(start.bytePos(), endPos: endIndex.bytePos(), isAscii: isAsciiFlag)
	end 'slice'

	export function slice(start StringIndex, length GraphemeCount) returns String
		if isAsciiFlag 'asciiPath'
			// Every ASCII grapheme is one byte, so the grapheme count IS the byte count.
			return sliceBytes(start.bytePos(), endPos: start.bytePos() + length, isAscii: true)
		end 'asciiPath'
		let endBytePos = graphemeOffsetToBytePos(self, startBytePos: start.bytePos(), count: length)
		return sliceBytes(start.bytePos(), endPos: endBytePos, isAscii: isAsciiFlag)
	end 'slice'

	// View methods - returns lazy Iterable views over bytes/codepoints/UTF-16
	// code units. View construction is cheap; iterating an empty view yields zero elements.
	export function bytes() returns ByteView
		return ByteView.create(self)
	end 'bytes'

	export function codepoints() returns CodepointView
		return CodepointView.create(self)
	end 'codepoints'

	export function utf16() returns UTF16View
		return UTF16View.create(self)
	end 'utf16'

	// Replace methods
	export function replace(old String, with String) returns String
		let oldLen = old.byteLength()
		if oldLen == 0 'empty_old'
			return clone()
		end 'empty_old'

		let selfLen = byteLength()

		// First pass: count matches
		var matchCount = 0
		var searchPos = 0
		while searchPos <= selfLen - oldLen 'count_loop'
			if let idx = try findIn(self, offset: searchPos, len: selfLen - searchPos, needle: old) 'try_count'
				matchCount = matchCount + 1
				searchPos = searchPos + idx + oldLen
			end 'try_count' else 'done_count'
				break
			end 'done_count'
		end 'count_loop'

		if matchCount == 0 'no_matches'
			return clone()
		end 'no_matches'

		// Build the result in ONE allocation. The first pass counted the matches, so the final size is
		// already known exactly — every match trades `oldLen` bytes for `with`'s — and a builder that is
		// told the answer never grows at all. (Appending the pieces to a `String` instead would copy the
		// whole result back and forth once per match: `String.append` is exact, by design. See
		// `StringBuilder`.)
		let withLen = with.byteLength()
		var out = StringBuilder.create()
		out.reserve(selfLen + matchCount * withLen - matchCount * oldLen)

		// ONE of the few places inside `String` that genuinely needs a real `__ManagedMemory`, and the
		// reason is `StringBuilder`: it takes each piece by BULK MEMCPY, which needs the bytes at an
		// address. `byteAt` cannot serve that — copying a piece a byte at a time would trade the memcpy
		// this type exists to get for a per-byte loop, on the strings `replace` is actually used on.
		//
		// So it materializes, and under 4b-2 a SMALL receiver will allocate a record here. Hoisted out
		// of the loop deliberately: that makes it once per `replace` CALL rather than once per match,
		// and a `replace` already allocates a builder and its buffer, so one more is noise beside them.
		let selfBytes = addressableBytes()

		var pos = 0
		while pos <= selfLen - oldLen 'search'
			if let idx = try findIn(self, offset: pos, len: selfLen - pos, needle: old) 'try_find'
				let matchPos = pos + idx
				if matchPos > pos 'has_prefix'
					let prefixSlice = try selfBytes.slice(pos, matchPos) otherwise 'prefixSliceErr'
						panic("String.replace: prefix slice — pos and matchPos within bounds from findIn")
					end 'prefixSliceErr'
					out.appendBytes(prefixSlice, isAscii: isAsciiFlag)
				end 'has_prefix'
				out.append(with)
				pos = matchPos + oldLen
			end 'try_find' else 'no_more'
				break
			end 'no_more'
		end 'search'

		// Append remaining suffix
		if pos < selfLen 'has_suffix'
			let suffixSlice = try selfBytes.slice(pos, selfLen) otherwise 'suffixSliceErr'
				panic("String.replace: suffix slice — pos < selfLen guaranteed")
			end 'suffixSliceErr'
			out.appendBytes(suffixSlice, isAscii: isAsciiFlag)
		end 'has_suffix'

		return out.build()
	end 'replace'

	export function replaceFirst(old String, with String) returns String
		let oldLen = old.byteLength()
		if oldLen == 0 'empty_old'
			return clone()
		end 'empty_old'

		let selfLen = byteLength()
		let idx = try findIn(self, offset: 0, len: selfLen, needle: old) otherwise 'no_match'
			return clone()
		end 'no_match'

		// `replace`'s three-piece build, with the counting pass it does not need: there is exactly one
		// match, so the final size is known outright — the match trades `oldLen` bytes for `with`'s —
		// and a builder that is told the answer allocates once and never grows. Growing the head slice
		// by two exact appends instead (what this used to do) reallocated and recopied the whole
		// result twice.
		let withLen = with.byteLength()
		var out = StringBuilder.create()
		out.reserve(selfLen - oldLen + withLen)

		// A real record, for `replace`'s reason — see the comment there.
		let selfBytes = addressableBytes()

		let head = try selfBytes.slice(0, idx) otherwise 'rfHeadSliceErr'
			panic("String.replaceFirst: head slice — idx from findIn, always in bounds")
		end 'rfHeadSliceErr'
		out.appendBytes(head, isAscii: isAsciiFlag)

		out.append(with)

		let tail = try selfBytes.slice(idx + oldLen, selfLen) otherwise 'rfTailSliceErr'
			panic("String.replaceFirst: tail slice — idx+oldLen <= selfLen guaranteed")
		end 'rfTailSliceErr'
		out.appendBytes(tail, isAscii: isAsciiFlag)

		return out.build()
	end 'replaceFirst'

	// Split method
	typealias StringArray = Array with String

	export function split(delimiter String) returns StringArray
		var result = StringArray.create()
		let delimLen = delimiter.byteLength()

		// Empty delimiter: return single-element array with original string
		if delimLen == 0 'empty_delim'
			result.push(clone())
			return result
		end 'empty_delim'

		let selfLen = byteLength()
		var pos = 0

		while pos <= selfLen - delimLen 'search'
			if let idx = try findIn(self, offset: pos, len: selfLen - pos, needle: delimiter) 'try_find'
				let matchPos = pos + idx
				result.push(sliceBytes(pos, endPos: matchPos, isAscii: isAsciiFlag))
				pos = matchPos + delimLen
			end 'try_find' else 'no_more'
				break
			end 'no_more'
		end 'search'

		// Append remaining suffix (always — even if empty, to handle trailing delimiters)
		result.push(sliceBytes(pos, endPos: selfLen, isAscii: isAsciiFlag))

		return result
	end 'split'

	// Case conversion. Both return a NEW String and leave the receiver UNCHANGED — the transform
	// runs on an independent copy of the bytes. `sliceBytes` hands back a String whose buffer is
	// either already private (an owned source is copied eagerly) or shares the source's bytes until
	// the first `setByte`, at which point COW detaches it — so a literal, a slice, or a buffer some
	// other String is aliasing is never written through. Returning `managed` after mutating it, as
	// this used to, made `let b = a.toLower()` silently lowercase `a` as well.
	//
	// `work` is a String and is mapped through `byteAt`/`setByte`, NOT a `__ManagedMemory` reached
	// through `addressableBytes()`. That is what keeps SSO: under 4b-2 a short `toLower()` is a small
	// String whose inline bytes are written in place — no record, no allocation. Materializing a
	// mutable buffer instead would allocate on every `toLower` of a short string, and short derived
	// strings are precisely what SSO exists for.
	function mapAsciiCase(lo Byte, hi Byte, delta AsciiCaseDelta) returns String
		let len = byteLength()
		if len == 0 'empty'
			return clone()
		end 'empty'

		var work = sliceBytes(0, endPos: len, isAscii: isAsciiFlag)

		for i in 0 upto len 'convert'
			let b = try work.byteAt(i) otherwise panic("String.mapAsciiCase: byteAt OOB — i < len invariant")
			if b >= lo and b <= hi 'inRange'
				try work.setByte(i, b + delta) otherwise panic("String.mapAsciiCase: setByte OOB — i < len invariant")
			end 'inRange'
		end 'convert'
		return work
	end 'mapAsciiCase'

	// ASCII uppercase A-Z (65-90) -> lowercase a-z (97-122)
	export function toLower() returns String
		return mapAsciiCase(65, hi: 90, delta: 32)
	end 'toLower'

	// ASCII lowercase a-z (97-122) -> uppercase A-Z (65-90)
	export function toUpper() returns String
		return mapAsciiCase(97, hi: 122, delta: -32)
	end 'toUpper'

	/// Trim characters in the given set from both ends of the string.
	export function trim(chars CharacterSet) returns String
		let len = byteLength()
		if len == 0 'empty'
			return clone()
		end 'empty'

		if isAsciiFlag 'asciiPath'
			// Forward scan: each ASCII byte is one grapheme
			var start = 0
			while start < len 'scanStartAscii'
				let ch = makeCharFromBytes(start, len: 1)
				if not chars.contains(ch) 'foundStartAscii'
					break
				end 'foundStartAscii'
				start = start + 1
			end 'scanStartAscii'

			if start >= len 'allMatchAscii'
				return sliceBytes(0, endPos: 0, isAscii: true)
			end 'allMatchAscii'

			// Backward scan
			var endPos = byteLength()
			while endPos > start 'scanEndAscii'
				endPos = endPos - 1
				let ch = makeCharFromBytes(endPos, len: 1)
				if not chars.contains(ch) 'foundEndAscii'
					endPos = endPos + 1
					break
				end 'foundEndAscii'
			end 'scanEndAscii'

			return sliceBytes(start, endPos: endPos, isAscii: true)
		end 'asciiPath'

		// Forward scan: find first non-matching grapheme
		var start = 0
		while start < len 'scan_start'
			let endByte = findGraphemeEnd(self, startPos: start)
			let graphemeLen = endByte - start
			let ch = makeCharFromBytes(start, len: graphemeLen)
			if not chars.contains(ch) 'found_start'
				break
			end 'found_start'
			start = endByte
		end 'scan_start'

		if start >= len 'all_match'
			return sliceBytes(0, endPos: 0, isAscii: true)
		end 'all_match'

		// Backward scan from end: find last non-matching grapheme
		var endPos = byteLength()
		while endPos > start 'scan_end'
			let graphemeStart = findGraphemeStart(self, beforePos: endPos)
			let graphemeLen = endPos - graphemeStart
			let ch = makeCharFromBytes(graphemeStart, len: graphemeLen)
			if not chars.contains(ch) 'found_end'
				break
			end 'found_end'
			endPos = graphemeStart
		end 'scan_end'

		return sliceBytes(start, endPos: endPos, isAscii: isAsciiFlag)
	end 'trim'

	/// Trim characters in the given set from the start of the string.
	export function trimStart(chars CharacterSet) returns String
		let len = byteLength()
		if len == 0 'empty'
			return clone()
		end 'empty'

		if isAsciiFlag 'asciiPath'
			var start = 0
			while start < len 'scanStartAscii'
				let ch = makeCharFromBytes(start, len: 1)
				if not chars.contains(ch) 'foundStartAscii'
					break
				end 'foundStartAscii'
				start = start + 1
			end 'scanStartAscii'

			if start >= len 'allMatchAscii'
				return sliceBytes(0, endPos: 0, isAscii: true)
			end 'allMatchAscii'

			return sliceBytes(start, endPos: len, isAscii: true)
		end 'asciiPath'

		var start = 0
		while start < len 'scan_start'
			let endByte = findGraphemeEnd(self, startPos: start)
			let graphemeLen = endByte - start
			let ch = makeCharFromBytes(start, len: graphemeLen)
			if not chars.contains(ch) 'found_start'
				break
			end 'found_start'
			start = endByte
		end 'scan_start'

		if start >= len 'all_match'
			return sliceBytes(0, endPos: 0, isAscii: true)
		end 'all_match'

		return sliceBytes(start, endPos: len, isAscii: isAsciiFlag)
	end 'trimStart'

	/// Trim characters in the given set from the end of the string.
	export function trimEnd(chars CharacterSet) returns String
		let len = byteLength()
		if len == 0 'empty'
			return clone()
		end 'empty'

		if isAsciiFlag 'asciiPath'
			var pos = byteLength()
			while pos > 0 'scanAscii'
				pos = pos - 1
				let ch = makeCharFromBytes(pos, len: 1)
				if not chars.contains(ch) 'notMatch'
					return sliceBytes(0, endPos: pos + 1, isAscii: true)
				end 'notMatch'
			end 'scanAscii'
			return sliceBytes(0, endPos: 0, isAscii: true)
		end 'asciiPath'

		// Backward scan from end: find first non-matching grapheme
		var pos = byteLength()
		while pos > 0 'scan'
			let graphemeStart = findGraphemeStart(self, beforePos: pos)
			let graphemeLen = pos - graphemeStart
			let ch = makeCharFromBytes(graphemeStart, len: graphemeLen)
			if not chars.contains(ch) 'not_match'
				break
			end 'not_match'
			pos = graphemeStart
		end 'scan'

		if pos == 0 'all_match'
			return sliceBytes(0, endPos: 0, isAscii: true)
		end 'all_match'

		return sliceBytes(0, endPos: pos, isAscii: isAsciiFlag)
	end 'trimEnd'

	/// Trim Unicode whitespace from both ends.
	export function trim() returns String
		return trim(CharacterSet.whitespacesAndNewlines())
	end 'trim'

	/// Trim Unicode whitespace from the start.
	export function trimStart() returns String
		return trimStart(CharacterSet.whitespacesAndNewlines())
	end 'trimStart'

	/// Trim Unicode whitespace from the end.
	export function trimEnd() returns String
		return trimEnd(CharacterSet.whitespacesAndNewlines())
	end 'trimEnd'
end 'String'

/// Builds a `String` piece by piece — which a `String` itself deliberately cannot do cheaply.
/// @category Text
///
/// WHY THIS TYPE EXISTS, AND WHY `String.append` IS NOT ALLOWED TO BE CLEVER INSTEAD.
///
/// A `String` OWNS EXACTLY THE BYTES IT HOLDS. `append` allocates a new buffer of exactly the
/// required size, copies into it, and frees the old one — no growth factor, no slack, not one byte
/// more than the string is. Every string in a program pays for that decision, and almost every
/// string in a program is built once and then only read, so it is the right one: a growth policy
/// would leave every one of them carrying capacity nobody will ever use.
///
/// The price is that appending in a LOOP is Θ(n²) — each append copies everything already there.
/// That is not a defect to be papered over by giving every string slack it does not need; it is
/// what this type is for. Build here, where the buffer grows GEOMETRICALLY (`Array`'s policy — see
/// `grownCapacity` in stdlib/Array.maxon: double while small, ease toward 1.25× once big), so the
/// whole build is amortized O(1) per byte, and hand the finished bytes to a `String` at the end.
///
/// It is Go's split, for Go's reason: an immutable `string` whose `+` copies, and a
/// `strings.Builder` that grows. The two costs are paid by different code — a program HOLDS many
/// strings and BUILDS few.
export type StringBuilder
	var bytes as ByteArray
	// Tracked as the pieces arrive rather than re-scanned at the end: the builder already sees every
	// byte that goes in. An empty builder is trivially ASCII, and one non-ASCII piece settles it.
	var isAsciiFlag as bool

	export static function create() returns StringBuilder
		return StringBuilder{bytes: ByteArray.create(), isAsciiFlag: true}
	end 'create'

	/// Reserve room for `byteCount` bytes up front — for the one case a growth policy cannot beat:
	/// when the caller ALREADY KNOWS the final size.
	///
	/// Growing geometrically costs log₂(N) reallocations and leaves slack behind. A caller who knows
	/// the answer can have ONE allocation of exactly the right size, with no re-copies and nothing
	/// wasted, which is strictly better than any growth policy can be. (It is what the compiler
	/// already does for an interpolated string: it measures every part, then allocates once.)
	export function reserve(byteCount ByteCount)
		bytes.reserve(byteCount)
	end 'reserve'

	export function append(other String)
		appendBytes(other.addressableBytes(), isAscii: other.isAscii())
	end 'append'

	/// Append a raw UTF-8 byte range whose ASCII-ness the caller ALREADY KNOWS — a slice cut out of a
	/// string that has already been classified, which is what `String.replace` spends its whole life
	/// doing. Routing those through `append(String)` would wrap each piece in a `String`, and a
	/// `String` built from raw bytes RE-SCANS them to decide `isAscii` — paying O(n) for an answer the
	/// caller is holding.
	///
	/// The bytes are COPIED in. The range may point into a buffer this builder is about to reallocate
	/// (`replace` slices the very string it is rebuilding), so borrowing it would be a use-after-free
	/// waiting for the next growth.
	function appendBytes(piece ByteBuffer, isAscii bool)
		bytes.appendMemory(piece)

		if not isAscii 'clearAscii'
			isAsciiFlag = false
		end 'clearAscii'
	end 'appendBytes'

	export function byteLength() returns ByteCount
		return bytes.count()
	end 'byteLength'

	export function isEmpty() returns bool
		return bytes.count() == 0
	end 'isEmpty'

	/// Throw away what has been built, KEEPING the capacity — so a builder reused across many strings
	/// pays for its growth once instead of once per string.
	export function clear()
		bytes.clear()
		isAsciiFlag = true
	end 'clear'

	/// The `String` that was built. The builder is EMPTY afterwards, and that is not an accident.
	///
	/// It HANDS THE BUFFER OVER instead of copying it — the finished string IS the bytes the builder
	/// accumulated, so a build costs no final O(n) copy and no second allocation. That is only sound
	/// because the builder gives them up: a non-consuming `toString()` would leave a `String` and a
	/// `StringBuilder` sharing one buffer that the builder's very next `append` may REALLOCATE out
	/// from under it, and the string would be reading freed memory. So there is exactly one way to
	/// finish, and it cannot alias.
	export function build() returns String
		let built = String.fromOwnedBytes(self.bytes, isAscii: self.isAsciiFlag)
		self.bytes = ByteArray.create()
		self.isAsciiFlag = true
		return built
	end 'build'
end 'StringBuilder'

/// Iterator for String — traverses Unicode grapheme clusters.
/// Positioning invariant: iterPos always points at the start of a valid grapheme,
/// and graphemeLen holds that grapheme's byte length. current() returns it without
/// recomputing boundaries; advance() moves past it.
///
/// IT HOLDS THE `String`, NOT ITS BYTES, and that is what Stage 4b-1b came here for. This field
/// used to be `var managed as ByteMemory` — a record reference that ESCAPES THE FRAME, since the
/// iterator outlives the `createIterator()` that built it. Under 4b-2 a small String is a 16-byte
/// VALUE with no record to store, and the caller-frame spill that lets `byteAt` reach a register's
/// bytes cannot help: there is no frame here to spill into that outlives the iterator. A `String`
/// field is the value itself — 16 bytes, copied in, nothing allocated, nothing to keep alive.
///
/// The fear that stopped an earlier attempt was that this would move materialization from create()
/// (once) to current() (per character), which would have been worse than leaving it alone. It does
/// not, and the reason is that both of the things current() needs are now INLINE primitives:
/// `makeCharFromBytes` copies the grapheme's bytes straight out of whichever representation the
/// String has, and `byteLength` is a field load. Neither reaches for a record, so there is nothing
/// to materialize on either path. Measured, not assumed — `for c in s` was timed across this change.
export type StringIterator implements Iterator with Character
	var s as String
	var iterPos as BytePos
	var graphemeLen as ByteCount
	var isAsciiFlag as bool

	export static function create(s String, isAsciiFlag bool) returns Self throws IterationError
		if s.byteLength() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		let len = computeGraphemeLen(s, pos: 0, isAsciiFlag: isAsciiFlag)
		return Self{s: s, iterPos: 0, graphemeLen: len, isAsciiFlag: isAsciiFlag}
	end 'create'

	export function current() returns Character
		return s.makeCharFromBytes(iterPos, len: graphemeLen)
	end 'current'

	export function advance() throws IterationError
		let nextPos = iterPos + graphemeLen
		if nextPos >= s.byteLength() 'done'
			throw IterationError.exhausted
		end 'done'
		iterPos = nextPos
		graphemeLen = computeGraphemeLen(s, pos: iterPos, isAsciiFlag: isAsciiFlag)
	end 'advance'
end 'StringIterator'

function computeGraphemeLen(s String, pos BytePos, isAsciiFlag bool) returns ByteCount
	if isAsciiFlag 'ascii'
		return 1
	end 'ascii'
	return findGraphemeEnd(s, startPos: pos) - pos
end 'computeGraphemeLen'

// StringIndex type - type-safe string position
export type StringIndex implements Equatable, Comparable
	var charIdx as GraphemeIndex
	var bytePosition as BytePos

	export static function create(charIndex GraphemeIndex, bytePos BytePos) returns StringIndex
		return StringIndex{charIdx: charIndex, bytePosition: bytePos}
	end 'create'

	export function charIndex() returns GraphemeIndex
		return charIdx
	end 'charIndex'

	export function bytePos() returns BytePos
		return bytePosition
	end 'bytePos'

	export function equals(other StringIndex) returns bool
		return charIdx == other.charIdx
	end 'equals'

	export function compare(other StringIndex) returns Ordering
		if charIdx < other.charIdx 'less'
			return Ordering.lessThan
		end 'less'
		if charIdx > other.charIdx 'greater'
			return Ordering.greaterThan
		end 'greater'
		return Ordering.equalTo
	end 'compare'
end 'StringIndex'

/// THE byte-range comparison. `equals`, `startsWith`, `endsWith` and both searches are all one
/// question — "are these `len` bytes the same?" — asked at different offsets, and each used to carry
/// its own copy of this loop. Four copies, plus a fifth that had rotted: `helpers/string/hash.maxon`
/// exported an `equalsManagedString` with this exact body and NOBODY had called it since `equals`
/// grew its own inline duplicate.
///
/// The `otherwise panic` is the point of the rewrite, not decoration. Every copy of this loop used
/// to answer an out-of-range byte with a bare `break`, which fell out of the loop and returned
/// TRUE — an OOB read would have reported a MATCH. The length checks above every caller made it
/// unreachable, so it was a silent wrong answer waiting for the first caller that got them wrong.
function bytesEqual(a String, aOffset BytePos, b String, bOffset BytePos, len ByteCount) returns bool
	for i in 0 upto len 'compare_loop'
		let ab = try a.byteAt(aOffset + i) otherwise panic("bytesEqual: byteAt OOB — caller guarantees aOffset + len <= a.byteLength()")
		let bb = try b.byteAt(bOffset + i) otherwise panic("bytesEqual: byteAt OOB — caller guarantees bOffset + len <= b.byteLength()")
		if ab != bb 'byte_check'
			return false
		end 'byte_check'
	end 'compare_loop'
	return true
end 'bytesEqual'

/// Search a WINDOW of `haystack` — `offset` and `len` are load-bearing here and only here:
/// `replace`, `replaceFirst` and `split` walk a string by re-searching the tail after each match.
/// (`startsWith`, `endsWith` and `findLastIn` only ever wanted the whole string, and each used to
/// pass `offset: 0, len: length()` at every call site to say so.)
///
/// The FIRST-BYTE CHECK before `bytesEqual` is not a micro-optimisation, it is what pays for the
/// shared compare loop. `bytesEqual` is a real CALL — the bootstrap has no inliner — and nearly
/// every candidate position mismatches on byte 0, so calling it per position spends a call to
/// compare one byte. Measured: without this check, a 576K-position miss ran ~4% slower than the
/// old code, which had the compare loop written out inline here (one of the five copies this
/// rung removed). With it, the dedup costs nothing and the search is faster than what it replaced.
function findIn(haystack String, offset BytePos, len ByteCount, needle String) returns BytePos throws StringError
	let needleLen = needle.byteLength()

	if needleLen == 0 'empty_needle'
		return 0
	end 'empty_needle'

	if needleLen > len 'too_long'
		throw StringError.notFound
	end 'too_long'

	let firstNeedleByte = try needle.byteAt(0) otherwise panic("findIn: byteAt(0) OOB — needleLen > 0 checked above")
	for i in 0 to (len - needleLen) 'search_loop'
		let candidate = try haystack.byteAt(offset + i) otherwise panic("findIn: byteAt OOB — i <= len - needleLen invariant")
		if candidate == firstNeedleByte 'firstByteMatch'
			if bytesEqual(haystack, aOffset: offset + i, b: needle, bOffset: 0, len: needleLen) 'found_check'
				return i
			end 'found_check'
		end 'firstByteMatch'
	end 'search_loop'
	throw StringError.notFound
end 'findIn'

function findLastIn(haystack String, needle String) returns BytePos throws StringError
	let len = haystack.byteLength()
	let needleLen = needle.byteLength()

	if needleLen == 0 'empty_needle'
		return len
	end 'empty_needle'

	if needleLen > len 'too_long'
		throw StringError.notFound
	end 'too_long'

	let firstNeedleByte = try needle.byteAt(0) otherwise panic("findLastIn: byteAt(0) OOB — needleLen > 0 checked above")
	var i = len - needleLen
	while i >= 0 'search_loop'
		let candidate = try haystack.byteAt(i) otherwise panic("findLastIn: byteAt OOB — i <= len - needleLen invariant")
		if candidate == firstNeedleByte 'firstByteMatch'
			if bytesEqual(haystack, aOffset: i, b: needle, bOffset: 0, len: needleLen) 'found_check'
				return i
			end 'found_check'
		end 'firstByteMatch'

		i = i - 1
	end 'search_loop'
	throw StringError.notFound
end 'findLastIn'

/// Takes the raw bytes, and MUST: this runs while a `String` is being CONSTRUCTED from them
/// (`init`, `from`), so `isAsciiFlag` has no value yet and there is no `String` to ask. Its callers
/// are already holding a real `__ManagedMemory` — the one they are building the string out of — so
/// there is nothing to materialize here under 4b-2 and nothing to route through `byteAt`. This is a
/// construction boundary, in the same family as `addressableBytes()`'s intrinsic callers.
function scanIsAscii(managed __ManagedMemory) returns bool
	let len = managed.length()
	for i in 0 upto len 'scan'
		let b = try managed.byteAt(i) otherwise panic("scanIsAscii: byteAt OOB — i < len invariant")
		if b >= 128 'nonAscii'
			return false
		end 'nonAscii'
	end 'scan'
	return true
end 'scanIsAscii'
