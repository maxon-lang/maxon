/// Unit-testing support. A `test` declaration throws this implicitly, so an
/// assertion that fails inside a test body propagates like any other error.
/// @category Testing
/// The error a failing assertion raises. A `test` declaration is implicitly
/// `throws TestFailure`, so an assertion in a test body needs no `try` and its
/// failure fails the test. Anywhere else it needs `try`, and a forgotten one is
/// a compile error rather than an assertion whose failure nothing observes.
public enum TestFailure implements Error
	assertion
end 'TestFailure'

// ─── __TestReport ───────────────────────────────────────────────────────────────
// The reporting surface a test binary speaks to its runner through, and the only
// thing in this file the COMPILER writes calls to. Kept in its own section because
// nothing here is written by a test author: `TestFailure` above and the assertions
// beside it are an author's vocabulary, this is machinery.
//
// Every byte the runner MATCHES ON arrives here as an argument. The compiler passes
// the wire format at every call it emits, so the protocol is written down exactly
// once -- in the code that both emits those calls and parses what the test binary
// printed. A marker spelled here as well would be that protocol written down twice,
// and the two would drift the first time either side moved.

public type __TestReport
	/// An error reached the end of a `test` body without being handled. The compiler
	/// emits this call; no program writes it.
	///
	/// `errorType` is the callee's declared `throws` type. `errorCase` is the thrown
	/// value rendered by the language's own interpolation rule -- the live case name
	/// for a union and for a plain enum, the raw value for an enum that declared one --
	/// so a report never spells an error differently from the program that printed it.
	/// `file` and `line` locate the operation that threw, not this function.
	public static function threw(wrapper String, separator String, errorType String, errorCase String, file String, line SourceLineNumber)
		printError("{wrapper}{errorType}{separator}{errorCase}{separator}{file}{separator}{line}{wrapper}\n")
	end 'threw'
end '__TestReport'

/// Raised by `TestScratch` in a process `maxon test` did not start.
public enum TestScratchError implements Error
	unavailable
end 'TestScratchError'

/// The two scratch directories `maxon test` makes for each test process, empty when the process starts.
/// The runner removes them when the process ends, and a process that passes but leaves an entry in
/// either fails, naming the entry.
public type TestScratch
	public static let outsideCheckoutVariable = "MAXON_TEST_SCRATCH"
	public static let insideProjectVariable = "MAXON_TEST_PROJECT_SCRATCH"

	/// A directory in the system temp area, outside every checkout and project.
	public static function outsideCheckout() returns FilePath throws TestScratchError
		return try TestScratch.namedBy(TestScratch.outsideCheckoutVariable)
	end 'outsideCheckout'

	/// A directory under the project's `.maxon/test/`, for what must sit inside the tree, such as a
	/// compiler copy that finds `stdlib/` by walking up from itself. A `.maxproj` staged here is refused
	/// (E2074, a project inside a project); stage a project in `outsideCheckout()`.
	public static function insideProject() returns FilePath throws TestScratchError
		return try TestScratch.namedBy(TestScratch.insideProjectVariable)
	end 'insideProject'

	static function namedBy(variable String) returns FilePath throws TestScratchError
		let spelled = try Process.environmentVariable(variable) otherwise throw TestScratchError.unavailable

		if spelled.isEmpty() 'namesNowhere'
			throw TestScratchError.unavailable
		end 'namesNowhere'

		return try FilePath.from(spelled) otherwise throw TestScratchError.unavailable
	end 'namedBy'
end 'TestScratch'

public typealias CownTortureSize = int(1 to u32.max)

public typealias CownTortureViolations = int(0 to u64.max)

public type CownTorture
	/// Stress-tests the multi-cown acquire: `workers` green threads each run `rounds` rounds, and a
	/// round draws a service or a pair of services from `cownCount` (a draw may repeat one) and either
	/// sends the first a message or acquires the pair and holds it across a yield. One worker stops a
	/// service half way through. Answers how many times a held service was entered again, plus one when
	/// the per-service entry counts do not add up to the messages delivered and the services acquired,
	/// plus one for every acquire of the stopped service that did not answer stopped; 0 means mutual
	/// exclusion and the stopped answer held. `cownCount` must be a power of two, and any other value
	/// aborts the process. It waits for the green threads it starts.
	public static function violations(cownCount CownTortureSize, workers CownTortureSize, rounds CownTortureSize) returns CownTortureViolations
		return __Builtins.cownTestMulti(cownCount, workers, rounds) as CownTortureViolations
	end 'violations'
end 'CownTorture'

// ─── Expect ─────────────────────────────────────────────────────────────────────
// The assertion vocabulary a test AUTHOR writes, as opposed to the machinery above,
// which only the compiler and the runner ever touch.

public typealias AssertedReal = float(f64.min to f64.max)

// The half-width of the window `close` accepts. Non-negative because a negative tolerance accepts
// nothing at all, which makes it a typo rather than a strict comparison; the range turns that typo
// into a compile error at the call site instead of a test that can never pass.
public typealias Tolerance = float(0.0 to f64.max)

/// The assertion library a `test` body calls.
///
/// Every matcher throws `TestFailure.assertion` when it does not hold, so a test stops at its
/// first bad assertion, and prints its report to stderr at the assertion site just before
/// throwing. The report has to be printed rather than carried on the error: a caught error in
/// Maxon is an enum you `match`, with no message and no payload that could hold two values of
/// arbitrary type. The assertion site is the one place both values are still in hand and still
/// fully typed, so it is the only place `expected: 4` / `received: 5` can be produced at all.
///
/// `file` and `line` default to `__file__` / `__line__`, which expand at the CALL SITE, so a
/// report names the test author's line and never a line in this file.
public type Expect
	// --- Report vocabulary ---------------------------------------------------------------------
	// Every string that reaches the printed report is declared here. Two reasons, and both bite:
	// the format is then readable in one place rather than reconstructed from twenty call sites,
	// and no matcher can end up spelling its own name two ways.

	static let failureMarker = "FAIL"

	// The type's own name, restated. Maxon has no reflection, so a report that says which library
	// produced it has to carry the name as data; this is the single place it is written.
	static let libraryName = "Expect"

	static let detailIndent = "  "
	static let expectedLabel = "expected"
	static let receivedLabel = "received"
	static let messageLabel = "message"
	static let withinLabel = "within"

	// Bool renderings, shared by isTrue and isFalse with the roles swapped. Spelled to match what
	// interpolating a `bool` produces, so `equal` over two `bool`s and these agree.
	static let trueRendering = "true"
	static let falseRendering = "false"
	static let emptyRendering = "\"\""

	static let equalName = "equal"
	static let notEqualName = "notEqual"
	static let greaterThanName = "greaterThan"
	static let lessThanName = "lessThan"
	static let atLeastName = "atLeast"
	static let atMostName = "atMost"
	static let closeName = "close"
	static let isTrueName = "isTrue"
	static let isFalseName = "isFalse"
	static let containsName = "contains"
	static let startsWithName = "startsWith"
	static let endsWithName = "endsWith"
	static let isEmptyName = "isEmpty"
	static let failName = "fail"

	static let negatedPrefix = "not "
	static let greaterPrefix = "> "
	static let lessPrefix = "< "
	static let atLeastPrefix = ">= "
	static let atMostPrefix = "<= "
	static let containsPrefix = "contains "
	static let startsWithPrefix = "starts with "
	static let endsWithPrefix = "ends with "

	// --- Shared failure path -------------------------------------------------------------------

	// The tail every failure funnels through: a header naming the caller's location and the
	// matcher, the matcher's own detail, an optional note, then the throw.
	static function raise(matcher String, detail String, note String, file String, line SourceLineNumber) throws TestFailure
		var block = "{Expect.failureMarker} {file}:{line}: {Expect.libraryName}.{matcher}\n"
		block.append(detail)

		if note.count() > 0 'hasNote'
			block.append("{Expect.detailIndent}{Expect.messageLabel}: {note}\n")
		end 'hasNote'

		// Assembled first and written once: a report is several lines, and one write keeps them
		// together rather than letting anything else writing to stderr land between them.
		printError(block)

		throw TestFailure.assertion
	end 'raise'

	// The two-line body every comparison matcher reports. This is the part that would otherwise be
	// respelled at every matcher, so it takes the two values already rendered and builds the block
	// `raise` prints verbatim.
	static function raiseMismatch(matcher String, expected String, received String, note String, file String, line SourceLineNumber) throws TestFailure
		var detail = "{Expect.detailIndent}{Expect.expectedLabel}: {expected}\n"
		detail.append("{Expect.detailIndent}{Expect.receivedLabel}: {received}\n")

		try Expect.raise(matcher, detail: detail, note: note, file: file, line: line)
	end 'raiseMismatch'

	// The matchers render values with `:q`, so an empty `String`, or one differing from the expectation
	// only in trailing space, is still visible in the report.
	public static function equal(actual T, expected T, message String = "", file String = __file__, line SourceLineNumber = __line__) uses T throws TestFailure where T is Equatable
		if actual != expected 'mismatch'
			try Expect.raiseMismatch(Expect.equalName, expected: "{expected:q}", received: "{actual:q}", note: message, file: file, line: line)
		end 'mismatch'
	end 'equal'

	public static function notEqual(actual T, expected T, message String = "", file String = __file__, line SourceLineNumber = __line__) uses T throws TestFailure where T is Equatable
		if actual == expected 'matched'
			try Expect.raiseMismatch(Expect.notEqualName, expected: "{Expect.negatedPrefix}{expected:q}", received: "{actual:q}", note: message, file: file, line: line)
		end 'matched'
	end 'notEqual'

	// ⚠ The ordering matchers and `close` fail unless the assertion HOLDS, never when its negation
	// does: NaN satisfies no comparison, so the negated form would pass a float that is not a number.
	public static function greaterThan(actual T, than T, message String = "", file String = __file__, line SourceLineNumber = __line__) uses T throws TestFailure where T is Comparable
		if not (actual > than) 'notGreater'
			try Expect.raiseMismatch(Expect.greaterThanName, expected: "{Expect.greaterPrefix}{than:q}", received: "{actual:q}", note: message, file: file, line: line)
		end 'notGreater'
	end 'greaterThan'

	public static function lessThan(actual T, than T, message String = "", file String = __file__, line SourceLineNumber = __line__) uses T throws TestFailure where T is Comparable
		if not (actual < than) 'notLess'
			try Expect.raiseMismatch(Expect.lessThanName, expected: "{Expect.lessPrefix}{than:q}", received: "{actual:q}", note: message, file: file, line: line)
		end 'notLess'
	end 'lessThan'

	public static function atLeast(actual T, than T, message String = "", file String = __file__, line SourceLineNumber = __line__) uses T throws TestFailure where T is Comparable
		if not (actual >= than) 'below'
			try Expect.raiseMismatch(Expect.atLeastName, expected: "{Expect.atLeastPrefix}{than:q}", received: "{actual:q}", note: message, file: file, line: line)
		end 'below'
	end 'atLeast'

	public static function atMost(actual T, than T, message String = "", file String = __file__, line SourceLineNumber = __line__) uses T throws TestFailure where T is Comparable
		if not (actual <= than) 'above'
			try Expect.raiseMismatch(Expect.atMostName, expected: "{Expect.atMostPrefix}{than:q}", received: "{actual:q}", note: message, file: file, line: line)
		end 'above'
	end 'atMost'

	// Float-only rather than generic, so a non-float argument is refused at the test's own call.
	public static function close(actual AssertedReal, expected AssertedReal, within Tolerance, message String = "", file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		if not (abs(actual - expected) <= (within as AssertedReal)) 'apart'
			try Expect.raiseMismatch(Expect.closeName, expected: "{expected} ({Expect.withinLabel} {within})", received: "{actual}", note: message, file: file, line: line)
		end 'apart'
	end 'close'

	// --- Bool ----------------------------------------------------------------------------------
	// isTrue is also the escape hatch for any type the roster does not name: `==` supplies the
	// predicate and `message` carries the rendering, so
	// `isTrue(a == b, message: "expected {b}, got {a}")` works for any Equatable + Stringable type.

	public static function isTrue(actual bool, message String = "", file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		if not actual 'notTrue'
			try Expect.raiseMismatch(Expect.isTrueName, expected: Expect.trueRendering, received: Expect.falseRendering, note: message, file: file, line: line)
		end 'notTrue'
	end 'isTrue'

	public static function isFalse(actual bool, message String = "", file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		if actual 'notFalse'
			try Expect.raiseMismatch(Expect.isFalseName, expected: Expect.falseRendering, received: Expect.trueRendering, note: message, file: file, line: line)
		end 'notFalse'
	end 'isFalse'

	// --- String --------------------------------------------------------------------------------

	public static function contains(haystack String, needle String, message String = "", file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		if not haystack.contains(needle) 'absent'
			try Expect.raiseMismatch(Expect.containsName, expected: "{Expect.containsPrefix}{needle:q}", received: "{haystack:q}", note: message, file: file, line: line)
		end 'absent'
	end 'contains'

	public static function startsWith(haystack String, needle String, message String = "", file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		if not haystack.startsWith(needle) 'absent'
			try Expect.raiseMismatch(Expect.startsWithName, expected: "{Expect.startsWithPrefix}{needle:q}", received: "{haystack:q}", note: message, file: file, line: line)
		end 'absent'
	end 'startsWith'

	public static function endsWith(haystack String, needle String, message String = "", file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		if not haystack.endsWith(needle) 'absent'
			try Expect.raiseMismatch(Expect.endsWithName, expected: "{Expect.endsWithPrefix}{needle:q}", received: "{haystack:q}", note: message, file: file, line: line)
		end 'absent'
	end 'endsWith'

	public static function isEmpty(haystack String, message String = "", file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		if not haystack.isEmpty() 'notEmpty'
			try Expect.raiseMismatch(Expect.isEmptyName, expected: Expect.emptyRendering, received: "{haystack:q}", note: message, file: file, line: line)
		end 'notEmpty'
	end 'isEmpty'

	// --- fail ----------------------------------------------------------------------------------

	// The escape hatch, for a branch the author believes unreachable. It has no pair of values to
	// compare, so it goes straight to `raise` with an empty detail and reports the message alone —
	// which is also why the message is required here and optional everywhere else.
	public static function fail(message String, file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		try Expect.raise(Expect.failName, detail: "", note: message, file: file, line: line)
	end 'fail'
end 'Expect'
