#if not os(Wasi)
	public typealias SampleCycles = int(0 to u64.max)
	public typealias SampledThreadId = int(0 to u64.max)
	public typealias SampleIntervalNanos = int(1 to u64.max)
	public typealias StackWindowOffset = int(0 to i64.max)

	public enum SamplerError implements Error
		noSuchProcess
		noScratch
		unknownThread
		outOfWindow
		moduleListUnavailable
		signalTrampolineUnavailable
		callingThread
		accessDenied
		threadNotPinned
	end 'SamplerError'

	let SampleProcessScratchBytes = 8192
	let SampleWindowBytes = 65536
	let ProfileSampleThreadGone = 0 - 1
	let ProfileSampleNoRegisters = 0 - 2
	let ProfileSampleCallingThread = 0 - 3

	#if os(Windows) and arch(x64)
		typealias UnitShift = int(0 to 48)

		let SampleContextSlot = 0 as ScratchOffset
		let SampleRegionSlot = 2048 as ScratchOffset
		let SampleModuleEntrySlot = 4096

		let SampleContextRspOffset = 0x98
		let SampleContextRbpOffset = 0xA0
		let SampleContextRipOffset = 0xF8
		let SampleContextRspSlot = (SampleContextSlot + SampleContextRspOffset) as ScratchOffset
		let SampleContextRbpSlot = (SampleContextSlot + SampleContextRbpOffset) as ScratchOffset
		let SampleContextRipSlot = (SampleContextSlot + SampleContextRipOffset) as ScratchOffset

		let ProfileRegionRecordBytes = 48
		let ProfileRegionAllocationBaseOffset = 8
		let ProfileRegionSuspendedCyclesOffset = ProfileRegionRecordBytes

		let SampleRegionAllocationBaseSlot = (SampleRegionSlot + ProfileRegionAllocationBaseOffset) as ScratchOffset
		let SampleRegionSuspendedCyclesSlot = (SampleRegionSlot + ProfileRegionSuspendedCyclesOffset) as ScratchOffset

		let ProfileSavedFrameCodeBaseOffset = 64
		let ProfileSavedFrameCodeBytesOffset = 72
		let ProfileSavedFrameSlotBaseOffset = 80
		let ProfileSavedFrameRecordFieldOffset = 88
		let ProfileSavedFrameCopyOffset = 96
		let ProfileSavedFramePcWord = 0
		let ProfileSavedFrameSpWord = 8
		let ProfileSavedFrameFpWord = 16
		let ProfileSavedFrameWindowBytesOffset = 120
		let ProfileSavedFrameFixedRecordOffset = 240
		let ProfileSavedFrameWindowAddressOffset = 256
		let NoSavedFrame = 0
		let SampleWindowPagesBytes = SampleWindowBytes * 2

		let SampleSavedFrameCodeBaseSlot = (SampleRegionSlot + ProfileSavedFrameCodeBaseOffset) as ScratchOffset
		let SampleSavedFrameCodeBytesSlot = (SampleRegionSlot + ProfileSavedFrameCodeBytesOffset) as ScratchOffset
		let SampleSavedFrameSlotBaseSlot = (SampleRegionSlot + ProfileSavedFrameSlotBaseOffset) as ScratchOffset
		let SampleSavedFrameRecordFieldSlot = (SampleRegionSlot + ProfileSavedFrameRecordFieldOffset) as ScratchOffset
		let SampleSavedFramePcSlot = (SampleRegionSlot + ProfileSavedFrameCopyOffset + ProfileSavedFramePcWord) as ScratchOffset
		let SampleSavedFrameSpSlot = (SampleRegionSlot + ProfileSavedFrameCopyOffset + ProfileSavedFrameSpWord) as ScratchOffset
		let SampleSavedFrameFpSlot = (SampleRegionSlot + ProfileSavedFrameCopyOffset + ProfileSavedFrameFpWord) as ScratchOffset
		let SampleSavedFrameWindowBytesSlot = (SampleRegionSlot + ProfileSavedFrameWindowBytesOffset) as ScratchOffset
		let SampleSavedFrameFixedRecordSlot = (SampleRegionSlot + ProfileSavedFrameFixedRecordOffset) as ScratchOffset
		let SampleSavedFrameWindowAddressSlot = (SampleRegionSlot + ProfileSavedFrameWindowAddressOffset) as ScratchOffset

		let ModuleEntryBytes = 1080
		let ModuleEntrySizeSlot = 4096
		let ModuleEntryBaseSlot = (4096 + 24) as ScratchOffset
		let ModuleEntryExtentSlot = (4096 + 32) as ScratchOffset
		let ModuleEntryNameOffset = 48

		let SampleProcessInformationSlot = 6144
		let SamplePebSlot = 6400
		let ProcessBasicInformationClass = 0
		let ProcessBasicInformationBytes = 48
		let ProcessPebAddressOffset = 8
		let PebPrefixBytes = 0x58
		let PebLoaderOffset = 0x18
		let PebCrossProcessFlagsOffset = 0x50
		let ProcessInitializingFlag = 0x2
		let NtStatusSuccess = 0
		let ReadProcessMemoryFailed = 0
		let PebLoaderAbsent = 0
		let ProcessPebAddressSlot = (SampleProcessInformationSlot + ProcessPebAddressOffset) as ScratchOffset
		let PebLoaderSlot = (SamplePebSlot + PebLoaderOffset) as ScratchOffset
		let PebCrossProcessFlagsSlot = (SamplePebSlot + PebCrossProcessFlagsOffset) as ScratchOffset

		let ModuleListDeadlineNanos = 1500000000
		let ModuleListRetryMs = 5
		let InvalidHandle = 0 - 1
		let CurrentThreadPseudoHandle = 0 - 2

		let Utf16UnitMask = 0xFFFF
		let Utf16UnitBits = 16
		let Utf16UnitsPerWord = 4
		let AsciiCeiling = 128
		let NonAsciiPlaceholder = 0x3F

		let NanosPerFileTimeTick = 100
		let ModuleHasNoFileType = 0
	#endif

	#if os(Macos)
		typealias MachUlebShift = int(0 to 63)

		let MachSuccess = 0
		let MachPortBytes = 4
		let MachPortBits = 32
		let MachPortsPerWord = 2
		let MachHighHalfShift = 32
		let MachLowHalfMask = 0xFFFFFFFF
		let MachThreadBasicInfo = 3
		let MachThreadBasicInfoWords = 10
		let MachThreadIdentifierInfo = 4
		let MachThreadIdentifierInfoWords = 6
		let MachTaskDyldInfo = 17
		let MachTaskDyldInfoWords = 5
		let ModuleListDeadlineNanos = 200000000
		let ModuleListRetryMs = 5

		let MachStateFramePointerOffset = 232
		let MachStateStackPointerOffset = 248
		let MachStateLinkRegisterOffset = 240
		let MachStateProgramCounterOffset = 256

		// The trampoline's entry reaches `__prof_mach_sample` in the state record's trailing word because
		// `__Builtins.profileMachSample` keeps its arity: the pinned seed refuses a tree that changes it.
		// `MachNoTrampoline` is that word for "none", and no 4-byte-aligned pc can equal it.
		let MachStateTrampolineOffset = 272
		let MachNoTrampoline = 0 - 1

		let MachPortSlot = 0
		let MachArraySlot = 8
		let MachArrayCountSlot = 16
		let MachCountSlot = 24
		let MachReadSizeSlot = 32
		let MachDyldInfoSlot = 64
		let MachInfoSlot = 256
		let MachStateSlot = 512
		let MachStateFramePointerSlot = (MachStateSlot + MachStateFramePointerOffset) as ScratchOffset
		let MachStateStackPointerSlot = (MachStateSlot + MachStateStackPointerOffset) as ScratchOffset
		let MachStateLinkRegisterSlot = (MachStateSlot + MachStateLinkRegisterOffset) as ScratchOffset
		let MachStateProgramCounterSlot = (MachStateSlot + MachStateProgramCounterOffset) as ScratchOffset
		let MachStateTrampolineSlot = (MachStateSlot + MachStateTrampolineOffset) as ScratchOffset

		let MachNanosPerSecond = 1000000000
		let MachNanosPerMicro = 1000
		let MachInfoSecondSlot = (MachInfoSlot + 8) as ScratchOffset
		let MachInfoStateSlot = (MachInfoSlot + 24) as ScratchOffset
		let MachStateRunning = 1

		let MachHeaderCommandsWord = 16
		let MachHeaderFileTypeWord = 8
		let MachHeaderBytes = 32
		let MachLoadCommandSegment64 = 0x19
		let MachLoadCommandSymbolTable = 0x2
		let MachLoadCommandFunctionStarts = 0x26
		let MachFunctionStartsLocationOffset = 8
		let MachUlebPayloadMask = 0x7F
		let MachUlebContinuation = 0x80
		let MachUlebPayloadBits = 7
		let MachUlebMaxShift = 56
		let MachSegmentNameOffset = 8
		let MachSegmentSecondNameOffset = 16
		let MachSegmentAddressOffset = 24
		let MachSegmentSizeOffset = 32
		let MachSegmentFileOffsetOffset = 40
		let MachSymbolTableLocationOffset = 8
		let MachSymbolTableStringsOffset = 16
		let MachTextSegmentNameWord = 0x545845545F5F
		let MachLinkEditFirstNameWord = 0x44454B4E494C5F5F
		let MachLinkEditSecondNameWord = 0x5449
		let MachSignalLibraryName = "libsystem_platform.dylib"
		let MachSignalTrampolineSymbol = "__sigtramp"
		let MachSymbolEntryBytes = 16
		let MachSymbolsPerRead = 256
		let MachSymbolNameWindowOffset = MachSymbolsPerRead * MachSymbolEntryBytes
		let MachSymbolTypeShift = 32
		let MachSymbolTypeMask = 0xEE
		let MachSymbolInSection = 0x0E
		let MachSymbolValueOffset = 8
		let MachByteMask = 0xFF
		let MachLibSystemFlagsOffset = 24
		let MachLibSystemInitializedShift = 8
		let MachMaxCommandBytes = 16384
		let MachMaxModules = 1024
		let MachImageInfoBytes = 24
		let MachImageInfoHeaderBytes = 32
		let MachImageArrayOffset = 8
		let MachImagePathOffset = 8
		let MachPortWordBytes = 8
		let MacosMaxPathLength = 1024
		let MachPathChunkBytes = 64
		let MachPathSeparator = 47
	#endif

	#if os(Linux)
		let TraceStopBudgetMillis = 10000
		let TraceStopBudgetNanos = TraceStopBudgetMillis * SamplerNanosPerMilli
		let TraceStopSpinNanos = 100000
		let TraceStopPollMicros = 100
		let ProcSchedStatFile = "schedstat"
		let ProcFieldSeparator = " "

		let SeizedTableBytes = 32768
		let SeizedTableCountOffset = 8
		let SeizedTableThreadsOffset = 32
		let SeizedWordBytes = 8
		let SeizedTableCapacity = (SeizedTableBytes - SeizedTableThreadsOffset) / SeizedWordBytes

		module typealias SeizedCount = int(0 to u64.max)

		union SeizedSlot
			none
			at(index SeizedCount)
		end 'SeizedSlot'

		enum SeizeOutcome
			held
			gone
			uninterruptible
		end 'SeizeOutcome'

		enum TraceProbe
			traceable
			refused
			killed
		end 'TraceProbe'

		union CpuNanos
			read(nanos SampleCycles)
			unreadable
		end 'CpuNanos'

		// `owed` is the signal the stop was holding for delivery, and the detach hands it back: detaching
		// with `NoTraceSignal` from a signal-delivery-stop cancels it, and a cancelled preemption `SIGURG`
		// leaves that machine unpreempted for the rest of the run.
		union StopArrival
			lost
			held(owed DebuggeeSignal)

			function isHeld() returns bool
				return match self 'which'
					lost gives false
					held gives true
				end 'which'
			end 'isHeld'

			function owedSignal() returns DebuggeeSignal
				return match self 'which'
					lost gives NoTraceSignal
					held(owed) gives owed
				end 'which'
			end 'owedSignal'
		end 'StopArrival'
	#endif

	#if not os(Windows)
		let StackReadChunkBytes = 4096
		let SamplerNanosPerMicro = 1000
		let SamplerNanosPerMilli = 1000000
	#endif

	public type SampledThread
		public let id as SampledThreadId
		let handle as RegisterWord

		static function identified(handle RegisterWord, id SampledThreadId) returns SampledThread
			return Self{id: id, handle: handle}
		end 'identified'

		function rawHandle() returns RegisterWord
			return self.handle
		end 'rawHandle'
	end 'SampledThread'

	type OpenThread
		let id as SampledThreadId
		let raw as RegisterWord
		var handle as __ManagedHandle

		static function holding(raw RegisterWord, owning __ManagedHandle, id SampledThreadId) returns OpenThread
			return Self{id: id, raw: raw, handle: owning}
		end 'holding'

		function names(thread SampledThread) returns bool
			return self.raw == thread.rawHandle() and self.id == thread.id
		end 'names'

		function identity() returns SampledThreadId
			return self.id
		end 'identity'

		function release()
			self.handle.release()
		end 'release'
	end 'OpenThread'

	typealias OpenThreadArray = Array with OpenThread

	#if os(Linux)
		module type SeizedThreads
			var table as __ManagedHandle

			module static function open(process Pid, pin MachinePin) returns SeizedThreads
				return Self{table: __ManagedHandle.adopting(__Builtins.profileSeizedOpen(process as RegisterWord, pin.surrender() as RegisterWord))}
			end 'open'

			module function held() returns bool
				return self.table.handle() != 0
			end 'held'

			function base() returns RegisterWord
				if self.table.handle() == 0 'notHeld'
					panic("SeizedThreads: the table was asked of a set that is not held — a caller used it before opening it or after releasing it")
				end 'notHeld'

				return self.table.handle() as RegisterWord
			end 'base'

			function word(offset RegisterWord) returns RegisterWord
				return __Builtins.profileReadWord(self.base(), offset) as RegisterWord
			end 'word'

			function setWord(offset RegisterWord, value RegisterWord)
				__Builtins.profileWriteWord(self.base(), offset, value)
			end 'setWord'

			module function count() returns SeizedCount
				return self.word(SeizedTableCountOffset) as SeizedCount
			end 'count'

			function slotOf(index SeizedCount) returns RegisterWord
				return SeizedTableThreadsOffset + (index as RegisterWord) * SeizedWordBytes
			end 'slotOf'

			function indexOf(thread DebuggeeThreadId) returns SeizedSlot
				for index in 0 upto self.count() 'eachSeized'
					if self.word(self.slotOf(index)) == (thread as RegisterWord) 'thisOne'
						return SeizedSlot.at(index)
					end 'thisOne'
				end 'eachSeized'

				return SeizedSlot.none
			end 'indexOf'

			module function contains(thread DebuggeeThreadId) returns bool
				return match self.indexOf(thread) 'found'
					none gives false
					at gives true
				end 'found'
			end 'contains'

			module function add(thread DebuggeeThreadId)
				if self.contains(thread) 'alreadyHeld'
					return
				end 'alreadyHeld'

				let count = self.count()

				if count >= SeizedTableCapacity 'full'
					panic("SeizedThreads.add: {SeizedTableCapacity} threads are seized at once, and a thread seized past that could not be detached by this table's release")
				end 'full'

				self.setWord(self.slotOf(count), value: thread as RegisterWord)
				self.setWord(SeizedTableCountOffset, value: (count + 1) as RegisterWord)
			end 'add'

			module function remove(thread DebuggeeThreadId)
				match self.indexOf(thread) 'found'
					none then return
					at(index) then self.removeAt(index)
				end 'found'
			end 'remove'

			function removeAt(index SeizedCount)
				let last = self.count() - 1
				self.setWord(self.slotOf(index), value: self.word(self.slotOf(last)))
				self.setWord(SeizedTableCountOffset, value: last as RegisterWord)
			end 'removeAt'

			module function killProcessHolding(thread DebuggeeThreadId)
				self.remove(thread)
				__Builtins.profileSeizedKill(self.base(), thread as RegisterWord)
			end 'killProcessHolding'

			module function release()
				self.table.release()
			end 'release'
		end 'SeizedThreads'
	#endif

	public typealias SampledThreadArray = Array with SampledThread

	#if not os(Windows)
		type ThreadWatch
			module let id as SampledThreadId
			module var cycles as SampleCycles

			static function starting(id SampledThreadId, cycles SampleCycles) returns ThreadWatch
				return Self{id: id, cycles: cycles}
			end 'starting'
		end 'ThreadWatch'

		typealias ThreadWatchArray = Array with ThreadWatch

		union ThreadReading
			running
			idle(cpuNanos SampleCycles)
			unreadable

			function isRunning() returns bool
				return match self 'which'
					running gives true
					idle or
					unreadable gives false
				end 'which'
			end 'isRunning'
		end 'ThreadReading'

		enum StopKind
			nothing
			gone
			unreadable
			registers
			calling
		end 'StopKind'

		type PendingStop
			module let id as SampledThreadId
			module let kind as StopKind
			module let programCounter as RegisterWord
			module let framePointer as RegisterWord
			module let stackPointer as RegisterWord
			module let linkRegister as LinkRegister
			module let copied as RegisterWord
			module let cycles as SampleCycles

			static function none() returns PendingStop
				return Self{id: 0, kind: StopKind.nothing, programCounter: 0, framePointer: 0, stackPointer: 0, linkRegister: LinkRegister.absent, copied: 0, cycles: 0}
			end 'none'

			static function unreadable(id SampledThreadId, cycles SampleCycles) returns PendingStop
				return Self{id: id, kind: StopKind.unreadable, programCounter: 0, framePointer: 0, stackPointer: 0, linkRegister: LinkRegister.absent, copied: 0, cycles: cycles}
			end 'unreadable'

			static function lost(id SampledThreadId) returns PendingStop
				return Self{id: id, kind: StopKind.gone, programCounter: 0, framePointer: 0, stackPointer: 0, linkRegister: LinkRegister.absent, copied: 0, cycles: 0}
			end 'lost'

			static function of(id SampledThreadId, kind StopKind, programCounter RegisterWord, framePointer RegisterWord, stackPointer RegisterWord, linkRegister LinkRegister, copied RegisterWord, cycles SampleCycles) returns PendingStop
				return Self{id: id, kind: kind, programCounter: programCounter, framePointer: framePointer, stackPointer: stackPointer, linkRegister: linkRegister, copied: copied, cycles: cycles}
			end 'of'
		end 'PendingStop'
	#endif

	public type SampledModule
		public let base as RegisterWord
		public let limit as RegisterWord
		public let name as String
		public let fileType as RegisterWord

		static function spanning(base RegisterWord, limit RegisterWord, name String, fileType RegisterWord) returns SampledModule
			return Self{base: base, limit: limit, name: name, fileType: fileType}
		end 'spanning'
	end 'SampledModule'

	/// The stack bytes one `capture` copied. The window holds its own copy, so it stays readable after
	/// the process is closed and after later captures.
	public type StackWindow
		let block as RegisterBlock
		let copied as RegisterWord

		static function copyOf(pages ScratchPages, copied RegisterWord) returns StackWindow
			return Self{block: RegisterBlock.readFrom(pages, at: 0, length: copied as ScratchBytes), copied: copied}
		end 'copyOf'

		#if os(Windows) and arch(x64)
			static function copyOfRegion(pages ScratchPages, copied RegisterWord, from ScratchOffset) returns StackWindow
				return Self{block: RegisterBlock.readFrom(pages, at: from, length: copied as ScratchBytes), copied: copied}
			end 'copyOfRegion'
		#endif

		public function byteCount() returns RegisterWord
			return self.copied
		end 'byteCount'

		public function word(offset StackWindowOffset) returns RegisterWord throws SamplerError
			if (offset as RegisterWord) > self.copied - (sizeof(RegisterWord) as RegisterWord) 'outsideTheCopy'
				throw SamplerError.outOfWindow
			end 'outsideTheCopy'

			return try self.block.wordAtAnyOffset(offset as RegisterOffset) otherwise throw SamplerError.outOfWindow
		end 'word'
	end 'StackWindow'

	/// The base of the reservation a sampled stack lives in, unique to each live stack, where the host
	/// reports one (Windows); `unreported` elsewhere.
	public union StackReservation
		unreported
		base(address RegisterWord)
	end 'StackReservation'

	#if os(Windows) and arch(x64)
		public union SavedFrame
			absent
			saved(programCounter RegisterWord, framePointer RegisterWord, stackPointer RegisterWord, window StackWindow)
		end 'SavedFrame'

		public union SavedFrameLocation
			untracked
			recordedAt(codeBase RegisterWord, codeBytes RegisterWord, slotBase RegisterWord, recordField RegisterWord)
			fixedAt(codeBase RegisterWord, codeBytes RegisterWord, record RegisterWord)
		end 'SavedFrameLocation'
	#endif

	public type SampledStack
		public let programCounter as RegisterWord
		public let framePointer as RegisterWord
		public let stackPointer as RegisterWord
		public let linkRegister as LinkRegister
		public let reservation as StackReservation
		public let suspendedCycles as RegisterWord
		public let window as StackWindow

		#if os(Windows) and arch(x64)
			public let savedFrame as SavedFrame

			static function of(programCounter RegisterWord, framePointer RegisterWord, stackPointer RegisterWord, linkRegister LinkRegister, reservation StackReservation, suspendedCycles RegisterWord, window StackWindow, savedFrame SavedFrame) returns SampledStack
				return Self{programCounter: programCounter, framePointer: framePointer, stackPointer: stackPointer, linkRegister: linkRegister, reservation: reservation, suspendedCycles: suspendedCycles, window: window, savedFrame: savedFrame}
			end 'of'
		#else
			static function of(programCounter RegisterWord, framePointer RegisterWord, stackPointer RegisterWord, linkRegister LinkRegister, reservation StackReservation, suspendedCycles RegisterWord, window StackWindow) returns SampledStack
				return Self{programCounter: programCounter, framePointer: framePointer, stackPointer: stackPointer, linkRegister: linkRegister, reservation: reservation, suspendedCycles: suspendedCycles, window: window}
			end 'of'
		#endif
	end 'SampledStack'

	/// A sampled thread's link register: `holds` on macOS, `absent` on Windows and Linux.
	public union LinkRegister
		absent
		holds(address RegisterWord)

		public function isWithin(code SignalTrampoline) returns bool
			return match self 'which'
				absent gives false
				holds(address) gives code.contains(address)
			end 'which'
		end 'isWithin'
	end 'LinkRegister'

	/// The code a thread runs while a signal is delivered to it: `spanning` once located, `unplaced`
	/// when it cannot be located, and `absent` where there is none to find yet or the host has none.
	public union SignalTrampoline
		absent
		unplaced
		spanning(start RegisterWord, limit RegisterWord)

		public function contains(address RegisterWord) returns bool
			return match self 'which'
				absent or
				unplaced gives false
				spanning(start, limit) gives address >= start and address < limit
			end 'which'
		end 'contains'

		public function placed() returns SignalTrampoline throws SamplerError
			match self 'which'
				absent or
				spanning then return self
				unplaced then throw SamplerError.signalTrampolineUnavailable
			end 'which'
		end 'placed'

		#if os(Macos)
			function entryAddress() returns RegisterWord
				return match self 'which'
					absent gives MachNoTrampoline
					unplaced panic("SignalTrampoline.entryAddress: a stop places the trampoline before it asks for its entry, and an unplaced one throws there")
					spanning(start, _) gives start
				end 'which'
			end 'entryAddress'
		#endif
	end 'SignalTrampoline'

	#if os(Macos)
		union TrampolineLocation
			notYet
			located(code SignalTrampoline)
		end 'TrampolineLocation'

		union DyldImageList
			stillLoading
			listed(count RegisterWord, array RegisterWord)
		end 'DyldImageList'

		union MachCommandWanted
			ofKind(kind RegisterWord)
			segment(firstName RegisterWord, secondName RegisterWord)
		end 'MachCommandWanted'
	#endif

	public union SampleCapture
		threadGone
		unreadable(reservation StackReservation, suspendedCycles RegisterWord)
		captured(stack SampledStack)
	end 'SampleCapture'

	union SampledThreadSlot
		none
		at(index ElementIndex)
	end 'SampledThreadSlot'

	/// Samples the threads of another process. `close()` releases the handles and scratch regions it holds;
	/// on Linux it also detaches every thread it stopped and unpins the green thread that opened it, so it is
	/// called on that green thread.
	public type SampledProcess
		#if not os(Linux)
			var process as __ManagedHandle
		#endif

		let pid as RegisterWord
		var scratch as ScratchPages
		var window as ScratchPages
		var openThreads as OpenThreadArray

		#if os(Windows) and arch(x64)
			var savedFrames = SavedFrameLocation.untracked
		#endif

		#if not os(Windows)
			var watches as ThreadWatchArray
			var pending as PendingStop
		#endif

		#if os(Macos)
			var trampoline as TrampolineLocation
		#endif

		#if os(Linux)
			var trace as ProcessTrace
			var seized as SeizedThreads
		#endif

		/// True where `cycles` and `suspendedCycles` are CPU nanoseconds (macOS, Linux); false on Windows,
		/// where they are the thread's cycle counter.
		public static function cyclesAreNanoseconds() returns bool
			#if os(Windows)
				return false
			#else
				return true
			#endif
		end 'cyclesAreNanoseconds'

		/// True where a frame-pointer walk may continue through code outside the sampled program (macOS,
		/// Linux); false on Windows, where such code need not keep the chain.
		public static function foreignCodeKeepsTheFrameChain() returns bool
			#if os(Windows)
				return false
			#else
				return true
			#endif
		end 'foreignCodeKeepsTheFrameChain'

		#if os(Windows) and arch(x64)
			public function trackSavedFrames(location SavedFrameLocation)
				self.savedFrames = location
			end 'trackSavedFrames'
		#endif

		/// libsystem_platform's `_sigtramp` on macOS, kept once located; `absent` until libSystem has
		/// initialised, and always on Windows and Linux.
		public function signalTrampoline() returns SignalTrampoline
			#if os(Macos)
				match self.trampoline 'which'
					located(code) then return code
					notYet then return self.placedTrampoline()
				end 'which'
			#else
				return SignalTrampoline.absent
			#endif
		end 'signalTrampoline'

		public static function open(pid Pid) returns SampledProcess throws SamplerError
			#if os(Windows) and arch(x64)
				let process = __ManagedHandle.adopting(__Builtins.profileOpenTarget(pid))

				if process.handle() == 0 'noSuchProcess'
					throw SamplerError.noSuchProcess
				end 'noSuchProcess'

				let sampled = Self{process: process, pid: pid as RegisterWord, scratch: ScratchPages.reserve(SampleProcessScratchBytes), window: ScratchPages.reserve(SampleWindowPagesBytes as ScratchBytes), openThreads: OpenThreadArray.create(0)}

				if not sampled.scratch.held() or not sampled.window.held() 'noPages'
					sampled.close()

					throw SamplerError.noScratch
				end 'noPages'

				return sampled
			#endif

			#if os(Macos)
				let scratch = ScratchPages.reserve(SampleProcessScratchBytes)
				let window = ScratchPages.reserve(SampleWindowBytes as ScratchBytes)

				if not scratch.held() or not window.held() 'noPages'
					scratch.release()
					window.release()

					throw SamplerError.noScratch
				end 'noPages'

				scratch.setWord(MachPortSlot, value: 0)
				let status = __Builtins.profileMachTaskForPid(__Builtins.profileMachSelfTask(), pid, scratch.addressOf(MachPortSlot))
				let port = scratch.word(MachPortSlot) and MachLowHalfMask

				if status != MachSuccess or port == 0 'refused'
					scratch.release()
					window.release()

					if not Process.isAlive(pid) 'gone'
						throw SamplerError.noSuchProcess
					end 'gone'

					throw SamplerError.accessDenied
				end 'refused'

				let sampled = Self{process: __ManagedHandle.adopting(port), pid: pid as RegisterWord, scratch: scratch, window: window, openThreads: OpenThreadArray.create(0), watches: ThreadWatchArray.create(0), pending: PendingStop.none(), trampoline: TrampolineLocation.notYet}

				return sampled
			#endif

			#if os(Linux)
				if not Process.isAlive(pid) 'gone'
					throw SamplerError.noSuchProcess
				end 'gone'

				let pin = MachinePin.acquire()

				if not pin.held() 'unpinnable'
					throw SamplerError.threadNotPinned
				end 'unpinnable'

				let sampled = Self{pid: pid as RegisterWord, scratch: ScratchPages.reserve(SampleProcessScratchBytes), window: ScratchPages.reserve(SampleWindowBytes as ScratchBytes), openThreads: OpenThreadArray.create(0), watches: ThreadWatchArray.create(0), pending: PendingStop.none(), trace: ProcessTrace.create(), seized: SeizedThreads.open(pid, pin: pin)}

				if not sampled.scratch.held() or not sampled.window.held() or not sampled.trace.isReady() or not sampled.seized.held() 'noPages'
					sampled.close()

					throw SamplerError.noScratch
				end 'noPages'

				let probe = sampled.canBeTraced()

				if probe != TraceProbe.traceable 'untraceable'
					sampled.close()

					if probe == TraceProbe.killed 'killedWhileProbing'
						throw SamplerError.noSuchProcess
					end 'killedWhileProbing'

					throw SamplerError.accessDenied
				end 'untraceable'

				return sampled
			#endif
		end 'open'

		function track(found SampledThreadArray, handle RegisterWord, id SampledThreadId)
			#if os(Linux)
				self.openThreads.push(OpenThread.holding(handle, owning: __ManagedHandle.adopting(0), id: id))
			#else
				self.openThreads.push(OpenThread.holding(handle, owning: __ManagedHandle.adopting(handle), id: id))
			#endif

			found.push(SampledThread.identified(handle, id: id))
		end 'track'

		public function threads() returns SampledThreadArray
			let found = SampledThreadArray.create(0)

			#if os(Windows) and arch(x64)
				var cursor = 0 as RegisterWord

				while true 'eachThread'
					let handle = __Builtins.profileNextThread(self.process.handle() as RegisterWord, cursor) as RegisterWord

					if handle == 0 'endOfTheList'
						break
					end 'endOfTheList'

					self.track(found, handle: handle, id: __Builtins.profileThreadId(handle) as SampledThreadId)
					cursor = handle
				end 'eachThread'
			#endif

			#if os(Macos)
				self.scratch.setWord(MachArraySlot, value: 0)
				self.scratch.setWord(MachArrayCountSlot, value: 0)
				let task = self.process.handle() as RegisterWord

				if __Builtins.profileMachTaskThreads(task, self.scratch.addressOf(MachArraySlot), self.scratch.addressOf(MachArrayCountSlot)) != MachSuccess 'listFailed'
					return found
				end 'listFailed'

				let array = self.scratch.word(MachArraySlot)
				let count = self.scratch.word(MachArrayCountSlot) and MachLowHalfMask

				for index in 0 upto count 'eachPort'
					let packed = __Builtins.profileReadWord(array, (index / MachPortsPerWord) * MachPortWordBytes) as RegisterWord
					let port = (packed shr ((index mod MachPortsPerWord) * MachPortBits)) and MachLowHalfMask

					if let id = try self.machThreadIdentifier(port) 'identified'
						self.track(found, handle: port, id: id)
					end 'identified' else 'exitedWhileListed'
						_ = __Builtins.profileMachReleasePort(__Builtins.profileMachSelfTask(), port)
					end 'exitedWhileListed'
				end 'eachPort'

				_ = __Builtins.profileMachReleaseMemory(__Builtins.profileMachSelfTask(), array, count * MachPortBytes)
			#endif

			#if os(Linux)
				let directory = try FilePath.from("{TraceProcRoot}/{self.pid}/{TraceProcTaskDirectory}") otherwise return found
				let entries = try Directory.list(directory) otherwise return found

				for entry in entries 'eachEntry'
					let id = try int.fromString(entry.filename()) otherwise continue
					self.track(found, handle: id as RegisterWord, id: id as SampledThreadId)
				end 'eachEntry'
			#endif

			return found
		end 'threads'

		function slotOf(thread SampledThread) returns SampledThreadSlot
			for (iter, held) in self.openThreads.withIterator() 'eachHandle'
				if held.names(thread) 'thisOne'
					return SampledThreadSlot.at(iter.index())
				end 'thisOne'
			end 'eachHandle'

			return SampledThreadSlot.none
		end 'slotOf'

		function requireHeld(thread SampledThread) throws SamplerError
			match self.slotOf(thread) 'held'
				none then throw SamplerError.unknownThread
				at then return
			end 'held'
		end 'requireHeld'

		public function release(thread SampledThread)
			match self.slotOf(thread) 'held'
				none then return
				at(index) then self.dropThread(index)
			end 'held'
		end 'release'

		function dropThread(index ElementIndex)
			let dropped = try self.openThreads.remove(index) otherwise panic("SampledProcess.dropThread: index {index} came from a search of the table")
			dropped.release()
		end 'dropThread'

		public function cycles(thread SampledThread) returns SampleCycles throws SamplerError
			try self.requireHeld(thread)

			#if os(Windows) and arch(x64)
				return __Builtins.profileThreadCycles(thread.rawHandle()) as SampleCycles
			#endif

			#if not os(Windows)
				self.pending = PendingStop.none()
				let reading = self.threadReading(thread)

				if reading.isRunning() 'canBeStopped'
					#if os(Linux)
						self.pending = self.stopThread(thread, stateKnown: true)
					#else
						self.pending = try self.stopThread(thread)
					#endif
				end 'canBeStopped'

				return match reading 'reading'
					running or
					unreadable gives self.lastCycles(thread.id)
					idle(cpuNanos) gives self.settleWatch(thread.id, exact: cpuNanos)
				end 'reading'
			#endif
		end 'cycles'

		#if not os(Windows)
			function watchSlotOf(id SampledThreadId) returns SampledThreadSlot
				for (iter, watch) in self.watches.withIterator() 'eachWatch'
					if watch.id == id 'thisOne'
						return SampledThreadSlot.at(iter.index())
					end 'thisOne'
				end 'eachWatch'

				return SampledThreadSlot.none
			end 'watchSlotOf'

			function lastCycles(id SampledThreadId) returns SampleCycles
				match self.watchSlotOf(id) 'known'
					none then return 0
					at(index) then return (try self.watches.get(index) otherwise panic("SampledProcess.lastCycles: index {index} came from a search of the table")).cycles
				end 'known'
			end 'lastCycles'

			function settleWatch(id SampledThreadId, exact SampleCycles) returns SampleCycles
				match self.watchSlotOf(id) 'known'
					none then return self.startWatch(id, exact: exact)
					at(index) then return self.settledWatch(index, exact: exact)
				end 'known'
			end 'settleWatch'

			function startWatch(id SampledThreadId, exact SampleCycles) returns SampleCycles
				self.watches.push(ThreadWatch.starting(id, cycles: exact))

				return exact
			end 'startWatch'

			function settledWatch(index ElementIndex, exact SampleCycles) returns SampleCycles
				let watch = try self.watches.get(index) otherwise panic("SampledProcess.settledWatch: index {index} came from a search of the table")

				if exact > watch.cycles 'ranSinceTheLastReading'
					watch.cycles = exact
					try self.watches.set(index, value: watch) otherwise panic("SampledProcess.settledWatch: index {index} came from a search of the table")
				end 'ranSinceTheLastReading'

				return watch.cycles
			end 'settledWatch'

			function takePendingStop(id SampledThreadId) returns PendingStop
				if self.pending.id != id 'someoneElses'
					return PendingStop.none()
				end 'someoneElses'

				let taken = PendingStop.of(self.pending.id, kind: self.pending.kind, programCounter: self.pending.programCounter, framePointer: self.pending.framePointer, stackPointer: self.pending.stackPointer, linkRegister: self.pending.linkRegister, copied: self.pending.copied, cycles: self.pending.cycles)
				self.pending = PendingStop.none()

				return taken
			end 'takePendingStop'

			function captureOfStop(stop PendingStop) returns SampleCapture throws SamplerError
				match stop.kind 'which'
					calling then throw SamplerError.callingThread
					gone then return SampleCapture.threadGone
					unreadable then return SampleCapture.unreadable(StackReservation.unreported, suspendedCycles: stop.cycles as RegisterWord)
					registers then return self.capturedStack(stop.programCounter, framePointer: stop.framePointer, stackPointer: stop.stackPointer, linkRegister: stop.linkRegister, copied: stop.copied, suspendedCycles: stop.cycles as RegisterWord)
					nothing then panic("SampledProcess.captureOfStop: a stop that stopped nothing reached a capture")
				end 'which'
			end 'captureOfStop'
		#endif

		/// Read `thread`'s registers and copy its stack into the window. Throws `unknownThread` for a
		/// thread `threads()` did not hand out or `release` let go, and `callingThread` for the thread
		/// making the call.
		public function capture(thread SampledThread) returns SampleCapture throws SamplerError
			try self.requireHeld(thread)

			#if os(Windows) and arch(x64)
				if thread.id == (__Builtins.profileThreadId(CurrentThreadPseudoHandle) as SampledThreadId) 'suspendsItself'
					throw SamplerError.callingThread
				end 'suspendsItself'

				self.publishSavedFrameLocation()

				let windowBytes = __Builtins.profileSample(self.process.handle() as RegisterWord, thread.rawHandle(), self.scratch.addressOf(SampleContextSlot), self.scratch.addressOf(SampleRegionSlot), self.window.addressOf(0), SampleWindowBytes)

				if windowBytes == ProfileSampleThreadGone 'exited'
					return SampleCapture.threadGone
				end 'exited'

				let allocationBase = self.scratch.word(SampleRegionAllocationBaseSlot)
				let suspendedCycles = self.scratch.word(SampleRegionSuspendedCyclesSlot)

				if windowBytes == ProfileSampleNoRegisters 'nothingToRead'
					return SampleCapture.unreadable(StackReservation.base(allocationBase), suspendedCycles: suspendedCycles)
				end 'nothingToRead'

				let copiedStack = StackWindow.copyOf(self.window, copied: windowBytes as RegisterWord)

				return SampleCapture.captured(SampledStack.of(self.scratch.word(SampleContextRipSlot), framePointer: self.scratch.word(SampleContextRbpSlot), stackPointer: self.scratch.word(SampleContextRspSlot), linkRegister: LinkRegister.absent, reservation: StackReservation.base(allocationBase), suspendedCycles: suspendedCycles, window: copiedStack, savedFrame: self.savedFrameOfSample()))
			#endif

			#if not os(Windows)
				let stop = self.takePendingStop(thread.id)

				if stop.kind != StopKind.nothing 'stoppedThisTick'
					return try self.captureOfStop(stop)
				end 'stoppedThisTick'

				#if os(Linux)
					return try self.captureOfStop(self.stopThread(thread, stateKnown: false))
				#else
					return try self.captureOfStop(try self.stopThread(thread))
				#endif
			#endif
		end 'capture'

		#if not os(Windows)
			function capturedStack(programCounter RegisterWord, framePointer RegisterWord, stackPointer RegisterWord, linkRegister LinkRegister, copied RegisterWord, suspendedCycles RegisterWord) returns SampleCapture
				let copiedStack = StackWindow.copyOf(self.window, copied: copied)

				return SampleCapture.captured(SampledStack.of(programCounter, framePointer: framePointer, stackPointer: stackPointer, linkRegister: linkRegister, reservation: StackReservation.unreported, suspendedCycles: suspendedCycles, window: copiedStack))
			end 'capturedStack'
		#endif

		#if os(Macos)
			function readRemote(address RegisterWord, windowOffset RegisterWord, count RegisterWord) returns bool
				return __Builtins.profileMachReadMemory(self.process.handle() as RegisterWord, address, count, self.window.addressOf(windowOffset as ScratchOffset), self.scratch.addressOf(MachReadSizeSlot)) == MachSuccess
			end 'readRemote'

			function machThreadIdentifier(port RegisterWord) returns SampledThreadId throws SamplerError
				self.scratch.setWord(MachCountSlot, value: MachThreadIdentifierInfoWords)

				if __Builtins.profileMachThreadInfo(port, MachThreadIdentifierInfo, self.scratch.addressOf(MachInfoSlot), self.scratch.addressOf(MachCountSlot)) != MachSuccess 'unidentified'
					throw SamplerError.unknownThread
				end 'unidentified'

				return self.scratch.word(MachInfoSlot) as SampledThreadId
			end 'machThreadIdentifier'

			function machReadBasicInfo(port RegisterWord) returns bool
				self.scratch.setWord(MachCountSlot, value: MachThreadBasicInfoWords)

				return __Builtins.profileMachThreadInfo(port, MachThreadBasicInfo, self.scratch.addressOf(MachInfoSlot), self.scratch.addressOf(MachCountSlot)) == MachSuccess
			end 'machReadBasicInfo'

			function machInfoCpuNanos() returns SampleCycles
				let user = self.scratch.word(MachInfoSlot)
				let system = self.scratch.word(MachInfoSecondSlot)
				let seconds = (user and MachLowHalfMask) + (system and MachLowHalfMask)
				let micros = (user shr MachHighHalfShift) + (system shr MachHighHalfShift)

				return (seconds * MachNanosPerSecond + micros * MachNanosPerMicro) as SampleCycles
			end 'machInfoCpuNanos'

			function threadReading(thread SampledThread) returns ThreadReading
				if not self.machReadBasicInfo(thread.rawHandle()) 'unreadable'
					return ThreadReading.unreadable
				end 'unreadable'

				let cpuNanos = self.machInfoCpuNanos()
				let running = (self.scratch.word(MachInfoStateSlot) and MachLowHalfMask) == MachStateRunning

				if running 'canBeStopped'
					return ThreadReading.running
				end 'canBeStopped'

				return ThreadReading.idle(cpuNanos)
			end 'threadReading'

			function callerCycles(thread SampledThread) returns SampleCycles
				if not self.machReadBasicInfo(thread.rawHandle()) 'unreadable'
					return self.lastCycles(thread.id)
				end 'unreadable'

				return self.settleWatch(thread.id, exact: self.machInfoCpuNanos())
			end 'callerCycles'

			function stopThread(thread SampledThread) returns PendingStop throws SamplerError
				// Placed first: locating reads into the same window this stop copies its stack to.
				let placed = try self.signalTrampoline().placed()
				self.scratch.setWord(MachInfoSlot, value: 0)
				self.scratch.setWord(MachInfoSecondSlot, value: 0)
				self.scratch.setWord(MachStateTrampolineSlot, value: placed.entryAddress())

				let windowBytes = __Builtins.profileMachSample(self.process.handle() as RegisterWord, thread.rawHandle(), self.scratch.addressOf(MachStateSlot), self.scratch.addressOf(MachInfoSlot), self.window.addressOf(0), SampleWindowBytes)

				if windowBytes == ProfileSampleThreadGone 'exited'
					return PendingStop.lost(thread.id)
				end 'exited'

				if windowBytes == ProfileSampleCallingThread 'callersOwn'
					return PendingStop.of(thread.id, kind: StopKind.calling, programCounter: 0, framePointer: 0, stackPointer: 0, linkRegister: LinkRegister.absent, copied: 0, cycles: self.callerCycles(thread))
				end 'callersOwn'

				let suspendedCycles = self.settleWatch(thread.id, exact: self.machInfoCpuNanos())

				if windowBytes == ProfileSampleNoRegisters 'nothingToRead'
					return PendingStop.unreadable(thread.id, cycles: suspendedCycles)
				end 'nothingToRead'

				return PendingStop.of(thread.id, kind: StopKind.registers, programCounter: self.scratch.word(MachStateProgramCounterSlot), framePointer: self.scratch.word(MachStateFramePointerSlot), stackPointer: self.scratch.word(MachStateStackPointerSlot), linkRegister: LinkRegister.holds(self.scratch.word(MachStateLinkRegisterSlot)), copied: windowBytes as RegisterWord, cycles: suspendedCycles)
			end 'stopThread'
		#endif

		#if os(Linux)
			function readRemote(address RegisterWord, windowOffset RegisterWord, count RegisterWord) returns bool
				return self.trace.copyFrom(self.pid as DebuggeeProcessId, address: address as DebuggeeAddress, destination: self.window.addressOf(windowOffset as ScratchOffset), count: count)
			end 'readRemote'

			function schedulerNanos(thread SampledThread) returns CpuNanos
				let path = try FilePath.from("{TraceProcRoot}/{self.pid}/{TraceProcTaskDirectory}/{thread.rawHandle()}/{ProcSchedStatFile}") otherwise return CpuNanos.unreadable
				let text = try File.readText(path) otherwise return CpuNanos.unreadable
				let onCpu = try text.split(ProcFieldSeparator).get(0) otherwise return CpuNanos.unreadable
				let nanos = try int.fromString(onCpu.trim()) otherwise return CpuNanos.unreadable

				return CpuNanos.read(nanos as SampleCycles)
			end 'schedulerNanos'

			function settledSchedulerCycles(thread SampledThread) returns SampleCycles
				return match self.schedulerNanos(thread) 'reading'
					read(nanos) gives self.settleWatch(thread.id, exact: nanos)
					unreadable gives self.lastCycles(thread.id)
				end 'reading'
			end 'settledSchedulerCycles'

			function threadState(id RegisterWord) returns TraceThreadState
				return self.trace.threadState(self.pid as DebuggeeProcessId, thread: id as DebuggeeThreadId)
			end 'threadState'

			function threadReading(thread SampledThread) returns ThreadReading
				let state = self.threadState(thread.rawHandle())

				return match state 'state'
					absent gives ThreadReading.unreadable
					present gives self.readingOfLiveThread(thread, running: state.isRunning())
				end 'state'
			end 'threadReading'

			function readingOfLiveThread(thread SampledThread, running bool) returns ThreadReading
				if running 'running'
					return ThreadReading.running
				end 'running'

				return match self.schedulerNanos(thread) 'accounted'
					read(nanos) gives ThreadReading.idle(nanos)
					unreadable gives ThreadReading.unreadable
				end 'accounted'
			end 'readingOfLiveThread'

			// Copied here, in Maxon, because a ptrace-stopped thread stays stopped until this process detaches
			// it. macOS copies inside `__prof_mach_sample` instead, the one graph whose every path reaches the
			// resume.
			function copyStack(stackPointer RegisterWord) returns RegisterWord
				var copied = 0 as RegisterWord

				while copied < SampleWindowBytes 'eachChunk'
					let address = stackPointer + copied
					let toBoundary = StackReadChunkBytes - (address mod StackReadChunkBytes)
					let wanted = toBoundary if toBoundary < SampleWindowBytes - copied else SampleWindowBytes - copied

					if not self.readRemote(address, windowOffset: copied, count: wanted) 'unmapped'
						break
					end 'unmapped'

					copied = copied + wanted
				end 'eachChunk'

				return copied
			end 'copyStack'

			function stopThread(thread SampledThread, stateKnown bool) returns PendingStop
				let id = thread.rawHandle() as DebuggeeThreadId

				match self.seizeForStop(id, stateKnown: stateKnown) 'seized'
					uninterruptible then return PendingStop.unreadable(thread.id, cycles: self.lastCycles(thread.id))
					gone then return PendingStop.lost(thread.id)
					held then break
				end 'seized'

				let arrival = self.interruptedAndHeld(id)
				let stopped = arrival.isHeld()
				var programCounter = 0 as RegisterWord
				var framePointer = 0 as RegisterWord
				var stackPointer = 0 as RegisterWord
				var copied = 0 as RegisterWord

				if stopped 'registersAreHeld'
					programCounter = self.trace.generalRegister(TraceProgramCounterOffset as ScratchOffset)
					framePointer = self.trace.generalRegister(TraceFramePointerOffset as ScratchOffset)
					stackPointer = self.trace.generalRegister(TraceStackPointerOffset as ScratchOffset)
					copied = self.copyStack(stackPointer)
				end 'registersAreHeld'

				_ = self.letGo(id, owed: arrival.owedSignal())

				var suspendedCycles = self.lastCycles(thread.id)

				if stopped 'settledByTheStop'
					suspendedCycles = self.settledSchedulerCycles(thread)
				end 'settledByTheStop'

				if not stopped 'nothingToRead'
					return PendingStop.unreadable(thread.id, cycles: suspendedCycles)
				end 'nothingToRead'

				return PendingStop.of(thread.id, kind: StopKind.registers, programCounter: programCounter, framePointer: framePointer, stackPointer: stackPointer, linkRegister: LinkRegister.absent, copied: copied, cycles: suspendedCycles)
			end 'stopThread'

			function canBeTraced() returns TraceProbe
				let leader = self.pid as DebuggeeThreadId
				var outcome = self.seizeForStop(leader, stateKnown: false)
				let started = Clock.nowNanos()

				while outcome == SeizeOutcome.uninterruptible and Clock.elapsedNanos(started) <= TraceStopBudgetNanos 'untilItWakes'
					self.pauseAfterSpinning(started)
					outcome = self.seizeForStop(leader, stateKnown: false)
				end 'untilItWakes'

				match outcome 'seized'
					gone then return TraceProbe.killed if self.threadState(self.pid).hasLeft() else TraceProbe.refused
					uninterruptible then return TraceProbe.traceable
					held then break
				end 'seized'

				let arrival = self.interruptedAndHeld(leader)

				return TraceProbe.traceable if self.letGo(leader, owed: arrival.owedSignal()) else TraceProbe.killed
			end 'canBeTraced'

			function seizeForStop(thread DebuggeeThreadId, stateKnown bool) returns SeizeOutcome
				if not stateKnown and self.threadState(thread as RegisterWord).isUninterruptible() 'asleepInTheKernel'
					return SeizeOutcome.uninterruptible
				end 'asleepInTheKernel'

				if not self.holdForStop(thread) 'refused'
					return SeizeOutcome.gone
				end 'refused'

				return SeizeOutcome.held
			end 'seizeForStop'

			function holdForStop(thread DebuggeeThreadId) returns bool
				if self.seized.contains(thread) 'alreadyHeld'
					return true
				end 'alreadyHeld'

				if not self.trace.seize(thread) 'refused'
					return false
				end 'refused'

				self.seized.add(thread)

				return true
			end 'holdForStop'

			function detachedOrGone(thread DebuggeeThreadId, owed DebuggeeSignal) returns bool
				if self.trace.detach(thread, signal: owed) or ((thread as RegisterWord) != self.pid and self.trace.reapedGone(thread)) or self.threadState(thread as RegisterWord).hasLeft() 'noLongerHeld'
					self.seized.remove(thread)

					return true
				end 'noLongerHeld'

				return false
			end 'detachedOrGone'

			function letGo(thread DebuggeeThreadId, owed DebuggeeSignal) returns bool
				let started = Clock.nowNanos()

				while not self.detachedOrGone(thread, owed: owed) 'untilItHasStopped'
					if Clock.elapsedNanos(started) > TraceStopBudgetNanos 'outOfTime'
						self.seized.killProcessHolding(thread)

						return false
					end 'outOfTime'

					self.pauseAfterSpinning(started)
				end 'untilItHasStopped'

				return true
			end 'letGo'

			function pauseAfterSpinning(started InstantNanos)
				if Clock.elapsedNanos(started) > TraceStopSpinNanos 'spunLongEnough'
					__Builtins.profileSleepMicros(TraceStopPollMicros)
				end 'spunLongEnough'
			end 'pauseAfterSpinning'

			function interruptedAndHeld(thread DebuggeeThreadId) returns StopArrival
				if not self.trace.interrupt(thread) 'refused'
					return StopArrival.lost
				end 'refused'

				return self.awaitStop(thread)
			end 'interruptedAndHeld'

			// Readiness is read from the registers and never by waiting on `thread`: `wait4` on the leader's
			// id reaps its exit status, and `ProfileCommand`'s `pollExit` would then never see the program end.
			function awaitStop(thread DebuggeeThreadId) returns StopArrival
				let started = Clock.nowNanos()

				while Clock.elapsedNanos(started) <= TraceStopBudgetNanos 'untilItHasStopped'
					if self.trace.readGeneralRegisters(thread) 'stopped'
						return StopArrival.held(self.trace.signalAwaitingDelivery(thread))
					end 'stopped'

					if Clock.elapsedNanos(started) > TraceStopSpinNanos and self.threadState(thread as RegisterWord).hasLeft() 'exited'
						return StopArrival.lost
					end 'exited'

					self.pauseAfterSpinning(started)
				end 'untilItHasStopped'

				return StopArrival.lost
			end 'awaitStop'
		#endif

		public function modules() returns SampledModuleArray throws SamplerError
			#if not os(Linux)
				let started = Clock.nowNanos()

				while Clock.elapsedNanos(started) < ModuleListDeadlineNanos 'retry'
					let listed = self.listedModules()

					if listed.count() > 0 'listed'
						return listed
					end 'listed'

					sleep(ModuleListRetryMs)
				end 'retry'

				throw SamplerError.moduleListUnavailable
			#endif

			#if os(Linux)
				if not Process.isAlive(self.pid as Pid) 'gone'
					throw SamplerError.moduleListUnavailable
				end 'gone'

				return SampledModuleArray.create(0)
			#endif
		end 'modules'

		#if os(Macos)
			function dyldImageList() returns DyldImageList
				self.pending = PendingStop.none()
				self.scratch.setWord(MachCountSlot, value: MachTaskDyldInfoWords)

				if __Builtins.profileMachTaskInfo(self.process.handle() as RegisterWord, MachTaskDyldInfo, self.scratch.addressOf(MachDyldInfoSlot), self.scratch.addressOf(MachCountSlot)) != MachSuccess or not self.readRemote(self.scratch.word(MachDyldInfoSlot), windowOffset: 0, count: MachImageInfoHeaderBytes) 'noImageList'
					return DyldImageList.stillLoading
				end 'noImageList'

				// Until libSystem initialises, the list can hold only the executable, and every library address
				// would then read as outside the program's images.
				if ((self.window.word(MachLibSystemFlagsOffset) shr MachLibSystemInitializedShift) and MachByteMask) == 0 'libSystemUninitialized'
					return DyldImageList.stillLoading
				end 'libSystemUninitialized'

				return DyldImageList.listed(self.window.word(0) shr MachHighHalfShift, array: self.window.word(MachImageArrayOffset))
			end 'dyldImageList'

			function listedModules() returns SampledModuleArray
				return match self.dyldImageList() 'images'
					stillLoading gives SampledModuleArray.create(0)
					listed(count, array) gives self.loadedImages(count, imageArray: array)
				end 'images'
			end 'listedModules'

			// `absent` is not kept, so the next stop asks again. Answering it before libSystem initialises
			// is sound: the runtime installs its SIGURG handler in `mrt_runtime_init`, which `mrt_start`
			// calls before `main` and after dyld has initialised libSystem, so no thread can be at the
			// trampoline yet.
			function placedTrampoline() returns SignalTrampoline
				match self.dyldImageList() 'images'
					stillLoading then return SignalTrampoline.absent
					listed(count, array) then return self.locatedOrUnplaced(self.loadedImages(count, imageArray: array))
				end 'images'
			end 'placedTrampoline'

			function locatedOrUnplaced(modules SampledModuleArray) returns SignalTrampoline
				let code = try self.locatedTrampoline(modules) otherwise return SignalTrampoline.unplaced
				self.trampoline = TrampolineLocation.located(code)

				return code
			end 'locatedOrUnplaced'

			function loadedImages(imageCount RegisterWord, imageArray RegisterWord) returns SampledModuleArray
				let modules = SampledModuleArray.create(0)
				var index = 0 as RegisterWord

				while index < imageCount and index < MachMaxModules 'eachImage'
					let entry = imageArray + index * MachImageInfoBytes
					index = index + 1

					if not self.readRemote(entry, windowOffset: 0, count: MachImageInfoBytes) 'unreadableEntry'
						continue
					end 'unreadableEntry'

					let base = self.window.word(0)
					let path = self.window.word(MachImagePathOffset)
					let extent = self.machTextExtent(base)

					if extent == 0 'noSegment'
						continue
					end 'noSegment'

					let fileType = self.window.word(MachHeaderFileTypeWord) shr MachHighHalfShift
					modules.push(SampledModule.spanning(base, limit: base + extent, name: self.machBaseName(path), fileType: fileType))
				end 'eachImage'

				return modules
			end 'loadedImages'
		#endif

		#if os(Windows) and arch(x64)
			function publishSavedFrameLocation()
				match self.savedFrames 'location'
					untracked then return
					recordedAt(codeBase, codeBytes, slotBase, recordField) then self.writeSavedFrameLocation(codeBase, codeBytes: codeBytes, slotBase: slotBase, recordField: recordField, fixedRecord: NoSavedFrame)
					fixedAt(codeBase, codeBytes, record) then self.writeSavedFrameLocation(codeBase, codeBytes: codeBytes, slotBase: NoSavedFrame, recordField: NoSavedFrame, fixedRecord: record)
				end 'location'
			end 'publishSavedFrameLocation'

			function writeSavedFrameLocation(codeBase RegisterWord, codeBytes RegisterWord, slotBase RegisterWord, recordField RegisterWord, fixedRecord RegisterWord)
				self.scratch.setWord(SampleSavedFrameCodeBaseSlot, value: codeBase)
				self.scratch.setWord(SampleSavedFrameCodeBytesSlot, value: codeBytes)
				self.scratch.setWord(SampleSavedFrameSlotBaseSlot, value: slotBase)
				self.scratch.setWord(SampleSavedFrameRecordFieldSlot, value: recordField)
				self.scratch.setWord(SampleSavedFrameFixedRecordSlot, value: fixedRecord)
				self.scratch.setWord(SampleSavedFrameWindowAddressSlot, value: self.window.addressOf(SampleWindowBytes))
			end 'writeSavedFrameLocation'

			function savedFrameOfSample() returns SavedFrame
				let programCounter = self.scratch.word(SampleSavedFramePcSlot)

				if programCounter == NoSavedFrame 'nothingSaved'
					return SavedFrame.absent
				end 'nothingSaved'

				let windowBytes = self.scratch.word(SampleSavedFrameWindowBytesSlot)

				return SavedFrame.saved(programCounter, framePointer: self.scratch.word(SampleSavedFrameFpSlot), stackPointer: self.scratch.word(SampleSavedFrameSpSlot), window: StackWindow.copyOfRegion(self.window, copied: windowBytes, from: SampleWindowBytes))
			end 'savedFrameOfSample'

			// `PEB.Ldr` is non-null and `PEB_LDR_DATA.Initialized` is already 1 while the loader still maps the
			// import closure; only `ProcessInitializingFlag` clearing marks it finished.
			function loaderHasInitialized() returns bool
				let target = self.process.handle() as RegisterWord
				let status = __Builtins.profileQueryProcess(target, ProcessBasicInformationClass, self.scratch.addressOf(SampleProcessInformationSlot), ProcessBasicInformationBytes) as RegisterWord

				if status != NtStatusSuccess 'unqueried'
					return false
				end 'unqueried'

				let readFailed = __Builtins.profileReadRemote(target, self.scratch.word(ProcessPebAddressSlot), self.scratch.addressOf(SamplePebSlot), PebPrefixBytes) == ReadProcessMemoryFailed

				if readFailed 'unreadable'
					return false
				end 'unreadable'

				return self.scratch.word(PebLoaderSlot) != PebLoaderAbsent and (self.scratch.word(PebCrossProcessFlagsSlot) and ProcessInitializingFlag) == 0
			end 'loaderHasInitialized'

			function listedModules() returns SampledModuleArray
				let modules = SampledModuleArray.create(0)

				if not self.loaderHasInitialized() 'stillLoading'
					return modules
				end 'stillLoading'

				let snapshot = __Builtins.profileModuleSnapshot(self.pid) as RegisterWord

				if snapshot == InvalidHandle or snapshot == 0 'notYet'
					return modules
				end 'notYet'

				self.scratch.setWord(ModuleEntrySizeSlot, value: ModuleEntryBytes)
				var more = __Builtins.profileModuleFirst(snapshot, self.scratch.addressOf(SampleModuleEntrySlot))

				while more != 0 'eachModule'
					let base = self.scratch.word(ModuleEntryBaseSlot)
					modules.push(SampledModule.spanning(base, limit: base + (self.scratch.word(ModuleEntryExtentSlot) and u32.max), name: self.moduleName(), fileType: ModuleHasNoFileType))
					more = __Builtins.profileModuleNext(snapshot, self.scratch.addressOf(SampleModuleEntrySlot))
				end 'eachModule'

				__Builtins.profileClose(snapshot)

				return modules
			end 'listedModules'

			function moduleName() returns String
				let name = ByteArray.create(0)
				var offset = ModuleEntryNameOffset as ScratchOffset

				while offset < ModuleEntryBytes 'eachWord'
					let packed = self.scratch.word(SampleModuleEntrySlot + offset)

					for unit in 0 upto Utf16UnitsPerWord 'eachUnit'
						let code = (packed shr ((unit * Utf16UnitBits) as UnitShift)) and Utf16UnitMask

						if code == 0 'endOfName'
							return String.from(name)
						end 'endOfName'

						name.push((code if code < AsciiCeiling else NonAsciiPlaceholder) as Byte)
					end 'eachUnit'

					offset = offset + (sizeof(RegisterWord) as ScratchOffset)
				end 'eachWord'

				return String.from(name)
			end 'moduleName'
		#endif

		#if os(Macos)
			function machReadCommands(base RegisterWord) returns RegisterWord throws SamplerError
				if not self.readRemote(base, windowOffset: 0, count: MachHeaderBytes) 'noHeader'
					throw SamplerError.moduleListUnavailable
				end 'noHeader'

				let commandBytes = self.window.word(MachHeaderCommandsWord) shr MachHighHalfShift

				if commandBytes > MachMaxCommandBytes or not self.readRemote(base + MachHeaderBytes, windowOffset: MachHeaderBytes, count: commandBytes) 'noCommands'
					throw SamplerError.moduleListUnavailable
				end 'noCommands'

				return commandBytes
			end 'machReadCommands'

			function machCommandWord(wanted MachCommandWanted, commandBytes RegisterWord, field RegisterWord) returns RegisterWord throws SamplerError
				var offset = MachHeaderBytes as RegisterWord

				while offset < MachHeaderBytes + commandBytes 'eachCommand'
					let command = self.window.word(offset as ScratchOffset)
					let size = command shr MachHighHalfShift

					if size == 0 'malformed'
						throw SamplerError.moduleListUnavailable
					end 'malformed'

					if self.machCommandIs(wanted, kind: command and MachLowHalfMask, offset: offset) 'theWantedCommand'
						return self.window.word((offset + field) as ScratchOffset)
					end 'theWantedCommand'

					offset = offset + size
				end 'eachCommand'

				throw SamplerError.moduleListUnavailable
			end 'machCommandWord'

			function machCommandIs(wanted MachCommandWanted, kind RegisterWord, offset RegisterWord) returns bool
				return match wanted 'which'
					ofKind(wantedKind) gives kind == wantedKind
					segment(firstName, secondName) gives kind == MachLoadCommandSegment64 and self.window.word((offset + MachSegmentNameOffset) as ScratchOffset) == firstName and self.window.word((offset + MachSegmentSecondNameOffset) as ScratchOffset) == secondName
				end 'which'
			end 'machCommandIs'

			function machTextExtent(base RegisterWord) returns RegisterWord
				let commandBytes = try self.machReadCommands(base) otherwise return 0

				return try self.machCommandWord(MachCommandWanted.segment(MachTextSegmentNameWord, secondName: 0), commandBytes: commandBytes, field: MachSegmentSizeOffset) otherwise 0
			end 'machTextExtent'

			function locatedTrampoline(modules SampledModuleArray) returns SignalTrampoline throws SamplerError
				for module in modules 'eachModule'
					if module.name == MachSignalLibraryName 'theSignalLibrary'
						return try self.machFunctionSpan(module.base, name: MachSignalTrampolineSymbol)
					end 'theSignalLibrary'
				end 'eachModule'

				throw SamplerError.moduleListUnavailable
			end 'locatedTrampoline'

			function machFunctionSpan(base RegisterWord, name String) returns SignalTrampoline throws SamplerError
				let commandBytes = try self.machReadCommands(base)
				let text = MachCommandWanted.segment(MachTextSegmentNameWord, secondName: 0)
				let textAddress = try self.machCommandWord(text, commandBytes: commandBytes, field: MachSegmentAddressOffset)
				let textSize = try self.machCommandWord(text, commandBytes: commandBytes, field: MachSegmentSizeOffset)
				let linkEdit = MachCommandWanted.segment(MachLinkEditFirstNameWord, secondName: MachLinkEditSecondNameWord)
				let linkEditAddress = try self.machCommandWord(linkEdit, commandBytes: commandBytes, field: MachSegmentAddressOffset)
				let linkEditFileOffset = try self.machCommandWord(linkEdit, commandBytes: commandBytes, field: MachSegmentFileOffsetOffset)
				let symbolTable = MachCommandWanted.ofKind(MachLoadCommandSymbolTable)
				let tableLocation = try self.machCommandWord(symbolTable, commandBytes: commandBytes, field: MachSymbolTableLocationOffset)
				let stringsLocation = try self.machCommandWord(symbolTable, commandBytes: commandBytes, field: MachSymbolTableStringsOffset)
				let startsLocation = try self.machCommandWord(MachCommandWanted.ofKind(MachLoadCommandFunctionStarts), commandBytes: commandBytes, field: MachFunctionStartsLocationOffset)
				let slide = base - textAddress
				let linkEditBase = linkEditAddress + slide - linkEditFileOffset
				let start = try self.machSymbolValue(linkEditBase + (tableLocation and MachLowHalfMask), symbolCount: tableLocation shr MachHighHalfShift, strings: linkEditBase + (stringsLocation and MachLowHalfMask), name: name)
				let limit = try self.machNextFunctionStart(linkEditBase + (startsLocation and MachLowHalfMask), byteCount: startsLocation shr MachHighHalfShift, textAddress: textAddress, after: start, textLimit: textAddress + textSize)

				return SignalTrampoline.spanning(start + slide, limit: limit + slide)
			end 'machFunctionSpan'

			// The trampoline ends at the next entry of `LC_FUNCTION_STARTS`, never the next symbol: the
			// symbol table need not list the function that follows, so the next symbol can lie past it and
			// the span would swallow its samples.
			function machNextFunctionStart(starts RegisterWord, byteCount RegisterWord, textAddress RegisterWord, after RegisterWord, textLimit RegisterWord) returns RegisterWord throws SamplerError
				if byteCount > SampleWindowBytes or not self.readRemote(starts, windowOffset: 0, count: byteCount) 'unreadableStarts'
					throw SamplerError.moduleListUnavailable
				end 'unreadableStarts'

				var address = textAddress
				var delta = 0 as RegisterWord
				var shift = 0 as MachUlebShift

				for byte in self.window.bytesAt(0, count: byteCount as DebuggeeByteCount) 'eachByte'
					delta = delta or (((byte as RegisterWord) and MachUlebPayloadMask) shl shift)

					if ((byte as RegisterWord) and MachUlebContinuation) != 0 'deltaContinues'
						if shift >= MachUlebMaxShift 'overlong'
							throw SamplerError.moduleListUnavailable
						end 'overlong'

						shift = (shift + MachUlebPayloadBits) as MachUlebShift
						continue
					end 'deltaContinues'

					address = address + delta

					if address > after 'theNextFunction'
						return address
					end 'theNextFunction'

					delta = 0
					shift = 0
				end 'eachByte'

				if shift != 0 'truncatedDelta'
					throw SamplerError.moduleListUnavailable
				end 'truncatedDelta'

				return textLimit
			end 'machNextFunctionStart'

			function machSymbolValue(table RegisterWord, symbolCount RegisterWord, strings RegisterWord, name String) returns RegisterWord throws SamplerError
				let terminated = name.toByteArray()
				terminated.push(0)
				var first = 0 as RegisterWord

				while first < symbolCount 'eachBatch'
					let batch = MachSymbolsPerRead if symbolCount - first > MachSymbolsPerRead else symbolCount - first

					if not self.readRemote(table + first * MachSymbolEntryBytes, windowOffset: 0, count: batch * MachSymbolEntryBytes) 'unreadableTable'
						throw SamplerError.moduleListUnavailable
					end 'unreadableTable'

					for entry in 0 upto batch 'eachSymbol'
						let entryOffset = (entry * MachSymbolEntryBytes) as ScratchOffset
						let identity = self.window.word(entryOffset)
						let symbolType = (identity shr MachSymbolTypeShift) and MachByteMask

						if (symbolType and MachSymbolTypeMask) != MachSymbolInSection 'notInASection'
							continue
						end 'notInASection'

						let value = self.window.word(entryOffset + MachSymbolValueOffset)

						if self.machNameIs(strings + (identity and MachLowHalfMask), terminated: terminated) 'theWantedSymbol'
							return value
						end 'theWantedSymbol'
					end 'eachSymbol'

					first = first + batch
				end 'eachBatch'

				throw SamplerError.moduleListUnavailable
			end 'machSymbolValue'

			function machNameIs(address RegisterWord, terminated ByteArray) returns bool
				if not self.readRemote(address, windowOffset: MachSymbolNameWindowOffset, count: terminated.count() as RegisterWord) 'unreadable'
					return false
				end 'unreadable'

				return self.window.bytesAt(MachSymbolNameWindowOffset as ScratchOffset, count: terminated.count() as DebuggeeByteCount).equals(terminated)
			end 'machNameIs'

			function machBaseName(path RegisterWord) returns String
				let name = ByteArray.create(0)
				var address = path

				while address - path < MacosMaxPathLength 'eachChunk'
					let chunk = MachPathChunkBytes - (address mod MachPathChunkBytes)

					if not self.readRemote(address, windowOffset: 0, count: chunk) 'unreadable'
						break
					end 'unreadable'

					let bytes = self.window.bytesAt(0, count: chunk as DebuggeeByteCount)

					for byte in bytes 'eachByte'
						if byte == 0 'endOfPath'
							return String.from(name)
						end 'endOfPath'

						if byte == MachPathSeparator 'newComponent'
							name.clear()
						end 'newComponent' else 'ordinaryByte'
							name.push(byte)
						end 'ordinaryByte'
					end 'eachByte'

					address = address + chunk
				end 'eachChunk'

				return String.from(name)
			end 'machBaseName'
		#endif

		public function close()
			#if os(Linux)
				self.seized.release()
			#endif

			for thread in self.openThreads 'eachThread'
				thread.release()
			end 'eachThread'

			self.openThreads.clear()

			#if not os(Linux)
				self.process.release()
			#endif

			self.scratch.release()
			self.window.release()

			#if os(Linux)
				self.trace.close()
			#endif
		end 'close'
	end 'SampledProcess'

	public typealias SampledModuleArray = Array with SampledModule

	/// A periodic timer: each `wait()` blocks until `interval` past the previous deadline. `wait()` after
	/// `close()` panics.
	public type SampleTimer
		#if os(Windows) and arch(x64)
			var timer as __ManagedHandle
			let stepTicks as RegisterWord
			var deadline as RegisterWord
		#else
			let stepNanos as SampleIntervalNanos
			var deadline as InstantNanos
		#endif

		var closed as bool

		public static function create(interval SampleIntervalNanos) returns SampleTimer
			#if os(Windows) and arch(x64)
				let ticks = (interval / NanosPerFileTimeTick) as RegisterWord
				let step = ticks if ticks > 0 else 1

				return Self{timer: __ManagedHandle.timer(), stepTicks: step, deadline: (__Builtins.profileNowFileTime() as RegisterWord) + step, closed: false}
			#else
				return Self{stepNanos: interval, deadline: Clock.nowNanos() + (interval as InstantNanos), closed: false}
			#endif
		end 'create'

		/// False when the host refused the timer `create` asked for; `wait()` panics on such a timer.
		public function ready() returns bool
			#if os(Windows) and arch(x64)
				return self.timer.handle() != 0
			#else
				return true
			#endif
		end 'ready'

		public function wait()
			if self.closed 'closed'
				panic("SampleTimer.wait: the timer was closed")
			end 'closed'

			if not self.ready() 'neverOpened'
				panic("SampleTimer.wait: the timer never opened — a caller checks ready() after create")
			end 'neverOpened'

			#if os(Windows) and arch(x64)
				self.deadline = self.deadline + self.stepTicks
				__Builtins.profileTimerWait(self.timer.handle() as RegisterWord, self.deadline)
			#else
				self.deadline = self.deadline + (self.stepNanos as InstantNanos)
				let now = Clock.nowNanos()

				if self.deadline > now 'early'
					__Builtins.profileSleepMicros(((self.deadline - now + SamplerNanosPerMicro - 1) / SamplerNanosPerMicro) as RegisterWord)
				end 'early'
			#endif
		end 'wait'

		public function close()
			#if os(Windows) and arch(x64)
				self.timer.release()
			#endif

			self.closed = true
		end 'close'
	end 'SampleTimer'
#endif
