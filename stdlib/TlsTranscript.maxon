module type TlsTranscript
	var messages as ByteArray

	module static function create() returns TlsTranscript
		return Self{messages: ByteArray.create()}
	end 'create'

	module function append(message ByteArray)
		messages.append(message)
	end 'append'

	module function restartAsMessageHash(suite Tls13CipherSuite)
		messages = Tls13KeySchedule.messageHash(suite, clientHello: messages)
	end 'restartAsMessageHash'

	module function content() returns ByteArray
		return messages.clone()
	end 'content'

	module function hash(algorithm HashAlgorithm) returns ByteArray
		return sha2Once(algorithm, data: messages)
	end 'hash'
end 'TlsTranscript'
