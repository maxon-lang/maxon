/// Hash map with open addressing and linear probing for key-value storage.
/// @category Collections
// Map receives managed memory buffers directly for literal initialization via BuiltinDictionaryLiteral.

// MapError - errors for dictionary/map operations
export enum MapError implements Error
	keyNotFound
	keyAlreadyExists
end 'MapError'

typealias EntryCount = int(0 to u64.max)

// The slot vocabulary is `helpers/hashtable/slotScan.maxon`'s, shared with `Set` (W93): `SlotState`,
// `TableSlotIndex`, `TableCapacity` and the `findNextOccupied` scan both iterators advance through.
// Two byte-identical copies of a three-state enum fail ASYMMETRICALLY — a fourth state is a compile
// error at one file's `match`es and silence at the other's — so there is one.

export type Map uses Key, Value implements BuiltinDictionaryLiteral, Iterable with (Entry, MapIterator) where Key is Hashable and Equatable
	typealias KeyArray = Array with Key
	typealias ValueArray = Array with Value
	typealias StateArray = Array with SlotState
	typealias HashSlotArray = Array with HashValue
	typealias Entry = (Key, Value)
	typealias KeyMemory = __ManagedMemory with Key
	typealias ValueMemory = __ManagedMemory with Value

	var keys as KeyArray = KeyArray.create()  // Key storage
	var values as ValueArray = ValueArray.create()  // Value storage
	var states as StateArray = StateArray.create()  // Slot states
	var hashes as HashSlotArray = HashSlotArray.create()  // Cached key hashes, parallel to keys
	var count = 0  // Number of occupied entries
	var capacity = 0  // Total slots

	/// Create an empty map
	export static function create() returns Self
		return Self{}
	end 'create'

	// Default type for dictionary literals - compiler discovers this via BuiltinDictionaryLiteral interface
	static function init(initKeys KeyMemory, initValues ValueMemory) returns Self
		// Get number of elements in the managed memory buffers
		let numElements = initKeys.length()

		// Calculate capacity: at least 16, or next power of 2 above numElements * 2
		var cap = 16
		while cap < numElements * 2 'calc_cap'
			cap = cap * 2
		end 'calc_cap'

		// Allocate internal arrays with preallocated capacity
		var ks = KeyArray{}
		ks.resize(cap)
		var vs = ValueArray{}
		vs.resize(cap)
		var sts = StateArray{}
		sts.resize(cap)
		var hs = HashSlotArray{}
		hs.resize(cap)

		// Create the map with arrays and preallocated capacity (count defaults to 0)
		var result = Self{keys: ks, values: vs, states: sts, hashes: hs, capacity: cap}

		// Insert each key-value pair from the init arrays
		for i in 0 upto numElements 'insert_loop'
			let k = try initKeys.get(i) otherwise 'kErr'
				panic("Map.init: initKeys.get OOB — i < numElements guaranteed")
			end 'kErr'
			let v = try initValues.get(i) otherwise 'vErr'
				panic("Map.init: initValues.get OOB — i < numElements guaranteed")
			end 'vErr'
			result.upsert(k, value: v)
		end 'insert_loop'

		return result
	end 'init'

	// Internal: initialize storage when capacity is zero, then grow if load factor exceeds 75%
	function ensureCapacity()
		if capacity == 0 'init_empty'
			keys = KeyArray{}
			keys.resize(16)
			values = ValueArray{}
			values.resize(16)
			states = StateArray{}
			states.resize(16)
			hashes = HashSlotArray{}
			hashes.resize(16)
			capacity = 16
		end 'init_empty'

		let loadLimit = trunc((capacity * 3) / 4)
		if count >= loadLimit 'do_grow'
			grow()
		end 'do_grow'
	end 'ensureCapacity'

	// Internal: write a key-value pair into the given slot. `hash` is the key's
	// precomputed hash (from findSlot), cached in the parallel `hashes` array so
	// probes can skip the full key.equals() when hashes differ.
	function insertAtSlot(slotIndex TableSlotIndex, key Key, value Value, hash HashValue)
		try keys.set(slotIndex, value: key) otherwise panic("Map.insertAtSlot: keys.set OOB — slot from findSlot is always in-bounds")
		try values.set(slotIndex, value: value) otherwise panic("Map.insertAtSlot: values.set OOB — slot from findSlot is always in-bounds")
		try states.set(slotIndex, value: SlotState.Occupied) otherwise panic("Map.insertAtSlot: states.set OOB — slot from findSlot is always in-bounds")
		try hashes.set(slotIndex, value: hash) otherwise panic("Map.insertAtSlot: hashes.set OOB — slot from findSlot is always in-bounds")
		count = count + 1
	end 'insertAtSlot'

	/// Insert a key-value pair into the map
	/// Throws if the key already exists
	/// Automatically resizes the map when load factor exceeds 75%
	export function insert(key Key, value Value) throws MapError
		ensureCapacity()

		let hash = key.hash()
		let slotIndex = findSlot(key, hash: hash)
		if slotIndex >= 0 'found'
			throw MapError.keyAlreadyExists
		end 'found'

		let insertIndex = -(slotIndex + 1)
		insertAtSlot(insertIndex, key: key, value: value, hash: hash)
	end 'insert'

	/// Insert or update a key-value pair in the map
	/// If the key already exists, updates the value
	/// Automatically resizes the map when load factor exceeds 75%
	export function upsert(key Key, value Value)
		ensureCapacity()

		let hash = key.hash()
		let slotIndex = findSlot(key, hash: hash)
		if slotIndex >= 0 'found'
			try values.set(slotIndex, value: value) otherwise panic("Map.upsert: values.set OOB — slot from findSlot is always in-bounds")
			return
		end 'found'

		let insertIndex = -(slotIndex + 1)
		insertAtSlot(insertIndex, key: key, value: value, hash: hash)
	end 'upsert'

	/// Get the value for a key, throws if not found
	export function get(key Key) returns Value throws MapError
		let slotIndex = findSlot(key, hash: key.hash())
		if slotIndex >= 0 'found'
			if let v = try values.get(slotIndex) 'get_value'
				return v
			end 'get_value'
		end 'found'
		throw MapError.keyNotFound
	end 'get'

	/// Check if key exists in the map
	export function contains(key Key) returns bool
		return findSlot(key, hash: key.hash()) >= 0
	end 'contains'

	/// Remove key from map, returns true if key was present
	export function remove(key Key) returns bool
		let slotIndex = findSlot(key, hash: key.hash())
		if slotIndex >= 0 'found'
			// Only the Deleted state marks the slot as removed. The cached hash is
			// left as-is: the hash-guard only runs inside the Occupied branch of
			// findSlot, so a tombstone's stale hash can never cause a false match.
			try states.set(slotIndex, value: SlotState.Deleted) otherwise panic("Map.remove: states.set OOB — slot from findSlot is always in-bounds")
			count = count - 1
			return true
		end 'found'
		return false
	end 'remove'

	/// Get number of entries in the map
	export function count() returns EntryCount
		return count
	end 'count'

	/// Create a fresh iterator positioned at the first occupied entry.
	/// Throws IterationError.exhausted if the map is empty.
	export function createIterator() returns MapIterator throws IterationError
		return try MapIterator.create(keys, values: values, states: states, capacity: capacity)
	end 'createIterator'

	/// Get current capacity (total number of slots)
	export function getCapacity() returns TableCapacity
		return capacity
	end 'getCapacity'

	// Internal: find the slot for a key using linear probing.
	// `hash` is the key's precomputed hash (computed once by the caller).
	// Returns the index of the key if found (>= 0).
	// Returns -(insertIndex + 1) if the key is not found, encoding the best
	// slot for insertion as a negative value. Returns -1 if the map is empty.
	function findSlot(key Key, hash HashValue) returns TableSlotIndex
		if capacity == 0 'empty'
			return -1
		end 'empty'

		// capacity is always a power of two (starts at 16, only ever doubled), so
		// `and (capacity - 1)` selects the low bits — identical to `mod capacity` for the
		// non-negative HashValue range, but cheaper. It is the SPREAD hash that is masked,
		// never the raw one: see `spreadHash` for the measured quadratic that costs.
		let mask = capacity - 1
		var index = spreadHash(hash) and mask

		var firstDeleted = -1
		var probes = 0

		while probes < capacity 'probe'
			let state = try states.get(index) otherwise SlotState.Empty

			let isEmpty = match state 'se1'
				Empty gives true
				Occupied gives false
				Deleted gives false
			end 'se1'
			if isEmpty 'empty_slot'
				// Key not found - return best insertion index encoded as negative
				var bestIndex = index
				if firstDeleted >= 0 'use_deleted'
					bestIndex = firstDeleted
				end 'use_deleted'
				return -(bestIndex + 1)
			end 'empty_slot'

			let isDeleted = match state 'sd1'
				Deleted gives true
				Empty gives false
				Occupied gives false
			end 'sd1'
			if isDeleted and firstDeleted < 0 'mark_deleted'
				firstDeleted = index
			end 'mark_deleted'

			let isOccupied = match state 'so1'
				Occupied gives true
				Empty gives false
				Deleted gives false
			end 'so1'
			if isOccupied 'check_key'
				// Skip the full key.equals() unless the cached hash matches — this
				// is the hot-path win for string-keyed maps.
				let slotHash = try hashes.get(index) otherwise hash
				if slotHash == hash 'hash_match'
					if let existing = try keys.get(index) 'get_existing'
						if existing == key 'found'
							return index
						end 'found'
					end 'get_existing'
				end 'hash_match'
			end 'check_key'

			// Linear probing
			index = (index + 1) and mask
			probes = probes + 1
		end 'probe'

		// All slots probed without finding key or empty slot
		if firstDeleted >= 0 'use_deleted_fallback'
			return -(firstDeleted + 1)
		end 'use_deleted_fallback'
		return -1
	end 'findSlot'

	// Internal: grow the table when load factor exceeds threshold
	function grow()
		let oldCapacity = capacity
		var newCapacity = oldCapacity * 2
		if newCapacity == 0 'handle_zero'
			newCapacity = 16
		end 'handle_zero'

		// Allocate new arrays with preallocated capacity
		var newKeys = KeyArray{}
		newKeys.resize(newCapacity)
		var newValues = ValueArray{}
		newValues.resize(newCapacity)
		var newStates = StateArray{}
		newStates.resize(newCapacity)
		var newHashes = HashSlotArray{}
		newHashes.resize(newCapacity)

		// Save old arrays for rehashing, then replace with new ones
		let oldKeys = keys
		let oldValues = values
		let oldStates = states
		let oldHashes = hashes
		keys = newKeys
		values = newValues
		states = newStates
		hashes = newHashes
		capacity = newCapacity
		count = 0

		// newCapacity is a power of two, so masking the SPREAD hash selects the low bits
		// (see `spreadHash`).
		let mask = newCapacity - 1

		// Rehash all occupied entries from old arrays. The new table is fresh
		// (no tombstones), so we can place each entry with a plain empty-slot
		// probe and reuse the cached hash instead of re-calling key.hash().
		for i in 0 upto oldCapacity 'rehash'
			let state = try oldStates.get(i) otherwise SlotState.Empty

			let isOccupied = match state 'so1'
				Occupied gives true
				Empty gives false
				Deleted gives false
			end 'so1'
			if isOccupied 'occupied'
				let key = try oldKeys.get(i) otherwise 'skip_key'
					continue
				end 'skip_key'
				let value = try oldValues.get(i) otherwise 'skip_val'
					continue
				end 'skip_val'
				let hash = try oldHashes.get(i) otherwise 'skip_hash'
					continue
				end 'skip_hash'

				var index = spreadHash(hash) and mask
				var currentState = try states.get(index) otherwise SlotState.Empty
				var isNotEmpty = match currentState 'ns1'
					Empty gives false
					Occupied gives true
					Deleted gives true
				end 'ns1'
				while isNotEmpty 'find_slot'
					index = (index + 1) and mask
					currentState = try states.get(index) otherwise SlotState.Empty
					isNotEmpty = match currentState 'ns2'
						Empty gives false
						Occupied gives true
						Deleted gives true
					end 'ns2'
				end 'find_slot'

				insertAtSlot(index, key: key, value: value, hash: hash)
			end 'occupied'
		end 'rehash'
	end 'grow'
end 'Map'

/// Iterator for Map — scans hash table slots for occupied entries.
/// Positioning invariant: iterIndex always points at an occupied slot (or ==
/// capacity after the final advance throws). current() reads that slot without
/// a state check.
export type MapIterator uses Key, Value implements Iterator with Entry where Key is Hashable and Equatable
	typealias Entry = (Key, Value)
	typealias IterKeyArray = Array with Key
	typealias IterValueArray = Array with Value
	typealias IterStateArray = Array with SlotState
	var keys as IterKeyArray
	var values as IterValueArray
	var states as IterStateArray
	var capacity as TableCapacity
	var iterIndex as TableSlotIndex

	export static function create(keys IterKeyArray, values IterValueArray, states IterStateArray, capacity TableCapacity) returns Self throws IterationError
		let first = try findNextOccupied(states, capacity: capacity, from: 0) otherwise throw IterationError.exhausted
		return Self{keys: keys, values: values, states: states, capacity: capacity, iterIndex: first}
	end 'create'

	export function current() returns Entry
		let k = try keys.get(iterIndex) otherwise panic("MapIterator.current: invariant violated — slot not populated")
		let v = try values.get(iterIndex) otherwise panic("MapIterator.current: invariant violated — slot not populated")
		return (k, v)
	end 'current'

	export function advance() throws IterationError
		iterIndex = try findNextOccupied(states, capacity: capacity, from: iterIndex + 1) otherwise throw IterationError.exhausted
	end 'advance'
end 'MapIterator'
