/// Build system configuration and utilities for customizing compilation.
/// @category Build
/// Build configuration type for customizing compilation
public type BuildConfig
	typealias StringArray = Array with String

	/// What SELECTS this build: `maxon build <name>` picks it out of a manifest describing several.
	/// ⚠ NOT the product name — `Build.build` sets it from the SOURCE PATH, so it is `.` for a project
	/// built from its own directory. A binary's product name is its own file name.
	public var name as String
	public var output as String
	public var sources as StringArray
	public var debug_info as bool

	/// Dotted product version stamped into the binary's own metadata — a Windows `VS_VERSIONINFO`
	/// resource, a Mach-O `LC_SOURCE_VERSION`. Empty means unversioned, which is what a program whose
	/// author has not said otherwise should claim.
	public var version as String

	/// `<name>=<value>` pairs, each replacing a top-level `String` constant's written-out default —
	/// the same thing `maxon build --define` does, said by the manifest instead of the command line.
	/// ⭐ THIS IS HOW A BUILD SUPPLIES A VERSION IT COMPUTED. A manifest is a PROGRAM, so it can derive
	/// one from git; a constant it wrote to a FILE could not be, because generating that file needs the
	/// compiler the file is needed to build.
	public var defines as StringArray

	/// The directory whose own `project.maxon` describes this build, for a manifest that hands the
	/// work to another one. Empty for an ordinary build, which states its own `sources`.
	public var directory as String

	/// Which of the delegated manifest's targets to build. Empty means its sole target.
	public var delegateTarget as String

	public static function create(name String, output String, sources StringArray, debug_info bool, version String = "", defines StringArray = StringArray.create(), directory String = "", delegateTarget String = "") returns BuildConfig
		return BuildConfig{name: name, output: output, sources: sources, debug_info: debug_info, version: version, defines: defines, directory: directory, delegateTarget: delegateTarget}
	end 'create'
end 'BuildConfig'

/// A list of named build targets, for `Build.buildTargets`.
public typealias BuildConfigArray = Array with BuildConfig

// The file a described build is written to, named by the driver before it runs a manifest. The
// compiler spells this name too (`Main.BuildDescriptionVariable`) and cannot share this constant:
// the two must agree, or every manifest describes nothing.
let BuildDescriptionVariable = "MAXON_BUILD_DESCRIPTION"

public type Build
	typealias StringArray = Array with String

	/// Build ONE source path to ONE output. The common shape, and the one that keeps a manifest to a
	/// single call: a caller naming a single directory should not have to build an array to say so,
	/// which in a manifest means declaring an `Array with String` typealias to hold it.
	/// source: the file or directory to compile. output: where the executable goes, extension omitted
	/// (the compiler appends `.exe` on Windows, `.wasm` on wasm32-wasi and nothing elsewhere). debugInfo:
	/// whether the build writes the `<output>.mxdbg` sidecar; `maxon build --no-debug-info` turns it off
	/// whatever this says.
	public static function build(source String, output String, debugInfo bool = true, version String = "", defines StringArray = StringArray.create())
		var sources = StringArray.create()
		sources.push(source)
		let config = BuildConfig.create(source, output: output, sources: sources, debug_info: debugInfo, version: version, defines: defines)
		Build.emitBuildConfig(config)
	end 'build'

	/// Custom build - full control via BuildConfig
	public static function buildWithConfig(config BuildConfig)
		Build.emitBuildConfig(config)
	end 'buildWithConfig'

	/// One NAMED target, for a manifest that describes more than one thing to build. The name is what
	/// `maxon build <name>` selects; with a single target the name is not needed and `maxon build`
	/// builds it, and with several `maxon build` lists them rather than guessing.
	/// source: the file or directory to compile. output: where the executable goes, extension omitted.
	/// debugInfo: as for `build`.
	public static function target(name String, source String, output String, debugInfo bool = true, version String = "", defines StringArray = StringArray.create()) returns BuildConfig
		var sources = StringArray.create()
		sources.push(source)
		return BuildConfig.create(name, output: output, sources: sources, debug_info: debugInfo, version: version, defines: defines)
	end 'target'

	/// One target whose description comes from ANOTHER directory's `project.maxon`. The compiler runs
	/// that manifest with the directory as its working directory and resolves the relative paths it
	/// states against it, so the delegated project builds the same way from either end.
	/// target: which of the delegated manifest's targets to build; empty means its sole one.
	public static function delegate(name String, directory String, target String = "")
		Build.emitBuildConfig(BuildConfig.create(name, output: "", sources: StringArray.create(), debug_info: true, directory: directory, delegateTarget: target))
	end 'delegate'

	/// One delegated target among several, for `Build.buildTargets`. Prints nothing.
	public static function delegateTarget(name String, directory String, target String = "") returns BuildConfig
		return BuildConfig.create(name, output: "", sources: StringArray.create(), debug_info: true, directory: directory, delegateTarget: target)
	end 'delegateTarget'

	/// Emit several named targets as a JSON array. One target is emitted as a bare object by the calls
	/// above, and the compiler accepts either shape.
	public static function buildTargets(targets BuildConfigArray)
		var text = "[\n"
		var i = 0
		let count = targets.count()

		for t in targets 'emitTargets'
			text.append(Build.renderBuildConfig(t))

			if i < count - 1 'targetComma'
				text.append(",\n")
			end 'targetComma' else 'lastTarget'
				text.append("\n")
			end 'lastTarget'

			i = i + 1
		end 'emitTargets'

		text.append("]\n")
		writeBuildDescription(text)
	end 'buildTargets'

	/// Emit one build configuration as JSON. Every string is JSON-escaped, so a `"` or a Windows `\`
	/// in a name or path reaches the compiler's JSON reader intact.
	public static function emitBuildConfig(config BuildConfig)
		writeBuildDescription("{Build.renderBuildConfig(config)}\n")
	end 'emitBuildConfig'

	static function renderBuildConfig(config BuildConfig) returns String
		var text = "\{\n"
		text.append("  \"name\": {Json.quote(config.name)},\n")
		text.append("  \"output\": {Json.quote(config.output)},\n")
		text.append("  \"directory\": {Json.quote(config.directory)},\n")
		text.append("  \"target\": {Json.quote(config.delegateTarget)},\n")
		text.append("  \"sources\": [{Build.renderStringList(config.sources)}],\n")
		text.append("  \"debug_info\": {"true" if config.debug_info else "false"},\n")
		text.append("  \"version\": {Json.quote(config.version)},\n")
		text.append("  \"defines\": [{Build.renderStringList(config.defines)}]\n")
		text.append("\}")
		return text
	end 'renderBuildConfig'

	static function renderStringList(items StringArray) returns String
		var text = ""
		var i = 0
		let count = items.count()

		for item in items 'eachItem'
			text.append(Json.quote(item))

			if i < count - 1 'itemComma'
				text.append(", ")
			end 'itemComma'

			i = i + 1
		end 'eachItem'

		return text
	end 'renderStringList'
end 'Build'

// With no variable set the description goes to stdout, which is how a manifest run directly can be
// inspected. wasm32-wasi always takes that road: reading the environment there needs a host
// facility that target has none of, and no manifest runs on it — a manifest runs on the host.
function writeBuildDescription(text String)
	#if os(Wasi)
		print(text)
	#else
		let destination = try Process.environmentVariable(BuildDescriptionVariable) otherwise 'noChannel'
			print(text)
			return
		end 'noChannel'

		if destination.isEmpty() 'noChannelNamed'
			print(text)
			return
		end 'noChannelNamed'

		let path = try FilePath.from(destination) otherwise panic("Build: {BuildDescriptionVariable} names '{destination}', which is not a path")

		try File.writeText(path, content: text) otherwise panic("Build: the described build could not be written to '{destination}'")
	#endif
end 'writeBuildDescription'
