/// Build system configuration and utilities for customizing compilation.
/// @category Build
/// Build configuration type for customizing compilation
public type BuildConfig
	typealias StringArray = Array with String

	public var output as String
	public var sources as StringArray
	public var debug_info as bool

	/// Dotted product version stamped into the binary's own metadata — a Windows `VS_VERSIONINFO`
	/// resource, a Mach-O `LC_SOURCE_VERSION`. Empty means unversioned, which is what a program whose
	/// author has not said otherwise should claim.
	public var version as String

	/// `<name>=<value>` pairs, each replacing a top-level `String` constant's written-out default —
	/// the same thing `maxon build --define` does, said by the manifest instead of the command line.
	/// ⭐ THIS IS HOW A BUILD SUPPLIES A VERSION IT COMPUTED. A manifest is a PROGRAM, so it can derive
	/// one from git; a constant it wrote to a FILE could not be, because generating that file needs the
	/// compiler the file is needed to build.
	public var defines as StringArray

	/// The directory whose own `.maxproj` file describes this build, for a build that hands the work
	/// to another project. Empty for an ordinary build, which states its own `sources`.
	public var directory as String

	/// Which of the delegated project's targets to build. Empty means its sole target.
	public var delegateTarget as String

	public static function create(sources StringArray, output String = "", debug_info bool = true, version String = "", defines StringArray = StringArray.create(), directory String = "", delegateTarget String = "") returns BuildConfig
		return BuildConfig{output: output, sources: sources, debug_info: debug_info, version: version, defines: defines, directory: directory, delegateTarget: delegateTarget}
	end 'create'
end 'BuildConfig'

// The file a described build is written to, named by the driver before it runs a manifest. The
// compiler spells this name too (`Main.BuildDescriptionVariable`) and cannot share this constant:
// the two must agree, or every manifest describes nothing.
let BuildDescriptionVariable = "MAXON_BUILD_DESCRIPTION"

let DescribedBuildSeparator = ",\n"

public type Build
	typealias StringArray = Array with String

	/// Build one source path. A target or task describes one build, so call this once per run. source:
	/// the file or directory to compile. output: where the executable goes, extension omitted (the
	/// compiler appends `.exe` on Windows, `.wasm` on wasm32-wasi and nothing elsewhere); empty means
	/// `.maxon/<name>`, `<name>` being the driver file's. debugInfo: whether the build writes the
	/// `<output>.mxdbg` sidecar; `maxon build --no-debug-info` turns it off whatever this says.
	public static function build(source String, output String = "", debugInfo bool = true, version String = "", defines StringArray = StringArray.create())
		var sources = StringArray.create()
		sources.push(source)
		Build.emitBuildConfig(BuildConfig.create(sources, output: output, debug_info: debugInfo, version: version, defines: defines))
	end 'build'

	/// Custom build - full control via BuildConfig
	public static function buildWithConfig(config BuildConfig)
		Build.emitBuildConfig(config)
	end 'buildWithConfig'

	/// Hand the build to another directory's `.maxproj` file. The compiler runs that file with the
	/// directory as its working directory and resolves the relative paths it states against it, so the
	/// delegated project builds the same way from either end. target: which of its targets to build,
	/// named as `maxon build` names one; empty means its sole target.
	public static function delegate(directory String, target String = "")
		Build.emitBuildConfig(BuildConfig.create(StringArray.create(), directory: directory, delegateTarget: target))
	end 'delegate'

	/// Emit one build configuration as JSON. Every string is JSON-escaped, so a `"` or a Windows `\`
	/// in a path reaches the compiler's JSON reader intact.
	public static function emitBuildConfig(config BuildConfig)
		writeBuildDescription("{Build.renderBuildConfig(config)}\n")
	end 'emitBuildConfig'

	static function renderBuildConfig(config BuildConfig) returns String
		var text = "\{\n"
		text.append("  \"output\": {Json.quote(config.output)},\n")
		text.append("  \"directory\": {Json.quote(config.directory)},\n")
		text.append("  \"target\": {Json.quote(config.delegateTarget)},\n")
		text.append("  \"sources\": [{Build.renderStringList(config.sources)}],\n")
		text.append("  \"debug_info\": {"true" if config.debug_info else "false"},\n")
		text.append("  \"version\": {Json.quote(config.version)},\n")
		text.append("  \"defines\": [{Build.renderStringList(config.defines)}]\n")
		text.append("\}")
		return text
	end 'renderBuildConfig'

	static function renderStringList(items StringArray) returns String
		var text = ""
		var i = 0
		let count = items.count()

		for item in items 'eachItem'
			text.append(Json.quote(item))

			if i < count - 1 'itemComma'
				text.append(", ")
			end 'itemComma'

			i = i + 1
		end 'eachItem'

		return text
	end 'renderStringList'
end 'Build'

// With no variable set the description goes to stdout, which is how a manifest run directly can be
// inspected. wasm32-wasi always takes that road: reading the environment there needs a host
// facility that target has none of, and no manifest runs on it — a manifest runs on the host.
function writeBuildDescription(text String)
	#if os(Wasi)
		print(text)
	#else
		let destination = try Process.environmentVariable(BuildDescriptionVariable) otherwise 'noChannel'
			print(text)
			return
		end 'noChannel'

		if destination.isEmpty() 'noChannelNamed'
			print(text)
			return
		end 'noChannelNamed'

		let path = try FilePath.from(destination) otherwise panic("Build: {BuildDescriptionVariable} names '{destination}', which is not a path")

		// Appended rather than overwritten, so a run that describes two builds reaches the compiler as
		// two and is refused, instead of building only the last.
		var described = text

		if File.exists(path) 'anotherBuild'
			let earlier = try File.readText(path) otherwise panic("Build: the builds already described could not be read back from '{destination}'")
			described = "{earlier}{DescribedBuildSeparator}{text}"
		end 'anotherBuild'

		try File.writeText(path, content: described) otherwise panic("Build: the described build could not be written to '{destination}'")
	#endif
end 'writeBuildDescription'
