/// Build system configuration and utilities for customizing compilation.
/// @category Build

/// Build configuration type for customizing compilation
public type BuildConfig
	typealias StringArray = Array with String

	/// What SELECTS this build: `maxon build <name>` picks it out of a manifest describing several.
	/// ⚠ NOT the product name — `Build.build` sets it from the SOURCE PATH, so it is `.` for a project
	/// built from its own directory. A binary's product name is its own file name.
	public var name as String
	public var output as String
	public var sources as StringArray
	public var optimize as bool
	public var debug_info as bool
	/// Dotted product version stamped into the binary's own metadata — a Windows `VS_VERSIONINFO`
	/// resource, a Mach-O `LC_SOURCE_VERSION`. Empty means unversioned, which is what a program whose
	/// author has not said otherwise should claim.
	public var version as String

	public static function create(name String, output String, sources StringArray, optimize bool, debug_info bool, version String = "") returns BuildConfig
		return BuildConfig{name: name, output: output, sources: sources, optimize: optimize, debug_info: debug_info, version: version}
	end 'create'
end 'BuildConfig'

/// A list of named build targets, for `Build.buildTargets`.
public typealias BuildConfigArray = Array with BuildConfig

public type Build
	typealias StringArray = Array with String

	/// Build ONE source path to ONE output. The common shape, and the one that keeps a manifest to a
	/// single call: a caller naming a single directory should not have to build an array to say so,
	/// which in a manifest means declaring an `Array with String` typealias to hold it.
	/// source: the file or directory to compile. output: where the executable goes, extension omitted
	/// (the compiler appends `.exe` on Windows and nothing elsewhere).
	public static function build(source String, output String, version String = "")
		var sources = StringArray.create()
		sources.push(source)
		let config = BuildConfig.create(source, output: output, sources: sources, optimize: false, debug_info: true, version: version)
		Build.emitBuildConfig(config)
	end 'build'

	/// Custom build - full control via BuildConfig
	public static function buildWithConfig(config BuildConfig)
		Build.emitBuildConfig(config)
	end 'buildWithConfig'

	/// One NAMED target, for a manifest that describes more than one thing to build. The name is what
	/// `maxon build <name>` selects; with a single target the name is not needed and `maxon build`
	/// builds it, and with several `maxon build` lists them rather than guessing.
	/// source: the file or directory to compile. output: where the executable goes, extension omitted.
	public static function target(name String, source String, output String, version String = "") returns BuildConfig
		var sources = StringArray.create()
		sources.push(source)
		return BuildConfig.create(name, output: output, sources: sources, optimize: false, debug_info: true, version: version)
	end 'target'

	/// Emit several named targets as a JSON array. One target is emitted as a bare object by the calls
	/// above, and the compiler accepts either shape.
	public static function buildTargets(targets BuildConfigArray)
		print("[")
		var i = 0
		let count = targets.count()
		for t in targets 'emit_targets'
			Build.emitBuildConfig(t)
			if i < count - 1 'target_comma'
				print(",")
			end 'target_comma'
			i = i + 1
		end 'emit_targets'
		print("]")
	end 'buildTargets'

	/// Emit build configuration as JSON to stdout
	public static function emitBuildConfig(config BuildConfig)
		print("\{")
		print("  \"name\": \"{config.name}\",")
		print("  \"output\": \"{config.output}\",")
		print("  \"sources\": [")

		var i = 0
		let count = config.sources.count()
		for src in config.sources 'emit_sources'
			if i < count - 1 'check_comma'
				print("    \"{src}\",")
			end 'check_comma' else 'no_comma'
				print("    \"{src}\"")
			end 'no_comma'
			i = i + 1
		end 'emit_sources'

		print("  ],")

		if config.optimize 'emit_optimize'
			print("  \"optimize\": true,")
		end 'emit_optimize' else 'emit_optimize_false'
			print("  \"optimize\": false,")
		end 'emit_optimize_false'

		if config.debug_info 'emit_debug'
			print("  \"debug_info\": true,")
		end 'emit_debug' else 'emit_debug_false'
			print("  \"debug_info\": false,")
		end 'emit_debug_false'

		print("  \"version\": \"{config.version}\"")

		print("\}")
	end 'emitBuildConfig'
end 'Build'
