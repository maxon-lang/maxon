/// Seeded hashing in the shape of Go's `hash/maphash`. Digests differ between seeds, hash tiers and
/// hosts, and `Hasher`'s between processes, so none is stored or compared across them; `Sha2` is the
/// stable digest.
/// @category Core
/// The result of a hash fold: 64 bits, every one carrying hash. `HashValue` is its low 32 bits.
public typealias HashDigest = bits(64)

let HashSeedBytes = 8

/// Why `HashSeed.fromBytes` refused its bytes.
public enum HashSeedError implements Error
	wrongByteCount
end 'HashSeedError'

/// The 64 bits a `KeyedHasher` fold starts from.
public type HashSeed
	let word as HashDigest
	let empty as HashDigest

	/// A fresh seed from the operating system's entropy.
	public static function random() returns HashSeed
		let bytes = try Random.bytes(HashSeedBytes) otherwise panic("HashSeed.random: the operating system refused to supply {HashSeedBytes} bytes of entropy")

		return try Self.fromBytes(bytes) otherwise panic("HashSeed.random: {HashSeedBytes} fresh bytes are a seed")
	end 'random'

	/// The seed as exactly 8 bytes, which `fromBytes` reads back as the same seed.
	public function toBytes() returns ByteArray
		let bytes = ByteArray.create(0)

		appendOrderedWord(bytes, word: self.word as OrderedWord, width: HashSeedBytes, order: ByteOrder.littleEndian)

		return bytes
	end 'toBytes'

	/// The seed 8 bytes spell; any other count throws `HashSeedError.wrongByteCount`.
	public static function fromBytes(bytes ByteArray) returns HashSeed throws HashSeedError
		if bytes.count() != HashSeedBytes 'wrongCount'
			throw HashSeedError.wrongByteCount
		end 'wrongCount'

		let word = readOrderedWord(bytes, off: 0, width: HashSeedBytes, limit: bytes.count(), order: ByteOrder.littleEndian) as HashDigest

		return Self{word: word, empty: __Builtins.hashBytes(b"", 0, 0, word)}
	end 'fromBytes'
end 'HashSeed'

function processFoldStart() returns HashDigest
	return __Builtins.hashSeed()
end 'processFoldStart'

/// The process fold `String`, `Character` and `Array` hash with, seeded once per process. A digest kept
/// or resumed is a `KeyedHasher` fold.
public type Hasher
	var state as HashDigest

	public static function create() returns Self
		return Self{state: processFoldStart()}
	end 'create'

	public function combine(value HashDigest)
		state = KeyedHasher.combined(state, value: value)
	end 'combine'

	public function combineBytes(bytes ByteArray)
		state = KeyedHasher.combinedBytes(state, bytes: bytes)
	end 'combineBytes'

	public function finalize() returns HashValue
		return hashValueOfDigest(state)
	end 'finalize'
end 'Hasher'

/// A running fold. Each step's state seeds the next, so `"ab"` then `"c"` and `"abc"` differ. The static
/// `empty`/`combined` pair is the same fold as expressions, for a place a mutable hasher cannot go.
public type KeyedHasher
	var state as HashDigest

	/// The state of a fold with nothing in it.
	public static function empty(seed HashSeed) returns HashDigest
		return seed.empty
	end 'empty'

	/// One step: `value` folded into `state`.
	public static function combined(state HashDigest, value HashDigest) returns HashDigest
		return __Builtins.hashWord(value, state)
	end 'combined'

	/// One step: `bytes` folded into `state`.
	public static function combinedBytes(state HashDigest, bytes ByteArray) returns HashDigest
		return __Builtins.hashBytes(bytes, 0, bytes.count(), state)
	end 'combinedBytes'

	/// A fold that starts from `seed`.
	public static function create(seed HashSeed) returns Self
		return Self{state: Self.empty(seed)}
	end 'create'

	/// Re-enter the fold at a state `finalize` returned.
	public static function resume(state HashDigest) returns Self
		return Self{state: state}
	end 'resume'

	public function combine(value HashDigest)
		state = Self.combined(state, value: value)
	end 'combine'

	public function combineBytes(bytes ByteArray)
		state = Self.combinedBytes(state, bytes: bytes)
	end 'combineBytes'

	/// The raw running state, so `resume(finalize())` continues the fold exactly.
	public function finalize() returns HashDigest
		return state
	end 'finalize'
end 'KeyedHasher'
