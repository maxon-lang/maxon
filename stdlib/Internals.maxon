	if count >= capacity 'full'
		// 134 = OS-direct capacity exceeded.
		__Internals.osExit(134)
	end 'full'

	let arrayBase = __Internals.loadIndirect(__Internals.slabOsDirectArrayAddr())
	let entryAddr = arrayBase + (count shl 4)
	__Internals.storeIndirect(entryAddr, value: ptr)
	__Internals.storeIndirect(entryAddr + 8, value: aligned)
	__Internals.storeIndirect(__Internals.slabOsDirectCountAddr(), value: count + 1)
	return ptr
end '__slab_os_direct_alloc'

// Smallest size-class index whose class size can hold `size` bytes. Single source
// of truth for the class scan shared by `__slab_alloc` (which then serves the slot)
// and `__slab_rounded_size` (which reports the rounded byte size). Caller must have
// already routed `size > SLAB_MAX_SMALL_ALLOC` to the OS-direct path — anything that
// reaches here fits the last class, so a fall-through is an invariant violation.
function __slab_class_index_for(size MachineWord) returns MachineWord
	var classIdx = 0
	for _ in 0 upto SLAB_NUM_SIZE_CLASSES 'classLoop'
		if __slab_class_size(classIdx) >= size 'fits'
			return classIdx
		end 'fits'
		classIdx = classIdx + 1
	end 'classLoop'
	// Unreachable (size <= SLAB_MAX_SMALL_ALLOC fits in the last class).
	__Internals.osExit(136)
	return 0
end '__slab_class_index_for'

// Public allocator entry point. Routes >SLAB_MAX_SMALL_ALLOC to the OS-direct path
// (under __slab_lock, mutating the shared OS-direct array); otherwise finds the
// smallest class >= size and serves it from the calling P's own mcache row
// (lockless fast path; refill takes __slab_lock).
function __slab_alloc(size MachineWord) returns MachineWord
	if size > SLAB_MAX_SMALL_ALLOC 'osPath'
		__Internals.osLockAcquire(__Internals.slabLockAddr())
		let osPtr = __slab_os_direct_alloc(size)
		__Internals.osLockRelease(__Internals.slabLockAddr())
		return osPtr
	end 'osPath'
	let classIdx = __slab_class_index_for(size)
	// A raw OS thread (id < 0) reaches the shared raw mcache shard. Two cases:
	//   (a) PRE-SCHEDULER main (no `async` yet → `__slab_proc_at(0) == 0`): the
	//       lone thread, so its pop is single-writer — lockless, no overhead on
	//       ordinary non-async programs.
	//   (b) a genuine raw thread WHILE a scheduler runs (subprocess sync worker
	//       / IOCP poller — main is then P[0], id 0): it shares the raw shard
	//       with the OTHER raw threads, so the pop is NOT single-writer.
	//       Serialize the whole class-alloc under __slab_lock; the inner refill
	//       re-acquires it, which is safe because __slab_lock is a recursive
	//       Windows CRITICAL_SECTION. `__gt_init` runs on main before any worker
	//       exists, so no raw thread ever takes the unlocked (a) path.
	// Real Ps (id >= 0) always keep the lockless fast path — each owns its shard.
	if __slab_current_p_id() < 0 and __slab_proc_at(0) != 0 'rawThreadLocked'
		__Internals.osLockAcquire(__Internals.slabLockAddr())
		let rawSlot = __slab_alloc_class(classIdx)
		__Internals.osLockRelease(__Internals.slabLockAddr())
		return rawSlot
	end 'rawThreadLocked'
	return __slab_alloc_class(classIdx)
end '__slab_alloc'

// Report the actual number of bytes `__slab_alloc(size)` would hand back — i.e.
// the size class it rounds `size` up to. `__slab_alloc` rounds every request to a
// class but discards the rounded size; the inline-small-array path needs it to
// reclaim the class slack as spare element capacity. Mirrors the two routing arms
// of `__slab_alloc` exactly: >SLAB_MAX_SMALL_ALLOC rounds up to a page (the
// OS-direct alignment in `__slab_os_direct_alloc`), otherwise the smallest class
// >= size. Pure sizing — no allocation, no locking.
function __slab_rounded_size(size MachineWord) returns MachineWord
	if size > SLAB_MAX_SMALL_ALLOC 'osPath'
		return (size + (SLAB_PAGE_SIZE - 1)) and -SLAB_PAGE_SIZE
	end 'osPath'
	return __slab_class_size(__slab_class_index_for(size))
end '__slab_rounded_size'

// Public free entry point. Recovers the owning mspan via __slab_arena_map_get
// (a lockless read of the immutable map). Routing:
//   * miss (span == 0): OS-direct pointer — free it under __slab_lock.
//   * same-P free (my raw id >= 0 AND == span.owning_p): lockless local push.
//   * cross-P free (different P, or a raw OS thread with no P): CAS-push onto
//     the OWNER P's remote-free queue.
//
// Refcount sanitizer (`--rc-sanitize`): the gate at the top intercepts mm-sized
// slab slots BEFORE the routing — they are poisoned and parked on the quarantine
// ring instead of returning to the slab, and re-enter here (via the bypass
// sentinel `__rc_quarantine_intercept` recognizes) only when they age out. The
// gate lives IN this body instead of wrapping it because runtime.std's
// `mm_realloc` calls `__slab_free` by name and runtime.std gets no inlining
// (mem2reg only) — a rename-plus-wrapper would survive as an extra call hop in
// default builds, breaking the sanitizer's byte-identical-when-off guarantee.
function __slab_free(ptr MachineWord)
	#if rcSanitize(true)
		if __rc_quarantine_intercept(ptr) 'quarantined'
			return
		end 'quarantined'
	#endif

	let span = __slab_arena_map_get(ptr)
	if span == 0 'osDirect'
		// OS-direct free mutates the shared OS-direct array — serialize it.
		__Internals.osLockAcquire(__Internals.slabLockAddr())
		__slab_os_direct_free(ptr)
		__Internals.osLockRelease(__Internals.slabLockAddr())
		return
	end 'osDirect'

	let owningP = __Internals.loadIndirect(span + 0x40)
	let myId = __slab_current_p_id()

	// RAW-OWNED span (owning_p < 0): the span lives in the shared raw mcache shard,
	// whose alloc side is serialized under __slab_lock once a scheduler runs (see
	// __slab_alloc). Once a scheduler is up (`__slab_proc_at(0) != 0`), ANY free of
	// such a slot — by the owning raw thread, another raw thread, or a real P that
	// received the slot through cross-thread data sharing — MUST take the same lock,
	// or it races the raw thread's allocation pop / another raw free. (The
	// `owningP == myId` raw==raw==-1 case and the real-P `__slab_proc_at(<0)==0`
	// fallback-local case both reach an UNLOCKED push otherwise.) The recursive
	// CRITICAL_SECTION makes the inner mcentral-return re-acquire safe. Before the
	// scheduler exists the lone main thread is the only writer → lockless.
	if owningP < 0 and __slab_proc_at(0) != 0 'rawOwnedLocked'
		__Internals.osLockAcquire(__Internals.slabLockAddr())
		__slab_free_class_with_mspan(ptr, mspan: span)
		__Internals.osLockRelease(__Internals.slabLockAddr())
		return
	end 'rawOwnedLocked'

	// Same-P free requires my_id >= 0 AND my_id == owning_p. A raw OS thread
	// (my_id == -1) never matches owning_p (>= 0), so it always routes remote.
	if owningP == myId 'localPath'
		// Single-writer push onto our own span's free list (lockless unless this
		// free fully empties the span, escalating to a locked mcentral return).
		__slab_free_class_with_mspan(ptr, mspan: span)
		return
	end 'localPath'

	// Defensive: a genuine cross-P free (real P, owning_p != my_id) must never
	// observe the 0xFFFFFFFF sentinel — the owning P drains every in-flight
	// remote free for a span before its free_count can reach total_slots. A
	// raw-OS-thread free (my_id < 0) skips this check (its id never equals the
	// sentinel anyway), exactly as the bootstrap's LoadCurrentP==NULL path does.
	if myId >= 0 'realP'
		if owningP == MSPAN_OWNING_P_PARKED 'sentinel'
			panic("__slab_free: cross-P free hit owning_p sentinel; span already returned to mcentral (Mimalloc invariant violation)")
		end 'sentinel'
	end 'realP'

	// Remote path: target_p = __sched_procs[owning_p]; CAS-push onto its queue.
	let targetP = __slab_proc_at(owningP)
	if targetP == 0 'fallbackLocal'
		// Defensive: a NULL target (no live P for owning_p) would drop the free.
		// Fall back to the local push so the slot is never lost; with no live
		// scheduler there is no contending writer, so the direct push is safe.
		__slab_free_class_with_mspan(ptr, mspan: span)
		return
	end 'fallbackLocal'
	__slab_remote_free_push(targetP, slot: ptr)
end '__slab_free'

// =============================================================================
// Refcount sanitizer (`--rc-sanitize`) — poison, quarantine, touch checks.
//
// An OVER-RELEASE (a refcount-inserter bug) frees an object while another live
// reference to it still exists; the process then crashes much LATER, when the
// reused slab slot's new occupant is corrupted through the dangling reference.
// That distance between bug and crash is what makes over-releases expensive to
// diagnose. With the sanitizer on, a freed slot is POISONED and QUARANTINED
// (its slab slot is not reused until it ages out of a FIFO ring), and every mm
// entry point checks for the poison first — so the FIRST touch of a freed
// object panics immediately, reporting the object address, the SYMBOLIZED
// five-frame free-site chain (captured into the quarantine ring entry at free
// time), and the touch site's own symbolized backtrace.
//
// Zero cost when off: everything here (and every check at the mm entry points)
// sits inside `#if rcSanitize(true)` conditional-compilation regions, so a
// default build PARSES NONE OF IT — no value ids, no IR, no blocks, nothing for
// downstream passes to even fold. A default build's output is byte-identical to
// one where this code does not exist. (A runtime-constant `if` gate was tried
// first and rejected: the const-fold left an empty-block seam and shifted value
// ids, which perturbed emitted bytes.)
// =============================================================================
#if rcSanitize(true)

	// Poison words written into a quarantined slot's mm-header field positions.
	// Impossible as real header values: a refcount is a small non-negative integer
	// (the decref underflow trap keeps it from ever going negative), a destructor
	// is a code pointer, and a size is a small positive byte count. The shared
	// `0x5AFEDEAD` high word identifies the sanitizer in a hex dump; the low word
	// names WHICH header field was read. Plain literals — top-level `let` accepts
	// only a literal, not an expression; all stay positive i64.
	let RC_SANITIZE_POISON_DTOR = 0x5AFEDEAD00000001
	let RC_SANITIZE_POISON_SIZE = 0x5AFEDEAD00000002
	let RC_SANITIZE_POISON_RC = 0x5AFEDEAD00000003

	// Bypass sentinel: `__rc_quarantine_release` stamps this into an aged-out
	// slot's refcount word so its re-entry into `__slab_free` falls through the
	// quarantine intercept to the real routing. Only ever written by the release
	// path, which owns the slot exclusively. (A raw non-mm slot whose freed
	// payload happens to equal this word would skip quarantine — a one-in-2^63
	// coverage miss, never a correctness problem.)
	let RC_SANITIZE_BYPASS = 0x5AFEDEAD0000000F

	// PAYLOAD poison, filled word-by-word over a quarantined slot's user region.
	// The header magics catch refcount-op touches of a freed object, but a plain
	// FIELD READ through a dangling reference never consults the header — with
	// the payload intact it silently returns the stale (still-correct-looking)
	// value, hiding the use-after-free behind correct-by-luck behavior (bug #10's
	// spurious E3071 came from exactly such a read). A poisoned payload makes
	// every stale read yield this recognizable pattern instead: dereferencing it
	// faults at a 0x5AFEDEAD-prefixed address (instantly attributable in the
	// fault report's rip/addr), and comparisons/logic on it go loudly wrong.
	let RC_SANITIZE_POISON_PAYLOAD = 0x5AFEDEAD00000011

	// Touch kinds for `__rc_report_freed_touch` — which mm entry point observed
	// the poisoned header.
	let RC_TOUCH_INCREF = 1
	let RC_TOUCH_DECREF = 2
	let RC_TOUCH_DROP = 3
	let RC_TOUCH_MM_FREE = 4
	let RC_TOUCH_SLAB_FREE = 5

	// Quarantine geometry. Only slots big enough to carry a full 32-byte mm header
	// are quarantined — poisoning the four header-word positions of a smaller RAW
	// slot would write past the slot into its live neighbor. Every mm allocation
	// is 32 (header) + >=1 user byte, so all mm objects — the sanitizer's target —
	// are covered; sub-32-byte raw slots and OS-direct blocks (whose pages are
	// unmapped on free, so poison could not persist) pass straight through. The
	// capacity and byte caps bound the quarantine's memory hold; slab slot sizes
	// are <= SLAB_MAX_SMALL_ALLOC, so a single entry can never exceed the byte cap.
	let RC_QUARANTINE_MIN_SLOT_SIZE = 32
	let RC_QUARANTINE_CAPACITY = 1048576
	let RC_QUARANTINE_BYTE_CAP = 536870912

	// Ring entry layout (96 bytes: 16-byte header + RC_QENTRY_RA_COUNT
	// return-address words at RC_QENTRY_RA_CHAIN, padded to a round size). The
	// free-site return-address CHAIN lives in the entry — NOT in the quarantined
	// slot — so every slot size gets full attribution and the slot's
	// header/payload carry only the poison. The freed-touch report finds the
	// entry by scanning the ring for its slotBase (O(live entries), fine on the
	// panic path).
	let RC_QUARANTINE_ENTRY_SIZE = 96
	let RC_QENTRY_SLOT_BASE = 0
	let RC_QENTRY_SLOT_SIZE = 8
	let RC_QENTRY_RA_CHAIN = 16
	let RC_QENTRY_RA_COUNT = 9

	// Field offsets of the `__mm_rc_quarantine_ctl` data-section global (layout doc
	// at its registration in LowerMaxonToStd.registerSlabAndMmGlobalsForDataSection).
	let RC_QCTL_RING_BASE = 0
	let RC_QCTL_HEAD = 8
	let RC_QCTL_TAIL = 16
	let RC_QCTL_COUNT = 24
	let RC_QCTL_BYTE_TOTAL = 32
	let RC_QCTL_CAPACITY = 40

	// =========================================================================
	// Refcount LEDGER — per-object refcount-op HISTORY ring.
	//
	// The quarantine machinery above localizes a use-AFTER-free (it catches the
	// first touch of a poisoned object). The LEDGER localizes the OVER-RELEASE
	// itself: for every managed object it records a small ring of the last N
	// refcount ops as (KIND, resulting-refcount) pairs, so when a decref drives
	// the refcount below zero the whole imbalanced sequence is visible end to end
	// (created rc0 -> storeIncrefNew rc1 -> fieldOverwriteDecrefOld rc0 ->
	// byRefParamDecrefOld rc-1 OVER-RELEASE). Each op's KIND names WHY the compiler
	// emitted it (see `__rc_kind_name` and the mirrored `RcOpKind` enum in
	// maxon-selfhosted/Compiler/IR/Std/ReleaseEmit.maxon — the raw values MUST
	// stay in lockstep with that enum).
	//
	// STORAGE. Each object's ring lives in a fixed-size BLOCK, and the block's
	// address is stashed in the object's otherwise-unused reserved header word at
	// `slot_base + 0` (== `user_ptr - 32`). Nothing else ever reads that word (the
	// destructor / size / refcount live at `user_ptr - 24/-16/-8`; the COW/inline
	// paths never touch `-32`), and `__mm_alloc` overwrites it on EVERY allocation
	// (to the block pointer under the sanitizer, to 0 otherwise), so the recording
	// path never observes stale garbage there — no magic/disambiguation needed.
	// Blocks come from a raw-OS-page bump arena (never the slab it instruments) and
	// are RECYCLED onto a lock-free freelist when the object's slot ages out of the
	// quarantine (its true free), so the arena is bounded by peak-in-flight objects.
	// All of it is `#if rcSanitize(true)`-gated: a default build allocates no arena,
	// stores 0 in the reserved word exactly as before, and is byte-identical.
	//
	// Block layout (RC_LEDGER_BLOCK_SIZE bytes):
	//   +0  freelist-next (only meaningful while the block sits on the freelist)
	//   +8  head          (ring write index, 0..RC_LEDGER_RING_ENTRIES-1)
	//   +16 count         (total ops recorded; the dump shows the last N)
	//   +24 entries[N]    each RC_LEDGER_ENTRY_SIZE bytes: +0 kind, +8 rc-after, +16 caller-ra
	let RC_LEDGER_RING_ENTRIES = 12
	let RC_LEDGER_ENTRY_SIZE = 24
	let RC_LEDGER_OFF_NEXT = 0
	let RC_LEDGER_OFF_HEAD = 8
	let RC_LEDGER_OFF_COUNT = 16
	let RC_LEDGER_OFF_ENTRIES = 24
	// 24 header bytes + 12 entries * 24 bytes = 312. Kept a literal (top-level
	// `let` takes only a literal); update alongside the three sizes above.
	let RC_LEDGER_BLOCK_SIZE = 312
	// 2 GiB bump arena for ring blocks (~6.9M blocks — a full self-compile keeps
	// millions of objects in flight). Blocks are recycled onto the freelist at
	// slot age-out, so live usage tracks peak-in-flight objects, not total
	// allocations; the arena is the hard ceiling before graceful degradation
	// (exhaustion => new objects get no ring, existing rings persist). The arena
	// is lazily OS-allocated on first use, so a sanitized run that never records
	// a ledger op pays nothing.
	let RC_LEDGER_ARENA_BYTES = 2147483648

	// Field offsets of the `__mm_rc_ledger_ctl` data-section global (registered in
	// LowerMaxonToStd.registerSlabAndMmGlobalsForDataSection alongside the
	// quarantine ctl). Three i64 words:
	//   +0 arena_next (bump cursor; 0 until the arena is lazily OS-allocated)
	//   +8 arena_end  (exclusive upper bound of the arena)
	//   +16 freelist  (lock-free Treiber-stack head of recycled blocks; 0 = empty)
	let RC_LCTL_ARENA_NEXT = 0
	let RC_LCTL_ARENA_END = 8
	let RC_LCTL_FREELIST = 16

	// Over-release backtrace geometry. The leading frames from
	// `__rc_print_backtrace_skipping` are the tagged-decref / report plumbing
	// (`__rc_report_over_release` <- `__mm_decref_tagged` <- possibly
	// `__mm_decref_maybenull_tagged`); skip them so the first printed frame is the
	// Maxon code that issued the imbalanced decref. Tuned conservatively — a
	// slightly-off skip still shows the culprit within the printed window, and the
	// trailing `panic` re-prints the full symbolized site backtrace as a backstop.
	let RC_OVER_RELEASE_SKIP_FRAMES = 2
	let RC_OVER_RELEASE_MAX_FRAMES = 12

	// RcOpKind raw values — MIRROR of `RcOpKind` in ReleaseEmit.maxon. `created`
	// is recorded by `__mm_alloc`; every other value is threaded from a compiler
	// refcount-op emission site into the tagged `__mm_*_tagged` runtime entry.
	let RC_KIND_UNSPECIFIED = 0
	let RC_KIND_CREATED = 1
	let RC_KIND_STORE_INCREF_NEW = 2
	let RC_KIND_FIELD_TRANSFER_INCREF = 3
	let RC_KIND_MODULE_GLOBAL_INCREF = 4
	let RC_KIND_ACQUIRE_AT_DEF = 5
	let RC_KIND_RETAIN_FOR_RETURN = 6
	let RC_KIND_BORROWED_ELEMENT_RETAIN = 7
	let RC_KIND_CONSUMED_ARG_COPY_RETAIN = 8
	let RC_KIND_TRANSPARENT_WRAP_RETAIN = 9
	let RC_KIND_RETURNED_BORROW_RETAIN = 10
	let RC_KIND_ADDRESS_TAKEN_SLOT_RETAIN = 11
	let RC_KIND_PHI_EDGE_INCREF = 12
	let RC_KIND_FIELD_OVERWRITE_DECREF_OLD = 13
	let RC_KIND_BY_REF_PARAM_DECREF_OLD = 14
	let RC_KIND_LAST_USE_DECREF = 15
	let RC_KIND_LAST_USE_EDGE_DECREF = 16
	let RC_KIND_TERMINATOR_DECREF = 17
	let RC_KIND_DEAD_DEF_DROP = 18
	let RC_KIND_DEAD_BLOCK_PARAM_DROP = 19
	let RC_KIND_ADDRESS_TAKEN_SLOT_DROP = 20
	let RC_KIND_ADDRESS_TAKEN_SLOT_OVERWRITE_DROP = 21
	let RC_KIND_BORROW_ROOT_EDGE_DROP = 22
	let RC_KIND_DESTRUCTOR_FIELD_DROP = 23

	// The `__slab_free` sanitizer gate: decide whether `slotBase` is quarantined.
	// Returns true when the slot was parked on the ring (the caller must NOT free
	// it); false when the free should proceed normally (pass-through cases and the
	// release path's bypass re-entry).
	function __rc_quarantine_intercept(slotBase MachineWord) returns bool
		let span = __slab_arena_map_get(slotBase)
		if span == 0 'osDirect'
			return false
		end 'osDirect'

		let slotSize = __Internals.loadIndirect(span + 0x08)
		if slotSize < RC_QUARANTINE_MIN_SLOT_SIZE 'tooSmall'
			return false
		end 'tooSmall'

		let rcWord = __Internals.loadIndirect(slotBase + 24)
		if rcWord == RC_SANITIZE_BYPASS 'agedOut'
			// `__rc_quarantine_release` re-entering after age-out: clear the
			// sentinel (the reserved-word / clean-header contract) and let the
			// real routing free the slot.
			__Internals.storeIndirect(slotBase + 24, value: 0)
			return false
		end 'agedOut'

		if rcWord == RC_SANITIZE_POISON_RC 'doubleFree'
			// The slot is already quarantined — this is a second free of the same
			// allocation with no intervening reuse: a genuine double-free.
			__rc_report_freed_touch(slotBase + 32, kind: RC_TOUCH_SLAB_FREE)
		end 'doubleFree'

		__rc_quarantine_push(slotBase, slotSize: slotSize)
		return true
	end '__rc_quarantine_intercept'

	// Poison `slotBase`'s header-word positions and enqueue it on the quarantine
	// ring, evicting (really freeing) the oldest entries first when the ring is
	// full or the byte cap would be exceeded. The ring is shared across Ps, so the
	// push runs under __slab_lock; each eviction RELEASES the lock before touching
	// the evictee — `__slab_free` may itself take the lock (os-direct / raw-owned
	// routing), and the write-to-freed panic must never fire while holding it.
	function __rc_quarantine_push(slotBase MachineWord, slotSize MachineWord)
		let ctl = __Internals.rcQuarantineCtlAddr()
		__Internals.osLockAcquire(__Internals.slabLockAddr())

		// Lazily allocate the ring on the first quarantined free. Raw OS pages
		// rather than a slab/os-direct allocation: the ring must never itself
		// route back through the allocator paths it interposes on, and it is
		// never freed.
		if __Internals.loadIndirect(ctl + RC_QCTL_RING_BASE) == 0 'lazyRing'
			let ring = __slab_assert_os_alloc(__Internals.osAllocPages(RC_QUARANTINE_CAPACITY * RC_QUARANTINE_ENTRY_SIZE))
			__Internals.storeIndirect(ctl + RC_QCTL_RING_BASE, value: ring)
			__Internals.storeIndirect(ctl + RC_QCTL_CAPACITY, value: RC_QUARANTINE_CAPACITY)
		end 'lazyRing'

		// Evict the oldest entries until this one fits — in entry count AND in
		// quarantined bytes. Each eviction drops the lock (see function comment);
		// the loop re-reads the control block after re-acquiring because another P
		// may have pushed or evicted in the gap.
		while __rc_quarantine_needs_evict(ctl, incomingBytes: slotSize) 'evict'
			let ringBase = __Internals.loadIndirect(ctl + RC_QCTL_RING_BASE)
			let capacity = __Internals.loadIndirect(ctl + RC_QCTL_CAPACITY)
			let head = __Internals.loadIndirect(ctl + RC_QCTL_HEAD)
			let entry = ringBase + head * RC_QUARANTINE_ENTRY_SIZE
			let evictSlot = __Internals.loadIndirect(entry + RC_QENTRY_SLOT_BASE)
			let evictSize = __Internals.loadIndirect(entry + RC_QENTRY_SLOT_SIZE)

			var nextHead = head + 1
			if nextHead == capacity 'wrapHead'
				nextHead = 0
			end 'wrapHead'
			__Internals.storeIndirect(ctl + RC_QCTL_HEAD, value: nextHead)
			__Internals.storeIndirect(ctl + RC_QCTL_COUNT, value: __Internals.loadIndirect(ctl + RC_QCTL_COUNT) - 1)
			__Internals.storeIndirect(ctl + RC_QCTL_BYTE_TOTAL, value: __Internals.loadIndirect(ctl + RC_QCTL_BYTE_TOTAL) - evictSize)

			__Internals.osLockRelease(__Internals.slabLockAddr())
			__rc_quarantine_release(evictSlot, slotSize: evictSize)
			__Internals.osLockAcquire(__Internals.slabLockAddr())
		end 'evict'

		// Poison the header-word positions. The free-site chain goes into the
		// RING ENTRY, not the slot — the slot keeps only the poison, and the
		// report finds the chain by scanning the ring for this slotBase.
		__Internals.storeIndirect(slotBase + 8, value: RC_SANITIZE_POISON_DTOR)
		__Internals.storeIndirect(slotBase + 16, value: RC_SANITIZE_POISON_SIZE)
		__Internals.storeIndirect(slotBase + 24, value: RC_SANITIZE_POISON_RC)

		// Poison the PAYLOAD too (see RC_SANITIZE_POISON_PAYLOAD): stale field
		// reads through dangling references must yield the pattern, not the
		// intact old value. Word-stepped; slab slot sizes are 8-aligned.
		var payloadPos = slotBase + 32

		while payloadPos + 8 <= slotBase + slotSize 'poisonPayload'
			__Internals.storeIndirect(payloadPos, value: RC_SANITIZE_POISON_PAYLOAD)
			payloadPos = payloadPos + 8
		end 'poisonPayload'

		let ringBase = __Internals.loadIndirect(ctl + RC_QCTL_RING_BASE)
		let capacity = __Internals.loadIndirect(ctl + RC_QCTL_CAPACITY)
		let tail = __Internals.loadIndirect(ctl + RC_QCTL_TAIL)
		let entry = ringBase + tail * RC_QUARANTINE_ENTRY_SIZE
		__Internals.storeIndirect(entry + RC_QENTRY_SLOT_BASE, value: slotBase)
		__Internals.storeIndirect(entry + RC_QENTRY_SLOT_SIZE, value: slotSize)

		// Free-site attribution: a return-address CHAIN captured by walking the
		// frame-pointer links ([fp] = caller's fp, [fp+8] = return address — the
		// same walk mrt_panic does on x64/arm64; the chain root is 0). One frame
		// is not enough: this helper and its callers (__rc_quarantine_intercept
		// ← __slab_free ← __mm_free ← the releasing decref/drop) are real
		// out-of-line functions, so the first return addresses name the
		// sanitizer's own plumbing and only the deeper entries reach the code
		// that actually released the object. Ring entries are recycled, so every
		// RA slot is written — 0 past the chain root. wasm has no frame-pointer
		// chain (loadFramePtr yields 0): all entries stash 0 and the report
		// degrades gracefully.
		var fp = __Internals.loadFramePtr()
		var raIdx = 0

		while raIdx < RC_QENTRY_RA_COUNT 'captureChain'
			var ra = 0

			if fp != 0 'liveFrame'
				ra = __Internals.loadIndirect(fp + 8)
				fp = __Internals.loadIndirect(fp)
			end 'liveFrame'

			__Internals.storeIndirect(entry + RC_QENTRY_RA_CHAIN + raIdx * 8, value: ra)
			raIdx = raIdx + 1
		end 'captureChain'

		var nextTail = tail + 1
		if nextTail == capacity 'wrapTail'
			nextTail = 0
		end 'wrapTail'
		__Internals.storeIndirect(ctl + RC_QCTL_TAIL, value: nextTail)
		__Internals.storeIndirect(ctl + RC_QCTL_COUNT, value: __Internals.loadIndirect(ctl + RC_QCTL_COUNT) + 1)
		__Internals.storeIndirect(ctl + RC_QCTL_BYTE_TOTAL, value: __Internals.loadIndirect(ctl + RC_QCTL_BYTE_TOTAL) + slotSize)

		__Internals.osLockRelease(__Internals.slabLockAddr())
	end '__rc_quarantine_push'

	// True when the ring cannot accept another entry of `incomingBytes` without
	// first evicting: no free ring slot, or the byte cap would be exceeded. The
	// count>0 guard makes an incoming slot larger than the whole byte cap (cannot
	// happen — slab slots are bounded by SLAB_MAX_SMALL_ALLOC — but cheap to make
	// impossible) terminate instead of evicting forever. Caller holds __slab_lock.
	function __rc_quarantine_needs_evict(ctl MachineWord, incomingBytes MachineWord) returns bool
		let count = __Internals.loadIndirect(ctl + RC_QCTL_COUNT)
		if count == 0 'empty'
			return false
		end 'empty'

		if count >= __Internals.loadIndirect(ctl + RC_QCTL_CAPACITY) 'full'
			return true
		end 'full'

		return __Internals.loadIndirect(ctl + RC_QCTL_BYTE_TOTAL) + incomingBytes > RC_QUARANTINE_BYTE_CAP
	end '__rc_quarantine_needs_evict'

	// Age-out of a quarantined slot: verify its poison survived the quarantine
	// stay (a mismatch means something WROTE through a dangling reference after
	// the free — report that rather than silently freeing corrupted state), clear
	// the poison so stale magics don't linger to confuse a later diagnosis,
	// stamp the bypass sentinel, and re-enter `__slab_free` for the real
	// routing. Runs with __slab_lock NOT held: the real free may take it, and
	// panicking while holding it would wedge the panic path's own allocations.
	function __rc_quarantine_release(slotBase MachineWord, slotSize MachineWord)
		let dtorWord = __Internals.loadIndirect(slotBase + 8)
		let sizeWord = __Internals.loadIndirect(slotBase + 16)
		let rcWord = __Internals.loadIndirect(slotBase + 24)

		if dtorWord != RC_SANITIZE_POISON_DTOR or sizeWord != RC_SANITIZE_POISON_SIZE or rcWord != RC_SANITIZE_POISON_RC 'tampered'
			panic("rc-sanitize: write to freed memory detected — quarantined slot 0x{slotBase:016x} (size {slotSize}) was modified after free (dtor=0x{dtorWord:016x} size=0x{sizeWord:016x} rc=0x{rcWord:016x})")
		end 'tampered'

		// The payload was pattern-filled at quarantine time; a changed first
		// payload word means something WROTE through a dangling reference while
		// the slot sat quarantined. One word is a cheap tripwire — full-payload
		// verification would just re-walk what the poison loop wrote.
		if slotSize >= 40 'hasPayloadWord'
			let payloadWord = __Internals.loadIndirect(slotBase + 32)

			if payloadWord != RC_SANITIZE_POISON_PAYLOAD 'payloadTampered'
				panic("rc-sanitize: write to freed memory detected — quarantined slot 0x{slotBase:016x} (size {slotSize}) payload was modified after free (first word=0x{payloadWord:016x})")
			end 'payloadTampered'
		end 'hasPayloadWord'

		// The slot is now truly freed: recycle its ledger ring block (stashed in
		// the reserved word) onto the freelist before the slab reclaims the slot.
		// The reserved word is never poisoned, so it still holds the block here.
		let ledgerBlock = __Internals.loadIndirect(slotBase + 0)
		if ledgerBlock != 0 'recycleLedger'
			__rc_ledger_free_block(ledgerBlock)
			__Internals.storeIndirect(slotBase + 0, value: 0)
		end 'recycleLedger'

		__Internals.storeIndirect(slotBase + 8, value: 0)
		__Internals.storeIndirect(slotBase + 16, value: 0)
		__Internals.storeIndirect(slotBase + 24, value: RC_SANITIZE_BYPASS)
		__slab_free(slotBase)
	end '__rc_quarantine_release'

	// The shared touch check the mm entry points run first: a poisoned refcount
	// word means `ptr` was already freed and quarantined — report instead of
	// touching it. One helper so the check reads identically at every entry point
	// (`__mm_drop` inlines its own comparison instead: it has already loaded the
	// refcount word for its rc==0 branch, and re-loading here would double the
	// header read on its hot path).
	function __rc_check_freed_touch(ptr MachineWord, kind MachineWord)
		if __Internals.loadIndirect(ptr - 8) == RC_SANITIZE_POISON_RC 'freedTouch'
			__rc_report_freed_touch(ptr, kind: kind)
		end 'freedTouch'
	end '__rc_check_freed_touch'

	// Print one free-site frame, symbolized in-process: return addresses inside
	// .text go through the same `mrt_panic_print_frame` lookup mrt_panic uses
	// for the touch backtrace ("  in <fn>"); anything else (0 from a truncated
	// walk, a non-text address from a corrupted frame chain) prints raw so the
	// chain's shape stays visible.
	function __rc_print_free_frame(ra MachineWord)
		if ra == 0 'noFrame'
			return
		end 'noFrame'

		let textBase = __Internals.mrtStartAddr()
		let textOffset = ra - textBase
		let textSize = __Internals.symtableAddr() - textBase

		if textOffset >= 0 and textOffset < textSize 'inText'
			__Internals.panicPrintFrame(textOffset, symtable: __Internals.symtableAddr())
			return
		end 'inText'

		printError("  at 0x{ra:016x} (outside .text)\n")
	end '__rc_print_free_frame'

	// A poisoned header was touched. `userPtr` is the freed object's user pointer;
	// `kind` names the mm entry point that observed it. The free-site return-
	// address chain lives in the object's quarantine RING ENTRY (found by
	// scanning the ring for the slot base — a poisoned header implies the slot
	// is still quarantined, so the entry exists); each frame is symbolized
	// in-process and printed to stderr, then the panic supplies the symbolized
	// backtrace of the TOUCH site. The chain's leading frames name the
	// sanitizer/mm plumbing (__rc_quarantine_intercept ← __slab_free ←
	// __mm_free …); the deeper frames name the code that released the object.
	// Reads nothing from the object itself beyond its header words — the
	// payload may be arbitrarily stale.
	// `rcOpKind` (RcOpKind raw value, RC_KIND_UNSPECIFIED when unknown) names the
	// COMPILER emission reason for a tagged incref/decref/drop that touched the
	// freed object — the same localization the live over-release report gives, but
	// for the touch-after-free manifestation (the object was already freed and
	// quarantined when the imbalanced op ran). Untagged callers pass the default.
	function __rc_report_freed_touch(userPtr MachineWord, kind MachineWord, rcOpKind MachineWord = RC_KIND_UNSPECIFIED)
		let slotBase = userPtr - 32

		var what = ""
		if kind == RC_TOUCH_INCREF 'increfKind'
			what = "INCREF of freed object"
		end 'increfKind' else if kind == RC_TOUCH_DECREF 'decrefKind'
			what = "DECREF of freed object (over-release pair)"
		end 'decrefKind' else if kind == RC_TOUCH_DROP 'dropKind'
			what = "DROP of freed object"
		end 'dropKind' else if kind == RC_TOUCH_MM_FREE 'freeKind'
			what = "DOUBLE __mm_free of object"
		end 'freeKind' else if kind == RC_TOUCH_SLAB_FREE 'slabFreeKind'
			what = "double slab-free of object"
		end 'slabFreeKind' else 'unknownKind'
			what = "freed-object touch with unknown kind {kind} on object"
		end 'unknownKind'

		printError("rc-sanitize: {what} 0x{userPtr:016x}\n")
		if rcOpKind != RC_KIND_UNSPECIFIED 'namedKind'
			printError("  imbalanced op KIND: {__rc_kind_name(rcOpKind)}\n")
		end 'namedKind'

		// Locate the quarantine entry. The scan walks the live window
		// (head..head+count) without the lock — this is the panic path, and a
		// racing push cannot move OUR entry (the object is quarantined until
		// evicted, and an eviction that raced us would have cleared the poison
		// before we saw it).
		let ctl = __Internals.rcQuarantineCtlAddr()
		let ringBase = __Internals.loadIndirect(ctl + RC_QCTL_RING_BASE)
		let capacity = __Internals.loadIndirect(ctl + RC_QCTL_CAPACITY)
		let count = __Internals.loadIndirect(ctl + RC_QCTL_COUNT)
		var idx = __Internals.loadIndirect(ctl + RC_QCTL_HEAD)
		var remaining = count
		var found = 0

		while remaining > 0 'scan'
			let entry = ringBase + idx * RC_QUARANTINE_ENTRY_SIZE

			if __Internals.loadIndirect(entry + RC_QENTRY_SLOT_BASE) == slotBase 'hit'
				printError("freed by (innermost first, leading frames are mm/sanitizer plumbing):\n")
				var raIdx = 0

				while raIdx < RC_QENTRY_RA_COUNT 'chain'
					__rc_print_free_frame(__Internals.loadIndirect(entry + RC_QENTRY_RA_CHAIN + raIdx * 8))
					raIdx = raIdx + 1
				end 'chain'

				found = 1
				break
			end 'hit'

			idx = idx + 1
			if idx == capacity 'wrap'
				idx = 0
			end 'wrap'
			remaining = remaining - 1
		end 'scan'

		if found == 0 'noEntry'
			printError("freed by: (no quarantine entry found for slot 0x{slotBase:016x} — poison without a live ring entry)\n")
		end 'noEntry'

		__rc_ledger_dump(userPtr)
		panic("rc-sanitize: {what} 0x{userPtr:016x} — touch backtrace:")
	end '__rc_report_freed_touch'

	// =========================================================================
	// Ledger ring-block arena + per-object recording (see the LEDGER design
	// comment above). Bump-allocated raw OS pages, lock-free freelist recycling.
	// =========================================================================

	// Lazily OS-allocate the ring-block bump arena on first use. Guarded by the
	// slab lock (a one-time cost; every subsequent alloc sees arena_next != 0 and
	// skips the lock). `arena_next` is published LAST so the lock-free bump gate
	// (`arena_next == 0`) stays correct for a racing allocator.
	function __rc_ledger_arena_init(ctl MachineWord)
		__Internals.osLockAcquire(__Internals.slabLockAddr())
		if __Internals.loadIndirect(ctl + RC_LCTL_ARENA_NEXT) == 0 'stillUnset'
			let arena = __slab_assert_os_alloc(__Internals.osAllocPages(RC_LEDGER_ARENA_BYTES))
			__Internals.storeIndirect(ctl + RC_LCTL_ARENA_END, value: arena + RC_LEDGER_ARENA_BYTES)
			__Internals.storeIndirect(ctl + RC_LCTL_ARENA_NEXT, value: arena)
		end 'stillUnset'
		__Internals.osLockRelease(__Internals.slabLockAddr())
	end '__rc_ledger_arena_init'

	// Obtain a ring block: pop the lock-free freelist first, else bump the arena.
	// Returns 0 when the arena is exhausted (graceful degradation — the object
	// simply gets no history ring).
	function __rc_ledger_alloc_block() returns MachineWord
		let ctl = __Internals.rcLedgerCtlAddr()

		while true 'pop'
			let head = __Internals.loadIndirect(ctl + RC_LCTL_FREELIST)
			if head == 0 'freelistEmpty'
				break
			end 'freelistEmpty'
			let next = __Internals.loadIndirect(head + RC_LEDGER_OFF_NEXT)
			if __Internals.atomicCas(ctl + RC_LCTL_FREELIST, old: head, new: next) != 0 'popped'
				return head
			end 'popped'
		end 'pop'

		if __Internals.loadIndirect(ctl + RC_LCTL_ARENA_NEXT) == 0 'needInit'
			__rc_ledger_arena_init(ctl)
		end 'needInit'

		let block = __Internals.atomicXadd(ctl + RC_LCTL_ARENA_NEXT, value: RC_LEDGER_BLOCK_SIZE)
		if block + RC_LEDGER_BLOCK_SIZE > __Internals.loadIndirect(ctl + RC_LCTL_ARENA_END) 'exhausted'
			return 0
		end 'exhausted'
		return block
	end '__rc_ledger_alloc_block'

	// Return a ring block to the lock-free freelist (called when the owning slot
	// truly frees at quarantine age-out). Treiber-stack push.
	function __rc_ledger_free_block(block MachineWord)
		let ctl = __Internals.rcLedgerCtlAddr()
		while true 'push'
			let head = __Internals.loadIndirect(ctl + RC_LCTL_FREELIST)
