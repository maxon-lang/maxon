		__Internals.storeIndirect(mcentralEntry, value: nextSpan)
		__Internals.storeIndirect(partial + 0x20, value: 0)
		// Re-stamp owning_p = rawId — this P now exclusively owns the span (it
		// carried the 0xFFFFFFFF sentinel while parked in mcentral).
		__Internals.storeIndirect(partial + 0x40, value: rawId)
		// Reset the scavenge grace state and re-back the pages if the scavenger handed
		// them to the OS. Factored into __slab_reback_span so refill's hot body stays
		// free of the syscall / rebuild calls.
		__slab_reback_span(span)
	end 'takePartial'

	if partial == 0 'growNew'
		let slotSize = __slab_class_size(classIdx)
		let totalSlots = __slab_objs_per_span(classIdx)
		let dataSize = slotSize * totalSlots
		// numChunks = ceil(dataSize / 8192)
		let numChunks = (dataSize + 8191) shr 13

