/// Compiler internals: platform-neutral runtime helpers that need raw access
/// to Std-level system ops. Only this file is allowed to invoke `__Internals.*`
/// intrinsics — the lowering pass rejects calls from any other source file.
///
/// Functions in here participate in the full stdlib optimization pipeline
/// (canonicalize, cse, licm, dce, Stage A const hoist, inliner) — that's why
/// they live in stdlib rather than runtime.std (which only gets mem2reg).
///
/// @category Compiler-internal
// ⭐⭐ **A RAW MACHINE WORD: AN ADDRESS, A SIZE, A BIT PATTERN, A FUNCTION POINTER, A COUNT, A
// FLAG. UNSIGNED, BECAUSE EVERY ONE OF THOSE IS.**
//
// ⚠ **THIS NAME USED TO MEAN SEVERAL DIFFERENT THINGS AT ONCE AND ITS OWN HEADER ADMITTED IT** —
// *"the full i64 range is intentional here so signed-arithmetic on byte offsets, atomic xadd with
// negative deltas, and pointer values all flow through one type"*. An address and a refcount delta
// are not the same fact and must not share a declaration: the ordering-comparison signedness rule
// reads the DECLARED domain, so one name covering both had to be read one way and was therefore
// wrong for the other. Each fact now has its own name, and each says what its values can be. The
// four below are the ones this paragraph's quote was about; `McacheShard` and `ProcIdOrAbsent`
// further down came out of the same split and are declared with their own reasons:
//
//   `MachineWord`      — this one. Unsigned, full range, unguarded. Nothing hostile arrives: every
//                        value is minted by the OS, the slab, or the compiler itself.
//   `BufferCoordinate` — an index/length/count a CALLER supplied. Signed, because rejecting a
//                        negative one is what the entry point carrying it is FOR.
//   `ElementStride`    — an `element_size`. Signed, because its NEGATIVE half is the sub-byte-packed
//                        bit-width encoding the whole container runtime dispatches on.
//   `RefCountDelta`    — refcount arithmetic. Signed, because a negative is the corruption signal.
//
// ⚠ **THE SECOND `MachineWord` NOW AGREES WITH THIS ONE, AND THAT IS THE POINT.**
// `maxon-shv2/Compiler/Targets/Shared/BinaryHelpers.maxon` declares `MachineWord = int(0 to u64.max)`
// for a value being SERIALIZED into an object file — a size, a file offset, an address. That was
// described here as "the OPPOSITE domain"; it is the SAME domain, and this one was the one that was
// wrong. The two names still do not collide, because this one is module-private and that one is
// `export`ed.
//
// `NonZeroWord` is the one place the two DO still differ (`1 to i64.max` here against `1 to
// u64.max` there), and deliberately: its only remaining use is casting an `ElementStride` at a
// divide, where a stride above `i64.max` is not a value the type must admit — so the narrower
// range keeps its door guarded instead of unguarded for a case that cannot arise.
typealias MachineWord = int(0 to u64.max)

// A machine word proven non-zero: the divisor type for `/`/`mod`. Integer division is fallible (a
// zero divisor throws), so a structurally-non-zero-but-0-inclusive divisor is cast to this at the
// divide — a bare divide, no check, and portable across compilers that do not model a throwing `/`.
typealias NonZeroWord = int(1 to i64.max)

// ⭐ **AN ELEMENT OR BYTE COORDINATE INTO A MANAGED BUFFER, AS THE CALLER SUPPLIED IT** — an index,
// a length, a count, a byte offset, a requested capacity. FULL-RANGE SIGNED, and it has to be:
// every `__managed_mem_*` entry point below opens with `if idx < 0 throw indexOutOfBounds`, and
// that check IS the contract (`specs/arrays.md` pins the throw). Read unsigned the test is always
// false, the bounds check silently disappears, and `get(-1)` becomes an out-of-bounds read.
//
// It cannot be narrowed either. A narrowed range is a GUARDED door, and a guarded door PANICS where
// these are specified to THROW a catchable `indexOutOfBounds` — so the narrowest HONEST range for a
// value whose whole purpose is to be caught and rejected here is the one that admits it.
//
// ⚠ It also puts the DESCENDING loops on a declaration rather than on an accident.
// `__managed_mem_shift_right` walks `j` down to `idx - 1` and stops on `j >= idx`; read unsigned,
// `-1 >= 0` is true and that loop never ends. MEASURED 2026-08-29, both compilers: it terminates
// correctly TODAY even with unsigned parameters, because `j` is a LOCAL and an operand with no
// declared range refuses the unsigned reading on its own. That is a property of where the value
// happens to live, not of what it is — declaring `idx` here says it outright.
typealias BufferCoordinate = int(i64.min to i64.max)

// ⭐ **A RECORD'S `element_size@24`, WHOSE NEGATIVE HALF IS A REAL ENCODING** — not an error value:
//   > 0  N-byte stride (byte-addressed: 1, 2, 4, 8, or a struct's width)
//   == 0  reserved / unset (non-container, or a pre-stamp record)
//   < 0  SUB-BYTE-PACKED: `(-element_size)` BITS per element (a `bool` is -1)
// `__managed_mem_is_packed` is `elemSize < 0` and ~10 access sites dispatch on it. Read unsigned,
// every packed array silently takes the byte-strided path and shreds its own buffer. Full-range
// because a struct element's stride has no bound this file can state.
typealias ElementStride = int(i64.min to i64.max)

// ⭐ **REFCOUNT ARITHMETIC: the delta an atomic xadd applies (a decref is `-1`), and the prior /
// resulting value that arithmetic produces.** FULL-RANGE SIGNED because the OVER-RELEASE TRAP
// (`if prior <= 0`) exists precisely to see a value a correct program cannot produce. Read unsigned
// that test degrades to `prior == 0`, a corrupt negative reads back as a huge positive, and the
// double-free detector stops firing over a green suite.
typealias RefCountDelta = int(i64.min to i64.max)

// An mcache ROW index: which of the `SLAB_MAX_SHARDS` rows a thread allocates from. Non-negative by
// construction — `__slab_shard_for_tag` is the sole producer and it caps. ⚠ The upper bound is
// `SLAB_MAX_SHARDS - 1` written out, because a range needs literals; the two must move together.
typealias McacheShard = int(0 to 255)

// ⚠ **THE ONE PLACE `-1` STILL MEANS "NO P", AND IT IS AN ABI, NOT A CHOICE.** `__slab_current_p_id`
// is OVERRIDDEN at that exact label by hand-emitted machine code on two targets
// (`emitX64SlabCurrentPId`, `emitArm64SlabCurrentPId`), which return `P->id` or `-1`; neither the
// encoding nor the NAME is this file's to change. So it is treated as what it is — a foreign
// boundary — and converted AT the boundary by `__slab_owning_p_tag`, the single caller. Nothing
// downstream of that ever sees a negative P id again.
typealias ProcIdOrAbsent = int(-1 to i64.max)

// ⭐⭐ **THE `int(0 to u64.max)` ROSTER — EVERY DELIBERATELY UNGUARDED NON-NEGATIVE ALIAS LEFT IN
// `stdlib/`, AND WHY EACH ONE STAYS.**
//
// A FULL range is the one shape both compilers leave unchecked (`rangeIsFull`, `IsFullBaseRange`), so
// `int(0 to u64.max)` means TWO things at once: this door is not guarded, AND every ordering
// comparison on it reads UNSIGNED. Both are correct for the four names below and for nothing else in
// `stdlib/` — every other non-negative alias has been narrowed to its honest upper bound, which is
// what makes its doors checked and pins its comparisons to the signed reading.
//
// ⇒ **`grep -rn "int(0 to u64.max)" stdlib/` must return exactly the FOUR declarations below plus
// the comments that quote the shape.** A fifth is either an alias nobody narrowed or an entry
// nobody justified, and it is a live cross-compiler divergence either way: the bootstrap propagates the
// first ranged type an operand offers onto arithmetic results, so a DERIVED negative under a
// full-range alias orders unsigned there and signed in shv2, which mints binop results unnamed.
//
//   • `MachineWord`          (this file)                     — an address, a size, a raw bit pattern,
//     a function pointer, a slot/page/class index, a count, a flag. ⭐ Its unguardedness is the one
//     entry here that is not merely tolerated but REQUIRED: this is the memory manager, and every
//     value it holds was minted by the OS, the slab, or the compiler — a guard could only ever fire
//     on a value the allocator itself produced. See its header for the three-way split that let it
//     join this roster.
//   • `HashMixWord`          (`Interfaces.maxon`)            — a hash avalanche's bit pattern. The
//     multiply and the shifts are defined on all 64 bits; a "negative" mixed word is meaningless.
//   • `GraphemeStateBits`    (`helpers/string/grapheme.maxon`) — a packed UAX #29 break-state
//     bitfield, read by masking, never ordered as a magnitude.
//   • `SortIndex`            (`helpers/sort/insertionSort.maxon`) — genuinely unsigned ARITHMETIC:
//     `nodePowerBetween`'s `scale * x` is designed to reach ~2^63 without wrapping, and its
//     leading-zero scan builds the 2^63 top bit as `2^62 * 2`. ⚠ `SortRunIndex` (`driftsort.maxon`)
//     is NOT this and was retyped: it holds a run's start index and length, which are array
//     coordinates.
//
// Full-range SIGNED aliases are deliberate too and do NOT appear in that grep, so none of them is
// evidence about the rule above. Each admits a NEGATIVE because a negative MEANS something to it:
//   • `BufferCoordinate` / `ElementStride` / `RefCountDelta` here, and `Array.ReportedCapacity` —
//     a caller's unvalidated index, a sub-byte-packed bit width, a refcount the trap must see go
//     below zero, and the flag a non-owned buffer answers instead of a capacity.
//   • `maxon-shv2/Compiler/Targets/Shared/BinaryHelpers.maxon`'s `NonZeroWord` — outside `stdlib/`
//     entirely. (Its `MachineWord` twin now AGREES with this file's and is no longer a split.)
// A range that must admit a sentinel is honest only by admitting it; the rule is not "narrow
// everything", it is "say what the value can be".

// Atomically increment the refcount at [ptr - 8]. Caller must ensure ptr is
// the user-region pointer (32-byte mm header sits at ptr-32..ptr-1; refcount
// is the trailing word at ptr-8). Migrated from runtime.std's mm_incref so
// the inliner can see this 2-op body at every call site.
function __mm_incref(ptr MachineWord)
	// STRICT: see `__mm_decref`. A null or non-heap value reaching incref is a
	// classification bug — fault on the `[ptr-8]` header write rather than
	// silently no-opping (which would let the bug hide and the real reference
	// leak). incref has no maybe-null sibling: the inserter only increfs values
	// it has proven live (a fresh allocation or a dominating definition), so a
	// null here is always wrong.
	#if rcSanitize(true)
		__rc_check_freed_touch(ptr, kind: RC_TOUCH_INCREF)
	#endif
	__Internals.atomicInc(ptr - 8)
end '__mm_incref'

// ⭐ **THE OVER-RELEASE PREDICATE — one test, three callers, and the ONE place its SIGNEDNESS is
// declared.** `prior` is the value an `atomicXadd(ptr - 8, value: -1)` displaced: `== 0` means this
// decref released a reference that was never taken, `< 0` means the header was already corrupt.
// Both are refcount-inserter / lowering bugs, and both are states a correct program cannot reach.
//
// ⚠ **IT TAKES A `RefCountDelta` FOR THE SAME REASON THE TEST EXISTS.** Read UNSIGNED, `<= 0`
// degrades to `== 0` and a corrupt negative comes back as a huge positive — the double-free trap
// stops firing, silently, over a green suite. The three call sites pass a LOCAL, which carries no
// declared range and so already refuses the unsigned reading; routing them all through one door
// that DECLARES the domain means the trap can no longer be broken by a retype anywhere, and states
// the requirement instead of leaving it resting on an absence.
//
// A one-line body the stdlib inliner folds into each caller, so this costs no call on the decref
// hot path — and it replaces three copies of the same comparison.
function __mm_is_over_release(prior RefCountDelta) returns bool
	return prior <= 0
end '__mm_is_over_release'

// Atomically decrement the refcount at [ptr - 8]. If the prior value was 1
// (refcount transitions to 0) call __mm_free to release the allocation.
// Caller must ensure ptr is non-null.
//
// We use atomicXadd with -1 rather than atomicDec because we need the prior
// value to detect the transition to zero across architectures uniformly —
// the bare atomic_dec op has no result Id in Std-IR.
function __mm_decref(ptr MachineWord)
	// STRICT: __mm_decref dereferences the allocation header at `[ptr-8]` (and
	// `[ptr-32]` on free). A null or non-heap value reaching here is NOT tolerated
	// — it is a refcount-inserter / lowering classification BUG, and faulting on
	// the header read surfaces it loudly with a stack trace instead of silently
	// no-opping (which masks the bug and leaks the real owner). The ONLY caller
	// allowed to pass a possibly-null pointer is `__mm_decref_maybenull_helper`, which
	// tolerates EXACTLY null (==0) at the statically-maybe-null release sites
	// (incomingOwner / selfReturnBorrow values, field-reassign old-occupant drop)
	// and calls through to this strict body for every non-null pointer.
	#if rcSanitize(true)
		__rc_check_freed_touch(ptr, kind: RC_TOUCH_DECREF)
	#endif
	let prior = __Internals.atomicXadd(ptr - 8, value: -1)
	if prior == 1 'lastRef'
		__mm_free(ptr)
	end 'lastRef'
	// STRICT over-release trap: prior == 0 means this decref releases a
	// reference that was never taken (the sole-owner rc=0 reference belongs to
	// `__mm_drop`, never to decref); prior < 0 means the header is already
	// corrupt. Both are refcount-inserter / lowering bugs. Silently going
	// negative masks the bug as a leak — or, once a later incref crosses zero
	// again, as a delayed double-free whose slab-slot reuse corrupts unrelated
	// data. Fault loudly at the source instead.
	// The test itself lives in `__mm_is_over_release`, which is where its signedness is declared.
	if __mm_is_over_release(prior) 'overRelease'
		panic("__mm_decref: over-release — refcount was already 0")
	end 'overRelease'
end '__mm_decref'

// Owner-drop for the alloc-at-0 model. `[ptr-8]` counts EXTRA references beyond
// the single owner; a freshly-allocated value owned by exactly one binding sits
// at rc=0 its whole life (it was moved in, never shared/incref'd). When that
// owner's scope ends:
//   - rc == 0  → this is the sole reference; free the block directly.
//   - rc  > 0  → the value escaped (was incref'd for another owner); decref the
//                extra reference and leave the block for the last owner to free.
// Null-tolerant (==0 ptr) for slots that were zero-initialized but never assigned
// on the taken exit path — the scope-exit drop runs unconditionally per slot.
// This is the primitive the binding scope-exit drop uses; it is DISTINCT from
// `__mm_decref` (which frees only on prior-rc==1 and is for releasing an EXTRA
// reference an aliasing owner holds, not the sole owner's rc=0 reference).
function __mm_drop(ptr MachineWord)
	if ptr == 0 'null'
		return
	end 'null'
	let rc = __Internals.loadIndirect(ptr - 8)
	#if rcSanitize(true)
		if rc == RC_SANITIZE_POISON_RC 'freedTouch'
			__rc_report_freed_touch(ptr, kind: RC_TOUCH_DROP)
		end 'freedTouch'
	#endif
	if rc == 0 'soleOwner'
		// Scope-exit drop of the sole owner (rc==0): this is the sole reference,
		// so free the block directly.
		__mm_free(ptr)
		return
	end 'soleOwner'
	// rc>0: the value escaped (an extra owner exists). Decref this owner's ref; the
	// last owner frees. (No mm_drop marker — a plain decref like any shared value.)
	__mm_decref(ptr)
end '__mm_drop'

// =============================================================================
// Sharded slab allocator (migrated from runtime.std — sharded variant).
//
// This is the per-P sharded (Go/mimalloc-style) slab. The fast path is
// lockless: each P owns its own mcache ROW (mcache_base + shard*144), and the
// span it pops from is its sole writer. A cross-P free is CAS-pushed onto the
// owner P's remote-free MPSC queue and replayed by the owner on its alloc slow
// path. The slow path (refill / mcentral mutation / OS-direct) takes the global
// __slab_lock. On single-P targets (wasm / arm64 / pre-scheduler x64) no thread ever
// adopts a P, so every allocation lands on SLAB_RAW_SHARD and the allocator collapses
// to a single shard.
//
// mspan struct (88 bytes used; 96-byte / 0x60 slot — see MSPAN_META_SLOT_SIZE):
//   +0x00 base_addr  +0x08 slot_size  +0x10 free_list  +0x18 free_count
//   +0x20 next_span  +0x28 class_idx  +0x30 total_slots +0x38 arena_base
//   +0x40 owning_p   (an OWNING-P TAG — see MSPAN_OWNING_P_RAW / _PARKED)
//   +0x48 scav_state (SPAN_SCAV_ACTIVE / SEEN_FREE / DECOMMITTED)
//   +0x50 bump_next  (Go's mspan.freeindex, held as an address — see below)
//
// ProcContext remote-free queue head sits at p_ptr + 0x78 (Treiber stack).
//
// `__Internals.atomicCas(addr, old, new)` returns 1 on success / 0 on failure
// (NOT the prior value) — the CAS loops below test it as a success boolean.
//
// -----------------------------------------------------------------------------
// ZEROING: the allocator hands back memory that is always zero.
//
// This is Go's model (`mallocgc(size, typ, needzero bool)`), which this allocator
// already mirrors elsewhere. Callers get zeroed memory by default; the audited
// `__slab_alloc_raw` opts out.
//
// A slot can reach a caller from two places, and they differ in whether the
// memory is dirty:
//
//   * the FREE LIST — a recycled slot. It still holds the previous occupant's
//     bytes, plus the free-list link written into slot[0] when it was freed. It
//     MUST be zeroed before the caller sees it.
//
//   * the BUMP REGION [bump_next, bump_end) — slots that have NEVER been handed
//     out. Their pages came straight from `__slab_arena_alloc_chunks`, i.e.
//     fresh VirtualAlloc/mmap/memory.grow address space, which every one of our
//     four targets guarantees arrives zeroed. (Go leans on exactly this: "sysAlloc
//     obtains a large chunk of ZEROED memory from the operating system.") They are
//     already zero, so they cost NOTHING to hand out.
//
// The bump cursor is what makes the second case possible at all, and it is the
// reason `__slab_build_freelist` no longer exists:
//
//   >>> Threading an intrusive free list through a fresh span writes a next-pointer
//   >>> into slot[0] of EVERY slot, which DIRTIES every one of them. A dirty slot
//   >>> must be memzeroed before it can be handed out. So building the list up front
//   >>> was not merely wasted work — it was the thing that would FORCE a memzero on
//   >>> every first-ever allocation. Leaving the region pristine is the precondition
//   >>> for any zero-elision at all.
//
// This is FINER-GRAINED than Go, whose `needzero` is per-span: Go re-zeroes even
// never-used slots in a span that has seen a single free. Our cursor is per-slot,
// so we never pay for a slot that was never dirtied.
//
// INVARIANTS (every mutation site below re-establishes these):
//   INV-1  free_count == |free_list| + (bump_end - bump_next) / slot_size
//   INV-2  bump_end   == base_addr + slot_size * total_slots   (DERIVED, never stored)
//   INV-3  every byte in [bump_next, bump_end) is ZERO
//
// The case worth stating explicitly, because it looks wrong: a span can be
// returned to mcentral carrying BOTH an unconsumed bump region AND a populated
// free list. (Allocate 3 slots from a fresh 1024-slot span, free all 3 →
// free_count == 1024 == total_slots → returned to mcentral, holding 3 free-list
// entries and 1021 never-used slots.) Both survive in the mspan, and the next P to
// take the span keeps using both. INV-1 holds throughout.
// =============================================================================

// Metadata-slab slot size for one mspan header. The struct occupies 0x00..0x58;
// 0x60 keeps successive headers 16-byte aligned inside the 8 KiB metadata chunk.
// MUST stay in lockstep with the mspan layout above — a stale value here silently
// OVERLAPS adjacent mspan headers.
let MSPAN_META_SLOT_SIZE = 0x60

// Zeroes `size` bytes starting at `ptr`. `size` need not be a multiple of 8.
//
// Go's `memclrNoHeapPointers`. The backend expands `__Internals.memzero` into a
// SIZE LADDER (straight-line overlapping stores when small, a store loop when
// medium, `rep stosq` only once the region is big enough to amortise its ~20-40
// cycle startup) — which is what makes it viable to zero an 8-byte slab slot on
// the allocator's hot path. This used to be a byte-at-a-time loop.
function __slab_memzero(ptr MachineWord, size MachineWord)
	__Internals.memzero(ptr, size: size)
end '__slab_memzero'

// Validate the result of an `osAllocPages` request. `osAllocPages` wraps
// VirtualAlloc(NULL, …, MEM_COMMIT|MEM_RESERVE) (mmap on POSIX), which returns
// 0 when the OS cannot satisfy the request — the system commit limit is
// exhausted. The slab's grow/init/OS-direct paths all immediately store the
// arena metadata into the returned pointer; a 0 here would fault on a NULL
// store (`mov %reg, (NULL)`) with an opaque segfault. Surface it as a clean,
// distinct abort instead so an out-of-memory condition is diagnosable rather
// than a mysterious nil-deref crash. 137 = slab OS allocation failed (OOM).
function __slab_assert_os_alloc(ptr MachineWord) returns MachineWord
	if ptr == 0 'oom'
		// 137 = osAllocPages returned NULL (out of memory / commit limit).
		__Internals.osExit(137)
	end 'oom'
	return ptr
end '__slab_assert_os_alloc'

// Allocates the very first 64 MiB arena from the OS, initialises its metadata
// and bitmap, prepends it to the arena list, and flips __slab_init_done to 1.
// Bitmap layout: chunk 0 holds the metadata, so its bit stays 0 (used); the
// other 8191 chunks start as 1 (free). 128 qwords of bitmap: qword 0 = -2
// (0xFFFFFFFFFFFFFFFE), qwords 1..127 = -1 (all free).
//
// globalAddr results are inlined (never bound to a local) so drop-injection
// does not treat them as heap-owned and emit a stray sys.free at function exit.
function __slab_arena_init()
	let arenaBase = __slab_assert_os_alloc(__Internals.osAllocPages(0x4000000))
	// metadata: next = NULL (offset 0)
	__Internals.storeIndirect(arenaBase, value: 0)
	// bitmap qword 0 = 0xFFFFFFFFFFFFFFFE (chunk 0 used, rest free)
	__Internals.storeIndirect(arenaBase + 0x10, value: -2)
	// qwords 1..127 = -1 (all free)
	for i in 1 upto 128 'fill'
		__Internals.storeIndirect(arenaBase + 0x10 + (i shl 3), value: -1)
	end 'fill'
	// Prepend to the arena list head: new->next = old_head; head = new.
	let oldHead = __Internals.loadIndirect(__Internals.slabArenaListHeadAddr())
	__Internals.storeIndirect(arenaBase, value: oldHead)
	__Internals.storeIndirect(__Internals.slabArenaListHeadAddr(), value: arenaBase)
	// __slab_init_done = 1
	__Internals.storeIndirect(__Internals.slabInitDoneAddr(), value: 1)
end '__slab_arena_init'

// Walks the arena list scanning each arena's bitmap bit-by-bit for a run of
// `numChunks` consecutive free chunks. On success: clears those bits, stores
// the arena base in __slab_arena_last_base, and returns
// (arena_base + run_start * CHUNK_SIZE). On failure (no arena had room),
// allocates a fresh 64 MiB arena via the OS, links it in, and retries.
function __slab_arena_alloc_chunks(numChunks MachineWord) returns MachineWord
	var arenaPtr = __Internals.loadIndirect(__Internals.slabArenaListHeadAddr())
	while true 'arenaLoop'
		if arenaPtr == 0 'grow'
			// No arena had room — alloc a fresh 64 MiB arena and link in.
			let newArena = __slab_assert_os_alloc(__Internals.osAllocPages(0x4000000))
			// metadata: next = old_head
			__Internals.storeIndirect(newArena, value: __Internals.loadIndirect(__Internals.slabArenaListHeadAddr()))
			// bitmap qword 0 = 0xFFFFFFFFFFFFFFFE
			__Internals.storeIndirect(newArena + 0x10, value: -2)
			// qwords 1..127 = -1 (all free)
			for j in 1 upto 128 'growFill'
				__Internals.storeIndirect(newArena + 0x10 + (j shl 3), value: -1)
			end 'growFill'
			// head = new_arena
			__Internals.storeIndirect(__Internals.slabArenaListHeadAddr(), value: newArena)
			// Restart the scan against the fresh arena.
			arenaPtr = newArena
			continue
		end 'grow'

		// Scan this arena's bitmap. Skip chunk 0 (always used by metadata).
		var i = 1
		var runLen = 0
		var runStart = 0
		var found = false
		while i < 0x2000 'bitLoop'
			let qwordIdx = i shr 6
			let qwordAddr = arenaPtr + 0x10 + (qwordIdx shl 3)
			let qword = __Internals.loadIndirect(qwordAddr)
			let bit = (qword shr (i and 63)) and 1
			if bit == 0 'used'
				runLen = 0
			end 'used'
			if bit != 0 'free'
				if runLen == 0 'startRun'
					runStart = i
				end 'startRun'
				runLen = runLen + 1
				if runLen >= numChunks 'gotRun'
					found = true
					break
				end 'gotRun'
			end 'free'
			i = i + 1
		end 'bitLoop'

		if found 'haveRun'
			// Clear bits runStart..runStart+numChunks-1 in the bitmap.
			for j in runStart upto runStart + numChunks 'clear'
				let qwordIdx = j shr 6
				let qwordAddr = arenaPtr + 0x10 + (qwordIdx shl 3)
				// mask = ~(1 << (j & 63)). Maxon has no unary bitNot; xor with -1
				// (all-ones two's complement) is the same.
				let bit = 1 shl (j and 63)
				let mask = bit xor -1
				let prior = __Internals.loadIndirect(qwordAddr)
				__Internals.storeIndirect(qwordAddr, value: prior and mask)
			end 'clear'
			// __slab_arena_last_base = arena_ptr
