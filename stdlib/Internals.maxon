				return
			end 'pushed'
		end 'push'
	end '__rc_ledger_free_block'

	// Attach a fresh (or recycled) ring block to a just-allocated object and seed
	// it with the `created` op at rc 0 (the alloc-at-0 model). Returns the block
	// pointer to stash in the object's reserved header word, or 0 on exhaustion.
	// Called by `__mm_alloc` under `#if rcSanitize(true)`.
	function __rc_ledger_attach() returns MachineWord
		let block = __rc_ledger_alloc_block()
		if block == 0 'exhausted'
			return 0
		end 'exhausted'
		let entry = block + RC_LEDGER_OFF_ENTRIES
		__Internals.storeIndirect(entry + 0, value: RC_KIND_CREATED)
		__Internals.storeIndirect(entry + 8, value: 0)
		__Internals.storeIndirect(entry + 16, value: 0)
		__Internals.storeIndirect(block + RC_LEDGER_OFF_HEAD, value: 1)
		__Internals.storeIndirect(block + RC_LEDGER_OFF_COUNT, value: 1)
		return block
	end '__rc_ledger_attach'

	// Append one (kind, rc-after) op to `userPtr`'s ring. No-op if the object has
	// no ring (arena was exhausted at its allocation). Best-effort under
	// concurrency: a torn ring under a genuine data race on ONE object is an
	// acceptable diagnostic imprecision, never a correctness hazard.
	function __rc_ledger_record(userPtr MachineWord, kind MachineWord, rcAfter MachineWord, ra MachineWord)
		let block = __Internals.loadIndirect(userPtr - 32)
		if block == 0 'noRing'
			return
		end 'noRing'
		let head = __Internals.loadIndirect(block + RC_LEDGER_OFF_HEAD)
		let entry = block + RC_LEDGER_OFF_ENTRIES + head * RC_LEDGER_ENTRY_SIZE
		__Internals.storeIndirect(entry + 0, value: kind)
		__Internals.storeIndirect(entry + 8, value: rcAfter)
		__Internals.storeIndirect(entry + 16, value: ra)
