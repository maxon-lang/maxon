			// non-owned cached span rather than popping it (prevents the analogous
			// fast-reject -> drain -> re-probe loop and the recycle corruption).
			if __Internals.loadIndirect(probedSpan + 0x40) != owningTag 'notOwned2'
				stillMiss = true
