		if nextHead == RC_LEDGER_RING_ENTRIES 'wrap'
			nextHead = 0
		end 'wrap'
		__Internals.storeIndirect(block + RC_LEDGER_OFF_HEAD, value: nextHead)
		__Internals.storeIndirect(block + RC_LEDGER_OFF_COUNT, value: __Internals.loadIndirect(block + RC_LEDGER_OFF_COUNT) + 1)
	end '__rc_ledger_record'

	// Human-readable name for an RcOpKind raw value (mirror of ReleaseEmit's enum).
	function __rc_kind_name(kind MachineWord) returns String
		if kind == RC_KIND_CREATED 'k'
			return "created"
		end 'k'
		if kind == RC_KIND_STORE_INCREF_NEW 'k'
			return "storeIncrefNew"
		end 'k'
		if kind == RC_KIND_FIELD_TRANSFER_INCREF 'k'
			return "fieldTransferIncref"
		end 'k'
		if kind == RC_KIND_MODULE_GLOBAL_INCREF 'k'
			return "moduleGlobalIncref"
		end 'k'
		if kind == RC_KIND_ACQUIRE_AT_DEF 'k'
			return "acquireAtDef"
		end 'k'
		if kind == RC_KIND_RETAIN_FOR_RETURN 'k'
			return "retainForReturn"
		end 'k'
		if kind == RC_KIND_BORROWED_ELEMENT_RETAIN 'k'
			return "borrowedElementRetain"
		end 'k'
		if kind == RC_KIND_CONSUMED_ARG_COPY_RETAIN 'k'
			return "consumedArgCopyRetain"
		end 'k'
		if kind == RC_KIND_TRANSPARENT_WRAP_RETAIN 'k'
			return "transparentWrapRetain"
		end 'k'
		if kind == RC_KIND_RETURNED_BORROW_RETAIN 'k'
			return "returnedBorrowRetain"
		end 'k'
		if kind == RC_KIND_ADDRESS_TAKEN_SLOT_RETAIN 'k'
			return "addressTakenSlotRetain"
		end 'k'
		if kind == RC_KIND_PHI_EDGE_INCREF 'k'
			return "phiEdgeIncref"
		end 'k'
		if kind == RC_KIND_FIELD_OVERWRITE_DECREF_OLD 'k'
			return "fieldOverwriteDecrefOld"
		end 'k'
		if kind == RC_KIND_BY_REF_PARAM_DECREF_OLD 'k'
			return "byRefParamDecrefOld"
		end 'k'
		if kind == RC_KIND_LAST_USE_DECREF 'k'
			return "lastUseDecref"
		end 'k'
		if kind == RC_KIND_LAST_USE_EDGE_DECREF 'k'
			return "lastUseEdgeDecref"
		end 'k'
		if kind == RC_KIND_TERMINATOR_DECREF 'k'
			return "terminatorDecref"
		end 'k'
		if kind == RC_KIND_DEAD_DEF_DROP 'k'
			return "deadDefDrop"
		end 'k'
		if kind == RC_KIND_DEAD_BLOCK_PARAM_DROP 'k'
			return "deadBlockParamDrop"
		end 'k'
		if kind == RC_KIND_ADDRESS_TAKEN_SLOT_DROP 'k'
			return "addressTakenSlotDrop"
		end 'k'
		if kind == RC_KIND_ADDRESS_TAKEN_SLOT_OVERWRITE_DROP 'k'
			return "addressTakenSlotOverwriteDrop"
		end 'k'
		if kind == RC_KIND_BORROW_ROOT_EDGE_DROP 'k'
			return "borrowRootEdgeDrop"
		end 'k'
		if kind == RC_KIND_DESTRUCTOR_FIELD_DROP 'k'
			return "destructorFieldDrop"
		end 'k'
		return "unspecified"
