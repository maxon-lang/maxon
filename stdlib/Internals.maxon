// stamps `elementDestroy` (lowering passes &__mm_decref for pointer elements) so
// the destructor's ROOT-branch element-walk fires. When the bit is clear (raw /
// primitive elements) the record's element_destroy stays 0 and the walk is inert
// — so a raw-int array is never walked (decref-ing a raw int would fault). Set-
// once / idempotent: re-stamping the same pointer on every grow is harmless.
// `layoutDesc == 0` is tolerated (no descriptor available → leave 0, no walk).
function __managed_mem_set_element_destroy_from_layout(self MachineWord, layoutDesc MachineWord, elementDestroy MachineWord) returns MachineWord
	if layoutDesc == 0 'noDesc'
		return 0
	end 'noDesc'
	let flags = __Internals.loadIndirect(layoutDesc + LAYOUT_OFFSET_FLAGS)
	if (flags and LAYOUT_FLAG_HAS_HEAP_REFS) != 0 'managed'
		__Internals.storeIndirect(self + MM_OFFSET_ELEMENT_DESTROY, value: elementDestroy)
	end 'managed'
	return 0
end '__managed_mem_set_element_destroy_from_layout'

// Stamp a record's `element_size@24` (per-slot storage stride) from a forwarded
// instance layout descriptor's `elementSize@16`. Emitted at the `grow` site (the
// generic container body where the concrete element type is an unbound
// type-parameter, so the per-create stamp `synthesizeManagedFieldInits` left the
// provisional pointer-width 8). Corrects a `Byte` array's stride to 1 so its slots
// pack contiguously instead of 8 bytes apart (the garbled-byte-slice bug: a
// self-compiled compiler's `byteSliceToString` reconstructed wrong strings →
// spurious E3034 on stdlib/Subprocess.maxon), and a `bool` array's stride to the
// packed -1 so its elements bit-pack (a dynamically-built `Array with bool`).
//
// `elementSize == 0` means the forwarded layout carries NO usable stride: it is a
// singleton element-layout (`__layout_elem_managed` / `__layout_elem_raw`) that a
// multi-type-param aggregate (e.g. a `Map`'s keys/values field-array) forwards,
// where only the HAS_HEAP_REFS bit is meaningful and every sizing slot is 0.
// Leaving the create-time default 8 untouched there is correct — those field
// elements are pointer-width (String / struct / int). Stamping the 0 in would
// flip `grow` onto a degenerate sizing path and shred the buffer (the
// `Map.insert` → `Array.set` over-release).
function __managed_mem_set_element_size_from_layout(self MachineWord, layoutDesc MachineWord) returns MachineWord
	if layoutDesc == 0 'noDesc'
		return 0
	end 'noDesc'
	// Preserve a deliberately sub-byte-packed record: `element_size < 0` is the
	// negative-bit-width sentinel (bool = -1) the packed path sets so `grow`
	// measures the buffer in BITS and the accessors bit-address it. Re-stamping is at
	// best a no-op (the layout re-derives the same width) and must never clobber it
	// back to a positive byte stride.
	let current = __Internals.loadIndirect(self + MM_OFFSET_ELEMENT_SIZE)
	if __managed_mem_is_packed(current) 'alreadyPacked'
		return 0
	end 'alreadyPacked'
	// `elementSize@16` is the element's byte stride (1 Byte, 8 pointer/managed), or —
	// when the layout's BIT_PACKED flag is set — its BIT width (1 for bool). `0` marks
	// a forwarded singleton element-layout (a Map's keys/values field-array); leave the
	// provisional pointer-width default there.
	let elemSize = __Internals.loadIndirect(layoutDesc + LAYOUT_OFFSET_ELEMENT_SIZE)
	if elemSize == 0 'singletonSkip'
		return 0
	end 'singletonSkip'
	let flags = __Internals.loadIndirect(layoutDesc + LAYOUT_OFFSET_FLAGS)
	if (flags and LAYOUT_FLAG_BIT_PACKED) != 0 'packed'
		// Sub-byte-packed: `elementSize@16` is the bit width; store its negation so the
		// record carries the negative-bit-width encoding the accessors dispatch on.
		__Internals.storeIndirect(self + MM_OFFSET_ELEMENT_SIZE, value: -elemSize)
		return 0
	end 'packed'
	__Internals.storeIndirect(self + MM_OFFSET_ELEMENT_SIZE, value: elemSize)
	return 0
end '__managed_mem_set_element_size_from_layout'

// toCString(self) — return a NUL-terminated byte pointer into self's buffer.
// A zero-copy slice or rdata-backed literal often has `buffer[length] != 0`
// (the byte there belongs to the next element / the next constant), so a bare
// `loadIndirect(self)` would hand back a pointer that `strlen` walks off the
// end of — a buffer overrun (and a hard out-of-bounds trap on wasm's
// bounds-checked memory). When the terminator slot is already `\0`, return the
// buffer as-is; otherwise COW to an owned buffer, grow capacity to `length + 1`,
// write the terminator, and return the (possibly reallocated) buffer.
// Non-throwing — `newCap = length + 1 > capacity` can never trip `invalidCapacity`.
//
// ⛔⛔ THIS BODY IS THE RULE'S THIRD SPELLING AND IT NO LONGER MIRRORS THE OTHER
// TWO. It has NO CALLER in this tree — both live compilers lower `toCString` to an
// intrinsic (`MaxonToStandardConversion.LowerManagedToCString` in the C# bootstrap,
// `StringRuntime.buildMmToCString` in shv2) and neither routes here — so what
// follows is v1's implementation, compiled but never run. That is exactly why the
// line above used to say "Mirror the bootstrap's `MaxonManagedToCStringOp`", and why
// the claim had to go: on 2026-09-02 both live compilers gained a GUARD this body
// does not have, and nothing here would have failed if the claim had gone on standing.
//
// ⛔ WHAT IS MISSING: the probe below reads `buffer[length]`, one byte PAST the
// content, and asks it of EVERY record. Two shapes do not own that byte — a VIEW,
// and an exactly-full OWNED buffer (`capacity == length`, which is what a first
// append leaves behind) — and a zero found there is one nothing keeps zero. The
// measured consequence in the bootstrap was `Directory.exists` answering FALSE for a
// directory plainly present: the next allocation landed on the byte the probe had
// just accepted as that path's terminator.
//
// ⇒ ANYONE REVIVING OR PORTING THIS BODY OWES THE VOUCH TEST FIRST. The rule, its
// admit-list and the reason each shape is in it are written out once, at
// `BufferOwnership.emitRouteOnVouchedTerminatorSlot`. It cannot be transcribed from
// there: this file encodes provenance in `parent@32` where shv2 uses a capacity
// sentinel, so the same rule has to be re-expressed in this model.
function __managed_mem_to_cstring(self MachineWord) returns MachineWord
	let buffer = __Internals.loadIndirect(self)
	let length = __Internals.loadIndirect(self + MM_OFFSET_LENGTH)
	if __Internals.loadByte(buffer, offset: length) == 0 'alreadyTerminated'
		return buffer
	end 'alreadyTerminated'
	// A capacity that already fits `length + 1` is always a positive (owned)
	// value — the rdata/shared sentinels are negative and so are < length + 1,
	// routing through `grow`, which COWs then reallocs. So reaching the
	// terminator write below always means we own the buffer.
	let capacity = __Internals.loadIndirect(self + MM_OFFSET_CAPACITY)
	if capacity < length + 1 'needRoom'
		_ = try __managed_mem_grow(self, newCap: length + 1) otherwise panic("__managed_mem_to_cstring: grow to length+1 cannot shrink")
	end 'needRoom'
	let ownedBuf = __Internals.loadIndirect(self)
	__Internals.storeByte(ownedBuf, offset: length, value: 0)
	return ownedBuf
end '__managed_mem_to_cstring'

// fromCString(cstr) — static `__ManagedMemory.fromCString`. Convert a
// NUL-terminated byte pointer into a fresh byte-element __ManagedMemory.
// Walks the pointer to find its length (the byte before the terminating
// `\0`), allocates a root header plus a buffer of `length + 1` bytes, and
// copies the bytes *including* the terminator so the result is itself a valid
// cstring (`toCString` on it returns the same shape). length=len,
// capacity=len+1, element_size=1, parent_ptr=-1 (root). Non-throwing.
// Mirrors the bootstrap's `LowerCStringToManagedCore`.
function __managed_mem_from_cstring(cstr MachineWord) returns MachineWord
	var len = 0
	while __Internals.loadByte(cstr, offset: len) != 0 'scan'
		len = len + 1
	end 'scan'
	let bufSize = len + 1
	let destructor = __Internals.destructManagedMemoryAddr()
	let newStruct = __mm_alloc(MANAGED_MEM_RECORD_SIZE, destructor: destructor)
	let newBuf = __managed_mem_alloc_buffer(bufSize)
	__Internals.memcpy(newBuf, src: cstr, size: bufSize)
	__Internals.storeIndirect(newStruct, value: newBuf)
	__Internals.storeIndirect(newStruct + MM_OFFSET_LENGTH, value: len)
	__Internals.storeIndirect(newStruct + MM_OFFSET_CAPACITY, value: bufSize)
	__Internals.storeIndirect(newStruct + MM_OFFSET_ELEMENT_SIZE, value: 1)
	__Internals.storeIndirect(newStruct + MM_OFFSET_PARENT, value: MM_PARENT_ROOT)
	__Internals.storeIndirect(newStruct + MM_OFFSET_ELEMENT_DESTROY, value: 0)
	return newStruct
end '__managed_mem_from_cstring'
