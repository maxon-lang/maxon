		return MSPAN_OWNING_P_RAW
	end 'noAdoptedP'
	return rawId
end '__slab_owning_p_tag'

// Does `tag` name an actual P — one with an id, an mcache row of its own, and a remote-free queue?
// False for both tags: a raw OS thread has no P, and a span parked in mcentral is owned by none.
function __slab_tag_is_real_p(tag MachineWord) returns bool
	return tag != MSPAN_OWNING_P_RAW and tag != MSPAN_OWNING_P_PARKED
end '__slab_tag_is_real_p'

// Map an owning-P tag onto its mcache row index in [0, SLAB_MAX_SHARDS).
// MSPAN_OWNING_P_RAW becomes the dedicated raw shard, NOT shard 0 — sharing shard 0
// with P[0] (the main thread, which actively allocates while draining green threads
// in an await loop) raced the main thread's lockless pops against a raw thread's,
// handing the same slab slot to both → heap corruption (the async-subprocess flake:
// a managed pointer overwritten by a concurrent cmdline UTF-16 / child-output
// write). A (practically unreachable) id >= 256 is capped to the last row. This is
