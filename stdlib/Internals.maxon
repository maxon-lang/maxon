		// answers 0 for the raw tag). Reclaimed slots may refill the cached span we just
		// found empty.
		__slab_drain_remote_frees(__slab_proc_at(owningTag))

		// Re-probe the cached span after draining.
		let probedSpan = __Internals.loadIndirect(mcacheSlot)
