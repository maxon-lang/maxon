	// Print `userPtr`'s recorded refcount-op history, oldest-first, capped at the
	// ring depth. Reads only the ring block (never the possibly-freed object).
	function __rc_ledger_dump(userPtr MachineWord)
		let block = __Internals.loadIndirect(userPtr - 32)
		if block == 0 'noRing'
			printError("  refcount-op history: (none — ledger arena exhausted at this object's allocation)\n")
			return
		end 'noRing'

		let count = __Internals.loadIndirect(block + RC_LEDGER_OFF_COUNT)
		var shown = count
		if shown > RC_LEDGER_RING_ENTRIES 'cap'
			shown = RC_LEDGER_RING_ENTRIES
		end 'cap'
		printError("  refcount-op history (oldest first; last {shown} of {count} ops):\n")

		// When the ring wrapped, the oldest retained entry sits at `head` (the
		// next slot to be overwritten); otherwise entries fill [0, count).
		var idx = 0
		if count > RC_LEDGER_RING_ENTRIES 'wrapped'
			idx = __Internals.loadIndirect(block + RC_LEDGER_OFF_HEAD)
		end 'wrapped'

		var shownCount = 0
		while shownCount < shown 'each'
			let entry = block + RC_LEDGER_OFF_ENTRIES + idx * RC_LEDGER_ENTRY_SIZE
			let entKind = __Internals.loadIndirect(entry + 0)
			let entRc = __Internals.loadIndirect(entry + 8)
			let entRa = __Internals.loadIndirect(entry + 16)
			printError("    {__rc_kind_name(entKind)} -> rc {entRc}   @\n")
			__rc_print_free_frame(entRa)
			idx = idx + 1
			if idx == RC_LEDGER_RING_ENTRIES 'ringWrap'
				idx = 0
			end 'ringWrap'
			shownCount = shownCount + 1
		end 'each'
	end '__rc_ledger_dump'

	// Walk the frame-pointer chain from the over-release site, symbolizing each
	// return address in-process (same `mrt_panic_print_frame` path the free-site
	// chain uses). `skipFrames` drops the leading mm/sanitizer plumbing frames
	// (the tagged decref entry + this report path); the rest name the Maxon code
	// that actually issued the imbalanced decref. wasm has no fp chain
	// (`loadFramePtr` yields 0) and degrades to nothing.
	function __rc_print_backtrace_skipping(skipFrames MachineWord, maxFrames MachineWord)
		var fp = __Internals.loadFramePtr()
		var dropped = 0
		while dropped < skipFrames and fp != 0 'skip'
			fp = __Internals.loadIndirect(fp)
			dropped = dropped + 1
		end 'skip'

		var printed = 0
		while printed < maxFrames and fp != 0 'walk'
			__rc_print_free_frame(__Internals.loadIndirect(fp + 8))
			fp = __Internals.loadIndirect(fp)
			printed = printed + 1
		end 'walk'
	end '__rc_print_backtrace_skipping'

	// The OVER-RELEASE report: a tagged decref drove `userPtr`'s refcount below
	// zero (prior <= 0) while the object was still LIVE (not yet poisoned). Prints
	// the over-releasing op's KIND, the object's full refcount-op history, and a
	// symbolized backtrace of the release site, then panics. This is the ledger's
	// primary localization output for the fixpoint hunt.
	function __rc_report_over_release(userPtr MachineWord, kind MachineWord)
		printError("rc-sanitize: OVER-RELEASE of object 0x{userPtr:016x} — this decref drove the refcount below zero\n")
		printError("  over-releasing op KIND: {__rc_kind_name(kind)}\n")
		__rc_ledger_dump(userPtr)
		printError("  over-release site (innermost first; leading mm/sanitizer frames skipped):\n")
		__rc_print_backtrace_skipping(RC_OVER_RELEASE_SKIP_FRAMES, maxFrames: RC_OVER_RELEASE_MAX_FRAMES)
		panic("rc-sanitize: over-release of 0x{userPtr:016x} (kind {__rc_kind_name(kind)})")
	end '__rc_report_over_release'

	// An obviously-invalid refcount-op "pointer": null, inside the never-mapped
	// low-64K page, or not 8-aligned (every mm user pointer is slot_base + 32 of
	// an 8-aligned slab/OS allocation, and null is only legal on the maybenull /
	// drop paths, which return before this check). Probing `ptr - 8` on such a
	// value faults INSIDE the sanitizer with a bare rip/addr line and no
	// attribution — exactly the crash class this check converts into a named,
	// backtraced report. No ledger to dump: the value never was an object.
	function __rc_check_invalid_ptr(ptr MachineWord, kind MachineWord)
		var invalid = 0

		if ptr < 65536 'lowPage'
			invalid = 1
		end 'lowPage'

		if (ptr and 7) != 0 'misaligned'
			invalid = 1
		end 'misaligned'

		if invalid == 1 'report'
			printError("rc-sanitize: refcount op on INVALID pointer 0x{ptr:016x} — not a plausible heap object\n")
			printError("  op KIND: {__rc_kind_name(kind)}\n")
			printError("  issued by (innermost first; leading frames are mm/sanitizer plumbing):\n")
			__rc_print_backtrace_skipping(1, maxFrames: RC_OVER_RELEASE_MAX_FRAMES)
			panic("rc-sanitize: refcount op on invalid pointer 0x{ptr:016x} (kind {__rc_kind_name(kind)})")
		end 'report'
	end '__rc_check_invalid_ptr'

	// Tagged refcount entries. The compiler emits these (with a constant KIND arg)
	// in a `--rc-sanitize` build; a default build emits the plain 1-arg forms and
	// never references these — so the whole tagged surface is sanitizer-only.

	// Tagged incref: freed-touch check (naming the emission kind), atomic +1,
	// record (kind, rc-after, caller-ra). The caller-ra is `[rbp+8]` — the return
	// address into the Maxon function that issued this incref (the emission site).
	function __mm_incref_tagged(ptr MachineWord, kind MachineWord)
		let ra = __Internals.loadIndirect(__Internals.loadFramePtr() + 8)
		__rc_check_invalid_ptr(ptr, kind: kind)
		if __Internals.loadIndirect(ptr - 8) == RC_SANITIZE_POISON_RC 'freedTouch'
			__rc_report_freed_touch(ptr, kind: RC_TOUCH_INCREF, rcOpKind: kind)
		end 'freedTouch'
		let prior = __Internals.atomicXadd(ptr - 8, value: 1)
		__rc_ledger_record(ptr, kind: kind, rcAfter: prior + 1, ra: ra)
	end '__mm_incref_tagged'

	// Tagged strict decref BODY, taking the pre-captured caller-ra so the null-
	// tolerant wrapper can attribute the op to the PARSER frame (its own caller)
	// rather than to the wrapper.
	function __mm_decref_tagged_ra(ptr MachineWord, kind MachineWord, ra MachineWord)
		__rc_check_invalid_ptr(ptr, kind: kind)
		if __Internals.loadIndirect(ptr - 8) == RC_SANITIZE_POISON_RC 'freedTouch'
			__rc_report_freed_touch(ptr, kind: RC_TOUCH_DECREF, rcOpKind: kind)
		end 'freedTouch'
		let prior = __Internals.atomicXadd(ptr - 8, value: -1)
		__rc_ledger_record(ptr, kind: kind, rcAfter: prior - 1, ra: ra)
		if prior == 1 'lastRef'
			__mm_free(ptr)
		end 'lastRef'
		if __mm_is_over_release(prior) 'overRelease'
			__rc_report_over_release(ptr, kind: kind)
		end 'overRelease'
	end '__mm_decref_tagged_ra'

	// Tagged strict decref: freed-touch check (naming the emission kind), atomic
	// -1, record (kind, rc-after), free at the 1->0 transition, and OVER-RELEASE
	// report when `__mm_is_over_release`.
	function __mm_decref_tagged(ptr MachineWord, kind MachineWord)
		let ra = __Internals.loadIndirect(__Internals.loadFramePtr() + 8)
		__mm_decref_tagged_ra(ptr, kind: kind, ra: ra)
	end '__mm_decref_tagged'

	// Tagged null-tolerant decref (the `__mm_decref_maybenull_helper` analogue):
	// tolerates exactly null, otherwise the strict tagged body.
	function __mm_decref_maybenull_tagged(ptr MachineWord, kind MachineWord)
		let ra = __Internals.loadIndirect(__Internals.loadFramePtr() + 8)
		if ptr == 0 'null'
			return
		end 'null'
		__mm_decref_tagged_ra(ptr, kind: kind, ra: ra)
	end '__mm_decref_maybenull_tagged'

	// Tagged owner-drop — MUST mirror `__mm_drop` exactly (balance parity): rc==0
	// frees the sole owner; rc>0 decrefs the extra reference AND frees at the 1->0
	// transition (the plain `__mm_drop` reaches that free by delegating to
	// `__mm_decref`). Omitting the free-at-`prior==1` here decouples rc from the
	// allocation lifetime and cascades into downstream double-frees. Records one op
	// either way.
	function __mm_drop_tagged(ptr MachineWord, kind MachineWord)
		let ra = __Internals.loadIndirect(__Internals.loadFramePtr() + 8)
		if ptr == 0 'null'
			return
		end 'null'
		__rc_check_invalid_ptr(ptr, kind: kind)
		let rc = __Internals.loadIndirect(ptr - 8)
		if rc == RC_SANITIZE_POISON_RC 'freedTouch'
			__rc_report_freed_touch(ptr, kind: RC_TOUCH_DROP, rcOpKind: kind)
		end 'freedTouch'
		if rc == 0 'soleOwner'
			__rc_ledger_record(ptr, kind: kind, rcAfter: 0, ra: ra)
			__mm_free(ptr)
			return
		end 'soleOwner'
		let prior = __Internals.atomicXadd(ptr - 8, value: -1)
		__rc_ledger_record(ptr, kind: kind, rcAfter: prior - 1, ra: ra)
		if prior == 1 'lastRef'
			__mm_free(ptr)
		end 'lastRef'
		if __mm_is_over_release(prior) 'overRelease'
			__rc_report_over_release(ptr, kind: kind)
		end 'overRelease'
	end '__mm_drop_tagged'
#endif

#if leakReport(true)

	// =========================================================================
	// Per-destructor LEAK CENSUS (`--leak-report`).
	//
	// A tiny per-DESTRUCTOR histogram of live allocations. `__mm_alloc` bumps the
	// bucket for the allocation's destructor; `__mm_free` (and the mm_realloc
	// old-buffer untrack patch) decrements it. At process exit `__leak_report_dump`
	// walks the histogram and prints, for every destructor with a non-zero live
	// count, one `LEAK-DTOR count=<c> off=0x<offset>` line — `offset` being the
	// destructor's address minus mrt_start's, so the numbers are ASLR-invariant and
	// symbolize offline via `llvm-nm` (see docs/leak-report.md). This is the
	// PROVEN census recipe made permanent: the destructor is recorded at ALLOC
	// time (when the object is unquestionably live) and tallied at EXIT from the
	// side histogram — we NEVER read `[user_ptr-24]` of a possibly-freed object at
	// walk time.
	//
	// STORAGE. An open-addressed (linear-probe) hash table keyed by destructor
	// address, `LEAK_TABLE_BUCKETS` buckets of `LEAK_BUCKET_SIZE` bytes
	// ({key, live-count}). The table is a single runtime slab/OS-page allocation
	// (NOT the slab it instruments, and NOT `__mm_alloc` — it must not count
	// itself), lazily allocated on the first non-raw record and never freed. Only a
	// 32-byte `__mm_leak_ctl` anchor lives in .data (well under the 4KB zero-init
	// ceiling larger globals hit). Distinct destructors number in the low
	// thousands even for a full self-compile, so a 65536-bucket table stays far
	// below the load factor where linear probing degrades.
	//
	// Raw buffers (`destructor == 0`, e.g. element-buffer allocations) share the
	// empty-bucket sentinel (key 0), so they are counted separately in the ctl's
	// `raw_live` word instead of the table.
	//
	// CONCURRENCY. Counts move via atomics; a destructor's bucket is claimed once
	// via CAS (first sight). The one-time lazy table alloc is guarded by the slab
	// lock. All of it is `#if leakReport(true)`-gated: a default build allocates no
	// table, and `__mm_alloc`/`__mm_free` never reference these helpers, so the
	// alloc/free hot path is byte-identical to a build where the census does not
	// exist.
	//
	// `__mm_leak_ctl` field layout (registered in
	// LowerMaxonToStd.registerSlabAndMmGlobalsForDataSection):
	//   +0  table_base — bucket-array pointer, 0 until lazily OS-allocated
	//   +8  capacity   — bucket count, stamped at lazy-alloc (0 = unallocated)
	//   +16 raw_live   — atomic live count of destructor==0 (raw) buffers
	//   +24 dumping    — 1 while __leak_report_dump prints, so its own String
	//                    temporaries' allocs/frees don't re-enter the histogram
	let LEAK_CTL_TABLE = 0
	let LEAK_CTL_CAPACITY = 8
	let LEAK_CTL_RAW_LIVE = 16
	let LEAK_CTL_DUMPING = 24

	// Bucket: {key: destructor address, count: live allocations, sampleRA: a
	// representative one-deep __mm_alloc-site return address, sampleRA2: the
	// validated TWO-deep caller of that site (0 when unwalkable)}. 32 bytes.
	// sampleRA turns the per-type census into a per-SITE lead — symbolize it to name
	// the CONSTRUCTOR that allocated the leaking object (e.g. Array.init for the Array
	// family). sampleRA2 climbs one frame further to name the constructor's OWN
	// caller — for Array literals, the function that wrote `[...]` — turning "which
	// type leaks" plus "who built it" into "who requested it". The pair is a coherent
	// snapshot of ONE concrete allocation, resampled toward the bulk on power-of-two
	// milestones (see __leak_count_inc) so it names the DOMINANT allocation site
	// rather than the incidental first one.
	let LEAK_BUCKET_SIZE = 32
	let LEAK_BUCKET_KEY = 0
	let LEAK_BUCKET_COUNT = 8
	let LEAK_BUCKET_SAMPLE_RA = 16
	let LEAK_BUCKET_SAMPLE_RA2 = 24

	// Upper bound on a single stack frame's span (rbp-to-caller-rbp distance) for the
	// two-deep alloc-site walk (__leak_walk_2deep). A candidate caller frame pointer
	// beyond this window above ours is treated as a corrupt/absent frame link and the
	// walk falls back to 0 rather than dereferencing it. 1 MiB dwarfs any real single
	// frame (even the compiler's largest spill-heavy frames stay well under it) while
	// rejecting garbage — the same "bound the walk to a sane window" discipline
	// mrt_panic_walk_frames applies to the fault-time backtrace (runtime.std).
	let LEAK_STACK_WALK_WINDOW = 1048576

	// 65536 buckets × 32 bytes = 2 MiB, lazily OS-allocated (zero-filled). Power of
	// two so the hash masks with `BUCKETS - 1`. Kept literals — top-level `let`
	// accepts only a literal; update the two together.
	let LEAK_TABLE_BUCKETS = 65536
	let LEAK_TABLE_BYTES = 2097152

	// Lazily OS-allocate the bucket array on the first non-raw record. Guarded by
	// the slab lock (a one-time cost); `table_base` is published LAST so a racing
	// recorder sees either 0 (and contends the lock) or a fully-initialized table.
	// osAllocPages hands back zero-filled pages, so every bucket starts {key:0,
	// count:0} and key==0 correctly reads as an empty slot.
	function __leak_ctl_ensure()
		let ctl = __Internals.leakCtlAddr()
		if __Internals.loadIndirect(ctl + LEAK_CTL_TABLE) != 0 'ready'
			return
		end 'ready'
		__Internals.osLockAcquire(__Internals.slabLockAddr())
		if __Internals.loadIndirect(ctl + LEAK_CTL_TABLE) == 0 'stillUnset'
			let table = __slab_assert_os_alloc(__Internals.osAllocPages(LEAK_TABLE_BYTES))
			__Internals.storeIndirect(ctl + LEAK_CTL_CAPACITY, value: LEAK_TABLE_BUCKETS)
			__Internals.storeIndirect(ctl + LEAK_CTL_TABLE, value: table)
		end 'stillUnset'
		__Internals.osLockRelease(__Internals.slabLockAddr())
	end '__leak_ctl_ensure'

	// Hash a destructor code address to a starting bucket index. Destructors are
	// 16-byte-aligned .text pointers, so the low bits carry no entropy — fold two
	// shifted copies and mask to the (power-of-two) table size.
	function __leak_hash(dtor MachineWord) returns MachineWord
		let mixed = (dtor shr 4) xor (dtor shr 17)
		return mixed and (LEAK_TABLE_BUCKETS - 1)
	end '__leak_hash'

	// Find `dtor`'s bucket via linear probing. When `claim` is true an empty bucket
	// is atomically claimed for `dtor` (first-sight insert); when false an empty
	// bucket means "never recorded" and returns 0. Returns the bucket address, or 0
	// on not-found. A full table (more than LEAK_TABLE_BUCKETS distinct
	// destructors) would silently under-report, so it exits loudly instead.
	function __leak_probe(dtor MachineWord, claim bool) returns MachineWord
		let table = __Internals.loadIndirect(__Internals.leakCtlAddr() + LEAK_CTL_TABLE)
		if table == 0 'noTable'
			return 0
		end 'noTable'
		var idx = __leak_hash(dtor)
		var probes = 0
		while probes < LEAK_TABLE_BUCKETS 'probe'
			let bucket = table + idx * LEAK_BUCKET_SIZE
			let key = __Internals.loadIndirect(bucket + LEAK_BUCKET_KEY)
			if key == dtor 'hit'
				return bucket
			end 'hit'
			if key == 0 'empty'
				if not claim 'noClaim'
					return 0
				end 'noClaim'
				// Race-safe claim: CAS 0 -> dtor. On success we own the bucket; on
				// failure another recorder claimed it — if it is now OUR dtor, use
				// it, otherwise keep probing.
				if __Internals.atomicCas(bucket + LEAK_BUCKET_KEY, old: 0, new: dtor) != 0 'claimed'
					return bucket
				end 'claimed'
				if __Internals.loadIndirect(bucket + LEAK_BUCKET_KEY) == dtor 'wonByOther'
					return bucket
				end 'wonByOther'
			end 'empty'
			idx = idx + 1
			if idx == LEAK_TABLE_BUCKETS 'wrap'
				idx = 0
			end 'wrap'
			probes = probes + 1
		end 'probe'
		// 138 = leak-census table full (raise LEAK_TABLE_BUCKETS).
		__Internals.osExit(138)
		return 0
	end '__leak_probe'

	// Frame-validated TWO-deep alloc-site walk. `allocFramePtr` is __mm_alloc's own
	// rbp (read INLINE at the __mm_alloc call site, so it names __mm_alloc's frame,
	// not this helper's). The one-deep sample already names the direct caller of
	// __mm_alloc (the per-type constructor, e.g. Array.init); this climbs ONE frame
	// further to name the constructor's caller — the code that requested the object.
	//
	// The single dereference this performs, `[callerFp + 8]`, is the risky one: a
	// naive deeper walk faults if any intervening frame corrupts the saved-rbp link.
	// Guard it exactly the way mrt_panic_walk_frames guards the fault-time backtrace
	// (runtime.std): the candidate caller frame pointer must strictly ASCEND (a
	// caller's frame sits at a higher address on the downward-growing stack), be
	// 8-aligned, and lie within LEAK_STACK_WALK_WINDOW of our frame; the resulting
	// return address must land inside .text. Any failed link returns 0 (unwalkable)
	// rather than dereferencing garbage. Because every Maxon/runtime frame maintains
	// a frame pointer (the x64/arm64 prologues emit an unconditional push rbp / stp
	// x29), `callerFp` is in practice always a genuine, mapped caller frame — the
	// guards degrade the rare corrupt/absent-link case to a missing sample. wasm has
	// no frame-pointer chain (loadFramePtr yields 0) and returns 0 immediately.
	function __leak_walk_2deep(allocFramePtr MachineWord) returns MachineWord
		if allocFramePtr == 0 'noFp'
			return 0
		end 'noFp'

		// callerFp = the direct caller's saved frame pointer, read from __mm_alloc's
		// own saved-rbp slot (reliably stored by __mm_alloc's prologue).
		let callerFp = __Internals.loadIndirect(allocFramePtr)
		if callerFp <= allocFramePtr 'notAscending'
			return 0
		end 'notAscending'
		if (callerFp and 7) != 0 'misaligned'
			return 0
		end 'misaligned'
		if callerFp - allocFramePtr > LEAK_STACK_WALK_WINDOW 'tooFar'
			return 0
		end 'tooFar'

		// Two-deep return address: into the constructor's caller. Validate it lands in .text by
		// bounding the ADDRESS against the region, exactly as `__rc_print_free_frame` does — the
		// symbol table is emitted immediately after the code region, so it is .text's exclusive
		// upper bound.
		let ra2 = __Internals.loadIndirect(callerFp + 8)
		if ra2 >= __Internals.mrtStartAddr() and ra2 < __Internals.symtableAddr() 'inText'
			return ra2
		end 'inText'

		return 0
	end '__leak_walk_2deep'

	// Record one live allocation of destructor `dtor` allocated at code address
	// `allocRA` (the one-deep return address into __mm_alloc's caller) with
	// `allocRA2` the validated two-deep caller (0 when unwalkable). Raw buffers
	// (dtor==0) are tallied in the ctl's raw_live word; everything else lands in its
	// bucket, which keeps a representative `allocRA`/`allocRA2` sample PAIR for that
	// type. Called by __mm_alloc under `#if leakReport(true)`. No-op while the exit
	// dump is printing (its String temporaries must not perturb the frozen histogram).
	//
	// SAMPLE POLICY — power-of-two milestone resample (NOT first-seen). Keeping the
	// FIRST allocation biases the sample toward whatever runs earliest, which for a
	// destructor shared between (a) a lazily-run stdlib global initializer holding ONE
	// process-lifetime object and (b) a SYSTEMATIC pipeline leaker allocating thousands
	// is always the incidental global (a) — masking the leaker (b) the census exists to
	// find. Instead the pair is overwritten whenever the post-increment live count is a
	// power of two (1, 2, 4, …, 2048, …). The retained sample is therefore drawn from
	// the highest power-of-two milestone ≤ count, i.e. deep in the bulk, so it names a
	// representative allocation of the DOMINANT (most-allocated) site. Cheap: one
	// power-of-two test, no RNG. Under-report of a rare site is acceptable — the census
	// localizes the leak that dominates the count, which is the one worth fixing.
	function __leak_count_inc(dtor MachineWord, allocRA MachineWord, allocRA2 MachineWord)
		if __Internals.loadIndirect(__Internals.leakCtlAddr() + LEAK_CTL_DUMPING) != 0 'dumping'
			return
		end 'dumping'
		if dtor == 0 'raw'
			__Internals.atomicInc(__Internals.leakCtlAddr() + LEAK_CTL_RAW_LIVE)
			return
		end 'raw'
		__leak_ctl_ensure()
		let bucket = __leak_probe(dtor, claim: true)
		if bucket != 0 'have'
			// atomicXadd returns the PRIOR count, so newCount is this allocation's
			// 1-based position in the bucket.
			let prior = __Internals.atomicXadd(bucket + LEAK_BUCKET_COUNT, value: 1)
			let newCount = prior + 1
			if (newCount and (newCount - 1)) == 0 'milestone'
				// Store the two-deep partner FIRST, then the one-deep sample: the
				// one-deep word is the gate the reader checks, so publishing it last
				// keeps the pair coherent under a concurrent recorder.
				__Internals.storeIndirect(bucket + LEAK_BUCKET_SAMPLE_RA2, value: allocRA2)
				__Internals.storeIndirect(bucket + LEAK_BUCKET_SAMPLE_RA, value: allocRA)
			end 'milestone'
		end 'have'
	end '__leak_count_inc'

	// Swap two 32-byte buckets in place (selection-sort primitive; operates on the
	// census's own OS-allocated array, so no allocation and no tracked memory).
	function __leak_swap_buckets(a MachineWord, b MachineWord)
		let ak = __Internals.loadIndirect(a + LEAK_BUCKET_KEY)
		let ac = __Internals.loadIndirect(a + LEAK_BUCKET_COUNT)
		let ar = __Internals.loadIndirect(a + LEAK_BUCKET_SAMPLE_RA)
		let ar2 = __Internals.loadIndirect(a + LEAK_BUCKET_SAMPLE_RA2)
		__Internals.storeIndirect(a + LEAK_BUCKET_KEY, value: __Internals.loadIndirect(b + LEAK_BUCKET_KEY))
		__Internals.storeIndirect(a + LEAK_BUCKET_COUNT, value: __Internals.loadIndirect(b + LEAK_BUCKET_COUNT))
		__Internals.storeIndirect(a + LEAK_BUCKET_SAMPLE_RA, value: __Internals.loadIndirect(b + LEAK_BUCKET_SAMPLE_RA))
		__Internals.storeIndirect(a + LEAK_BUCKET_SAMPLE_RA2, value: __Internals.loadIndirect(b + LEAK_BUCKET_SAMPLE_RA2))
		__Internals.storeIndirect(b + LEAK_BUCKET_KEY, value: ak)
		__Internals.storeIndirect(b + LEAK_BUCKET_COUNT, value: ac)
		__Internals.storeIndirect(b + LEAK_BUCKET_SAMPLE_RA, value: ar)
		__Internals.storeIndirect(b + LEAK_BUCKET_SAMPLE_RA2, value: ar2)
	end '__leak_swap_buckets'

	// Process-exit dump of the per-destructor census to stderr. Injected into
	// mrt_start right before the `mrt_leak_check` gate by the leak-report backend
	// patch (BackendDispatch.patchMrtStartLeakReport), so it runs after main +
	// global cleanup + GT drain — `__mm_alloc_count` is then the true leak count.
	//
	// The `dumping` flag freezes the histogram: printing builds interpolated
	// String temporaries that themselves allocate/free, and without the flag those
	// (raw-buffer) allocations would perturb `raw_live` mid-report. `total`
	// (`__mm_alloc_count`) is snapshotted up front for the same reason; it must
	// still equal `raw_live + Σ bucket counts`, an invariant the offline census
	// verifies.
	//
	// Non-empty buckets are compacted to the front of the array in place (write
	// index never exceeds read index, so the pass is safe) and selection-sorted by
	// count descending before printing — no heap allocation, so the walk never
	// counts itself.
	function __leak_report_dump()
		let ctl = __Internals.leakCtlAddr()
		__Internals.storeIndirect(ctl + LEAK_CTL_DUMPING, value: 1)

		let total = __Internals.loadIndirect(__Internals.mmAllocCountAddr())
		let rawLive = __Internals.loadIndirect(ctl + LEAK_CTL_RAW_LIVE)
		let mrtStart = __Internals.mrtStartAddr()
		let table = __Internals.loadIndirect(ctl + LEAK_CTL_TABLE)
		let capacity = __Internals.loadIndirect(ctl + LEAK_CTL_CAPACITY)

		// Compact every bucket with a non-zero live count to the front of the array.
		var live = 0
		if table != 0 'haveTable'
			var read = 0
			while read < capacity 'compact'
				let src = table + read * LEAK_BUCKET_SIZE
				let count = __Internals.loadIndirect(src + LEAK_BUCKET_COUNT)
				if count != 0 'nonEmpty'
					let dst = table + live * LEAK_BUCKET_SIZE
					__Internals.storeIndirect(dst + LEAK_BUCKET_KEY, value: __Internals.loadIndirect(src + LEAK_BUCKET_KEY))
					__Internals.storeIndirect(dst + LEAK_BUCKET_COUNT, value: count)
					__Internals.storeIndirect(dst + LEAK_BUCKET_SAMPLE_RA, value: __Internals.loadIndirect(src + LEAK_BUCKET_SAMPLE_RA))
					__Internals.storeIndirect(dst + LEAK_BUCKET_SAMPLE_RA2, value: __Internals.loadIndirect(src + LEAK_BUCKET_SAMPLE_RA2))
					live = live + 1
				end 'nonEmpty'
				read = read + 1
			end 'compact'

			// Selection sort the [0, live) prefix by count descending.
			var i = 0
			while i < live 'selOuter'
				var best = i
				var j = i + 1
				while j < live 'selInner'
					let cj = __Internals.loadIndirect(table + j * LEAK_BUCKET_SIZE + LEAK_BUCKET_COUNT)
					let cbest = __Internals.loadIndirect(table + best * LEAK_BUCKET_SIZE + LEAK_BUCKET_COUNT)
					if cj > cbest 'newBest'
						best = j
					end 'newBest'
					j = j + 1
				end 'selInner'
				if best != i 'swap'
					__leak_swap_buckets(table + i * LEAK_BUCKET_SIZE, b: table + best * LEAK_BUCKET_SIZE)
				end 'swap'
				i = i + 1
			end 'selOuter'
		end 'haveTable'

		printError("LEAK-REPORT-BEGIN total={total} distinct={live} raw={rawLive}\n")
		var k = 0
		while k < live 'emit'
			let bucket = table + k * LEAK_BUCKET_SIZE
			let dtor = __Internals.loadIndirect(bucket + LEAK_BUCKET_KEY)
			let count = __Internals.loadIndirect(bucket + LEAK_BUCKET_COUNT)
			let sampleRA = __Internals.loadIndirect(bucket + LEAK_BUCKET_SAMPLE_RA)
			let sampleRA2 = __Internals.loadIndirect(bucket + LEAK_BUCKET_SAMPLE_RA2)
			let off = dtor - mrtStart
			let allocOff = sampleRA - mrtStart

			// Two-deep sample is 0 when the walk was unwalkable — emit alloc2=0x0
			// rather than a wrapped `0 - mrtStart` so the reader sees "no frame".
			var alloc2Off = 0
			if sampleRA2 != 0 'have2'
				alloc2Off = sampleRA2 - mrtStart
			end 'have2'

			printError("LEAK-DTOR count={count} off=0x{off:x} alloc=0x{allocOff:x} alloc2=0x{alloc2Off:x}\n")
			k = k + 1
		end 'emit'
		if rawLive != 0 'hasRaw'
			printError("LEAK-RAW count={rawLive}\n")
		end 'hasRaw'
		printError("LEAK-REPORT-END\n")

		__Internals.storeIndirect(ctl + LEAK_CTL_DUMPING, value: 0)
	end '__leak_report_dump'
#endif

// Untrack one freed allocation of destructor `dtor` from the per-destructor leak
// census. Called by `__mm_free` (under `#if leakReport(true)`) AND unconditionally
// by `mm_realloc` (runtime.std), which frees the old buffer DIRECTLY — bypassing
// `__mm_free` — so its census entry would otherwise leak a permanent +1 skew per
// realloc. Because mm_realloc's call is unconditional and mm_realloc's body may be
// served from the stdlib cache (so it cannot be reliably IR-patched at link time),
// this function must ALWAYS exist — hence it lives OUTSIDE the census `#if` block,
// with its body gated internally: real work when the census is on, an empty no-op
// (one `ret`) when off. `destructor` is always the value the caller already read
// from the still-live object's mm header, so a freed header is never re-read.
function __leak_count_dec(destructor MachineWord)
	#if leakReport(true)
		if __Internals.loadIndirect(__Internals.leakCtlAddr() + LEAK_CTL_DUMPING) != 0 'dumping'
			return
		end 'dumping'
		if destructor == 0 'raw'
			__Internals.atomicDec(__Internals.leakCtlAddr() + LEAK_CTL_RAW_LIVE)
			return
		end 'raw'
		let bucket = __leak_probe(destructor, claim: false)
		if bucket != 0 'have'
			__Internals.atomicDec(bucket + LEAK_BUCKET_COUNT)
		end 'have'
	#else
		// Census disabled: no-op. Discard the (unused) destructor so a non-census
		// build carries an empty untrack that mm_realloc can still call.
		_ = destructor
	#endif
end '__leak_count_dec'

// Allocate a tracked block of `size` bytes through the slab allocator.
// Layout: 32-byte mm header followed by the user region. The first header
// word sits at slot_base+0 so the destructor / size / refcount fields keep
// their historical `user_ptr - 24 / -16 / -8` offsets (every destructor and
// the COW path reads those, so leaving them put keeps the header layout
// stable). That word is reserved (always 0) — it preserves the trailing
// offsets without carrying any payload.
//   slot_base + 0  : reserved   (always 0)
//   slot_base + 8  : destructor (function pointer; 0 means "no destructor")
//   slot_base + 16 : size       (user-region size)
//   slot_base + 24 : refcount   (initialized to 0 — alloc-at-0 model, mirrors
//                                 the C# bootstrap: a fresh allocation owns NO
//                                 reference; the binding/field store that takes
//                                 ownership increfs it to 1. A value never bound
//                                 anywhere is freed at its producing scope's exit
//                                 decref of rc 0→... — see __mm_decref guard.)
//   user_ptr       = slot_base + 32 (returned)
// The user region is ZEROED (the slab guarantees it). `__mm_alloc_raw` is the
// opt-out — see the audit rule on `__slab_alloc_raw` before using it.
function __mm_alloc(size MachineWord, destructor MachineWord) returns MachineWord
	return __mm_alloc_needzero(size, destructor: destructor, needzero: 1)
end '__mm_alloc'

// Tracked allocation whose user region is NOT zeroed. Go's `needzero: false`.
// Same audit rule as `__slab_alloc_raw`: the caller must write every byte before
// anything can read it, and the region must never be walked as managed pointers.
function __mm_alloc_raw(size MachineWord, destructor MachineWord) returns MachineWord
	return __mm_alloc_needzero(size, destructor: destructor, needzero: 0)
end '__mm_alloc_raw'

function __mm_alloc_needzero(size MachineWord, destructor MachineWord, needzero MachineWord) returns MachineWord
	// Zero-sized requests get one byte, so every allocation has a distinct address. Written as
	// `== 0` rather than `< 1`: `size` is an unsigned `MachineWord`, under which the two are the
	// same test, and the equality says which one is meant without depending on the reading.
	var clampedSize = size
	if size == 0 'clamp'
		clampedSize = 1
	end 'clamp'
	__Internals.atomicInc(__Internals.mmAllocCountAddr())
	// `--leak-report`: tally this allocation under its destructor in the
	// per-destructor census (raw dtor==0 buffers go to the ctl's raw_live word).
	// Kept adjacent to the __mm_alloc_count bump so the two stay in lockstep. Two
	// alloc-site samples, both taken from __mm_alloc's OWN frame pointer (read inline
	// here so `loadFramePtr` names __mm_alloc's frame):
	//   allocRA  — `[frame_ptr + 8]`, the ONE-deep return address = the direct caller
	//              of __mm_alloc (a per-type constructor, e.g. Array.init, or code
	//              that allocates the record directly).
	//   allocRA2 — the validated TWO-deep caller (__leak_walk_2deep), naming that
	//              constructor's OWN caller — for the Array-literal family, the
	//              function that wrote `[...]`. A bare deeper read would fault on a
	//              corrupt/absent frame link, so the walk validates the link first
	//              and yields 0 when unwalkable.
	// The hot path is byte-identical when the flag is off (region parsed away).
	#if leakReport(true)
		__leak_count_inc(destructor, allocRA: __Internals.loadIndirect(__Internals.loadFramePtr() + 8), allocRA2: __leak_walk_2deep(__Internals.loadFramePtr()))
	#endif
	// The 32-byte header is fully written below on BOTH paths, so only the user
	// region's zeroing is in question — which is exactly what `needzero` selects.
	var slotBase = 0
	if needzero != 0 'zeroed'
		slotBase = __slab_alloc(clampedSize + 32)
	end 'zeroed' else 'raw'
		slotBase = __slab_alloc_raw(clampedSize + 32)
	end 'raw'
	// The first header word is reserved (always 0). It is kept so the
	// destructor / size / refcount offsets stay at their historical
	// `user_ptr - 24 / -16 / -8`. Under `--rc-sanitize` it instead carries this
	// object's refcount-op history ring block (0 on arena exhaustion); nothing
	// else reads this word, and a default build stores 0 here exactly as before,
	// so the emitted bytes are identical when the sanitizer is off.
	#if rcSanitize(true)
		__Internals.storeIndirect(slotBase, value: __rc_ledger_attach())
	#else
		__Internals.storeIndirect(slotBase, value: 0)
	#endif
	__Internals.storeIndirect(slotBase + 8, value: destructor)
	__Internals.storeIndirect(slotBase + 16, value: clampedSize)
	// Refcount-insertion (Step 2): a fresh allocation owns NO reference — the
	// refcount header starts at 0 (alloc-at-0). With lowering no longer emitting
	// any incref, the binding/field store that takes ownership is the first +1,
	// supplied by the late SSA insert-refcounts pass. (See the header layout
	// comment above and the __mm_decref rc-guard.)
	__Internals.storeIndirect(slotBase + 24, value: 0)
	return slotBase + 32
end '__mm_alloc_needzero'

// Release a tracked allocation. Reads the destructor from [ptr - 24] and
// invokes it (if non-null) before slab-freeing. The destructor is
// responsible for decreffing managed fields stored inside the user region;
// __mm_free only releases the surrounding allocation.
//
// Tolerates ptr == 0 as a no-op so callers don't have to null-check.
function __mm_free(ptr MachineWord)
	if ptr == 0 'nullPtr'
		return
	end 'nullPtr'

	// Sanitizer: a poisoned refcount word here means this allocation was already
	// freed — report the double-free BEFORE the destructor read, so a poisoned
	// destructor word is never indirect-called.
	#if rcSanitize(true)
		__rc_check_freed_touch(ptr, kind: RC_TOUCH_MM_FREE)
	#endif
	let destructor = __Internals.loadIndirect(ptr - 24)
	if destructor != 0 'hasDtor'
		__Internals.indirectCall1(destructor, arg: ptr)
	end 'hasDtor'
	__Internals.atomicDec(__Internals.mmAllocCountAddr())
	// `--leak-report`: untrack this allocation from the per-destructor census.
	// `destructor` here is the value already read from the mm header of the (still
	// live) object — we never re-read a freed header. Kept adjacent to the
	// __mm_alloc_count decrement, and BEFORE the rc-sanitize quarantine early
	// return below, so the census stays balanced on every free path.
	#if leakReport(true)
		__leak_count_dec(destructor)
	#endif
	// slot_base = ptr - 32 (the reserved word is the first header word).
	// rc-sanitize: quarantine the mm slot here (NOT in `__slab_free`) so only slots
	// carrying the mm header + ledger word are poisoned/held; raw `__slab_alloc`
	// buffers that free via `__slab_free` directly are left alone. On age-out the
	// quarantine re-enters `__slab_free` for the real reclaim.
	#if rcSanitize(true)
		if __rc_quarantine_intercept(ptr - 32) 'quarantined'
			return
		end 'quarantined'
	#endif
	__slab_free(ptr - 32)
end '__mm_free'

// =============================================================================
// __ManagedMemory destructor and builtin helpers (Phase 4 migration).
//
// Each helper mirrors the runtime.std body bit-for-bit (the runtime body still
// exists for the C# bootstrap). Throwing helpers return (i64 primary, i64
// errorWire) via the multi-value error ABI: `return X` inside a `throws`
// function lowers to `errorReturn(X, 0)`, and `throw __ManagedMemoryError.case`
// lowers to `errorReturn(0, ord+1)`. The `+1` on the wire keeps 0 reserved
// for "no error in flight" — same convention used by every other throwing
// builtin (lookupVariantOrdinalPlusOne in LowerMaxonToStd.maxon).
//
// __ManagedMemoryError wire map:
//   ordinal | name              | wire
//   0       | indexOutOfBounds  | 1
//   1       | emptySlot         | 2
//   2       | sliceOutOfBounds  | 3
//   3       | invalidLength     | 4
//   4       | invalidCapacity   | 5
//   5       | shiftOutOfBounds  | 6
//   6       | invalidByteRange  | 7
//   7       | invalidAllocation | 8
//
// __ManagedMemory layout (6-field, 48-byte struct, all i64):
//   offset 0  buffer         (heap pointer to mm_alloc'd buffer, or 0)
//   offset 8  length         (live element count)
//   offset 16 capacity       (allocated element slots; -1 = slice, -2 = rdata)
//   offset 24 element_size   (sizeof(Element); 1 for Byte, 8 otherwise)
//   offset 32 parent_ptr     (-1 root; -2 rdata-backed; otherwise parent ptr)
//   offset 40 element_destroy(per-element teardown fn ptr, or 0 — see MM_OFFSET_ELEMENT_DESTROY)
//
// We use `int` rather than `__ManagedMemory` for self/result types — the
// helpers treat MMs as raw pointers and the call site re-stamps the result
// type via refineMmCallResultType.
// =============================================================================

// Single source of truth for the __ManagedMemory record size. Every hand-rolled
// __mm_alloc of a record header references this so the size lives in one place.
// (Does NOT cover element buffers or the separate __ManagedMemoryCursor struct.)
let MANAGED_MEM_RECORD_SIZE = 48

// Named byte-offsets of the five i64 fields in the __ManagedMemory record, and
// the three sentinel values the parent_ptr field can hold. Replacing the magic
// literals at every mm-record access site so the layout lives in one place.
let MM_OFFSET_BUFFER = 0
let MM_OFFSET_LENGTH = 8
let MM_OFFSET_CAPACITY = 16
let MM_OFFSET_ELEMENT_SIZE = 24
let MM_OFFSET_PARENT = 32
let MM_OFFSET_ELEMENT_DESTROY = 40
let MM_PARENT_ROOT = -1
let MM_PARENT_RDATA = -2
let MM_PARENT_UNINIT = 0

// Small-array inline-storage sentinel + budget. When an array's element bytes fit
// within MM_INLINE_CAP_BYTES, `__managed_mem_create_managed` holds the elements
// INLINE right after the record fields in the SAME allocation (buffer@0 points into
// the record's own slab slot) instead of taking a second heap allocation. Such a
// record is marked by parent_ptr == MM_PARENT_INLINE (-3): a NON-pointer sentinel
// (like ROOT/RDATA) so the slice-parent decref never treats it as a heap pointer,
// and NOT a capacity sentinel (capacity stays >= 0 so bounds checks and the COW
// no-copy fast path keep working). The inline bytes are reclaimed when `__mm_free`
// frees the record's own slot — there is no separate buffer to decref. The first
// grow past the inline capacity detaches to a normal external buffer via
// `__managed_mem_cow_check`, after which the record is an ordinary ROOT array.
let MM_PARENT_INLINE = -3
let MM_INLINE_CAP_BYTES = 64

// Bytes of mm header `__mm_alloc` prepends to every user region (`user_ptr =
// slot_base + MM_ALLOC_HEADER_SIZE`; see `__mm_alloc`). The inline path uses it to
// map a requested user-region byte size onto the class the slab will actually serve.
let MM_ALLOC_HEADER_SIZE = 32

// Runtime-readable fields of the per-instantiation layout descriptor blob.
// ⚠ The blob's LENGTH differs between the two compilers that emit one and this
// prose named a THIRD number that neither uses: the self-hosted compiler's image
// is 64 bytes and shv2's is 72 (size@0, alignment@8, elementSize@16, flags@24,
// copyFunc@32, destroyFunc@40, fieldOffsetsPtr@48, elementLogicalSize@56,
// retainFunc@64 — `maxon-shv2/Compiler/IR/LayoutDescriptor.maxon`).
// The OFFSETS mirrored below are the ones both agree on, which is what makes this
// file's reads portable across them; only the total length is a per-compiler fact.
// Only the two fields the
// generic-body element-walk wiring reads at runtime are mirrored here; changing
// either end requires updating the other in lockstep. `flags` bit 0 is set when
// the instance's element type is heap-managed (a String / generic-instance
// pointer, or — after the recursive widening — a struct with managed fields).
// `flags` bit 1 (LAYOUT_FLAG_BIT_PACKED) marks a sub-byte-packed element (bool):
// `elementSize@16` then holds the element's BIT width and the stamp negates it.
let LAYOUT_OFFSET_ELEMENT_SIZE = 16
let LAYOUT_OFFSET_FLAGS = 24
let LAYOUT_OFFSET_DESTROY_FUNC = 40
let LAYOUT_FLAG_HAS_HEAP_REFS = 1
let LAYOUT_FLAG_BIT_PACKED = 2

// Allocate a raw element buffer for an mm record and return it at refcount 1.
// A ROOT `__ManagedMemory`'s `__destruct___ManagedMemory` does exactly ONE
// `__mm_decref(buffer)` at teardown, and `__mm_decref` frees only on the 1->0
// transition (alloc-at-0), so the buffer MUST be rc=1 when stored — a bare
// `__mm_alloc(size, 0, 0)` (rc=0) would have its single ROOT decref go 0->-1 and
// never free → the buffer leaks. This wraps alloc+incref (the same rc=1 contract
// `mrt_alloc` and `mm_realloc` already honor for owned buffers) so every record
// builder (create/slice/cow/from_cstring) shares one place to get an owned
// buffer. destructor=0: the buffer is raw bytes; its element pointers (if any)
// are torn down by the record's element-walk, not the buffer's own destructor.
function __managed_mem_alloc_buffer(byteLen MachineWord) returns MachineWord
	let buf = __mm_alloc(byteLen, destructor: 0)
	__mm_incref(buf)
	// The buffer arrives ZEROED — `__mm_alloc` guarantees it, so this function no
	// longer zeroes it itself (it used to, with a byte-at-a-time loop, on every
	// Array/Map/Set buffer).
	//
	// That guarantee is load-bearing, not a nicety: a container that fills its
	// buffer SPARSELY — a Map/Set hash table writes keys at hashed positions and
	// leaves the rest unwritten — would otherwise have the previous occupant's stale
	// bytes read by the ROOT destructor's element-walk and decref'd as live managed
	// pointers (the String-keyed-map teardown crash). Zeroed slots read null, so the
	// walk's `if slot != 0` guard skips them. This buffer must therefore NEVER be
	// moved to `__mm_alloc_raw`.
	return buf
end '__managed_mem_alloc_buffer'

// Destructor invoked indirectly by mm_free via the destructor function
// pointer baked into the mm_alloc header. Inspects `parent_ptr` (offset 32)
// to decide what to free:
//   parent == -1: root MM — drop our refcount on the (external) buffer
//   parent == -3: inline MM — buffer lives in this record's own slab slot,
//                 nothing to decref (element-walk still runs for managed elements)
//   parent == -2: rdata-backed — buffer lives in .rdata, nothing to free
//   parent == 0:  uninitialized — nothing to free
//   otherwise:    slice view — drop one ref on the parent MM
//
// Returns i64 (always 0) rather than void: indirect calls require a uniform
// signature across every callable destructor, and the wasm backend's
// call_indirect needs the static call-site type to match exactly. The
// returned 0 is silently discarded.
function __destruct___ManagedMemory(self MachineWord) returns MachineWord
	let parent = __Internals.loadIndirect(self + MM_OFFSET_PARENT)
	if parent == MM_PARENT_ROOT or parent == MM_PARENT_INLINE 'ownedWalk'
		// Container element-walk teardown. element_destroy@40 holds the
		// per-element teardown function pointer (or 0 for raw/unmanaged-element
		// buffers). For managed-pointer elements it is &__mm_decref: each live
		// slot in [0, length) carries exactly +1 (push moved the caller's ref in
		// without an incref), so decref-ing the slot value once nets to zero and
		// cascades into the element's own destructor. Walk for records that OWN
		// their buffer — a ROOT with an external buffer OR an INLINE record whose
		// buffer lives in its own slab slot — but never for slice/rdata views,
		// which alias a buffer they do not own (walking them would double-free).
		// The element_destroy==0 gate keeps raw/byte/primitive buffers from being
		// walked (decref-ing a raw int would fault).
		__managed_mem_walk_elements(self)
		if parent == MM_PARENT_ROOT 'extBuf'
			// ONLY external ROOT buffers are a separate allocation to decref. An
			// INLINE record's buffer lives inside this record's own slab slot and is
			// reclaimed when `__mm_free` frees that slot — there is nothing to decref.
			let buffer = __Internals.loadIndirect(self)
			if buffer != 0 'hasBuf'
				__mm_decref(buffer)
			end 'hasBuf'
		end 'extBuf'
		return 0
	end 'ownedWalk'
	if parent == MM_PARENT_RDATA 'rdata'
		return 0
	end 'rdata'
	if parent == MM_PARENT_UNINIT 'uninit'
		return 0
	end 'uninit'
	// Slice view: drop one ref on the parent __ManagedMemory.
	__mm_decref(parent)
	return 0
end '__destruct___ManagedMemory'

// Run the per-element teardown (`element_destroy@40`, &__mm_decref for
// managed-pointer elements) on every live slot in the half-open range
// [start, end). Each live slot carries exactly +1 (push moved the caller's ref
// in without an incref), so one decref nets to zero and cascades into the
// element's own destructor. A 0 `element_destroy` (raw/primitive elements) makes
// this a no-op — decref-ing a raw int would fault.
//
// The single source of truth for partial element teardown: full-record teardown
// (`__managed_mem_walk_elements`), clear, and the shrink path of setLength all
// funnel through here so the element_destroy==0 raw-buffer gate and the per-slot
// null check live in one place. Does NOT touch the buffer or length; callers do.
// Caller guarantees 0 <= start <= end <= length.
function __managed_mem_walk_elements_range(self MachineWord, start BufferCoordinate, end BufferCoordinate)
	let elementDestroy = __Internals.loadIndirect(self + MM_OFFSET_ELEMENT_DESTROY)
	if elementDestroy == 0 'rawElems'
		return
	end 'rawElems'
	let elemSize = __Internals.loadIndirect(self + MM_OFFSET_ELEMENT_SIZE)
	let walkBuf = __Internals.loadIndirect(self)
	if walkBuf == 0 'noBuf'
		return
	end 'noBuf'
	var i = start
	while i < end 'eachElem'
		let slot = __Internals.loadIndirect(walkBuf + i * elemSize)
		if slot != 0 'live'
			// `element_destroy` is `&__mm_decref` (void), so use the void-shaped
			// indirect call — wasm's `call_indirect` type-checks the site against the
			// target's `(i64) -> void` signature (`indirectCall1` would trap as a
			// mismatch). See `lowerInternalsIndirectCall1`.
			__Internals.indirectCallVoid1(elementDestroy, arg: slot)
		end 'live'
		i = i + 1
	end 'eachElem'
end '__managed_mem_walk_elements_range'

// Walk and tear down every live element [0, length) of a ROOT record.
function __managed_mem_walk_elements(self MachineWord)
	let length = __Internals.loadIndirect(self + MM_OFFSET_LENGTH)
	__managed_mem_walk_elements_range(self, start: 0, end: length)
end '__managed_mem_walk_elements'

// ============================================================================
// THE CAPACITY-SLOT INVARIANT
//
//     Every slot in [length, capacity) of an owned buffer reads as ZERO.
//
// This is what makes lengthening the live range safe. `setLength` (and so
// `Array.resize`) does not — CANNOT — initialize the slots it exposes: every
// caller that lengthens the buffer STAGES the value FIRST and publishes it with
// `setLength` SECOND (`push` = set-then-setLength; `insert` = shiftRight +
// set-then-setLength; `Character.fromCodepoint` / string building =
// create + setByte-then-setLength). A `setLength` that zeroed [oldLength,
// newLength) on the way up would erase every one of those values. So the slots
// must ALREADY be zero when they are exposed, and the way to guarantee that is
// to zero them on the way OUT — in the three operations that VACATE a slot
// (`clear`, the shrink path of `setLength`, and `remove`).
//
// Zero is the right value for BOTH element classes, which is why one byte-level,
// type-agnostic primitive serves both: `0` for a scalar (the documented
// "new elements are zero-initialized") and NULL for a managed pointer — the
// element walk's `if slot != 0` skips a null slot, `__mm_decref_maybenull_helper`
// tolerates it, and `__managed_mem_get` reports it as `emptySlot`.
//
// Fresh capacity is NEVER re-zeroed, because it is already zero at birth:
// `__managed_mem_create` / `__managed_mem_alloc_buffer` allocate from the
// always-zeroing slab; `__managed_mem_grow` goes through `mm_realloc`, which
// memcpy's the live prefix and memzeroes the grown tail; `__managed_mem_cow_check`
// copies the live bytes into a fresh zeroed buffer. A `resize` that grows into
// fresh memory therefore pays NOTHING here — only slots that were actually
// occupied are ever zeroed.
// ============================================================================

// Erase the slots [start, end) of `self`'s buffer. The other half of the vacate
// contract: `__managed_mem_walk_elements_range` RELEASES a departing element,
// this ERASES the slot it left behind — so a later regrow of the length can only
// expose a zeroed slot, never a stale (already-decref'd) pointer.
//
// SKIPPED for a buffer this record does not own (capacity < 0: an rdata-backed
// array literal, or a read-only view). Writing there would fault on read-only
// memory — and the invariant needs no help: `setLength` compares n against a
// NEGATIVE capacity and so rejects every n, meaning such a record cannot
// lengthen without first going through `grow` -> `cow_check`, which copies the
// live elements into a fresh ZEROED buffer sized to `length` and then mmReallocs
// (zeroing the grown tail). The mandatory COW re-establishes the invariant by
// construction. Caller guarantees 0 <= start <= end <= capacity.
function __managed_mem_zero_elements_range(self MachineWord, start BufferCoordinate, end BufferCoordinate)
	let capacity = __Internals.loadIndirect(self + MM_OFFSET_CAPACITY)
	if capacity < 0 'notOwned'
		return
	end 'notOwned'
	let buffer = __Internals.loadIndirect(self)
	if buffer == 0 'noBuf'
		return
	end 'noBuf'
	let elemSize = __Internals.loadIndirect(self + MM_OFFSET_ELEMENT_SIZE)
	// element_size < 0 is the sub-byte-packed sentinel: `start`/`end` are FIELD
	// indices, and a field is not generally byte-aligned, so a byte-range memzero
	// would flatten the live neighbours sharing the boundary bytes. Clear the
	// fields one at a time through the shared packed writer instead.
	if __managed_mem_is_packed(elemSize) 'packed'
		var i = start
		while i < end 'clearFields'
			__managed_mem_write_packed(buffer, idx: i, elemSize: elemSize, value: 0)
			i = i + 1
		end 'clearFields'
		return
	end 'packed'
	// Byte-level and type-agnostic — exactly why it is correct for a scalar
	// element and a managed pointer alike.
	__Internals.memzero(buffer + start * elemSize, size: (end - start) * elemSize)
end '__managed_mem_zero_elements_range'

// Vacate the slots [start, end): release each departing managed element, THEN
// erase the slots it leaves behind. The two halves belong together — a release
// without the erase leaves a dangling pointer above `length` for the next regrow
// to hand back (double-free); an erase without the release leaks the element.
// The teardown must run first: it reads the slots this then zeroes.
// Caller guarantees 0 <= start <= end <= length.
function __managed_mem_vacate_range(self MachineWord, start BufferCoordinate, end BufferCoordinate)
	__managed_mem_walk_elements_range(self, start: start, end: end)
	__managed_mem_zero_elements_range(self, start: start, end: end)
end '__managed_mem_vacate_range'

// clear(self) — drop every live managed element, erase the slots, then truncate
// to empty (length=0). `Array.clear()` formerly lowered to a bare `length = 0`,
// which leaked every managed element (the slots' +1 refs were orphaned with no
// walk). Vacate-then-truncate frees them AND leaves [0, capacity) zeroed, so a
// following `resize` back over the same slots re-exposes zeros rather than the
// pointers clear just released. The backing buffer + capacity are retained for
// reuse. Returns 0 (the void result the lowering binds).
function __managed_mem_clear(self MachineWord) returns MachineWord
	let length = __Internals.loadIndirect(self + MM_OFFSET_LENGTH)
	__managed_mem_vacate_range(self, start: 0, end: length)
	__Internals.storeIndirect(self + MM_OFFSET_LENGTH, value: 0)
	return 0
end '__managed_mem_clear'

// __destruct___ManagedMemoryCursor(self): release the source __ManagedMemory the
// cursor RETAINED at creation. A for-in cursor borrows the source collection's
// buffer (cursor.buffer@0 aliases source.buffer), so the source MUST stay alive
// for the whole loop — lowerCreateCursor increfs source_ptr@32 when building the
// cursor, and this destructor drops that ref when the iterator (which owns the
// cursor) is torn down. Without the retain+release pair the inserter freed the
// source collection right after createIterator() (its textual last use), leaving
// the cursor's buffer pointer dangling → SIGSEGV on the 2nd iteration once the
// freed slab slot was reused. `buffer@0` is NOT decref'd here: it is owned by the
// source record (source_ptr), released transitively when source_ptr's refcount
// hits 0. Returns i64 (0) to match the indirect-call destructor ABI.
function __destruct___ManagedMemoryCursor(self MachineWord) returns MachineWord
	let sourcePtr = __Internals.loadIndirect(self + 32)
	if sourcePtr != 0 'hasSource'
		__mm_decref(sourcePtr)
	end 'hasSource'
	return 0
end '__destruct___ManagedMemoryCursor'

// setLength(self, n) — bounds-check n against capacity, then write to
// self.length. Throws invalidLength (wire 4) on n > capacity.
//
// GROW is a bare length store, and MUST stay one: every caller that lengthens
// the buffer has already STAGED the new elements into [oldLength, n) and is
// using this call to PUBLISH them (`push` = set-then-setLength; `insert` =
// shiftRight + set-then-setLength; `Character.fromCodepoint` / string building =
// create + setByte-then-setLength). Zeroing the exposed range here would erase
// exactly those values. The slots are safe to expose because they are already
// zero — see THE CAPACITY-SLOT INVARIANT above.
//
// SHRINK vacates the dropped slots: [n, oldLength) is leaving the live range, so
// each managed element there is released (or its +1 ref is orphaned — a leak)
// and the slot is then erased (or the next regrow past `n` hands the caller a
// pointer that has already been freed — a double-free on teardown). Both halves
// live in `__managed_mem_vacate_range`. It must precede the length store: it
// reads [n, oldLength) off the OLD live range.
function __managed_mem_set_length(self MachineWord, n BufferCoordinate) returns MachineWord throws __ManagedMemoryError
	let capacity = __Internals.loadIndirect(self + MM_OFFSET_CAPACITY)
	if n > capacity 'tooLong'
		throw __ManagedMemoryError.invalidLength
	end 'tooLong'
	let oldLength = __Internals.loadIndirect(self + MM_OFFSET_LENGTH)
	if n < oldLength 'shrink'
		__managed_mem_vacate_range(self, start: n, end: oldLength)
	end 'shrink'
	__Internals.storeIndirect(self + MM_OFFSET_LENGTH, value: n)
	return 0
end '__managed_mem_set_length'

// Sub-byte-packed element access. An `Array with T` whose element occupies FEWER
// than 8 bits stores `element_size@24 = -(bitWidth)`: a `bool` is 1 bit (-1); a
// future 2-bit type would be -2, a nibble -4. This NEGATIVE-bit-width encoding is
// the one representation the whole runtime reads:
//   element_size  > 0  →  N-byte stride (byte-addressed: 1, 2, 4, 8)
//   element_size == 0  →  reserved / unset (non-container, or a pre-stamp record)
//   element_size  < 0  →  packed, (-element_size) BITS per element
// `capacity` and `length` stay element counts (never bit counts), so bounds checks
// and the COW gates are unchanged. The four helpers below are the SOLE source of
// truth for the bit math, so it can never drift across the ~10 access sites
// (get/set/swap/cursor/remove/insert/append/slice/grow/cow) that dispatch on it.
//
// Only widths that divide 8 (1, 2, 4) are supported: an element then never
// straddles a byte boundary — bit offset `(idx*w) & 7` plus `w` stays <= 8 — so a
// single load/store per access suffices. A future width that does not divide 8
// (3/5/6/7) would need a multi-byte read-modify-write, and ONLY here.
function __managed_mem_is_packed(elemSize ElementStride) returns bool
	return elemSize < 0
end '__managed_mem_is_packed'

function __managed_mem_packed_bit_width(elemSize ElementStride) returns MachineWord
	return -elemSize
end '__managed_mem_packed_bit_width'

// Bytes needed to hold `count` packed elements of this element_size.
function __managed_mem_packed_byte_len(count BufferCoordinate, elemSize ElementStride) returns MachineWord
	let bits = count * __managed_mem_packed_bit_width(elemSize)
	return (bits + 7) shr 3
end '__managed_mem_packed_byte_len'

function __managed_mem_read_packed(buffer MachineWord, idx BufferCoordinate, elemSize ElementStride) returns MachineWord
	let w = __managed_mem_packed_bit_width(elemSize)
	let bitPos = idx * w
	let byte = __Internals.loadByte(buffer + (bitPos shr 3), offset: 0)
	let mask = (1 shl w) - 1
	return (byte shr (bitPos and 7)) and mask
end '__managed_mem_read_packed'

function __managed_mem_write_packed(buffer MachineWord, idx BufferCoordinate, elemSize ElementStride, value MachineWord)
	let w = __managed_mem_packed_bit_width(elemSize)
	let bitPos = idx * w
	let byteAddr = buffer + (bitPos shr 3)
	let bitOff = bitPos and 7
	let mask = (1 shl w) - 1
	let cur = __Internals.loadByte(byteAddr, offset: 0)
	let cleared = cur and (255 xor (mask shl bitOff))
	let newByte = cleared or ((value and mask) shl bitOff)
	__Internals.storeByte(byteAddr, offset: 0, value: newByte)
end '__managed_mem_write_packed'

// Byte length of a buffer holding `count` elements. Sub-byte-packed elements
// (element_size < 0) are measured in BITS; every byte-strided element is
// count * element_size. Single source of truth for buffer sizing across
// create / grow / cow_check / slice, so the packed-vs-byte split lives once.
function __managed_mem_buffer_byte_len(count BufferCoordinate, elemSize ElementStride) returns MachineWord
	if __managed_mem_is_packed(elemSize) 'packed'
		return __managed_mem_packed_byte_len(count, elemSize: elemSize)
	end 'packed'
	return count * elemSize
end '__managed_mem_buffer_byte_len'

// How many elements fit in `bytes` bytes of buffer for this element_size — the
// inverse of `__managed_mem_buffer_byte_len`. The inline-storage fast path uses
// it to reclaim the slab class slack as spare capacity: sub-byte-packed elements
// are (-element_size) bits each, so `bytes * 8` bits hold `bytes*8 / bitWidth` of
// them; byte-strided elements are `bytes / element_size`.
function __managed_mem_capacity_for_bytes(bytes MachineWord, elemSize ElementStride) returns MachineWord
	// `/` is fallible at the type level. `elemSize` is `ElementStride`, which is 0-inclusive, and
	// `__managed_mem_packed_bit_width` returns a `MachineWord`, which is too — so BOTH divisors are
	// cast. Both are non-zero by construction: the packed path's `0 - elemSize` is >= 1 (packed
	// elemSize < 0), and the sole caller reaches the non-packed path only under `elemSize != 0`.
	// The casts make that provable to the type system (a bare divide, no check); their lower-bound
	// panics are unreachable.
	//
	// ⚠ **A NARROWER RETURN TYPE CANNOT REPLACE THE FIRST CAST, AND TRYING IT HITS A BOOTSTRAP
	// CONTRADICTION.** MEASURED 2026-08-29 with the width declared `int(1 to 8)`: the bootstrap
	// answers `E3057 division by a possibly-zero value` for the bare divide AND
	// `E3010 unneeded cast: 'PackedBitWidth' already fits in 'NonZeroWord'` for the cast — so
	// NEITHER spelling compiles there, because its divisor check cannot see a CALL RESULT's declared
	// ranged return while its cast check can. (shv2 accepts the bare divide, so this is the
	// bootstrap's alone.) The cast stays until those two checks agree.
	if __managed_mem_is_packed(elemSize) 'packed'
		let bitWidth = __managed_mem_packed_bit_width(elemSize) as NonZeroWord
		return (bytes shl 3) / bitWidth
	end 'packed'
	let stride = elemSize as NonZeroWord
	return bytes / stride
end '__managed_mem_capacity_for_bytes'

// Width-dispatched scalar load/store at a precomputed element address. The
// element_size cascade (1→byte, 2→halfword, 4→word, else qword) was copied
// across get / cursor_current (load) and set / raw_set (store); centralize it
// so a new width or a fixed default lands in exactly one place. Unsigned reads —
// typed sign-extension is applied by the caller's field-load shim.
function __managed_mem_load_sized(addr MachineWord, elemSize ElementStride) returns MachineWord
	if elemSize == 1 'b'
		return __Internals.loadByte(addr, offset: 0)
	end 'b'
	if elemSize == 2 'h'
		return __Internals.loadHalfword(addr)
	end 'h'
	if elemSize == 4 'w'
		return __Internals.loadWord(addr)
	end 'w'
	return __Internals.loadIndirect(addr)
end '__managed_mem_load_sized'

function __managed_mem_store_sized(addr MachineWord, elemSize ElementStride, value MachineWord)
	if elemSize == 1 'b'
		__Internals.storeByte(addr, offset: 0, value: value)
		return
	end 'b'
	if elemSize == 2 'h'
		__Internals.storeHalfword(addr, value: value)
		return
	end 'h'
	if elemSize == 4 'w'
		__Internals.storeWord(addr, value: value)
		return
	end 'w'
	__Internals.storeIndirect(addr, value: value)
end '__managed_mem_store_sized'

// cursor_current(cursor) — load the element at the cursor's current
// position, dispatching on element_size like __managed_mem_get does.
// Non-throwing: callers (the for-in iterator protocol) only invoke this
// after a successful `advance()`, which guarantees `position < length`,
// so the bounds check from __managed_mem_get is provably dead.
// Cursor layout: buffer @0, position @8, length @16, element_size @24,
// source_ptr @32. Each load is zero-extending; source-level signed
// narrow types are sign-extended at the call site by the
// `maybeSignExtendCallResult` shim in LowerMaxonToStd.
function __managed_mem_cursor_current(cursor MachineWord) returns MachineWord
	let buffer = __Internals.loadIndirect(cursor)
	let position = __Internals.loadIndirect(cursor + 8)
	let elemSize = __Internals.loadIndirect(cursor + 24)
	// element_size < 0 is the sub-byte-packed sentinel: read the (-element_size)-bit
	// field at `position` — same layout as __managed_mem_get.
	if __managed_mem_is_packed(elemSize) 'packed'
		return __managed_mem_read_packed(buffer, idx: position, elemSize: elemSize)
	end 'packed'
	return __managed_mem_load_sized(buffer + position * elemSize, elemSize: elemSize)
end '__managed_mem_cursor_current'

// cursor_peek(cursor, ahead) — load the element at `position + ahead` without
// moving the cursor, dispatching on element_size exactly like cursor_current.
// Unlike current(), peek has no invariant guaranteeing the target is in range,
// so it bounds-checks target ∈ [0, length) and throws indexOutOfBounds (wire 1)
// on a miss — the stdlib's `ArrayIterator.peek` rethrows that as
// IterationError.exhausted. The width dispatch must live here, at the one
// place that has the runtime element_size value: a fixed qword load in the
// lowering leaked 7 bytes of adjacent buffer state for narrow elements (the
// lexer's hex-prefix peek returned garbage high bytes, splitting every `0x…`
// literal into `0` + identifier). No empty-slot guard, mirroring
// cursor_current: a zeroed managed slot reads back as null, same as current().
function __managed_mem_cursor_peek(cursor MachineWord, ahead BufferCoordinate) returns MachineWord throws __ManagedMemoryError
	let position = __Internals.loadIndirect(cursor + 8)
	let length = __Internals.loadIndirect(cursor + 16)
	let target = position + ahead
	if target < 0 'lo'
		throw __ManagedMemoryError.indexOutOfBounds
	end 'lo'
	if target >= length 'hi'
		throw __ManagedMemoryError.indexOutOfBounds
	end 'hi'
	let buffer = __Internals.loadIndirect(cursor)
	let elemSize = __Internals.loadIndirect(cursor + 24)
	// element_size < 0 is the sub-byte-packed sentinel — same layout as
	// __managed_mem_get / cursor_current.
	if __managed_mem_is_packed(elemSize) 'packed'
		return __managed_mem_read_packed(buffer, idx: target, elemSize: elemSize)
	end 'packed'
	return __managed_mem_load_sized(buffer + target * elemSize, elemSize: elemSize)
end '__managed_mem_cursor_peek'

// get(self, idx) — bounds-check idx ∈ [0, length), then load the element.
// Dispatch on element_size: 1 byte (loadByte), 2 (loadHalfword), 4 (loadWord),
// fall through to qword (loadIndirect). Unsigned reads — typed sign-extension
// is handled by the source-level field-load path with signed: true.
// Throws indexOutOfBounds (wire 1) on OOB.
function __managed_mem_get(self MachineWord, idx BufferCoordinate) returns MachineWord throws __ManagedMemoryError
	if idx < 0 'lo'
		throw __ManagedMemoryError.indexOutOfBounds
	end 'lo'
	let length = __Internals.loadIndirect(self + MM_OFFSET_LENGTH)
	if idx >= length 'hi'
		throw __ManagedMemoryError.indexOutOfBounds
	end 'hi'
	let elemSize = __Internals.loadIndirect(self + MM_OFFSET_ELEMENT_SIZE)
	let buffer = __Internals.loadIndirect(self)
	// element_size < 0 is the sub-byte-packed sentinel: read the (-element_size)-bit
	// field at `idx` (bool = 1 bit) and return it zero-extended.
	if __managed_mem_is_packed(elemSize) 'packed'
		return __managed_mem_read_packed(buffer, idx: idx, elemSize: elemSize)
	end 'packed'
	let loaded = __managed_mem_load_sized(buffer + idx * elemSize, elemSize: elemSize)
	// Empty-slot detection for managed-pointer (struct/string/union/array)
	// elements only: `element_destroy != 0` marks a slot that holds a refcounted
	// heap pointer. resize()/remove() zero such slots; reading one back as a live
	// pointer and dereferencing it (or increfing it) would fault on null. Report
	// it as `emptySlot` so `try arr.get(i) otherwise …` handles sparse arrays.
	// Primitive slots (element_destroy == 0) store values inline — a 0 there is a
	// valid element, never an empty slot. Mirrors the C# bootstrap's
	// `LowerManagedMemGet` null-slot guard.
	let elementDestroy = __Internals.loadIndirect(self + MM_OFFSET_ELEMENT_DESTROY)
