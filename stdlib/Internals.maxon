		// scavenger advances it to SEEN_FREE then DECOMMITTED across two idle passes;
		// __slab_reback_span resets it to ACTIVE (re-backing the pages) on reuse.
		__Internals.storeIndirect(span + 0x48, value: SPAN_SCAV_ACTIVE)

