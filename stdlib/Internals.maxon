// Build a span's intrusive free list in place: slot[i] links to slot[i+1] and the
// last slot links to 0, so `free_list = pageBase` walks every slot once. Shared by
// the fresh-span path in __slab_refill_mcache and the scavenged-span rebuild in
// __slab_reback_span (a decommitted span loses its in-page links and must be rebuilt).
function __slab_build_freelist(pageBase MachineWord, slotSize MachineWord, totalSlots MachineWord)
	for i in 0 upto totalSlots 'linkLoop'
		let current = pageBase + i * slotSize
		if i + 1 == totalSlots 'lastSlot'
			__Internals.storeIndirect(current, value: 0)
		end 'lastSlot'
