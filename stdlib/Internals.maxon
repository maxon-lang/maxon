		// holds the zeroes the OS gave us — no memzero, at any size class. This is
		// the common case while a span fills for the first time.
		let bumpNext = __Internals.loadIndirect(span + 0x50)
		// INV-1 says free_count > 0 and an empty free list imply bump_next < bump_end.
		// If that ever fails we would hand out a slot past the end of the span, so
