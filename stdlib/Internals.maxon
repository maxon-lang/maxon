	// detach here: their buffer points into the record's own allocation, so
	// `mmRealloc` (which grow calls right after cow_check) would be reallocating a
	// pointer the slab does not track as an independent block. First grow copies
	// the live bytes to a fresh external buffer and flips parent to ROOT.
	if capacity >= 0 and parent != MM_PARENT_INLINE 'noCopy'
		return 0
