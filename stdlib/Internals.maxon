		// because chunks and pages are both 8KB.
		__slab_arena_map_set(pageBase, numPages: numChunks, mspan: span)

		// Build the intrusive free list: slot[i] -> slot[i+1], last slot -> 0.
		__slab_build_freelist(pageBase, slotSize: slotSize, totalSlots: totalSlots)
	end 'growNew'

	// mcache[rowShard][classIdx] = span
	__Internals.storeIndirect(mcacheSlot, value: span)
