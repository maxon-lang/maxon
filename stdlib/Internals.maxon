	// [idx, idx+count) UP one position with a DESCENDING loop (read_packed(j) ->
	// write_packed(j+1)) so overlapping copies never clobber, then clear the vacated
	// field at idx. This is the packed mirror of the byte-loop + hole-zeroing below;
	// the caller's following set(idx, value) overwrites the cleared field.
	if __managed_mem_is_packed(elemSize) 'packed'
		var j = idx + count - 1
		while j >= idx 'shiftBits'
			let bit = __managed_mem_read_packed(buffer, idx: j, elemSize: elemSize)
