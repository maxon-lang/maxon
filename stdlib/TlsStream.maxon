/// TLS connections over sockets: the stream both `TlsClient` and `TlsListener` hand back.
/// @category Network
let tlsReadChunkBytes = 32768
let tlsRecordMajorVersion = 3
let tlsCloseNotifyDeadlineMs = 5000

/// The ALPN protocol a handshake settled on.
public union TlsApplicationProtocol
	unnegotiated
	negotiated(name String)
end 'TlsApplicationProtocol'

union TlsWriteHealth
	intact
	failed(cause TlsError)
end 'TlsWriteHealth'

enum TlsHandshakePhase
	pending
	running
	complete
	failed
end 'TlsHandshakePhase'

/// A TLS connection. A stream from `TlsClient` is established; one from `TlsListener.accept()` runs
/// its handshake on its first `send`, `recv` or `shutdownWrite`, or on `handshake()`, and what it
/// negotiated is readable once that has completed. Use it through a `var` from one green thread. A
/// stream that goes out of scope closes its socket without a close_notify, which the peer reads as
/// `truncated`; `close()` sends one. A failed write ends the write side: every later `send` and
/// `shutdownWrite` throws the same error, while reads go on.
public type TlsStream
	var transport as TcpClient
	var endpoint as TlsEndpoint

	// The machine holds this same instance and records on it why it refused a chain; `refuse` reads that back.
	var peer as TlsX509Peer
	var inbound as ByteArray
	var consumed as BytePos
	var unread as ByteArray
	var unreadConsumed as BytePos
	var writeClosed as bool

	// A send that failed part-way may have cut a record, and anything written after it would reach the
	// peer as garbage, so the first failure is kept and thrown by every later write.
	var writeHealth as TlsWriteHealth
	var closed as bool
	var phase as TlsHandshakePhase
	var handshakeDeadlineMs as SocketDeadlineMs
	var readDeadlineMs as SocketDeadlineMs
	var writeDeadlineMs as SocketDeadlineMs

	module static function establish(transport TcpClient, endpoint TlsEndpoint, peer TlsX509Peer, deadlineMs SocketDeadlineMs) returns TlsStream throws TlsError
		var stream = TlsStream.unshaken(transport, endpoint: endpoint, peer: peer, deadlineMs: deadlineMs)

		try stream.handshake()

		return stream
	end 'establish'

	module static function unshaken(transport TcpClient, endpoint TlsEndpoint, peer TlsX509Peer, deadlineMs SocketDeadlineMs) returns TlsStream
		return Self{transport: transport, endpoint: endpoint, peer: peer, inbound: ByteArray.create(), consumed: 0, unread: ByteArray.create(), unreadConsumed: 0, writeClosed: false, writeHealth: TlsWriteHealth.intact, closed: false, phase: TlsHandshakePhase.pending, handshakeDeadlineMs: deadlineMs, readDeadlineMs: NoDeadlineMs, writeDeadlineMs: NoDeadlineMs}
	end 'unshaken'

	/// Run the handshake if it has not run; returns at once when it has completed. `send`, `recv` and
	/// `shutdownWrite` run it first. A failure is thrown here, closes the connection, and every later
	/// call throws `closed`.
	public function handshake() throws TlsError
		if closed 'unusable'
			throw TlsError.closed
		end 'unusable'

		match phase 'phase'
			complete then return
			pending then try runHandshake()
			running then throw TlsError.handshakePending
			failed then throw TlsError.closed
		end 'phase'
	end 'handshake'

	/// Send every byte of `data`; returns the byte count.
	public function send(data String) returns BytePos throws TlsError
		return try send(data.toByteArray())
	end 'send'

	/// Send every byte of `data`, split into records of at most 16 KiB; returns the byte count.
	public function send(data ByteArray) returns BytePos throws TlsError
		try requireWritable()
		try handshake()

		if data.isEmpty() 'nothing'
			return 0
		end 'nothing'

		try endpoint.session().write(data) otherwise (failure) 'refused'
			throw refuse(failure)
		end 'refused'

		try flush()

		return data.count() as BytePos
	end 'send'

	/// Receive between one and `bufferSize` bytes of application data.
	public function recv(bufferSize RecvCapacity) returns String throws TlsError
		return String.from(try recvBytes(bufferSize))
	end 'recv'

	/// `recv`, as bytes. Throws `connectionClosed` once the peer's close_notify and the data before it were read, and
	/// `truncated` when the transport ends without one.
	public function recvBytes(bufferSize RecvCapacity) returns ByteArray throws TlsError
		if closed 'unreadable'
			throw TlsError.closed
		end 'unreadable'

		try handshake()

		while unreadCount() == 0 'waiting'
			if endpoint.session().hasPeerClosed() 'peerFinished'
				throw TlsError.connectionClosed
			end 'peerFinished'

			try pump()
			unread.append(endpoint.session().takeReceived())
		end 'waiting'

		return takeUnread(bufferSize)
	end 'recvBytes'

	/// The TLS version negotiated. Throws `handshakePending` until the handshake has completed.
	public function protocol() returns TlsProtocol throws TlsError
		let suite = try cipherSuite()

		return match suite 'suite'
			tls13 gives TlsProtocol.tls13
			tls12 gives TlsProtocol.tls12
		end 'suite'
	end 'protocol'

	/// The cipher suite negotiated. Throws `handshakePending` until the handshake has completed.
	public function cipherSuite() returns TlsCipherSuite throws TlsError
		try requireHandshaken()

		return try endpoint.session().negotiatedCipherSuite() otherwise panic("TlsStream.cipherSuite: a completed handshake negotiated a suite")
	end 'cipherSuite'

	/// The ALPN protocol negotiated, if any. Throws `handshakePending` until the handshake has
	/// completed.
	public function applicationProtocol() returns TlsApplicationProtocol throws TlsError
		try requireHandshaken()

		return match endpoint.session().alpn 'alpn'
			negotiated(name) gives TlsApplicationProtocol.negotiated(String.from(name))
			absent gives TlsApplicationProtocol.unnegotiated
		end 'alpn'
	end 'applicationProtocol'

	/// The DER chain the peer presented, in the order sent; empty for a client that presented none.
	/// Throws `handshakePending` until the handshake has completed.
	public function peerCertificates() returns ByteArrays throws TlsError
		try requireHandshaken()

		return endpoint.session().peerChain.clone()
	end 'peerCertificates'

	/// Make a read still waiting `milliseconds` after this call throw `timedOut`; the stream stays
	/// usable. `0` clears it. Set before the handshake has completed, it applies from the moment the
	/// handshake completes.
	public function setReadDeadline(milliseconds SocketDeadlineMs) throws TlsError
		if closed 'unreadable'
			throw TlsError.closed
		end 'unreadable'

		readDeadlineMs = milliseconds

		if phase == TlsHandshakePhase.complete 'established'
			try applyReadDeadline(milliseconds)
		end 'established'
	end 'setReadDeadline'

	/// Make a write that cannot finish within `milliseconds` of this call throw `timedOut`. `0` clears it.
	/// Set before the handshake has completed, it applies from the moment the handshake completes.
	public function setWriteDeadline(milliseconds SocketDeadlineMs) throws TlsError
		if closed 'unwritable'
			throw TlsError.closed
		end 'unwritable'

		writeDeadlineMs = milliseconds

		if phase == TlsHandshakePhase.complete 'established'
			try applyWriteDeadline(milliseconds)
		end 'established'
	end 'setWriteDeadline'

	/// Send close_notify and stop sending; the peer reads the end of the stream while this side can still `recv`.
	public function shutdownWrite() throws TlsError
		try requireWritable()
		try handshake()

		try endpoint.session().close() otherwise (failure) 'refused'
			throw refuse(failure)
		end 'refused'

		try flushWithinCloseDeadline()

		writeClosed = true

		try transport.shutdownWrite() otherwise (failure) 'refused'
			throw tlsNetworkFailure(failure)
		end 'refused'
	end 'shutdownWrite'

	/// Send close_notify, waiting at most 5 s for it to go out, and close the connection. Idempotent;
	/// never throws, since the peer may already be gone.
	public function close()
		if closed 'already'
			return
		end 'already'

		closed = true

		announceClose()
		transport.close()
	end 'close'

	module function closeAfterDraining()
		if closed 'already'
			return
		end 'already'

		closed = true

		announceClose()
		lingerForThePeer(transport)
		transport.close()
	end 'closeAfterDraining'

	function announceClose()
		if writeClosed or phase != TlsHandshakePhase.complete 'announced'
			return
		end 'announced'

		try requireIntactWrites() otherwise return
		try endpoint.session().close() otherwise ignore
		try flushWithinCloseDeadline() otherwise ignore
	end 'announceClose'

	function requireHandshaken() throws TlsError
		match phase 'phase'
			complete then return
			pending or
			running then throw TlsError.handshakePending
			failed then throw TlsError.closed
		end 'phase'
	end 'requireHandshaken'

	function requireWritable() throws TlsError
		if closed or writeClosed 'unwritable'
			throw TlsError.closed
		end 'unwritable'

		try requireIntactWrites()
	end 'requireWritable'

	function requireIntactWrites() throws TlsError
		match writeHealth 'health'
			intact then return
			failed(cause) then throw cause
		end 'health'
	end 'requireIntactWrites'

	function applyReadDeadline(milliseconds SocketDeadlineMs) throws TlsError
		try transport.setReadDeadline(milliseconds) otherwise (failure) 'refused'
			throw tlsNetworkFailure(failure)
		end 'refused'
	end 'applyReadDeadline'

	function applyWriteDeadline(milliseconds SocketDeadlineMs) throws TlsError
		try transport.setWriteDeadline(milliseconds) otherwise (failure) 'refused'
			throw tlsNetworkFailure(failure)
		end 'refused'
	end 'applyWriteDeadline'

	function flushWithinCloseDeadline() throws TlsError
		try applyWriteDeadline(tlsCloseNotifyDeadlineMs)
		try flush()
	end 'flushWithinCloseDeadline'

	function runHandshake() throws TlsError
		phase = TlsHandshakePhase.running

		try completeHandshake() otherwise (cause) 'abandoned'
			phase = TlsHandshakePhase.failed
			closed = true
			transport.close()

			throw cause
		end 'abandoned'

		phase = TlsHandshakePhase.complete
	end 'runHandshake'

	function completeHandshake() throws TlsError
		try applyReadDeadline(handshakeDeadlineMs)
		try applyWriteDeadline(handshakeDeadlineMs)
		try flush()

		while not endpoint.session().isConnected() 'handshaking'
			try pump()
		end 'handshaking'

		try applyReadDeadline(readDeadlineMs)
		try applyWriteDeadline(writeDeadlineMs)
	end 'completeHandshake'

	function pump() throws TlsError
		let record = try nextRecord()

		try endpoint.receive(record) otherwise (failure) 'refused'
			throw refuse(failure)
		end 'refused'

		try flush()
	end 'pump'

	// The alert the machine queued is flushed before the socket closes, so the peer reads it rather than a reset.
	function refuse(failure TlsHandshakeError) returns TlsError
		closed = true

		try flushWithinCloseDeadline() otherwise ignore

		lingerForThePeer(transport)
		transport.close()

		return tlsPublicFailure(failure, session: endpoint.session(), refusal: peer.refusal)
	end 'refuse'

	function reject(failure TlsHandshakeError) returns TlsError
		endpoint.session().abort(failure)

		return refuse(failure)
	end 'reject'

	function flush() throws TlsError
		let records = endpoint.session().takeRecords()

		if records.isEmpty() 'nothingQueued'
			return
		end 'nothingQueued'

		try requireIntactWrites()

		var wire = ByteArray.create()

		for record in records 'eachRecord'
			wire.append(record)
		end 'eachRecord'

		_ = try transport.send(String.from(wire)) otherwise (failure) 'refused'
			let cause = transportFailure(failure, ordinary: tlsNetworkFailure(failure))

			writeHealth = TlsWriteHealth.failed(cause)

			throw cause
		end 'refused'
	end 'flush'

	// The bound is the largest body either version allows; the record layer applies the stricter TLS 1.3 limit.
	function nextRecord() returns ByteArray throws TlsError
		try fill(tlsRecordHeaderBytes)
		try screenHeader()

		let bodyBytes = readOrderedWord(inbound, off: consumed + tlsRecordLengthOffset, width: tlsRecordFieldBytes, limit: inbound.count(), order: ByteOrder.bigEndian) as Count

		if bodyBytes > tlsMaxCiphertext12Bytes 'oversized'
			throw reject(TlsHandshakeError.recordOverflow)
		end 'oversized'

		let recordBytes = tlsRecordHeaderBytes + bodyBytes

		try fill(recordBytes)

		let record = tlsRecordPart(inbound, start: consumed, endIndex: consumed + recordBytes)

		consumed = consumed + recordBytes

		if consumed == inbound.count() 'drained'
			inbound.clear()
			consumed = 0
		end 'drained'

		return record
	end 'nextRecord'

	// Runs before the body is awaited: input that is not TLS declares an arbitrary length and would stall the read.
	function screenHeader() throws TlsError
		let contentType = tlsRecordByte(inbound, offset: consumed + tlsRecordTypeOffset)

		if contentType < TlsContentType.changeCipherSpec.rawValue or contentType > TlsContentType.applicationData.rawValue 'foreignContent'
			throw reject(TlsHandshakeError.unexpectedMessage)
		end 'foreignContent'

		if tlsRecordByte(inbound, offset: consumed + tlsRecordVersionOffset) != tlsRecordMajorVersion 'foreignProtocol'
			throw reject(TlsHandshakeError.protocolVersion)
		end 'foreignProtocol'
	end 'screenHeader'

	function fill(needed Count) throws TlsError
		while inbound.count() - consumed < needed 'filling'
			if consumed > 0 'compact'
				inbound = tlsRecordPart(inbound, start: consumed, endIndex: inbound.count())
				consumed = 0
			end 'compact'

			let chunk = try transport.recv(tlsReadChunkBytes) otherwise (failure) 'unreadable'
				throw transportFailure(failure, ordinary: tlsReadFailure(failure))
			end 'unreadable'

			inbound.append(chunk.toByteArray())
		end 'filling'
	end 'fill'

	function transportFailure(failure NetworkError, ordinary TlsError) returns TlsError
		if phase == TlsHandshakePhase.running and failure == NetworkError.timedOut 'stalled'
			return TlsError.handshakeTimedOut
		end 'stalled'

		return ordinary
	end 'transportFailure'

	function unreadCount() returns Count
		return unread.count() - unreadConsumed
	end 'unreadCount'

	function takeUnread(bufferSize RecvCapacity) returns ByteArray
		var stop = unreadConsumed + (bufferSize as BytePos)

		if stop > unread.count() 'allOfIt'
			stop = unread.count() as BytePos
		end 'allOfIt'

		let taken = tlsRecordPart(unread, start: unreadConsumed, endIndex: stop)

		unreadConsumed = stop

		if unreadConsumed == unread.count() 'drained'
			unread.clear()
			unreadConsumed = 0
		end 'drained'

		return taken
	end 'takeUnread'
end 'TlsStream'
