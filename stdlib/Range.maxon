/// Range and OpenRange — first-class iterable values produced by `start to end`
/// and `start upto end` expressions when used outside a for-in header.
///
/// In a for-in header, `to`/`upto` is still desugared directly to a while loop
/// for performance (no allocation, no per-iteration error path). Used in
/// expression position — bound to a variable, passed as an argument, or
/// receiver of `.createIterator()` / `.withIterator()` — `to` constructs a
/// Range and `upto` constructs an OpenRange.
///
/// @category Collections
public typealias RangeBound = int(i64.min to i64.max)

// How many steps the iterator has taken. Non-negative because `pos` starts at `first` and `retreat`
// refuses to go below it, and it is minted at the one `as IterPos` cast in `index()` — the door the
// narrowed upper turns into a check. A `RangeBound` span wider than `i64.max` cannot be represented
// by the subtraction that produces this, so a wrapped difference is an overflow and the guard is
// right to refuse it rather than report a negative step count.
typealias IterPos = int(0 to i64.max)

/// Iterator for both Range and OpenRange. Stores the inclusive last value so a
/// single comparison per step suffices.
public type RangeIterator implements Iterator with RangeBound, BidirectionalIterator
	let first as RangeBound
	let last as RangeBound
	var pos as RangeBound

	public static function create(first RangeBound, last RangeBound) returns Self throws IterationError
		if last < first 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Self{first: first, last: last, pos: first}
	end 'create'

	public function current() returns RangeBound
		return pos
	end 'current'

	public function index() returns IterPos
		return (pos - first) as IterPos
	end 'index'

	public function advance() throws IterationError
		if pos == last 'done'
			throw IterationError.exhausted
		end 'done'
		pos = pos + 1
	end 'advance'

	public function retreat() throws IterationError
		if pos == first 'begin'
			throw IterationError.atStart
		end 'begin'
		pos = pos - 1
	end 'retreat'
end 'RangeIterator'

/// Inclusive range: iterates from start through finish (both endpoints visited).
public type Range implements Iterable with (RangeBound, RangeIterator)
	let start as RangeBound
	let finish as RangeBound

	public static function create(start RangeBound, finish RangeBound) returns Self
		return Self{start: start, finish: finish}
	end 'create'

	/// Create a fresh iterator positioned at start.
	/// Throws IterationError.exhausted if finish < start (empty range).
	public function createIterator() returns RangeIterator throws IterationError
		return try RangeIterator.create(start, last: finish)
	end 'createIterator'
end 'Range'

/// Half-open range: iterates from start up to but not including endExclusive.
public type OpenRange implements Iterable with (RangeBound, RangeIterator)
	let start as RangeBound
	let endExclusive as RangeBound

	public static function create(start RangeBound, endExclusive RangeBound) returns Self
		return Self{start: start, endExclusive: endExclusive}
	end 'create'

	/// Create a fresh iterator positioned at start.
	/// Throws IterationError.exhausted if endExclusive <= start (empty range).
	public function createIterator() returns RangeIterator throws IterationError
		if endExclusive <= start 'empty'
			throw IterationError.exhausted
		end 'empty'
		return try RangeIterator.create(start, last: endExclusive - 1)
	end 'createIterator'
end 'OpenRange'
