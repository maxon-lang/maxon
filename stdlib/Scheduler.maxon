/// Green-thread scheduler controls.
/// @category System
/// A processor count the scheduler resolved. A scheduler always has at least one processor, and the machine's
/// logical processor count is the only ceiling.
public typealias SchedulerProcessorCount = int(1 to u64.max) implements Count

public typealias SchedulerEventCount = int(0 to u64.max)

public typealias StackByteCount = int(0 to u64.max)

public typealias GreenThreadCount = int(0 to u64.max)

public typealias MachineIndex = int(0 to u64.max)

module typealias PinDepth = int(0 to u64.max)

module typealias PinToken = int(0 to u64.max)

public type SchedulerCounters
	public let steals as SchedulerEventCount
	public let retakes as SchedulerEventCount
	public let maxActiveWorkers as SchedulerEventCount
	public let recycledThreads as SchedulerEventCount
	public let timerStarts as SchedulerEventCount
	public let syscalls as SchedulerEventCount
	public let slices as SchedulerEventCount
	public let preempts as SchedulerEventCount
	public let parkWakes as SchedulerEventCount
	public let netpollBlocks as SchedulerEventCount
	public let idleProcessors as SchedulerEventCount
	public let threadRecordsCarved as SchedulerEventCount
	public let timerScanSteps as SchedulerEventCount
	public let globalPushes as SchedulerEventCount

	static function create(steals SchedulerEventCount, retakes SchedulerEventCount, maxActiveWorkers SchedulerEventCount, recycledThreads SchedulerEventCount, timerStarts SchedulerEventCount, syscalls SchedulerEventCount, slices SchedulerEventCount, preempts SchedulerEventCount, parkWakes SchedulerEventCount, netpollBlocks SchedulerEventCount, idleProcessors SchedulerEventCount, threadRecordsCarved SchedulerEventCount, timerScanSteps SchedulerEventCount, globalPushes SchedulerEventCount) returns Self
		return Self{steals: steals, retakes: retakes, maxActiveWorkers: maxActiveWorkers, recycledThreads: recycledThreads, timerStarts: timerStarts, syscalls: syscalls, slices: slices, preempts: preempts, parkWakes: parkWakes, netpollBlocks: netpollBlocks, idleProcessors: idleProcessors, threadRecordsCarved: threadRecordsCarved, timerScanSteps: timerScanSteps, globalPushes: globalPushes}
	end 'create'
end 'SchedulerCounters'

/// Controls over the green-thread scheduler the program is already running on.
///
/// `Scheduler` is a namespace for scheduler-level operations rather than a value: it has no fields and is never
/// constructed, so every member is `static`.
public type Scheduler
	/// Cooperatively reschedule the current green thread.
	///
	/// The next runnable green thread takes over and the caller resumes where it left off once its turn comes
	/// round again — BEHIND everything that was already runnable, never ahead of it. `main` runs as an
	/// ordinary green thread in a program that spawns any, so a yield there follows the same rule. If nothing
	/// else is runnable the call returns promptly and the caller simply continues, so a `Scheduler.yield()` in
	/// a wait loop is a busy wait that makes progress rather than a block — `await` and `sleep` are the
	/// blocking waits.
	///
	/// Unlike `sleep(0)` it occupies no timer, so a program may yield as often as it likes without competing
	/// for the timer store. It is safe outside any async context: called from a program that never spawned a
	/// green thread it simply returns.
	public static function yield()
		__Builtins.yield()
	end 'yield'

	/// The number of processors the green-thread scheduler runs services on: the machine's logical processor
	/// count, or the count `MAXON_MAX_PROCS` sets, clamped to between 1 and the machine's count.
	///
	/// The scheduler resolves it once, before `main` runs, and asking is itself a use of the scheduler, so the
	/// answer is the same before the first `spawn` as after it — the number to size a pool of services by.
	/// `wasm32-wasi` has no green-thread scheduler, and a call there is refused at compile time (E3104).
	public static function processorCount() returns SchedulerProcessorCount
		return __Builtins.schedProcessorCount() as SchedulerProcessorCount
	end 'processorCount'

	/// The machine's logical processor count.
	public static function machineCpuCount() returns SchedulerProcessorCount
		return __Builtins.cpuCount() as SchedulerProcessorCount
	end 'machineCpuCount'

	public static function counters() returns SchedulerCounters
		return SchedulerCounters.create(__Builtins.schedStealCount() as SchedulerEventCount, retakes: __Builtins.schedRetakeCount() as SchedulerEventCount, maxActiveWorkers: __Builtins.schedMaxActiveWorkers() as SchedulerEventCount, recycledThreads: __Builtins.schedGtRecycleCount() as SchedulerEventCount, timerStarts: __Builtins.schedTimerStartCount() as SchedulerEventCount, syscalls: __Builtins.schedSyscallCount() as SchedulerEventCount, slices: __Builtins.schedSliceCount() as SchedulerEventCount, preempts: __Builtins.schedPreemptCount() as SchedulerEventCount, parkWakes: __Builtins.schedParkWakeCount() as SchedulerEventCount, netpollBlocks: __Builtins.schedNetpollBlockCount() as SchedulerEventCount, idleProcessors: __Builtins.schedIdleProcessorCount() as SchedulerEventCount, threadRecordsCarved: __Builtins.schedGtRecordsCarved() as SchedulerEventCount, timerScanSteps: __Builtins.schedTimerScanStepCount() as SchedulerEventCount, globalPushes: __Builtins.schedGlobalPushCount() as SchedulerEventCount)
	end 'counters'

	public static function currentStackBytes() returns StackByteCount
		return __Builtins.gtStackBytes() as StackByteCount
	end 'currentStackBytes'

	/// Park `main` until every other green thread has finished, and answer how many have not.
	public static function quiesce() returns GreenThreadCount
		return __Builtins.gtQuiesce() as GreenThreadCount
	end 'quiesce'

	/// Does nothing at run time. A CPU-bound function calls it to mark a spawn of itself as deliberate
	/// (E3073 refuses spawning a function that never gives up its green thread).
	public static function parallelBoundary()
		__Builtins.parallelBoundary()
	end 'parallelBoundary'

	/// Bind the calling green thread to the machine running it, and answer whether it did. A pinned
	/// thread resumes on the machine it parked on.
	public static function pinToMachine() returns bool
		return __Builtins.pinToMachine() != 0
	end 'pinToMachine'

	/// Release one pin the calling green thread took; pins nest, and the last release frees it from its
	/// machine. A green thread that holds no pin is a fatal runtime error.
	public static function unpinFromMachine()
		__Builtins.unpinFromMachine()
	end 'unpinFromMachine'

	module static function pinDepth() returns PinDepth
		return __Builtins.pinDepth() as PinDepth
	end 'pinDepth'

	/// The machine running the calling green thread; 0 is no machine.
	public static function currentMachine() returns MachineIndex
		return __Builtins.currentMachine() as MachineIndex
	end 'currentMachine'
end 'Scheduler'

/// A pin of the calling green thread to its machine, as `Scheduler.pinToMachine()` takes, released by
/// `release()` or the drop, whichever comes first. `held()` is false when there was no machine to pin to.
/// Releasing it from another green thread, off any green-thread machine, or after
/// `Scheduler.unpinFromMachine()` undid the pin is a fatal runtime error.
public type MachinePin
	var pin as __ManagedPin

	public static function acquire() returns MachinePin
		return Self{pin: __ManagedPin.acquire()}
	end 'acquire'

	public function held() returns bool
		return self.pin.token() != 0
	end 'held'

	public function release()
		self.pin.release()
	end 'release'

	module function surrender() returns PinToken
		return self.pin.surrender() as PinToken
	end 'surrender'

	public function clone() returns Self
		panic("MachinePin.clone: a pin binds one green thread to one machine and is released once — hold it in one place")
	end 'clone'
end 'MachinePin'
