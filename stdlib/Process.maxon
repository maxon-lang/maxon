/// Introspection of the currently-running process.
///
/// For launching and managing child processes, see `stdlib/Subprocess.maxon`.
/// For monotonic time, see `stdlib/Clock.maxon`.
///
/// @category System
#if os(Windows)
	public typealias ExitCode = int(0 to u32.max)
#else
	// POSIX-style byte-sized exit codes on Linux and macOS. WASI shares this
	// range: the wasm backend exits via `wasi:cli/exit.exit-with-code`, whose
	// `status-code` is a `u8` (0..255) — wasmtime masks it to the low 8 bits.
	// (NOT through `proc_exit`, which wasmtime caps to [0..126) — see
	// `emitOsExit` in MirToWasm.)
	public typealias ExitCode = int(0 to 255)
#endif

typealias StringArray = Array with String

// What separates a name from its value inside one entry: `=` (0x3D). ⭐ ONE home, because both halves of
// the split and the block ASSEMBLER must divide an entry at the same byte.
//
// ⚠ At file scope because a `let` inside a type body declares a FIELD: a constant cannot be a static
// member here. It is the only name this facility adds to the global namespace, and the three functions
// that read it are members of `Process`.
public let EnvNameValueSeparator = 61 as Byte

// A byte position inside one `NAME=VALUE` environment entry.
typealias EnvEntryBytePos = int(0 to u64.max)

/// Errors raised by current-process introspection APIs (e.g. `Process.executablePath`).
public enum ProcessIntrospectionError implements Error
	pathUnavailable

	/// No entry of this process's environment carries the name asked for. DISTINCT from a variable
	/// whose value is the empty string, which is a value a caller may legitimately have set.
	variableUnset

	/// The host could not hand over this process's environment, so no answer about it can be given.
	environmentUnreadable
end 'ProcessIntrospectionError'

// The byte `__Builtins.osEnvironmentEntry`'s one-byte "host could not answer" record holds — a NUL, which no
// cstring entry contains. `SubprocessRuntime.SubpEnvUnreadableByte` is the producer's half.
let EnvironmentUnreadableByte = 0

/// Information about the currently-running process.
public type Process
	/// Returns the absolute path to the current executable.
	/// Uses OS-specific APIs: GetModuleFileNameA (Windows),
	/// _NSGetExecutablePath (macOS), /proc/self/exe (Linux).
	public static function executablePath() returns FilePath throws ProcessIntrospectionError
		let managed = __Builtins.executablePath()
		let path = String.init(managed)
		return try FilePath.from(path) otherwise throw ProcessIntrospectionError.pathUnavailable
	end 'executablePath'

	/// The value of `name` in this process's own environment, or `variableUnset` when nothing carries
	/// it. Throws `environmentUnreadable` when the environment cannot be read at all.
	///
	/// ⭐ It reads the environment through the SAME walk `Subprocess` builds a child's block from
	/// (`currentEnvironmentEntries`), so this process has one reading of its own environment rather
	/// than two free to disagree about what is set.
	///
	/// ⚠ **THE NAME IS FOLDED ON WINDOWS AND MATCHED EXACTLY UNDER POSIX**, because that is what the
	/// two platforms mean by a variable name: Windows spells its search path `Path` and answers to
	/// `PATH`, while under POSIX two names differing in case are two variables. A byte-exact match
	/// everywhere would report `variableUnset` on Windows for variables that are plainly set.
	///
	public static function environmentVariable(name String) returns String throws ProcessIntrospectionError
		#if os(Windows)
			let wanted = name.toLower()
		#else
			let wanted = name
		#endif

		let entries = try currentEnvironmentEntries()

		for entry in entries 'eachEntry'
			#if os(Windows)
				let candidate = envEntryName(entry).toLower()
			#else
				let candidate = envEntryName(entry)
			#endif

			if candidate == wanted 'thisOne'
				return envEntryValue(entry)
			end 'thisOne'
		end 'eachEntry'

		throw ProcessIntrospectionError.variableUnset
	end 'environmentVariable'

	/// This process's environment, one `NAME=VALUE` entry per element, in the order the OS reports them.
	/// Throws `environmentUnreadable` when the host hands over no environment.
	///
	/// The walk reads `__Builtins.osEnvironmentEntry` from index 0 and tells its three answers apart by
	/// what no real entry can be: an EMPTY answer is past the last entry (every entry carries a name),
	/// and a lone NUL is the host's failure (every entry is a cstring, so none holds a NUL).
	public static function currentEnvironmentEntries() returns StringArray throws ProcessIntrospectionError
		var entries = StringArray.create()
		var index = 0

		while true 'eachEntry'
			let raw = __Builtins.osEnvironmentEntry(index)

			if raw.length() == 0 'pastTheEnd'
				break
			end 'pastTheEnd'

			if raw.length() == 1 'oneByte'
				let only = try raw.byteAt(0) otherwise panic("Process.currentEnvironmentEntries: byteAt(0) of a one-byte answer")

				if only == EnvironmentUnreadableByte 'hostFailed'
					throw ProcessIntrospectionError.environmentUnreadable
				end 'hostFailed'
			end 'oneByte'

			entries.push(String.init(raw))
			index = index + 1
		end 'eachEntry'

		return entries
	end 'currentEnvironmentEntries'

	/// The NAME half of one `NAME=VALUE` entry — everything before its first `=`, or the whole entry when
	/// it holds none.
	public static function envEntryName(entry String) returns String
		let bytes = entry.toByteArray()

		return envEntryBytes(bytes, from: 0, to: envEntrySeparatorAt(bytes))
	end 'envEntryName'

	/// The VALUE half of one `NAME=VALUE` entry — everything past its first `=`, or the empty String when
	/// it holds none.
	///
	/// An entry carrying no separator at all is a name set to nothing, and the empty String is its value
	/// rather than a sentinel — `Process.environmentVariable` reports an ABSENT name by throwing.
	public static function envEntryValue(entry String) returns String
		let bytes = entry.toByteArray()
		let at = envEntrySeparatorAt(bytes)

		// An entry holding no separator answers `at == count`, so its value is the zero-width slice at the
		// end — the same shape a `NAME=` with nothing after it produces.
		let firstValueByte = bytes.count() if at == bytes.count() else at + 1

		return envEntryBytes(bytes, from: firstValueByte, to: bytes.count())
	end 'envEntryValue'

	/// Where one entry divides: the position of its first `=`, or its byte length when it holds none.
	///
	/// ⭐ **ONE ANSWER FOR BOTH HALVES.** A name taken from one rule and a value from another disagree
	/// the moment either is edited, and the entry they disagree over is `=C:=C:\dir` — a name split at
	/// the wrong byte reads as a value, silently.
	///
	/// ⚠ THE SEARCH STARTS AT BYTE 1, NOT BYTE 0, and that is a platform fact rather than a defensive
	/// flourish: a Windows process's environment begins with entries like `=C:=C:\dir` recording the
	/// current directory of each drive, whose NAME is `=C:`. Splitting at byte 0 would give every one of
	/// them the empty name, and they would then collide with each other in the override lookup.
	static function envEntrySeparatorAt(bytes ByteArray) returns EnvEntryBytePos
		let n = bytes.count()

		for i in 1 upto n 'eachByte'
			let b = try bytes.get(i) otherwise panic("envEntrySeparatorAt: i < n = bytes.count() but get({i}) failed")

			if b == EnvNameValueSeparator 'atSeparator'
				return i
			end 'atSeparator'
		end 'eachByte'

		return n
	end 'envEntrySeparatorAt'

	static function envEntryBytes(bytes ByteArray, from EnvEntryBytePos, to EnvEntryBytePos) returns String
		var taken = ByteArray.create()

		for i in from upto to 'eachByte'
			taken.push(try bytes.get(i) otherwise panic("envEntryBytes: i < to <= bytes.count() but get({i}) failed"))
		end 'eachByte'

		return String.from(taken)
	end 'envEntryBytes'
end 'Process'

// ============================================================================================
// THIS PROCESS'S ENVIRONMENT — the entry walk, and the rule that divides an entry
// ============================================================================================
//
// ⭐ Here rather than in `Subprocess` because reading THIS process's environment is introspection of
// this process, which is what this file is. `Subprocess` is a CONSUMER: it builds a child's block from
// these same entries, and a second walk there would be free to disagree with this one about what this
// process's environment contains.
//
// ⚠ `public` is the tier a stdlib symbol crossing a file boundary takes (see
// `Compiler/UnusedExportCheck.maxon`): `module` is audited by E3094 and would fire for every program
// that reaches only one of the two readers, which is most of them.

// What separates a name from its value inside one entry: `=` (0x3D). ⭐ ONE home, because both halves of
