/// HMAC message authentication over SHA-2 (RFC 2104), and a constant-time byte comparison.
/// @category Crypto
let hmacInnerPadByte = 0x36
let hmacOuterPadByte = 0x5c

/// The full-length HMAC of `message` under `key`, for a key of any length.
public function hmac(algorithm HashAlgorithm, key ByteArray, message ByteArray) returns ByteArray
	let blockBytes = algorithm.blockBytes()
	let blockKey = hmacBlockKey(algorithm, key: key, blockBytes: blockBytes)

	var inner = Digest.create(algorithm)
	inner.update(hmacMaskedKey(blockKey, mask: hmacInnerPadByte, blockBytes: blockBytes))
	inner.update(message)

	var outer = Digest.create(algorithm)
	outer.update(hmacMaskedKey(blockKey, mask: hmacOuterPadByte, blockBytes: blockBytes))
	outer.update(inner.finalize())
	return outer.finalize()
end 'hmac'

function hmacBlockKey(algorithm HashAlgorithm, key ByteArray, blockBytes HashBlockBytes) returns ByteArray
	if key.count() <= blockBytes 'fits'
		return key
	end 'fits'

	return sha2Once(algorithm, data: key)
end 'hmacBlockKey'

function hmacMaskedKey(key ByteArray, mask Byte, blockBytes HashBlockBytes) returns ByteArray
	var masked = ByteArray.create()
	masked.reserve(blockBytes)

	for byte in key 'eachKeyByte'
		masked.push(byte xor mask)
	end 'eachKeyByte'

	while masked.count() < blockBytes 'zeroPadded'
		masked.push(mask)
	end 'zeroPadded'

	return masked
end 'hmacMaskedKey'

/// Whether `a` and `b` hold the same bytes. For equal lengths every pair is compared, with no early
/// exit, so the running time reveals the length and nothing else: compare MAC tags with this.
public function constantTimeEqual(a ByteArray, b ByteArray) returns bool
	if a.count() != b.count() 'lengths'
		return false
	end 'lengths'

	var difference = 0 as Byte

	for (iter, left) in a.withIterator() 'eachPair'
		let right = try b.get(iter.index()) otherwise panic("constantTimeEqual: index past the equal length just checked")
		difference = difference or (left xor right)
	end 'eachPair'

	return difference == 0
end 'constantTimeEqual'
