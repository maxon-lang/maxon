/// Random integers and bytes from the operating system's cryptographic source, on every target.
/// @category System

/// Why `Random` could not draw.
public enum RandomError implements Error
	unavailable  // the operating system refused to supply random bytes
end 'RandomError'

public typealias RandomDraw = int(0 to u64.max)
public typealias RandomBound = int(1 to u64.max) implements RandomDraw
public typealias RandomByteCount = int(0 to u64.max) implements ElementIndex
typealias RandomWord = bits(64)

let RandomWordBytes = 8
let RandomFillSucceeded = 0
let RandomByteRadix = 256
let RandomHalfWordBits = 32
let RandomHalfWordMask = 4294967295

public type Random
	/// A uniformly distributed integer from 0 to `u64.max`.
	public static function draw() returns RandomDraw throws RandomError
		let drawn = try bytes(RandomWordBytes)
		var value = 0 as RandomDraw

		for byte in drawn 'eachByte'
			value = value * RandomByteRadix + (byte as RandomDraw)
		end 'eachByte'

		return value
	end 'draw'

	/// `count` fresh bytes, every one from the operating system's source. `bytes(0)` is empty and asks
	/// the operating system for nothing.
	public static function bytes(count RandomByteCount) returns ByteArray throws RandomError
		let drawn = ByteArray.create(0)

		if count == 0 'nothingToDraw'
			return drawn
		end 'nothingToDraw'

		drawn.resize(count)

		if __Builtins.fillRandom(drawn.managed) != RandomFillSucceeded 'refused'
			throw RandomError.unavailable
		end 'refused'

		return drawn
	end 'bytes'

	/// A uniformly distributed integer from 0 to `bound - 1`.
	public static function below(bound RandomBound) returns RandomDraw throws RandomError
		let mask = (bound - 1) as RandomDraw

		if (bound and mask) == 0 'powerOfTwo'
			let word = try draw()

			return word and mask
		end 'powerOfTwo'

		// The answer is the high half of the 128-bit product `word * bound`, and `lowHalfOfProduct` is the
		// low half: it multiplies as `RandomWord`, because `*` over a `RandomDraw` panics on overflow. A
		// draw whose low half is below `2^64 mod bound` is drawn again, or the low answers would be
		// likelier; testing `< bound` first spares that division, because the threshold is below it.
		var word = try draw()
		var lowHalf = lowHalfOfProduct(word, factor: bound)

		while lowHalf < bound and lowHalf < rejectionThreshold(bound) 'inTheBiasedTail'
			word = try draw()
			lowHalf = lowHalfOfProduct(word, factor: bound)
		end 'inTheBiasedTail'

		return highHalfOfProduct(word, factor: bound)
	end 'below'

	static function lowHalfOfProduct(left RandomDraw, factor RandomDraw) returns RandomDraw
		return ((left as RandomWord) * (factor as RandomWord)) as RandomDraw
	end 'lowHalfOfProduct'

	static function rejectionThreshold(bound RandomBound) returns RandomDraw
		return ((u64.max - bound + 1) mod bound) as RandomDraw
	end 'rejectionThreshold'

	static function highHalfOfProduct(left RandomDraw, factor RandomDraw) returns RandomDraw
		let leftLow = left and RandomHalfWordMask
		let leftHigh = left shr RandomHalfWordBits
		let factorLow = factor and RandomHalfWordMask
		let factorHigh = factor shr RandomHalfWordBits

		let lowProduct = leftLow * factorLow
		let crossCarry = leftHigh * factorLow + (lowProduct shr RandomHalfWordBits)
		let crossLow = (crossCarry and RandomHalfWordMask) + leftLow * factorHigh

		return leftHigh * factorHigh + (crossCarry shr RandomHalfWordBits) + (crossLow shr RandomHalfWordBits)
	end 'highHalfOfProduct'
end 'Random'
