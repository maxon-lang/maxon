/// File reading, writing, and manipulation operations.
/// @category System
/// Error for file read operations
public enum FileReadError implements Error
	notFound
	accessDenied
	busy
	failed

	public function failure() returns FileFailure
		return match self 'cause'
			notFound gives FileFailure.notFound
			accessDenied gives FileFailure.accessDenied
			busy gives FileFailure.busy
			failed gives FileFailure.failed
		end 'cause'
	end 'failure'
end 'FileReadError'

/// Error for file write operations
public enum FileWriteError implements Error
	failed
	notFound
	accessDenied
	alreadyExists
	busy
	partialFileLeft  // `createText` failed to write and could not delete the file it had created

	public function failure() returns FileFailure
		return match self 'cause'
			failed gives FileFailure.failed
			notFound gives FileFailure.notFound
			accessDenied gives FileFailure.accessDenied
			alreadyExists gives FileFailure.alreadyExists
			busy gives FileFailure.busy
			partialFileLeft gives FileFailure.failed
		end 'cause'
	end 'failure'
end 'FileWriteError'

/// Error for file delete operations
public enum FileDeleteError implements Error
	notFound
	accessDenied
	busy
	failed

	public function failure() returns FileFailure
		return match self 'cause'
			notFound gives FileFailure.notFound
			accessDenied gives FileFailure.accessDenied
			busy gives FileFailure.busy
			failed gives FileFailure.failed
		end 'cause'
	end 'failure'
end 'FileDeleteError'

/// Error for file rename operations
public enum FileRenameError implements Error
	failed
	notFound
	accessDenied
	busy

	public function failure() returns FileFailure
		return match self 'cause'
			failed gives FileFailure.failed
			notFound gives FileFailure.notFound
			accessDenied gives FileFailure.accessDenied
			busy gives FileFailure.busy
		end 'cause'
	end 'failure'
end 'FileRenameError'

/// A size in bytes, and a moment in whole Unix seconds. Both come out of `__ManagedFile.statField`,
/// which answers an i64 on every platform: a size is `off_t`/`GetFileSizeEx` and a timestamp has
/// already been converted from FILETIME's 100 ns ticks to seconds since 1970 by the runtime. Neither
/// can present a value above `i64.max`, so the upper bound costs nothing and buys the doors a check.
public typealias FileSize = int(0 to u64.max)
public typealias Timestamp = int(0 to u64.max)

/// Error for file info operations
public enum FileInfoError implements Error
	notFound
	accessDenied
	busy
	failed

	public function failure() returns FileFailure
		return match self 'cause'
			notFound gives FileFailure.notFound
			accessDenied gives FileFailure.accessDenied
			busy gives FileFailure.busy
			failed gives FileFailure.failed
		end 'cause'
	end 'failure'
end 'FileInfoError'

/// Metadata about a file
public type FileInfo
	public let size as FileSize
	public let modifiedTime as Timestamp
	public let createdTime as Timestamp
	public let accessedTime as Timestamp
	public let isDirectory as bool
	public let isReadOnly as bool

	public static function create(size FileSize, modifiedTime Timestamp, createdTime Timestamp, accessedTime Timestamp, isDirectory bool, isReadOnly bool) returns FileInfo
		return FileInfo{size: size, modifiedTime: modifiedTime, createdTime: createdTime, accessedTime: accessedTime, isDirectory: isDirectory, isReadOnly: isReadOnly}
	end 'create'
end 'FileInfo'

public typealias ByteArray = Array with Byte

/// File permission mode for write operations
public enum FilePermission
	normal  // 0666 - standard file permissions
	executable  // 0755 - executable permissions (Unix)
end 'FilePermission'

let ReadChunkBytes = 4096 as FileSize

/// A file handle opened for reading.
type FileReader
	let file as __ManagedFile

	/// Open file for reading, throwing if not found
	static function open(path String) returns FileReader throws FileReadError
		let result = try __ManagedFile.openRead(path.addressableBytes()) otherwise (e) 'openFailed'
			throw readFailureOf(e)
		end 'openFailed'

		return FileReader{file: result}
	end 'open'

	/// Read entire file into managed memory with extra bytes for null terminator etc.
	/// It reads until a read returns nothing, past `size()`: a Linux `/proc` file reports a size of 0
	/// and still holds text (`specs/file-io.md` pins this).
	function readAll(extraBytes FileSize) returns __ManagedMemory throws FileReadError
		let size = try file.size() otherwise (e) 'sizeFailed'
			throw readFailureOf(e)
		end 'sizeFailed'

		var managed = try __ManagedMemory.create(size + ReadChunkBytes, 1) otherwise 'createErr'
			panic("File.readAll: create — size + ReadChunkBytes is positive")
		end 'createErr'

		while true 'eachChunk'
			if managed.capacity() - managed.length() < ReadChunkBytes 'roomForAChunk'
				try managed.grow(managed.length() + ReadChunkBytes) otherwise panic("File.readAll: grow — the new capacity is above the current one")
			end 'roomForAChunk'

			let got = try file.readAppending(managed, managed.capacity() - managed.length()) otherwise (e) 'readFailed'
				throw readFailureOf(e)
			end 'readFailed'

			if got == 0 'endOfFile'
				break
			end 'endOfFile'
		end 'eachChunk'

		file.close()

		if managed.capacity() < managed.length() + extraBytes 'roomForTheExtra'
			try managed.grow(managed.length() + extraBytes) otherwise panic("File.readAll: grow — the new capacity is above the current one")
		end 'roomForTheExtra'

		return managed
	end 'readAll'
end 'FileReader'

/// A file handle opened for writing.
type FileWriter
	let file as __ManagedFile

	/// Open a file for writing with the given permission mode, throwing on failure
	static function open(path __ManagedMemory, mode FilePermission) returns FileWriter throws FileWriteError
		let fileHandle = try openForWriting(path, mode: mode) otherwise (e) 'openFailed'
			throw writeFailureOf(e)
		end 'openFailed'

		return FileWriter{file: fileHandle}
	end 'open'

	static function openNew(path __ManagedMemory) returns FileWriter throws FileWriteError
		let fileHandle = try __ManagedFile.openCreateNew(path) otherwise (e) 'createFailed'
			throw writeFailureOf(e)
		end 'createFailed'

		return FileWriter{file: fileHandle}
	end 'openNew'

	/// Write managed memory content and close the file. Closes the file on both
	/// success and error paths.
	function writeAll(managed __ManagedMemory) throws FileWriteError
		try file.write(managed) otherwise (e) 'err'
			file.close()
			throw writeFailureOf(e)
		end 'err'

		file.close()
	end 'writeAll'
end 'FileWriter'

function openForWriting(path __ManagedMemory, mode FilePermission) returns __ManagedFile throws __ManagedFileError
	return match mode 'perm'
		executable gives try __ManagedFile.openWriteExecutable(path)
		normal gives try __ManagedFile.openWrite(path)
	end 'perm'
end 'openForWriting'

/// Static file operations.
public type File
	/// Read text file content as a UTF-8 string
	public static function readText(path FilePath) returns String throws FileReadError
		var reader = try FileReader.open(path.path)
		var managed = try reader.readAll(1)
		let len = managed.length()

		// Write null terminator: len is within capacity (extraBytes=1) but at the
		// length boundary, so temporarily extend length to allow setByte at that index
		try managed.setLength(len + 1) otherwise 'lenErr1'
			panic("File.readText: setLength(len+1) — extraBytes=1 guarantees capacity")
		end 'lenErr1'

		try managed.setByte(len, 0) otherwise 'setErr'
			panic("File.readText: setByte at null terminator — length just extended to len+1")
		end 'setErr'

		try managed.setLength(len) otherwise 'lenErr2'
			panic("File.readText: setLength(len) — restoring original length always valid")
		end 'lenErr2'

		return String.init(managed)
	end 'readText'

	/// Read file content as raw bytes
	public static function readBinary(path FilePath) returns ByteArray throws FileReadError
		var reader = try FileReader.open(path.path)
		let managed = try reader.readAll(0)
		return ByteArray.init(managed)
	end 'readBinary'

	/// Write string content to a text file
	public static function writeText(path FilePath, content String, mode FilePermission = FilePermission.normal) throws FileWriteError
		var writer = try FileWriter.open(path.path.addressableBytes(), mode: mode)
		try writer.writeAll(content.addressableBytes())
	end 'writeText'

	/// Create a new file holding `content`. Throws `alreadyExists` when the path is already there. A
	/// failed write deletes the file it created and throws the write's error; `partialFileLeft` when
	/// that delete fails too.
	public static function createText(path FilePath, content String) throws FileWriteError
		var writer = try FileWriter.openNew(path.path.addressableBytes())

		try writer.writeAll(content.addressableBytes()) otherwise (e) 'unwritten'
			try File.delete(path) otherwise (cleanup) 'kept'
				if cleanup == FileDeleteError.notFound 'nothingLeft'
					throw e
				end 'nothingLeft'

				throw FileWriteError.partialFileLeft
			end 'kept'

			throw e
		end 'unwritten'
	end 'createText'

	/// Write binary content to a file
	public static function writeBinary(path FilePath, content ByteArray, mode FilePermission = FilePermission.normal) throws FileWriteError
		var writer = try FileWriter.open(path.path.addressableBytes(), mode: mode)
		try writer.writeAll(content.managed)
	end 'writeBinary'

	/// Check if a file exists at the given path
	public static function exists(path FilePath) returns bool
		let result = __ManagedFile.exists(path.path.addressableBytes())
		return result != 0
	end 'exists'

	/// Delete a file at the given path
	public static function delete(path FilePath) throws FileDeleteError
		try __ManagedFile.delete(path.path.addressableBytes()) otherwise (e) 'failed'
			throw deleteFailureOf(e)
		end 'failed'
	end 'delete'

	/// Atomically rename (move) a file from one path to another. If the
	/// destination exists it is replaced in a single step, so a reader of the
	/// destination never observes a partially written file. Used to publish
	/// freshly written files (e.g. cache entries) without a torn-read window.
	public static function rename(from FilePath, to FilePath) throws FileRenameError
		try __ManagedFile.rename(from.path.addressableBytes(), to.path.addressableBytes()) otherwise (e) 'failed'
			throw renameFailureOf(e)
		end 'failed'
	end 'rename'

	/// Get file metadata
	public static function info(path FilePath) returns FileInfo throws FileInfoError
		let statResult = try __ManagedFile.stat(path.path.addressableBytes()) otherwise (e) 'statFailed'
			throw infoFailureOf(e)
		end 'statFailed'

		let fileSize = __ManagedFile.statField(statResult, 0) as FileSize
		let mtime = __ManagedFile.statField(statResult, 1) as Timestamp
		let ctime = __ManagedFile.statField(statResult, 2) as Timestamp
		let atime = __ManagedFile.statField(statResult, 3) as Timestamp
		let attrs = __ManagedFile.statField(statResult, 4)
		let isDir = attrs == 1
		let roAttrs = __ManagedFile.statField(statResult, 5)
		let isRo = roAttrs == 1
		__ManagedFile.statFree(statResult)
		return FileInfo.create(fileSize, modifiedTime: mtime, createdTime: ctime, accessedTime: atime, isDirectory: isDir, isReadOnly: isRo)
	end 'info'
end 'File'

/// Why a file operation failed, whichever operation it was: every `File` error answers it through
/// `failure()`, so a caller can judge them all in one place.
public enum FileFailure
	notFound
	accessDenied
	alreadyExists
	busy
	failed
end 'FileFailure'

function fileFailureOf(cause __ManagedFileError) returns FileFailure
	return match cause 'cause'
		notFound gives FileFailure.notFound
		accessDenied gives FileFailure.accessDenied
		alreadyExists gives FileFailure.alreadyExists
		busy gives FileFailure.busy
		openFailed or
		readFailed or
		writeFailed or
		sizeFailed or
		deleteFailed or
		statFailed or
		invalidStatBuffer or
		invalidStatIndex or
		closed gives FileFailure.failed
	end 'cause'
end 'fileFailureOf'

function readFailureOf(cause __ManagedFileError) returns FileReadError
	return match fileFailureOf(cause) 'failure'
		notFound gives FileReadError.notFound
		accessDenied gives FileReadError.accessDenied
		busy gives FileReadError.busy
		alreadyExists or
		failed gives FileReadError.failed
	end 'failure'
end 'readFailureOf'

function writeFailureOf(cause __ManagedFileError) returns FileWriteError
	return match fileFailureOf(cause) 'failure'
		notFound gives FileWriteError.notFound
		accessDenied gives FileWriteError.accessDenied
		alreadyExists gives FileWriteError.alreadyExists
		busy gives FileWriteError.busy
		failed gives FileWriteError.failed
	end 'failure'
end 'writeFailureOf'

function deleteFailureOf(cause __ManagedFileError) returns FileDeleteError
	return match fileFailureOf(cause) 'failure'
		notFound gives FileDeleteError.notFound
		accessDenied gives FileDeleteError.accessDenied
		busy gives FileDeleteError.busy
		alreadyExists or
		failed gives FileDeleteError.failed
	end 'failure'
end 'deleteFailureOf'

function renameFailureOf(cause __ManagedFileError) returns FileRenameError
	return match fileFailureOf(cause) 'failure'
		notFound gives FileRenameError.notFound
		accessDenied gives FileRenameError.accessDenied
		busy gives FileRenameError.busy
		alreadyExists or
		failed gives FileRenameError.failed
	end 'failure'
end 'renameFailureOf'

function infoFailureOf(cause __ManagedFileError) returns FileInfoError
	return match fileFailureOf(cause) 'failure'
		notFound gives FileInfoError.notFound
		accessDenied gives FileInfoError.accessDenied
		busy gives FileInfoError.busy
		alreadyExists or
		failed gives FileInfoError.failed
	end 'failure'
end 'infoFailureOf'
