/// The certificate chain and private key a TLS endpoint presents.
/// @category Network
let tlsPemCertificateLabel = "CERTIFICATE"
let tlsPemPkcs8KeyLabel = "PRIVATE KEY"
let tlsPemEcKeyLabel = "EC PRIVATE KEY"
let tlsPemRsaKeyLabel = "RSA PRIVATE KEY"

let tlsDerIntegerTag = 2
let tlsDerOctetStringTag = 4
let tlsDerSequenceTag = 16
let tlsDerIntegerIdentifier = 0x02
let tlsDerOctetStringIdentifier = 0x04
let tlsDerSequenceIdentifier = 0x30
let tlsDerObjectIdentifierIdentifier = 0x06
let tlsEcParametersTag = 0
let tlsEcPublicKeyTag = 1

let tlsKeyVersionZero = ByteArray from [0]
let tlsKeyVersionOne = ByteArray from [1]
let tlsEcP256ScalarBytes = 32
let tlsEcP384ScalarBytes = 48
let tlsEd25519SeedBytes = 32

module typealias TlsPemLabelArray = Array with String

/// A certificate chain, leaf first, and the private key of its first certificate.
public type TlsIdentity
	module var chain as ByteArrays
	module var key as TlsPrivateKey

	/// DER certificates and a private key as PKCS #8, SEC1 or PKCS #1. Only the first certificate is read; the rest
	/// are sent as given.
	public static function fromDer(chain ByteArrays, key ByteArray) returns TlsIdentity throws TlsError
		let leafDer = try chain.first() otherwise throw TlsError.invalidCertificate

		let leaf = try X509.parse(leafDer) otherwise throw TlsError.invalidCertificate
		let parsed = try tlsParsePrivateKey(key.clone())

		if leaf.publicKey().algorithm() != parsed.algorithm() or not (try tlsPairsWith(parsed, certificateKey: leaf.publicKey())) 'foreignKey'
			throw TlsError.invalidPrivateKey
		end 'foreignKey'

		return Self{chain: chain.clone(), key: parsed}
	end 'fromDer'

	/// The `CERTIFICATE` blocks of `certificates` and the first private key block of `key`.
	public static function fromPem(certificates String, key String) returns TlsIdentity throws TlsError
		var chain = ByteArrays.create()
		let certificateBlocks = try Pem.decode(certificates) otherwise throw TlsError.invalidPem
		let keyBlocks = try Pem.decode(key) otherwise throw TlsError.invalidPem

		for block in certificateBlocks 'eachCertificate'
			if block.label() == tlsPemCertificateLabel 'isCertificate'
				chain.push(block.bytes().clone())
			end 'isCertificate'
		end 'eachCertificate'

		for block in keyBlocks 'eachKey'
			if tlsPemKeyLabels().contains(block.label()) 'isKey'
				return try fromDer(chain, key: block.bytes().clone())
			end 'isKey'
		end 'eachKey'

		throw TlsError.invalidPem
	end 'fromPem'
end 'TlsIdentity'

function tlsPemKeyLabels() returns TlsPemLabelArray
	return TlsPemLabelArray from [tlsPemPkcs8KeyLabel, tlsPemEcKeyLabel, tlsPemRsaKeyLabel]
end 'tlsPemKeyLabels'

union TlsEcCurveName
	unspecified
	named(oid ByteArray)

	function agreeing(other TlsEcCurveName) returns TlsEcCurveName throws TlsError
		match self 'self'
			unspecified then return other
			named(oid) then return try other.confirming(oid)
		end 'self'
	end 'agreeing'

	function confirming(oid ByteArray) returns TlsEcCurveName throws TlsError
		match self 'self'
			unspecified then return TlsEcCurveName.named(oid)
			named(own) then return try tlsRequireSameCurve(own, other: oid)
		end 'self'
	end 'confirming'
end 'TlsEcCurveName'

function tlsRequireSameCurve(first ByteArray, other ByteArray) returns TlsEcCurveName throws TlsError
	if not first.equals(other) 'differ'
		throw TlsError.invalidPrivateKey
	end 'differ'

	return TlsEcCurveName.named(first)
end 'tlsRequireSameCurve'

function tlsParsePrivateKey(der ByteArray) returns TlsPrivateKey throws TlsError
	var info = try DerReader.wholeSequence(der) otherwise throw TlsError.invalidPrivateKey

	let version = try info.readInteger() otherwise throw TlsError.invalidPrivateKey
	let next = try info.peekHeader() otherwise throw TlsError.invalidPrivateKey

	if next.tagNumber() == tlsDerSequenceTag 'pkcs8'
		try requireKeyVersion(version, expected: tlsKeyVersionZero)

		return try tlsPkcs8Key(der, info: info)
	end 'pkcs8' else if next.tagNumber() == tlsDerOctetStringTag 'sec1'
		try requireKeyVersion(version, expected: tlsKeyVersionOne)

		return try tlsEcKey(info, outer: TlsEcCurveName.unspecified)
	end 'sec1' else if next.tagNumber() == tlsDerIntegerTag 'pkcs1'
		return try tlsRsaKey(tlsPkcs8OfPkcs1(der))
	end 'pkcs1'

	throw TlsError.invalidPrivateKey
end 'tlsParsePrivateKey'

function requireKeyVersion(version ByteArray, expected ByteArray) throws TlsError
	if not version.equals(expected) 'unsupportedVersion'
		throw TlsError.invalidPrivateKey
	end 'unsupportedVersion'
end 'requireKeyVersion'

function tlsRsaKey(pkcs8 ByteArray) returns TlsPrivateKey throws TlsError
	let key = try RsaPrivateKey.parse(pkcs8) otherwise throw TlsError.invalidPrivateKey

	return TlsPrivateKey.rsa(key)
end 'tlsRsaKey'

function tlsPkcs8Key(der ByteArray, info DerReader) returns TlsPrivateKey throws TlsError
	var algorithm = try info.enterSequence() otherwise throw TlsError.invalidPrivateKey
	let identifier = try algorithm.readObjectIdentifier() otherwise throw TlsError.invalidPrivateKey

	if identifier.equals(rsaEncryptionOid) 'rsa'
		return try tlsRsaKey(der)
	end 'rsa'

	if identifier.equals(x509OidEd25519) 'ed25519'
		try algorithm.finish() otherwise throw TlsError.invalidPrivateKey

		let wrapped = try info.readOctetString() otherwise throw TlsError.invalidPrivateKey

		try info.finish() otherwise throw TlsError.invalidPrivateKey

		return try tlsEd25519Key(wrapped)
	end 'ed25519'

	if identifier.equals(x509OidEcPublicKey) 'ec'
		let parameters = try algorithm.readElement() otherwise throw TlsError.invalidPrivateKey

		try algorithm.finish() otherwise throw TlsError.invalidPrivateKey

		var sec1 = DerReader.create(try info.readOctetString() otherwise throw TlsError.invalidPrivateKey)

		try info.finish() otherwise throw TlsError.invalidPrivateKey

		var key = try sec1.enterSequence() otherwise throw TlsError.invalidPrivateKey

		try sec1.finish() otherwise throw TlsError.invalidPrivateKey
		try requireKeyVersion(try key.readInteger() otherwise throw TlsError.invalidPrivateKey, expected: tlsKeyVersionOne)

		return try tlsEcKey(key, outer: TlsEcCurveName.named(parameters))
	end 'ec'

	throw TlsError.invalidPrivateKey
end 'tlsPkcs8Key'

function tlsEd25519Key(wrapped ByteArray) returns TlsPrivateKey throws TlsError
	var wrapper = DerReader.create(wrapped)
	let seed = try wrapper.readOctetString() otherwise throw TlsError.invalidPrivateKey

	try wrapper.finish() otherwise throw TlsError.invalidPrivateKey

	if seed.count() != tlsEd25519SeedBytes 'seedLength'
		throw TlsError.invalidPrivateKey
	end 'seedLength'

	return TlsPrivateKey.ed25519(seed)
end 'tlsEd25519Key'

function tlsEcKey(key DerReader, outer TlsEcCurveName) returns TlsPrivateKey throws TlsError
	let scalar = try key.readOctetString() otherwise throw TlsError.invalidPrivateKey
	var inner = TlsEcCurveName.unspecified

	if not key.isAtEnd() and (try key.peekHeader() otherwise throw TlsError.invalidPrivateKey).tagNumber() == tlsEcParametersTag 'explicitParameters'
		var explicit = try key.enterExplicit(tlsEcParametersTag) otherwise throw TlsError.invalidPrivateKey

		inner = TlsEcCurveName.named(try explicit.readElement() otherwise throw TlsError.invalidPrivateKey)

		try explicit.finish() otherwise throw TlsError.invalidPrivateKey
	end 'explicitParameters'

	if not key.isAtEnd() 'publicKey'
		var explicit = try key.enterExplicit(tlsEcPublicKeyTag) otherwise throw TlsError.invalidPrivateKey

		_ = try explicit.readBitString() otherwise throw TlsError.invalidPrivateKey

		try explicit.finish() otherwise throw TlsError.invalidPrivateKey
	end 'publicKey'

	try key.finish() otherwise throw TlsError.invalidPrivateKey

	let curve = try tlsEcCurve(try outer.agreeing(inner), scalarBytes: scalar.count())

	if scalar.count() != tlsEcScalarBytes(curve) 'scalarLength'
		throw TlsError.invalidPrivateKey
	end 'scalarLength'

	return match curve 'curve'
		p256 gives TlsPrivateKey.ecP256(scalar)
		p384 gives TlsPrivateKey.ecP384(scalar)
	end 'curve'
end 'tlsEcKey'

function tlsEcCurve(name TlsEcCurveName, scalarBytes Count) returns EcdsaCurve throws TlsError
	match name 'name'
		unspecified then return try tlsEcCurveOfScalar(scalarBytes)
		named(oid) then return try tlsEcCurveOfParameters(oid)
	end 'name'
end 'tlsEcCurve'

function tlsEcCurveOfScalar(scalarBytes Count) returns EcdsaCurve throws TlsError
	if scalarBytes == tlsEcP256ScalarBytes 'p256'
		return EcdsaCurve.p256
	end 'p256'

	if scalarBytes == tlsEcP384ScalarBytes 'p384'
		return EcdsaCurve.p384
	end 'p384'

	throw TlsError.invalidPrivateKey
end 'tlsEcCurveOfScalar'

function tlsEcCurveOfParameters(parameters ByteArray) returns EcdsaCurve throws TlsError
	if parameters.equals(x509ParametersP256) 'p256'
		return EcdsaCurve.p256
	end 'p256'

	if parameters.equals(x509ParametersP384) 'p384'
		return EcdsaCurve.p384
	end 'p384'

	throw TlsError.invalidPrivateKey
end 'tlsEcCurveOfParameters'

function tlsEcScalarBytes(curve EcdsaCurve) returns Count
	return match curve 'curve'
		p256 gives tlsEcP256ScalarBytes
		p384 gives tlsEcP384ScalarBytes
	end 'curve'
end 'tlsEcScalarBytes'

function tlsPairsWith(key TlsPrivateKey, certificateKey X509PublicKey) returns bool throws TlsError
	return match key 'key'
		ecP256(scalar) gives (try nistPublicKey(EcdsaCurve.p256, privateKey: scalar) otherwise throw TlsError.invalidPrivateKey).equals(certificateKey.keyBytes())
		ecP384(scalar) gives (try nistPublicKey(EcdsaCurve.p384, privateKey: scalar) otherwise throw TlsError.invalidPrivateKey).equals(certificateKey.keyBytes())
		rsa(rsaKey) gives rsaKey.pairs(certificateKey.der())
		ed25519(seed) gives (try Ed25519.publicKey(seed) otherwise throw TlsError.invalidPrivateKey).equals(certificateKey.keyBytes())
	end 'key'
end 'tlsPairsWith'

function tlsPkcs8OfPkcs1(pkcs1 ByteArray) returns ByteArray
	var algorithm = derElement(tlsDerObjectIdentifierIdentifier, contents: rsaEncryptionOid)
	algorithm.append(x509ParametersNull)

	var body = derElement(tlsDerIntegerIdentifier, contents: tlsKeyVersionZero)
	body.append(derElement(tlsDerSequenceIdentifier, contents: algorithm))
	body.append(derElement(tlsDerOctetStringIdentifier, contents: pkcs1))

	return derElement(tlsDerSequenceIdentifier, contents: body)
end 'tlsPkcs8OfPkcs1'
