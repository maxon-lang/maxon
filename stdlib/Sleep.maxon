/// Suspend the current green thread for the given number of milliseconds.
/// @category System
// A non-negative wait. `i64.max` ms is ~292 million years, so the bound excludes nothing a caller
// could mean, and it makes the parameter a checked door instead of an unguarded full range.
typealias Milliseconds = int(0 to i64.max)

public function sleep(milliseconds Milliseconds)
	__Builtins.sleep(milliseconds)
end 'sleep'
