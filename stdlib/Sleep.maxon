/// Suspend the current green thread for the given number of milliseconds.
/// @category System
// A non-negative wait.
public typealias Milliseconds = int(0 to u64.max)

public function sleep(milliseconds Milliseconds)
	__Builtins.sleep(milliseconds)
end 'sleep'

/// A `sendTimeout:` that waits for room in a full mailbox as long as it takes, untimed. Such a send
/// fails `mailboxFull` only when the coroutine sending it has been cancelled. A program whose every
/// green thread is waiting stops with exit code 92.
public let ForeverMs = u64.max as Milliseconds
