/// Monotonic time helpers. Use for measuring elapsed durations; absolute
/// values are platform-defined (e.g. milliseconds since boot) and only
/// meaningful when subtracted.
/// @category System
/// ⭐ **NO SHIM BEHIND THESE CAN PRESENT A VALUE ABOVE `i64.max`, AND THAT WAS CHECKED RATHER THAN
/// ASSUMED.** `__gt_now_ns` — the one monotonic source both `currentTimeNanos` and `currentTimeMs`
/// lower to — scales QPC ticks with SIGNED `div`/`mod` and answers nanoseconds since boot, which
/// needs 292 years of uptime to reach `i64.max`; `GetTickCount64` and `clock_gettime` are the same
/// quantity in coarser units. The wasm lane has no clock at all — `StdToWasm` panics on
/// `osReadClock`, so no WASI `monotonic-clock.now` u64 reaches here. A duration is the difference of
/// two such instants and is clamped at 0 below, so it is bounded by the same word.
public typealias DurationMs = int(0 to i64.max)
public typealias InstantMs = int(0 to i64.max)
public typealias DurationNanos = int(0 to i64.max)
public typealias InstantNanos = int(0 to i64.max)

public type Clock
	/// Monotonic time in milliseconds. Differences between two `nowMs()`
	/// readings are meaningful; the absolute value is not.
	///
	/// The underlying source is the platform's COARSE tick counter
	/// (`GetTickCount64` on Windows), whose period is ~15.6 ms. Anything that
	/// needs to resolve durations shorter than a scheduler tick — profiling,
	/// benchmarking, latency accounting — must use `nowNanos()` instead.
	public static function nowMs() returns InstantMs
		return __Builtins.currentTimeMs()
	end 'nowMs'

	/// Milliseconds elapsed since a prior `nowMs()` reading. Clamps to 0 if
	/// the system clock somehow moves backwards between the two readings
	/// (shouldn't happen on a monotonic source, but guards against bugs).
	public static function elapsedMs(since InstantMs) returns DurationMs
		let now = Clock.nowMs()
		if now < since 'clockSkew'
			return 0
		end 'clockSkew'
		return now - since
	end 'elapsedMs'

	/// Monotonic time in nanoseconds, read from the platform's HIGH-RESOLUTION
	/// counter (`QueryPerformanceCounter` on Windows, `clock_gettime(CLOCK_MONOTONIC)`
	/// on Linux/macOS, `wasi:clocks/monotonic-clock.now` on WASI). Differences
	/// between two `nowNanos()` readings are meaningful; the absolute value is
	/// not.
	///
	/// The value is always expressed in nanoseconds, but the counter's PERIOD is
	/// platform-defined — typically 100 ns on Windows and 1 ns elsewhere — so
	/// successive readings taken back-to-back may compare equal.
	public static function nowNanos() returns InstantNanos
		return __Builtins.currentTimeNanos()
	end 'nowNanos'

	/// Nanoseconds elapsed since a prior `nowNanos()` reading. Clamps to 0 on
	/// apparent backwards movement, mirroring `elapsedMs`.
	public static function elapsedNanos(since InstantNanos) returns DurationNanos
		let now = Clock.nowNanos()
		if now < since 'clockSkew'
			return 0
		end 'clockSkew'
		return now - since
	end 'elapsedNanos'
end 'Clock'

/// Whole seconds since the Unix epoch, 1970-01-01 00:00:00 UTC. `i64.max` seconds is ~292 billion
/// years, so the bound excludes no representable calendar moment the platform can report.
public typealias UnixSeconds = int(0 to i64.max)

/// The WALL clock — the calendar, as opposed to `Clock`, which is a stopwatch.
///
/// These are two different instruments and the distinction is not pedantry. Every reading
/// `Clock` gives you is monotonic: its absolute value is meaningless (milliseconds since boot,
/// performance-counter ticks) and only the DIFFERENCE between two readings means anything. That
/// makes it exactly right for "how long did this take" and completely useless for "what is
/// today's date" — no arithmetic turns an uptime into a calendar day.
///
/// `WallClock` answers the second question and must never be used for the first. A wall clock can
/// step BACKWARDS: NTP corrects a drift, a user changes the timezone, a VM resumes from a
/// snapshot. A duration measured across such a step comes out negative or absurd, which is
/// precisely the bug `Clock`'s monotonic guarantee exists to prevent.
///
///   duration → Clock.elapsedNanos / Clock.elapsedMs
///   date     → WallClock.nowUnixSeconds
///
/// @category System
public type WallClock
	/// Seconds since the Unix epoch, UTC. No timezone is applied — the caller converts if it
	/// wants local time, because the offset is a policy decision the stdlib has no business
	/// guessing.
	public static function nowUnixSeconds() returns UnixSeconds
		return __Builtins.currentUnixTimeSeconds()
	end 'nowUnixSeconds'
end 'WallClock'
