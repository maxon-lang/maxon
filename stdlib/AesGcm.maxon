/// AES-GCM authenticated encryption (NIST SP 800-38D) with a 12-byte nonce and a 16-byte tag.
/// @category Crypto
// bench/aes/go/bitsliced.go mirrors this file function for function; a change here is ported there in the
// same commit.
typealias GhashWord = bits(64)
typealias GhashBlock = (GhashWord, GhashWord)
typealias GhashShift = int(1 to 16)

let aesGcmNonceBytes = 12
let aesGcmTagBytes = 16
let aesGcmBlockBytes = 16
let aesGcmWordBytes = 8
let aesGcmBitsPerByte = 8
let aesGcmTagMaskCounter = 1

// 2^32 − 2 blocks of 16 bytes: counters 1 to 2^32 − 1 cover the tag mask block plus this many data
// blocks.
let aesGcmMaxPlaintextBytes = 68719476704

let ghashWordBits = 64
let ghashCarryShift = 1
let ghashTapLow = 1
let ghashTapMid = 2
let ghashTapHigh = 7
let ghashSwapBit = 1
let ghashSwapPair = 2
let ghashSwapNibble = 4
let ghashSwapByte = 8
let ghashSwapHalfword = 16
let ghashSwapWord = 32

let ghashZeroWord = 0
let ghashHoleMask0 = 0x1111111111111111 as GhashWord
let ghashHoleMask1 = 0x2222222222222222 as GhashWord
let ghashHoleMask2 = 0x4444444444444444 as GhashWord
let ghashHoleMask3 = 0x8888888888888888 as GhashWord
let ghashBitMask = 0x5555555555555555
let ghashPairMask = 0x3333333333333333
let ghashNibbleMask = 0x0F0F0F0F0F0F0F0F
let ghashByteMask = 0x00FF00FF00FF00FF
let ghashHalfwordMask = 0x0000FFFF0000FFFF

function ghashSwapUnits(word GhashWord, mask GhashWord, shift GhashShift) returns GhashWord
	return ((word and mask) shl shift) or ((word shr shift) and mask)
end 'ghashSwapUnits'

function ghashReverseBytes(word GhashWord) returns GhashWord
	let bytes2 = ghashSwapUnits(word, mask: ghashByteMask, shift: ghashSwapByte)
	let bytes4 = ghashSwapUnits(bytes2, mask: ghashHalfwordMask, shift: ghashSwapHalfword)

	return (bytes4 shl ghashSwapWord) or (bytes4 shr ghashSwapWord)
end 'ghashReverseBytes'

function ghashReverse(word GhashWord) returns GhashWord
	let bits1 = ghashSwapUnits(word, mask: ghashBitMask, shift: ghashSwapBit)
	let bits2 = ghashSwapUnits(bits1, mask: ghashPairMask, shift: ghashSwapPair)
	let bits4 = ghashSwapUnits(bits2, mask: ghashNibbleMask, shift: ghashSwapNibble)

	return ghashReverseBytes(bits4)
end 'ghashReverse'

// Carry-less multiplication through integer multiplies: each operand keeps one bit in four, so each 4-bit
// slot of a product collects at most 16 contributions, and the multiplies wrap mod 2^64.
function ghashMultiplyLow(x GhashWord, y GhashWord) returns GhashWord
	let x0 = x and ghashHoleMask0
	let x1 = x and ghashHoleMask1
	let x2 = x and ghashHoleMask2
	let x3 = x and ghashHoleMask3
	let y0 = y and ghashHoleMask0
	let y1 = y and ghashHoleMask1
	let y2 = y and ghashHoleMask2
	let y3 = y and ghashHoleMask3
	let z0 = ((x0 * y0) xor (x1 * y3) xor (x2 * y2) xor (x3 * y1)) and ghashHoleMask0
	let z1 = ((x0 * y1) xor (x1 * y0) xor (x2 * y3) xor (x3 * y2)) and ghashHoleMask1
	let z2 = ((x0 * y2) xor (x1 * y1) xor (x2 * y0) xor (x3 * y3)) and ghashHoleMask2
	let z3 = ((x0 * y3) xor (x1 * y2) xor (x2 * y1) xor (x3 * y0)) and ghashHoleMask3

	return z0 or z1 or z2 or z3
end 'ghashMultiplyLow'

function ghashFoldRight(word GhashWord) returns GhashWord
	return word xor (word shr ghashTapLow) xor (word shr ghashTapMid) xor (word shr ghashTapHigh)
end 'ghashFoldRight'

function ghashFoldSpill(word GhashWord) returns GhashWord
	return (word shl (ghashWordBits - ghashTapLow)) xor (word shl (ghashWordBits - ghashTapMid)) xor (word shl (ghashWordBits - ghashTapHigh))
end 'ghashFoldSpill'

function ghashReadWord(source ByteArray, at ElementIndex) returns GhashWord
	return (try __Builtins.readBigEndian(source, at, aesGcmWordBytes) otherwise panic("aesgcm: a word inside an array the caller sized is missing")) as GhashWord
end 'ghashReadWord'

function ghashBlockWords(data ByteArray, blockStart ElementIndex) returns GhashBlock
	let limit = data.count()

	if blockStart + aesGcmBlockBytes <= limit 'whole'
		let high = ghashReadWord(data, at: blockStart)
		let low = ghashReadWord(data, at: blockStart + aesGcmWordBytes)

		return (high, low)
	end 'whole'

	let high = readOrderedWord(data, off: blockStart, width: aesGcmWordBytes, limit: limit, order: ByteOrder.bigEndian) as GhashWord
	let low = readOrderedWord(data, off: blockStart + aesGcmWordBytes, width: aesGcmWordBytes, limit: limit, order: ByteOrder.bigEndian) as GhashWord

	return (high, low)
end 'ghashBlockWords'

type GhashKey
	var h0 as GhashWord
	var h1 as GhashWord
	var h0r as GhashWord
	var h1r as GhashWord
	var h2 as GhashWord
	var h2r as GhashWord

	static function create(hashSubkey ByteArray) returns GhashKey
		let h1 = ghashReadWord(hashSubkey, at: 0)
		let h0 = ghashReadWord(hashSubkey, at: aesGcmWordBytes)
		let h0r = ghashReverse(h0)
		let h1r = ghashReverse(h1)

		return Self{h0: h0, h1: h1, h0r: h0r, h1r: h1r, h2: h0 xor h1, h2r: h0r xor h1r}
	end 'create'

	function multiply(y1 GhashWord, y0 GhashWord) returns GhashBlock
		let y0r = ghashReverse(y0)
		let y1r = ghashReverse(y1)
		let y2 = y0 xor y1
		let y2r = y0r xor y1r

		let z0 = ghashMultiplyLow(y0, y: h0)
		let z1 = ghashMultiplyLow(y1, y: h1)
		let z2 = ghashMultiplyLow(y2, y: h2)
		let z0h = ghashMultiplyLow(y0r, y: h0r)
		let z1h = ghashMultiplyLow(y1r, y: h1r)
		let z2h = ghashMultiplyLow(y2r, y: h2r)

		let middle = z2 xor z0 xor z1
		let middleHigh = z2h xor z0h xor z1h
		let v0 = z0
		let v1 = (ghashReverse(z0h) shr ghashCarryShift) xor middle
		let v2 = z1 xor (ghashReverse(middleHigh) shr ghashCarryShift)
		let v3 = ghashReverse(z1h) shr ghashCarryShift

		let s3 = (v3 shl ghashCarryShift) or (v2 shr (ghashWordBits - ghashCarryShift))
		let s2 = (v2 shl ghashCarryShift) or (v1 shr (ghashWordBits - ghashCarryShift))
		let s1 = (v1 shl ghashCarryShift) or (v0 shr (ghashWordBits - ghashCarryShift))
		let s0 = v0 shl ghashCarryShift

		// s0 folds into s2, spilling into s1, before s1 folds into s3: s1 must already carry s0's spill.
		let t1 = s1 xor ghashFoldSpill(s0)
		let t2 = s2 xor ghashFoldRight(s0)
		let t3 = s3 xor ghashFoldRight(t1)
		let u2 = t2 xor ghashFoldSpill(t1)

		return (t3, u2)
	end 'multiply'

	function absorb(startHigh GhashWord, startLow GhashWord, data ByteArray) returns GhashBlock
		var high = startHigh
		var low = startLow
		var blockStart = 0 as ElementIndex
		let limit = data.count()

		while blockStart < limit 'eachBlock'
			let (blockHigh, blockLow) = ghashBlockWords(data, blockStart: blockStart)
			(high, low) = multiply(high xor blockHigh, y0: low xor blockLow)
			blockStart = blockStart + aesGcmBlockBytes
		end 'eachBlock'

		return (high, low)
	end 'absorb'

	function finish(high GhashWord, low GhashWord, additionalBytes Count, ciphertextBytes Count) returns GhashBlock
		return multiply(high xor ((additionalBytes * aesGcmBitsPerByte) as GhashWord), y0: low xor ((ciphertextBytes * aesGcmBitsPerByte) as GhashWord))
	end 'finish'
end 'GhashKey'

function ghashAppendTag(output ByteArray, high GhashWord, low GhashWord)
	__Builtins.appendBigEndian(output, high as OrderedWord, aesGcmWordBytes)
	__Builtins.appendBigEndian(output, low as OrderedWord, aesGcmWordBytes)
end 'ghashAppendTag'

function aesGcmCipher(key ByteArray, bitsliced bool) returns Aes throws AesError
	if bitsliced 'software'
		return try Aes.createBitsliced(key)
	end 'software'

	return try Aes.create(key)
end 'aesGcmCipher'

function aesGcmKeyFailure(failure AesError) returns AeadError
	if failure == AesError.invalidKeyLength 'length'
		return AeadError.invalidKeyLength
	end 'length'

	panic("AesGcm: Aes.create reported a block length")
end 'aesGcmKeyFailure'

/// AES-GCM under one 16-, 24- or 32-byte key.
public type AesGcm implements Aead
	var cipher as Aes
	var hashKey as GhashKey

	// Empty when the software backing is in use.
	let hardwareKeys as ByteArray

	/// The cipher for `key`, or `invalidKeyLength`.
	public static function create(key ByteArray) returns AesGcm throws AeadError
		return try Self.build(key, bitsliced: false)
	end 'create'

	// `bitsliced: true` forces the software backing, so a spec can compare the two on one CPU.
	module static function build(key ByteArray, bitsliced bool) returns AesGcm throws AeadError
		let cipher = try aesGcmCipher(key, bitsliced: bitsliced) otherwise (failure) 'refused'
			throw aesGcmKeyFailure(failure)
		end 'refused'

		var zeros = ByteArray.create()
		zeros.resize(aesGcmBlockBytes)
		let hashSubkey = try cipher.encryptBlock(zeros) otherwise panic("AesGcm: the hash subkey block was refused")
		let hashKey = GhashKey.create(hashSubkey)

		#if arch(x64) or arch(arm64)
			if not cipher.schedule.isEmpty() 'hardware'
				return Self{cipher: cipher, hashKey: hashKey, hardwareKeys: aesGcmHardwareKeys(cipher.schedule)}
			end 'hardware'
		#endif

		return Self{cipher: cipher, hashKey: hashKey, hardwareKeys: ByteArray.create()}
	end 'build'

	module function usesHardware() returns bool
		return not hardwareKeys.isEmpty()
	end 'usesHardware'

	public function seal(nonce ByteArray, plaintext ByteArray, additionalData ByteArray) returns ByteArray throws AeadError
		try aeadRequireNonce(nonce, nonceBytes: aesGcmNonceBytes)
		try aeadRequirePlaintextLength(plaintext, limit: aesGcmMaxPlaintextBytes)

		#if arch(x64) or arch(arm64)
			if not hardwareKeys.isEmpty() 'hardware'
				return aesGcmHardwareSeal(cipher.schedule, keys: hardwareKeys, nonce: nonce, plaintext: plaintext, additionalData: additionalData)
			end 'hardware'
		#endif

		var sealed = ByteArray.create()
		sealed.reserve(plaintext.count() + aesGcmTagBytes)
		let (firstLane, secondLane) = applyBehindMask(nonce, data: plaintext, output: sealed)
		let (tagHigh, tagLow) = authenticate(additionalData, ciphertext: sealed, firstLane: firstLane, secondLane: secondLane)
		ghashAppendTag(sealed, high: tagHigh, low: tagLow)

		return sealed
	end 'seal'

	// The plaintext is decrypted before the tag is known, which is what lets the tag mask share the
	// first software batch. It stays local until `aeadRequireTag` passes: a throw drops it, so no path
	// hands back unauthenticated bytes.
	public function open(nonce ByteArray, sealed ByteArray, additionalData ByteArray) returns ByteArray throws AeadError
		try aeadRequireNonce(nonce, nonceBytes: aesGcmNonceBytes)

		let parts = try aeadSplitSealed(sealed, tagBytes: aesGcmTagBytes, plaintextLimit: aesGcmMaxPlaintextBytes)

		#if arch(x64) or arch(arm64)
			if not hardwareKeys.isEmpty() 'hardware'
				var opened = ByteArray.create()
				let expectedTag = aesGcmHardwareOpen(cipher.schedule, keys: hardwareKeys, nonce: nonce, ciphertext: parts.ciphertext, additionalData: additionalData, plaintext: opened)
				try aeadRequireTag(expectedTag, received: parts.tag)

				return opened
			end 'hardware'
		#endif

		var plaintext = ByteArray.create()
		plaintext.reserve(parts.ciphertext.count())
		let (firstLane, secondLane) = applyBehindMask(nonce, data: parts.ciphertext, output: plaintext)
		let (tagHigh, tagLow) = authenticate(additionalData, ciphertext: parts.ciphertext, firstLane: firstLane, secondLane: secondLane)
		var expected = ByteArray.create()
		expected.reserve(aesGcmTagBytes)
		ghashAppendTag(expected, high: tagHigh, low: tagLow)
		try aeadRequireTag(expected, received: parts.tag)

		return plaintext
	end 'open'

	// The tag mask is the key-stream block at counter 1. The software cipher computes it in the same
	// four-block batch as the first data blocks, so that short messages cost one batch rather than two.
	function applyBehindMask(nonce ByteArray, data ByteArray, output ByteArray) returns AesPair
		let lanes = try cipher.xorKeyStreamPastFirstBlock(nonce, counter: aesGcmTagMaskCounter, data: data, output: output) otherwise (failure) 'refused'
			match failure 'reason'
				invalidNonceLength then panic("AesGcm: xorKeyStreamPastFirstBlock refused a nonce that aeadRequireNonce accepted")
				counterOverflow then panic("AesGcm: xorKeyStreamPastFirstBlock wrapped the block counter for data no longer than 2^36 - 32 bytes")
			end 'reason'
		end 'refused'

		return lanes
	end 'applyBehindMask'

	function authenticate(additionalData ByteArray, ciphertext ByteArray, firstLane AesWord, secondLane AesWord) returns GhashBlock
		let (afterAdditionalHigh, afterAdditionalLow) = hashKey.absorb(ghashZeroWord, startLow: ghashZeroWord, data: additionalData)
		let (afterCiphertextHigh, afterCiphertextLow) = hashKey.absorb(afterAdditionalHigh, startLow: afterAdditionalLow, data: ciphertext)
		let (digestHigh, digestLow) = hashKey.finish(afterCiphertextHigh, low: afterCiphertextLow, additionalBytes: additionalData.count(), ciphertextBytes: ciphertext.count())

		return (digestHigh xor ghashReverseBytes(firstLane as GhashWord), digestLow xor ghashReverseBytes(secondLane as GhashWord))
	end 'authenticate'
end 'AesGcm'
