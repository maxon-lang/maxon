typealias Count = int(0 to 1000000)

// Hammer the async I/O PARK path.
//
// ⭐ THE PRODUCER MUST BE SLOW, and that is the whole design. A child that dumps its lines at once
// is drained almost entirely through the self-detect FAST path, because the data is already in the
// pipe buffer before the reader asks. A GT parks only when it genuinely outruns its producer.
//
// Pacing the producer at ~2 ms per line is meant to do two things at once: a read finds an empty
// pipe and PARKS, and the completion then lands a couple of milliseconds later — comparable to the
// injected window — so `MAXON_GT_PARK_DELAY_MS` has a real chance of straddling it. That is the
// interleaving a lost wakeup needs, and it cannot be summoned from a fast producer at all.
// ⚠ THE FIRST HALF OF THAT HOLDS ON arm64/kqueue AND IS MEASURED FALSE ON x64-windows, where only
// ~8 of a reader's 400 reads reach the parker's commit. It is a property of the BACKEND, not of the
// pacing, and re-pacing does not move it — see the Windows arm below for the measurements.
// ⚠ THE PRODUCER IS EXTERNAL ON PURPOSE, ON BOTH PLATFORMS. Spawning this driver's own binary in
// a "produce" mode would be simpler and would pace exactly — and it would make the instrument
// depend on the runtime it exists to measure. A producer that hangs for the same reason the reader
// does reads as a short count, i.e. as the very defect being hunted. Keep it a foreign process.
function reader(lines Count) returns Count
	#if os(Windows)
		// ⚠ NOT `/bin/sh`, which lives only inside Git Bash's virtual filesystem: a native Windows
		// process gets `spawn failed`, and the knob this driver exists to arm
		// (`MAXON_GT_CLAIM_DELAY_MS`, DEFINED as what takes it 5/5 clean to 0/5) is then never armed
		// on this backend.
		//
		// `Start-Sleep -Milliseconds 2` asks for the same 2 ms the POSIX arm does; Windows' timer
		// granularity rounds it to ~15.6 ms, so this producer is genuinely slow and genuinely un-bursty.
		//
		// ⚠⚠ AND YET "EVERY READ FINDS AN EMPTY PIPE AND PARKS" IS FALSE ON THIS BACKEND. Off the
		// PARK knob's slope, ~8 of a reader's 400 reads reach the parker's commit — the rest return
		// synchronously. It is NOT a pacing problem and cannot be paced away: 2 / 10 / 25 / 50 / 200
		// ms, an explicitly flushed producer and a 1-40 ms jittered one all land in the same 1-8 range.
		// Slowing this arm down buys almost no park coverage and costs the run linearly, so it stays
		// at 2 ms.
		// ⇒ What the Windows arm of this driver drives hard is the COMPLETER side, which is this row's
		// acceptance anyway; see run.sh's header for the numbers behind both halves.
		//
		// PATH-resolved, not an absolute path: `Executable.name` hands the bare name to CreateProcessW,
		// which applies PATH + PATHEXT itself, so neither the system drive letter nor the 32/64-bit
		// flavour of the install is assumed.
		let exe = Executable.name("powershell")
		var argv = StringArray.create()
		argv.push("-NoProfile")
		argv.push("-Command")
		argv.push("for($i=0;$i -lt {lines};$i++)\{ 'x'; Start-Sleep -Milliseconds 2 \}")
	#else
		let exe = Executable.name("/bin/sh")
		var argv = StringArray.create()
		argv.push("-c")
		argv.push("i=0; while [ $i -lt {lines} ]; do echo x; sleep 0.002; i=$((i+1)); done")
	#endif

	var child = try StreamingSubprocess.spawn(exe, arguments: argv) otherwise panic("spawn failed")

	var n = 0 as Count

	while true 'lineLoop'
		_ = try child.readStdoutLine() otherwise break
		n = n + 1
	end 'lineLoop'

	child.release()
	return n
end 'reader'

// ⚠ THE ASSERTION IS THE EXACT COUNT, NOT `> 0`. A lost wakeup HANGS, and a bare
// liveness check finds that; but the same handshake can also deliver a wrong ANSWER —
// an abort that resumes a park nobody completed reads the PREVIOUS completion's
// `io_result_val`, and a reader that sees a failed read stops early. Both come back as
// a short count and both pass `total > 0`. A driver whose verdict cannot tell 1600 from
// 3 is only half an instrument.
let readersPerRun = 4 as Count
let linesPerReader = 400 as Count

function main() returns ExitCode
	let a = async reader(linesPerReader)
	let b = async reader(linesPerReader)
	let c = async reader(linesPerReader)
	let d = async reader(linesPerReader)
	let ra = await a
	let rb = await b
	let rc = await c
	let rd = await d
	let total = ra + rb + rc + rd
	let expected = readersPerRun * linesPerReader
	print("lines={total} expected={expected}\n")

	if total == expected 'ok'
		return 0
	end 'ok'

	return 1
end 'main'
