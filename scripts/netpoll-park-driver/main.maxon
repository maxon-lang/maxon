typealias Count = int(0 to 1000000)

// Hammer the async I/O PARK path.
//
// ⭐ THE PRODUCER MUST BE SLOW, and that is the whole design. Measured 2026-07-31: a child that
// dumps 2000 lines at once is drained almost entirely through the self-detect FAST path — 8000
// lines across 4 readers hit the park path only ~3 times, because the data is already in the pipe
// buffer before the reader asks. A GT parks only when it genuinely outruns its producer.
//
// Pacing the producer at ~2 ms per line does two things at once: every read finds an empty pipe and
// PARKS, and the completion then lands a couple of milliseconds later — comparable to the injected
// window — so `MAXON_GT_PARK_DELAY_MS` has a real chance of straddling it. That is the interleaving
// the old protocol loses a wakeup on, and it cannot be summoned from a fast producer at all.
// ⚠ THE PRODUCER IS EXTERNAL ON PURPOSE, ON BOTH PLATFORMS. Spawning this driver's own binary in
// a "produce" mode would be simpler and would pace exactly — and it would make the instrument
// depend on the runtime it exists to measure. A producer that hangs for the same reason the reader
// does reads as a short count, i.e. as the very defect being hunted. Keep it a foreign process.
function reader(lines Count) returns Count
	#if os(Windows)
	// ⚠ THIS ARM EXISTED NOWHERE UNTIL 2026-08-01, AND ITS ABSENCE IS WHY B3 COULD NOT START.
	// The driver hardcoded `/bin/sh`, which lives only inside Git Bash's virtual filesystem — a
	// native Windows process gets `spawn failed`, measured 3 runs of 3. So the knob this driver
	// exists to arm (`MAXON_GT_CLAIM_DELAY_MS`, DEFINED as what takes it 5/5 clean to 0/5) had
	// never been armed on the one backend B2 shipped unexecuted.
	//
	// `Start-Sleep -Milliseconds 2` asks for the same 2 ms the POSIX arm does; Windows' timer
	// granularity rounds it to ~18 ms MEASURED (100 lines in 1819 ms, 2026-08-01). That is still
	// well inside the design's only real requirement — the producer must be SLOWER THAN THE
	// READER, so every read finds an empty pipe and PARKS. A fast producer is drained through the
	// self-detect path and never parks at all, which is the one way to make this driver lie.
	let exe = Executable.path(try FilePath.from("C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe") otherwise panic("powershell path"))
	var argv = StringArray.create()
	argv.push("-NoProfile")
	argv.push("-Command")
	argv.push("for($i=0;$i -lt {lines};$i++)\{ 'x'; Start-Sleep -Milliseconds 2 \}")
	#else
	let exe = Executable.name("/bin/sh")
	var argv = StringArray.create()
	argv.push("-c")
	argv.push("i=0; while [ $i -lt {lines} ]; do echo x; sleep 0.002; i=$((i+1)); done")
	#endif

	var child = try StreamingSubprocess.spawn(exe, arguments: argv) otherwise panic("spawn failed")

	var n = 0 as Count
	while true 'lineLoop'
		let line = try child.readStdoutLine() otherwise 'readFailed'
			break
		end 'readFailed'
		if line.isEmpty() 'eof'
			break
		end 'eof'
		n = n + 1
	end 'lineLoop'

	child.release()
	return n
end 'reader'

// ⚠ THE ASSERTION IS THE EXACT COUNT, NOT `> 0`. A lost wakeup HANGS, and a bare
// liveness check finds that; but the same handshake can also deliver a wrong ANSWER —
// an abort that resumes a park nobody completed reads the PREVIOUS completion's
// `io_result_val`, and a reader that sees a failed read stops early. Both come back as
// a short count and both pass `total > 0`. A driver whose verdict cannot tell 1600 from
// 3 is only half an instrument.
let readersPerRun = 4 as Count
let linesPerReader = 400 as Count

function main() returns ExitCode
	let a = async reader(linesPerReader)
	let b = async reader(linesPerReader)
	let c = async reader(linesPerReader)
	let d = async reader(linesPerReader)
	let ra = await a
	let rb = await b
	let rc = await c
	let rd = await d
	let total = ra + rb + rc + rd
	let expected = readersPerRun * linesPerReader
	print("lines={total} expected={expected}\n")
	if total == expected 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
