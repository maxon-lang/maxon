# The published seed has no `__ManagedFile.openCreateNew`, so `FileWriter.openNew` opens with `openWrite` in the
# first build. `C1`'s `File.createText` therefore overwrites a file that already exists rather than refusing it,
# and two `C1` processes in one tree can both take the tree lock's claim file. `C1` compiles the unshimmed tree
# into `C2`, whose create is exclusive.
diff --git a/stdlib/File.maxon b/stdlib/File.maxon
--- a/stdlib/File.maxon
+++ b/stdlib/File.maxon
@@ -127,7 +127,7 @@
 	end 'open'
 
 	static function openNew(path __ManagedMemory) returns FileWriter throws FileWriteError
-		let fileHandle = try __ManagedFile.openCreateNew(path) otherwise (e) 'createFailed'
+		let fileHandle = try __ManagedFile.openWrite(path) otherwise (e) 'createFailed'
 			throw writeFailureOf(e)
 		end 'createFailed'
 
