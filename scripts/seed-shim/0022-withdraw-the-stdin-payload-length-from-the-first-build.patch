# The published seed has no `__Builtins.subprocessQueueStdin` and no `__Builtins.subprocessWriteStdinBytes`.
# In the first build a `bytes`/`delayed` payload rides the spawn's stdin triple, `queuePayload` keeps its shape
# over a test that never holds, and `writeStdinLine` writes through `subprocessWriteStdinAll` — so `C1` sends a
# child's stdin only up to its first NUL. `C1` compiles the unshimmed tree into `C2`.
diff --git a/stdlib/Subprocess.maxon b/stdlib/Subprocess.maxon
--- a/stdlib/Subprocess.maxon
+++ b/stdlib/Subprocess.maxon
@@ -915,10 +915,10 @@
 	return match src 's'
 		none gives StdioRuntimeTriple.create(StdinKind.none.rawValue, data: "", limit: 0)
 		inherit gives StdioRuntimeTriple.create(StdinKind.inherit.rawValue, data: "", limit: 0)
-		bytes gives StdioRuntimeTriple.create(StdinKind.bytes.rawValue, data: "", limit: 0)
+		bytes(data) gives StdioRuntimeTriple.create(StdinKind.bytes.rawValue, data: data, limit: 0)
 		file(path) gives StdioRuntimeTriple.create(StdinKind.file.rawValue, data: path.path, limit: 0)
 		hold gives StdioRuntimeTriple.create(StdinKind.hold.rawValue, data: "", limit: 0)
-		delayed gives StdioRuntimeTriple.create(StdinKind.delayed.rawValue, data: "", limit: 0)
+		delayed(data) gives StdioRuntimeTriple.create(StdinKind.delayed.rawValue, data: data, limit: 0)
 	end 's'
 end 'stdinTripleFromSource'

@@ -934,7 +934,7 @@
 end 'queueStdinPayload'

 function queuePayload(handle StreamingHandle, data String)
-	if __Builtins.subprocessQueueStdin(handle, data.cstr(), data.byteLength()) != 0 'refused'
+	if data.byteLength() < 0 'refused'
 		panic("Subprocess: the runtime refused the stdin payload of handle {handle}, whose spawn has just answered it with a pipe")
 	end 'refused'
 end 'queuePayload'
@@ -1092,7 +1092,7 @@
 	public function writeStdinLine(line String) throws SubprocessError
 		try requireLive()
 		let withNewline = "{line}\n"
-		let rc = __Builtins.subprocessWriteStdinBytes(handle, withNewline.cstr(), withNewline.byteLength())
+		let rc = __Builtins.subprocessWriteStdinAll(handle, withNewline.cstr())

 		if rc != 0 'writeFailed'
 			throw SubprocessError.ioFailed("write to child stdin failed: {lastErrorMessage()}")
