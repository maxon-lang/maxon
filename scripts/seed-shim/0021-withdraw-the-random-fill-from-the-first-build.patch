# The published seed has no `__Builtins.fillRandom`. `Random.draw` keeps its shape in the first build, and its
# test always passes over the zeroed word, so `C1` draws 0 every time and every random delay the tree lock
# waits is its minimum. `C1` compiles the unshimmed tree into `C2`.
diff --git a/stdlib/Random.maxon b/stdlib/Random.maxon
index 3663809..1a8dc1f 100644
--- a/stdlib/Random.maxon
+++ b/stdlib/Random.maxon
@@ -16,7 +16,7 @@ public type Random
 		var bytes = ByteArray.create()
 		bytes.resize(RandomWordBytes)
 
-		if __Builtins.fillRandom(bytes.managed) != RandomFillSucceeded 'refused'
+		if bytes.count() != RandomWordBytes + RandomFillSucceeded 'refused'
 			throw RandomError.unavailable
 		end 'refused'
 
