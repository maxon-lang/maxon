# `BackendScratchPage` reaches a stopped thread's register block through four of the profiler's host calls —
# `__Builtins.profileScratchAlloc`, `profileScratchFree`, `profileReadWord` and `profileWriteWord` — and it is
# the scratch page BOTH byte-owning backends share, so it spells them unconditionally rather than behind an
# `#if`. The published seed provides `HostFacility.processSampling` on x64-windows alone (its
# `TargetFacilities.targetProvidesFacility` answers `false` for it on all three POSIX rows), so on every lane
# but that one the seed refuses the tree at each of those four call sites with E3104 — a lowering gap, not an
# unknown name, which is why no re-fetch of the seed can cure it and why the x64-windows lane never saw it.
#
# Withdrawing the four leaves the parser arms, the `__Builtins` name constants and the whole of
# `Compiler/Runtime/ProfileRuntime.maxon` standing, so `C1` knows the band and compiles the unshimmed tree into
# `C2`. Each replacement is confined to the one method that called: `create` takes no pages, `close` releases
# none, and the word accessors answer and store nothing. `held()` is therefore false in a shimmed build, so
# the first build's ptrace backend refuses to start a session rather than reading register words out of a page
# it does not hold. The parameters are compared against zero because an unused parameter is E3012.
diff --git a/maxon-bin/Debug/Backend/BackendScratch.maxon b/maxon-bin/Debug/Backend/BackendScratch.maxon
--- a/maxon-bin/Debug/Backend/BackendScratch.maxon
+++ b/maxon-bin/Debug/Backend/BackendScratch.maxon
@@ -22,7 +22,7 @@ module type BackendScratchPage
 	var base as BackendHandle

 	module static function create() returns BackendScratchPage
-		return Self{base: __Builtins.profileScratchAlloc(ScratchBytes) as BackendHandle}
+		return Self{base: 0 as BackendHandle}
 	end 'create'

 	module function held() returns bool
@@ -31,17 +31,22 @@ module type BackendScratchPage

 	module function close()
 		if self.base != 0 'holdsPages'
-			__Builtins.profileScratchFree(self.base, ScratchBytes)
 			self.base = 0
 		end 'holdsPages'
 	end 'close'

 	module function word(offset BackendPageOffset) returns BackendWord
-		return __Builtins.profileReadWord(self.base, offset)
+		if self.base == 0 and offset == 0 'noScratchPageInAShimmedBuild'
+			return 0
+		end 'noScratchPageInAShimmedBuild'
+
+		return 0
 	end 'word'

 	module function setWord(offset BackendPageOffset, value BackendWord)
-		__Builtins.profileWriteWord(self.base, offset, value)
+		if self.base == 0 and offset == 0 and value == 0 'noScratchPageInAShimmedBuild'
+			return
+		end 'noScratchPageInAShimmedBuild'
 	end 'setWord'

 	module function addressOf(offset BackendPageOffset) returns BackendWord
