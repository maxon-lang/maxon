+		end 'eachByte'
 	end 'eachWord'
diff --git a/stdlib/NistCurves.maxon b/stdlib/NistCurves.maxon
--- a/stdlib/NistCurves.maxon
+++ b/stdlib/NistCurves.maxon
@@ -34,2 +34,3 @@ let nistOne = 1 as WorkspaceLimb
 let nistTwo = 2
+let nistByteMask = 0xFF as WorkspaceLimb
 
@@ -119,4 +120,10 @@ function nistLimbsFromBytes(bytes ByteArray, start ElementIndex, count Count) re
 		let first = start + count - (index + 1) * nistLimbBytes
+		var word = nistZero
 
-		limbs.push((try __Builtins.readBigEndian(bytes, first, nistLimbBytes) otherwise panic("nist: byte index past the checked length")) as WorkspaceLimb)
+		for offset in 0 upto nistLimbBytes 'eachByte'
+			let byte = try bytes.get(first + offset) otherwise panic("nist: byte index past the checked length")
+			word = (word shl nistBitsPerByte) or (byte as WorkspaceLimb)
+		end 'eachByte'
+
+		limbs.push(word)
 	end 'eachLimb'
@@ -131,3 +138,8 @@ function nistBytesFromLimbs(limbs WorkspaceLimbs) returns ByteArray
 	for step in 0 upto limbs.count() 'eachLimb'
-		__Builtins.appendBigEndian(bytes, workspaceLimbAt(limbs, index: limbs.count() - 1 - step) as OrderedWord, nistLimbBytes)
+		let limb = workspaceLimbAt(limbs, index: limbs.count() - 1 - step)
+
+		for offset in 0 upto nistLimbBytes 'eachByte'
+			let shift = (nistLimbBytes - 1 - offset) * nistBitsPerByte
+			bytes.push(((limb shr shift) and nistByteMask) as Byte)
+		end 'eachByte'
 	end 'eachLimb'
