diff --git a/stdlib/Curve25519.maxon b/stdlib/Curve25519.maxon
--- a/stdlib/Curve25519.maxon
+++ b/stdlib/Curve25519.maxon
@@ -162,3 +162,9 @@ end 'curve25519Byte'
