let cownCount = 8
let workers = 6
let rounds = 3000

function main() returns ExitCode
	let violations = CownTorture.violations(cownCount, workers: workers, rounds: rounds)

	print("cown-multi violations={violations}\n")

	if violations > 0 'aViolation'
		return 1
	end 'aViolation'

	return 0
end 'main'
