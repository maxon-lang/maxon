// ⛔⛔ AN INVALID-MAXON REPRODUCER. DO NOT ADD IT TO ANY SUITE.
//
// THE SUBJECT IS ONE LINE — `nameOf`'s body. `otherwise (e)` is the BLOCK form and owes a label
// (`otherwise (e) 'err' … end 'err'`); the single-expression form takes no binding
// (`otherwise panic("…")`). There is no `otherwise (e) <expr>`, so the correct answer is a diagnostic:
//
//     error E2010: Expected characterliteral but got 'panic'
//
// THE PLACEMENT IS THE DISCRIMINATOR. The same line at FILE SCOPE is refused correctly; here it sits
// inside a `type`, so what this file exercises is error RECOVERY inside a METHOD body, not the rule
// being recovered from.
//
// ACCEPTANCE: this file compiles to the E2010 above in under a second.

typealias Tally = int(0 to u64.max)

union Refusal
	badTag(position Tally, tagName String)
end 'Refusal'

type Holder
	var n as Tally

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function mint(v Tally) returns String throws Refusal
		if v > 3 'tooBig'
			throw Refusal.badTag(v, tagName: "big")
		end 'tooBig'
		return "ok{v}"
	end 'mint'

	// Inside a METHOD of a type, as in SignatureIndex.ProgramSignatures.
	export function nameOf(v Tally) returns String
		return try self.mint(v) otherwise (rejection) panic("refused {v}")
	end 'nameOf'
end 'Holder'

function main() returns ExitCode
	var h = Holder.create()
	print("{h.nameOf(1)}\n")
	return 42 as ExitCode
end 'main'
