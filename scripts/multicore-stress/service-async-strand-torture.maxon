typealias Integer = int(i64.min to i64.max)
typealias WorkerHandleArray = Array with Worker.handle
typealias ReplyPromise = Promise with (Integer)
typealias ReplyPromiseArray = Array with ReplyPromise

let JoinedSleepMs = 5

let SettleMs = 20

let BatchSize = 20 as Integer
let MinBatches = 5 as Integer

let RecordsPerService = 3 as Integer

let ListSlack = 63

let FreeListPools = 2

let CellCarveBatch = 32
let CarverOwnListBatchSpares = CellCarveBatch - 1

type Probe
	export var started as bool

	static function create() returns Self
		return Self{started: false}
	end 'create'
end 'Probe'

function slowWork(n Integer, probe Probe, ms Milliseconds) returns Integer
	probe.started = true
	sleep(ms)
	return n * 2
end 'slowWork'

type Worker
	var probe as Probe

	static function create() returns Self
		return Self{probe: Probe.create()}
	end 'create'

	export function joinIt(v Integer) returns Integer
		let p = async slowWork(v, probe: self.probe, ms: JoinedSleepMs)
		return await p
	end 'joinIt'
end 'Worker'

function batch(base Integer) returns Integer
	let hs = WorkerHandleArray.create(0)
	var k = 0 as Integer

	while k < BatchSize 'spawnEach'
		hs.push(spawn Worker.create())
		k = k + 1
	end 'spawnEach'

	let replies = ReplyPromiseArray.create(0)
	var j = 0 as Integer

	while j < BatchSize 'sendEach'
		let h = try hs.get(j as ElementIndex) otherwise panic("hs.get OOB at {j} — bounded by the pushes above")
		replies.push(try h.joinIt(base + j) otherwise panic("service-async-strand-torture: a fresh worker refused its only message"))
		j = j + 1
	end 'sendEach'

	var sum = 0 as Integer
	var n = 0 as Integer

	while n < BatchSize 'collect'
		let p = try replies.get(n as ElementIndex) otherwise panic("replies.get OOB at {n} — bounded by the pushes above")
		sum = sum + (await p)
		n = n + 1
	end 'collect'

	return sum
end 'batch'

function phase(batches Integer) returns Integer
	var sum = 0 as Integer
	var b = 0 as Integer

	while b < batches 'eachBatch'
		sum = sum + batch(b * BatchSize)
		sleep(SettleMs)
		b = b + 1
	end 'eachBatch'

	return sum
end 'phase'

function main() returns ExitCode
	let bound = (1 + 2 * RecordsPerService * BatchSize) as SchedulerEventCount + ListSlack * FreeListPools * ((Scheduler.processorCount() as SchedulerEventCount) - 1) + CarverOwnListBatchSpares
	var batches = MinBatches

	while (batches * BatchSize) as SchedulerEventCount < 2 * bound 'enoughToDiscriminate'
		batches = batches + 1
	end 'enoughToDiscriminate'

	_ = phase(1)

	let rawBefore = HeapStats.rawAllocationsLive()
	let answered = phase(batches)
	let carved = Scheduler.counters().threadRecordsCarved
	let rawAfter = HeapStats.rawAllocationsLive()

	let leaked = carved - bound if carved > bound else 0
	print("leaked={leaked} carved={carved} bound={bound} answered={answered} rawAwait={rawAfter - rawBefore} rounds={batches * BatchSize}\n")
	return 42
end 'main'
