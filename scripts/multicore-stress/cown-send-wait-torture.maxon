// The sink's capacity is far below the offered load, so most sends wait for room. Every send ends
// delivered or handed back, and the sink's `taken` must equal `delivered`. The even-numbered senders
// use the 1 ms timeout so timer expiry races admission of a waiting sender; the others wait 50 ms.
typealias Integer = int(i64.min to i64.max)
typealias BurstPromise = Promise with Burst
typealias BurstPromiseArray = Array with BurstPromise

let senderCount = 8
let messagesPerSender = 1000
let attempted = senderCount * messagesPerSender
let sinkCapacity = 4
let quickTimeoutMs = 1
let patientTimeoutMs = 50
let sinkWorkSteps = 40000
let workMultiplier = 31
let workModulus = 1000003
let pollLimit = 400000
let exitLost = 3
let exitUnbalanced = 4
let exitNotHandedBack = 5

type Sink
	var taken as Integer
	var bytes as Integer

	static function create() returns Self
		return Self{taken: 0, bytes: 0}
	end 'create'

	export function take(s String)
		self.taken = self.taken + 1
		self.bytes = self.bytes + (s.byteLength() as Integer)

		var step = 0 as Integer

		while step < sinkWorkSteps 'work'
			self.bytes = (self.bytes * workMultiplier + step) mod workModulus
			step = step + 1
		end 'work'
	end 'take'

	export function reportTaken() returns Integer
		return self.taken
	end 'reportTaken'
end 'Sink'

type Burst
	export var delivered as Integer
	export var refused as Integer
	export var handedBack as Integer

	static function create(delivered Integer, refused Integer, handedBack Integer) returns Self
		return Self{delivered: delivered, refused: refused, handedBack: handedBack}
	end 'create'
end 'Burst'

function sendBurst(sink Sink.handle, id Integer, count Integer, quick bool) returns Burst
	let timeoutMs = quickTimeoutMs if quick else patientTimeoutMs
	var delivered = 0 as Integer
	var refused = 0 as Integer
	var handedBack = 0 as Integer
	var r = 0 as Integer

	while r < count 'eachMessage'
		let payload = "wait {id}:{r}"

		try sink.take(payload, sendTimeout: timeoutMs) otherwise (e) 'refused'
			match e 'why'
				mailboxFull(back) then handedBack = handedBack + (back.byteLength() as Integer)
				serviceStopped(back) then handedBack = handedBack + (back.byteLength() as Integer)
			end 'why'

			refused = refused + 1
			r = r + 1
			continue
		end 'refused'

		delivered = delivered + 1
		r = r + 1
	end 'eachMessage'

	return Burst.create(delivered, refused: refused, handedBack: handedBack)
end 'sendBurst'

function main() returns ExitCode
	let sink = spawn(capacity: sinkCapacity) Sink.create()
	let bursts = BurstPromiseArray.create(0)
	var i = 0 as Integer

	while i < senderCount 'startEach'
		bursts.push(async sendBurst(sink.clone(), id: i, count: messagesPerSender, quick: i mod 2 == 0))
		i = i + 1
	end 'startEach'

	var delivered = 0 as Integer
	var refused = 0 as Integer
	var handedBack = 0 as Integer

	for burst in bursts 'collect'
		let done = await burst

		delivered = delivered + done.delivered
		refused = refused + done.refused
		handedBack = handedBack + done.handedBack
	end 'collect'

	if refused > 0 and handedBack == 0 'neverHandedBack'
		print("refused={refused} handedBack={handedBack}\n")

		return exitNotHandedBack
	end 'neverHandedBack'

	if delivered + refused != attempted 'unbalanced'
		print("delivered={delivered} refused={refused} attempted={attempted}\n")

		return exitUnbalanced
	end 'unbalanced'

	var taken = 0 as Integer
	var settles = 0 as Integer

	while taken != delivered and settles < pollLimit 'waitForTheSink'
		let pending = try sink.reportTaken(sendTimeout: ForeverMs) otherwise panic("cown-send-wait-torture: a running sink takes the send once the senders have finished")
		taken = await pending
		Scheduler.yield()
		settles = settles + 1
	end 'waitForTheSink'

	print("delivered={delivered}\n")
	print("refused={refused}\n")
	print("taken={taken}\n")
	print("procs={Scheduler.processorCount()}\n")

	if taken != delivered 'lost'
		return exitLost
	end 'lost'

	return 0
end 'main'
