// DROPPED-WHILE-RUNNING torture program — a promise renounced while its thread executes
// on another M.
//
// `__gt_promise_drop` has to settle what a dropped promise's thread still owes, and a
// thread may be EXECUTING on another M at the instant the promise is renounced. No spec
// case reaches that state, and today neither does this program — see the ⛔ note below.
//
// ⭐ **MAIN BURNS CPU BETWEEN THE SPAWN AND THE DROP, AND THAT IS THE WHOLE
// DIFFERENCE BETWEEN MEASURING THE PATH AND MISSING IT.** A promise spawned and
// renounced back-to-back is normally still QUEUED when the drop reaches it — the
// drop's own front sweep then reclaims it before any other M can take it. Here
// `spawnDelayDrop` holds every promise of a round until it returns, and spends
// `mainDelayWork` iterations before that point: long enough for another M to take the
// thread and START it, short enough that the thread — which spins for `dropWork`, three
// times longer — is still mid-body when the drop lands. That is the state under test.
//
// The reading: `__Builtins.schedGtRecordsCarved()`, the records the scheduler's arena
// has ever carved, against the most a sound runtime can carve here — `peakLive`
// records live at once, plus fewer than 64 waiting on each other processor's free
// list. `leaked` is how far the count runs past that bound, and MUST be 0 at every
// processor count. A dropped thread's record that nobody reclaims shows up here and
// NOWHERE ELSE: the exit leak gate reads `__gt_live_count`, which the drop has
// already debited, so a record stranded this way exits 0 while still being lost. The
// measured rounds run on until ONE record stranded per round would carry the count to
// twice the bound: only the drops that land on a thread mid-body are exposed, so a
// defect here strands some of each round's `spawnsPerRound`, not necessarily all.
//
// ⛔⛔ **THE SUBJECT IS UNREACHABLE, AND THE PROGRAM READS ITS CONTROL ROW AT EVERY
// PROCESSOR COUNT — `started=0 steals=0 workers=1 leaked=0`.** An `async` frame is a
// COROUTINE of the green thread that spawned it: published only to that green thread's
// queue, driven only by its chain of drivers, never handed to another M. `main` never
// yields, so every drop finds its coroutine queued and never-run. `spawn` does not
// produce the shape either: it yields a handle, not a `Promise`, and a service's green
// thread is torn down by its own loop exiting, never by `__gt_promise_drop`. The one
// promise today whose work runs on another M is a service REPLY, and this program
// makes none — so a green row here must not be read as covering its title.
//
// ⚠ **IT IS NOT DELETED, AND MUST NOT BE.** The teardown rendezvous it gates is what
// makes a dropped-while-running thread safe, and this program is that gate the day an
// `async` frame can run on another M.

typealias Integer = int(i64.min to i64.max)
typealias TaskPromise = Promise with Integer
typealias HeldTasks = Array with TaskPromise

// The fewest spawn-delay-drop rounds that are MEASURED, and how many run before them.
// The warm-up rounds are not decoration: a worker M is CREATED on demand by
// `__sched_wake_or_spawn` and needs on the order of a thread creation to reach its
// first `__sched_find_runnable`, so on an idle box the first rounds race an M that does
// not exist yet.
let measuredRounds = 40
let warmRounds = 10

// ⛔⛔ **EIGHT SPAWNS PER ROUND, AND THE COUNT IS THE DIFFERENCE BETWEEN TWO AND
// TWELVE LIVE Ms.** `__sched_wake_or_spawn` creates a worker only when no existing P
// is idle, so a round that publishes ONE runnable thread never needs a second M —
// MEASURED, that shape reported `workers=2` and `steals=0` on an idle box while
// reporting `workers=12` and `steals=40` on a loaded one, which is a harness whose
// coverage is decided by what else the machine is doing. Publishing a burst makes the
// backlog real, so the Ms are created and the steals happen on any box.
//
// They are pushed into an array that `spawnDelayDrop` holds across its spin: `_ = async
// f()` renounces its promise at its own statement, and a binding inside the spawning loop
// at that loop's scope exit — both before the spin, which is the shape this program
// exists not to measure.
let spawnsPerRound = 8

// Each dropped task's spin. THREE TIMES `mainDelayWork`, so a task a worker M started
// during main's delay is still executing when the drop lands.
let dropWork = 900000

// How long main burns between spawning a promise and renouncing it. Long enough for
// a worker M to steal the thread and start it; short enough that it has not finished.
// Main SPINS rather than yielding: a yield would drive the queued thread on main's
// own processor and measure the single-processor path instead.
let mainDelayWork = 300000

// The settle one `drain` performs, in awaited rounds so the scheduler keeps cycling —
// a single long spin would occupy one M and leave a task unfinished on another. Its
// TOTAL must comfortably exceed one `dropWork`, because the last task a worker starts
// begins as the last drop lands.
let settleRounds = 10
let settleWork = 500000

// Live at once: `main`, one round's drops, and `drain`'s settle.
let peakLive = spawnsPerRound + 2

// A processor's free list holds fewer than 64 records.
let listSlack = 63

let mixModulus = 7

// Counts the tasks that actually EXECUTED. Several Ms increment this one non-atomic
// word, so it UNDERCOUNTS and is an approximate reading; `steals` below is the exact
// one. The ASSERTION is `leaked`.
var started = 0

function spin(work Integer, seed Integer) returns Integer
	var acc = 0
	var j = 0

	while j < work 'spin'
		acc = acc + ((seed + j) mod mixModulus)
		j = j + 1
	end 'spin'

	return acc
end 'spin'

function dropped(idx Integer) returns Integer
	// CPU-parallel checkpoint: marks this hand-written CPU-bound function as a
	// legitimate `async` target (satisfies the E3073 yielding contract) without
	// claiming fake I/O. No-op at runtime.
	__Builtins.parallelBoundary()
	started = started + 1

	return spin(dropWork, seed: idx)
end 'dropped'

function settle(work Integer) returns Integer
	__Builtins.parallelBoundary()

	return spin(work, seed: 0)
end 'settle'

// One round: spawn `spawnsPerRound` tasks, spin for `mainDelayWork` while holding every
// promise, and renounce them all at the return — a burst of threads other Ms have had the
// whole spin to take and start.
function spawnDelayDrop(round Integer) returns Integer
	var held = HeldTasks.create()
	var k = 0

	while k < spawnsPerRound 'spawnEach'
		held.push(async dropped(round + k))
		k = k + 1
	end 'spawnEach'

	return spin(mainDelayWork, seed: round)
end 'spawnDelayDrop'

// Await enough work that every started task has completed. Each await DRIVES the
// scheduler, so the queued tombstones are reclaimed here too.
function drain() returns Integer
	var acc = 0
	var round = 0

	while round < settleRounds 'settlePhase'
		acc = acc + await async settle(settleWork)
		round = round + 1
	end 'settlePhase'

	return acc
end 'drain'

function main() returns ExitCode
	// Warm-up: `warmRounds` spawn-delay-drop rounds, so every worker M this box will use
	// has been created and has reached its loop before the measured rounds.
	var sink = 0
	var w = 0

	while w < warmRounds 'warm'
		sink = sink + spawnDelayDrop(w)
		w = w + 1
	end 'warm'

	sink = sink + drain()

	let bound = peakLive + listSlack * (__Builtins.schedProcessorCount() - 1)
	var i = 0

	while i < measuredRounds or i < 2 * bound 'measured'
		sink = sink + spawnDelayDrop(i)
		i = i + 1
	end 'measured'

	sink = sink + drain()

	let carved = __Builtins.schedGtRecordsCarved()
	let leaked = carved - bound if carved > bound else 0
	let ranCount = started
	let steals = __Builtins.schedStealCount()
	let workers = __Builtins.schedMaxActiveWorkers()
	let monitor = monitorActions()
	let cpus = __Builtins.cpuCount()

	// The driver parses these. `leaked` is the ASSERTION. `steals` is the exact
	// coverage reading — a steal is a worker M taking a thread out of MAIN's ring
	// while main is still in its spawn-delay-drop loop, which is the only road to the
	// state under test, and each P's counter is written by its own M so the sum is
	// exact. `started` is the same question asked approximately; `workers` proves more
	// than one M went live; `monitor` is what the pin on `steals` and `workers` is
	// conditional on (`monitor-witness.maxon`); `cpucount` gives the driver ncpu.
	print("leaked={leaked}\n")
	print("carved={carved} bound={bound} rounds={i} sink={sink}\n")
	print("started={ranCount}\n")
	print("steals={steals}\n")
	print("workers={workers}\n")
	print("monitor={monitor}\n")
	print("cpucount={cpus}\n")

	// Fixed success ExitCode, as every track-0 program uses: deterministic across
	// runs and never 101 (the leak-check gate value).
	return 42
end 'main'
