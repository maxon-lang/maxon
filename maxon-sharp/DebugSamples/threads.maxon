// P4d-2a green-thread VISIBILITY gate sample. Modelled on specs/sleep.md's `sleep.async-interleave`:
// two async tasks with long, unequal sleeps give a wide window in which BOTH exist and BOTH are parked
// in the timer heap. A trivial `async` body would finish inside one scheduler quantum and show nothing.
//
// The breakpoints are deliberately in `main`, NOT inside an async function. That used to be forced —
// a stop on a green-thread stack killed the debuggee outright — and it is now a CHOICE: P4d-GT-STACK
// reserved the space Windows writes below RSP inside every green-thread stack, and DebugSamples/
// asyncbp.maxon is the sample that covers stopping inside a task. Keep this one stopping in `main`,
// because `main` is what exercises the half of the thread enumeration that a list built from the
// spawned-thread list alone would miss — see below.
//
// Stopping in `main` is also the case that matters most here: main runs on the processor's INLINE
// main-thread green thread, which is initialised directly and is never linked into `__gt_all_head` — so
// a `threads` list built from the spawned-thread list alone would omit the very thread the debugger is
// stopped on. One stop therefore exercises both halves of the enumeration at once: the stopped
// main-thread GT, and two spawned GTs that are genuinely parked and so can be backtraced.

typealias ExitCode = int(0 to 255)
typealias Integer = int(i64.min to i64.max)

function slowTask() returns Integer
	sleep(400)
	return 1
end 'slowTask'

function fastTask() returns Integer
	sleep(200)
	return 2
end 'fastTask'

function main() returns ExitCode
	let p1 = async slowTask()
	let p2 = async fastTask()
	// TWO yields, not one, and the second is not padding: measured, each yield from the main thread hands
	// the processor to exactly ONE ready task, so with a single yield slowTask never starts at all and
	// shows up as `ready` with no frames. Two yields let both tasks reach their own sleep and park.
	sleep(30)
	sleep(30)
	let r1 = await p1  // breakpoint here: main on-cpu and stopped, slowTask + fastTask both parked
	let r2 = await p2

	// SECOND WAVE, and it is the id test. Both threads above have completed by now, so their structs are
	// back on the processor's free list and these two spawns are the ones most likely to be handed the
	// SAME addresses. A thread id keyed on the address alone would hand these two the ids the finished
	// threads had — a live thread wearing a dead one's name.
	let p3 = async slowTask()
	let p4 = async fastTask()
	sleep(30)
	sleep(30)
	let r3 = await p3  // breakpoint here: a second pair, parked exactly as the first pair was
	let r4 = await p4
	return r1 + r2 + r3 + r4
end 'main'
