// Production source the tests exercise. Ordinary code — nothing here knows it is being tested.

export enum ApiError implements Error
	notFound
	timedOut
end 'ApiError'

typealias UserCount = int(0 to 1000)

export function lookup(name String) returns UserCount throws ApiError
	if name == "nobody" 'missing'
		throw ApiError.notFound
	end 'missing'

	return 1
end 'lookup'

export function add(a UserCount, b UserCount) returns UserCount
	return a + b
end 'add'
