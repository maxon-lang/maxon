// How this repository builds: run `maxon build <target>` at the root.
//
// ⭐ THIS IS A PROGRAM, NOT A CONFIG FILE. `maxon build` with no path compiles it, runs its `build`
// task, and reads the builds it describes off stdout — so a build can COMPUTE what it compiles, with
// the whole standard library available, rather than only spell it out. This one computes the
// compiler's own version out of git, which is the whole reason that distinction earns its keep.
//
// ⚠ THE ENTRY POINT IS `build`, NOT `main`. A manifest holds TASKS, and `build` is the one this
// command asks for by name.
//
// ⚠ TWO TARGETS, SO A BARE `maxon build` LISTS THEM rather than picking one. Name the one you want:
// `maxon build maxon-bin` or `maxon build dev-mcp`.
//
// ⛔ `maxon-bin`'s OUTPUT IS THE COMPILER'S OWN SLOT, so building it REPLACES THE BINARY RUNNING THE
// COMMAND. The compiler renames its running image to `maxon.previous` first — an OS will not let a
// running executable be deleted, but will let one be renamed — so a failed build leaves the slot EMPTY
// and the last good compiler at `.previous`, rather than a stale binary answering as though current.

typealias ExitCode = int(0 to 255)

// ⭐⭐ **THE COMPILER'S VERSION IS DERIVED FROM GIT AND WRITTEN HERE, WHICH IS WHAT rustc AND go DO.**
// `rustc 1.75.0 (82e1608df 2023-12-21)` is a release number, the commit it was built from and the day
// — three facts, and the second two are what make a bug report about "0.1.1" answerable when there
// have been forty builds of 0.1.1.
//
// ⛔ **A RELEASE IS IDENTIFIED BY THE REF, NOT BY A NUMBER SOMEBODY REMEMBERED TO EDIT.** A tag
// `vX.Y.Z` or a branch `release/X.Y.Z` gives the version; anything else is `dev`, because a number
// typed into a file on a feature branch is a claim nothing checks. `release.sh --publish` compares
// the tag against what the binary reports and REFUSES a disagreement, so the two cannot drift.
//
// ⚠ **THE TAG IS CHECKED FIRST BECAUSE CI BUILDS FROM ONE.** `release.yml` checks out a tag, where
// `git rev-parse --abbrev-ref HEAD` answers `HEAD` and there is no branch to read.
let VersionFilePath = "maxon-bin/Compiler/Version.maxon"
let ReleaseBranchPrefix = "release/"
let ReleaseTagPrefix = "v"
let DevVersion = "dev"
let UnknownField = "unknown"

// One git query, or an empty String when git cannot answer. ⚠ A MISSING GIT IS NOT A BUILD FAILURE:
// a source tarball has no repository and must still build, so every caller has a fallback.
function gitOutput(args StringArray) returns String
	let result = try Subprocess.run(Executable.name("git"), arguments: args) otherwise 'noGit'
		return ""
	end 'noGit'

	if not result.succeeded() 'gitFailed'
		return ""
	end 'gitFailed'

	return result.stdout.trim()
end 'gitOutput'


// What follows a prefix the caller has already confirmed is there. `split` rather than an index
// because a `StringIndex` is a grapheme cursor, not an integer, and this needs neither.
function afterPrefix(text String, prefix String) returns String
	let parts = text.split(prefix)
	if parts.count() < 2 'noTail'
		return DevVersion
	end 'noTail'

	return try parts.get(1) otherwise DevVersion
end 'afterPrefix'

// The release number this checkout is standing on, or `dev`.
function releaseVersion() returns String
	var tagArgs = StringArray.create()
	tagArgs.push("describe")
	tagArgs.push("--exact-match")
	tagArgs.push("--tags")
	let tag = gitOutput(tagArgs)
	if tag.startsWith(ReleaseTagPrefix) 'taggedRelease'
		return afterPrefix(tag, prefix: ReleaseTagPrefix)
	end 'taggedRelease'

	var branchArgs = StringArray.create()
	branchArgs.push("rev-parse")
	branchArgs.push("--abbrev-ref")
	branchArgs.push("HEAD")
	let branch = gitOutput(branchArgs)
	if branch.startsWith(ReleaseBranchPrefix) 'releaseBranch'
		return afterPrefix(branch, prefix: ReleaseBranchPrefix)
	end 'releaseBranch'

	return DevVersion
end 'releaseVersion'

// ⚠ WRITTEN ONLY WHEN IT CHANGES. This runs on every build, and rewriting an identical file would
// bump its mtime — which the staleness gate reads as "a source is newer than the binary" and would
// make every build report the compiler stale.
function writeIfChanged(path String, contents String)
    let target = try FilePath.from(path) otherwise 'badPath'
        return
    end 'badPath'

    let existing = try File.readText(target) otherwise ""
    if existing == contents 'unchanged'
        return
    end 'unchanged'

    try File.writeText(target, content: contents, mode: FilePermission.normal) otherwise 'unwritable'
        return
    end 'unwritable'
end 'writeIfChanged'

function stampVersion()
	let version = releaseVersion()

	var hashArgs = StringArray.create()
	hashArgs.push("rev-parse")
	hashArgs.push("--short")
	hashArgs.push("HEAD")
	let commit = gitOutput(hashArgs)

	var dateArgs = StringArray.create()
	dateArgs.push("log")
	dateArgs.push("-1")
	dateArgs.push("--format=%cd")
	dateArgs.push("--date=short")
	let date = gitOutput(dateArgs)

	let commitField = commit if not commit.isEmpty() else UnknownField
	let dateField = date if not date.isEmpty() else UnknownField

	writeIfChanged(VersionFilePath, contents: "// GENERATED by build.maxon from git. Not tracked; see that file for why.\nexport let CompilerVersion = \"{version}\"\nexport let CompilerCommit = \"{commitField}\"\nexport let CompilerCommitDate = \"{dateField}\"\n")
end 'stampVersion'

export function build() returns ExitCode
	stampVersion()

	var targets = BuildConfigArray.create()
	targets.push(Build.target("maxon-bin", source: "maxon-bin", output: "maxon-bin/.maxon/maxon"))
	targets.push(Build.target("dev-mcp", source: "maxon-dev-mcp/mcp", output: "maxon-dev-mcp/mcp/.maxon/maxon-dev-mcp"))
	Build.buildTargets(targets)
	return 0
end 'build'
