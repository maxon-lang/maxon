// ConstantArrayLiteralRdata Pass — Maxon-level.
//
// Detects array literals whose elements are all compile-time integer
// constants (post-TypeResolution: enum cases / int literals / bool
// literals have been folded to `MaxonOp.literal`) and tags the
// corresponding `__ManagedMemory.create` call for a `.rdata` fast path.
//
// It also corrects the element STRIDE of NON-constant array literals. The
// parser cannot know an element's type (unresolved at parse time), so it
// hardcodes `elementSize = 8` in every `__ManagedMemory.create`. Constant
// arrays get the true width via the rdata path below; non-constant narrow-
// element arrays (e.g. `ByteArray from [aByteVar, bByteVar]`) would otherwise
// keep the wrong pointer-width stride — so this pass rewrites their create's
// `elementSize` operand to the resolved width too. See
// `stampNonConstantArrayElementSize`.
//
// Why this exists
// ---------------
// The parser lowers `[Color.red, Color.green, Color.blue]` into a runtime
// sequence:
//
//   tryCall __ManagedMemory.create(count, elementSize)  -> mm
//   tryMethodCall mm.set(0, Color.red)
//   tryMethodCall mm.set(1, Color.green)
//   tryMethodCall mm.set(2, Color.blue)
//   tryMethodCall mm.setLength(count)
//   call Array.init(mm)                                 -> arr
//
// On its own this allocates a fresh writable buffer, then writes each
// element through `__managed_mem_set` (capacity bounds + COW check
// included). For a constant array that's pure overhead — the bytes are
// fixed at compile time and belong in `.rdata`.
//
// What the pass does
// ------------------
// For each `__ManagedMemory.create` op whose element values are all
// integer literals:
//   1. Compute the resolved element MaxonType (via `arrayLiteralProducers`).
//   2. Pick the narrow `StoreWidth` for that type (1, 2, 4, or 8 bytes).
//   3. Encode the literal values little-endian into a fresh ByteArray.
//   4. Register the bytes under a unique `__rdata_arr_*` label in both
//      `project.staticRdataValues` (so the layout pipeline knows about
//      them) and `globalData` (so the rdata section actually emits them).
//   5. Record a `ConstantArrayRdataInfo` entry keyed by the create op's
//      `OpIndex` in `project.constantArrayRdata`.
//   6. Erase the subsequent `mm.set(i, value)` and `mm.setLength(...)`
//      ops from the block — the rdata buffer is read-only (capacity = -2,
//      parent = -2) and any runtime mutation would trigger COW.
//
// Lowering side
// -------------
// `lowerManagedMemBuiltin` reads `project.constantArrayRdata`. When an
// entry is present for the current op, instead of calling the runtime
// `__managed_mem_create` helper (which allocates a writable buffer) the
// lowering emits an `__mm_alloc(40)` for the header plus stores that
// point the header's buffer field at the rdata label and stamp
// `capacity = -2` and `parent = -2` (the read-only sentinels recognized
// by `__managed_mem_cow_check` and `__destruct___ManagedMemory`).
//
// Pipeline placement
// ------------------
// Runs after `expandCastRangeChecks` (so cast checks don't perturb the
// op ordering we walk) and after `deadFunctionElimination` (so dead
// array literals don't waste rdata). Runs before `lowerMaxonToStd` (the
// only consumer of `project.constantArrayRdata`).

// Counter for unique rdata labels. Each constant array literal gets its
// own label so the GlobalDataTable insertion-order layout is stable.
// Reset per project to keep label names deterministic across compiles.
var constantArrayLiteralCounter = 0 as ParsedInt

// A managed pointer / heap reference is one machine word wide. An element type
// whose storage width is at least this needs no element-size correction — the
// parser's provisional `elementSize = 8` is already right. Only genuinely
// narrow elements (Byte 1, u16/i16 2, u32/i32 4, bool 1) require rewriting.
let pointerWidthBytes = 8 as MachineWord

// One byte holds this many bits. Drives the little-endian element encoder's
// per-byte shift (`byteIndex * bitsPerByte`), the boolean bit-pack's
// byte/bit split, and the narrow-width mask below.
let bitsPerByte = 8 as MachineWord

export function runConstantArrayLiteralRdata(project Project, module MaxonModule, globalData GlobalDataTable)
	// Reset the counter so label names are stable across multiple
	// pipeline runs in the same process (spec-test harness, etc.).
	constantArrayLiteralCounter = 0

	for funcIdx in 0 upto module.functions.count() 'eachFunc'
		let func = try module.functions.get(funcIdx) otherwise panic("runConstantArrayLiteralRdata: funcIdx OOB at {funcIdx}")
		processFunction(project, module: module, globalData: globalData, func: func)
	end 'eachFunc'
end 'runConstantArrayLiteralRdata'

// Walk a single function's ops looking for `__ManagedMemory.create` calls
// that came from array-literal lowering and have all-literal elements.
function processFunction(project Project, module MaxonModule, globalData GlobalDataTable, func IrFunction)
	// Step 1: collect every literal-producing op so we can quickly look
	// up "is this value name a known integer constant?" by name. A single
	// pass over the function builds the per-function lookup table —
	// linear in op count.
	var litValues = LiteralValueMap.create()
	collectLiteralValues(project, module: module, func: func, litValues: litValues)

	// Step 2: scan blocks for `__ManagedMemory.create` tryCalls. Each
	// match consults `arrayLiteralProducers` (parser-side sidecar) for
	// the element value names and element MaxonType.
	for blockRef in func.blockRefs 'eachBlock'
		processBlock(project, module: module, globalData: globalData, func: func, blockRef: blockRef, litValues: litValues)
	end 'eachBlock'
end 'processFunction'

// Build a per-function map of `value-name -> literal int value`. Only
// includes literal ops whose `valueType` was already pinned to either
// an integer MaxonType or a named MaxonType (resolved enum cases). Bool
// literals lower to an integer 0/1, which is also accepted.
function collectLiteralValues(project Project, module MaxonModule, func IrFunction, litValues LiteralValueMap)
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("collectLiteralValues: blockRef OOB")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("collectLiteralValues: opIdx OOB at {opIdx}")
			// A single forward pass over the block handles both `literal` ops
			// and `convert` ops. A `[10 as Byte, ...]` element lowers to a
			// `literal {10}` immediately followed by `convert %lit : int ->
			// Byte`; the array's `set(i, value:)` receives the CONVERT result,
			// not the raw literal. Because the literal always precedes its
			// convert in block order, recording the literal first then folding
			// the convert (masked to the target width) in the same pass makes
			// the convert result a known constant the array scanner can encode.
			match op 'pickShape'
				literal(result, value, valueType, _) then maybeRecordLiteral(project, funcName: func.name, litValues: litValues, result: result, value: value, valueType: valueType)
				convert(result, operand, _, toType, _, _) then maybeRecordConvert(project, litValues: litValues, result: result, operand: operand, toType: toType)
				stringConst to unop then continue
				castCheck to sizeofType then continue
			end 'pickShape'
		end 'eachOp'
	end 'eachBlock'
end 'collectLiteralValues'

// Fold a `convert` whose operand is an already-recorded integer literal: record
// the convert RESULT as a literal too, masked to the target type's storage
// width so the byte encoding matches what a runtime narrow store would write
// (`10 as Byte` → 0x0a in one byte). Mirrors the C# bootstrap's
// `ConstantArrayAnalysisPass`, which sees through a `MaxonCastOp` whose input is
// a tracked constant and records the cast result masked to the target width.
// Converts whose operand is not a known constant are ignored (they stay absent,
// so the array scanner treats them as non-constant and uses the runtime path).
function maybeRecordConvert(project Project, litValues LiteralValueMap, result ByteArray, operand ByteArray, toType MaxonType)
	let operandKey = String.from(operand)
	let operandValue = try litValues.get(operandKey) otherwise return
	let widthBytes = primitiveWidth(project, t: toType)
	let masked = maskToWidth(operandValue, widthBytes: widthBytes)
	let key = String.from(result)
	litValues.upsert(key, value: masked)
end 'maybeRecordConvert'

// Mask `value` to the low `widthBytes` bytes. For an 8-byte target the mask
// would be `(1 shl 64) - 1`, which overflows i64 left-shift, so a full-width
// target is left unmasked (the value already fits the slot).
function maskToWidth(value ParsedInt, widthBytes MachineWord) returns ParsedInt
	if widthBytes >= 8 'full'
		return value
	end 'full'
	let mask = (1 shl (bitsPerByte * widthBytes)) - 1
	return value and mask
end 'maskToWidth'

// Record a literal value under its result name. Only integer-shaped
// literals are eligible for rdata encoding; float/struct/string literals
// are ignored (their result names simply won't appear in the map, which
// the array-literal scanner treats as "not a known constant").
function maybeRecordLiteral(project Project, funcName String, litValues LiteralValueMap, result ByteArray, value ParsedInt, valueType MaxonType)
	if not literalValueTypeIsRdataEligible(valueType) 'skipKind'
		return
	end 'skipKind'
	// Char-byte literals (`'a'`) take the single-byte fast path and emit a
	// `MaxonType.integer` literal op tagged in `project.charByteLiterals`,
	// but their true element type is the managed `Character` struct. Encoding
	// the raw codepoint into rdata would produce an array of bare ints where
	// `Character` managed pointers are expected — iterating it (e.g.
	// `Set.init`'s `for elem in arr`) then dereferences a codepoint as a
	// pointer and crashes. Exclude them so the array takes the runtime
	// `__mm.set` path, which materializes real `Character` structs.
	if project.charByteLiterals.contains(charByteLiteralKey(funcName, valueName: result)) 'isCharByte'
		return
	end 'isCharByte'
	let key = String.from(result)
	litValues.upsert(key, value: value)
end 'maybeRecordLiteral'

// True when the literal's MaxonType is one we can encode in rdata
// bytes. Integers (bare `int` or named integer typealiases — both arms
// of `MaxonType.integer` and `MaxonType.named`) and booleans qualify.
// Float and string literals are out of scope for the narrow-int rdata
// path; they have their own rdata-label machinery upstream.
function literalValueTypeIsRdataEligible(t MaxonType) returns bool
	return match t 'check'
		integer gives true
		boolean gives true
		named gives true
		unresolved gives false
		float gives false
		string gives false
		character gives false
		function gives false
		typeParameter to cstring gives false
	end 'check'
end 'literalValueTypeIsRdataEligible'

// Process one block: scan its op list for `__ManagedMemory.create`
// tryCalls, check eligibility, and rewrite. Removes set/setLength ops in
// place — `pos` is reset to 0 after a successful rewrite because the
// block's op list has shrunk and we want a clean walk.
function processBlock(project Project, module MaxonModule, globalData GlobalDataTable, func IrFunction, blockRef BlockRef, litValues LiteralValueMap)
	let block = try module.blocks.get(blockRef) otherwise panic("processBlock: blockRef OOB")
	var pos = 0
	while pos < block.opRefs.count() 'walk'
		let opIdx = try block.opRefs.get(pos) otherwise panic("processBlock: opRefs.get OOB at {pos}")
		let op = try module.ops.get(opIdx) otherwise panic("processBlock: ops.get OOB at {opIdx}")
		let info = extractMmCreateInfo(project, op: op)
		if not info.isMmCreate 'notCreate'
			pos = pos + 1
			continue
		end 'notCreate'
		// Look up the array-literal producer entry for this MM result.
		// Map-literal axes also key under their __mm name, so we end up
		// processing them too — that's fine, they share the same shape.
		let producerKey = arrayLiteralProducerKey(func.name, valueName: info.resultName)
		let producer = try project.arrayLiteralProducers.get(producerKey) otherwise 'noProducer'
			pos = pos + 1
			continue
		end 'noProducer'
		if not allElementsAreLiterals(litValues, producer: producer) 'notAllConst'
			// Not an rdata-eligible constant array — but its parser-emitted
			// runtime create still carries a hardcoded pointer-width elementSize.
			// Correct it to the resolved element width before moving on.
			stampNonConstantArrayElementSize(project, module: module, func: func, info: info)
			pos = pos + 1
			continue
		end 'notAllConst'
		let elementType = lookupResolvedElementType(module, func: func, producer: producer)
		if isUnresolvedType(elementType) 'noType'
			// Could not pin element type yet — leave for runtime path.
			pos = pos + 1
			continue
		end 'noType'
		// A constant ranged-int literal packs when its element type is pinned to the
		// alias: `[0 as Q, 1 as Q, …]` resolves through the `convert` op to `Q`, so
		// `packedElementBits` sees the range and it bit-packs like a bool literal. A
		// CONTEXT-typed bare literal (`[0, 1, 2, 3]` passed where `Array with Q` is
		// expected) decays to bare `int` at both its defining op and set call — the
		// alias lives only in the consuming context, invisible to this pass — so it
		// stores byte-strided (correct, just unpacked). Dynamically-built ranged-int
		// arrays carry the alias in their type arg and pack via the grow-site stamp.
		let count = producer.elemNames.count()
		// Sub-byte-packed element arrays are BIT-PACKED in rdata (a bool packs 8/byte,
		// an `int(0 to 3)` 4/byte, a nibble `int(0 to 15)` 2/byte). The record's
		// `element_size@24` carries the negative-bit-width encoding (-1/-2/-4) so the
		// runtime `__managed_mem_*` path bit-addresses get/set — the SAME representation
		// a dynamically-built `Array with <packed>` uses, so const and dynamic arrays
		// read identically. Byte-or-wider elements use the narrow byte width as before;
		// `elementStorageSize` (stamped below) returns both forms.
		var bytes = ByteArray.create()
		let packBits = packedElementBits(project, t: elementType)
		if packBits > 0 'packed'
			bytes = encodePackedBytes(litValues, producer: producer, bitWidth: packBits)
		end 'packed' else 'narrowArray'
			let widthBytes = primitiveWidth(project, t: elementType)
			bytes = encodeConstantArrayBytes(litValues, producer: producer, widthBytes: widthBytes)
		end 'narrowArray'
		let elementSizeInt = elementStorageSize(project, t: elementType)
		let label = mintConstantArrayLabel(func.name)
		project.staticRdataValues.upsert(label, value: bytes)
		addNamedGlobalData(globalData, name: label, data: bytes)
		let rdataInfo = ConstantArrayRdataInfo.create(label, count: count, elementSize: elementSizeInt)
		project.constantArrayRdata.upsert(opIdx, value: rdataInfo)
		// Strip per-element set / setLength calls that target this MM.
		eraseSetCallsForMm(module, block: block, mmName: info.resultName, startPos: pos + 1)
		pos = pos + 1
	end 'walk'
end 'processBlock'

// Identify a `tryCall` / `call` whose callee resolves to
// `__ManagedMemory.create`. The callee bytes are interned per project so
// a bytewise compare against the interned name is sufficient. Both
// tryCall and call are accepted because the parser's `emitErrorFlagDrain`
// rewrites the `call` into `tryCall` immediately after emission — but
// dead-code elimination or other passes may not preserve the try-form.
function extractMmCreateInfo(project Project, op MaxonOp) returns MmCreateInfo
	if op.rawValue.category != OpCategory.callFree 'notCall'
		return MmCreateInfo.none()
	end 'notCall'
	let createName = project.calleeNames.intern("__ManagedMemory.create")
	match op 'shape'
		tryCall(result, callee, _, args, _, _, _, _, _) then return matchMmCreateCallee(result, callee: callee, args: args, createName: createName)
		call(result, callee, _, args, _, _, _, _) then return matchMmCreateCallee(result, callee: callee, args: args, createName: createName)
		default panic("extractMmCreateInfo: op.name was call/tryCall but match did not extract")
	end 'shape'
end 'extractMmCreateInfo'

function matchMmCreateCallee(result ByteArray, callee ByteArray, args ByteArrayArray, createName ByteArray) returns MmCreateInfo
	if callee != createName 'notCreate'
		return MmCreateInfo.none()
	end 'notCreate'
	// The parser emits `__ManagedMemory.create(count, elementSize)`, so args[1]
	// is the elementSize literal's value name. Guard the arity defensively so a
	// future emission-shape change degrades to "no stamp" rather than a panic.
	if args.count() < 2 'noElemSize'
		return MmCreateInfo.create(result, elementSizeArgName: ByteArray.create())
	end 'noElemSize'
	let elemSizeArgName = try args.get(1) otherwise panic("matchMmCreateCallee: args.get(1) OOB after count check")
	return MmCreateInfo.create(result, elementSizeArgName: elemSizeArgName)
end 'matchMmCreateCallee'

type MmCreateInfo
	export var isMmCreate as bool
	export var resultName as ByteArray
	// The value name of the create call's second argument — the `elementSize`
	// literal. The non-constant element-size stamp rewrites the literal op that
	// defines this name. Empty when the create's arity is unexpectedly < 2.
	export var elementSizeArgName as ByteArray

	export static function none() returns MmCreateInfo
		return Self{isMmCreate: false, resultName: ByteArray.create(), elementSizeArgName: ByteArray.create()}
	end 'none'

	export static function create(resultName ByteArray, elementSizeArgName ByteArray) returns MmCreateInfo
		return Self{isMmCreate: true, resultName: resultName, elementSizeArgName: elementSizeArgName}
	end 'create'
end 'MmCreateInfo'

// A NON-constant array literal (at least one element is not a compile-time
// literal, so the rdata fast path above does not apply) keeps the parser-
// emitted runtime `__ManagedMemory.create(count, elementSize)`. The parser
// hardcodes `elementSize = 8` (pointer width) because element types are not
// resolved at parse time (see `emitManagedMemoryFromElements`'s TODO). For a
// NARROW element type (Byte 1, u16/i16 2, u32/i32 4) that stride is wrong:
// per-slot stores/loads, a later bulk read (`String.from`, `toCString`,
// `memcpy`), and `__managed_mem_grow`'s `newCap * element_size` sizing would all
// address every 8th byte. A `bool` element is sub-byte-PACKED — its stored size is
// the negative bit width -1, not 1. Post-TypeResolution the element type is known,
// so rewrite the create's `elementSize` operand to `elementStorageSize` (the same
// value the grow-site layout stamp derives, so a subsequent grow re-stamps the same
// width, a no-op). Pointer-width and managed elements (width 8) need no change and
// are left untouched.
function stampNonConstantArrayElementSize(project Project, module MaxonModule, func IrFunction, info MmCreateInfo)
	let elementType = lookupElementTypeFromSetCall(module, func: func, mmName: info.resultName)
	if isUnresolvedType(elementType) 'noType'
		// Empty literal (no set calls) or a type TypeResolution could not pin —
		// leave the pointer-width default; a later grow will stamp the real width.
		return
	end 'noType'

	// element_size@24 as a signed ParsedInt: -1 for a packed bool, else the byte
	// width. Comparing signed avoids the unsigned-MachineWord trap where a negative
	// width would read as a huge value.
	let stored = elementStorageSize(project, t: elementType)
	if stored == (pointerWidthBytes as ParsedInt) 'pointerWidth'
		return
	end 'pointerWidth'

	let loc = findManagedMemLiteralOp(module, func: func, name: info.elementSizeArgName)
	if not loc.found 'noLiteral'
		return
	end 'noLiteral'

	try module.ops.set(loc.opIdx, value: MaxonOp.literal(info.elementSizeArgName, value: stored, valueType: MaxonType.integer, range: loc.range)) otherwise panic("stampNonConstantArrayElementSize: ops.set OOB at {loc.opIdx}")
end 'stampNonConstantArrayElementSize'

// Recover the resolved element MaxonType of a non-constant array literal by
// reading the backfilled value-arg type of one of its `mm.set(i, value: elem)`
// calls. TypeResolution's `fillArgTypes` stamps the set call's `argTypes[1]`
// with the unified element type. Unlike `lookupResolvedElementType` (which
// probes the element's DEFINING op and only succeeds when that op is a
// literal/convert), this works for arbitrary non-constant elements (params,
// call results, field loads). Returns unresolved when no set call is found
// (empty literal) or the type has not been pinned.
function lookupElementTypeFromSetCall(module MaxonModule, func IrFunction, mmName ByteArray) returns MaxonType
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("lookupElementTypeFromSetCall: blockRef OOB")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("lookupElementTypeFromSetCall: opIdx OOB at {opIdx}")
			if op.rawValue.category != OpCategory.callMethod 'notMethodCall'
				continue
			end 'notMethodCall'
			let probe = setCallElementTypeProbe(op, mmName: mmName)
			if probe.found 'hit'
				return probe.valueType
			end 'hit'
		end 'eachOp'
	end 'eachBlock'
	return MaxonType.unresolved
end 'lookupElementTypeFromSetCall'

// Package a method-call op into an element-type probe: a `mm.set(i, value:)`
// whose receiver is `mmName` yields its resolved value-arg type. The
// `OpCategory.callMethod` guard in the caller ensures only method calls reach
// here, so the `default` arm is unreachable.
function setCallElementTypeProbe(op MaxonOp, mmName ByteArray) returns LiteralValueTypeProbe
	let setName = "set".toByteArray()
	match op 'shape'
		tryMethodCall(_, receiver, methodName, _, _, argTypes, _, _, _) then return setCallValueType(receiver, methodName: methodName, argTypes: argTypes, mmName: mmName, setName: setName)
		methodCall(_, receiver, methodName, _, _, argTypes, _, _) then return setCallValueType(receiver, methodName: methodName, argTypes: argTypes, mmName: mmName, setName: setName)
		default panic("setCallElementTypeProbe: op category was callMethod but match did not extract")
	end 'shape'
end 'setCallElementTypeProbe'

// Return the resolved element type from a `set` call's `argTypes[1]`, or a miss
// when the call is not `mmName.set(...)` or its value type is not yet resolved.
function setCallValueType(receiver ByteArray, methodName ByteArray, argTypes MaxonTypeArray, mmName ByteArray, setName ByteArray) returns LiteralValueTypeProbe
	if receiver != mmName 'notOurs'
		return LiteralValueTypeProbe.miss()
	end 'notOurs'
	if methodName != setName 'notSet'
		return LiteralValueTypeProbe.miss()
	end 'notSet'
	if argTypes.count() < 2 'noValueType'
		return LiteralValueTypeProbe.miss()
	end 'noValueType'

	let valueType = try argTypes.get(1) otherwise panic("setCallValueType: argTypes.get(1) OOB after count check")
	if isUnresolvedType(valueType) 'unresolved'
		return LiteralValueTypeProbe.miss()
	end 'unresolved'
	return LiteralValueTypeProbe.hit(valueType)
end 'setCallValueType'

// Locate the `literal` op that defines `name` anywhere in the function, so its
// value (and only its value) can be rewritten in place. The elementSize literal
// and the create call may sit in different blocks (`emitManagedMemoryFromElements`
// emits the literal into `block` but the create into `currentBlock`), so the
// scan spans every block. Returns its op index and source range.
function findManagedMemLiteralOp(module MaxonModule, func IrFunction, name ByteArray) returns LiteralOpLoc
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("findManagedMemLiteralOp: blockRef OOB")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("findManagedMemLiteralOp: opIdx OOB at {opIdx}")
			let probe = match op 'shape'
				literal(result, _, _, range) gives literalOpLocProbe(opIdx, result: result, range: range, target: name)
				convert gives LiteralOpLoc.missing()
				stringConst to unop gives LiteralOpLoc.missing()
				castCheck to sizeofType gives LiteralOpLoc.missing()
			end 'shape'
			if probe.found 'hit'
				return probe
			end 'hit'
		end 'eachOp'
	end 'eachBlock'
	return LiteralOpLoc.missing()
end 'findManagedMemLiteralOp'

// Package a `literal` op into a location probe: a hit (with its op index and
// range) when its result name matches `target`, else a miss.
function literalOpLocProbe(opIdx OpIndex, result ByteArray, range SourceRange, target ByteArray) returns LiteralOpLoc
	if result == target 'matched'
		return LiteralOpLoc.hit(opIdx, range: range)
	end 'matched'
	return LiteralOpLoc.missing()
end 'literalOpLocProbe'

type LiteralOpLoc
	export var found as bool
	export var opIdx as OpIndex
	export var range as SourceRange

	export static function missing() returns LiteralOpLoc
		return Self{found: false, opIdx: 0, range: SourceRange.none()}
	end 'missing'

	export static function hit(opIdx OpIndex, range SourceRange) returns LiteralOpLoc
		return Self{found: true, opIdx: opIdx, range: range}
	end 'hit'
end 'LiteralOpLoc'

// Every element value name in the array-literal producer must be the
// result of a literal op. The producer's `elemNames` list is the parser-
// recorded source-order element-value sequence; we match each against the
// per-function literal value map collected upstream.
function allElementsAreLiterals(litValues LiteralValueMap, producer ArrayLiteralProducer) returns bool
	if producer.elemNames.count() == 0 'empty'
		return false
	end 'empty'
	for elemName in producer.elemNames 'each'
		let key = String.from(elemName)
		if not litValues.contains(key) 'missing'
			return false
		end 'missing'
	end 'each'
	return true
end 'allElementsAreLiterals'

// The producer's first element name carries the resolved element
// MaxonType through `producerTypes` — but the pass runs after
// `fillUnresolvedTypes` so the per-function producer-type maps have
// been thrown away. Recover the type by inspecting the op that DEFINES
// the first element value (every element shares one unified type post-TR).
// The defining op is either a `literal` (plain `[10, 20, 30]`, element type
// = the literal's value type) or a `convert` (`[10 as Byte, ...]`, element
// type = the convert's `toType` — e.g. Byte, yielding element_size 1).
function lookupResolvedElementType(module MaxonModule, func IrFunction, producer ArrayLiteralProducer) returns MaxonType
	if producer.elemNames.count() == 0 'empty'
		return MaxonType.unresolved
	end 'empty'
	let firstName = try producer.elemNames.get(0) otherwise panic("lookupResolvedElementType: elemNames.get(0) OOB")
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("lookupResolvedElementType: blockRef OOB")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("lookupResolvedElementType: opIdx OOB at {opIdx}")
			// The defining op is either a `literal` (element type = the
			// literal's value type) or a `convert` (`[10 as Byte, ...]`,
			// element type = the convert's `toType` — e.g. Byte, element
			// size 1). Every other op shape misses.
			let hit = match op 'pickShape'
				literal(result, _, valueType, _) gives literalValueTypeProbeFor(result, valueType: valueType, target: firstName)
				convert(result, _, _, toType, _, _) gives literalValueTypeProbeFor(result, valueType: toType, target: firstName)
				stringConst to unop gives LiteralValueTypeProbe.miss()
				castCheck to sizeofType gives LiteralValueTypeProbe.miss()
			end 'pickShape'
			if hit.found 'gotIt'
				return hit.valueType
			end 'gotIt'
		end 'eachOp'
	end 'eachBlock'
	return MaxonType.unresolved
end 'lookupResolvedElementType'

type LiteralValueTypeProbe
	export var found as bool
	export var valueType as MaxonType

	export static function miss() returns LiteralValueTypeProbe
		return Self{found: false, valueType: MaxonType.unresolved}
	end 'miss'

	export static function hit(valueType MaxonType) returns LiteralValueTypeProbe
		return Self{found: true, valueType: valueType}
	end 'hit'
end 'LiteralValueTypeProbe'

// True when `result` matches the target element name, packaging the
// element's MaxonType into a probe hit. Called from the `literal` and
// `convert` arms of `lookupResolvedElementType`'s `match op`.
function literalValueTypeProbeFor(result ByteArray, valueType MaxonType, target ByteArray) returns LiteralValueTypeProbe
	if result == target 'matched'
		return LiteralValueTypeProbe.hit(valueType)
	end 'matched'
	return LiteralValueTypeProbe.miss()
end 'literalValueTypeProbeFor'

// Pack each element value into the encoded byte sequence. Little-endian
// per the target ABI — every supported target (x64, arm64, wasm) is
// little-endian. Signedness is not threaded through: the two's-complement
// byte pattern for a signed value matches the unsigned bit pattern at
// every width, so the bytes are identical either way.
function encodeConstantArrayBytes(litValues LiteralValueMap, producer ArrayLiteralProducer, widthBytes MachineWord) returns ByteArray
	var bytes = ByteArray.create()
	for elemName in producer.elemNames 'each'
		let key = String.from(elemName)
		let v = try litValues.get(key) otherwise panic("encodeConstantArrayBytes: missing literal for '{key}' (allElementsAreLiterals should have guarded)")
		appendLittleEndian(bytes, value: v, widthBytes: widthBytes)
	end 'each'
	return bytes
end 'encodeConstantArrayBytes'

// Sub-byte-pack constant array elements into `ceil(count * bitWidth / 8)` bytes,
// LSB-first: element i occupies the `bitWidth`-bit field at bit `i * bitWidth` —
// bits [(i*bitWidth) mod 8, +bitWidth) of byte `(i*bitWidth) / 8`. Widths divide 8
// (1/2/4) so a field never straddles a byte, and every byte starts zeroed, so a
// single OR of the masked value places it (no clear-mask, unlike the runtime
// `__managed_mem_write_packed` which writes into a live buffer). This MIRRORS that
// runtime layout so a constant literal and a dynamically-built array read
// identically. bitWidth 1 reduces to bool bit-packing (`[true,false,true,false]`
// -> `0x05`); the `and mask` is a no-op for any in-range element value.
function encodePackedBytes(litValues LiteralValueMap, producer ArrayLiteralProducer, bitWidth MachineWord) returns ByteArray
	let count = producer.elemNames.count()
	let byteCount = (count * bitWidth + 7) / 8
	var bytes = ByteArray.create()
	var b = 0 as MachineWord
	while b < byteCount 'zero'
		bytes.push(0)
		b = b + 1
	end 'zero'
	let mask = (1 shl bitWidth) - 1
	var i = 0
	for elemName in producer.elemNames 'each'
		let key = String.from(elemName)
		let v = try litValues.get(key) otherwise panic("encodePackedBytes: missing literal for '{key}' (allElementsAreLiterals should have guarded)")
		let bitPos = i * bitWidth
		let byteIdx = bitPos / bitsPerByte
		let bitOff = bitPos mod bitsPerByte
		let cur = try bytes.get(byteIdx) otherwise panic("encodePackedBytes: byteIdx {byteIdx} OOB (byteCount {byteCount})")
		try bytes.set(byteIdx, value: cur or ((v and mask) shl bitOff)) otherwise panic("encodePackedBytes: set byteIdx {byteIdx} OOB")
		i = i + 1
	end 'each'
	return bytes
end 'encodePackedBytes'

// Append `widthBytes` little-endian bytes of `value` to `bytes`. Sign
// handling is implicit: `ParsedInt` is i64, two's-complement, and the
// low N bytes match what every backend's narrow store writes.
function appendLittleEndian(bytes ByteArray, value ParsedInt, widthBytes MachineWord)
	var i = 0 as MachineWord
	while i < widthBytes 'each'
		let shift = (i * bitsPerByte)
		let byteVal = ((value shr shift) and 0xff) as Byte
		bytes.push(byteVal)
		i = i + 1
	end 'each'
end 'appendLittleEndian'

// Mint a fresh `__rdata_arr_*` label. The function name disambiguates
// across functions (multiple `let arr = [...]` in distinct functions),
// the counter disambiguates within one function (e.g. nested literals
// or sibling array constants). The result is interned via
// `staticRdataValues` so a second mint with the same label would
// overwrite — the counter prevents that.
function mintConstantArrayLabel(funcName String) returns String
	let id = constantArrayLiteralCounter
	constantArrayLiteralCounter = constantArrayLiteralCounter + 1
	// Sanitize function name: replace `.` with `_` so the label is a
	// valid linker symbol (matches the bootstrap's `__const_array_*`
	// shape).
	let sanitized = sanitizeFunctionNameForLabel(funcName)
	return "__rdata_arr_{sanitized}_{id}"
end 'mintConstantArrayLabel'

// Replace `.` characters in a function name with `_` so the resulting
// label is a clean linker-friendly symbol. Mirrors the approach the
// bootstrap uses when minting per-function rdata labels.
function sanitizeFunctionNameForLabel(name String) returns String
	let raw = name.toByteArray()
	// 0x5f = '_'. Using the numeric literal sidesteps a bootstrap-side
	// cast-validation hiccup for char-to-Byte conversion (the self-hosted
	// compiler treats both as integer).
	let underscore = 0x5f as Byte
	var out = ByteArray.create()
	for b in raw 'each'
		if b == '.' 'isDot'
			out.push(underscore)
		end 'isDot' else 'keep'
			out.push(b)
		end 'keep'
	end 'each'
	return String.from(out)
end 'sanitizeFunctionNameForLabel'

// Remove `mm.set(...)` and `mm.setLength(...)` ops whose receiver is
// `mmName`, starting at `startPos`. The walk skips over interleaved
// literal ops (the parser emits an `int` literal for each set's index /
// the setLength count between the call ops), and stops at the first op
// that mentions `mmName` as anything other than a set/setLength
// receiver — that's the first downstream use (the `Array.init(mm)`
// call) and signals we've consumed every internally-emitted setter.
function eraseSetCallsForMm(module MaxonModule, block IrBlock, mmName ByteArray, startPos OpCount)
	var pos = startPos
	while pos < block.opRefs.count() 'walk'
		let opIdx = try block.opRefs.get(pos) otherwise panic("eraseSetCallsForMm: opRefs.get OOB at {pos}")
		let op = try module.ops.get(opIdx) otherwise panic("eraseSetCallsForMm: ops.get OOB at {opIdx}")
		if isSetOrSetLengthOnMm(op, mmName: mmName) 'isTarget'
			_ = try block.opRefs.remove(pos) otherwise panic("eraseSetCallsForMm: opRefs.remove OOB at {pos}")
			continue
		end 'isTarget'
		// Index / count literals interleaved with the set calls — leave
		// in place (later DCE drops their dead defs).
		let isIndexLiteral = match op 'classify'
			literal gives true
			stringConst to sizeofType gives false
		end 'classify'
		if isIndexLiteral 'isLiteral'
			pos = pos + 1
			continue
		end 'isLiteral'
		// Anything else means we've reached the first non-setter use
		// of the MM (typically `Array.init(mm)`); stop scanning.
		return
	end 'walk'
end 'eraseSetCallsForMm'

// Is `op` a `tryMethodCall` / `methodCall` whose receiver is `mmName`
// and whose method is `set` or `setLength`? The parser emits the entire
// per-element write sequence using these exact method names, so a
// byte-level compare on the method name field is enough.
function isSetOrSetLengthOnMm(op MaxonOp, mmName ByteArray) returns bool
	let setName = "set".toByteArray()
	let setLengthName = "setLength".toByteArray()
	if op.rawValue.category != OpCategory.callMethod 'notMethodCall'
		return false
	end 'notMethodCall'
	match op 'shape'
		tryMethodCall(_, receiver, methodName, _, _, _, _, _, _) then return receiver == mmName and (methodName == setName or methodName == setLengthName)
		methodCall(_, receiver, methodName, _, _, _, _, _) then return receiver == mmName and (methodName == setName or methodName == setLengthName)
		default panic("isSetOrSetLengthOnMm: op.name was methodCall/tryMethodCall but match did not extract")
	end 'shape'
end 'isSetOrSetLengthOnMm'

// Per-function value-name → integer-value lookup. Keys are
// `String.from(byteArray)` because Map's hash/eq operate on String, and
// element names are slices over the source buffer (so direct ByteArray
// keys would compare by identity rather than content). Building the
// map keys once up-front amortizes the conversion cost across the scan.
typealias LiteralValueMap = Map with (String, ParsedInt)
