// Typed query functions wrapping each compiler phase.
// Each follows the memoization pattern:
//   1. Record dependency (caller depends on this query)
//   2. Check cache -- if present and valid, return cached value
//   3. Push self onto activeQueryStack
//   4. Clear old dependencies for self
//   5. Compute result (calling upstream queries records deps)
//   6. Pop from activeQueryStack
//   7. Store result in cache with current revision
//   8. Return result
// All functions receive a Project parameter to access the query database.

// --- Input query: source file content ---

function querySourceFile(project Project, path FilePath) returns String throws CompileError
	recordDependency(project, dependency: QueryKey.sourceFile(path))
	let entry = try project.db.sourceFiles.get(path) otherwise throw CompileError.fileNotFound(path)
	return entry.content
end 'querySourceFile'

// --- Per-file derived query: tokenize ---

function queryTokens(project Project, path FilePath) returns TokenArray throws CompileError
	let key = QueryKey.tokens(path)
	recordDependency(project, dependency: key)

	// Check cache
	if var memo = try project.db.tokenCache.get(path) 'checkCache'
		if memo.computedAt > 0 'hasValue'
			if areDepsValid(project, key: key, computedAt: memo.computedAt) 'valid'
				logDebug(LogCategory.compiler, message: function() gives "queryTokens cache hit for {path}")
				project.db.tokenHits = project.db.tokenHits + 1
				memo.verifiedAt = project.db.currentRevision
				return memo.value
			end 'valid'
		end 'hasValue'
	end 'checkCache'

	logDebug(LogCategory.compiler, message: function() gives "queryTokens computing for {path}")
	project.db.tokenMisses = project.db.tokenMisses + 1

	// Compute
	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	let content = try querySourceFile(project, path: path)
	// tokenize throws LexerError for fatal scan errors (e.g. unterminated
	// string literal). Forward those to the project's diagnostic sink so
	// the gate at queryAllMid stops the pipeline before parsing consumes
	// partial tokens. Then return an empty token stream so the caller's
	// downstream logic doesn't crash on truncated input.
	let lexStart = passTimerStart()
	let tokens = try tokenize(content) otherwise (lerr) 'lexFail'
		match lerr 'kind'
			unterminatedString(line, column) then reportCompileError(project, code: ErrorCode.lexerUnterminatedString, message: "Unterminated string literal", line: line, column: column, filePath: path)
			unterminatedBlockComment(line, column) then reportCompileError(project, code: ErrorCode.lexerUnterminatedBlockComment, message: "Unterminated block comment", line: line, column: column, filePath: path)
			unescapedBrace(line, column) then reportCompileError(project, code: ErrorCode.lexerUnescapedBrace, message: "Unescaped '\{' in string literal — use '\\\{' for a literal brace", line: line, column: column, filePath: path)
			unknownDirective(name, line, column) then reportCompileError(project, code: ErrorCode.lexerUnexpectedCharacter, message: "Unknown compiler directive '#{name}'. Expected '#if', '#else', or '#endif'.", line: line, column: column, filePath: path)
			unexpectedEof(line, column) then reportCompileError(project, code: ErrorCode.parserUnexpectedEof, message: "Unexpected end of input", line: line, column: column, filePath: path)
		end 'kind'
		popQuery(project)
		return TokenArray.create()
	end 'lexFail'
	recordPassSince("__lex", startMs: lexStart)

	popQuery(project)

	// Store
	let newMemo = TokenMemo.create(tokens, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)
	project.db.tokenCache.upsert(path, value: newMemo)

	return tokens
end 'queryTokens'

// Derive a namespace from the file path relative to its compile root.
//
// Phase 4 of the directory-as-module redesign: a file's namespace is the
// directory portion of its path relative to `rootPath`, with separators
// converted to dots. Stdlib uses `<install>` as the root, user code uses
// the project root, single-file spec fragments use the fragment directory
// itself.
//
// Examples (with rootPath = the per-file compile anchor):
//   - root=<install>,  path=<install>/stdlib/Math.maxon            -> "stdlib"
//   - root=<install>,  path=<install>/stdlib/helpers/string/utf8.maxon -> "stdlib.helpers.string"
//   - root=<tempDir>,  path=<tempDir>/api/types.maxon              -> "api"
//   - root=<fragDir>,  path=<fragDir>/basic.test                   -> ""
export function deriveNamespace(filePath FilePath, rootPath FilePath) returns String
	let rel = try filePath.relativeTo(rootPath) otherwise 'notUnderRoot'
		// Misconfigured caller: file lives outside its declared rootPath.
		// Fall back to the immediate parent directory name so we never
		// produce ".." segments in qualified names.
		let parent = try filePath.parent() otherwise return ""
		return parent.filename()
	end 'notUnderRoot'
	let parent = try rel.parent() otherwise return ""
	let dirStr = parent.toString()
	if dirStr.isEmpty() 'noDir'
		return ""
	end 'noDir'
	return dirStr.replace("\\", with: ".").replace("/", with: ".")
end 'deriveNamespace'

// --- Per-file derived query: parse ---

function queryParseOps(project Project, path FilePath) returns MaxonModule throws CompileError
	let key = QueryKey.parseOps(path)
	recordDependency(project, dependency: key)

	// Check cache
	if var memo = try project.db.parseCache.get(path) 'checkCache'
		if memo.computedAt > 0 'hasValue'
			if areDepsValid(project, key: key, computedAt: memo.computedAt) 'valid'
				logDebug(LogCategory.compiler, message: function() gives "queryParseOps cache hit for {path}")
				project.db.parseHits = project.db.parseHits + 1
				memo.verifiedAt = project.db.currentRevision
				return memo.value
			end 'valid'
		end 'hasValue'
	end 'checkCache'

	logDebug(LogCategory.compiler, message: function() gives "queryParseOps computing for {path}")
	project.db.parseMisses = project.db.parseMisses + 1

	// Compute
	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	// Parser-side-effect rollback. If this file was parsed before (then
	// invalidated by a content change or a manual edit), the prior parse's
	// inserts into funcReturnTypes / methodNameIndex / unresolvedStructTypes /
	// … are still live on `project`. Without rollback, the upcoming
	// `parseModule` call collides with its own prior registrations on every
	// `.insert(...)` site. `beginFileParse` removes those entries before the
	// parse runs.
	beginFileParse(project, filePath: path)

	let tokens = try queryTokens(project, path: path)
	let parseStart = passTimerStart()
	let errorCountBefore = project.diagnostics.count()
	// Empty or whitespace-only source produces an empty token stream and the
	// Parser.create attempt fails. That isn't an error — an empty file is
	// just a module with no functions. Return an empty module and let the
	// "no main" semantic check fire if appropriate.
	var parser = try Parser.create(project, tokens: tokens, filePath: path, rootPath: project.rootPath, namespace: deriveNamespace(path, rootPath: project.rootPath)) otherwise 'parserCreateFail'
		popQuery(project)
		return MaxonModule.create()
	end 'parserCreateFail'
	let module = try parser.parseModule() otherwise 'parseModuleFail'
		// If the parser threw without recording any diagnostic, it's because
		// expect/consume hit EOF while parsing a truly-truncated input (e.g.
		// `function ` with no name). The throw is the parser's fast-unwind
		// path; emit a generic diagnostic here so the error gate at
		// queryAllMid catches it instead of silently rolling forward to the
		// "no main" semantic check. Position points at the last lexed token,
		// which is the closest stable anchor we have for "where the input
		// ended."
		if project.diagnostics.count() == errorCountBefore 'noDiagYet'
			var eofLine = 1 as LineNumber
			var eofColumn = 1 as ColumnNumber
			if tokens.count() > 0 'hasTokens'
				let lastTok = try tokens.get(tokens.count() - 1) otherwise panic("queryParseOps: tokens.count() > 0 but get failed")
				eofLine = lastTok.line
				eofColumn = lastTok.column
			end 'hasTokens'
			reportCompileError(project, code: ErrorCode.parserUnexpectedEof, message: "Unexpected end of input", line: eofLine, column: eofColumn, filePath: path)
		end 'noDiagYet'
		popQuery(project)
		return MaxonModule.create()
	end 'parseModuleFail'
	recordPassSince("__parse", startMs: parseStart)

	popQuery(project)

	// Only cache if no new errors were added during this file's parse
	let hadErrors = project.diagnostics.count() > errorCountBefore
	if not hadErrors 'cacheOk'
		// Sanity check: every block emitted during a successful parse must
		// have a terminator. Skipped on error paths — reported errors may
		// legitimately leave blocks unfinished.
		module.assertAllBlocksTerminated()
		let newMemo = ParseMemo.create(module, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)
		project.db.parseCache.upsert(path, value: newMemo)
	end 'cacheOk'

	return module
end 'queryParseOps'

// Pre-parse declaration-name scan. Tokenizes every source file and records each
// top-level `interface <Name>` in `project.prescannedInterfaceNames` (so
// `internMaxonType` can promote a forward-referenced interface use site to its
// `interface(_)` arm) and each top-level `union <Name>` in
// `project.prescannedUnionPayload` — mapped to whether any case carries a
// payload — so `enumIsUnion` (membership) and `unionIsBoxed` (the payload flag)
// recognise a forward / cross-file union, AND its representation, before its
// declaring file is parsed. Both close the same gap: the parser parses
// file-by-file, top-to-bottom, so a declaration
// may be parsed only after a use site elsewhere has already been resolved. This
// is the self-hosted analogue of maxon-sharp's `PreScan` registering all type
// names before any param/return annotation is resolved.
//
// `interface` is a keyword but is ALSO a legal parameter / variable / field
// name (keywords-as-identifiers, see `keyword-parameter-names`), so a bare
// `interface <ident>` match would mis-register the SECOND token in
// `passthrough(interface StdType)` as an interface. To match only genuine
// `[export|module] interface <Name>` declarations, the scan requires the
// `interface` token to be (a) at parenthesis/bracket depth 0 — a param-name
// `interface` always sits inside `(...)` — and (b) in statement position: the
// preceding non-trivial token is a newline, `export`, the contextual `module`
// keyword, or the file start. This mirrors how `dispatchInner` only reaches
// `parseInterfaceDecl` from a top-level/decl-opener position. The scan is
// name-only: the full `UnresolvedInterfaceType` is still built by
// `parseInterfaceDecl` during the real parse, which owns duplicate detection.
function preRegisterInterfaceNames(project Project) throws CompileError
	for path in project.db.sourcePaths 'eachFile'
		let tokens = try queryTokens(project, path: path)
		let tokenCount = tokens.count()
		var parenDepth = 0
		for i in 0 upto tokenCount 'eachToken'
			let token = try tokens.get(i) otherwise panic("preRegisterInterfaceNames: tokens.get OOB at {i}")
			if token.kind == TokenKind.leftParen or token.kind == TokenKind.leftBracket 'openGroup'
				parenDepth = parenDepth + 1
				continue
			end 'openGroup'
			if token.kind == TokenKind.rightParen or token.kind == TokenKind.rightBracket 'closeGroup'
				if parenDepth > 0 'haveOpen'
					parenDepth = parenDepth - 1
				end 'haveOpen'
				continue
			end 'closeGroup'
			// We scan for four declaration keywords: `interface <Name>`,
			// `union <Name>`, `enum <Name>`, and `type <Name>`. All are also legal
			// as parameter / variable names (keywords-as-identifiers), so require
			// depth 0 (a param-name keyword always sits inside `(...)`) and the
			// statement-position gate below.
			let isInterfaceKw = token.kind == TokenKind.interface
			let isUnionKw = token.kind == TokenKind.union
			let isEnumKw = token.kind == TokenKind.enum
			let isTypeKw = token.kind == TokenKind.type
			if (not isInterfaceKw and not isUnionKw and not isEnumKw and not isTypeKw) or parenDepth != 0 'notDecl'
				continue
			end 'notDecl'
			// Statement-position gate: a genuine declaration follows a newline,
			// `export`, the contextual `module` keyword, or the file start. A
			// param/variable-name keyword follows some other token (it is also
			// usually inside `(...)`, already excluded by parenDepth).
			if i > 0 'notFileStart'
				let prev = try tokens.get(i - 1) otherwise continue
				let prevIsModule = prev.kind == TokenKind.identifier and prev.value == "module"
				if prev.kind != TokenKind.newline and prev.kind != TokenKind.export and not prevIsModule 'notStatementPosition'
					continue
				end 'notStatementPosition'
			end 'notFileStart'
			let nameToken = try tokens.get(i + 1) otherwise continue
			if nameToken.kind != TokenKind.identifier 'noName'
				continue
			end 'noName'
			if isInterfaceKw 'recordInterface'
				project.prescannedInterfaceNames.insert(nameToken.value)
			end 'recordInterface' else if isUnionKw 'recordUnion'
				// Record the union AND whether any case carries a payload, so the
				// cross-file forward-reference fallbacks in `enumIsUnion` (membership)
				// and `unionIsBoxed` (payload flag) answer the same way the resolved
				// path would. A payload-free union is representationally an enum
				// (ordinal+1 throw ABI, no `__construct_*`); a payload-bearing union
				// is heap-boxed. Guessing "boxed" for a forward-referenced scalar
				// union routed its thrown case through a never-synthesized
				// `__construct_*` and crashed the backend.
				let payloadBearing = unionBodyIsPayloadBearing(tokens, unionStart: i)
				project.prescannedUnionPayload.upsert(nameToken.value, value: payloadBearing)
			end 'recordUnion' else if isEnumKw 'recordEnum'
				// Record the enum's full declaration-ordered case list so the
				// parse-time `.allCases` / `.allCaseNames` synthesis (and the
				// `prefixIsEnum` static-access gate) resolve a forward / cross-file
				// enum reference the same way they would in declaration order —
				// regardless of which file the parse loop reaches first. See
				// `scanEnumBodyCases`. A `union` is introduced with its own keyword
				// (handled above), so only a genuine `enum` reaches here.
				project.prescannedEnumCases.upsert(nameToken.value, value: scanEnumBodyCases(tokens, enumStart: i, filePath: path))
			end 'recordEnum' else 'recordType'
				// Record the struct/type name so `maxonTypeStructName` recognises a
				// cross-file struct-typed receiver at parse time (the qualified
				// `TypeName.method` key the `(e)` binding's throws lookup needs),
				// regardless of which file the parse loop reaches first.
				project.prescannedTypeNames.insert(nameToken.value)
			end 'recordType'
		end 'eachToken'
	end 'eachFile'
end 'preRegisterInterfaceNames'

// Token-level payload detector for the pre-parse scan: given the index of a
// `union` opener token, returns true iff any of the union's cases carries an
// associated-value payload (`caseName(...)`). Mirrors `parseUnionDecl`'s payload
// decision (a case is payload-bearing iff its name is immediately followed by
// `(`), but works purely on tokens so it can run before any body is parsed.
//
// Method bodies inside the union (`function m() ... end`) must NOT be mistaken
// for payload cases: a call `helper(x)` inside a method is also `IDENT (`. So we
// only inspect tokens DIRECTLY in the union body (block depth 0 relative to the
// union opener), using the same block-opener set as `prescanFunctionThrows`. A
// payload case appears at statement position (after a newline) at that depth.
function unionBodyIsPayloadBearing(tokens TokenArray, unionStart ElementCount) returns bool
	let tokenCount = tokens.count()
	// Walk from just past `union <Name>`. `depth` counts open `end`-bearing
	// blocks RELATIVE to the union body; depth 0 is the union body itself. The
	// union's own body opens at depth 1 once we pass its header line, so we seed
	// depth 1 here and close the union when depth falls back to 0.
	var depth = 1 as PrescanDepth
	var i = unionStart + 2
	while i < tokenCount and depth > 0 'scan'
		let tok = try tokens.get(i) otherwise break
		let kind = tok.kind

		// Block openers (mirror `prescanFunctionThrows`). A nested type opener
		// cannot occur inside a union body, but methods, control flow, and
		// block-form try all open `end`-bearing blocks whose contents must be
		// skipped.
		if kind == TokenKind.function or kind == TokenKind.if or kind == TokenKind.while or kind == TokenKind.for or kind == TokenKind.match 'blockOpener'
			depth = depth + 1
			i = i + 1
			continue
		end 'blockOpener'
		if kind == TokenKind.else 'elseReopen'
			depth = depth + 1
			let nextTok = try tokens.get(i + 1) otherwise Token.eof()
			if nextTok.kind == TokenKind.if 'elseIf'
				i = i + 2
				continue
			end 'elseIf'
			i = i + 1
			continue
		end 'elseReopen'
		if kind == TokenKind.try 'maybeTryBlock'
			let labelTok = try tokens.get(i + 1) otherwise Token.eof()
			if labelTok.kind == TokenKind.charLiteral 'isBlockTry'
				depth = depth + 1
			end 'isBlockTry'
			i = i + 1
			continue
		end 'maybeTryBlock'
		if kind == TokenKind.end 'closeBlock'
			depth = depth - 1
			i = i + 1
			continue
		end 'closeBlock'

		// A payload case is recognised only at the union-body statement position
		// (depth 1, after a newline): an identifier whose next token is `(`. The
		// preceding-newline gate keeps a method-return-type or backing expression
		// that happens to read `IDENT (` from registering a false payload.
		if depth == 1 and kind == TokenKind.identifier 'maybeCase'
			let prev = try tokens.get(i - 1) otherwise Token.eof()
			let afterName = try tokens.get(i + 1) otherwise Token.eof()
			if prev.kind == TokenKind.newline and afterName.kind == TokenKind.leftParen 'payloadCase'
				return true
			end 'payloadCase'
		end 'maybeCase'

		i = i + 1
	end 'scan'

	return false
end 'unionBodyIsPayloadBearing'

// One enum case's `= <raw value>` backing, decoded at the token level for the
// pre-parse scan. See `scanEnumCaseBacking`.
type PrescanEnumBacking
	// The case's raw value — what `.allCases` emits as the literal. The running
	// ordinal for every backing except int-backed (explicit value) and
	// float-backed (the IEEE-754 bit pattern).
	export var rawValue as IntConstant
	// The auto-increment counter for the NEXT case that omits `=`.
	export var nextOrdinal as IntConstant
	// Token index where the case walk resumes (the terminating newline / `end`).
	export var nextIndex as ElementCount
	export var isFloat as bool
	export var isString as bool
	export var isChar as bool

	export static function create(rawValue IntConstant, nextOrdinal IntConstant, nextIndex ElementCount, isFloat bool, isString bool, isChar bool) returns PrescanEnumBacking
		return Self{rawValue: rawValue, nextOrdinal: nextOrdinal, nextIndex: nextIndex, isFloat: isFloat, isString: isString, isChar: isChar}
	end 'create'
end 'PrescanEnumBacking'

// Advance past one enum-case right-hand side, balancing `()` / `[]` / `{}` so a
// struct-literal backing (`= StructType{...}` / `= StructType.create(...)`) that
// spans brackets or newlines is consumed whole. Returns the index of the
// terminating newline (or the enum's `end`, or EOF) at bracket depth 0, where
// the caller's statement-position case walk resumes.
function skipEnumBackingRhs(tokens TokenArray, startIndex ElementCount) returns ElementCount
	let tokenCount = tokens.count()
	var bracketDepth = 0 as PrescanDepth
	var i = startIndex
	while i < tokenCount 'skip'
		let tok = try tokens.get(i) otherwise break
		let kind = tok.kind
		if kind == TokenKind.leftParen or kind == TokenKind.leftBracket or kind == TokenKind.leftBrace 'open'
			bracketDepth = bracketDepth + 1
			i = i + 1
			continue
		end 'open'
		if kind == TokenKind.rightParen or kind == TokenKind.rightBracket or kind == TokenKind.rightBrace 'close'
			if bracketDepth > 0 'haveOpen'
				bracketDepth = bracketDepth - 1
			end 'haveOpen'
			i = i + 1
			continue
		end 'close'
		if bracketDepth == 0 and (kind == TokenKind.newline or kind == TokenKind.end) 'lineEnd'
			return i
		end 'lineEnd'
		i = i + 1
	end 'skip'
	return i
end 'skipEnumBackingRhs'

// Token-level reader for one enum case's `= <raw value>` backing, used by
// `scanEnumBodyCases`. `valueIndex` points at the first token after `=`.
// Mirrors `parseCaseBacking`'s raw-value assignment: an int literal (optionally
// negated) is the explicit value and resets the auto-increment counter; a float
// literal becomes the IEEE-754 bit pattern (negated by toggling the sign bit);
// string / char / struct / function backings keep the running ordinal as the
// raw value (their representation IS the ordinal). Emits no diagnostics —
// overflow / type-mismatch reporting stays with the real parse.
function scanEnumCaseBacking(tokens TokenArray, valueIndex ElementCount, nextOrdinal IntConstant) returns PrescanEnumBacking
	var rawValue = nextOrdinal
	var nextOrdinalOut = nextOrdinal + 1
	var isFloat = false
	var isString = false
	var isChar = false

	// Peel an optional leading `-` so a negative numeric literal reads as one
	// value (the lexer emits `-` as its own token).
	var magIndex = valueIndex
	var sign = 1 as IntConstant
	let signTok = try tokens.get(valueIndex) otherwise Token.eof()
	if signTok.kind == TokenKind.minus 'negative'
		sign = -1
		magIndex = valueIndex + 1
	end 'negative'

	let magTok = try tokens.get(magIndex) otherwise Token.eof()
	if magTok.kind == TokenKind.intLiteral 'intBacking'
		let mag = try parseInt(magTok.value) otherwise 0
		rawValue = mag * sign
		nextOrdinalOut = rawValue + 1
	end 'intBacking' else if magTok.kind == TokenKind.floatLiteral 'floatBacking'
		var bits = 0 as IntConstant
		bits = try parseFloatBits(magTok.value) otherwise 0
		if sign < 0 'negateFloat'
			bits = bits xor (1 shl 63)
		end 'negateFloat'
		rawValue = bits
		isFloat = true
		// Float-backed cases all require explicit values, so the auto-increment
		// counter is irrelevant; leave it unchanged (matches `parseCaseBacking`).
		nextOrdinalOut = nextOrdinal
	end 'floatBacking' else if magTok.kind == TokenKind.stringLiteral 'stringBacking'
		isString = true
	end 'stringBacking' else if magTok.kind == TokenKind.charLiteral 'charBacking'
		isChar = true
	end 'charBacking'
	// else: identifier (struct / function backing) or malformed — keep the
	// running ordinal as the raw value (already seeded above).

	let nextIndex = skipEnumBackingRhs(tokens, startIndex: valueIndex)
	return PrescanEnumBacking.create(rawValue, nextOrdinal: nextOrdinalOut, nextIndex: nextIndex, isFloat: isFloat, isString: isString, isChar: isChar)
end 'scanEnumCaseBacking'

// Token-level enum-case extractor for the pre-parse scan: given the index of an
// `enum` opener token, walk the enum body and return an `UnresolvedEnumType`
// carrying the declaration-ordered cases with their raw values. Mirrors
// `parseEnumDecl` / `parseCaseBacking` but emits no IR and no diagnostics (the
// real parse owns those). Used only as the cross-file / forward-reference
// fallback for `.allCases` / `.allCaseNames`, so a complex enum (methods,
// struct / function backings) need only yield correct names + ordinals here;
// its same-file uses still resolve through the real parse's `unresolvedEnums`
// entry. Best-effort and diagnostic-free, so an already-invalid enum (e.g.
// duplicate cases) is left for the real parse to reject — we do not dedup.
//
// Like `unionBodyIsPayloadBearing`, `depth` tracks open `end`-bearing blocks
// relative to the enum body: depth 1 is the enum body itself (where cases and
// method headers live); depth >= 2 is inside a method body. Control-flow
// keywords (`if` / `while` / `for` / `match` / block-`try`) are legal keyword
// CASE NAMES at depth 1, so they only act as block openers once we are already
// inside a method body (depth >= 2). Closures are always `gives`-form (no
// `end`), so `function` inside a method body never opens a block.
function scanEnumBodyCases(tokens TokenArray, enumStart ElementCount, filePath FilePath) returns UnresolvedEnumType
	let tokenCount = tokens.count()
	let nameTok = try tokens.get(enumStart + 1) otherwise Token.eof()
	let enumName = nameTok.value

	var cases = EnumCaseArray.create()
	var nextOrdinal = 0 as IntConstant
	var isFloatBacked = false
	var isStringBacked = false
	var isCharBacked = false

	// Seed depth 1 (enum body) and start just past `enum <Name>`. Any
	// `implements I1, I2` clause sits on the header line before the first
	// newline; the statement-position gate (prev == newline) excludes those
	// identifiers, so the clause needs no explicit skip.
	var depth = 1 as PrescanDepth
	var i = enumStart + 2
	while i < tokenCount and depth > 0 'scan'
		let tok = try tokens.get(i) otherwise break
		let kind = tok.kind

		if kind == TokenKind.end 'closeBlock'
			if depth > 0 'haveDepth'
				depth = depth - 1
			end 'haveDepth'
			i = i + 1
			continue
		end 'closeBlock'

		// Inside a method body (depth >= 2): only balance `end`-bearing blocks; a
		// case is never declared here.
		if depth > 1 'insideMethod'
			if kind == TokenKind.if or kind == TokenKind.while or kind == TokenKind.for or kind == TokenKind.match 'methodBlockOpener'
				depth = depth + 1
				i = i + 1
				continue
			end 'methodBlockOpener'
			if kind == TokenKind.else 'methodElse'
				depth = depth + 1
				let afterElse = try tokens.get(i + 1) otherwise Token.eof()
				if afterElse.kind == TokenKind.if 'methodElseIf'
					i = i + 2
					continue
				end 'methodElseIf'
				i = i + 1
				continue
			end 'methodElse'
			if kind == TokenKind.try 'methodTry'
				let labelTok = try tokens.get(i + 1) otherwise Token.eof()
				if labelTok.kind == TokenKind.charLiteral 'methodBlockTry'
					depth = depth + 1
				end 'methodBlockTry'
				i = i + 1
				continue
			end 'methodTry'
			i = i + 1
			continue
		end 'insideMethod'

		// depth == 1: enum-body statement level. A case (or method header) appears
		// at statement position — the previous token is a newline (the header's
		// trailing newline for the first case).
		let prev = try tokens.get(i - 1) otherwise Token.eof()
		if prev.kind != TokenKind.newline 'notStatementStart'
			i = i + 1
			continue
		end 'notStatementStart'

		// Compiler directives (`#if` / `#else` / `#endif`) at the enum-body level:
		// skip the directive token. Cases under any branch are still scanned by
		// the surrounding walk — over-including an inactive branch is harmless for
		// a parse-time-only fallback (the real parse owns branch selection).
		if kind == TokenKind.hashIf or kind == TokenKind.hashElse or kind == TokenKind.hashEndif 'directive'
			i = i + 1
			continue
		end 'directive'

		// Method header: `[export] function IDENT (`. Enter its body (depth + 1)
		// so the contents are skipped. A `function` keyword used as a case name is
		// followed by a newline / `=` / end-of-block (never IDENT + `(`) and falls
		// through to the case path below.
		var funcOffset = 0 as ElementCount
		if kind == TokenKind.export 'sawExport'
			funcOffset = 1
		end 'sawExport'
		let funcTok = try tokens.get(i + funcOffset) otherwise Token.eof()
		if funcTok.kind == TokenKind.function 'maybeMethod'
			let mNameTok = try tokens.get(i + funcOffset + 1) otherwise Token.eof()
			let mAfterName = try tokens.get(i + funcOffset + 2) otherwise Token.eof()
			if mNameTok.kind == TokenKind.identifier and mAfterName.kind == TokenKind.leftParen 'isMethod'
				depth = depth + 1
				i = i + funcOffset + 1
				continue
			end 'isMethod'
		end 'maybeMethod'

		// Otherwise this token is a case name (an identifier, or a keyword token
		// used as a case name — the lexer keeps the raw spelling in `.value`).
		let caseName = tok.value
		i = i + 1

		var rawValue = nextOrdinal
		let eqTok = try tokens.get(i) otherwise Token.eof()
		if eqTok.kind == TokenKind.equals 'hasBacking'
			i = i + 1
			let backing = scanEnumCaseBacking(tokens, valueIndex: i, nextOrdinal: nextOrdinal)
			rawValue = backing.rawValue
			nextOrdinal = backing.nextOrdinal
			i = backing.nextIndex
			if backing.isFloat 'float'
				isFloatBacked = true
			end 'float'
			if backing.isString 'string'
				isStringBacked = true
			end 'string'
			if backing.isChar 'char'
				isCharBacked = true
			end 'char'
		end 'hasBacking' else 'noBacking'
			nextOrdinal = nextOrdinal + 1
		end 'noBacking'

		let ordinalSlot = cases.count() as CaseOrdinal
		cases.push(EnumCase.create(caseName, ordinal: ordinalSlot, rawValue: rawValue, line: tok.line, column: tok.column))
	end 'scan'

	// Exported tier: a forward / cross-file `.allCases` is only reachable when
	// the enum is cross-file-visible anyway, and none of the fallback consumers
	// (`enumCasesOrEmpty` / `enumIsFloatBacked` / `prefixIsEnum`) read visibility.
	return UnresolvedEnumType.create(enumName, cases: cases, isFloatBacked: isFloatBacked, visibility: Visibility.global, line: nameTok.line, column: nameTok.column, filePath: filePath, implementedInterfaces: ConformanceArray.create(), isStringBacked: isStringBacked, isCharBacked: isCharBacked)
end 'scanEnumBodyCases'

// Pre-parse throws-clause scan. For every source file, run the parser's
// throws-header prescan so `project.funcThrowsTypes` is seeded for EVERY
// throwing function in the project before any file's body is parsed. The
// per-file `parseModule` already prescans its own file, but that only helps a
// SAME-file forward reference: a `try X() otherwise (e)` whose callee `X` lives
// in a DIFFERENT file is parsed against a `funcThrowsTypes` that may not yet
// (or no longer, after that file's `beginFileParse` rollback) hold X's clause,
// so the `(e)` binding falls back to `integer` and the downstream `match e`
// reports E3005 "match scrutinee must be an enum-typed value". Running the
// prescan across all files up front closes that cross-file gap. Each file's
// entries are recorded under its own parse delta (via `recordFuncThrowsInsert`
// inside the prescan), so incremental re-parse rolls them back correctly.
// Mirrors `preRegisterInterfaceNames`; runs alongside it before the parse loop.
function preRegisterFunctionThrows(project Project) throws CompileError
	for path in project.db.sourcePaths 'eachFile'
		let tokens = try queryTokens(project, path: path)
		var parser = try Parser.create(project, tokens: tokens, filePath: path, rootPath: project.rootPath, namespace: deriveNamespace(path, rootPath: project.rootPath)) otherwise continue
		parser.prescanThrowsHeaders()
	end 'eachFile'
end 'preRegisterFunctionThrows'

// --- Whole-program derived query: all modules merged ---

function queryAllModule(project Project) returns MaxonModule throws CompileError
	let key = QueryKey.allModule
	recordDependency(project, dependency: key)

	// Check cache
	if project.db.allModuleCache.computedAt > 0 'hasCache'
		if areDepsValid(project, key: key, computedAt: project.db.allModuleCache.computedAt) 'valid'
			logDebug(LogCategory.compiler, message: function() gives "queryAllModule cache hit")
			project.db.allModuleHits = project.db.allModuleHits + 1
			project.db.allModuleCache.verifiedAt = project.db.currentRevision
			return project.db.allModuleCache.value
		end 'valid'
	end 'hasCache'

	logDebug(LogCategory.compiler, message: function() gives "queryAllModule computing")
	project.db.allModuleMisses = project.db.allModuleMisses + 1

	// Compute
	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	// Prepend cached stdlib module (shared across all projects). Note that
	// SSA ValueIds no longer exist at this phase — the Maxon IR identifies
	// values by name slices and numbering is assigned later per-function at
	// the Maxon→Std lowering boundary, so there is no global counter to
	// synchronize across cached files.
	let stdlibModule = getStdlibModule(project)
	var allModule = MaxonModule.create()
	allModule.merge(stdlibModule)

	// Phase 6: register every external library this project links (--library=DIR
	// ∪ build.maxon library("...")) AFTER stdlib (so stdlib stays index 0) and
	// BEFORE the user files, then merge each library's (empty — cache-linked)
	// module. With no external libraries this loop is a no-op and the registry
	// stays stdlib-only, preserving Phase-4 byte parity.
	try registerProjectLibraries(project)
	for i in 1 upto registeredLibraryCount() 'eachLib'
		allModule.merge(getLibraryModule(i))
	end 'eachLib'

	// Pre-parse interface-name scan (mirrors maxon-sharp's `PreScan`): register
	// every user interface name across ALL files before any file is parsed, so
	// `internMaxonType` interns a forward-referenced interface use site (an
	// interface declared in a later file, or later in the same file) as
	// `interface(_)` rather than `named(_)`. Runs after `getStdlibModule`
	// (stdlib interfaces already live in `project.interfaces`) and before the
	// user-file parse loop below.
	try preRegisterInterfaceNames(project)

	// Pre-parse throws-clause scan across ALL files (mirrors maxon-sharp's
	// `PreScanFunction`): seed `funcThrowsTypes` for every throwing function so a
	// cross-file `try X() otherwise (e)` recovers the callee's error union at
	// parse time regardless of file order, keeping the `(e)` binding typed (and
	// its `match e` enum-resolvable) instead of falling back to `integer`.
	try preRegisterFunctionThrows(project)

	// Then parse user files
	for path in project.db.sourcePaths 'eachFile'
		let module = try queryParseOps(project, path: path)
		allModule.merge(module)
	end 'eachFile'

	// Drain cross-file overload renames produced by `rekeyExistingFunction`
	// when a late-parsed user file overloaded a sibling file's free function
	// name. The per-file parser only sees its own freshly-parsing module, so it
	// cannot reach the existing overload's IrFunction sitting in another file's
	// already-merged module — the rename was queued in `crossFileOverloadRenames`
	// instead. Apply it now, BEFORE TypeResolution and codegen key off the
	// IrFunction `.name`. Mirrors the stdlib and external-library parse paths,
	// which drain the same way after their own parse loops. Unlike
	// `pendingFuncRenames` (a transient parse-time queue cleared each drain),
	// `crossFileOverloadRenames` persists on the project so an incremental
	// `allModule` rebuild whose triggering file did NOT re-parse the overload
	// declaration still re-applies the rename to the freshly-merged module.
	applyCrossFileOverloadRenames(project, allModule: allModule)

	// G.2: user-code `<TypeName>.fromRawValue(...)` / `.fromName(...)`
	// calls also go through the parser's optimistic rewrite, so a
	// cross-file forward reference (user-defined enum declared in file
	// B referenced by a call in file A) needs the same post-parse
	// validation pass to synthesize the helper / emit E3034 / restore
	// the natural form. Runs after every user file has been parsed and
	// after `getStdlibModule` populated the stdlib enum tables, so
	// `project.enumTypes` / `project.unresolvedEnums` carry both stdlib
	// and user enums by this point.
	validateEnumLookupCalls(project, allModule: allModule)
	// NB: indirect-call sentinel patching (fnTypeId=0) is NOT done here.
	// It moved into `runTypeResolution` (`validateIndirectCallLabels`),
	// which runs after alias resolution so it can see cross-file typealiases
	// the pre-TypeResolution pass at this site could not.

	popQuery(project)

	// Store
	project.db.allModuleCache = MaxonModuleMemo.create(allModule, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)

	return allModule
end 'queryAllModule'

// --- Whole-program derived query: mid-level ops ---
//
// Runs phases 2-4 (Maxon → Std). Returns the optimized StdModule.

function queryAllMid(project Project) returns StdModule throws CompileError
	let key = QueryKey.allMid
	recordDependency(project, dependency: key)

	// Check cache
	// --emit-ir / --dump-stages need every pass to actually run so the printer
	// sees live modules. A cache hit here would silently bypass the pipeline
	// (and therefore the per-pass dump hook), so skip the fast path entirely
	// when IR dumping is requested.
	if project.db.allMidCache.computedAt > 0 and not project.irDump.enabled() 'hasCache'
		if areDepsValid(project, key: key, computedAt: project.db.allMidCache.computedAt) 'valid'
			logDebug(LogCategory.compiler, message: function() gives "queryAllMid cache hit")
			project.db.allMidHits = project.db.allMidHits + 1
			project.db.allMidCache.verifiedAt = project.db.currentRevision
			return project.db.allMidCache.value
		end 'valid'
	end 'hasCache'

	logDebug(LogCategory.compiler, message: function() gives "queryAllMid computing")
	project.db.allMidMisses = project.db.allMidMisses + 1

	// Compute
	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	let maxonModule = try queryAllModule(project)

	// Gate: structural lex/parser/IR errors leave the IR malformed and the
	// downstream passes panic on them, so short-circuit. Pure semantic
	// diagnostics (3xxx) are safe to flow through — running TypeResolution /
	// visibility checks against an otherwise-well-formed module surfaces
	// follow-up semantic errors the user would expect (e.g. cross-file
	// `as HiddenAlias` → E2003 reported alongside its E3062 unused-typealias
	// origin).
	if hasStructuralErrors(project) 'parseErrors'
		popQuery(project)
		throw CompileError.compileError
	end 'parseErrors'

	// Run phases 2-4 through the typed pipeline
	project.globalData = createGlobalDataTable()
	// queryAllModule guarantees at least one source file — it would have
	// thrown upstream if the project were empty, so the first path is always present.
	let firstPath = try project.db.sourcePaths.get(0) otherwise panic("queryAllMid: no source files after queryAllModule")
	let sourceFileName = firstPath.filename()
	var pipeline = PassPipeline.create(maxonModule, project: project, globalData: project.globalData, target: project.target, sourceFileName: sourceFileName, sourcePath: firstPath)
	pipeline.addPasses(buildMidPipeline(project))
	try pipeline.run()
	let result = pipeline.stdModule

	popQuery(project)

	// Store
	project.db.allMidCache = StdModuleMemo.create(result, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)

	return result
end 'queryAllMid'

// --- Whole-program derived query: code emission ---

// Pick between the whole-module driver (`emitBackend`) and the chunk-driven
// driver (`emitBackendIncremental`) for this build. `enableIncremental` is
// the master switch for the per-function cache machinery — on by default
// (Stage P Step 6), but explicit opt-out via `enableIncremental=false` keeps
// the historical whole-module path available for debugging and for tests
// that assert classical query-counter semantics (Scenarios A/C/E). Both
// paths produce byte-identical `code` / `rdata`; the spec-test matrix gates
// that invariant.
function dispatchBackendEmit(midModule StdModule, target Target, globalData GlobalDataTable, project Project, stdlibCache StdlibCacheData) returns CodeResult throws CompileError
	if project.db.enableIncremental 'fastPath'
		return try emitBackendIncremental(midModule, target: target, globalData: globalData, project: project, stdlibCache: stdlibCache)
	end 'fastPath'
	return try emitBackend(midModule, target: target, globalData: globalData, project: project, stdlibCache: stdlibCache)
end 'dispatchBackendEmit'

export function queryCodeResult(project Project) returns CodeResult throws CompileError
	let key = QueryKey.codeResult
	recordDependency(project, dependency: key)

	// Check cache
	// See queryAllMid: skip the cache whenever IR dumping is active so the
	// backend and the post-target-lowering dump observe a fresh compile.
	let ccAt = project.db.codeCache.computedAt
	if ccAt > 0 and not project.irDump.enabled() 'hasCache'
		if areDepsValid(project, key: key, computedAt: ccAt) 'valid'
			logDebug(LogCategory.compiler, message: function() gives "queryCodeResult cache hit")
			project.db.codeHits = project.db.codeHits + 1
			project.db.codeCache.verifiedAt = project.db.currentRevision
			return project.db.codeCache.value
		end 'valid'
	end 'hasCache'

	logDebug(LogCategory.compiler, message: function() gives "queryCodeResult computing")
	project.db.codeMisses = project.db.codeMisses + 1

	// Compute
	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	let midStart = passTimerStart()
	let midModule = try queryAllMid(project)
	recordPassSince("__queryAllMid", startMs: midStart)
	// Gate: semantic errors collected during the mid pipeline (call-
	// visibility violations, unknown callees, …) must short-circuit
	// codegen. Lowering trusts that every call op resolves to a
	// registered function and panics otherwise.
	if hasErrors(project) 'midErrors'
		popQuery(project)
		throw CompileError.compileError
	end 'midErrors'
	var globalData = project.globalData
	let stdlibCache = combinedLibraryCache()

	// Phase 5: install validated persisted user-function chunks into
	// `db.codePerFunc` before the incremental backend runs, so a same-source
	// rebuild in a fresh process reuses each chunk (no re-lower, no regalloc).
	// Runs AFTER queryAllMid (midPerFunc keyHashes + fresh inlineEdges ready)
	// and BEFORE emit; each install is re-validated per-chunk against this
	// build's fresh post-inline state.
	let loadStart = passTimerStart()
	try loadUserChunkCache(project)
	recordPassSince("__loadUserChunkCache", startMs: loadStart)

	// Snapshot the persistable-chunk miss counter so the store can tell whether
	// any USER-owned function was actually (re)compiled this build. A fully-warm
	// rebuild that reused every user chunk produces no new persistable misses
	// (the per-compile `mrt_start` miss doesn't count) → the on-disk file is
	// already current → skip the rewrite entirely (the read-modify-write merge
	// of a large chunk set is pure I/O overhead when nothing changed).
	let missesBefore = project.db.userChunkMisses

	let backendStart = passTimerStart()
	let result = try dispatchBackendEmit(midModule, target: project.target, globalData: globalData, project: project, stdlibCache: stdlibCache)
	recordPassSince("__emitBackend", startMs: backendStart)

	// Phase 5: persist the (possibly grown) user-function chunk cache, merged
	// with whatever is on disk (atomic read-modify-write — concurrent builds
	// don't clobber each other). Skipped when nothing was recompiled.
	let storeStart = passTimerStart()
	try storeUserChunkCache(project, missesBefore: missesBefore)
	recordPassSince("__storeUserChunkCache", startMs: storeStart)

	// Final --dump-stages file for the target-lowering phase. emitBackend runs
	// Phase 7 (lowerMirToTarget, regalloc, prologue/epilogue) outside the
	// PassPipeline dispatcher, so this post-backend write is the only place
	// where the fully-lowered TargetModule is visible. WASM skips target
	// lowering — its last pipeline dump already covers the final MIR.
	dumpTargetLoweringIr(project, result: result)

	popQuery(project)

	// Store
	project.db.codeCache = CodeMemo.create(result, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)

	return result
end 'queryCodeResult'

// --- Phase 11.5: per-function queries ---
//
// These queries cache MIR and emitted code at function granularity. The
// cache key is `(funcName, contentHash)`; a body edit invalidates the
// touched function's entry but leaves callers with a `body` dependency
// edge alone. A signature change invalidates every caller because the
// callee's `paramTypes`/`returnType` change shifts the call ABI.
//
// On first call with `db.enableIncremental == false`, these queries run
// the existing whole-module pipeline once (memoized via queryAllMid /
// queryCodeResult) and extract the requested function from the result.
// That keeps the spine landed and verifiable while the incremental
// pass-pipeline plumbing (runForFunction in PassPipeline) gets fleshed
// out in 11.6+. Output is byte-identical to the whole-module path
// because the per-function chunk extraction is a pure projection over
// the already-emitted CodeResult.
//
// Both code paths must produce identical bytes for the same input —
// that's the guard that lets the incremental path roll out behind a
// flag without breaking spec-test parity.

// Op-content-deep Std-tier content hash of a single function. Pure — does not
// mutate the function or module. Shared by `stampStdContentHash` (the chunk-
// cache key path) and the inliner's `recordInlineEdge` (which captures a
// callee's hash at splice time, before DCE can drop the standalone body). The
// two callers MUST agree byte-for-byte: an inline-dep hash captured here is
// later compared against a callee's stamped `contentHash` in
// `callerInlineDepsUnchanged`, so any divergence would break invalidation.
//
// The hash folds in a STRUCTURAL per-op hash (`mixStdOp`) for every op in
// every block (Step 3.5a), so a body edit that preserves shape (e.g. flipping
// the constant in `return 1` to `return 2`) still produces a distinct
// contentHash. Before this, the hash only covered block count / opRefs count /
// terminator kind / labels — none of which change when a literal value flips,
// so two materially-different functions hashed identically and the
// per-function chunk cache served stale bytes.
//
// The structural hash replaced an earlier fold over `stdOpToString`, which
// pretty-printed every op (one or more String allocations per op, then a
// byte-wise mix of the printed text) — O(total ops) String churn on every
// build, in the always-taken incremental emit path. Hash VALUES therefore
// differ from the printed-form era: any persisted chunk cache invalidates
// once when this lands (acceptable — a one-time cold rebuild, never a stale
// hit). Every in-process caller (the chunk-cache stamp, the inliner's
// `recordInlineEdge`, the stdlib-cache snapshot) shares this one function,
// so in-memory hash consistency is unaffected.
module function computeStdContentHashFor(project Project, module StdModule, func IrFunction) returns ContentHash
	var h = computeFunctionSignatureHash(project, func: func)
	h = mix(h, value: func.varSlotCount)
	h = mix(h, value: func.blockRefs.count())
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("computeStdContentHashFor: blocks.get OOB")
		h = mixString(h, s: block.label)
		h = mix(h, value: block.opRefs.count())
		let termKind = match block.terminator 'tk'
			unset gives 0 as ContentHash
			dead gives 1
			fallthrough gives 2
			opIndex gives 3
		end 'tk'
		h = mix(h, value: termKind)
		// Op-content mixing: fold each op's structural hash in so a
		// literal-value edit (or any other intra-op change) flips the
		// contentHash even when block shape is preserved.
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("computeStdContentHashFor: ops.get OOB at {opIdx}")
			h = mixStdOp(h, op: op)
		end 'eachOp'
		if block.hasTerminatorOp() 'hasTermOp'
			let termOp = try module.ops.get(block.terminatorIndex()) otherwise panic("computeStdContentHashFor: ops.get OOB at terminator {block.terminatorIndex()}")
			h = mixStdOp(h, op: termOp)
		end 'hasTermOp'
	end 'eachBlock'
	return h
end 'computeStdContentHashFor'

// --- Structural StdOp hashing (replaces the stdOpToString fold) ---
//
// Every field the printed form carried is mixed, and then some: fields the
// printer omitted (e.g. `indirectCall`'s isVoid/isThrowing/errorFlagId) are
// hashed too. Extra coverage is safe for a cache key — it can only invalidate
// MORE than the printed form did, never produce a stale hit. A variant tag
// (the union ordinal) is mixed at every union level so same-shaped payloads
// in different variants cannot collide. The matches are exhaustive on
// purpose: adding or reshaping a variant fails loudly here instead of
// silently hashing to a stale value.

// Hash a bool field as a 0/1 scalar.
function mixBool(state ContentHash, value bool) returns ContentHash
	let bit = 1 if value else 0
	return mix(state, value: bit)
end 'mixBool'

// ParsedInt is signed (i64 range) and cannot widen into ContentHash's
// unsigned 0-to-u64.max range, so fold its decimal text — the same bytes the
// old printed form carried, and deterministic across runs.
function mixParsedInt(state ContentHash, value ParsedInt) returns ContentHash
	return mixString(state, s: "{value}")
end 'mixParsedInt'

// Two-to-five scalar mix chains: collapse the deeply-nested `mix(mix(...))`
// calls the per-variant hash arms would otherwise need.
function mix2(state ContentHash, a ContentHash, b ContentHash) returns ContentHash
	return mix(mix(state, value: a), value: b)
end 'mix2'

function mix3(state ContentHash, a ContentHash, b ContentHash, c ContentHash) returns ContentHash
	return mix(mix2(state, a: a, b: b), value: c)
end 'mix3'

function mix4(state ContentHash, a ContentHash, b ContentHash, c ContentHash, d ContentHash) returns ContentHash
	return mix(mix3(state, a: a, b: b, c: c), value: d)
end 'mix4'

function mix5(state ContentHash, a ContentHash, b ContentHash, c ContentHash, d ContentHash, e ContentHash) returns ContentHash
	return mix(mix4(state, a: a, b: b, c: c, d: d), value: e)
end 'mix5'

// Hash a value-id list with a leading count tag so adjacent lists cannot
// alias across field boundaries (e.g. [1,2]+[] vs [1]+[2]).
function mixValueIds(state ContentHash, ids ValueIdArray) returns ContentHash
	var h = mix(state, value: ids.count())
	for id in ids 'each'
		h = mix(h, value: id)
	end 'each'
	return h
end 'mixValueIds'

// Branch arms hash the target BlockId scalar instead of resolving the target
// block's label text (what the old printed form folded in). BlockIds are
// finer-grained than labels — a renumbered-but-identically-labeled block
// flips the hash — which is SAFE for a cache key: it can only invalidate
// more, never produce a stale hit.
function mixBranchArm(state ContentHash, target BlockId, argIds ValueIdArray) returns ContentHash
	return mixValueIds(mix(state, value: target), ids: argIds)
end 'mixBranchArm'

function mixStdOp(state ContentHash, op StdOp) returns ContentHash
	let h = mix(state, value: op.ordinal)
	return match op 'category'
		arith(inner) gives mixStdArithOp(h, op: inner)
		control(inner) gives mixStdControlOp(h, op: inner)
		call(inner) gives mixStdCallOp(h, op: inner)
		memory(inner) gives mixStdMemoryOp(h, op: inner)
		system(inner) gives mixStdSystemOp(h, op: inner)
	end 'category'
end 'mixStdOp'

function mixStdArithOp(state ContentHash, op StdArithOp) returns ContentHash
	let h = mix(state, value: op.ordinal)
	return match op 'variant'
		const(c) gives mixParsedInt(mix2(h, a: c.opcode.ordinal, b: c.resultId), value: c.value)
		unary(u) gives mix3(h, a: u.opcode.ordinal, b: u.resultId, c: u.operandId)
		binary(bin) gives mix4(h, a: bin.opcode.ordinal, b: bin.resultId, c: bin.leftId, d: bin.rightId)
	end 'variant'
end 'mixStdArithOp'

function mixStdControlOp(state ContentHash, op StdControlOp) returns ContentHash
	let h = mix(state, value: op.ordinal)
	return match op 'variant'
		br(target, argIds) gives mixBranchArm(h, target: target, argIds: argIds)
		condBr(condId, thenTarget, thenArgIds, elseTarget, elseArgIds) gives mixBranchArm(mixBranchArm(mix(h, value: condId), target: thenTarget, argIds: thenArgIds), target: elseTarget, argIds: elseArgIds)
	end 'variant'
end 'mixStdControlOp'

function mixStdCallOp(state ContentHash, op StdCallOp) returns ContentHash
	let h = mix(state, value: op.ordinal)
	return match op 'variant'
		ret(retValId) gives mix(h, value: retValId)
		call(resultId, callee, argIds) gives mixValueIds(mixString(mix(h, value: resultId), s: callee), ids: argIds)
		tryCall(resultId, callee, argIds, errorFlagId) gives mix(mixValueIds(mixString(mix(h, value: resultId), s: callee), ids: argIds), value: errorFlagId)
		indirectCall(resultId, calleeId, argIds, isVoid, isThrowing, errorFlagId) gives mix(mixBool(mixBool(mixValueIds(mix2(h, a: resultId, b: calleeId), ids: argIds), value: isVoid), value: isThrowing), value: errorFlagId)
		witnessCall(resultId, witnessAddrId, methodIndex, isVoid, argIds) gives mixValueIds(mixBool(mix3(h, a: resultId, b: witnessAddrId, c: methodIndex), value: isVoid), ids: argIds)
		witnessTryCall(resultId, witnessAddrId, methodIndex, isVoid, argIds, errorFlagId) gives mix(mixValueIds(mixBool(mix3(h, a: resultId, b: witnessAddrId, c: methodIndex), value: isVoid), ids: argIds), value: errorFlagId)
		funcRef(resultId, funcName) gives mixString(mix(h, value: resultId), s: funcName)
		tailCall(callee, argIds) gives mixValueIds(mixString(h, s: callee), ids: argIds)
		param(resultId, paramIndex, paramType) gives mix3(h, a: resultId, b: paramIndex, c: paramType.ordinal)
		errorReturn(retValId, errorFlagId) gives mix2(h, a: retValId, b: errorFlagId)
	end 'variant'
end 'mixStdCallOp'

function mixStdMemoryOp(state ContentHash, op StdMemoryOp) returns ContentHash
	let h = mix(state, value: op.ordinal)
	return match op 'variant'
		storeSlot(slotId, valueId) gives mix2(h, a: slotId, b: valueId)
		loadSlot(resultId, slotId) gives mix2(h, a: resultId, b: slotId)
	end 'variant'
end 'mixStdMemoryOp'

function mixStdSystemOp(state ContentHash, op StdSystemOp) returns ContentHash
	let h = mix(state, value: op.ordinal)
	return match op 'variant'
		globalAddr(resultId, name) gives mixString(mix(h, value: resultId), s: name)
		memcpy(dstId, srcId, lenId) gives mix3(h, a: dstId, b: srcId, c: lenId)
		memzero(dstId, lenId) gives mix2(h, a: dstId, b: lenId)
		stackAddr(resultId, slotId) gives mix2(h, a: resultId, b: slotId)
		storeByte(baseId, offsetId, byteId) gives mix3(h, a: baseId, b: offsetId, c: byteId)
		loadByte(resultId, baseId, offsetId) gives mix3(h, a: resultId, b: baseId, c: offsetId)
		osExit(codeId) gives mix(h, value: codeId)
		osSleep(msId) gives mix(h, value: msId)
		osWrite(ptrId, lenId) gives mix2(h, a: ptrId, b: lenId)
		free(ptrId) gives mix(h, value: ptrId)
		osWriteErr(ptrId, lenId) gives mix2(h, a: ptrId, b: lenId)
		osRead(resultId, ptrId, lenId) gives mix3(h, a: resultId, b: ptrId, c: lenId)
		osOpenWrite(resultId, pathPtrId, pathLenId) gives mix3(h, a: resultId, b: pathPtrId, c: pathLenId)
		osWriteFd(fdId, ptrId, lenId) gives mix3(h, a: fdId, b: ptrId, c: lenId)
		osClose(fdId) gives mix(h, value: fdId)
		osGetEnv(resultId, namePtrId, nameLenId, outBufPtrId, outBufLenId) gives mix5(h, a: resultId, b: namePtrId, c: nameLenId, d: outBufPtrId, e: outBufLenId)
		osGetArgc(resultId) gives mix(h, value: resultId)
		osClockMs(resultId) gives mix(h, value: resultId)
		osClockNanos(resultId) gives mix(h, value: resultId)
		osGetArgv(resultId, indexId) gives mix2(h, a: resultId, b: indexId)
		osGetExecutablePath(resultId, bufPtrId, bufSizeId) gives mix3(h, a: resultId, b: bufPtrId, c: bufSizeId)
		loadFramePtr(resultId) gives mix(h, value: resultId)
		loadIndirect(resultId, addrId, offset, width, signed, isFloat) gives mixBool(mixBool(mix4(h, a: resultId, b: addrId, c: offset, d: width.ordinal), value: signed), value: isFloat)
		funcAddr(resultId, name) gives mixString(mix(h, value: resultId), s: name)
		storeIndirect(addrId, offset, valueId, width, isFloat) gives mixBool(mix4(h, a: addrId, b: offset, c: valueId, d: width.ordinal), value: isFloat)
		drop(valueId) gives mix(h, value: valueId)
		osAllocPages(resultId, sizeId) gives mix2(h, a: resultId, b: sizeId)
		osAllocPagesLarge(resultId, sizeId) gives mix2(h, a: resultId, b: sizeId)
		osFreePages(ptrId, sizeId) gives mix2(h, a: ptrId, b: sizeId)
		osDecommitPages(ptrId, sizeId) gives mix2(h, a: ptrId, b: sizeId)
		osRecommitPages(ptrId, sizeId) gives mix2(h, a: ptrId, b: sizeId)
		osFileOpen(resultId, cStringPtrId, flagsId, fileModeId) gives mix4(h, a: resultId, b: cStringPtrId, c: flagsId, d: fileModeId)
		osFileRead(resultId, fdId, bufPtrId, countId) gives mix4(h, a: resultId, b: fdId, c: bufPtrId, d: countId)
		osFileWrite(resultId, fdId, bufPtrId, countId) gives mix4(h, a: resultId, b: fdId, c: bufPtrId, d: countId)
		osFileClose(resultId, fdId) gives mix2(h, a: resultId, b: fdId)
		osFileLseek(resultId, fdId, offsetId, whenceId) gives mix4(h, a: resultId, b: fdId, c: offsetId, d: whenceId)
		osFileStat(resultId, cStringPtrId, statBufPtrId) gives mix3(h, a: resultId, b: cStringPtrId, c: statBufPtrId)
		osFileAccess(resultId, cStringPtrId, modeId) gives mix3(h, a: resultId, b: cStringPtrId, c: modeId)
		osFileUnlink(resultId, cStringPtrId) gives mix2(h, a: resultId, b: cStringPtrId)
		osFileRename(resultId, oldPathPtrId, newPathPtrId) gives mix3(h, a: resultId, b: oldPathPtrId, c: newPathPtrId)
		osDirGetdents64(resultId, fdId, bufPtrId, bufSizeId) gives mix4(h, a: resultId, b: fdId, c: bufPtrId, d: bufSizeId)
		osDirGetcwd(resultId, bufPtrId, bufSizeId) gives mix3(h, a: resultId, b: bufPtrId, c: bufSizeId)
		osDirMkdir(resultId, cStringPtrId, modeId) gives mix3(h, a: resultId, b: cStringPtrId, c: modeId)
		atomicInc(addrId) gives mix(h, value: addrId)
		atomicDec(addrId) gives mix(h, value: addrId)
		atomicXadd(resultId, addrId, valId) gives mix3(h, a: resultId, b: addrId, c: valId)
		atomicCas(resultId, addrId, oldId, newId) gives mix4(h, a: resultId, b: addrId, c: oldId, d: newId)
		osLockInit(addrId) gives mix(h, value: addrId)
		osLockAcquire(addrId) gives mix(h, value: addrId)
		osLockRelease(addrId) gives mix(h, value: addrId)
		boxValue(resultId, valueId, sizeId) gives mix3(h, a: resultId, b: valueId, c: sizeId)
		unboxValue(resultId, ptrId, sizeId) gives mix3(h, a: resultId, b: ptrId, c: sizeId)
		loadLayoutDescriptor(resultId, label) gives mixString(mix(h, value: resultId), s: label)
		loadWitnessTable(resultId, label) gives mixString(mix(h, value: resultId), s: label)
		descriptorField(resultId, descAddrId, field) gives mix3(h, a: resultId, b: descAddrId, c: field.ordinal)
		witnessMethod(resultId, witnessAddrId, methodIndex) gives mix3(h, a: resultId, b: witnessAddrId, c: methodIndex)
		dropTypeParam(slotValueId, layoutValueId) gives mix2(h, a: slotValueId, b: layoutValueId)
	end 'variant'
end 'mixStdSystemOp'

// Stamp one StdModule function's contentHash with its op-content-deep hash.
// Called lazily from the per-function queries because the Maxon→Std lowerer
// doesn't propagate Maxon-phase block shape to StdModule (post-lowering blocks
// aren't comparable to pre-lowering blocks), so the incremental cache key has
// to be derived from the StdModule's function shape directly — the stamped
// value carries through the rest of the pipeline.
function stampStdContentHash(project Project, module StdModule, funcIdx FuncIndex)
	var func = try module.functions.get(funcIdx) otherwise panic("stampStdContentHash: functions.get OOB at {funcIdx}")
	// Always recompute. Step 3.5a: the Maxon-level
	// `stampFunctionContentHashes` runs before this stamp and writes a
	// shape-only hash onto every function (via `computeFunctionContentHash`),
	// so an `alreadyStamped` shortcut here would leave the shape-only hash
	// in place — letting literal-value edits (which preserve block shape)
	// slip through the chunk cache as false hits. Overwriting with the
	// op-content-deep hash (`computeStdContentHashFor`) is the load-bearing
	// invalidation signal for the per-function chunk cache.
	func.contentHash = computeStdContentHashFor(project, module: module, func: func)
	try module.functions.set(funcIdx, value: func) otherwise panic("stampStdContentHash: functions.set OOB at {funcIdx}")
end 'stampStdContentHash'

// Mix helpers re-exported from IrFunctionContentHash for the StdModule
// stamp path above. Keeping the Maxon-phase variant the canonical entry
// point and reusing the same primitives means a single content-hash
// algorithm governs both phases — invalidation can never disagree
// between Maxon and Std views of the same function.
function mix(state ContentHash, value ContentHash) returns ContentHash
	var s = state xor value
	s = s * 1099511628211 as ContentHash
	return s
end 'mix'

function mixString(state ContentHash, s String) returns ContentHash
	var h = state
	let n = s.byteLength()
	var i = 0
	while i < n 'each'
		let b = try s.managed.byteAt(i) otherwise panic("mixString: byteAt OOB")
		h = mix(h, value: b as ContentHash)
		i = i + 1
	end 'each'
	return mix(h, value: n)
end 'mixString'

// Locate a function by name in the cached whole-module StdModule. Returns
// (-1) if not present — that's a hard error at the caller because
// per-function queries are only valid for functions the whole-module
// pipeline has already emitted.
typealias StdFuncIndexResult = int(0 to u64.max)

function findStdFunctionIndex(module StdModule, name String) returns StdFuncIndexResult
	for i in 0 upto module.functions.count() 'scan'
		let f = try module.functions.get(i) otherwise panic("findStdFunctionIndex: functions.get OOB at {i}")
		if f.name == name 'match'
			return i as StdFuncIndexResult
		end 'match'
	end 'scan'
	return u64.max
end 'findStdFunctionIndex'

// Name → index directory over a module's `functions` array, for callers that
// resolve MANY names against the same module snapshot. The incremental
// backend's per-function precheck does one lookup per MIR function, and
// runtime/stdlib helper names (`mrt_*`, `__slab_*`, `stdlib.*`) are guaranteed
// misses that a `findStdFunctionIndex` probe would scan the ENTIRE array for —
// O(F²) across the precheck (and the same shape recurs for the target-lowered
// function array on a cold, all-miss build). First occurrence wins on
// duplicate names, matching `findStdFunctionIndex`'s front-to-back scan order.
// The directory reflects the array at build time: it stays valid across
// `stampStdContentHash` (in-place `functions.set`, no reorder) but must be
// rebuilt if functions are appended or removed.
module typealias FuncNameToIndexMap = Map with (String, FuncIndex)

// `StdModule.functions` and `TargetModule.functions` are both `IrFunctionArray`,
// so this one builder serves both the mid-module and target-module directories.
module function buildFuncNameToIndex(functions IrFunctionArray) returns FuncNameToIndexMap
	var index = FuncNameToIndexMap.create()
	for i in 0 upto functions.count() 'each'
		let f = try functions.get(i) otherwise panic("buildFuncNameToIndex: functions.get OOB at {i}")
		if not index.contains(f.name) 'firstWins'
			index.upsert(f.name, value: i)
		end 'firstWins'
	end 'each'
	return index
end 'buildFuncNameToIndex'

// Per-function Mid (Std-tier) query.
//
// Cache key: `(funcName, function-content-hash)`. The content hash is
// stamped onto the StdFunction by `stampStdContentHash` after the whole-
// module pipeline lands the function in the project-wide StdModule.
//
// `queryAllMid` is the upstream call; its internal dispatch routes per-
// function-classified Std passes through the singleton-wrap shim in
// `PassPipeline.dispatch`. The projected function is byte-identical to
// what a whole-module pass invocation would produce.
//
// Why the per-function path doesn't bypass `queryAllMid`: the Maxon→Std
// lowering (`lowerMaxonToStd`) is intrinsically whole-module — it
// synthesizes per-enum/per-union helpers post-loop and mints
// monotonically-numbered panic labels across all functions. A pure per-
// function entry into the lowerer would emit divergent helpers and
// reordered panic labels, breaking byte parity. The singleton-wrap
// strategy keeps the lowerer whole-module while still exercising per-
// function entry points for every downstream Std pass.
export function queryMidForFunction(project Project, funcName String) returns IrFunction throws CompileError
	let key = QueryKey.midForFunction(funcName)
	recordDependency(project, dependency: key)

	if let memo = try project.db.midPerFunc.get(funcName) 'checkCache'
		if memo.computedAt > 0 'hasValue'
			if memo.verifiedAt >= project.db.currentRevision 'recent'
				project.db.midPerFuncHits = project.db.midPerFuncHits + 1
				return memo.value
			end 'recent'
			if areDepsValid(project, key: key, computedAt: memo.computedAt) 'valid'
				project.db.midPerFuncHits = project.db.midPerFuncHits + 1
				let verified = MidFuncMemo.create(memo.value, keyHash: memo.keyHash, computedAt: memo.computedAt, verifiedAt: project.db.currentRevision)
				project.db.midPerFunc.upsert(funcName, value: verified)
				return memo.value
			end 'valid'
		end 'hasValue'
	end 'checkCache'

	project.db.midPerFuncMisses = project.db.midPerFuncMisses + 1
	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	let module = try queryAllMid(project)
	let idx = findStdFunctionIndex(module, name: funcName)
	if idx == u64.max as StdFuncIndexResult 'missing'
		popQuery(project)
		throw CompileError.compileError
	end 'missing'
	stampStdContentHash(project, module: module, funcIdx: idx)
	let func = try module.functions.get(idx) otherwise panic("queryMidForFunction: functions.get OOB at {idx}")

	popQuery(project)

	let memo = MidFuncMemo.create(func, keyHash: func.contentHash, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)
	project.db.midPerFunc.upsert(funcName, value: memo)
	return func
end 'queryMidForFunction'

// MIR pass version. Bumped manually whenever any MIR-tier pass body
// (`lowerStdToMir`, `commuteForCoalescing`, `scheduleInstructions`) changes
// in a way that affects per-function output bytes. The version mixes into
// the cache key so a manual bump invalidates every cached MIR function in
// one shot. Mirrors the `CACHE_FORMAT_VERSION` pattern in `StdlibCache.maxon`.
//
// Bump on every MIR-pass edit that could change per-function output. The
// on-disk cache shape is unaffected (this is purely a runtime cache-key
// salt), so this does NOT require a `CACHE_FORMAT_VERSION` bump.
let mirPassVersion = 1 as ContentHash

// Per-function MIR query.
//
// Cache key: `(funcName, stdFunctionContentHash, mirPassVersion)`. The Std
// content hash comes from `queryMidForFunction`; mixing the MIR-pass version
// in means a MIR-tier code edit invalidates every cached MIR function
// without forcing a Std re-stamp.
//
// Upstream call is `queryCodeResult` — its pipeline runs Std→MIR lowering
// and the MIR-tier passes through the per-function dispatch shims in
// `PassPipeline.dispatch`, then this query projects the named function out
// of the resulting `MirModule`.
function queryMirForFunction(project Project, funcName String) returns IrFunction throws CompileError
	let key = QueryKey.mirForFunction(funcName)
	recordDependency(project, dependency: key)

	if let memo = try project.db.mirPerFunc.get(funcName) 'checkCache'
		if memo.computedAt > 0 'hasValue'
			if memo.verifiedAt >= project.db.currentRevision 'recent'
				project.db.mirPerFuncHits = project.db.mirPerFuncHits + 1
				return memo.value
			end 'recent'
			if areDepsValid(project, key: key, computedAt: memo.computedAt) 'valid'
				project.db.mirPerFuncHits = project.db.mirPerFuncHits + 1
				let verified = MirFuncMemo.create(memo.value, keyHash: memo.keyHash, computedAt: memo.computedAt, verifiedAt: project.db.currentRevision)
				project.db.mirPerFunc.upsert(funcName, value: verified)
				return memo.value
			end 'valid'
		end 'hasValue'
	end 'checkCache'

	project.db.mirPerFuncMisses = project.db.mirPerFuncMisses + 1
	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	// Trigger the full code path so we can pick the function out of the
	// MIR module the backend produced. CodeResult holds the post-MIR
	// module; the per-function query simply projects the named function
	// out of it. The upstream `queryCodeResult` path runs the MIR-tier
	// passes through per-function entry shims in
	// `Compiler/IR/PassPipeline.maxon`.
	let result = try queryCodeResult(project)
	let mirModule = result.mirModule
	var foundIdx = u64.max as StdFuncIndexResult
	for i in 0 upto mirModule.functions.count() 'scan'
		let f = try mirModule.functions.get(i) otherwise panic("queryMirForFunction: mirModule.functions.get OOB at {i}")
		if f.name == funcName 'match'
			foundIdx = i as StdFuncIndexResult
			break
		end 'match'
	end 'scan'
	if foundIdx == u64.max 'missing'
		popQuery(project)
		throw CompileError.compileError
	end 'missing'
	let func = try mirModule.functions.get(foundIdx) otherwise panic("queryMirForFunction: functions.get OOB")

	popQuery(project)

	// Mix `mirPassVersion` into the stored key hash so a MIR-pass edit
	// invalidates cached MIR memos even when the upstream Std contentHash
	// has not changed. The mix uses the same FNV-1a-style step as
	// `stampStdContentHash` for consistency.
	let keyHash = mix(func.contentHash, value: mirPassVersion)
	let memo = MirFuncMemo.create(func, keyHash: keyHash, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)
	project.db.mirPerFunc.upsert(funcName, value: memo)
	return func
end 'queryMirForFunction'

// Backend version. Bumped manually whenever a backend emit, register
// allocator, prologue/epilogue inserter, or stdlib link step changes in a
// way that affects per-function output bytes. The version mixes into the
// cache key so a manual bump invalidates every cached FunctionCodeChunk
// in one shot. Mirrors `mirPassVersion` above.
//
// The current value is `2` — bumped at Stage P Step 8 (tier-flag removal)
// to invalidate any in-memory chunks stamped before the tier-aware emit
// path was deleted. The new code path is structurally simpler and the
// version bump guarantees a clean cache-line on the first build after the
// cleanup lands. On-disk cache shape is unaffected (this is a runtime
// cache-key salt), so this does NOT require a `CACHE_FORMAT_VERSION` bump.
let backendVersion = 2 as ContentHash

// Shared keyHash computation for `CodeChunkMemo` entries. Both the lazy
// stamp inside `queryCodeForFunction` and the eager stamp inside the
// whole-module emit must produce the exact same hash — otherwise a chunk
// written by one caller would look invalid to the other. The mix sequence
// folds in the upstream MidFuncMemo keyHash (or 0 when the mid memo hasn't
// been stamped yet — cold compile before any per-function queries fired),
// then mirPassVersion, then backendVersion.
module function computeChunkKeyHash(project Project, funcName String) returns ContentHash
	var keyHash = 0 as ContentHash
	if let m = try project.db.midPerFunc.get(funcName) 'mid'
		keyHash = m.keyHash
	end 'mid'
	keyHash = mix(keyHash, value: mirPassVersion)
	keyHash = mix(keyHash, value: backendVersion)
	return keyHash
end 'computeChunkKeyHash'

// Stage P Step 3: signal for "no valid cached chunk for this function". The
// caller that pre-checks the per-function cache (either `queryCodeForFunction`
// on a projection-path miss, or `emitBackendIncrementalWith` on a chunk-
// driven-path miss) consumes this via `try ... otherwise` and falls through
// to its own recompute path. Keeping the miss signal as a throw lets both
// call sites share the lookup-and-validate logic without out-parameters or
// tuple unpacking.
module union ChunkCacheLookupError implements Error
	miss
end 'ChunkCacheLookupError'

// Step 3.5a: content-hash-driven chunk lookup. The chunk-driven path in
// `emitBackendIncrementalWith` calls this with a freshly-computed `freshKeyHash`
// (read off the just-rebuilt `midPerFunc[funcName]` keyHash plus the
// mir/backend version salts). A function whose source body changed flips its
// per-function content hash, which flips `freshKeyHash`, which forces a miss
// here even when the stored memo's `verifiedAt` is still ahead of the prior
// `computedAt`. Unedited functions reuse their cached chunk because their
// content hash is stable across the revision bump.
//
// This bypasses the dep-graph validation entirely: the chunk-driven path
// can't rely on `depIndex["cf:funcName"]` because the direct-emit miss tail
// never invokes other tracked queries, so the dep bucket would always be
// empty and `areDepsValid` would unconditionally return true (the Step 3.5a
// bug Step 4 caught: 100 stale hits, edited bytes never re-emitted).
module function lookupCachedChunkByKeyHash(project Project, funcName String, freshKeyHash ContentHash) returns FunctionCodeChunk throws ChunkCacheLookupError
	if let memo = try project.db.codePerFunc.get(funcName) 'checkCache'
		if memo.computedAt > 0 'hasValue'
			if memo.keyHash == freshKeyHash 'keyMatch'
				project.db.codePerFuncHits = project.db.codePerFuncHits + 1
				let verified = CodeChunkMemo.create(memo.value, keyHash: memo.keyHash, computedAt: memo.computedAt, verifiedAt: project.db.currentRevision)
				project.db.codePerFunc.upsert(funcName, value: verified)
				return memo.value
			end 'keyMatch'
		end 'hasValue'
	end 'checkCache'
	throw ChunkCacheLookupError.miss
end 'lookupCachedChunkByKeyHash'

// Stamp a freshly-emitted `FunctionCodeChunk` into `codePerFunc`. Shared by
// the two code paths that recompute a chunk (whole-module emit's per-function
// stamp loop and `emitBackendIncrementalWith`'s direct-emit miss tail) so the
// memo shape stays in lockstep across both writers.
module function stampChunkMemo(project Project, funcName String, chunk FunctionCodeChunk)
	let keyHash = computeChunkKeyHash(project, funcName: funcName)
	let memo = CodeChunkMemo.create(chunk, keyHash: keyHash, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)
	project.db.codePerFunc.upsert(funcName, value: memo)
end 'stampChunkMemo'

// Step 3.5a: refresh `midPerFunc[funcName].keyHash` from the *current*
// `queryAllMid` StdModule so the chunk-driven validator (which reads
// `midPerFunc[funcName].keyHash` through `computeChunkKeyHash`) sees the
// post-edit content hash. Idempotent — multiple calls in the same revision
// converge on the same hash, and the no-op tail when the function isn't
// in queryAllMid's module covers the runtime/stdlib case (those helpers
// carry a stable zero-mid keyHash by design).
//
// Why this exists alongside `queryMidForFunction`: the wrapper short-
// circuits on the `areDepsValid(mid:funcName)` arm once `queryCodeResult`
// has refreshed the upstream `allMid` dep, which keeps the prior
// revision's keyHash on the memo and hides function-level content edits.
// The chunk-driven path needs per-function granularity inside a single
// revision, so it bypasses the wrapper's `verifiedAt`/dep arms entirely
// and writes the freshly-computed hash straight into the memo.
// The `module` and `funcIndex` parameters are the precheck loop's shared
// snapshot (`currentAllMidModule` + `buildFuncNameToIndex`), resolved ONCE
// per emit instead of once per function — a per-call `findStdFunctionIndex`
// scan (a guaranteed full-array miss for runtime/stdlib helper names) made
// the precheck O(functions²). A map miss is the exact no-op tail the old
// sentinel-index path took.
module function refreshMidContentHashForFunction(project Project, funcName String, module StdModule, funcIndex FuncNameToIndexMap)
	if let idx = try funcIndex.get(funcName) 'inModule'
		stampStdContentHash(project, module: module, funcIdx: idx)
		let func = try module.functions.get(idx) otherwise panic("refreshMidContentHashForFunction: functions.get OOB at {idx}")
		let memo = MidFuncMemo.create(func, keyHash: func.contentHash, computedAt: project.db.currentRevision, verifiedAt: project.db.currentRevision)
		project.db.midPerFunc.upsert(funcName, value: memo)
	end 'inModule'
end 'refreshMidContentHashForFunction'

// The StdModule the incremental precheck hashes against: reuse the already-
// computed mid module from `allMidCache` rather than re-invoking
// `queryAllMid`. By the time the incremental backend's precheck runs,
// `queryCodeResult` -> `queryAllMid` has already run once and populated the
// cache (the memo is stored unconditionally, even under --emit-ir /
// --dump-stages). Re-running `queryAllMid` would be another full mid-pipeline
// run; worse, under IR-dump (which bypasses the allMid cache) it would re-run
// the pipeline over the SAME merged module the first run already mutated in
// place (TypeResolution rewrites ops + expands the ABI param vector; DCE
// prunes blockRefs), so the re-run walks pruned blockRefs and panics
// ("blockRef OOB"). Reading the cached result sidesteps both: one
// computation, no re-mutation. Fall back to `queryAllMid` only if the cache
// isn't populated yet (defensive — shouldn't happen on this path).
module function currentAllMidModule(project Project) returns StdModule throws CompileError
	if project.db.allMidCache.computedAt > 0 'haveCache'
		return project.db.allMidCache.value
	end 'haveCache'
	return try queryAllMid(project)
end 'currentAllMidModule'

// Capture the inline-dependency fingerprint for `callerName` from the current
// build: the callees the inliner spliced into it, each paired with the content
// hash its body had at splice time. This is a direct read of
// `project.inlineEdges` (the inliner already captured each callee's hash at the
// splice, before `dceFunctions` could drop the standalone body — see
// `recordInlineEdge`). A persistent chunk cache stores the returned array
// alongside the caller's chunk; on a later build it captures the fingerprint
// again and compares via `callerInlineDepsUnchanged`. Returns an empty array
// when the caller had nothing inlined into it.
export function captureInlineDeps(project Project, callerName String) returns InlineDepArray
	return try project.inlineEdges.get(callerName) otherwise InlineDepArray.create()
end 'captureInlineDeps'

// Inline-aware validity predicate for a persistent (or warm) caller chunk.
// `stored` is the inline-dependency fingerprint captured when the chunk was
// stamped (a prior build); `fresh` is the fingerprint of the current build
// (`captureInlineDeps` after the inliner re-ran). The caller's chunk is
// inline-valid iff the two fingerprints are identical — same callees, same
// order, same body hashes. Any difference (a callee's body changed, a callee
// is no longer inlined, or a new callee got inlined) means the caller's inlined
// copy diverged and its chunk must be recomputed.
//
// A persistent chunk loaded from disk is safe to reuse only when BOTH its own
// keyHash matches (caller body unchanged) AND this returns true. The in-memory
// path gets the latter for free via the post-inline deep-op hash; this is the
// hook the on-disk cache depends on. Pure — no side effects.
export function callerInlineDepsUnchanged(stored InlineDepArray, fresh InlineDepArray) returns bool
	if stored.count() != fresh.count() 'countDiff'
		return false
	end 'countDiff'
	for (iter, dep) in stored.withIterator() 'each'
		let other = try fresh.get(iter.index()) otherwise panic("callerInlineDepsUnchanged: fresh.get OOB at {iter.index()} (counts matched)")
		if dep.calleeName != other.calleeName 'nameDiff'
			return false
		end 'nameDiff'
		if dep.calleeHash != other.calleeHash 'hashDiff'
			return false
		end 'hashDiff'
	end 'each'
	return true
end 'callerInlineDepsUnchanged'

function dumpTargetLoweringIr(project Project, result CodeResult)
	if not project.irDump.stagesEnabled() 'disabled'
		return
	end 'disabled'
	// WASM skips target lowering — its last pipeline dump already covers the
	// final MIR, so there's nothing new to emit here.
	if project.target.cpu == CpuArch.wasm32 'noTarget'
		return
	end 'noTarget'
	// `--dump-stages=NAMES` selection — claim the number, skip the render
	// (mirrors `dumpPassIr`).
	if not project.irDump.stageWanted("target-lowering") 'filtered'
		claimStageNumber(project)
		return
	end 'filtered'

	// Honor the same stdlib filter as the per-pass stage dumps: default to
	// the user program only, include stdlib only under `--dump-stages-stdlib`.
	let skipStdlib = project.irDump.renderSkipsStdlib()
	let content = targetModuleToString(result.targetModule, skipStdlib: skipStdlib, cpu: project.target.cpu)
	writeStageDumpFile(project, label: "target-lowering", phase: PipelinePhase.target, content: content)
end 'dumpTargetLoweringIr'
