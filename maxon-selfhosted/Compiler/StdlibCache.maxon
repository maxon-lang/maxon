	let fieldRaw = try readDword(buf, offset: offset + 16) otherwise throw CacheCorruption.invalidEncoding
	let field = try DescriptorField.allCases.get(fieldRaw) otherwise throw CacheCorruption.invalidEncoding
	return (StdSystemOp.descriptorField(resultId, descAddrId: descAddrId, field: field), offset + 20)
end 'readStdSysDescriptorField'

