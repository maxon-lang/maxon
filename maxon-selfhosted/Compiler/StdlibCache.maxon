function readStdSysOsGetEnv(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let resultId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let namePtrId = try readQword(buf, offset: offset + 8) otherwise throw CacheCorruption.invalidEncoding
	let nameLenId = try readQword(buf, offset: offset + 16) otherwise throw CacheCorruption.invalidEncoding
	let outBufPtrId = try readQword(buf, offset: offset + 24) otherwise throw CacheCorruption.invalidEncoding
	let outBufLenId = try readQword(buf, offset: offset + 32) otherwise throw CacheCorruption.invalidEncoding
	return (StdSystemOp.osGetEnv(resultId, namePtrId: namePtrId, nameLenId: nameLenId, outBufPtrId: outBufPtrId, outBufLenId: outBufLenId), offset + 40)
end 'readStdSysOsGetEnv'

