function readStdSystemOp(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let raw = try readDword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let kase = try StdSystemOp.unionCases.fromRawValue(raw) otherwise throw CacheCorruption.invalidEncoding
	let pos = offset + 4
	return match kase 'sys'
		globalAddr gives try readStdSysGlobalAddr(buf, offset: pos)
		memcpy gives try readStdSysMemcpy(buf, offset: pos)
		stackAddr gives try readStdSysStackAddr(buf, offset: pos)
		storeByte gives try readStdSysStoreByte(buf, offset: pos)
		loadByte gives try readStdSysLoadByte(buf, offset: pos)
		osExit gives try readStdSysOsExit(buf, offset: pos)
		osSleep gives try readStdSysOsSleep(buf, offset: pos)
		osWrite gives try readStdSysOsWrite(buf, offset: pos)
		free gives try readStdSysFree(buf, offset: pos)
		osWriteErr gives try readStdSysOsWriteErr(buf, offset: pos)
		osRead gives try readStdSysOsRead(buf, offset: pos)
		osOpenWrite gives try readStdSysOsOpenWrite(buf, offset: pos)
		osWriteFd gives try readStdSysOsWriteFd(buf, offset: pos)
		osClose gives try readStdSysOsClose(buf, offset: pos)
		osGetEnv gives try readStdSysOsGetEnv(buf, offset: pos)
		osGetArgc gives try readStdSysOsGetArgc(buf, offset: pos)
		osClockMs gives try readStdSysOsClockMs(buf, offset: pos)
		osGetArgv gives try readStdSysOsGetArgv(buf, offset: pos)
		osGetExecutablePath gives try readStdSysOsGetExecutablePath(buf, offset: pos)
		loadFramePtr gives try readStdSysLoadFramePtr(buf, offset: pos)
		loadIndirect gives try readStdSysLoadIndirect(buf, offset: pos)
		funcAddr gives try readStdSysFuncAddr(buf, offset: pos)
		storeIndirect gives try readStdSysStoreIndirect(buf, offset: pos)
		drop gives try readStdSysDrop(buf, offset: pos)
		osAllocPages gives try readStdSysOsAllocPages(buf, offset: pos)
		osAllocPagesLarge gives try readStdSysOsAllocPagesLarge(buf, offset: pos)
		osFreePages gives try readStdSysOsFreePages(buf, offset: pos)
		osDecommitPages gives try readStdSysOsDecommitPages(buf, offset: pos)
		osRecommitPages gives try readStdSysOsRecommitPages(buf, offset: pos)
		osFileOpen gives try readStdSysOsFileOpen(buf, offset: pos)
		osFileRead gives try readStdSysOsFileRead(buf, offset: pos)
		osFileWrite gives try readStdSysOsFileWrite(buf, offset: pos)
		osFileClose gives try readStdSysOsFileClose(buf, offset: pos)
		osFileLseek gives try readStdSysOsFileLseek(buf, offset: pos)
		osFileStat gives try readStdSysOsFileStat(buf, offset: pos)
		osFileAccess gives try readStdSysOsFileAccess(buf, offset: pos)
		osFileUnlink gives try readStdSysOsFileUnlink(buf, offset: pos)
		osFileRename gives try readStdSysOsFileRename(buf, offset: pos)
		osDirGetdents64 gives try readStdSysOsDirGetdents64(buf, offset: pos)
		osDirGetcwd gives try readStdSysOsDirGetcwd(buf, offset: pos)
		osDirMkdir gives try readStdSysOsDirMkdir(buf, offset: pos)
		atomicInc gives try readStdSysAtomicInc(buf, offset: pos)
		atomicDec gives try readStdSysAtomicDec(buf, offset: pos)
		atomicXadd gives try readStdSysAtomicXadd(buf, offset: pos)
		atomicCas gives try readStdSysAtomicCas(buf, offset: pos)
		osLockInit gives try readStdSysOsLockInit(buf, offset: pos)
		osLockAcquire gives try readStdSysOsLockAcquire(buf, offset: pos)
		osLockRelease gives try readStdSysOsLockRelease(buf, offset: pos)
		boxValue gives try readStdSysBoxValue(buf, offset: pos)
		unboxValue gives try readStdSysUnboxValue(buf, offset: pos)
		loadLayoutDescriptor gives try readStdSysLoadLayoutDescriptor(buf, offset: pos)
		loadWitnessTable gives try readStdSysLoadWitnessTable(buf, offset: pos)
		descriptorField gives try readStdSysDescriptorField(buf, offset: pos)
		witnessMethod gives try readStdSysWitnessMethod(buf, offset: pos)
		dropTypeParam gives try readStdSysDropTypeParam(buf, offset: pos)
	end 'sys'
end 'readStdSystemOp'

function readStdSysGlobalAddr(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let resultId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let (name, p) = try readString(buf, offset: offset + 8)
	return (StdSystemOp.globalAddr(resultId, name: name), p)
end 'readStdSysGlobalAddr'

function readStdSysMemcpy(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let dstId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let srcId = try readQword(buf, offset: offset + 8) otherwise throw CacheCorruption.invalidEncoding
	let lenId = try readQword(buf, offset: offset + 16) otherwise throw CacheCorruption.invalidEncoding
	return (StdSystemOp.memcpy(dstId, srcId: srcId, lenId: lenId), offset + 24)
end 'readStdSysMemcpy'

function readStdSysStackAddr(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let resultId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
