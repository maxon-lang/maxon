	let baseId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let offsetId = try readQword(buf, offset: offset + 8) otherwise throw CacheCorruption.invalidEncoding
	let byteId = try readQword(buf, offset: offset + 16) otherwise throw CacheCorruption.invalidEncoding
	return (StdSystemOp.storeByte(baseId, offsetId: offsetId, byteId: byteId), offset + 24)
end 'readStdSysStoreByte'

