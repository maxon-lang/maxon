	let resultId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let bufPtrId = try readQword(buf, offset: offset + 8) otherwise throw CacheCorruption.invalidEncoding
	let bufSizeId = try readQword(buf, offset: offset + 16) otherwise throw CacheCorruption.invalidEncoding
	return (StdSystemOp.osGetExecutablePath(resultId, bufPtrId: bufPtrId, bufSizeId: bufSizeId), offset + 24)
end 'readStdSysOsGetExecutablePath'

function readStdSysLoadFramePtr(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let resultId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	return (StdSystemOp.loadFramePtr(resultId), offset + 8)
end 'readStdSysLoadFramePtr'

function readStdSysLoadIndirect(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let resultId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let addrId = try readQword(buf, offset: offset + 8) otherwise throw CacheCorruption.invalidEncoding
	let off = try readQword(buf, offset: offset + 16) otherwise throw CacheCorruption.invalidEncoding
	let (width, posAfterWidth) = try readStoreWidthTag(buf, offset: offset + 24)
	let (signed, posAfterSigned) = try readBoolByte(buf, offset: posAfterWidth)
	let (isFloat, p) = try readBoolByte(buf, offset: posAfterSigned)
	return (StdSystemOp.loadIndirect(resultId, addrId: addrId, offset: off, width: width, signed: signed, isFloat: isFloat), p)
end 'readStdSysLoadIndirect'

function readStdSysFuncAddr(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let resultId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let (name, p) = try readString(buf, offset: offset + 8)
	return (StdSystemOp.funcAddr(resultId, name: name), p)
end 'readStdSysFuncAddr'

function readStdSysStoreIndirect(buf ByteArray, offset ByteOffset) returns (StdSystemOp, ByteOffset) throws CacheCorruption
	let addrId = try readQword(buf, offset: offset) otherwise throw CacheCorruption.invalidEncoding
	let off = try readQword(buf, offset: offset + 8) otherwise throw CacheCorruption.invalidEncoding
	let valueId = try readQword(buf, offset: offset + 16) otherwise throw CacheCorruption.invalidEncoding
	let (width, posAfterWidth) = try readStoreWidthTag(buf, offset: offset + 24)
	let (isFloat, p) = try readBoolByte(buf, offset: posAfterWidth)
	return (StdSystemOp.storeIndirect(addrId, offset: off, valueId: valueId, width: width, isFloat: isFloat), p)
end 'readStdSysStoreIndirect'

