// ABI Lowering Pass — Phase 5.
// Rewrites function signatures and call sites to respect calling conventions.
// Currently an identity pass with full infrastructure in place.
// Walks module -> functions -> blocks -> ops.
// Records call site info and classifies parameters by ABI convention.

// -- ABI infrastructure types --

// How a parameter is passed at the ABI level.
union ABIParamClass
	register
	stack
	indirect
end 'ABIParamClass'

// Supported calling conventions.
union ABIConvention
	windowsX64
	sysVAmd64
	aapcs64
	wasmABI
end 'ABIConvention'

// Recorded info about a call site.
type ABICallInfo
	export let callee as String
	export let argCount as VarSlot
	export let hasReturn as bool

	export static function create(callee String, argCount VarSlot, hasReturn bool) returns ABICallInfo
		return Self{callee: callee, argCount: argCount, hasReturn: hasReturn}
	end 'create'
end 'ABICallInfo'

export typealias ABICallInfoArray = Array with ABICallInfo

// -- ABI helper functions --

// Map a compilation target to its calling convention.
function getABIConvention(target Target) returns ABIConvention
	return match target.cpu 'cpuMatch'
		x64 gives getX86Convention(target)
		arm64 gives ABIConvention.aapcs64
		wasm32 gives ABIConvention.wasmABI
	end 'cpuMatch'
end 'getABIConvention'

function getX86Convention(target Target) returns ABIConvention
	return match target.os 'osMatch'
		windows gives ABIConvention.windowsX64
		linux gives ABIConvention.sysVAmd64
		macos gives ABIConvention.sysVAmd64
		wasi gives ABIConvention.sysVAmd64
	end 'osMatch'
end 'getX86Convention'

// Classify how a parameter is passed based on its index, type, and convention.
// windowsX64: first 4 integer params in RCX, RDX, R8, R9; rest on stack
// sysVAmd64: first 6 integer params in RDI, RSI, RDX, RCX, R8, R9; rest on stack
// aapcs64: first 8 integer params in X0-X7; rest on stack
//
// C1.c note: interface fat-pointer params occupy two consecutive integer-
// class register slots (`{value, witness}`). At Std-IR level the lowering
// emits the callee's two ValueIds in adjacent param positions, so the
// existing per-index classifier here already produces the right answer —
// each half of the pair is classified as an ordinary i64. End-to-end
// fat-pointer parameter passing requires upstream changes (param-index
// expansion in `LowerMaxonToStd.transferFuncs`) that C1.c defers because
// no parser-emitted interface(_) MaxonType reaches lowering today.
// Similarly, fat returns are deferred until a multi-register `ret` op
// shape is wired through the dialect; today's `ret` carries a single
// ValueId and an interface-typed return is structurally absent.
function classifyParam(paramIndex VarSlot, convention ABIConvention) returns ABIParamClass
	let regLimit = match convention 'limit'
		windowsX64 gives 4
		sysVAmd64 gives 6
		aapcs64 gives 8
		wasmABI gives 1000  // all params pass as locals, no stack spilling
	end 'limit'

	if paramIndex < regLimit 'fitsInReg'
		return ABIParamClass.register
	end 'fitsInReg'
	return ABIParamClass.stack
end 'classifyParam'

// -- Main pass --

export function lowerABI(module StdModule, target Target) returns StdModule
	let convention = getABIConvention(target)

	for func in module.functions 'eachFunc'
		for blockRef in func.blockRefs 'eachBlock'
			var block = try module.blocks.get(blockRef) otherwise panic("Block not found in module")

			let oldOps = block.opRefs
			block.opRefs = OpIndexList.create()
			for packed in oldOps 'eachOp'
				processOp(module, opIdx: packed, dstBlock: block, convention: convention)
			end 'eachOp'
			// Terminators pass through unchanged
		end 'eachBlock'
	end 'eachFunc'

	return module
end 'lowerABI'

// -- Per-op processing --

// Dispatch an op. lowerABI is a pure identity pass today (it only classifies
// params for diagnostic logging — see processCall/processParam — and rewrites
// nothing), so EVERY op is preserved by re-referencing its existing slot via
// `dstBlock.opRefs.append(opIdx)`. Re-emitting an unchanged op through
// `module.appendOp` instead would append a byte-identical duplicate and leave
// the original as an orphan in the shared, append-only `module.ops`; over a
// call-dense program (the self-hosted compiler's own source) that orphans
// roughly every call/param/ret op and is a primary driver of the self-compile
// memory blowup. When ABI rewriting actually changes an op, that arm must
// append the rewritten op (and drop the reuse) at that point.
function processOp(module StdModule, opIdx OpIndex, dstBlock IrBlock, convention ABIConvention)
	let stdOp = try module.ops.get(opIdx) otherwise panic("invariant: opIdx not in module.ops")
	match stdOp 'outer'
		call(funcOp) then classifyCallOp(funcOp, convention: convention)
		arith to control then break 'outer'
		memory to system then break 'outer'
	end 'outer'
	dstBlock.opRefs.append(opIdx)
end 'processOp'

// Emit the diagnostic classification side-effects for a std.call dialect op.
// Records nothing into the IR — the op is preserved in-place by processOp.
function classifyCallOp(funcOp StdCallOp, convention ABIConvention)
	match funcOp 'classify'
		call(_, callee, argIds) then classifyCall(callee, argIds: argIds, convention: convention)
		param(_, paramIndex, paramType) then classifyParamOp(paramIndex, paramType: paramType, convention: convention)
		ret then break 'classify'
		tryCall to tailCall then break 'classify'
		errorReturn then break 'classify'
	end 'classify'
end 'classifyCallOp'

// Classify a std.call's args for ABI diagnostics (no IR mutation).
function classifyCall(callee String, argIds ValueIdArray, convention ABIConvention)
	let callInfo = ABICallInfo.create(callee, argCount: argIds.count(), hasReturn: true)
	logTrace(LogCategory.ir, message: function() gives "abi: call @{callInfo.callee} args={callInfo.argCount} hasReturn={callInfo.hasReturn}")

	var i = 0
	while i < argIds.count() 'classifyArgs'
		let paramClass = classifyParam(i, convention: convention)
		logTrace(LogCategory.ir, message: function() gives "abi:   arg {i} -> {paramClassToString(paramClass)}")
		i = i + 1
	end 'classifyArgs'
end 'classifyCall'

// Classify a std.param for ABI diagnostics (no IR mutation).
function classifyParamOp(paramIndex VarSlot, paramType StdType, convention ABIConvention)
	let paramClass = classifyParam(paramIndex, convention: convention)
	logTrace(LogCategory.ir, message: function() gives "abi: param {paramIndex} : {paramType.name} -> {paramClassToString(paramClass)}")
end 'classifyParamOp'

// -- Formatting helpers --

function paramClassToString(pc ABIParamClass) returns String
	return match pc 'str'
		register gives "register"
		stack gives "stack"
		indirect gives "indirect"
	end 'str'
end 'paramClassToString'
