// Maxon-tier Borrow Check Pass — NLL-style borrow analysis (E3070).
//
// Pure analysis pass: reports errors via `reportCompileError` but does NOT
// modify the module. Runs at the Maxon phase (after TypeResolution, before
// lowering) so every op carries source-level names, line/column ranges, and
// resolved receiver types — the layer the C# bootstrap's BorrowCheckPass
// operates on.
//
// It detects the dangling-reference hazard: obtaining a reference into a
// collection's backing buffer (`let s = try arr.get(0) ...`) and then mutating
// that collection (`arr.push(...)`). A growth could reallocate the buffer and
// dangle the outstanding reference. The check uses non-lexical lifetimes: the
// borrow expires at the borrowing variable's last use, so using the reference
// and then mutating the source is allowed.
//
// Ported from maxon-sharp/Compiler/MLIR/Passes/BorrowCheckPass.cs. The C# pass
// works over MaxonAssignOp/MaxonCallOp with variable names; the self-hosted
// Maxon IR is slot-addressed (varLoad/varDecl carry a VarSlot, method calls
// carry SSA value names), so this port adds two reverse maps:
//   - ssaToSlot: an SSA value name (a method-call receiver) -> the VarSlot it
//     loaded from, built by scanning `varLoad` ops.
//   - slotToVarInfo: a VarSlot -> the source VarInfo (name, type), built by
//     inverting the function's `scope`.
// With those, the algorithm mirrors the C# three-pass structure exactly.

// Op index within a function under a single global counter spanning all blocks
// (matches the C# pass — borrows flow across blocks through try-result
// branching, so a per-block index would mis-expire them).
typealias GlobalOpIndex = int(0 to u64.max)

// Cursor into one of the per-function call-site arrays during the merged
// (method + free) conflict walk in `checkConflicts`.
typealias CallSiteCursor = int(0 to u64.max)

typealias MethodNameSet = Set with String

// Mutating collection method names. A method call whose receiver is a borrowed
// collection and whose name is in this set conflicts with the borrow. Mirrors
// C# ParameterMutationAnalysisPass.IsMutatingMethodName — for a collection
// receiver these are exactly the methods whose `MutatedParamIndices` include
// the self slot, which is what BorrowCheckPass.DoesMutateArg(call, 0) tests.
function mutatingMethodNames() returns MethodNameSet
	return MethodNameSet from ["push", "pop", "insert", "remove", "set", "clear", "resize", "reserve", "append", "ensureCapacity"]
end 'mutatingMethodNames'

// ============================================================
// Parameter-mutation analysis (E3070 via-helper detection)
// ============================================================
//
// A free-function call `clearList(list)` where `clearList` mutates its
// parameter `list` (its body runs `list.clear()`) mutates the collection just
// as `list.clear()` would — so it conflicts with a live borrow of `list`. The
// C# BorrowCheckPass detects this through `IrFunction.MutatedParamIndices`
// (computed by a dedicated `ParameterMutationAnalysisPass`): `DetectMutationConflict`
// loops over EVERY call argument and reports the conflict when the callee
// mutates the matching parameter index (`DoesMutateArg`). The self-hosted IR has
// no separate pass for this, so this section computes the same fact in the
// borrow pass: for every function, which 0-based USER-parameter positions does
// its body mutate, propagated transitively through call edges to a fixpoint.
//
// Positions are USER-parameter ordinals (the declaration order recorded in
// `paramReservations`), NOT ABI indices — they align with a `call` op's `args`
// list at this Maxon tier (companion/env/witness ABI expansion happens later in
// lowering), which is exactly the index `DetectMutationConflict` consults.

typealias ParamIndexSet = Set with ParamCount

// Whole-module mutated-parameter facts as a FLAT key set: one `"funcName::idx"`
// entry per (function, mutated user-parameter position). A flat set (rather than
// a `Map` of per-function `Set`s) keeps both the local-collection stage and the
// transitive fixpoint to plain `insert`/`contains` — no get-modify-upsert of a
// map-stored collection (which would itself trip this borrow pass on the
// returned-collection-then-mutate-the-map pattern).
typealias MutatedParamsKeySet = Set with String

// The `"funcName::paramIndex"` key for one mutated / reassigned parameter.
// Exported so the pass-by-reference lowering builds the exact same key when it
// consults `computeReassignedParams`'s result at call sites.
export function mutatedParamKey(funcName String, paramIndex ParamCount) returns String
	return "{funcName}::{paramIndex}"
end 'mutatedParamKey'

// Slot -> user-parameter ordinal for one function, inverted from
// `paramReservations` (entry k backs declared param k). Empty for synthesized /
// restored functions with no reservations.
typealias SlotToParamIndexMap = Map with (VarSlot, ParamCount)

function buildSlotToParamIndex(func IrFunction) returns SlotToParamIndexMap
	var m = SlotToParamIndexMap.create()
	for k in 0 upto func.paramReservations.count() 'eachParam'
		let res = try func.paramReservations.get(k) otherwise panic("buildSlotToParamIndex: paramReservations.get OOB at {k}")
		m.upsert(res.paramSlot, value: k as ParamCount)
	end 'eachParam'
	return m
end 'buildSlotToParamIndex'

// The per-function local seed for `computeParamKeySet`: given one function,
// return the set of its user-parameter positions the relevant analysis marks
// locally. `computeMutatedParams` and `computeReassignedParams` differ only in
// which collector they plug in here.
typealias LocalParamCollector = function(MaxonModule, IrFunction, SlotToParamIndexMap) returns ParamIndexSet

// Shared driver for both whole-module parameter-set analyses. Two stages
// mirroring `ParameterMutationAnalysisPass`:
//   1. Local: seed each function's marked positions with `collectLocal`, keyed
//      `"funcName::paramIndex"`.
//   2. Transitive: a function that passes its own parameter P as the argument
//      for a callee parameter the callee marks, marks P too. Iterated to a
//      fixpoint over the (caller, argPos, calleePos) call edges.
function computeParamKeySet(module MaxonModule, collectLocal LocalParamCollector) returns MutatedParamsKeySet
	var keys = MutatedParamsKeySet.create()

	// Stage 1: local facts per function.
	for func in module.functions 'eachFunc'
		let slotToParam = buildSlotToParamIndex(func)
		if slotToParam.count() == 0 'noParams'
			continue
		end 'noParams'
		let indices = collectLocal(module, func, slotToParam)
		for idx in indices 'eachIdx'
			keys.insert(mutatedParamKey(func.name, paramIndex: idx))
		end 'eachIdx'
	end 'eachFunc'

	// Stage 2: transitive propagation to a fixpoint.
	propagateMutatedParams(module, mutated: keys)

	return keys
end 'computeParamKeySet'

// Compute, per function name, the set of user-parameter positions its body
// mutates: a `varStore` to a param slot (direct reassignment) or a mutating
// method call (`isMutatingMethodName`) on a param-derived receiver.
function computeMutatedParams(module MaxonModule) returns MutatedParamsKeySet
	return computeParamKeySet(module, collectLocal: collectLocalParamMutations)
end 'computeMutatedParams'

// Compute, per function name, the set of user-parameter positions its body
// DIRECTLY reassigns (`param = expr` — a `varStore` to a param slot),
// transitively propagated through call edges to a fixpoint. This is the
// subset of `computeMutatedParams` that seeds ONLY on direct reassignment
// (not on a mutating method call like `list.clear()`): only a direct
// reassignment changes the parameter-passing ABI, since a method mutation
// already propagates through the shared struct pointer. Mirrors the C#
// bootstrap's `IrFunction.ReassignedParams`, which drives pass-by-reference.
// Keyed `"funcName::paramIndex"` like `computeMutatedParams`.
export function computeReassignedParams(module MaxonModule) returns MutatedParamsKeySet
	return computeParamKeySet(module, collectLocal: collectLocalParamReassignments)
end 'computeReassignedParams'

// Stage-1 local scan for `computeReassignedParams`: return the set of
// user-parameter positions `func` DIRECTLY reassigns (a `varStore` to a param
// slot). Unlike `collectLocalParamMutations` it deliberately ignores mutating
// method calls — only a whole-value reassignment needs the by-reference ABI.
function collectLocalParamReassignments(module MaxonModule, func IrFunction, slotToParam SlotToParamIndexMap) returns ParamIndexSet
	var indicesOut = ParamIndexSet.create()
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("collectLocalParamReassignments: blockRef OOB")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("collectLocalParamReassignments: opIdx OOB")
			recordParamReassignmentFact(op, slotToParam: slotToParam, indicesOut: indicesOut)
		end 'eachOp'
		if block.hasTerminatorOp() 'hasTerm'
			let termOp = try module.ops.get(block.terminatorIndex()) otherwise panic("collectLocalParamReassignments: termIdx OOB")
			recordParamReassignmentFact(termOp, slotToParam: slotToParam, indicesOut: indicesOut)
		end 'hasTerm'
	end 'eachBlock'
	return indicesOut
end 'collectLocalParamReassignments'

// One op's contribution to the direct-reassignment scan: a `varStore` to a
// param slot reassigns that parameter. Every other op variant contributes
// nothing (covered by the surrounding `to`-range no-op arms so the match stays
// exhaustive without a `default`).
function recordParamReassignmentFact(op MaxonOp, slotToParam SlotToParamIndexMap, indicesOut ParamIndexSet)
	match op 'op'
		varStore(slotId, _, _) then markParamStore(slotId, slotToParam: slotToParam, indicesOut: indicesOut)
		literal to varLoad then return
		globalLoad to sizeofType then return
	end 'op'
end 'recordParamReassignmentFact'

// Stage-1 local scan: return the set of user-parameter positions `func` mutates
// directly (param reassignment or a mutating method on a param-derived value).
function collectLocalParamMutations(module MaxonModule, func IrFunction, slotToParam SlotToParamIndexMap) returns ParamIndexSet
	var indicesOut = ParamIndexSet.create()

	// SSA value names derived from a parameter (a `varLoad` of a param slot, or a
	// `fieldLoad` chained off an already-tainted value). A mutating method on such
	// a receiver mutates the parameter it derives from. Maps the tainted value
	// name to the originating param position so the mutation is attributed to the
	// right parameter.
	var taintedParam = ParamTaintMap.create()

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("collectLocalParamMutations: blockRef OOB")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("collectLocalParamMutations: opIdx OOB")
			recordParamMutationFacts(op, slotToParam: slotToParam, taintedParam: taintedParam, indicesOut: indicesOut)
		end 'eachOp'
		if block.hasTerminatorOp() 'hasTerm'
			let termOp = try module.ops.get(block.terminatorIndex()) otherwise panic("collectLocalParamMutations: termIdx OOB")
			recordParamMutationFacts(termOp, slotToParam: slotToParam, taintedParam: taintedParam, indicesOut: indicesOut)
		end 'hasTerm'
	end 'eachBlock'

	return indicesOut
end 'collectLocalParamMutations'

// SSA value name -> the user-parameter ordinal it derives from.
typealias ParamTaintMap = Map with (String, ParamCount)

// One op's contribution to the local param-mutation scan. A single forward pass
// suffices: a `fieldLoad` always follows its receiver's load, and a mutating
// method follows the load of its receiver, in op order.
function recordParamMutationFacts(op MaxonOp, slotToParam SlotToParamIndexMap, taintedParam ParamTaintMap, indicesOut ParamIndexSet)
	match op 'op'
		varLoad(result, slotId, _, _) then taintParamVarLoad(result, slotId: slotId, slotToParam: slotToParam, taintedParam: taintedParam)
		varStore(slotId, _, _) then markParamStore(slotId, slotToParam: slotToParam, indicesOut: indicesOut)
		methodCall(_, receiver, methodName, _, _, _, _, _) then markParamMethodMutation(receiver, methodName: methodName, taintedParam: taintedParam, indicesOut: indicesOut)
		fieldLoad(result, receiver, _, _) then taintParamFieldLoad(result, receiver: receiver, taintedParam: taintedParam)
		tryMethodCall(_, receiver, methodName, _, _, _, _, _, _) then markParamMethodMutation(receiver, methodName: methodName, taintedParam: taintedParam, indicesOut: indicesOut)
		literal to varDecl then return
		globalLoad to call then return
		ret to structAlloc then return
		fieldStore to tryCall then return
		rethrow to sizeofType then return
	end 'op'
end 'recordParamMutationFacts'

function taintParamVarLoad(result ByteArray, slotId VarSlot, slotToParam SlotToParamIndexMap, taintedParam ParamTaintMap)
	if let idx = try slotToParam.get(slotId) 'isParam'
		taintedParam.upsert(String.from(result), value: idx)
	end 'isParam'
end 'taintParamVarLoad'

function taintParamFieldLoad(result ByteArray, receiver ByteArray, taintedParam ParamTaintMap)
	if let idx = try taintedParam.get(String.from(receiver)) 'derived'
		taintedParam.upsert(String.from(result), value: idx)
	end 'derived'
end 'taintParamFieldLoad'

// A `varStore` to a param slot is a direct reassignment of that parameter.
function markParamStore(slotId VarSlot, slotToParam SlotToParamIndexMap, indicesOut ParamIndexSet)
	if let idx = try slotToParam.get(slotId) 'isParam'
		indicesOut.insert(idx)
	end 'isParam'
end 'markParamStore'

// A mutating method on a param-derived receiver mutates the parameter it derives from.
function markParamMethodMutation(receiver ByteArray, methodName ByteArray, taintedParam ParamTaintMap, indicesOut ParamIndexSet)
	let idx = try taintedParam.get(String.from(receiver)) otherwise return
	if isBorrowCheckMutatingMethod(String.from(methodName)) 'mutating'
		indicesOut.insert(idx)
	end 'mutating'
end 'markParamMethodMutation'

// Method names that mutate their receiver's reachable state, for the parameter-
// mutation analysis. Two groups:
//   - the collection mutators (`push`/`pop`/`clear`/…) — the same set the borrow
//     conflict walk treats as mutating (`mutatingMethodNames`); and
//   - the `__ManagedList` node-mutating methods (`insertFirst`/`insertLast`/…),
//     which mirror the dedicated `MaxonManagedList*Op` mutation ops the C#
//     `ParameterMutationAnalysisPass` recognizes structurally.
// A function whose body calls any of these on a parameter-derived receiver
// mutates that parameter. Spelled as an `or`-chain (not a per-call `Set`) to
// match the self-hosted `SemanticCheck.isMutatingMethodName` convention.
function isBorrowCheckMutatingMethod(methodName String) returns bool
	return methodName == "push" or methodName == "pop" or methodName == "insert" or methodName == "remove" or methodName == "set" or methodName == "clear" or methodName == "resize" or methodName == "reserve" or methodName == "append" or methodName == "ensureCapacity" or methodName == "insertFirst" or methodName == "insertLast" or methodName == "insertAfter" or methodName == "insertBefore" or methodName == "detach" or methodName == "setValue"
end 'isBorrowCheckMutatingMethod'

// Stage-2 transitive propagation: a function that forwards its own parameter to
// a callee parameter the callee mutates, mutates its own parameter too. Iterate
// the call edges to a fixpoint (monotonic — entries are only added — so the loop
// terminates in at most #functions rounds).
function propagateMutatedParams(module MaxonModule, mutated MutatedParamsKeySet)
	var changed = true
	while changed 'fixpoint'
		changed = false
		for caller in module.functions 'eachCaller'
			let callerSlotToParam = buildSlotToParamIndex(caller)
			if callerSlotToParam.count() == 0 'noParams'
				continue
			end 'noParams'
			if propagateThroughCalls(module, caller: caller, callerSlotToParam: callerSlotToParam, mutated: mutated) 'grew'
				changed = true
			end 'grew'
		end 'eachCaller'
	end 'fixpoint'
end 'propagateMutatedParams'

// Walk `caller`'s free `call` ops; for each argument that is a load of one of
// the caller's own parameters, if the callee mutates the parameter position the
// argument lands in, mark the caller's parameter mutated. Returns true if any
// new mutation was recorded (drives the fixpoint).
function propagateThroughCalls(module MaxonModule, caller IrFunction, callerSlotToParam SlotToParamIndexMap, mutated MutatedParamsKeySet) returns bool
	// Map each of the caller's SSA value names to the parameter ordinal it loads
	// from, so a call argument naming that value resolves to the caller param.
	var argValueToCallerParam = ParamTaintMap.create()
	for blockRef in caller.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("propagateThroughCalls: blockRef OOB")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("propagateThroughCalls: opIdx OOB")
			recordArgValueParamSource(op, callerSlotToParam: callerSlotToParam, argValueToCallerParam: argValueToCallerParam)
		end 'eachOp'
		if block.hasTerminatorOp() 'hasTerm'
			let termOp = try module.ops.get(block.terminatorIndex()) otherwise panic("propagateThroughCalls: termIdx OOB")
			recordArgValueParamSource(termOp, callerSlotToParam: callerSlotToParam, argValueToCallerParam: argValueToCallerParam)
		end 'hasTerm'
	end 'eachBlock'

	var grew = false
	for blockRef in caller.blockRefs 'eachBlock2'
		let block = try module.blocks.get(blockRef) otherwise panic("propagateThroughCalls: blockRef2 OOB")
		for opIdx in block.opRefs 'eachOp2'
			let op = try module.ops.get(opIdx) otherwise panic("propagateThroughCalls: opIdx2 OOB")
			if propagateOneCall(op, caller: caller, argValueToCallerParam: argValueToCallerParam, mutated: mutated) 'callGrew'
				grew = true
			end 'callGrew'
		end 'eachOp2'
	end 'eachBlock2'
	return grew
end 'propagateThroughCalls'

// A `varLoad` of a caller-param slot makes its result name resolve to that
// caller parameter ordinal — the source a `call` argument naming it carries.
function recordArgValueParamSource(op MaxonOp, callerSlotToParam SlotToParamIndexMap, argValueToCallerParam ParamTaintMap)
	match op 'op'
		varLoad(result, slotId, _, _) then taintParamVarLoad(result, slotId: slotId, slotToParam: callerSlotToParam, taintedParam: argValueToCallerParam)
		literal to varDecl then return
		varStore to sizeofType then return
	end 'op'
end 'recordArgValueParamSource'

// Propagate one direct `call` / `tryCall`: for each argument that names a
// caller-param-derived value, if the callee mutates that argument's position,
// record the caller's parameter as mutated. Returns true if a new entry was
// added. A `tryCall` (the throwing form of a free/qualified call) carries the
// SAME (callee, args) shape as `call` — plus a trailing `errorBoundName` — so a
// parameter FORWARDED through a `try callee(...)` propagates identically. Without
// the `tryCall` arm the by-reference ABI does not propagate up a chain of `try`
// forwarders (e.g. `parseScopedStatementsRequireBody` -> `parseStatementsRequireBody`
// -> `parseStatements`), so an owned value passed by-reference through the chain is
// released BOTH by the callee's `byRefParamDecrefOld` and by the original owner's
// last-use decref — a double free of a collection-owned block. Mirrors the C#
// bootstrap, whose `ParameterMutationAnalysisPass` propagates across every
// synchronous call-graph edge regardless of the throwing/non-throwing form.
function propagateOneCall(op MaxonOp, caller IrFunction, argValueToCallerParam ParamTaintMap, mutated MutatedParamsKeySet) returns bool
	return match op 'op'
		call(_, callee, callContext, args, _, _, _, _) gives propagateFreeCall(String.from(callee), callContext: callContext, args: args, caller: caller, argValueToCallerParam: argValueToCallerParam, mutated: mutated)
		tryCall(_, callee, callContext, args, _, _, _, _, _) gives propagateFreeCall(String.from(callee), callContext: callContext, args: args, caller: caller, argValueToCallerParam: argValueToCallerParam, mutated: mutated)
		literal to br gives false
		methodCall to throw gives false
		tryMethodCall to sizeofType gives false
	end 'op'
end 'propagateOneCall'

// The QUALIFIED callee name + the SELF-OFFSET between a maxon call's argument
// positions and the callee's parameter INDICES, derived from the call context. The
// mutated set is keyed on `<qualified func.name>::<param-index-INCLUDING-self>`
// (Stage-1 base facts key on `func.name`, and `buildByRefParamKeys` looks them up the
// same way). But a maxon call op carries the BARE callee, and a `sibling`
// (implicit-self, same-type) call's args EXCLUDE the self receiver — so the callee's
// parameter `k` corresponds to argument position `k - 1`. Without both adjustments the
// bare-name / raw-argPos lookup NEVER matches a qualified method, so the by-reference
// ABI never propagates past a directly-reassigning function: the parseStatements ->
// parseStatementsRequireBody -> parseScopedStatementsRequireBody -> parseIfStatement
// `try`-forwarder chain leaves `block` by-VALUE, and parseStatements' unconditional
// `byRefParamDecrefOld` then over-releases a block the caller/collection still owns
// (the v-next self-compile over-release).
function calleePropagationKey(callContext CallContext, callee String) returns (String, ParamCount)
	return match callContext 'ctx'
		sibling(typeName) gives ("{typeName}.{callee}", 1)
		free gives (callee, 0)
		qualified gives (callee, 0)
	end 'ctx'
end 'calleePropagationKey'

function propagateFreeCall(callee String, callContext CallContext, args ByteArrayArray, caller IrFunction, argValueToCallerParam ParamTaintMap, mutated MutatedParamsKeySet) returns bool
	let (qualifiedCallee, selfOffset) = calleePropagationKey(callContext, callee: callee)
	var grew = false
	for argPos in 0 upto args.count() 'eachArg'
		let calleeParamIndex = argPos + selfOffset
		if not mutated.contains(mutatedParamKey(qualifiedCallee, paramIndex: calleeParamIndex)) 'notMutatedHere'
			continue
		end 'notMutatedHere'
		let argName = try args.get(argPos) otherwise panic("propagateFreeCall: args.get OOB at {argPos}")
		let callerParam = try argValueToCallerParam.get(String.from(argName)) otherwise continue
		let key = mutatedParamKey(caller.name, paramIndex: callerParam)
		if not mutated.contains(key) 'newFact'
			mutated.insert(key)
			grew = true
		end 'newFact'
	end 'eachArg'
	return grew
end 'propagateFreeCall'

// A pending or active borrow: the borrowing variable's slot borrows from the
// source collection's slot. `borrowLine` is the source line of the `.get()`
// call, embedded verbatim into the E3070 message.
type MbcBorrow
	export var borrowingSlot as VarSlot
	export var sourceSlot as VarSlot
	export var borrowingName as String
	export var sourceName as String
	export var borrowLine as LineNumber
	// Global op index at which the borrow becomes active (the varDecl that
	// binds the .get() result into the borrowing variable). Borrows activate
	// at their binding, not at the call, so a borrow bound inside a
	// try-otherwise continuation does not exist on the failure path.
	export var activationIndex as GlobalOpIndex

	export static function create(borrowingSlot VarSlot, sourceSlot VarSlot, borrowingName String, sourceName String, borrowLine LineNumber, activationIndex GlobalOpIndex) returns MbcBorrow
		return Self{borrowingSlot: borrowingSlot, sourceSlot: sourceSlot, borrowingName: borrowingName, sourceName: sourceName, borrowLine: borrowLine, activationIndex: activationIndex}
	end 'create'
end 'MbcBorrow'

typealias MbcBorrowArray = Array with MbcBorrow
typealias SsaToSlotMap = Map with (String, VarSlot)
typealias SlotToVarInfoMap = Map with (VarSlot, VarInfo)
typealias SlotLastUseMap = Map with (VarSlot, GlobalOpIndex)

// Slot -> resolved MaxonType, captured from `varLoad` ops. The scope's
// VarInfo.varType keeps the parser's pre-resolution type (often `unresolved`
// for inferred `var arr = [...]`), but TypeResolution stamps the concrete type
// onto each `varLoad.slotType`, so the load sites are the reliable source.
typealias SlotTypeMap = Map with (VarSlot, MaxonType)

// SSA value name -> the slot a `var_decl`/`var_store` binds it into, plus the
// reverse: a slot -> the SSA value name a `var_load` produces from it. Together
// these follow the store→load→decl chain a `try EXPR otherwise default` lowers
// to: the call result is stored into a temp slot, reloaded in the merge block,
// then bound to the user variable's slot.
typealias ValueToSlotMap = Map with (String, VarSlot)
typealias SlotToValueMap = Map with (VarSlot, String)
typealias ValueToIndexMap = Map with (String, GlobalOpIndex)

// A method-call site flattened to the fields the borrow check consumes.
typealias MethodCallSiteArray = Array with MethodCallSite

// A free-call site flattened to the fields the via-helper conflict check
// consumes.
typealias FreeCallSiteArray = Array with FreeCallSite

// All per-function facts the borrow analysis collects in one linear pass,
// gathered into a struct so the recorders share one parameter instead of a
// long positional list. Mirrors the C# pass's per-function analysis state.
type BorrowFacts
	// SSA value name -> source slot it was loaded from (var_load).
	export var ssaToSlot as SsaToSlotMap
	// Slot -> resolved type, from var_load.slotType.
	export var slotTypes as SlotTypeMap
	// Slot -> last global op index that uses it (NLL expiry).
	export var lastUse as SlotLastUseMap
	// SSA value -> slot it is bound into by var_decl, and that decl's index.
	export var declSlotByValue as ValueToSlotMap
	export var declIndexByValue as ValueToIndexMap
	// SSA value -> slot it is stored into by var_store.
	export var storeSlotByValue as ValueToSlotMap
	// Slot -> SSA value name a var_load produces from it (last writer wins;
	// the merge-block reload is the only load of a try-temp slot).
	export var loadValueBySlot as SlotToValueMap
	// Every method-call / try-method-call site in program order.
	export var callSites as MethodCallSiteArray
	// Every free `call` site in program order (the via-helper conflict source).
	export var freeCallSites as FreeCallSiteArray

	export static function create() returns BorrowFacts
		return Self{
			ssaToSlot: SsaToSlotMap.create(),
			slotTypes: SlotTypeMap.create(),
			lastUse: SlotLastUseMap.create(),
			declSlotByValue: ValueToSlotMap.create(),
			declIndexByValue: ValueToIndexMap.create(),
			storeSlotByValue: ValueToSlotMap.create(),
			loadValueBySlot: SlotToValueMap.create(),
			callSites: MethodCallSiteArray.create(),
			freeCallSites: FreeCallSiteArray.create()
		}
	end 'create'
end 'BorrowFacts'

// One method-call op, recovered from `methodCall` / `tryMethodCall`, paired
// with its global op index. `receiverName` is the SSA value name of the
// receiver; `resultName` is the SSA value name the call binds.
type MethodCallSite
	export var globalIndex as GlobalOpIndex
	export var receiverName as String
	export var methodName as String
	export var resultName as String
	export var line as LineNumber
	export var column as ColumnNumber

	export static function create(globalIndex GlobalOpIndex, receiverName String, methodName String, resultName String, line LineNumber, column ColumnNumber) returns MethodCallSite
		return Self{globalIndex: globalIndex, receiverName: receiverName, methodName: methodName, resultName: resultName, line: line, column: column}
	end 'create'
end 'MethodCallSite'

// One free `call` op, recovered from the `call` variant, paired with its global
// op index. `callee` is the called function name; `argNames` are the SSA value
// names of the positional arguments (their order is the user-arg ordinal, which
// matches a callee's mutated-param positions). Used by the via-helper conflict
// check: a call whose argument is a borrowed-from source AND whose callee
// mutates that argument's position conflicts with the live borrow.
type FreeCallSite
	export var globalIndex as GlobalOpIndex
	export var callee as String
	export var argNames as StringArray
	export var line as LineNumber
	export var column as ColumnNumber

	export static function create(globalIndex GlobalOpIndex, callee String, argNames StringArray, line LineNumber, column ColumnNumber) returns FreeCallSite
		return Self{globalIndex: globalIndex, callee: callee, argNames: argNames, line: line, column: column}
	end 'create'
end 'FreeCallSite'

// ============================================================
// Entry point
// ============================================================

export function runMaxonBorrowCheck(project Project, module MaxonModule) returns MaxonModule
	// Whole-module parameter-mutation facts (which user-parameter positions each
	// function mutates), consulted at every free-call conflict site. Computed
	// once because a callee's facts depend on the whole module (transitive
	// propagation); the per-function conflict walk is a read-only consumer.
	let mutatedParams = computeMutatedParams(module)

	for func in module.functions 'eachFunc'
		checkFunction(project, func: func, module: module, mutatedParams: mutatedParams)
	end 'eachFunc'

	// Analysis-only pass: return the module unchanged.
	return module
end 'runMaxonBorrowCheck'

// ============================================================
// Per-function analysis
// ============================================================

function checkFunction(project Project, func IrFunction, module MaxonModule, mutatedParams MutatedParamsKeySet)
	// Build slot -> VarInfo by inverting the function's symbol table. Empty
	// for stdlib-restored / synthesized functions (no scope), which makes the
	// borrow scan a no-op there — exactly right, since user code can't fix
	// stdlib and the C# pass exempts IsStdlib functions.
	var slotToVarInfo = SlotToVarInfoMap.create()
	for (_, info) in func.scope.allVars() 'eachVar'
		slotToVarInfo.upsert(info.slot, value: info)
	end 'eachVar'
	if slotToVarInfo.count() == 0 'noLocals'
		return
	end 'noLocals'

	let mutators = mutatingMethodNames()

	// Pass 1: one linear walk collects every fact the analysis needs.
	var facts = BorrowFacts.create()
	collectFacts(module, func: func, facts: facts)

	// E3019: a mutating method (`push`/`set`/`append`/…) called on an immutable
	// (`let`-bound) receiver. Shares the call-site + slot facts the borrow scan
	// already collected. Runs unconditionally (independent of pending borrows).
	checkImmutableReceiverMutation(project, func: func, facts: facts, slotToVarInfo: slotToVarInfo, mutators: mutators)

	// E3019: passing an immutable (`let`-bound) local as the argument for a
	// parameter the callee MUTATES (reassigns it, or mutates its reachable
	// state) — the mutation would reach data the user bound immutably. Uses the
	// same whole-module `mutatedParams` facts the via-helper borrow check
	// consults. Runs unconditionally, mirroring the C# call-lowering check.
	checkImmutableArgToMutatingParam(project, func: func, facts: facts, slotToVarInfo: slotToVarInfo, mutatedParams: mutatedParams)

	// Pass 2: detect pending borrows (a .get()-style call on a generic
	// collection whose result binds into a user slot).
	var pending = detectBorrows(project, facts: facts, slotToVarInfo: slotToVarInfo, mutators: mutators)
	if pending.count() == 0 'noBorrows'
		return
	end 'noBorrows'

	// Pass 3: walk call sites in order; activate borrows at their binding
	// index, expire them past last use, and flag mutating calls on a still-
	// borrowed source.
	checkConflicts(project, func: func, facts: facts, pending: pending, mutators: mutators, mutatedParams: mutatedParams)
end 'checkFunction'

// E3019 (SemanticImmutableRefToMutatingParam): report a mutating method call
// whose receiver is a `let`-bound local. The receiver SSA name traces back
// through `facts.ssaToSlot` to its source slot; the inverted symbol table
// (`slotToVarInfo`) gives the slot's `VarInfo`, whose `mutable` flag is false
// for `let`. Self-field receivers are exempt — a struct `self` is passed by
// reference, so its fields are mutable through the receiver even when the
// enclosing binding is a `let` (mirrors the C# pass's `argName == "self"` skip).
// `var` locals, parameters declared mutable, and non-local receivers pass.
function checkImmutableReceiverMutation(project Project, func IrFunction, facts BorrowFacts, slotToVarInfo SlotToVarInfoMap, mutators MethodNameSet)
	for site in facts.callSites 'eachSite'
		if not mutators.contains(site.methodName) 'notMutating'
			continue
		end 'notMutating'
		let slot = try facts.ssaToSlot.get(site.receiverName) otherwise continue
		let info = try slotToVarInfo.get(slot) otherwise continue
		if info.isSelfField 'selfFieldReceiver'
			continue
		end 'selfFieldReceiver'
		if info.mutable 'mutableReceiver'
			continue
		end 'mutableReceiver'
		// Only user-facing collections (Array / Map / String) route their
		// mutating methods through real `self`-mutating functions that the C#
		// bootstrap's E3019 check sees. Compiler-internal builtin handles
		// (`__ManagedMemory`, `__ManagedList`) intercept their mutating methods
		// before callee resolution, so the bootstrap never fires E3019 on them
		// even through a `let` binding — exempt them here to match.
		let receiverType = try facts.slotTypes.get(slot) otherwise info.varType
		if not receiverTypeIsMutationChecked(project, t: receiverType) 'notUserCollection'
			continue
		end 'notUserCollection'
		let inFunc = "" if func.name.isEmpty() else " (in {func.name})"
		reportCompileError(project, code: ErrorCode.semanticImmutableRefToMutatingParam, message: "cannot pass '{info.name}' to function that mutates parameter 'self'{inFunc}", line: site.line, column: site.column, filePath: func.sourceFilePath)
	end 'eachSite'
end 'checkImmutableReceiverMutation'

// E3019 (SemanticImmutableRefToMutatingParam): report a free call that passes
// an immutable (`let`-bound) local as the argument for a parameter position the
// callee MUTATES (`mutatedParams`). Mirrors the C# call-lowering check
// (`MaxonToStandardConversion.Calls`): for each user-argument that names a
// `let` local, if the callee mutates that parameter position, the write would
// reach data the user bound immutably. `var` locals and parameters (implicitly
// mutable — a parameter forwarded into a mutating position just becomes
// by-reference itself) pass. Self-field arguments are exempt: a struct `self`
// is passed by reference, so its fields are mutable through the receiver.
function checkImmutableArgToMutatingParam(project Project, func IrFunction, facts BorrowFacts, slotToVarInfo SlotToVarInfoMap, mutatedParams MutatedParamsKeySet)
	for site in facts.freeCallSites 'eachSite'
		for argPos in 0 upto site.argNames.count() 'eachArg'
			if not mutatedParams.contains(mutatedParamKey(site.callee, paramIndex: argPos)) 'notMutatedHere'
				continue
			end 'notMutatedHere'
			let argName = try site.argNames.get(argPos) otherwise panic("checkImmutableArgToMutatingParam: argNames.get OOB at {argPos}")
			let slot = try facts.ssaToSlot.get(argName) otherwise continue
			let info = try slotToVarInfo.get(slot) otherwise continue
			if info.isSelfField 'selfFieldArg'
				continue
			end 'selfFieldArg'
			if info.mutable 'mutableArg'
				continue
			end 'mutableArg'
			let paramName = calleeParamName(project, callee: site.callee, paramIndex: argPos)
			let inFunc = "" if func.name.isEmpty() else " (in {func.name})"
			reportCompileError(project, code: ErrorCode.semanticImmutableRefToMutatingParam, message: "cannot pass '{info.name}' to function that mutates parameter '{paramName}'{inFunc}", line: site.line, column: site.column, filePath: func.sourceFilePath)
		end 'eachArg'
	end 'eachSite'
end 'checkImmutableArgToMutatingParam'

// The declared name of the callee's parameter at `paramIndex` (self included at
// ordinal 0 for instance methods), for the E3019 message. Empty when the callee
// has no registered signature or the index is out of range — the diagnostic
// still names the argument, so a blank parameter name only omits detail.
function calleeParamName(project Project, callee String, paramIndex ParamCount) returns String
	if let sig = try project.funcSignatures.get(callee) 'haveSig'
		return try sig.paramNames.get(paramIndex) otherwise ""
	end 'haveSig'
	return ""
end 'calleeParamName'

// True when a mutating method on a `let` receiver of type `t` should fire
// E3019: user-facing collections (`String`, or a generic instance whose base is
// not a `__Managed*` builtin handle). Builtin managed handles are exempt — their
// mutating methods are intercepted before callee resolution in the bootstrap,
// so it never raises E3019 on a `let` handle.
function receiverTypeIsMutationChecked(project Project, t MaxonType) returns bool
	return match t 'check'
		boolean to float gives false
		string gives true
		character gives true
		named(id) gives nonEmptyEquals(project.typeNames.get(id), discovered: getCachedBuiltinStringLiteralTypeName())
		function to typeParameter gives false
		genericInstance(id) gives not isBuiltinManagedTypeName(genericInstanceIdBaseName(project, id: id))
		interface to cstring gives false
	end 'check'
end 'receiverTypeIsMutationChecked'

// ============================================================
// Pass 1: fact collection (ssaToSlot, call sites, last-use)
// ============================================================

function collectFacts(module MaxonModule, func IrFunction, facts BorrowFacts)
	var gi = 0 as GlobalOpIndex
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("collectFacts: blockRef {blockRef} OOB in module.blocks")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("collectFacts: opIdx {opIdx} OOB in module.ops")
			recordOpFacts(op, gi: gi, facts: facts)
			gi = gi + 1
		end 'eachOp'
		if block.hasTerminatorOp() 'hasTerm'
			let termOp = try module.ops.get(block.terminatorIndex()) otherwise panic("collectFacts: terminator opIdx OOB in module.ops")
			recordOpFacts(termOp, gi: gi, facts: facts)
			gi = gi + 1
		end 'hasTerm'
	end 'eachBlock'
end 'collectFacts'

// Dispatch on op variant so unrelated ops contribute no facts. Each handled
// arm destructures exactly the op variant it cares about; every other variant
// is covered by a `to`-range no-op arm so the match stays exhaustive without a
// `default`.
function recordOpFacts(op MaxonOp, gi GlobalOpIndex, facts BorrowFacts)
	match op 'op'
		literal to stringInterp then return
		varDecl(slotId, value, _, _) then recordVarDecl(slotId, value: value, gi: gi, facts: facts)
		varLoad(result, slotId, slotType, _) then recordVarLoad(result, slotId: slotId, slotType: slotType, gi: gi, facts: facts)
		varStore(slotId, value, _) then facts.storeSlotByValue.upsert(String.from(value), value: slotId)
		globalLoad to br then return
		call(_, callee, _, args, _, _, _, range) then recordFreeCallSite(facts, gi: gi, callee: callee, args: args, range: range)
		methodCall(result, receiver, methodName, _, _, _, _, range) then recordCallSite(facts, gi: gi, receiver: receiver, methodName: methodName, result: result, range: range)
		ret to tryCall then return
		tryMethodCall(result, receiver, methodName, _, _, _, _, _, range) then recordCallSite(facts, gi: gi, receiver: receiver, methodName: methodName, result: result, range: range)
		rethrow to sizeofType then return
	end 'op'
end 'recordOpFacts'

// Append a method-call site. Shared by the methodCall / tryMethodCall arms,
// which carry identical receiver/method/result/range shapes for our purposes.
function recordCallSite(facts BorrowFacts, gi GlobalOpIndex, receiver ByteArray, methodName ByteArray, result ByteArray, range SourceRange)
	facts.callSites.push(MethodCallSite.create(gi, receiverName: String.from(receiver), methodName: String.from(methodName), resultName: String.from(result), line: range.line, column: range.column))
end 'recordCallSite'

// Append a free-call site, copying the positional argument SSA names. The via-
// helper conflict check (`reportFreeCallConflict`) consults these against the
// callee's mutated-param positions.
function recordFreeCallSite(facts BorrowFacts, gi GlobalOpIndex, callee ByteArray, args ByteArrayArray, range SourceRange)
	var argNames = StringArray.create()
	for arg in args 'eachArg'
		argNames.push(String.from(arg))
	end 'eachArg'
	facts.freeCallSites.push(FreeCallSite.create(gi, callee: String.from(callee), argNames: argNames, line: range.line, column: range.column))
end 'recordFreeCallSite'

// A varLoad binds an SSA name to its source slot, records the slot's load-site
// SSA name (for the store→load→decl chain), captures the TypeResolution-stamped
// `slotType`, and marks a use of the slot (NLL last-use).
function recordVarLoad(result ByteArray, slotId VarSlot, slotType MaxonType, gi GlobalOpIndex, facts BorrowFacts)
	let resultName = String.from(result)
	facts.ssaToSlot.upsert(resultName, value: slotId)
	facts.loadValueBySlot.upsert(slotId, value: resultName)
	facts.slotTypes.upsert(slotId, value: slotType)
	facts.lastUse.upsert(slotId, value: gi)
end 'recordVarLoad'

// A varDecl binds an SSA value into a slot — the activation point of a borrow
// whose ultimate user variable is that slot.
function recordVarDecl(slotId VarSlot, value ByteArray, gi GlobalOpIndex, facts BorrowFacts)
	let valueName = String.from(value)
	facts.declSlotByValue.upsert(valueName, value: slotId)
	facts.declIndexByValue.upsert(valueName, value: gi)
end 'recordVarDecl'

// ============================================================
// Pass 2: borrow detection
// ============================================================

function detectBorrows(project Project, facts BorrowFacts, slotToVarInfo SlotToVarInfoMap, mutators MethodNameSet) returns MbcBorrowArray
	var pending = MbcBorrowArray.create()
	for site in facts.callSites 'eachSite'
		// The receiver must resolve to a user variable slot with a known name.
		let sourceSlot = try facts.ssaToSlot.get(site.receiverName) otherwise 'noSlot'
			continue
		end 'noSlot'
		let sourceInfo = try slotToVarInfo.get(sourceSlot) otherwise 'noInfo'
			continue
		end 'noInfo'

		// Only generic/parameterized receivers (Array, Map, ...) hand out
		// references into a movable backing buffer. Plain structs return value
		// copies from method calls and cannot dangle. Use the TypeResolution-
		// stamped varLoad type, not the scope's pre-resolution VarInfo type.
		// Chase a collection typealias to its generic instance first — a
		// PARAMETER's slotType keeps the source-level alias (`list StringList`),
		// which `isGenericCollectionType` would otherwise reject.
		let rawSourceType = try facts.slotTypes.get(sourceSlot) otherwise 'noType'
			continue
		end 'noType'
		let sourceType = resolveCollectionAlias(project, t: rawSourceType)
		if not isGenericCollectionType(sourceType) 'notCollection'
			continue
		end 'notCollection'

		// Mutating extractors (pop, remove) return a value that has left the
		// collection — not a borrow into it.
		if mutators.contains(site.methodName) 'isMutator'
			continue
		end 'isMutator'

		// Resolve the borrowing variable: follow the call result through the
		// store→load chain a `try EXPR otherwise default` emits to the user
		// `varDecl`. Returns the user slot + the binding's global op index.
		let activation = try resolveActivation(facts, resultName: site.resultName) otherwise 'noActivation'
			continue
		end 'noActivation'
		let borrowingInfo = try slotToVarInfo.get(activation.boundSlot) otherwise 'noBorrowInfo'
			continue
		end 'noBorrowInfo'

		// The borrow must produce a heap-allocated value (a pointer into the
		// buffer); primitive/value returns are copies. Use the resolved load
		// type of the borrowing slot, falling back to its declared type.
		let rawBorrowingType = try facts.slotTypes.get(activation.boundSlot) otherwise borrowingInfo.varType
		let borrowingType = resolveCollectionAlias(project, t: rawBorrowingType)
		if not typeIsHeapAllocated(project, t: borrowingType) 'valueCopy'
			continue
		end 'valueCopy'

		// A builtin managed-handle result (`__ManagedListNode`) is an INDEPENDENT,
		// refcounted node — not a view into the receiver's storage — so mutating
		// the receiver (`list.remove(other)`) cannot dangle it. Exclude it from
		// the buffer-aliasing borrow rule (see `isBuiltinManagedHandleType`).
		if isBuiltinManagedHandleType(project, t: borrowingType) 'independentHandle'
			continue
		end 'independentHandle'

		// Skip methods that return the same collection type as the receiver
		// (`.slice()`, `.clone()`, builder-pattern chains). Those produce a new,
		// independent collection — not a reference into the receiver's buffer —
		// so mutating the receiver afterwards cannot dangle. `.get()` returns the
		// Element type, which differs from the `Array with Element` receiver.
		if maxonTypesStructurallyEqual(borrowingType, b: sourceType) 'returnsSelf'
			continue
		end 'returnsSelf'

		pending.push(MbcBorrow.create(activation.boundSlot, sourceSlot: sourceSlot, borrowingName: borrowingInfo.name, sourceName: sourceInfo.name, borrowLine: site.line, activationIndex: activation.index))
	end 'eachSite'
	return pending
end 'detectBorrows'

// The binding site of a call result: the user slot it lands in and the global
// op index of the `varDecl` that binds it.
type MbcActivation
	export var boundSlot as VarSlot
	export var index as GlobalOpIndex

	export static function create(boundSlot VarSlot, index GlobalOpIndex) returns MbcActivation
		return Self{boundSlot: boundSlot, index: index}
	end 'create'
end 'MbcActivation'

union MbcActivationLookup implements Error
	notFound
end 'MbcActivationLookup'

// Follow a call result to the `varDecl` that binds it into a user variable.
//
// A `let s = arr.get(0)` binds the call result directly: `var_decl slot_s,
// %result`. A `let s = try arr.get(0) otherwise default` instead routes through
// a try-temp slot: the result is `var_store`d into slot_tmp (success path), the
// default into the same slot (otherwise path), then the merge block reloads it
// (`%v = var_load slot_tmp`) and binds the user var (`var_decl slot_s, %v`).
// So we follow value → var_decl (done) | var_store slot → var_load slot → value
// (repeat), bounded to a few hops to stay loop-free on malformed IR.
function resolveActivation(facts BorrowFacts, resultName String) returns MbcActivation throws MbcActivationLookup
	var currentValue = resultName
	for _ in 0 upto 5 'follow'
		if let boundSlot = try facts.declSlotByValue.get(currentValue) 'directDecl'
			let index = try facts.declIndexByValue.get(currentValue) otherwise throw MbcActivationLookup.notFound
			return MbcActivation.create(boundSlot, index: index)
		end 'directDecl'
		let storeSlot = try facts.storeSlotByValue.get(currentValue) otherwise throw MbcActivationLookup.notFound
		currentValue = try facts.loadValueBySlot.get(storeSlot) otherwise throw MbcActivationLookup.notFound
	end 'follow'
	throw MbcActivationLookup.notFound
end 'resolveActivation'

// Resolve a `named(alias)` collection typealias to its underlying generic
// instance (`StringList` -> `List with String`). The C# pass reads the resolved
// `callee.ParamTypes[0]` so it always sees the structural `IrStructType`; the
// self-hosted pass reads the `varLoad.slotType`, which for a PARAMETER keeps the
// source-level alias the user wrote (`list StringList`) rather than the resolved
// generic instance. Chase the alias through `genericTypealiases` so a param-typed
// receiver is recognized as a collection (the borrow conflict inside a helper
// like `clearList(list StringList)` depends on this). A non-alias / unregistered
// type passes through unchanged. Bounded loop handles alias-to-alias chains.
function resolveCollectionAlias(project Project, t MaxonType) returns MaxonType
	var resolved = t
	for _ in 0 upto 8 'unwrap'
		let name = resolved.namedAliasNameOrEmpty(project)
		if name.isEmpty() 'notNamed'
			return resolved
		end 'notNamed'
		let next = try project.genericTypealiases.get(name) otherwise return resolved
		resolved = next
	end 'unwrap'
	return resolved
end 'resolveCollectionAlias'

// True when a type is a generic collection (Array / Map / Set / List / Vector)
// — a parameterized type whose method calls can return interior references.
function isGenericCollectionType(t MaxonType) returns bool
	return match t 'gc'
		boolean to typeParameter gives false
		genericInstance gives true
		interface to cstring gives false
	end 'gc'
end 'isGenericCollectionType'

// True when `t` is a builtin compiler-managed handle (`__ManagedList`,
// `__ManagedListNode`, `__ManagedMemory`) — its base name is in the
// `isBuiltinManagedTypeName` set. A `genericInstance` whose base is such a
// handle is NOT a contiguous-buffer collection: `__ManagedList` is a doubly-
// linked chain of individually heap-allocated, refcounted nodes, and a node
// accessor (`insertLast`/`head`/`first`) returns an INDEPENDENT
// `__ManagedListNode` handle, not a pointer into a movable backing buffer.
// Removing one node never reallocates or dangles another node handle, so a
// node result must not be treated as a borrow into the list (the C# bootstrap
// reaches the same outcome because the node-producing methods mutate `self`
// and so are classified non-borrow producers; here we encode the structural
// reason directly — the produced value is an owned handle, not a buffer view).
function isBuiltinManagedHandleType(project Project, t MaxonType) returns bool
	return match t 'bm'
		genericInstance(id) gives isBuiltinManagedTypeName(genericInstanceIdBaseName(project, id: id))
		boolean to typeParameter gives false
		interface to cstring gives false
	end 'bm'
end 'isBuiltinManagedHandleType'

// True when a value of type `t` is heap-allocated (a reference into managed
// memory) rather than a copied primitive. Strings and struct/collection types
// are heap-allocated; bool/int/float/byte/enum are value copies.
function typeIsHeapAllocated(project Project, t MaxonType) returns bool
	return match t 'heap'
		boolean gives false
		integer gives false
		float gives false
		string gives true
		character gives true
		named(id) gives namedTypeIsHeapAllocated(project, id: id)
		function gives false
		unresolved gives false
		typeParameter gives true
		genericInstance gives true
		interface gives true
		constInt gives false
		opaquePointer to cstring gives false
	end 'heap'
end 'typeIsHeapAllocated'

// A `named(id)` type is heap-allocated when it resolves to a struct type.
// Enums and primitive typealiases are value copies.
function namedTypeIsHeapAllocated(project Project, id TypeNameId) returns bool
	let name = project.typeNames.get(id)
	return project.structTypes.contains(name)
end 'namedTypeIsHeapAllocated'

// ============================================================
// Pass 3: conflict checking
// ============================================================

function checkConflicts(project Project, func IrFunction, facts BorrowFacts, pending MbcBorrowArray, mutators MethodNameSet, mutatedParams MutatedParamsKeySet)
	var active = MbcBorrowArray.create()
	// Tracks which pending borrows have already moved into `active`, so each
	// borrow activates exactly once even though the walk only visits call
	// sites (the activation index — a varDecl — is not itself a call site, so
	// we activate at the first call site at or past it).
	var activated = BoolArray.create()
	for _ in 0 upto pending.count() 'seedActivated'
		activated.push(false)
	end 'seedActivated'

	// Walk method-call and free-call sites together in global-op-index order
	// (both arrays are already in op order). Activation/expiry must see ALL
	// calls in order, so a borrow active at a free call (`clearList(list)`) is
	// flagged just like one at a direct mutating method (`list.clear()`).
	var mi = 0 as CallSiteCursor
	var fi = 0 as CallSiteCursor
	while mi < facts.callSites.count() or fi < facts.freeCallSites.count() 'walk'
		let nextIsMethod = freeCallComesAfterMethod(facts, mi: mi, fi: fi)
		if nextIsMethod 'methodSite'
			let site = try facts.callSites.get(mi) otherwise panic("checkConflicts: callSites.get OOB at {mi}")
			mi = mi + 1
			advanceBorrowState(facts, pending: pending, active: active, activated: activated, currentIndex: site.globalIndex)
			checkMethodCallConflict(project, func: func, facts: facts, active: active, mutators: mutators, site: site)
		end 'methodSite' else 'freeSite'
			let site = try facts.freeCallSites.get(fi) otherwise panic("checkConflicts: freeCallSites.get OOB at {fi}")
			fi = fi + 1
			advanceBorrowState(facts, pending: pending, active: active, activated: activated, currentIndex: site.globalIndex)
			checkFreeCallConflict(project, func: func, facts: facts, active: active, mutatedParams: mutatedParams, site: site)
		end 'freeSite'
	end 'walk'
end 'checkConflicts'

// True when the next site to process (lowest global index) is the method-call
// site. When one stream is exhausted the other wins; on a tie the method-call
// site is processed first (deterministic, and the two never share an index).
function freeCallComesAfterMethod(facts BorrowFacts, mi CallSiteCursor, fi CallSiteCursor) returns bool
	if fi >= facts.freeCallSites.count() 'noMoreFree'
		return true
	end 'noMoreFree'
	if mi >= facts.callSites.count() 'noMoreMethod'
		return false
	end 'noMoreMethod'
	let mSite = try facts.callSites.get(mi) otherwise panic("freeCallComesAfterMethod: callSites.get OOB at {mi}")
	let fSite = try facts.freeCallSites.get(fi) otherwise panic("freeCallComesAfterMethod: freeCallSites.get OOB at {fi}")
	return mSite.globalIndex <= fSite.globalIndex
end 'freeCallComesAfterMethod'

// Activate pending borrows bound at/before this op and expire dead ones —
// the per-site bookkeeping shared by both call-site kinds.
function advanceBorrowState(facts BorrowFacts, pending MbcBorrowArray, active MbcBorrowArray, activated BoolArray, currentIndex GlobalOpIndex)
	activatePendingUpTo(pending, active: active, activated: activated, currentIndex: currentIndex)
	expireDeadBorrows(active, lastUse: facts.lastUse, currentIndex: currentIndex)
end 'advanceBorrowState'

// A mutating method on a still-borrowed source is a conflict.
function checkMethodCallConflict(project Project, func IrFunction, facts BorrowFacts, active MbcBorrowArray, mutators MethodNameSet, site MethodCallSite)
	if not mutators.contains(site.methodName) 'notMutating'
		return
	end 'notMutating'
	let mutatedSlot = try facts.ssaToSlot.get(site.receiverName) otherwise return
	reportConflictIfBorrowed(project, func: func, active: active, mutatedSlot: mutatedSlot, methodName: site.methodName, line: site.line, column: site.column)
end 'checkMethodCallConflict'

// A free call whose argument is a still-borrowed source AND whose callee mutates
// that argument's parameter position is a conflict (the via-helper case:
// `clearList(list)` where `clearList` runs `list.clear()`). Mirrors the C# pass's
// `DetectMutationConflict` arg-loop over `DoesMutateArg(call, argIdx)`. The
// message names the CALLEE (display-trimmed of any namespace prefix), matching
// the C# `FormatMethodName` form (`StringList.clear` -> `clear`, `clearList` ->
// `clearList`).
function checkFreeCallConflict(project Project, func IrFunction, facts BorrowFacts, active MbcBorrowArray, mutatedParams MutatedParamsKeySet, site FreeCallSite)
	let methodDisplay = formatCalleeDisplay(site.callee)
	for argPos in 0 upto site.argNames.count() 'eachArg'
		if not mutatedParams.contains(mutatedParamKey(site.callee, paramIndex: argPos)) 'notMutatedHere'
			continue
		end 'notMutatedHere'
		let argName = try site.argNames.get(argPos) otherwise panic("checkFreeCallConflict: argNames.get OOB at {argPos}")
		let mutatedSlot = try facts.ssaToSlot.get(argName) otherwise continue
		reportConflictIfBorrowed(project, func: func, active: active, mutatedSlot: mutatedSlot, methodName: methodDisplay, line: site.line, column: site.column)
	end 'eachArg'
end 'checkFreeCallConflict'

// Trim a callee name to its display form: everything after the LAST `.` (so a
// qualified callee `ns.helper` displays as `helper`); an unqualified free
// function (`clearList`) is returned verbatim. Mirrors the C# pass's
// `FormatMethodName` for the cases the borrow check reports — a bare free-
// function name has no dot, so both agree (`clearList` -> `clearList`).
function formatCalleeDisplay(callee String) returns String
	let bytes = callee.toByteArray()
	let dotByte = 0x2E
	var lastDot = -1
	var i = 0
	while i < bytes.count() 'scan'
		let b = try bytes.get(i) otherwise panic("formatCalleeDisplay: bytes.get OOB at {i}")
		if b == dotByte 'hit'
			lastDot = i
		end 'hit'
		i = i + 1
	end 'scan'
	if lastDot < 0 'noDot'
		return callee
	end 'noDot'
	let tail = try bytes.slice(lastDot + 1, endIndex: bytes.count()) otherwise panic("formatCalleeDisplay: slice failed past last dot")
	return String.from(tail)
end 'formatCalleeDisplay'

// Move every not-yet-activated pending borrow whose binding index is at or
// before `currentIndex` into the active set. A borrow becomes live once its
// `let s = ...` binding has executed; the conflict walk only stops at call
// sites, so we activate lazily at the first call site that reaches the
// binding's index.
function activatePendingUpTo(pending MbcBorrowArray, active MbcBorrowArray, activated BoolArray, currentIndex GlobalOpIndex)
	for i in 0 upto pending.count() 'eachPending'
		let already = try activated.get(i) otherwise panic("activatePendingUpTo: activated.get OOB at {i}")
		if already 'skipActivated'
			continue
		end 'skipActivated'
		let borrow = try pending.get(i) otherwise panic("activatePendingUpTo: pending.get OOB at {i}")
		if borrow.activationIndex <= currentIndex 'activate'
			active.push(borrow)
			try activated.set(i, value: true) otherwise panic("activatePendingUpTo: activated.set OOB at {i}")
		end 'activate'
	end 'eachPending'
end 'activatePendingUpTo'

// Drop borrows whose borrowing variable's last use is strictly before the
// current op — the reference is no longer live (NLL).
function expireDeadBorrows(active MbcBorrowArray, lastUse SlotLastUseMap, currentIndex GlobalOpIndex)
	var live = MbcBorrowArray.create()
	for borrow in active 'eachActive'
		let last = try lastUse.get(borrow.borrowingSlot) otherwise 'noUse'
			// No recorded use after binding — treat as already expired.
			continue
		end 'noUse'
		if last >= currentIndex 'stillLive'
			live.push(borrow)
		end 'stillLive'
	end 'eachActive'
	active.clear()
	for borrow in live 'refill'
		active.push(borrow)
	end 'refill'
end 'expireDeadBorrows'

// Report E3070 for the first active borrow of `mutatedSlot`, if any.
function reportConflictIfBorrowed(project Project, func IrFunction, active MbcBorrowArray, mutatedSlot VarSlot, methodName String, line LineNumber, column ColumnNumber)
	for borrow in active 'eachActive'
		if borrow.sourceSlot == mutatedSlot 'conflict'
			let message = "cannot mutate '{borrow.sourceName}' via '{methodName}' while it is borrowed by '{borrow.borrowingName}' (borrowed at line {borrow.borrowLine})"
			reportCompileError(project, code: ErrorCode.semanticBorrowConflict, message: message, line: line, column: column, filePath: func.sourceFilePath)
			return
		end 'conflict'
	end 'eachActive'
end 'reportConflictIfBorrowed'
