// TargetModule: the top-level container for the target (x64/arm64) phase.
// Holds target-specific machine ops, blocks, and functions for a single
// compilation unit. Produced by lowerMirToTarget; consumed by the register
// allocator, prologue/epilogue pass, instruction scheduler, and code
// emitter.
//
// A single TargetModule holds ONE of x64Ops or arm64Ops — never both. The
// `cpu` field discriminates which array is active. Backend passes that
// care about the specific ISA dispatch on cpu. This shape is simpler than
// four fully separate X64Module/Arm64Module types because all the shared
// regalloc machinery would otherwise need two copies.
//
// An IrBlock's opRefs are plain indices into whichever op array is
// active per module.cpu; the type system still guarantees that no non-
// target op can land here, because the module only has x64Ops and
// arm64Ops arrays.
//
// At the Target phase, IrFunction's spillSize and calleeSavedGprs/calleeSavedFps
// fields are populated by the register allocator and prologue/epilogue pass.

// TargetModule: top-level container for a compilation unit at the target
// phase. Holds either x64Ops or arm64Ops (not both) depending on cpu.
export type TargetModule
	export var functions as IrFunctionArray
	export var blocks as IrBlockArray
	export var x64Ops as X64OpArray
	export var arm64Ops as Arm64OpArray
	export var cpu as CpuArch

	export static function create(cpu CpuArch) returns TargetModule
		return Self{
			functions: IrFunctionArray.create(),
			blocks: IrBlockArray.create(),
			x64Ops: X64OpArray.create(),
			arm64Ops: Arm64OpArray.create(),
			cpu: cpu
		}
	end 'create'

	// Count ops still reachable from any block. Shared with IrModule via
	// `countLiveOps`; both modules report block-reachable counts so post-
	// rewrite passes don't double-count dropped, unreferenced entries in
	// the underlying op array. Cold path — only called when ir-trace
	// logging or `--dump-stages` is on.
	export function liveOpCount() returns OpCount
		return countLiveOps(self.functions, blocks: self.blocks)
	end 'liveOpCount'

	// Reclaim orphaned target ops in place. The target phase orphans the same
	// way the pre-target tiers do: applyColoring, insertSpillCode, and the
	// prologue/epilogue pass all clear each block's `opRefs` and re-append fresh
	// machine ops, leaving the predecessors unreferenced in the active op array.
	// Across the per-function regalloc loop these orphans accumulate in one
	// shared array (x64Ops or arm64Ops), so this is compacted at backend-stage
	// boundaries to cap the peak. See IrModule.compactOps for the in-place
	// algorithm and byte-identity guarantee — this mirrors it on whichever op
	// array `cpu` selects (a TargetModule holds exactly one).
	export function compactOps()
		match self.cpu 'dispatch'
			x64 then compactX64Ops(self)
			arm64 then compactArm64Ops(self)
			// WASM never reaches the target phase (it branches from MIR), so its
			// op arrays are always empty — nothing to compact.
			wasm32 then break 'dispatch'
		end 'dispatch'
	end 'compactOps'
end 'TargetModule'

// Compact `module.x64Ops` in place. Computes the shared op-type-agnostic
// forwarding plan, moves each live op leftward (newIndex <= oldIndex, so no
// clobber), truncates the orphan tail, then rewrites every block's opRefs +
// terminator through the plan.
function compactX64Ops(module TargetModule)
	let oldCount = module.x64Ops.count()
	let plan = computeOpCompaction(module.functions, blocks: module.blocks, opCount: oldCount)
	if plan.liveCount == oldCount 'noOrphans'
		return
	end 'noOrphans'

	// Swap (never `set`) each live op leftward — see IrModule.compactOps for why
	// `set` would UAF a managed-payload op (X64Op carries String/array operands).
	for oldIdx in 0 upto oldCount 'move'
		let newIdx = try plan.forward.get(oldIdx) otherwise panic("compactX64Ops: forward.get OOB at {oldIdx}")
		if newIdx == plan.deadMarker 'orphan'
			continue
		end 'orphan'
		if newIdx != oldIdx 'needsSwap'
			module.x64Ops.swap(newIdx, j: oldIdx)
		end 'needsSwap'
	end 'move'

	// Pop+drop the orphan tail so each dropped op's managed payload (String /
	// array operands) is freed — see IrModule.compactOps for why `resize` alone
	// would leak them.
	for _ in plan.liveCount upto oldCount 'dropOrphan'
		_ = try module.x64Ops.pop() otherwise panic("compactX64Ops: x64Ops.pop on non-empty tail failed")
	end 'dropOrphan'

	rewriteBlockOpRefs(module.functions, blocks: module.blocks, plan: plan)
end 'compactX64Ops'

// Compact `module.arm64Ops` in place — the arm64 mirror of compactX64Ops.
function compactArm64Ops(module TargetModule)
	let oldCount = module.arm64Ops.count()
	let plan = computeOpCompaction(module.functions, blocks: module.blocks, opCount: oldCount)
	if plan.liveCount == oldCount 'noOrphans'
		return
	end 'noOrphans'

	// Swap (never `set`) each live op leftward — see IrModule.compactOps for why
	// `set` would UAF a managed-payload op (Arm64Op carries String/array operands).
	for oldIdx in 0 upto oldCount 'move'
		let newIdx = try plan.forward.get(oldIdx) otherwise panic("compactArm64Ops: forward.get OOB at {oldIdx}")
		if newIdx == plan.deadMarker 'orphan'
			continue
		end 'orphan'
		if newIdx != oldIdx 'needsSwap'
			module.arm64Ops.swap(newIdx, j: oldIdx)
		end 'needsSwap'
	end 'move'

	// Pop+drop the orphan tail so each dropped op's managed payload (String /
	// array operands) is freed — see IrModule.compactOps for why `resize` alone
	// would leak them.
	for _ in plan.liveCount upto oldCount 'dropOrphan'
		_ = try module.arm64Ops.pop() otherwise panic("compactArm64Ops: arm64Ops.pop on non-empty tail failed")
	end 'dropOrphan'

	rewriteBlockOpRefs(module.functions, blocks: module.blocks, plan: plan)
end 'compactArm64Ops'

// ============================================================
// Op append / terminator helpers
// ============================================================

export function appendX64Op(module TargetModule, block IrBlock, op X64Op)
	let idx = module.x64Ops.count()
	module.x64Ops.push(op)
	block.opRefs.append(idx)
end 'appendX64Op'

export function appendArm64Op(module TargetModule, block IrBlock, op Arm64Op)
	let idx = module.arm64Ops.count()
	module.arm64Ops.push(op)
	block.opRefs.append(idx)
end 'appendArm64Op'

function setX64Terminator(module TargetModule, block IrBlock, op X64Op)
	let idx = module.x64Ops.count()
	module.x64Ops.push(op)
	block.terminator = Terminator.opIndex(idx)
end 'setX64Terminator'

export function setArm64Terminator(module TargetModule, block IrBlock, op Arm64Op)
	let idx = module.arm64Ops.count()
	module.arm64Ops.push(op)
	block.terminator = Terminator.opIndex(idx)
end 'setArm64Terminator'
