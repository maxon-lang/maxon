// Convenience wrapper: compiles a file or directory and returns the output executable path.
// When `irDump.enabled()` is true, the project-wide query cache is bypassed
// so the pipeline re-runs and the printer hooks observe fresh modules.
export function compile(path FilePath, target Target, coverage bool = false, irDump IrDumpOptions = IrDumpOptions.disabled(), irOutputPath FilePath = FilePath from "", leakCheck bool = false, cacheStats bool = false, cacheRoot FilePath = FilePath from "", libraryDirs StringArray = StringArray.create(), fastRegalloc bool = false, outputPathOverride String = "", rcSanitize bool = false) returns FilePath throws CompileError
	// Persisting the lazily-grown stdlib cache back to disk is safe from ANY
	// project (Phase 3.5 made the cache codec project-independent — it resolves
	// through the cache's own snapshot tables, not the consumer's interner), so
	// `ensureStdlibFunctionsCompiled` persists unconditionally; no gating here.
	var project = createProject(path, target: target)
	project.coverageEnabled = coverage
	// `--leak-check`: wire the process-exit leak gate (`mrt_leak_check`) so the
	// binary exits 101 if any allocation is live at exit. Standalone equivalent of
	// the spec runner's per-fragment leak gate; does NOT bypass the stdlib cache.
	project.leakCheckEnabled = leakCheck
	// `--fast`: use the fast register allocator (depth-0 recolor, no splitting,
	// tighter spill-loop cap). Off by default so a normal build is byte-identical.
	project.fastRegalloc = fastRegalloc
	// `--rc-sanitize`: include the `#if rcSanitize(true)` sanitizer regions in
	// stdlib/Internals.maxon (poison + quarantine freed mm allocations so the
	// first touch of a freed object panics). The parser's rcSanitize(...)
	// predicate reads this bit, so a default build (false) skips the regions at
	// parse time and is byte-identical; the stdlib cache filename carries the bit
	// so a sanitized and a normal stdlib coexist.
	project.rcSanitizeEnabled = rcSanitize
	// `--cache-stats` / `--cache-root=DIR` (internal, drives `maxon test-lib-cache`):
	// print the post-build CACHE_STATS line and/or redirect the library cache to a
	// throwaway temp dir. Both default off / empty, so a normal build is unchanged.
	project.cacheStatsEnabled = cacheStats
	project.cacheRootOverride = cacheRoot
	// `-o PATH` / `--output PATH`: override the output executable path (empty =
	// normal name derivation). See resolveBuildOutputPath.
	project.outputPathOverride = outputPathOverride
	// Phase 6: the external libraries to link = `--library=DIR` flags
	// (`libraryDirs`) ∪ `build.maxon` `library("...")` manifest entries, deduped
	// by absolute path. The manifest is resolved against the project DIRECTORY
	// (`userProjectDir`, the file's parent for a single-file build) — NOT
	// `rootPath`, which for `maxon build foo.maxon` is the file itself.
	project.libraryDirs = resolveProjectLibraryDirs(userProjectDir(project), cliDirs: libraryDirs)
	project.irDump = irDump
	let outputPath = try compileProject(project)

	// Write the final .ir file for --emit-ir. The code cache is populated by
	// compileProject above; caching is disabled when emitFinal is true so the
	// module reflects the just-finished compile. `skipStdlib: false` APPENDS the
	// reachable-filtered, post-DCE/post-inliner stdlib StdModule snapshot after the
	// user IR — the focused Std-level view (including refcount ops) of exactly the
	// stdlib functions `main` reaches. The user pipeline's final IR carries only
	// `main`'s body (stdlib lives in the cache and is merely linked), so without the
	// snapshot a `.ir` for a program that mostly drives stdlib (containers, strings)
	// shows almost nothing. The reachability filter keeps the cost near-zero for
	// trivial programs. (The spec `// CompiledIR` blocks use a SEPARATE path —
	// `finishInMemoryCompile(includeStdlibIr:)` — so golden output is unaffected.)
	if irDump.emitFinal 'hasEmit'
		let codeResult = project.db.codeCache.value
		let ir = finalIrString(project, codeResult: codeResult, skipStdlib: false)
		try File.writeText(irOutputPath, content: ir) otherwise 'writeErr'
			logInfo(LogCategory.compiler, message: function() gives "emit-ir: failed to write {irOutputPath}")
		end 'writeErr'
	end 'hasEmit'

	return outputPath
end 'compile'

// Pick the IR string appropriate for `--emit-ir` / the CompiledIR section of
// spec fragments. Native targets print the fully-lowered TargetModule;
// WASM bypasses target lowering so we fall back to the MIR.
//
// When `skipStdlib` is false, append the stdlib's post-DCE StdModule
// snapshot so spec tests with `IncludeStdlibIr: true` can inspect how
// optimization passes shaped the stdlib functions called from user code.
// Stdlib functions live in a separate cached StdModule (compiled once and
// linked from the on-disk cache) and aren't carried in the user pipeline's
// targetModule/mirModule, so they have to be rendered from the loader's
// snapshot rather than the user's final IR.
function finalIrString(project Project, codeResult CodeResult, skipStdlib bool) returns String
	var ir = ""
	if project.target.cpu == CpuArch.wasm32 'isWasm'
		ir = mirModuleToString(codeResult.mirModule, skipStdlib: skipStdlib)
	end 'isWasm' else 'isNative'
		ir = targetModuleToString(codeResult.targetModule, skipStdlib: skipStdlib, cpu: project.target.cpu)
	end 'isNative'
	if not skipStdlib 'appendStdlib'
		let stdlibModule = combinedInlinerStdModule()
		if stdlibModule.functions.count() > 0 'haveStdlib'
			let reachable = collectReachableStdlibFunctions(codeResult, stdlibModule: stdlibModule)
			if reachable.count() > 0 'haveReachable'
				ir = "{ir}\n// Stdlib StdModule (post-dce, post-inliner — pre-MIR-lowering, reachable from main only)\n{stdModuleToStringFiltered(stdlibModule, allowedNames: reachable)}"
			end 'haveReachable'
		end 'haveStdlib'
	end 'appendStdlib'
	return ir
end 'finalIrString'

// Walk the user pipeline's final IR (MIR for wasm, TargetModule for native)
// to collect statically-called stdlib function names, then close over the
// stdlib StdModule's own call ops so transitive callees show up too. The
// returned set is the input to `stdModuleToStringFiltered` so the
// IncludeStdlibIr snapshot stays focused on what the test actually exercises
// rather than dumping every stdlib function the cache happens to hold.
function collectReachableStdlibFunctions(codeResult CodeResult, stdlibModule StdModule) returns StdlibFuncNameSet
	var stdlibNames = StdlibFuncNameSet.create()
	for func in stdlibModule.functions 'index'
		stdlibNames.insert(func.name)
	end 'index'

	// MIR is populated for both wasm and native pipelines (the native flow
	// holds it on `codeResult.mirModule` alongside the target module), so
	// walking MIR gives us a single seeding path that works for either CPU.
	let seeds = collectUserCallNamesFromMir(codeResult.mirModule)

	var reachable = StdlibFuncNameSet.create()
	var worklist = StringArray.create()
	for name in seeds 'seedWorklist'
		if stdlibNames.contains(name) and not reachable.contains(name) 'isNew'
			reachable.insert(name)
			worklist.push(name)
		end 'isNew'
	end 'seedWorklist'

	var nameToFunc = StdlibFuncByName.create()
	for func in stdlibModule.functions 'buildIndex'
		nameToFunc.upsert(func.name, value: func)
	end 'buildIndex'

	var wi = 0
	while wi < worklist.count() 'walk'
		let name = try worklist.get(wi) otherwise 'skip'
			wi = wi + 1
			continue
		end 'skip'
		wi = wi + 1
		let func = try nameToFunc.get(name) otherwise continue
		for blockRef in func.blockRefs 'eachBlock'
			let block = try stdlibModule.blocks.get(blockRef) otherwise continue
			for opIdx in block.opRefs 'eachOp'
				let op = try stdlibModule.ops.get(opIdx) otherwise continue
				let calleeName = match op 'extract'
					call(c) gives extractStaticCalleeName(c)
					arith gives ""
					control gives ""
					memory gives ""
					system gives ""
				end 'extract'
				if not calleeName.isEmpty() and stdlibNames.contains(calleeName) and not reachable.contains(calleeName) 'newCallee'
					reachable.insert(calleeName)
					worklist.push(calleeName)
				end 'newCallee'
			end 'eachOp'
		end 'eachBlock'
	end 'walk'

	return reachable
end 'collectReachableStdlibFunctions'

typealias StdlibFuncByName = Map with (String, IrFunction)

// Phase 6: absolute-path dedup set for `resolveProjectLibraryDirs`.
typealias StringSet = Set with String

function extractStaticCalleeName(op StdCallOp) returns String
	return match op 'shape'
		call(_, callee, _) gives callee
		tryCall(_, callee, _, _) gives callee
		tailCall(callee, _) gives callee
		ret gives ""
		indirectCall gives ""
		witnessCall gives ""
		witnessTryCall gives ""
		funcRef gives ""
		param gives ""
		errorReturn gives ""
	end 'shape'
end 'extractStaticCalleeName'

function mirCallCalleeName(op MirOp) returns String
	return match op 'shape'
		call(_, callee, _) gives callee
		tryCall(_, callee, _, _) gives callee
		movImm to branch gives ""
		indirectCall to loadFramePtr gives ""
		osExit to osLockRelease gives ""
		// witnessTryCall dispatches through a witness table — no static callee.
		witnessTryCall gives ""
		errorReturn gives ""
	end 'shape'
end 'mirCallCalleeName'

function collectUserCallNamesFromMir(module MirModule) returns StringArray
	var seeds = StringArray.create()
	for func in module.functions 'eachFunc'
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise continue
			for opIdx in block.opRefs 'eachOp'
				let op = try module.ops.get(opIdx) otherwise continue
				let name = mirCallCalleeName(op)
				if not name.isEmpty() 'haveName'
					seeds.push(name)
				end 'haveName'
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
	return seeds
end 'collectUserCallNamesFromMir'

// Emit the companion .covmap so the aggregator can join per-site counters
// to source lines. Non-coverage builds stay byte-for-byte identical to
// pre-coverage builds — this writes nothing when coverage is disabled.
// `covMapPath` is the destination; callers that want the default "next to
// the exe" placement pass outputPath.changeExtension(".covmap").
function writeCovMapTo(project Project, covMapPath FilePath)
	if not project.coverageEnabled 'skip'
		return
	end 'skip'
	try writeCovMap(project.covSites, path: covMapPath) otherwise 'noWrite'
		logInfo(LogCategory.compiler, message: function() gives "Failed to write covmap to {covMapPath}")
	end 'noWrite'
end 'writeCovMapTo'

// Compiles source code directly from memory (no temp file) and returns IR.
// The caller picks `covMapPath`. `maxon build --coverage` wants the covmap
// next to the exe (outputPath.changeExtension(".covmap")); the spec runner
// redirects it into its per-suite .coverage directory. When coverage is off
// the path is ignored — no file is written.
export function compileSourceWithIr(source String, virtualPath FilePath, target Target, outputPath FilePath, coverage bool, covMapPath FilePath, includeStdlibIr bool = false, asyncTrace bool = false, leakCheck bool = false, rcSanitize bool = false) returns CompileWithIrResult throws CompileError
	let setupStart = passTimerStart()
	// Single-file fragment: rootPath = the file's parent directory (decision #3
	// in the directory-as-module redesign — single-file compiles have no module
	// prefix). Falls back to outputPath only when the virtual file has no
	// parent (defensive — runner always hands us an absolute path).
	let rootPath = try virtualPath.parent() otherwise outputPath
	var project = createProject(rootPath, target: target)
	project.coverageEnabled = coverage
	project.asyncTraceEnabled = asyncTrace
	project.leakCheckEnabled = leakCheck
	project.rcSanitizeEnabled = rcSanitize
	fileChanged(project, path: virtualPath, content: source)
	recordPassSince("__compile-setup", startMs: setupStart)

	return try finishInMemoryCompile(project, outputPath: outputPath, covMapPath: covMapPath, includeStdlibIr: includeStdlibIr)
end 'compileSourceWithIr'

// One in-memory file passed to the multi-file compile entry point. Defined
// here (not borrowed from the test runner) so the compiler stays free of
// `Testing/` types — callers populate this from whatever source-of-truth
// they have (spec-parsed fragments, language server, etc.).
export type VirtualSourceFile
	export var path as FilePath
	export var source as String

	export static function create(path FilePath, source String) returns VirtualSourceFile
		return Self{path: path, source: source}
	end 'create'
end 'VirtualSourceFile'

export typealias VirtualSourceFileArray = Array with VirtualSourceFile

// Multi-file variant of `compileSourceWithIr`: feed each pre-resolved
// virtual file to the project as a distinct compilation unit. Used by spec
// tests that author `// --- file: name.maxon` markers so cross-file
// references (exports, module visibility within a directory subtree)
// resolve the same way they would in a real on-disk project. The caller is
// responsible for choosing virtual paths whose layout matches the test's
// intent (e.g. siblings under one dir vs. nested subdirectories).
export function compileMultiFileSourceWithIr(files VirtualSourceFileArray, projectRoot FilePath, target Target, outputPath FilePath, coverage bool, covMapPath FilePath, includeStdlibIr bool = false, asyncTrace bool = false, leakCheck bool = false, rcSanitize bool = false) returns CompileWithIrResult throws CompileError
	if files.count() == 0 'noFiles'
		throw CompileError.noSourceFiles(outputPath)
	end 'noFiles'

	// Multi-file fragment: callers anchor the root explicitly (the spec
	// runner uses the fragment directory; on-disk builds use the project's
	// top-level). Using a fixed anchor matches the C# bootstrap's
	// `multiFileRoot = tempDir` behavior so `feature/helper.maxon` and
	// `feature/sub/deep.maxon` both derive their namespaces relative to the
	// same root (yielding `feature` and `feature.sub` respectively) — a
	// "deepest common ancestor" heuristic instead would collapse two
	// siblings under their nearest shared parent and lose those segments.
	var project = createProject(projectRoot, target: target)
	project.coverageEnabled = coverage
	project.asyncTraceEnabled = asyncTrace
	project.leakCheckEnabled = leakCheck
	project.rcSanitizeEnabled = rcSanitize
	for file in files 'eachFile'
		fileChanged(project, path: file.path, content: file.source)
	end 'eachFile'

	return try finishInMemoryCompile(project, outputPath: outputPath, covMapPath: covMapPath, includeStdlibIr: includeStdlibIr)
end 'compileMultiFileSourceWithIr'

// Shared tail for the in-memory compile entry points: run the code query,
// write the executable, emit the covmap, and capture IR.
function finishInMemoryCompile(project Project, outputPath FilePath, covMapPath FilePath, includeStdlibIr bool = false) returns CompileWithIrResult throws CompileError
	logInfo(LogCategory.compiler, message: function() gives "Starting in-memory compilation")
	// This path captures `finalIrString` from `codeResult.targetModule`, which
	// the chunk-driven incremental backend only populates with the MISS set
	// (cache-hit functions are served from `db.codePerFunc` and never re-lowered
	// into `targetModule`). A persisted user-chunk-cache hit would therefore
	// leave the dumped `CompiledIR` missing those functions. The whole-module
	// emitter lowers every function into `targetModule`, so disable the
	// incremental path (and, transitively, the user chunk cache, which gates on
	// `enableIncremental`) for any IR-capturing in-memory compile. Byte-output
	// is identical either way (the spec matrix guarantees chunk == whole-module).
	project.db.enableIncremental = false
	let codeStart = passTimerStart()
	let codeResult = try queryCodeResult(project)
	recordPassSince("__queryCodeResult", startMs: codeStart)

	let writeStart = passTimerStart()
	writeExecutable(outputPath, codeResult: codeResult, target: project.target, stdlibCache: combinedLibraryCache())
	recordPassSince("__writeExecutable", startMs: writeStart)
	logInfo(LogCategory.compiler, message: function() gives "Wrote {codeResult.code.count()} bytes code to {outputPath}")

	writeCovMapTo(project, covMapPath: covMapPath)

	let irStart = passTimerStart()
	let ir = finalIrString(project, codeResult: codeResult, skipStdlib: not includeStdlibIr)
	recordPassSince("__finalIrString", startMs: irStart)
	return CompileWithIrResult.create(outputPath, ir: ir)
end 'finishInMemoryCompile'

export type CompileWithIrResult
	export var outputPath as FilePath
	export var ir as String

	export static function create(outputPath FilePath, ir String) returns CompileWithIrResult
		return Self{outputPath: outputPath, ir: ir}
	end 'create'
end 'CompileWithIrResult'

// Compiles a project and returns the output executable path.
export function compileProject(project Project) returns FilePath throws CompileError
	logInfo(LogCategory.compiler, message: function() gives "Starting incremental compilation")

	try loadSourceFiles(project, path: project.rootPath)

	let codeResult = try queryCodeResult(project)

	let ext = executableExtension(project.target)
	let outputPath = try resolveBuildOutputPath(project, ext: ext)

	writeExecutable(outputPath, codeResult: codeResult, target: project.target, stdlibCache: combinedLibraryCache())

	logInfo(LogCategory.compiler, message: function() gives "Wrote {codeResult.code.count()} bytes code to {outputPath}")

	writeCovMapTo(project, covMapPath: outputPath.changeExtension(".covmap"))

	if project.cacheStatsEnabled 'emitCacheStats'
		emitCacheStatsLine(project)
	end 'emitCacheStats'

	return outputPath
end 'compileProject'

// Print the machine-readable `CACHE_STATS …` line the `maxon test-lib-cache`
// harness parses. Emitted on stdout after a `--cache-stats` build. Fields:
//   regalloc_hits / regalloc_misses — the per-function code-chunk (regalloc +
//     emit) cache hits/misses for the USER program this build (`project.db`).
//     A from-scratch build is all misses; a same-source rebuild is all hits.
//   stdlib_funcs — count of stdlib functions that carry real machine code in the
//     active cache (lazily-compiled bodies; the rest are deferred stubs).
//   stdlib_valid — whether the stdlib library cache is valid for this target
//     after the build (hit-or-just-written; the harness pairs this with its own
//     pre-build File.exists check to distinguish a cold build from a hit).
function emitCacheStatsLine(project Project)
	let hits = project.db.codePerFuncHits
	let misses = project.db.codePerFuncMisses
	let stdlibFuncs = countCompiledStdlibFunctions(getStdlibCacheData())
	var stdlibValid = "no"
	if isStdlibCacheValid() 'v'
		stdlibValid = "yes"
	end 'v'
	// v84 (Phase 7): the count of unchanged stdlib function bodies preserved
	// (Tier-C bytecode reused instead of re-regalloc'd / re-emitted) on the most
	// recent stdlib rebuild this process. 0 on a cache hit or a first-ever cold
	// build; >0 after a source edit that left most functions unchanged.
	print("CACHE_STATS regalloc_hits={hits} regalloc_misses={misses} stdlib_funcs={stdlibFuncs} stdlib_valid={stdlibValid} phase7_preserved={lastPreservedTierCCount}\n")
end 'emitCacheStatsLine'

// Resolves the output path. An explicit `-o`/`--output` override wins; otherwise
// uses the build name if available, falling back to the first source file.
function resolveBuildOutputPath(project Project, ext String) returns FilePath throws CompileError
	if not project.outputPathOverride.isEmpty() 'hasOverride'
		// Append the platform executable extension so `-o foo` still yields
		// `foo.exe` on Windows; `ext` is empty on macOS/Linux, so the override is
		// used verbatim there.
		return try FilePath.from("{project.outputPathOverride}{ext}") otherwise panic("resolveBuildOutputPath: invalid -o/--output path '{project.outputPathOverride}'")
	end 'hasOverride'
	if let buildName = try parseBuildName(project.rootPath) 'hasBuildName'
		return project.rootPath.join("{buildName}{ext}")
	end 'hasBuildName'
	let firstPath = try project.db.sourcePaths.get(0) otherwise panic("resolveBuildOutputPath: sourcePaths empty — loadSourceFiles should have thrown")
	return firstPath.changeExtension(ext)
end 'resolveBuildOutputPath'

// Parses build.maxon in the project root to extract the build name.
// Throws `BuildNameError.notFound` if no build.maxon or no build("...") call
// is present — callers use `if let` to take the named-build path and fall
// through to deriving the output name from the first source file. Exported so
// the Phase-5 user-program chunk cache (UserChunkCache.maxon) names its cache
// file after the same build name.
export function parseBuildName(projectRoot FilePath) returns String throws BuildNameError
	let buildPath = projectRoot.join("build.maxon")
	let content = try File.readText(buildPath) otherwise throw BuildNameError.notFound
	let marker = "build(\""
	var nameStart = try content.findFirst(marker) otherwise throw BuildNameError.notFound
	// Skip past 'build("' (7 chars) to get to the name
	for _ in 0 upto 7 'skipMarker'
		nameStart = try content.indexAfter(nameStart) otherwise throw BuildNameError.notFound
	end 'skipMarker'
	let rest = content.slice(nameStart, endIndex: content.endIndex())
	let nameEnd = try rest.findFirst("\"") otherwise throw BuildNameError.notFound
	return rest.slice(rest.startIndex(), endIndex: nameEnd)
end 'parseBuildName'

enum BuildNameError implements Error
	notFound
end 'BuildNameError'

// Phase 6: scan `build.maxon` for every `library("...")` manifest entry and
// return the referenced directories resolved against the project root. Scans
// `build.maxon` LINE BY LINE — one `library("...")` per line (the manifest
// convention, matching `build("...")`) — and extracts the first quoted path on
// any line containing the marker. Line-based scanning keeps each iteration's
// string locals to fresh `let` bindings off the `for` iterator, with no
// heap-managed local reassigned across the loop back-edge (a slice-derived-from-
// self reassignment leaks under the current SSA refcount inserter). A relative
// path is resolved against `projectRoot`; an absolute path is used as-is.
// Returns an empty array when there is no `build.maxon` or no `library(...)`
// entry.
export function parseLibraryDirs(projectRoot FilePath) returns FilePathArray
	var dirs = FilePathArray.create()
	let buildPath = projectRoot.join("build.maxon")
	let content = try File.readText(buildPath) otherwise return dirs
	for line in content.split("\n") 'eachLine'
		if let pathStr = try extractLibraryPath(line) 'hasPath'
			if not pathStr.isEmpty() 'nonEmpty'
				dirs.push(resolveLibraryDir(projectRoot, pathStr: pathStr))
			end 'nonEmpty'
		end 'hasPath'
	end 'eachLine'
	return dirs
end 'parseLibraryDirs'

// Extract the quoted path from a single `library("PATH")` manifest line, or
// throw `BuildNameError.notFound` if the line has no `library("` marker. Pure
// per-line slicing with no loop-carried state.
function extractLibraryPath(line String) returns String throws BuildNameError
	let marker = "library(\""
	var nameStart = try line.findFirst(marker) otherwise throw BuildNameError.notFound
	for _ in 0 upto marker.count() 'skipMarker'
		nameStart = try line.indexAfter(nameStart) otherwise throw BuildNameError.notFound
	end 'skipMarker'
	let afterMarker = line.slice(nameStart, endIndex: line.endIndex())
	let nameEnd = try afterMarker.findFirst("\"") otherwise throw BuildNameError.notFound
	return afterMarker.slice(afterMarker.startIndex(), endIndex: nameEnd)
end 'extractLibraryPath'

// Resolve a manifest/CLI library path string against the project root: absolute
// paths pass through, relative paths join onto `projectRoot`.
export function resolveLibraryDir(projectRoot FilePath, pathStr String) returns FilePath
	let p = try FilePath.from(pathStr) otherwise return projectRoot.join(pathStr)
	if p.isAbsolute() 'abs'
		return p
	end 'abs'
	return projectRoot.join(pathStr)
end 'resolveLibraryDir'

// Phase 6: the full external-library dir set for a build — the CLI
// `--library=DIR` strings (`cliDirs`) unioned with the `build.maxon`
// `library("...")` manifest entries, deduped by normalized-path string (a dir
// named both ways is linked once). CLI dirs resolve against the CURRENT WORKING
// DIRECTORY (matching how the positional source path is interpreted); manifest
// dirs resolve against `projectRoot` (relative to the `build.maxon` that names
// them). Order: CLI dirs first (in argument order), then manifest dirs, skipping
// any already present. The registry registers them in this order after stdlib.
function resolveProjectLibraryDirs(projectRoot FilePath, cliDirs StringArray) returns FilePathArray
	var resolved = FilePathArray.create()
	var seen = StringSet.create()
	let cwd = Directory.currentPath()
	for s in cliDirs 'eachCli'
		appendLibraryDirDeduped(resolveLibraryDir(cwd, pathStr: s), into: resolved, seen: seen)
	end 'eachCli'
	for dir in parseLibraryDirs(projectRoot) 'eachManifest'
		appendLibraryDirDeduped(dir, into: resolved, seen: seen)
	end 'eachManifest'
	return resolved
end 'resolveProjectLibraryDirs'

// Append `dir` to `into` unless its absolute-path string is already in `seen`.
function appendLibraryDirDeduped(dir FilePath, into FilePathArray, seen StringSet)
	let key = absolutePathKey(dir)
	if seen.contains(key) 'dup'
		return
	end 'dup'
	seen.insert(key)
	into.push(dir)
end 'appendLibraryDirDeduped'

// The dedup key for a library dir: its normalized path string (so `foo/../foo`
// and `foo`, or differing separators, collapse). The dirs are already absolute
// or root-joined by `resolveLibraryDir`, so normalization is enough to dedupe.
function absolutePathKey(dir FilePath) returns String
	return dir.normalize().toString()
end 'absolutePathKey'

// Phase 6: register every external library this project links into the library
// registry (stdlib-first is preserved because stdlib is auto-registered at
// index 0 by `getStdlibModule` BEFORE this runs in `queryAllModule`). The set is
// `project.libraryDirs` (the CLI `--library=DIR` dirs ∪ the `build.maxon`
// `library("...")` manifest dirs, already merged + absolute-path-deduped by the
// build driver). Each dir is parsed under its own namespace anchor, built/loaded
// to its own shared cache, and surfaced through the Phase-4 combined accessors.
// A missing directory or a duplicate basename is reported as a diagnostic and
// fails the build (no silent skip). With an empty `libraryDirs` this is a no-op
// and the registry stays stdlib-only (Phase-4 byte parity).
export function registerProjectLibraries(project Project) throws CompileError
	for dir in project.libraryDirs 'eachLib'
		if not Directory.exists(dir) 'missing'
			reportSemanticError(project, code: ErrorCode.semanticLibraryNotFound, message: "library directory not found: {dir}")
			throw CompileError.directoryNotFound(dir)
		end 'missing'
		try registerExternalLibrary(project, rootDir: dir, target: project.target) otherwise (e) 'libErr'
			match e 'kind'
				duplicateName(n) then reportSemanticError(project, code: ErrorCode.semanticLibraryDuplicateName, message: "two libraries resolve to the same name '{n}' — library directory basenames must be unique")
				directoryNotFound(p) then reportSemanticError(project, code: ErrorCode.semanticLibraryNotFound, message: "library directory not found: {p}")
				parseError(p) then logError(LogCategory.compiler, message: function() gives "library parse failed in {p} (see diagnostics above)")
			end 'kind'
			throw CompileError.compileError
		end 'libErr'
	end 'eachLib'
end 'registerProjectLibraries'

// --- Source file loading ---

function loadSourceFiles(project Project, path FilePath) throws CompileError
	if File.exists(path) 'isFile'
		logTrace(LogCategory.compiler, message: function() gives "Loading single file: {path}")

		if isIgnoredPath(path) 'ignored'
			return
		end 'ignored'

		try loadOneSourceFile(project, path: path)
	end 'isFile' else if Directory.exists(path) 'isDir'
		logTrace(LogCategory.compiler, message: function() gives "Loading directory: {path}")

		if isIgnoredPath(path) 'ignored'
			return
		end 'ignored'

		try loadSourceDirectory(project, dir: path)

		// Path does not exist.
	end 'isDir' else 'notFound'
		throw CompileError.fileNotFound(path)
	end 'notFound'

	if project.db.sourcePaths.count() == 0 'noFiles'
		throw CompileError.noSourceFiles(path)
	end 'noFiles'
end 'loadSourceFiles'

// Recursively load every `.maxon` source file under `dir`, descending into
// subdirectories. Mirrors the C# bootstrap's `Directory.GetFiles(path,
// "*.maxon", SearchOption.AllDirectories)` so a multi-directory project (like
// the self-hosted compiler itself) loads its whole tree, not just the top
// level.
function loadSourceDirectory(project Project, dir FilePath) throws CompileError
	let dirEntries = try Directory.list(dir) otherwise throw CompileError.directoryNotFound(dir)

	for entry in dirEntries 'loop'
		if Directory.isDirectory(entry) 'isSubdir'
			if isIgnoredPath(entry) 'ignoredSub'
				continue
			end 'ignoredSub'
			try loadSourceDirectory(project, dir: entry)
			continue
		end 'isSubdir'

		let name = entry.filename()
		if name == "build.maxon" 'isBuildFile'
			continue
		end 'isBuildFile'
		if name.endsWith(".maxon") 'isMaxon'
			try loadOneSourceFile(project, path: entry)
		end 'isMaxon'
	end 'loop'
end 'loadSourceDirectory'

// Read, fragment-strip, and register a single source file with the project.
function loadOneSourceFile(project Project, path FilePath) throws CompileError
	logTrace(LogCategory.compiler, message: function() gives "Loading file: {path}")

	let rawContent = try File.readText(path) otherwise throw CompileError.readError(path)

	let content = stripTestFragments(path, content: rawContent)
	fileChanged(project, path: path, content: content)
end 'loadOneSourceFile'

// Spec `.test` files contain Maxon source followed by one or more `---`
// separators delimiting the expected output. Strip everything from the first
// separator onward so `maxon build foo.test` compiles only the source section.
function stripTestFragments(path FilePath, content String) returns String
	if path.fileExtension() != ".test" 'notTest'
		return content
	end 'notTest'
	let separator = "\n---"
	let sepIndex = try content.findFirst(separator) otherwise return content
	return content.slice(content.startIndex(), endIndex: sepIndex)
end 'stripTestFragments'

function isIgnoredPath(path FilePath) returns bool
	var dir = try path.parent() otherwise return false
	while true 'walk'
		if File.exists(dir.join(".maxonignore")) 'found'
			return true
		end 'found'
		dir = try dir.parent() otherwise return false
	end 'walk'
	return false
end 'isIgnoredPath'
