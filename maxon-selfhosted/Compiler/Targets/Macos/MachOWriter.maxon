// Mach-O file writer for macOS ARM64 executables.
// Produces a Mach-O with __TEXT, __DATA (GOT), __LINKEDIT segments.
// Uses libSystem.B.dylib for _exit and write via GOT + chained fixups.
// Includes ad-hoc code signature (required on Apple Silicon).

let MACHO_PAGE_SIZE = 0x4000
let MACHO_TEXT_VM_ADDR = 0x100000000
let MACHO_PAGEZERO_SIZE = 0x100000000

// Mach-O header constants
let MH_MAGIC_64 = 0xFEEDFACF
let CPU_TYPE_ARM64 = 0x0100000C
let CPU_SUBTYPE_ARM64_ALL = 0
let MH_EXECUTE = 2
let MH_DYLDLINK = 0x4
let MH_TWOLEVEL = 0x80
let MH_PIE = 0x200000

// Load command types
let LC_SEGMENT_64 = 0x19
let LC_SYMTAB = 0x02
let LC_DYSYMTAB = 0x0B
let LC_CODE_SIGNATURE = 0x1D
let LC_MAIN = 0x80000028
let LC_LOAD_DYLIB = 0x0C
let LC_LOAD_DYLINKER = 0x0E
let LC_UUID = 0x1B
let LC_BUILD_VERSION = 0x32
let LC_DYLD_CHAINED_FIXUPS = 0x80000034
let LC_DYLD_EXPORTS_TRIE = 0x80000033

// Protection flags
let VM_PROT_READ = 0x01
let VM_PROT_WRITE = 0x02
let VM_PROT_EXECUTE = 0x04

// Section flags
let S_REGULAR = 0x00000000
let S_ZEROFILL = 0x00000001
let S_ATTR_PURE_INSTRUCTIONS = 0x80000000
let S_ATTR_SOME_INSTRUCTIONS = 0x00000400

// Code signature constants
let CSMAGIC_EMBEDDED_SIGNATURE = 0xFADE0CC0
let CSMAGIC_CODEDIRECTORY = 0xFADE0C02
let CSSLOT_CODEDIRECTORY = 0
let CS_ADHOC = 0x2
let CS_LINKER_SIGNED = 0x20000
let CS_HASHTYPE_SHA256 = 2
let CS_SHA256_LEN = 32
let CS_PAGE_SIZE_LOG2 = 12

// Chained fixup constants. Pointer format 6 is DYLD_CHAINED_PTR_64_OFFSET (the
// plain DYLD_CHAINED_PTR_64 is value 2): a rebase entry's `target` field holds
// the runtime OFFSET from the image base, and dyld computes the final pointer as
// mach_header_address + target (so it is slide-safe). Bind entries are identical
// across both 64-bit formats (they use the ordinal field, not target).
let DYLD_CHAINED_PTR_64_OFFSET = 6
let DYLD_CHAINED_IMPORT = 1

// page_start sentinel: this page of the segment carries no fixups.
let DYLD_CHAINED_PTR_START_NONE = 0xFFFF

// Import names for macOS dyld chained-fixup imports. The Mach-O writer
// currently targets arm64-macos only; x64-macos has no Mach-O writer yet
// and remains broken at the link stage. The new `_NSGetExecutablePath`
// slot is consumed by the ARM64 `osGetExecutablePath` lowering.
export let MACHO_IMPORT_SLOT_EXIT = 0
export let MACHO_IMPORT_SLOT_WRITE = 1
export let MACHO_IMPORT_SLOT_NSGETEXECUTABLEPATH = 2
export let MACHO_IMPORT_SLOT_MMAP = 3
export let MACHO_IMPORT_SLOT_MUNMAP = 4
export let MACHO_IMPORT_SLOT_OPEN = 5
export let MACHO_IMPORT_SLOT_CLOSE = 6
export let MACHO_IMPORT_SLOT_READ = 7
let MACHO_IMPORT_SLOT_GETENV = 8
export let MACHO_IMPORT_SLOT_GETTIMEOFDAY = 9
let MACHO_IMPORT_SLOT_NANOSLEEP = 10
export let MACHO_IMPORT_SLOT_RENAME = 11
export let MACHO_IMPORT_SLOT_LSEEK = 12
export let MACHO_IMPORT_SLOT_STAT = 13
export let MACHO_IMPORT_SLOT_ACCESS = 14
export let MACHO_IMPORT_SLOT_UNLINK = 15
export let MACHO_IMPORT_SLOT_GETCWD = 16
export let MACHO_IMPORT_SLOT_MKDIR = 17
export let MACHO_IMPORT_SLOT_USLEEP = 18
let MACHO_IMPORT_SLOT_TIME = 19
export let MACHO_IMPORT_SLOT_GETDIRENTRIES64 = 20
export let MACHO_IMPORT_SLOT_ERROR = 21
export let MACHO_IMPORT_SLOT_STRLEN = 22

// Subprocess runtime (arm64-macos): posix_spawn + pipes + waitpid. The
// hand-emitted maxon_subprocess_* helpers (Arm64MacosSubprocess.maxon) call
// these via iatCall, mirroring the C# bootstrap's arm64 subprocess.
export let MACHO_IMPORT_SLOT_PIPE = 23
export let MACHO_IMPORT_SLOT_POSIX_SPAWN = 24
export let MACHO_IMPORT_SLOT_SPAWN_FA_INIT = 25
export let MACHO_IMPORT_SLOT_SPAWN_FA_ADDDUP2 = 26
export let MACHO_IMPORT_SLOT_SPAWN_FA_ADDCLOSE = 27
export let MACHO_IMPORT_SLOT_SPAWN_FA_ADDOPEN = 28
export let MACHO_IMPORT_SLOT_SPAWN_FA_ADDCHDIR = 29
export let MACHO_IMPORT_SLOT_SPAWN_FA_DESTROY = 30
export let MACHO_IMPORT_SLOT_WAITPID = 31
export let MACHO_IMPORT_SLOT_NSGETENVIRON = 32

// kill(pid, sig): used by maxon_subprocess_wait_collect's timeout path (SIGKILL
// the child once the deadline elapses) and by maxon_subprocess_kill.
export let MACHO_IMPORT_SLOT_KILL = 33

// fcntl(fd, cmd, arg): used by maxon_subprocess_spawn_streaming to set the
// parent's stdout/stderr pipe read ends O_NONBLOCK, so the streaming line reader
// can poll-read + __gt_yield cooperatively (the single-thread green-thread runtime
// has no kqueue / __io_submit_read to park on, unlike the C# GMP scheduler).
export let MACHO_IMPORT_SLOT_FCNTL = 34

// Tier-4 multi-M (GMP) scheduler runtime (Arm64MacosGreenThread.maxon multi-M port):
// a pthread worker pool, each OS thread's ProcContext* held in a pthread TLS key,
// sysconf for the CPU count, kqueue/kevent for multi-M I/O completion, and
// sigaction/sigaltstack for the per-thread CPU-fault handler. The dispatch_semaphore
// slots 40..43 below are LEGACY (no longer called): worker park/wake moved to the
// pthread mutex+cond wake lock block at slots 48..54 (see there) to avoid the
// dispatch_semaphore UE-wedge on kill. They stay bound for slot-numbering stability.
// All resolve in libSystem (libpthread + libdispatch are part of it).
export let MACHO_IMPORT_SLOT_PTHREAD_CREATE = 35
export let MACHO_IMPORT_SLOT_PTHREAD_KEY_CREATE = 36
export let MACHO_IMPORT_SLOT_PTHREAD_SETSPECIFIC = 37
let MACHO_IMPORT_SLOT_PTHREAD_GETSPECIFIC = 38
export let MACHO_IMPORT_SLOT_SYSCONF = 39

// Not exported: these LEGACY dispatch_semaphore slots are no longer referenced
// anywhere (worker park/wake moved to slots 48..54). They stay declared (as
// non-exported `let`, like MACHO_IMPORT_SLOT_PTHREAD_GETSPECIFIC above) only to
// hold slots 40..43 so the surrounding slot numbering is undisturbed.
let MACHO_IMPORT_SLOT_DISPATCH_SEMAPHORE_CREATE = 40
let MACHO_IMPORT_SLOT_DISPATCH_SEMAPHORE_WAIT = 41
let MACHO_IMPORT_SLOT_DISPATCH_SEMAPHORE_SIGNAL = 42
let MACHO_IMPORT_SLOT_DISPATCH_TIME = 43
export let MACHO_IMPORT_SLOT_KQUEUE = 44
export let MACHO_IMPORT_SLOT_KEVENT = 45
export let MACHO_IMPORT_SLOT_SIGACTION = 46
export let MACHO_IMPORT_SLOT_SIGALTSTACK = 47

// slots 48..56: Go-style worker M park/wake via a pthread mutex+cond+count wake lock
// block (replaces the libdispatch dispatch_semaphore at slots 40..43, which is
// Mach-port-backed and not async-signal-safe — it wedged killed processes in macOS
// 'UE' state). Plus sigprocmask + raise for the dieFromSignal SIGTERM/SIGINT handler
// (async-signal-safe re-raise so a catchable kill terminates with the correct
// disposition). All resolve in libSystem (libpthread is part of it).
export let MACHO_IMPORT_SLOT_PTHREAD_MUTEX_INIT = 48
export let MACHO_IMPORT_SLOT_PTHREAD_MUTEX_LOCK = 49
export let MACHO_IMPORT_SLOT_PTHREAD_MUTEX_UNLOCK = 50
export let MACHO_IMPORT_SLOT_PTHREAD_COND_INIT = 51
export let MACHO_IMPORT_SLOT_PTHREAD_COND_WAIT = 52
export let MACHO_IMPORT_SLOT_PTHREAD_COND_TIMEDWAIT_RELATIVE_NP = 53
export let MACHO_IMPORT_SLOT_PTHREAD_COND_SIGNAL = 54
export let MACHO_IMPORT_SLOT_SIGPROCMASK = 55
export let MACHO_IMPORT_SLOT_RAISE = 56

// madvise(addr, len, advice): slab scavenger page discard (osDecommitPages).
export let MACHO_IMPORT_SLOT_MADVISE = 57

// usleep(microseconds) is already imported at slot 18 (MACHO_IMPORT_SLOT_USLEEP);
// the wait-collect timeout poll loop reuses it for its inter-poll sleep.
let MACHO_IMPORT_COUNT = 58

// libSystem symbols imported via dyld chained-fixup binds, in slot order (see
// MACHO_IMPORT_SLOT_* above). buildChainedFixups iterates this to emit both the
// import table and the symbol pool, so adding an import is three edits: append
// its "_name" here, add a MACHO_IMPORT_SLOT_* constant, and bump
// MACHO_IMPORT_COUNT.
function machoImportNames() returns StringArray
	var names = StringArray.create()
	names.push("_exit")
	names.push("_write")
	// C source name is `_NSGetExecutablePath`; the Mach-O symbol carries the
	// extra C-ABI leading underscore, so it is `__NSGetExecutablePath`.
	names.push("__NSGetExecutablePath")
	names.push("_mmap")
	names.push("_munmap")
	names.push("_open")
	names.push("_close")
	names.push("_read")
	names.push("_getenv")
	names.push("_gettimeofday")
	names.push("_nanosleep")
	names.push("_rename")
	// File-I/O libSystem entry points (slots 12..17). macOS forbids raw syscalls,
	// so the arm64 file-I/O ops call these imports just like _open/_read/_write.
	// `_stat` is the arm64 64-bit-inode default (no $INODE64 suffix on arm64).
	names.push("_lseek")
	names.push("_stat")
	names.push("_access")
	names.push("_unlink")
	names.push("_getcwd")
	names.push("_mkdir")
	// osSleep → usleep(microseconds) (single-arg libcall; avoids nanosleep's
	// timespec marshalling). slot 18.
	names.push("_usleep")
	// osClockMs → time(NULL) seconds (single-arg libcall; avoids gettimeofday's
	// timeval struct). slot 19.
	names.push("_time")
	// Directory enumeration (osDirGetdents64). macOS arm64 dropped the usable
	// `getdirentries`/`getdirentries$INODE64` exports for the 64-bit-inode world
	// (they resolve to a link-time "not available" stub), so we call the
	// lower-level 64-bit-inode entry `___getdirentries64(fd, buf, nbytes, &basep)`.
	// slot 20.
	names.push("___getdirentries64")
	// errno access: libSystem sets the thread-local errno on failure and returns
	// -1 (not Linux's -errno). `___error()` returns &errno so the file-op
	// lowerings can rebuild the Linux -errno convention the runtime classifiers
	// expect. slot 21.
	names.push("___error")
	// strlen: osGetExecutablePath calls `_NSGetExecutablePath`, which
	// NUL-terminates the buffer but leaves `*bufsize` unchanged on success
	// (unlike Linux readlink, which returns the byte count). The arm64-macos
	// lowering calls `_strlen(buf)` after the call to recover the real path
	// length. slot 22.
	names.push("_strlen")
	// Subprocess runtime (slots 23..32). The Mach-O symbol is the C name with a
	// leading underscore; `_NSGetEnviron`'s C name already starts with one so it
	// doubles to `__NSGetEnviron` (same as `__NSGetExecutablePath`).
	names.push("_pipe")
	names.push("_posix_spawn")
	names.push("_posix_spawn_file_actions_init")
	names.push("_posix_spawn_file_actions_adddup2")
	names.push("_posix_spawn_file_actions_addclose")
	names.push("_posix_spawn_file_actions_addopen")
	names.push("_posix_spawn_file_actions_addchdir_np")
	names.push("_posix_spawn_file_actions_destroy")
	names.push("_waitpid")
	names.push("__NSGetEnviron")
	names.push("_kill")
	// slot 34: fcntl, for setting the streaming pipe read ends O_NONBLOCK.
	names.push("_fcntl")
	// slots 35..47: Tier-4 multi-M scheduler (pthread worker pool + a TLS key for
	// the per-OS-thread P*, sysconf for the CPU count, kqueue/kevent for multi-M I/O,
	// sigaction/sigaltstack for the fault handler). The dispatch_semaphore_* +
	// dispatch_time at slots 40..43 are legacy/unused (park/wake moved to the pthread
	// wake lock block at slots 48..54) but stay bound for slot-numbering stability.
	names.push("_pthread_create")
	names.push("_pthread_key_create")
	names.push("_pthread_setspecific")
	names.push("_pthread_getspecific")
	names.push("_sysconf")
	names.push("_dispatch_semaphore_create")
	names.push("_dispatch_semaphore_wait")
	names.push("_dispatch_semaphore_signal")
	names.push("_dispatch_time")
	names.push("_kqueue")
	names.push("_kevent")
	names.push("_sigaction")
	names.push("_sigaltstack")
	// slots 48..56: Go-style worker park/wake (pthread mutex+cond+count wake lock
	// block) + the dieFromSignal SIGTERM/SIGINT handler's sigprocmask + raise.
	names.push("_pthread_mutex_init")
	names.push("_pthread_mutex_lock")
	names.push("_pthread_mutex_unlock")
	names.push("_pthread_cond_init")
	names.push("_pthread_cond_wait")
	names.push("_pthread_cond_timedwait_relative_np")
	names.push("_pthread_cond_signal")
	names.push("_sigprocmask")
	names.push("_raise")
	// slot 57: slab scavenger page discard (osDecommitPages → madvise(MADV_FREE)).
	names.push("_madvise")
	return names
end 'machoImportNames'

// nlist_64 type/sect bits used for debug symbols.
let N_EXT = 0x01
let N_SECT = 0x0E
let MACHO_TEXT_SECT_INDEX = 1

typealias MachoStrOffsetArray = Array with ByteOffset

// --- Segment/Section header helpers ---

function writeSegName(buf ByteArray, name String)
	var written = 0
	for ch in name 'chars'
		// Sentinel: non-ASCII characters become null byte; segment names are always ASCII literals at call sites.
		let b = try ch.asciiValue() otherwise 0
		buf.push(b)
		written = written + 1
	end 'chars'
	while written < 16 'pad'
		buf.push(0)
		written = written + 1
	end 'pad'
end 'writeSegName'

function writeSegmentCommand(buf ByteArray, segname String, vmaddr MachineWord, vmsize MachineWord, fileoff MachineWord, filesize MachineWord, maxprot MachineWord, initprot MachineWord, nsects MachineWord)
	writeDword(buf, value: LC_SEGMENT_64)
	writeDword(buf, value: 72 + 80 * nsects)
	writeSegName(buf, name: segname)
	writeQword(buf, value: vmaddr)
	writeQword(buf, value: vmsize)
	writeQword(buf, value: fileoff)
	writeQword(buf, value: filesize)
	writeDword(buf, value: maxprot)
	writeDword(buf, value: initprot)
	writeDword(buf, value: nsects)
	writeDword(buf, value: 0)
end 'writeSegmentCommand'

function writeMachOSectionHeader(buf ByteArray, sectname String, segname String, addr MachineWord, size MachineWord, offset MachineWord, alignVal MachineWord, flags MachineWord)
	writeSegName(buf, name: sectname)
	writeSegName(buf, name: segname)
	writeQword(buf, value: addr)
	writeQword(buf, value: size)
	writeDword(buf, value: offset)
	writeDword(buf, value: alignVal)
	writeDword(buf, value: 0)  // reloff
	writeDword(buf, value: 0)  // nreloc
	writeDword(buf, value: flags)
	writeDword(buf, value: 0)  // reserved1
	writeDword(buf, value: 0)  // reserved2
	writeDword(buf, value: 0)  // reserved3
end 'writeMachOSectionHeader'

// --- Chained fixups builder ---

// `pageStarts` has one entry per file-backed page of the __DATA segment, in
// page order: the leading rdata pages (each holding the in-page byte offset of
// the first funcAbs64 rebase, or DYLD_CHAINED_PTR_START_NONE) followed by the
// __got page (offset of the first import bind). dyld walks each page's chain
// from this start via the per-entry `next` field.
function buildChainedFixups(dataSegmentFileOff MachineWord, pageStarts CodeOffsetArray) returns ByteArray
	var cf = ByteArray.create()
	cf.reserve(256)

	// Header (0x20 bytes)
	let startsOffset = 0x20
	let segCount = 4
	let startsSize = 4 + segCount * 4
	let pageCount = pageStarts.count()
	// dyld_chained_starts_in_segment: size(4)+page_size(2)+pointer_format(2)+
	// segment_offset(8)+max_valid_pointer(4)+page_count(2)+page_start[pageCount].
	let dataSegStartsSize = 22 + 2 * pageCount
	let dataSegStartsOffset = startsSize

	let importsOffset = alignUp(startsOffset + startsSize + dataSegStartsSize, alignment: 4)

	// Symbol pool: leading \0 byte then each import name as `_name\0`.
	// See `MACHO_IMPORT_SLOT_*` for the slot-index assignment.
	let symbolsOffset = importsOffset + (MACHO_IMPORT_COUNT * 4)

	// Header fields
	writeDword(cf, value: 0)  // fixups_version
	writeDword(cf, value: startsOffset)
	writeDword(cf, value: importsOffset)
	writeDword(cf, value: symbolsOffset)
	writeDword(cf, value: MACHO_IMPORT_COUNT)
	writeDword(cf, value: DYLD_CHAINED_IMPORT)
	writeDword(cf, value: 0)  // symbols_format
	writeDword(cf, value: 0)  // padding to 0x20

	// Starts section (at offset 0x20)
	writeDword(cf, value: segCount)
	writeDword(cf, value: 0)  // seg 0 (PAGEZERO): no starts
	writeDword(cf, value: 0)  // seg 1 (TEXT): no starts
	writeDword(cf, value: dataSegStartsOffset)  // seg 2 (DATA): has starts
	writeDword(cf, value: 0)  // seg 3 (LINKEDIT): no starts

	// DATA segment starts
	writeDword(cf, value: dataSegStartsSize)
	writeWord(cf, value: MACHO_PAGE_SIZE)
	writeWord(cf, value: DYLD_CHAINED_PTR_64_OFFSET)
	writeQword(cf, value: dataSegmentFileOff)
	writeDword(cf, value: 0)  // max_valid_pointer
	writeWord(cf, value: pageCount)
	for ps in pageStarts 'eachPageStart'
		writeWord(cf, value: ps)
	end 'eachPageStart'

	// Pad to imports offset
	while cf.count() < importsOffset 'padToImports'
		cf.push(0)
	end 'padToImports'

	// Import entries (4 bytes each): lib_ordinal=1, weak=0, name_offset.
	// Symbol offsets are counted from the start of the symbol pool, which
	// begins with a leading NUL byte; that's why each name offset starts
	// at the byte after the previous `_name\0` (6 bytes for `_exit\0`,
	// 7 bytes for `_write\0`, 21 bytes for `_NSGetExecutablePath\0`).
	// Import entries (4 bytes each): lib_ordinal=1, weak=0, name_offset. Symbol
	// offsets are counted from the start of the symbol pool, which begins with a
	// leading NUL byte, so the first real name sits at offset 1 and each
	// subsequent name follows the previous `_name\0`.
	let importNames = machoImportNames()
	var nameOff = 1
	for name in importNames 'eachImport'
		let importEntry = 1 or (0 shl 8) or (nameOff shl 9)
		writeDword(cf, value: importEntry)
		nameOff = nameOff + name.byteLength() + 1
	end 'eachImport'

	// Symbol pool: leading NUL then each `_name\0`.
	cf.push(0)  // leading null
	for name in importNames 'eachSymbol'
		cf.append(name.toByteArray())
		cf.push(0)
	end 'eachSymbol'

	// Align to 8
	while cf.count() mod 8 != 0 'alignCf'
		cf.push(0)
	end 'alignCf'

	return cf
end 'buildChainedFixups'

// --- GOT builder ---

function buildGot() returns ByteArray
	var got = ByteArray.create()
	got.reserve(MACHO_IMPORT_COUNT * 8)

	// Build chained fixup bind entries for the GOT, one per import slot.
	// Entry format: bit63=1 (bind), bits 51-62=next (stride in 8-byte
	// units), bits 0-23=ordinal. Every entry except the last points 2
	// qwords ahead (16 bytes / 8); the last entry has next=0.
	var slot = 0
	while slot < MACHO_IMPORT_COUNT 'eachSlot'
		let isLast = slot == MACHO_IMPORT_COUNT - 1
		let nextField = 0 if isLast else 2
		let entry = (1 shl 63) or (nextField shl 51) or slot
		writeQword(got, value: entry)
		slot = slot + 1
	end 'eachSlot'

	return got
end 'buildGot'

// --- ADRP+LDR relocation patching for Mach-O ---

function patchRelocationsMachO(code ByteArray, relocations RelocationArray, textSectionVMAddr MachineWord, gotSectionVMAddr MachineWord)
	for reloc in relocations 'patch'
		let gotEntryVA = gotSectionVMAddr + (reloc.slotIndex * 8)
		let instrVA = textSectionVMAddr + reloc.codeOffset

		// ADRP: target page relative to instruction page
		let instrPage = instrVA and not 0xFFF
		let targetPage = gotEntryVA and not 0xFFF
		let pageOff = targetPage - instrPage
		let pageOffShifted = pageOff shr 12
		let immlo = pageOffShifted and 0x3
		let immhi = (pageOffShifted shr 2) and 0x7FFFF
		let origAdrp = try readDword(code, offset: reloc.codeOffset) otherwise panic("MachOWriter: reloc.codeOffset {reloc.codeOffset} past end of emitted code (count={code.count()}) — relocation/emitter bug")
		let rd = origAdrp and 0x1F
		let patchedAdrp = (immlo shl 29) or 0x90000000 or (immhi shl 5) or rd
		patchDword(code, offset: reloc.codeOffset, value: patchedAdrp)

		// LDR: page offset within the 4KB page, scaled by 8
		let pageOffset = gotEntryVA and 0xFFF
		let ldrOffset = reloc.codeOffset + 4
		let origLdr = try readDword(code, offset: ldrOffset) otherwise panic("MachOWriter: ldrOffset {ldrOffset} past end of emitted code (count={code.count()}) — relocation/emitter bug")
		let ldrImm = (pageOffset / 8) and 0xFFF
		let patchedLdr = (origLdr and 0xFFC003FF) or (ldrImm shl 10)
		patchDword(code, offset: ldrOffset, value: patchedLdr)
	end 'patch'
end 'patchRelocationsMachO'

// --- Code signature builder ---

function buildCodeSignature(fileData ByteArray, codeLimit MachineWord, execSegLimit MachineWord, identifierStr String) returns ByteArray
	let hashPageSize = 1 shl CS_PAGE_SIZE_LOG2
	let nCodeSlots = (codeLimit + hashPageSize - 1) / hashPageSize

	// Compute identifier bytes
	var identifierBytes = ByteArray.create()
	for ch in identifierStr 'chars'
		// Sentinel: non-ASCII becomes null byte; code-signature identifiers are always ASCII.
		let b = try ch.asciiValue() otherwise 0
		identifierBytes.push(b)
	end 'chars'
	let identLen = identifierBytes.count() + 1

	// CodeDirectory layout
	let cdHeaderSize = 88
	let hashOffset = cdHeaderSize + identLen
	let cdSize = hashOffset + nCodeSlots * CS_SHA256_LEN

	// SuperBlob: header (12) + 1 BlobIndex (8) + CodeDirectory
	let superBlobHeaderSize = 12 + 8
	let codeSignatureSize = superBlobHeaderSize + cdSize

	var sig = ByteArray.create()
	sig.reserve(codeSignatureSize)

	// SuperBlob header (big-endian)
	writeDwordBE(sig, value: CSMAGIC_EMBEDDED_SIGNATURE)
	writeDwordBE(sig, value: codeSignatureSize)
	writeDwordBE(sig, value: 1)  // count = 1 blob

	// BlobIndex[0]
	writeDwordBE(sig, value: CSSLOT_CODEDIRECTORY)
	writeDwordBE(sig, value: superBlobHeaderSize)  // offset to CodeDirectory

	// CodeDirectory (big-endian)
	writeDwordBE(sig, value: CSMAGIC_CODEDIRECTORY)
	writeDwordBE(sig, value: cdSize)
	writeDwordBE(sig, value: 0x20400)  // version
	writeDwordBE(sig, value: CS_ADHOC or CS_LINKER_SIGNED)  // flags
	writeDwordBE(sig, value: hashOffset)  // hashOffset
	writeDwordBE(sig, value: cdHeaderSize)  // identOffset
	writeDwordBE(sig, value: 0)  // nSpecialSlots
	writeDwordBE(sig, value: nCodeSlots)  // nCodeSlots
	writeDwordBE(sig, value: codeLimit)  // codeLimit
	sig.push(CS_SHA256_LEN)  // hashSize
	sig.push(CS_HASHTYPE_SHA256)  // hashType
	sig.push(0)  // platform
	sig.push(CS_PAGE_SIZE_LOG2)  // pageSize (log2)
	writeDwordBE(sig, value: 0)  // spare2
	writeDwordBE(sig, value: 0)  // scatterOffset
	writeDwordBE(sig, value: 0)  // teamOffset
	writeDwordBE(sig, value: 0)  // spare3
	writeQwordBE(sig, value: 0)  // codeLimit64
	writeQwordBE(sig, value: 0)  // execSegBase (__TEXT starts at file offset 0)
	writeQwordBE(sig, value: execSegLimit)  // execSegLimit = __TEXT file size; AMFI rejects a 0-length exec segment
	writeQwordBE(sig, value: 0x1)  // execSegFlags (CS_EXECSEG_MAIN_BINARY)

	// Identifier (null-terminated)
	sig.append(identifierBytes)
	sig.push(0)

	// Page hashes (SHA-256 of each 4096-byte page)
	var slot = 0
	while slot < nCodeSlots 'hashPages'
		let pageStart = slot * hashPageSize
		var pageEnd = pageStart + hashPageSize
		if pageEnd > codeLimit 'clamp'
			pageEnd = codeLimit
		end 'clamp'
		let pageLen = pageEnd - pageStart

		// Extract page data
		var pageData = ByteArray.create()
		pageData.reserve(pageLen)
		var pi = 0
		while pi < pageLen 'copyPage'
			// pageEnd = min(pageStart + hashPageSize, codeLimit) and pageLen = pageEnd - pageStart,
			// so pageStart + pi < pageEnd <= codeLimit <= fileData.count() (caller guarantees).
			let b = try fileData.get(pageStart + pi) otherwise panic("MachO code-sig copyPage: pageStart+pi < codeLimit <= fileData.count() but get({pageStart + pi}) failed (fileData.count={fileData.count()})")
			pageData.push(b)
			pi = pi + 1
		end 'copyPage'

		// Hash the page
		let hash = sha256(pageData)
		sig.append(hash)

		slot = slot + 1
	end 'hashPages'

	return sig
end 'buildCodeSignature'

// --- Rdata relocation patching for Mach-O ---

function patchMachORdataRelocations(code ByteArray, rdataRelocs RdataRelocationArray, textSectionVMAddr MachineWord, constSectionVMAddr MachineWord, symdataSectionVMAddr MachineWord, heapSectionVMAddr MachineWord)
	for reloc in rdataRelocs 'patch'
		let instrVA = textSectionVMAddr + reloc.codeOffset
		match reloc.kind 'patchKind'
			ripRelDisp32 to covdataRipRelDisp32 then break 'patchKind'
			arm64Adr then patchArm64Adr(code, codeOffset: reloc.codeOffset, instrAddr: instrVA, targetAddr: constSectionVMAddr + reloc.rdataOffset)
			arm64LdrLiteral then patchArm64LdrLiteral(code, codeOffset: reloc.codeOffset, instrAddr: instrVA, targetAddr: constSectionVMAddr + reloc.rdataOffset)
			symdataArm64Adr then patchArm64Adr(code, codeOffset: reloc.codeOffset, instrAddr: instrVA, targetAddr: symdataSectionVMAddr)
			dataSectionArm64Adr then patchArm64Adr(code, codeOffset: reloc.codeOffset, instrAddr: instrVA, targetAddr: heapSectionVMAddr + reloc.rdataOffset)
			arm64Adrp then patchArm64Adrp(code, codeOffset: reloc.codeOffset, instrAddr: instrVA, targetAddr: constSectionVMAddr + reloc.rdataOffset)
			arm64PageOff then patchArm64PageOff(code, codeOffset: reloc.codeOffset, targetAddr: constSectionVMAddr + reloc.rdataOffset)
			dataSectionArm64Adrp then patchArm64Adrp(code, codeOffset: reloc.codeOffset, instrAddr: instrVA, targetAddr: heapSectionVMAddr + reloc.rdataOffset)
			dataSectionArm64PageOff then patchArm64PageOff(code, codeOffset: reloc.codeOffset, targetAddr: heapSectionVMAddr + reloc.rdataOffset)
			// Coverage instrumentation is a Phase 3 item for macOS; no .covdata
			// section is emitted yet, so covdata relocations should never appear.
			covdataArm64Adr then panic("MachO writer: coverage not yet supported")
			covdataArm64Adrp to covdataArm64PageOff then panic("MachO writer: coverage not yet supported")
			funcAbs64InRdata then break 'patchKind'
		end 'patchKind'
	end 'patch'
end 'patchMachORdataRelocations'

// --- funcAbs64 PIE rebase emission (dyld chained fixups) ---

// macOS arm64 forces MH_PIE, so dyld slides the image at launch. The funcAbs64
// function pointers baked into witness tables / layout descriptors must be
// rebased (not baked as fixed absolute VAs) or every witness/layout dispatch
// jumps to an unslid address and crashes. The writer places the rdata image at
// the front of the writable __DATA segment and threads these slots into the
// dyld chained-fixup chains. Slots are tracked in two parallel primitive arrays
// (offset, preferred-VA target) — primitive reads are copies, so the in-place
// insertion sort has no get/set borrow conflict.

// Insertion-sort the parallel (offset, target) arrays by ascending slot offset
// so consecutive slots can be threaded into per-page chains and the page_start
// table can take the first slot in each page. Counts are tiny (a handful of
// witness/layout pointers).
function sortMachoRebases(offsets CodeOffsetArray, targets CodeOffsetArray)
	let n = offsets.count()
	var i = 1
	while i < n 'outer'
		let keyOffset = try offsets.get(i) otherwise panic("sortMachoRebases.outer: i < n by loop guard but offsets.get({i}) failed")
		let keyTarget = try targets.get(i) otherwise panic("sortMachoRebases.outer: targets.get({i}) failed")
		var j = i - 1
		while j >= 0 'inner'
			let valOffset = try offsets.get(j) otherwise panic("sortMachoRebases.inner: 0 <= j < i but offsets.get({j}) failed")
			if valOffset <= keyOffset 'done'
				break
			end 'done'
			let valTarget = try targets.get(j) otherwise panic("sortMachoRebases.inner: targets.get({j}) failed")
			try offsets.set(j + 1, value: valOffset) otherwise panic("invariant: offsets.set OOB")
			try targets.set(j + 1, value: valTarget) otherwise panic("invariant: targets.set OOB")
			j = j - 1
		end 'inner'
		try offsets.set(j + 1, value: keyOffset) otherwise panic("invariant: offsets.set OOB")
		try targets.set(j + 1, value: keyTarget) otherwise panic("invariant: targets.set OOB")
		i = i + 1
	end 'outer'
end 'sortMachoRebases'

// Replace the non-PIE absolute-VA baking with dyld chained-fixup REBASE entries
// for every funcAbs64InRdata slot. Each slot becomes a DYLD_CHAINED_PTR_64_OFFSET
// rebase: bits 0-35 hold the target's OFFSET from the image base (dyld re-adds
// the runtime base), bits 51-62 hold `next` (4-byte stride to the following
// fixup IN THE SAME PAGE), bit 63 (bind) is 0. `textImageOffset` is the __text
// section's offset from the image base. Returns the slot offsets ascending so
// the caller can build the segment's page_start table.
function writeMachoFuncAbs64Rebases(rdata ByteArray, rdataRelocs RdataRelocationArray, textImageOffset MachineWord, debugSymbols DebugSymbolArray) returns CodeOffsetArray
	let symbolIndex = buildDebugSymbolIndex(debugSymbols)

	var offsets = CodeOffsetArray.create()
	var targets = CodeOffsetArray.create()
	// `target` is the function's OFFSET from the image base (textImageOffset +
	// funcCodeOffset); dyld re-adds the runtime base under the
	// DYLD_CHAINED_PTR_64_OFFSET pointer format.
	for slot in collectFuncAbs64Slots(rdataRelocs) 'collect'
		let funcCodeOffset = resolveFuncAbs64Symbol(symbolIndex, funcName: slot.funcName)
		offsets.push(slot.rdataOffset + slot.offsetInLabel)
		targets.push(textImageOffset + funcCodeOffset)
	end 'collect'

	sortMachoRebases(offsets, targets: targets)

	let count = offsets.count()
	var idx = 0
	while idx < count 'write'
		let slotOffset = try offsets.get(idx) otherwise panic("writeMachoFuncAbs64Rebases: idx < count but offsets.get({idx}) failed")
		let target = try targets.get(idx) otherwise panic("writeMachoFuncAbs64Rebases: targets.get({idx}) failed")
		var nextField = 0
		if idx + 1 < count 'hasNext'
			let followingOffset = try offsets.get(idx + 1) otherwise panic("writeMachoFuncAbs64Rebases: idx+1 < count but offsets.get({idx + 1}) failed")
			// next only links within a page; a cross-page successor ends this chain.
			if followingOffset / MACHO_PAGE_SIZE == slotOffset / MACHO_PAGE_SIZE 'samePage'
				nextField = (followingOffset - slotOffset) / 4
			end 'samePage'
		end 'hasNext'
		let entry = (nextField shl 51) or (target and 0xFFFFFFFFF)
		patchQword(rdata, offset: slotOffset, value: entry)
		idx = idx + 1
	end 'write'

	return offsets
end 'writeMachoFuncAbs64Rebases'

// Build the __DATA segment's page_start table from the ascending rebase slot
// offsets. The first `rdataPages` entries cover the rdata image (each the
// in-page offset of the first rebase, or START_NONE); the final entry covers
// the __got page, which begins at the page-aligned `gotOffsetInData`.
function buildMachoDataPageStarts(sortedRebaseOffsets CodeOffsetArray, rdataPages CodeOffset, gotOffsetInData CodeOffset) returns CodeOffsetArray
	var pageStarts = CodeOffsetArray.create()
	var p = 0
	while p < rdataPages 'rdataPage'
		let pageBase = p * MACHO_PAGE_SIZE
		let pageEnd = pageBase + MACHO_PAGE_SIZE
		var start = DYLD_CHAINED_PTR_START_NONE
		for slotOffset in sortedRebaseOffsets 'find'
			if slotOffset >= pageBase and slotOffset < pageEnd 'inPage'
				start = slotOffset - pageBase
				break
			end 'inPage'
		end 'find'
		pageStarts.push(start)
		p = p + 1
	end 'rdataPage'
	// __got is page-aligned, so its first bind sits at in-page offset 0.
	pageStarts.push(gotOffsetInData mod MACHO_PAGE_SIZE)
	return pageStarts
end 'buildMachoDataPageStarts'

// --- Main Mach-O writer ---

// One 32-bit FNV-1a stream over `code` from `seed`. Four distinct seeds compose the
// 128-bit LC_UUID. Uses the same fnvUpdate the stdlib cache uses (StdlibCache.maxon).
function machoUuidStream(code ByteArray, seed CacheChecksum) returns CacheChecksum
	var h = seed
	for b in code 'eachByte'
		h = fnvUpdate(h, b: b)
	end 'eachByte'
	return h
end 'machoUuidStream'

export function writeMachO(outputPath FilePath, codeResult CodeResult, target Target)
	logInfo(LogCategory.binary, message: function() gives "Writing Mach-O file: {outputPath} ({targetToString(target)})")

	var code = codeResult.code
	let codeSize = code.count()
	let rdataSize = codeResult.rdata.count()
	let symdataSize = codeResult.symdata.count()
	let hasRdata = rdataSize > 0
	let hasSymdata = symdataSize > 0
	// __TEXT holds __text and (optionally) __symtab. rdata (__const) lives in the
	// writable __DATA segment now (so its funcAbs64 pointers can be PIE-rebased),
	// so __DATA holds (optionally) __const plus __got and __heap.
	var textSectionCount = 1
	if hasSymdata 'setSecCount'
		textSectionCount = textSectionCount + 1
	end 'setSecCount'
	var dataSectionCount = 2  // __got + __heap
	if hasRdata 'setDataSecCount'
		dataSectionCount = dataSectionCount + 1  // __const
	end 'setDataSecCount'

	// --- Compute layout ---

	// Load command sizes
	let segCmdBase = 72
	let sectionSize = 80
	let textCmdSize = segCmdBase + (sectionSize * textSectionCount)  // __text + optionally __symtab
	let dataCmdSize = segCmdBase + (sectionSize * dataSectionCount)  // optionally __const + __got + __heap
	let symtabCmdSize = 24
	let dysymtabCmdSize = 80
	let mainCmdSize = 24
	let buildVersionCmdSize = 24
	let codeSignatureCmdSize = 16
	let chainedFixupsCmdSize = 16
	let exportTrieCmdSize = 16

	// dylinker: "/usr/lib/dyld" = 13 chars + null = 14, cmd = 12 + 14 = 26, aligned to 8 = 32
	let dylinkerCmdSize = 32
	// dylib: "/usr/lib/libSystem.B.dylib" = 25 chars + null = 26, cmd = 24 + 26 = 50, aligned to 8 = 56
	let dylibCmdSize = 56

	// LC_UUID: 8-byte header + 16-byte uuid. dyld on macOS 26+ rejects an executable
	// that lacks it ("missing LC_UUID load command").
	let uuidCmdSize = 24
	let loadCommandsSize = segCmdBase + textCmdSize + dataCmdSize + segCmdBase + symtabCmdSize + dysymtabCmdSize + dylinkerCmdSize + mainCmdSize + dylibCmdSize + buildVersionCmdSize + chainedFixupsCmdSize + exportTrieCmdSize + codeSignatureCmdSize + uuidCmdSize
	let numCmds = 14
	let headerSize = 32

	let textSectionOffset = alignUp(headerSize + loadCommandsSize, alignment: 4)
	let textSectionVMAddr = MACHO_TEXT_VM_ADDR + textSectionOffset
	// __symtab section placed after __text, aligned to 8 bytes. rdata (__const)
	// is no longer in __TEXT — it moved to writable __DATA so dyld can rebase its
	// funcAbs64 pointers under PIE slide (see writeMachoFuncAbs64Rebases).
	let symdataSectionOffset = alignUp(textSectionOffset + codeSize, alignment: 8)
	let symdataSectionVMAddr = MACHO_TEXT_VM_ADDR + symdataSectionOffset
	var textSegmentContentEnd = textSectionOffset + codeSize
	if hasSymdata 'setContentEnd'
		textSegmentContentEnd = symdataSectionOffset + symdataSize
	end 'setContentEnd'
	let textSegmentFileSize = alignUp(textSegmentContentEnd, alignment: MACHO_PAGE_SIZE)

	// GOT
	let got = buildGot()
	let gotSize = got.count()

	// === __DATA layout: __const (rebased rdata) | __got | __heap ===
	// __const goes first so it stays the closest __DATA section to __text — the
	// heap/data ADRs already reach further, so the single-ADR (+/-1MB) rdata
	// references remain in range. It must be writable for dyld to apply the
	// funcAbs64 rebases.
	let dataSegmentFileOff = textSegmentFileSize
	let dataSegmentVMAddr = MACHO_TEXT_VM_ADDR + textSegmentFileSize
	let constSectionVMAddr = dataSegmentVMAddr
	// Page-align the rdata image so __got starts on a fresh page; that isolates
	// the import-bind chain on its own page from the rdata rebase chains.
	var rdataAreaSize = 0
	if hasRdata 'rdataArea'
		rdataAreaSize = alignUp(rdataSize, alignment: MACHO_PAGE_SIZE)
	end 'rdataArea'
	let rdataPages = rdataAreaSize / MACHO_PAGE_SIZE
	let gotOffsetInData = rdataAreaSize
	let gotSectionVMAddr = dataSegmentVMAddr + gotOffsetInData
	// __const + __got occupy the first file-backed, page-aligned span. Keeping
	// this span unchanged preserves the funcAbs64 chained-fixup page_starts,
	// which index only the rdata + got pages — the prelude lands on a fresh page
	// beyond the fixup table and carries no rebased pointers.
	let constGotFileSize = alignUp(gotOffsetInData + gotSize, alignment: MACHO_PAGE_SIZE)
	// __heap holds the top-level / static globals' initial values (the
	// dataPrelude). It MUST be FILE-BACKED so those values survive into the
	// image — a zerofill heap silently zeroed every global (the static-variables
	// miscompile: `var a = 5; return a` returned 0). The runtime allocator mmaps
	// its own arenas (osAllocPages), so the section only needs to cover the
	// globals; a zerofill tail is still provided via the segment's vmsize.
	let heapSectionVMAddr = dataSegmentVMAddr + constGotFileSize
	let preludeSize = codeResult.dataPrelude.count()
	let hasPrelude = preludeSize > 0
	let heapFileOffset = dataSegmentFileOff + constGotFileSize
	let heapDataFileSize = alignUp(preludeSize, alignment: MACHO_PAGE_SIZE) if hasPrelude else 0
	let dataSegmentFileSize = constGotFileSize + heapDataFileSize
	let heapVirtualSize = 65536
	let dataSegmentVMSize = dataSegmentFileSize + heapVirtualSize

	// LINKEDIT segment (vmaddr must be after DATA's full virtual range including zerofill)
	let linkeditFileOff = dataSegmentFileOff + dataSegmentFileSize
	let linkeditVMAddr = dataSegmentVMAddr + alignUp(dataSegmentVMSize, alignment: MACHO_PAGE_SIZE)

	// Emit funcAbs64 PIE rebases into the rdata image, then build the __DATA
	// page_start table (one entry per rdata page + the __got page) and the
	// chained-fixups payload that threads both the rebases and the import binds.
	// textSectionOffset is __text's file offset, which equals its offset from the
	// image base (the mach header sits at file 0 / image base) — exactly the
	// OFFSET form DYLD_CHAINED_PTR_64_OFFSET rebases require.
	let rebaseSlots = writeMachoFuncAbs64Rebases(codeResult.rdata, rdataRelocs: codeResult.rdataRelocations, textImageOffset: textSectionOffset, debugSymbols: codeResult.debugSymbols)
	let dataPageStarts = buildMachoDataPageStarts(rebaseSlots, rdataPages: rdataPages, gotOffsetInData: gotOffsetInData)
	let chainedFixupsData = buildChainedFixups(dataSegmentFileOff, pageStarts: dataPageStarts)

	// Exports trie (minimal empty trie)
	var exportsTrieData = ByteArray.create()
	writeQword(exportsTrieData, value: 0)

	// LINKEDIT content layout
	let chainedFixupsOff = linkeditFileOff
	let chainedFixupsSize = chainedFixupsData.count()
	let exportsTrieOff = alignUp(chainedFixupsOff + chainedFixupsSize, alignment: 8)
	let exportsTrieSize = exportsTrieData.count()

	// Build the symbol string table up front so the layout calculation knows
	// its on-disk size. Mach-O strtab starts with a NUL byte; each symbol name
	// is underscore-prefixed (per the Apple platform ABI) and NUL-terminated.
	let nsyms = codeResult.debugSymbols.count()
	let hasSymtab = nsyms > 0
	var machoStrtab = ByteArray.create()
	machoStrtab.push(0)
	var machoSymNameOffsets = MachoStrOffsetArray.create()
	for sym in codeResult.debugSymbols 'eachSymName'
		let nameOff = machoStrtab.count()
		machoStrtab.push(0x5F)  // leading underscore '_'
		machoStrtab.append(sym.name.toByteArray())
		machoStrtab.push(0)
		machoSymNameOffsets.push(nameOff)
	end 'eachSymName'
	// When no debug symbols, preserve the original 4-byte placeholder strtab so
	// behavior matches the pre-debug-symbol output bytewise.
	if not hasSymtab 'noSyms'
		machoStrtab = ByteArray.create()
		writeZeros(machoStrtab, n: 4)
	end 'noSyms'

	let symtabOff = alignUp(exportsTrieOff + exportsTrieSize, alignment: 8)
	let symtabSize = nsyms * 16
	let strtabOff = symtabOff + symtabSize
	let strtabSize = machoStrtab.count()

	// Code signature offset (aligned to 16)
	let codeSignatureOff = alignUp(strtabOff + strtabSize, alignment: 16)

	// Pre-compute code signature size so we can compute LINKEDIT size upfront
	let csHashPageSize = 1 shl CS_PAGE_SIZE_LOG2
	let csNCodeSlots = (codeSignatureOff + csHashPageSize - 1) / csHashPageSize
	let csIdentLen = 13  // strlen("maxon-output") + 1
	let csCdSize = 88 + csIdentLen + csNCodeSlots * CS_SHA256_LEN
	let codeSignatureSize = 20 + csCdSize

	// Now compute final LINKEDIT size
	let linkeditEnd = codeSignatureOff + codeSignatureSize
	let linkeditFileSize = alignUp(linkeditEnd - linkeditFileOff, alignment: MACHO_PAGE_SIZE)

	// Patch ADRP+LDR relocations in code
	patchRelocationsMachO(code, relocations: codeResult.relocations, textSectionVMAddr: textSectionVMAddr, gotSectionVMAddr: gotSectionVMAddr)

	// Patch rdata relocations in code (ADR/LDR-literal -> __const section, now in __DATA)
	patchMachORdataRelocations(code, rdataRelocs: codeResult.rdataRelocations, textSectionVMAddr: textSectionVMAddr, constSectionVMAddr: constSectionVMAddr, symdataSectionVMAddr: symdataSectionVMAddr, heapSectionVMAddr: heapSectionVMAddr)

	// Patch function-address ADRP+ADD pairs (±4 GiB reach) into the `.text`
	// section. PC-relative, so PIE-slide-safe — no chained-fixup rebase needed.
	patchArm64FuncAdrpRelocs(code, funcAdrpRelocs: codeResult.arm64FuncAdrpRelocs, textBase: textSectionVMAddr)

	let entryOff = textSectionOffset + codeResult.mainCallFixupOffset
	// macOS arm64 requires PIE (the kernel kills a non-PIE main executable with
	// SIGKILL). MH_PIE lets dyld slide the image; PC-relative code (ADRP/ADD) is
	// slide-safe, and the absolute funcAbs64 function pointers in rdata are made
	// slide-safe by the DYLD_CHAINED_PTR_64_OFFSET rebases emitted into the
	// writable __DATA __const section above (see writeMachoFuncAbs64Rebases).
	let flags = MH_DYLDLINK or MH_TWOLEVEL or MH_PIE

	// --- Build Mach-O buffer ---
	var macho = ByteArray.create()
	macho.reserve(codeSignatureOff + 4096)

	// === Mach-O Header (32 bytes) ===
	writeDword(macho, value: MH_MAGIC_64)
	writeDword(macho, value: CPU_TYPE_ARM64)
	writeDword(macho, value: CPU_SUBTYPE_ARM64_ALL)
	writeDword(macho, value: MH_EXECUTE)
	writeDword(macho, value: numCmds)
	writeDword(macho, value: loadCommandsSize)
	writeDword(macho, value: flags)
	writeDword(macho, value: 0)  // reserved

	// === __PAGEZERO ===
	writeSegmentCommand(macho, segname: "__PAGEZERO", vmaddr: 0, vmsize: MACHO_PAGEZERO_SIZE, fileoff: 0, filesize: 0, maxprot: 0, initprot: 0, nsects: 0)

	// === __TEXT ===
	writeSegmentCommand(macho, segname: "__TEXT", vmaddr: MACHO_TEXT_VM_ADDR, vmsize: textSegmentFileSize, fileoff: 0, filesize: textSegmentFileSize, maxprot: VM_PROT_READ or VM_PROT_EXECUTE, initprot: VM_PROT_READ or VM_PROT_EXECUTE, nsects: textSectionCount)
	writeMachOSectionHeader(macho, sectname: "__text", segname: "__TEXT", addr: textSectionVMAddr, size: codeSize, offset: textSectionOffset, alignVal: 2, flags: S_ATTR_PURE_INSTRUCTIONS or S_ATTR_SOME_INSTRUCTIONS or S_REGULAR)
	if hasSymdata 'writeSymtabHeader'
		writeMachOSectionHeader(macho, sectname: "__symtab", segname: "__TEXT", addr: symdataSectionVMAddr, size: symdataSize, offset: symdataSectionOffset, alignVal: 2, flags: S_REGULAR)
	end 'writeSymtabHeader'

	// === __DATA ===
	writeSegmentCommand(macho, segname: "__DATA", vmaddr: dataSegmentVMAddr, vmsize: dataSegmentVMSize, fileoff: dataSegmentFileOff, filesize: dataSegmentFileSize, maxprot: VM_PROT_READ or VM_PROT_WRITE, initprot: VM_PROT_READ or VM_PROT_WRITE, nsects: dataSectionCount)
	if hasRdata 'writeConstHeader'
		writeMachOSectionHeader(macho, sectname: "__const", segname: "__DATA", addr: constSectionVMAddr, size: rdataSize, offset: dataSegmentFileOff, alignVal: 3, flags: S_REGULAR)
	end 'writeConstHeader'
	writeMachOSectionHeader(macho, sectname: "__got", segname: "__DATA", addr: gotSectionVMAddr, size: gotSize, offset: dataSegmentFileOff + gotOffsetInData, alignVal: 3, flags: S_REGULAR)
	if hasPrelude 'fileBackedHeap'
		// File-backed: the prelude bytes (global initial values) live in the image.
		writeMachOSectionHeader(macho, sectname: "__heap", segname: "__DATA", addr: heapSectionVMAddr, size: preludeSize, offset: heapFileOffset, alignVal: 3, flags: S_REGULAR)
	end 'fileBackedHeap' else 'zerofillHeap'
		// No globals: keep the historic zerofill heap (no file content).
		writeMachOSectionHeader(macho, sectname: "__heap", segname: "__DATA", addr: heapSectionVMAddr, size: heapVirtualSize, offset: 0, alignVal: 3, flags: S_ZEROFILL)
	end 'zerofillHeap'

	// === __LINKEDIT ===
	writeSegmentCommand(macho, segname: "__LINKEDIT", vmaddr: linkeditVMAddr, vmsize: linkeditFileSize, fileoff: linkeditFileOff, filesize: linkeditFileSize, maxprot: VM_PROT_READ, initprot: VM_PROT_READ, nsects: 0)

	// === LC_SYMTAB ===
	// When the backend supplies debugSymbols, points at a real nlist_64 array
	// followed by its strtab; otherwise nsyms = 0 and symoff degenerates to the
	// strtab address (preserving the pre-debug-symbol behavior).
	writeDword(macho, value: LC_SYMTAB)
	writeDword(macho, value: symtabCmdSize)
	let lcSymoff = symtabOff if hasSymtab else strtabOff
	writeDword(macho, value: lcSymoff)
	writeDword(macho, value: nsyms)
	writeDword(macho, value: strtabOff)
	writeDword(macho, value: strtabSize)

	// === LC_DYSYMTAB ===
	writeDword(macho, value: LC_DYSYMTAB)
	writeDword(macho, value: dysymtabCmdSize)
	writeZeros(macho, n: 72)  // 18 * 4 = 72 bytes of zeros

	// === LC_LOAD_DYLINKER ===
	writeDword(macho, value: LC_LOAD_DYLINKER)
	writeDword(macho, value: dylinkerCmdSize)
	writeDword(macho, value: 12)  // name offset within command
	macho.append(b"/usr/lib/dyld\x00")
	// Pad to dylinkerCmdSize (32 - 12 - 14 = 6 bytes padding)
	let dylinkerPad = dylinkerCmdSize - 12 - 14
	writeZeros(macho, n: dylinkerPad)

	// === LC_MAIN ===
	writeDword(macho, value: LC_MAIN)
	writeDword(macho, value: mainCmdSize)
	writeQword(macho, value: entryOff)
	writeQword(macho, value: 0)  // stacksize

	// === LC_UUID ===
	// Required by dyld on macOS 26+. A deterministic 128-bit value from four FNV-1a
	// streams over the code bytes (distinct seeds) — deterministic so repeated builds
	// of identical input stay binary-identical, distinct binaries get distinct UUIDs.
	writeDword(macho, value: LC_UUID)
	writeDword(macho, value: uuidCmdSize)
	writeDword(macho, value: machoUuidStream(code, seed: FNV_OFFSET_BASIS))
	writeDword(macho, value: machoUuidStream(code, seed: 0x01000193))
	writeDword(macho, value: machoUuidStream(code, seed: 0x9E3779B1))
	writeDword(macho, value: machoUuidStream(code, seed: 0x85EBCA77))

	// === LC_LOAD_DYLIB ===
	writeDword(macho, value: LC_LOAD_DYLIB)
	writeDword(macho, value: dylibCmdSize)
	writeDword(macho, value: 24)  // name offset within command
	writeDword(macho, value: 0)  // timestamp
	writeDword(macho, value: 0)  // current_version
	writeDword(macho, value: 0)  // compat_version
	macho.append(b"/usr/lib/libSystem.B.dylib\x00")
	// Pad to dylibCmdSize (56 - 24 - 27 = 5 bytes padding)
	let dylibPad = dylibCmdSize - 24 - 27
	writeZeros(macho, n: dylibPad)

	// === LC_BUILD_VERSION ===
	writeDword(macho, value: LC_BUILD_VERSION)
	writeDword(macho, value: buildVersionCmdSize)
	writeDword(macho, value: 1)  // platform = MACOS
	writeDword(macho, value: 0x000D0000)  // minos = 13.0
	writeDword(macho, value: 0)  // sdk
	writeDword(macho, value: 0)  // ntools

	// === LC_DYLD_CHAINED_FIXUPS ===
	writeDword(macho, value: LC_DYLD_CHAINED_FIXUPS)
	writeDword(macho, value: chainedFixupsCmdSize)
	writeDword(macho, value: chainedFixupsOff)
	writeDword(macho, value: chainedFixupsSize)

	// === LC_DYLD_EXPORTS_TRIE ===
	writeDword(macho, value: LC_DYLD_EXPORTS_TRIE)
	writeDword(macho, value: exportTrieCmdSize)
	writeDword(macho, value: exportsTrieOff)
	writeDword(macho, value: exportsTrieSize)

	// === LC_CODE_SIGNATURE ===
	writeDword(macho, value: LC_CODE_SIGNATURE)
	writeDword(macho, value: codeSignatureCmdSize)
	writeDword(macho, value: codeSignatureOff)
	writeDword(macho, value: codeSignatureSize)

	// === Pad to __text ===
	padTo(macho, size: textSectionOffset)

	// === __text section ===
	macho.append(code)

	// === __symtab section (symbol table) ===
	if hasSymdata 'writeSymtab'
		padTo(macho, size: symdataSectionOffset)
		macho.append(codeResult.symdata)
	end 'writeSymtab'

	// === Pad __TEXT segment to page boundary ===
	padTo(macho, size: textSegmentFileSize)

	// === __DATA segment: __const (rebased rdata) then __got ===
	if hasRdata 'writeConst'
		padTo(macho, size: dataSegmentFileOff)
		macho.append(codeResult.rdata)
	end 'writeConst'
	padTo(macho, size: dataSegmentFileOff + gotOffsetInData)
	macho.append(got)
	// __heap: file-backed top-level / static globals' initial values.
	if hasPrelude 'writePrelude'
		padTo(macho, size: heapFileOffset)
		macho.append(codeResult.dataPrelude)
	end 'writePrelude'
	padTo(macho, size: dataSegmentFileOff + dataSegmentFileSize)

	// === __LINKEDIT content ===
	// Chained fixups
	macho.append(chainedFixupsData)
	padTo(macho, size: exportsTrieOff)

	// Exports trie
	macho.append(exportsTrieData)

	// Symbol table (nlist_64 entries) — present only when debug symbols emitted.
	if hasSymtab 'writeMachoSyms'
		padTo(macho, size: symtabOff)
		// All function symbols live in __text. Mach-O n_type for an external
		// section-defined symbol is N_EXT | N_SECT.
		let nType = N_EXT or N_SECT
		for (iter, sym) in codeResult.debugSymbols.withIterator() 'writeSyms'
			let nameOff = try machoSymNameOffsets.get(iter.index()) otherwise panic("invariant: machoSymNameOffsets[{iter.index()}] OOB ({machoSymNameOffsets.count()} entries)")
			writeDword(macho, value: nameOff)  // n_strx
			macho.push(nType and 0xFF)  // n_type
			macho.push(MACHO_TEXT_SECT_INDEX and 0xFF)  // n_sect
			writeWord(macho, value: 0)  // n_desc
			writeQword(macho, value: textSectionVMAddr + sym.codeOffset)  // n_value
		end 'writeSyms'
	end 'writeMachoSyms'

	// String table — either the real symbol-name strtab or the pre-debug-symbol
	// 4-byte placeholder.
	padTo(macho, size: strtabOff)
	macho.append(machoStrtab)

	// Pad to code signature offset
	padTo(macho, size: codeSignatureOff)

	// === Build code signature ===
	let sig = buildCodeSignature(macho, codeLimit: codeSignatureOff, execSegLimit: textSegmentFileSize, identifierStr: "maxon-output")

	// Append code signature
	macho.append(sig)

	// Pad to end of LINKEDIT
	padTo(macho, size: linkeditFileOff + linkeditFileSize)

	// === Write to file ===
	try File.writeBinary(outputPath, content: macho, mode: FilePermission.executable) otherwise 'writeErr'
		logError(LogCategory.binary, message: function() gives "Failed to write Mach-O file: {outputPath}")
	end 'writeErr'

	logInfo(LogCategory.binary, message: function() gives "Mach-O write complete: {macho.count()} bytes")
end 'writeMachO'
