// ARM64 machine code emitter — block-based.
// Emits fixed-width 32-bit instructions from Arm64Op dialect ops.
// Walks TargetModule -> functions -> blocks -> ops.
// Uses BlockId -> code offset maps for jump resolution.
// OS-specific stubs are parameterized by OsDescriptor.

// VReg resolver functions — at emission time all VRegs must be physical.
function resolveArm64Gpr(vreg Arm64VReg) returns Arm64Register
	var result = Arm64Register.x0
	match vreg 'resolve'
		physical(reg) then result = reg
		virtual(id) then panic("arm64 emitter: unresolved virtual GPR v{id}")
	end 'resolve'
	return result
end 'resolveArm64Gpr'

function resolveArm64Fp(vreg Arm64FpVReg) returns Arm64FloatRegister
	var result = Arm64FloatRegister.d0
	match vreg 'resolve'
		physical(reg) then result = reg
		virtual(id) then panic("arm64 emitter: unresolved virtual FP vf{id}")
	end 'resolve'
	return result
end 'resolveArm64Fp'

export typealias Arm64Offset = int(0 to u64.max)
export typealias Arm64OffsetArray = Array with Arm64Offset

// --- Block offset tracking ---
// Maps BlockId -> code offset for jump fixup resolution.

typealias BlockOffsetMap = Array with Arm64Offset
export typealias BlockIdFixupArray = Array with BlockIdFixup

export type BlockIdFixup
	export var instrOffset as Arm64Offset
	export var targetBlock as BlockId
	export var isCond as bool

	export static function create(instrOffset Arm64Offset, targetBlock BlockId, isCond bool) returns BlockIdFixup
		return Self{instrOffset: instrOffset, targetBlock: targetBlock, isCond: isCond}
	end 'create'
end 'BlockIdFixup'

function blockOffsetMapGet(m BlockOffsetMap, blockId BlockId) returns Arm64Offset
	// Sentinel: unrecorded block returns 0 — fixup resolution treats 0 as "target not yet placed".
	let result = try m.get(blockId) otherwise 0
	return result
end 'blockOffsetMapGet'

export function blockOffsetMapSet(m BlockOffsetMap, blockId BlockId, offset Arm64Offset)
	while m.count() <= blockId 'grow'
		m.push(0)
	end 'grow'
	try m.set(blockId, value: offset) otherwise panic("invariant: m.set OOB")
end 'blockOffsetMapSet'

// --- Instruction emit helper ---

export function arm64EmitInsn(code ByteArray, insn MachineWord)
	code.push(insn and 0xFF)
	code.push((insn shr 8) and 0xFF)
	code.push((insn shr 16) and 0xFF)
	code.push((insn shr 24) and 0xFF)
end 'arm64EmitInsn'

// --- Register encoding ---

// --- Condition code encoding ---

// --- Instruction helpers ---

// Largest frame the pre/post-indexed STP/LDP frame-record form can encode. The
// imm7 field is signed and scaled by 8: the LDP post-index reaches +504 (63*8)
// and the STP pre-index reaches -512 (-64*8). Use the smaller bound for both so
// a single threshold governs the symmetric prologue/epilogue forms; frames above
// it route through the ADD/SUB-immediate path (see arm64EmitStackAlloc).
let ARM64_FRAME_PAIR_INDEX_MAX = 504

// STP X29, X30, [SP, #-frameSize]! (pre-indexed, 64-bit). Caller must ensure
// frameSize <= ARM64_FRAME_PAIR_INDEX_MAX — beyond that the imm7 field overflows.
export function arm64EmitStpPreIndex(code ByteArray, frameSize StackSize)
	let imm7 = (-frameSize) / 8 and 0x7F
	let insn = 0xA9800000 or (imm7 shl 15) or (30 shl 10) or (31 shl 5) or 29
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStpPreIndex'

// MOV X29, SP => ADD X29, SP, #0
export function arm64EmitMovFpSp(code ByteArray)
	code.append(b"\xfd\x03\x00\x91")
end 'arm64EmitMovFpSp'

// LDP X29, X30, [SP], #frameSize (post-indexed, 64-bit)
export function arm64EmitLdpPostIndex(code ByteArray, frameSize StackSize)
	let imm7 = frameSize / 8 and 0x7F
	let insn = 0xA8C00000 or (imm7 shl 15) or (30 shl 10) or (31 shl 5) or 29
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLdpPostIndex'

// STP Xt1, Xt2, [Xn, #offset] (signed offset, 64-bit GPR pair store)
function arm64EmitStpOffset(code ByteArray, rt1 MachineWord, rt2 MachineWord, baseReg MachineWord, offset MachineWord)
	let imm7 = (offset / 8) and 0x7F
	let insn = 0xA9000000 or (imm7 shl 15) or (rt2 shl 10) or (baseReg shl 5) or rt1
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStpOffset'

// LDP Xt1, Xt2, [Xn, #offset] (signed offset, 64-bit GPR pair load)
function arm64EmitLdpOffset(code ByteArray, rt1 MachineWord, rt2 MachineWord, baseReg MachineWord, offset MachineWord)
	let imm7 = (offset / 8) and 0x7F
	let insn = 0xA9400000 or (imm7 shl 15) or (rt2 shl 10) or (baseReg shl 5) or rt1
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLdpOffset'

// STP Dt1, Dt2, [Xn, #offset] (signed offset, 64-bit FP pair store)
function arm64EmitFpStpOffset(code ByteArray, rt1 MachineWord, rt2 MachineWord, baseReg MachineWord, offset MachineWord)
	let imm7 = (offset / 8) and 0x7F
	let insn = 0x6D000000 or (imm7 shl 15) or (rt2 shl 10) or (baseReg shl 5) or rt1
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpStpOffset'

// LDP Dt1, Dt2, [Xn, #offset] (signed offset, 64-bit FP pair load)
function arm64EmitFpLdpOffset(code ByteArray, rt1 MachineWord, rt2 MachineWord, baseReg MachineWord, offset MachineWord)
	let imm7 = (offset / 8) and 0x7F
	let insn = 0x6D400000 or (imm7 shl 15) or (rt2 shl 10) or (baseReg shl 5) or rt1
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpLdpOffset'

// STR Xt, [Xn, #offset] (single GPR store, unsigned offset)
export function arm64EmitStrRegOffset(code ByteArray, rt MachineWord, baseReg MachineWord, offset MachineWord)
	let imm12 = (offset / 8) and 0xFFF
	let insn = 0xF9000000 or (imm12 shl 10) or (baseReg shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStrRegOffset'

// LDR Xt, [Xn, #offset] (single GPR load, unsigned offset)
export function arm64EmitLdrRegOffset(code ByteArray, rt MachineWord, baseReg MachineWord, offset MachineWord)
	let imm12 = (offset / 8) and 0xFFF
	let insn = 0xF9400000 or (imm12 shl 10) or (baseReg shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLdrRegOffset'

// STR Dt, [Xn, #offset] (single FP store, unsigned offset)
function arm64EmitFpStrRegOffset(code ByteArray, rt MachineWord, baseReg MachineWord, offset MachineWord)
	let imm12 = (offset / 8) and 0xFFF
	let insn = 0xFD000000 or (imm12 shl 10) or (baseReg shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpStrRegOffset'

// LDR Dt, [Xn, #offset] (single FP load, unsigned offset)
function arm64EmitFpLdrRegOffset(code ByteArray, rt MachineWord, baseReg MachineWord, offset MachineWord)
	let imm12 = (offset / 8) and 0xFFF
	let insn = 0xFD400000 or (imm12 shl 10) or (baseReg shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpLdrRegOffset'

// RET (return via X30)
export function arm64EmitRet(code ByteArray)
	code.append(b"\xc0\x03\x5f\xd6")
end 'arm64EmitRet'

// Shared helper: emit instruction with opcode | (imm16 << 5) | rd encoding.
function arm64EmitImmShift(code ByteArray, opcode MachineWord, rd MachineWord, imm16 MachineWord)
	let insn = opcode or ((imm16 and 0xFFFF) shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitImmShift'

// MOVZ Xd, #imm16 (no shift)
function arm64EmitMovz(code ByteArray, rd MachineWord, imm16 MachineWord)
	arm64EmitImmShift(code, opcode: 0xD2800000, rd: rd, imm16: imm16)
end 'arm64EmitMovz'

// MOVZ Xd, #imm16, LSL #16
function arm64EmitMovzLsl16(code ByteArray, rd MachineWord, imm16 MachineWord)
	arm64EmitImmShift(code, opcode: 0xD2A00000, rd: rd, imm16: imm16)
end 'arm64EmitMovzLsl16'

// MOVK Xd, #imm16, LSL #16
function arm64EmitMovkLsl16(code ByteArray, rd MachineWord, imm16 MachineWord)
	arm64EmitImmShift(code, opcode: 0xF2A00000, rd: rd, imm16: imm16)
end 'arm64EmitMovkLsl16'

// MOVK Xd, #imm16, LSL #32
function arm64EmitMovkLsl32(code ByteArray, rd MachineWord, imm16 MachineWord)
	arm64EmitImmShift(code, opcode: 0xF2C00000, rd: rd, imm16: imm16)
end 'arm64EmitMovkLsl32'

// MOVK Xd, #imm16, LSL #48
function arm64EmitMovkLsl48(code ByteArray, rd MachineWord, imm16 MachineWord)
	arm64EmitImmShift(code, opcode: 0xF2E00000, rd: rd, imm16: imm16)
end 'arm64EmitMovkLsl48'

// Load a full 64-bit immediate into register Xd using MOVZ + MOVK sequence.
// Zero is special-cased to MOV Xd, XZR (ORR Xd, XZR, XZR) for smaller encoding.
export function arm64EmitMovImm(code ByteArray, rd MachineWord, value MachineWord)
	if value == 0 'useXzr'
		// MOV Xd, XZR => ORR Xd, XZR, XZR: 0xAA1F03E0 | Rd
		arm64EmitInsn(code, insn: 0xAA1F03E0 or rd)
		return
	end 'useXzr'

	let chunk0 = value and 0xFFFF
	let chunk1 = (value shr 16) and 0xFFFF
	let chunk2 = (value shr 32) and 0xFFFF
	let chunk3 = (value shr 48) and 0xFFFF

	arm64EmitMovz(code, rd: rd, imm16: chunk0)
	if chunk1 != 0 'k16'
		arm64EmitMovkLsl16(code, rd: rd, imm16: chunk1)
	end 'k16'
	if chunk2 != 0 'k32'
		arm64EmitMovkLsl32(code, rd: rd, imm16: chunk2)
	end 'k32'
	if chunk3 != 0 'k48'
		arm64EmitMovkLsl48(code, rd: rd, imm16: chunk3)
	end 'k48'
end 'arm64EmitMovImm'

// STR Xt, [X29, #offset] (unsigned offset, scaled by 8)
// offset = 16 + slotIndex * 8
export function arm64EmitStrSlot(code ByteArray, rt MachineWord, slotIndex VarSlot)
	let offset = 16 + slotIndex * 8
	let insn = 0xF9000000 or ((offset / 8) shl 10) or (29 shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStrSlot'

// LDR Xt, [X29, #offset] (unsigned offset, scaled by 8)
// offset = 16 + slotIndex * 8
export function arm64EmitLdrSlot(code ByteArray, rt MachineWord, slotIndex VarSlot)
	let offset = 16 + slotIndex * 8
	let insn = 0xF9400000 or ((offset / 8) shl 10) or (29 shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLdrSlot'

// Shared helper: emit instruction with opcode | (rm << 16) | (rn << 5) | rd encoding.
function arm64EmitRRR(code ByteArray, opcode MachineWord, rd MachineWord, rn MachineWord, rm MachineWord)
	let insn = opcode or (rm shl 16) or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitRRR'

// ADD Xd, Xn, Xm (64-bit register)
function arm64EmitAdd(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0x8B000000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitAdd'

// ADDS Xd, Xn, Xm (64-bit register, sets flags)
function arm64EmitAdds(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0xAB000000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitAdds'

// SUB Xd, Xn, Xm (64-bit register)
function arm64EmitSub(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0xCB000000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitSub'

// SUBS Xd, Xn, Xm (64-bit register, sets flags)
function arm64EmitSubs(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0xEB000000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitSubs'

// MUL Xd, Xn, Xm (64-bit register)
function arm64EmitMul(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0x9B007C00, rd: rd, rn: rn, rm: rm)
end 'arm64EmitMul'

// SDIV Xd, Xn, Xm (signed divide)
function arm64EmitSdiv(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0x9AC00C00, rd: rd, rn: rn, rm: rm)
end 'arm64EmitSdiv'

// NEG Xd, Xn => SUB Xd, XZR, Xn
function arm64EmitNeg(code ByteArray, rd MachineWord, rn MachineWord)
	let insn = 0xCB000000 or (rn shl 16) or (31 shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitNeg'

// MVN Xd, Xn => ORN Xd, XZR, Xn
function arm64EmitMvn(code ByteArray, rd MachineWord, rn MachineWord)
	let insn = 0xAA2003E0 or (rn shl 16) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitMvn'

// AND Xd, Xn, Xm
function arm64EmitAnd(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0x8A000000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitAnd'

// ANDS Xd, Xn, Xm (sets flags)
function arm64EmitAnds(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0xEA000000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitAnds'

// ORR Xd, Xn, Xm
function arm64EmitOrr(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0xAA000000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitOrr'

// EOR Xd, Xn, Xm
export function arm64EmitEor(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0xCA000000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitEor'

// LSLV Xd, Xn, Xm (variable shift left)
function arm64EmitLslv(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0x9AC02000, rd: rd, rn: rn, rm: rm)
end 'arm64EmitLslv'

// ASRV Xd, Xn, Xm (variable arithmetic shift right)
function arm64EmitAsrv(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0x9AC02800, rd: rd, rn: rn, rm: rm)
end 'arm64EmitAsrv'

// LSRV Xd, Xn, Xm (variable logical shift right)
function arm64EmitLsrv(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0x9AC02400, rd: rd, rn: rn, rm: rm)
end 'arm64EmitLsrv'

// MSUB Xd, Xn, Xm, Xa => Xd = Xa - Xn * Xm
export function arm64EmitMsub(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, ra MachineWord)
	let insn = 0x9B008000 or (rm shl 16) or (ra shl 10) or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitMsub'

// UDIV Xd, Xn, Xm
export function arm64EmitUdiv(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	arm64EmitRRR(code, opcode: 0x9AC00800, rd: rd, rn: rn, rm: rm)
end 'arm64EmitUdiv'

// Remainder: SDIV X2, X0, X1; MSUB X0, X2, X1, X0 => X0 = X0 - (X0/X1)*X1
function arm64EmitRem(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	// Use x16 (IP0) as scratch — guaranteed not in allocatable pool, avoids clobbering rd/rn/rm
	arm64EmitSdiv(code, rd: 16, rn: rn, rm: rm)
	arm64EmitMsub(code, rd: rd, rn: 16, rm: rm, ra: rn)
end 'arm64EmitRem'

// MOV Xd, Xn => ORR Xd, XZR, Xn
export function arm64EmitMovRegReg(code ByteArray, rd MachineWord, rn MachineWord)
	// ORR Xd, XZR, Xn: 0xAA0003E0 | (rn << 16) | rd
	let insn = 0xAA0003E0 or (rn shl 16) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitMovRegReg'

// Store a spilled register to [X29 + byteOffset]. Spill offsets are positive and
// 8-byte aligned (see `computeStackOffset`). Small offsets use the unscaled STUR
// (simm9, signed -256..255); LARGER frames MUST use the scaled unsigned STR
// (imm12 * 8, range 0..32760) — STUR's 9-bit field silently truncates any offset
// >= 256, so a frame past ~256 bytes (e.g. a function with many string/int
// interpolations) would spill to the WRONG slot and corrupt live data. The
// reload path mirrors this exactly.
function arm64EmitSpillToStack(code ByteArray, rt MachineWord, byteOffset MachineWord)
	if byteOffset < 256 'fitsSimm9'
		// STUR Xt, [X29, #simm9]: 0xF8000000 | (imm9 << 12) | (Xn << 5) | Xt
		let insn = 0xF8000000 or ((byteOffset and 0x1FF) shl 12) or (29 shl 5) or rt
		arm64EmitInsn(code, insn: insn)
	end 'fitsSimm9' else 'scaled'
		// STR Xt, [X29, #imm12*8] (scaled unsigned offset)
		arm64EmitStrRegOffset(code, rt: rt, baseReg: 29, offset: byteOffset)
	end 'scaled'
end 'arm64EmitSpillToStack'

// Reload a spilled register from [X29 + byteOffset]. See `arm64EmitSpillToStack`
// for the simm9-vs-scaled offset rationale.
function arm64EmitReloadFromStack(code ByteArray, rt MachineWord, byteOffset MachineWord)
	if byteOffset < 256 'fitsSimm9'
		// LDUR Xt, [X29, #simm9]: 0xF8400000 | (imm9 << 12) | (Xn << 5) | Xt
		let insn = 0xF8400000 or ((byteOffset and 0x1FF) shl 12) or (29 shl 5) or rt
		arm64EmitInsn(code, insn: insn)
	end 'fitsSimm9' else 'scaled'
		// LDR Xt, [X29, #imm12*8] (scaled unsigned offset)
		arm64EmitLdrRegOffset(code, rt: rt, baseReg: 29, offset: byteOffset)
	end 'scaled'
end 'arm64EmitReloadFromStack'

// LDR Xt, [X29, #incomingOffset] — load an incoming overflow stack param.
// The caller wrote it into its outgoing-arg area, which sits just above this
// frame at `[x29 + (frameSize - outgoingArgSize) + argIndex*8]`. Uses the LDR
// unsigned-offset form (scaled imm12, up to 32760) rather than the LDUR simm9
// the spill reload uses — incoming-arg offsets routinely exceed the 256-byte
// signed range.
function arm64EmitLoadIncomingArg(code ByteArray, rt MachineWord, argIndex MachineWord, tracker Arm64StackTracker)
	let outgoing = tracker.outgoingArgSize
	let frameSize = arm64ComputeFrameSize(tracker.currentStackSize, outgoingArgSize: outgoing)
	let incomingOffset = frameSize - outgoing + argIndex * 8
	arm64EmitLdrRegOffset(code, rt: rt, baseReg: 29, offset: incomingOffset)
end 'arm64EmitLoadIncomingArg'

// STR Xt, [SP, #offset] — store to unsigned byte offset from stack pointer
function arm64EmitStrSpOffset(code ByteArray, rt MachineWord, byteOffset MachineWord)
	// STR (unsigned offset): 0xF9000000 | (imm12 << 10) | (Rn << 5) | Rt
	// imm12 is byte_offset / 8 for 64-bit stores
	let scaledOffset = (byteOffset / 8) and 0xFFF
	let insn = 0xF9000000 or (scaledOffset shl 10) or (31 shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStrSpOffset'

// FMOV Dd, Dn (double-precision float register move)
function arm64EmitFmovDD(code ByteArray, rd MachineWord, rn MachineWord)
	// FMOV Dd, Dn: 0x1E604000 | (Rn << 5) | Rd
	let insn = 0x1E604000 or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFmovDD'

// STR Dt, [X29, #offset] — store FP register to stack (unsigned offset, scaled by 8)
function arm64EmitFpSpillToStack(code ByteArray, rt MachineWord, byteOffset MachineWord)
	// STR (FP, unsigned offset): 0xFD000000 | (imm12 << 10) | (Rn << 5) | Rt
	// imm12 = byte_offset / 8 for double-precision stores
	let scaledOffset = (byteOffset / 8) and 0xFFF
	let insn = 0xFD000000 or (scaledOffset shl 10) or (29 shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpSpillToStack'

// LDR Dt, [X29, #offset] — load FP register from stack (unsigned offset, scaled by 8)
function arm64EmitFpReloadFromStack(code ByteArray, rt MachineWord, byteOffset MachineWord)
	// LDR (FP, unsigned offset): 0xFD400000 | (imm12 << 10) | (Rn << 5) | Rt
	let scaledOffset = (byteOffset / 8) and 0xFFF
	let insn = 0xFD400000 or (scaledOffset shl 10) or (29 shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpReloadFromStack'

// LDR Dt/St, [PC+offset] — PC-relative literal load from rdata section.
// Emits a placeholder LDR literal instruction; the imm19 field is patched
// by the binary writer after rdata section layout.
function arm64EmitFpLoadRdata(code ByteArray, dest Arm64FloatRegister, rdataLabel String, precision FloatPrecision, rdataRelocs RdataRelocationArray)
	let rt = dest.rawValue and 0x1F
	let opcode = match precision 'selectOpc'
		f64 gives 0x5C000000
		f32 gives 0x1C000000
	end 'selectOpc'
	// Record relocation at this instruction offset
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: rdataLabel, kind: RdataRelocKind.arm64LdrLiteral))
	// Emit placeholder instruction with imm19=0
	arm64EmitInsn(code, insn: opcode or rt)
end 'arm64EmitFpLoadRdata'

// CMP Xn, Xm => SUBS XZR, Xn, Xm
export function arm64EmitCmp(code ByteArray, rn MachineWord, rm MachineWord)
	let insn = 0xEB00001F or (rm shl 16) or (rn shl 5)
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCmp'

// CMP Xn, #0
export function arm64EmitCmpRegZero(code ByteArray, rn MachineWord)
	let insn = 0xF100001F or (rn shl 5)
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCmpRegZero'

// CMP Xn, #imm12 => SUBS XZR, Xn, #imm12
function arm64EmitCmpImm(code ByteArray, rn MachineWord, imm12 MachineWord)
	let insn = 0xF100001F or ((imm12 and 0xFFF) shl 10) or (rn shl 5)
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCmpImm'

// STUR Xt, [Xn, #simm9] — unscaled signed offset. The scaled STR form
// (arm64EmitStrRegOffset) takes an UNSIGNED imm12, so it cannot express the
// negative displacements the memzero ladder uses to anchor stores at the end
// of the region.
function arm64EmitStur(code ByteArray, rt MachineWord, baseReg MachineWord, offset MachineWord)
	let insn = 0xF8000000 or ((offset and 0x1FF) shl 12) or (baseReg shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStur'

// B with an explicit imm26 branch offset (in instructions, sign-extended).
function arm64EmitBranchOffset(code ByteArray, imm26 MachineWord)
	arm64EmitInsn(code, insn: 0x14000000 or (imm26 and 0x3FFFFFF))
end 'arm64EmitBranchOffset'

// B.cond with imm19 placeholder (patched later)
export function arm64EmitCondBranch(code ByteArray, cond MachineWord)
	let insn = 0x54000000 or cond
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCondBranch'

// B.cond with an explicit imm19 branch offset (in instructions, sign-extended).
// Unlike arm64EmitCondBranch this needs no later patching — used by the inline
// atomic CAS LL/SC loop whose branch targets are fixed relative distances.
function arm64EmitCondBranchOffset(code ByteArray, cond MachineWord, imm19 MachineWord)
	let insn = 0x54000000 or ((imm19 and 0x7FFFF) shl 5) or cond
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCondBranchOffset'

// B (unconditional) with imm26 placeholder (patched later)
export function arm64EmitBranch(code ByteArray)
	code.append(b"\x00\x00\x00\x14")
end 'arm64EmitBranch'

// BL (branch and link) with imm26 placeholder (patched later)
export function arm64EmitBranchLink(code ByteArray)
	code.append(b"\x00\x00\x00\x94")
end 'arm64EmitBranchLink'

// SVC #0 (supervisor call for Linux syscalls)
function arm64EmitSvc(code ByteArray)
	code.append(b"\x01\x00\x00\xd4")
end 'arm64EmitSvc'

// BLR Xn (branch to register with link)
export function arm64EmitBlr(code ByteArray, rn MachineWord)
	let insn = 0xD63F0000 or (rn shl 5)
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitBlr'

// BR Xn (branch to register, no link)
function arm64EmitBr(code ByteArray, rn MachineWord)
	let insn = 0xD61F0000 or (rn shl 5)
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitBr'

// ADRP Xd, #immhi (4KB page-relative, placeholder -- patched by relocation)
export function arm64EmitAdrp(code ByteArray, rd MachineWord)
	let insn = 0x90000000 or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitAdrp'

// LDR Xd, [Xn, #imm12] (unsigned offset, scaled by 8)
export function arm64EmitLdrImm(code ByteArray, rt MachineWord, rn MachineWord, imm12 MachineWord)
	let insn = 0xF9400000 or ((imm12 / 8) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLdrImm'

// STRB Wt, [Xn, #offset] (unsigned offset, unscaled byte)
export function arm64EmitStrb(code ByteArray, rt MachineWord, rn MachineWord, offset MachineWord)
	let insn = 0x39000000 or ((offset and 0xFFF) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStrb'

// LDRB Wt, [Xn, #offset]
export function arm64EmitLdrb(code ByteArray, rt MachineWord, rn MachineWord, offset MachineWord)
	let insn = 0x39400000 or ((offset and 0xFFF) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLdrb'

// ADR Xd, #offset (PC-relative, +/- 1MB range). File-local: the only remaining
// user is the `__symtable` load in `arm64EmitLeaFuncAddrOp` (writer-resolved with
// a ±1 MiB reach guard); function addresses now use the ±4 GiB ADRP+ADD pair.
function arm64EmitAdr(code ByteArray, rd MachineWord, offset MachineWord)
	let immlo = offset and 0x3
	let immhi = (offset shr 2) and 0x7FFFF
	let insn = (immlo shl 29) or 0x10000000 or (immhi shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitAdr'

// SUB Xd, Xn, #imm12 (immediate)
export function arm64EmitSubImm(code ByteArray, rd MachineWord, rn MachineWord, imm12 MachineWord)
	let insn = 0xD1000000 or ((imm12 and 0xFFF) shl 10) or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitSubImm'

// ADD Xd, Xn, #imm12 (immediate)
export function arm64EmitAddImm(code ByteArray, rd MachineWord, rn MachineWord, imm12 MachineWord)
	let insn = 0x91000000 or ((imm12 and 0xFFF) shl 10) or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitAddImm'

// SUB SP, SP, #imm12 [, LSL #12] — `sh` selects the optional 12-bit left shift
// (the ADD/SUB-immediate `sh` field at bit 22). Used by the stack-adjust helpers
// to reach frame sizes past the single-imm12 4095-byte limit without a scratch
// register (SP cannot be a shifted-register ADD/SUB operand).
function arm64EmitSubSpImmShifted(code ByteArray, imm12 MachineWord, sh MachineWord)
	let insn = 0xD1000000 or (sh shl 22) or ((imm12 and 0xFFF) shl 10) or (31 shl 5) or 31
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitSubSpImmShifted'

// ADD SP, SP, #imm12 [, LSL #12] — see `arm64EmitSubSpImmShifted`.
function arm64EmitAddSpImmShifted(code ByteArray, imm12 MachineWord, sh MachineWord)
	let insn = 0x91000000 or (sh shl 22) or ((imm12 and 0xFFF) shl 10) or (31 shl 5) or 31
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitAddSpImmShifted'

// Allocate `amount` bytes of stack (SP -= amount). `amount` is 16-byte aligned
// and non-zero. ADD/SUB-immediate reach only 12 bits (0..4095) per instruction,
// so split into a high (<<12) and low part — covering any frame up to 0xFFFFFF
// (16 MiB) — instead of silently truncating a large frame to a wrong, unaligned
// value (the imm7 pre-indexed STP could not encode these at all).
function arm64EmitStackAlloc(code ByteArray, amount StackSize)
	if amount > 0xFFFFFF 'tooLarge'
		panic("arm64EmitStackAlloc: frame size exceeds 16 MiB encodable range")
	end 'tooLarge'
	let high = (amount shr 12) and 0xFFF
	let low = amount and 0xFFF
	if high > 0 'hasHigh'
		arm64EmitSubSpImmShifted(code, imm12: high, sh: 1)
	end 'hasHigh'
	if low > 0 'hasLow'
		arm64EmitSubSpImmShifted(code, imm12: low, sh: 0)
	end 'hasLow'
end 'arm64EmitStackAlloc'

// ADD Xd, Xn, #imm for an immediate that may exceed the 12-bit ADD field.
// The single-instruction arm64EmitAddImm masks imm to 12 bits, silently
// truncating any value >= 0x1000 — which corrupts the computed address of a
// stack slot whose byte offset reaches 0x1000 (slot index >= ~510, hit by
// functions with large frames like mrt_executable_path's 4 KiB path buffer).
// Splits into a high (<<12) and low part exactly like arm64EmitStackAlloc.
// `rd` doubles as the intermediate, so this is safe even when rd == rn.
function arm64EmitAddImmWide(code ByteArray, rd MachineWord, rn MachineWord, imm MachineWord)
	if imm > 0xFFFFFF 'tooLarge'
		panic("arm64EmitAddImmWide: immediate exceeds 24-bit encodable range")
	end 'tooLarge'
	let high = (imm shr 12) and 0xFFF
	let low = imm and 0xFFF
	if high == 0 'smallImm'
		arm64EmitAddImm(code, rd: rd, rn: rn, imm12: low)
		return
	end 'smallImm'
	// ADD rd, rn, #high, lsl #12 — sh field (bit 22) set, mirroring the
	// shifted SUB/ADD-SP helpers above.
	let insnHigh = 0x91400000 or (high shl 10) or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insnHigh)
	if low > 0 'hasLow'
		arm64EmitAddImm(code, rd: rd, rn: rd, imm12: low)
	end 'hasLow'
end 'arm64EmitAddImmWide'

// Free `amount` bytes of stack (SP += amount). Mirror of `arm64EmitStackAlloc`.
function arm64EmitStackFree(code ByteArray, amount StackSize)
	if amount > 0xFFFFFF 'tooLarge'
		panic("arm64EmitStackFree: frame size exceeds 16 MiB encodable range")
	end 'tooLarge'
	let high = (amount shr 12) and 0xFFF
	let low = amount and 0xFFF
	if high > 0 'hasHigh'
		arm64EmitAddSpImmShifted(code, imm12: high, sh: 1)
	end 'hasHigh'
	if low > 0 'hasLow'
		arm64EmitAddSpImmShifted(code, imm12: low, sh: 0)
	end 'hasLow'
end 'arm64EmitStackFree'

// CBZ Xn, #offset (compare and branch if zero)
export function arm64EmitCbz(code ByteArray, rn MachineWord, imm19 MachineWord)
	let insn = 0xB4000000 or ((imm19 and 0x7FFFF) shl 5) or rn
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCbz'

// CBNZ Xn, #offset (compare and branch if not zero)
export function arm64EmitCbnz(code ByteArray, rn MachineWord, imm19 MachineWord)
	let insn = 0xB5000000 or ((imm19 and 0x7FFFF) shl 5) or rn
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCbnz'

// CBNZ Wn, #imm19 — 32-bit variant. imm19 is in instructions, sign-extended.
function arm64EmitCbnzW(code ByteArray, rn MachineWord, imm19 MachineWord)
	let insn = 0x35000000 or ((imm19 and 0x7FFFF) shl 5) or rn
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCbnzW'

// LDAXR Xt, [Xn] — load-acquire exclusive register, 64-bit.
export function arm64EmitLdaxr(code ByteArray, rt MachineWord, rn MachineWord)
	let insn = 0xC85FFC00 or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLdaxr'

// STLXR Ws, Xt, [Xn] — store-release exclusive register, 64-bit. Ws receives
// the success status (0 = success, 1 = failure).
export function arm64EmitStlxr(code ByteArray, rs MachineWord, rt MachineWord, rn MachineWord)
	let insn = 0xC800FC00 or (rs shl 16) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStlxr'

// STLR Xt, [Xn] — store-release register, 64-bit. Publishes Xt with release
// ordering (no exclusive monitor, no status register).
export function arm64EmitStlr(code ByteArray, rt MachineWord, rn MachineWord)
	let insn = 0xC89FFC00 or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStlr'

// ADD Xd, Xn, #imm12 helper writes the immediate-form ADD using the standard
// sf=1 encoding. (arm64EmitAddImm above already does this — alias kept for clarity.)

// MOV Xd, Xn => ORR Xd, XZR, Xn
function arm64EmitMovReg(code ByteArray, rd MachineWord, rn MachineWord)
	let insn = 0xAA0003E0 or (rn shl 16) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitMovReg'

// --- Patch helpers ---

// Patch a B or BL instruction at instrOffset with a PC-relative offset in instruction units.
function arm64PatchBranch(code ByteArray, instrOffset Arm64Offset, targetOffset Arm64Offset)
	let relBytes = targetOffset - instrOffset
	let relInsns = relBytes / 4
	let origInsn = try readDword(code, offset: instrOffset) otherwise panic("arm64PatchBranch: instrOffset {instrOffset} past end of emitted code (count={code.count()}) — emitter bug")
	let patched = (origInsn and 0xFC000000) or (relInsns and 0x3FFFFFF)
	patchDword(code, offset: instrOffset, value: patched)
end 'arm64PatchBranch'

// Patch a B.cond instruction at instrOffset with a PC-relative offset.
function arm64PatchCondBranch(code ByteArray, instrOffset Arm64Offset, targetOffset Arm64Offset)
	let relBytes = targetOffset - instrOffset
	let relInsns = relBytes / 4
	let origInsn = try readDword(code, offset: instrOffset) otherwise panic("arm64PatchCondBranch: instrOffset {instrOffset} past end of emitted code (count={code.count()}) — emitter bug")
	let condBits = origInsn and 0xF
	let patched = 0x54000000 or ((relInsns and 0x7FFFF) shl 5) or condBits
	patchDword(code, offset: instrOffset, value: patched)
end 'arm64PatchCondBranch'

// --- Label management for function names (call fixups) ---
//
// `arm64LabelOffsetMap` is the O(1) hash view; the parallel labelNames /
// labelOffsets arrays remain for ordered traversal (symbol-table
// emission, logging). Both views are populated by arm64RecordLabel and
// must stay in sync.

export typealias Arm64LabelOffsetMap = Map with (String, Arm64Offset)

// Strip a leading `stdlib.` namespace prefix, giving the bare symbol that a
// runtime.std (Std-IR) call site references. Returns the input unchanged when
// there is no such prefix. Mirrors the x64 backend's stripStdlibPrefix.
function arm64StripStdlibPrefix(name String) returns String
	let prefix = "stdlib."
	if not name.startsWith(prefix) 'noPrefix'
		return name
	end 'noPrefix'
	var idx = name.startIndex()
	for _ in 0 upto prefix.byteLength() 'advance'
		idx = try name.indexAfter(idx) otherwise return name
	end 'advance'
	return name.slice(idx, endIndex: name.endIndex())
end 'arm64StripStdlibPrefix'

export function arm64RecordLabel(labelNames StringArray, labelOffsets Arm64OffsetArray, labelOffsetMap Arm64LabelOffsetMap, name String, offset Arm64Offset)
	logTrace(LogCategory.codegen, message: function() gives "ARM64 Label '{name}' at code offset {offset}")
	labelNames.push(name)
	labelOffsets.push(offset)
	labelOffsetMap.upsert(name, value: offset)
	// Bare alias for a `stdlib.`-qualified definition so a bare call site (from
	// runtime.std Std-IR, which has no namespace form — e.g. mrt_start's call to
	// `__slab_init` or a refcount pass's `__mm_decref`) resolves to the
	// Maxon-phase Internals function recorded under its `stdlib.`-qualified name.
	// Mirrors the x64 backend's recordLabel.
	if name.startsWith("stdlib.") 'qualified'
		labelOffsetMap.upsert(arm64StripStdlibPrefix(name), value: offset)
	end 'qualified'
end 'arm64RecordLabel'

export function arm64LookupLabel(labelOffsetMap Arm64LabelOffsetMap, name String) returns Arm64Offset
	let offset = try labelOffsetMap.get(name) otherwise 'missing'
		// Bare callee -> `stdlib.`-qualified def fallback: a bare call may target a
		// function whose definition was recorded only under its `stdlib.`-qualified
		// name. Mirrors the x64 backend's lookupLabel.
		let qualifiedOffset = try labelOffsetMap.get("stdlib.{name}") otherwise 'stillMissing'
			logError(LogCategory.codegen, message: function() gives "ARM64 unresolved label '{name}'")
			return 0
		end 'stillMissing'
		return qualifiedOffset
	end 'missing'
	return offset
end 'arm64LookupLabel'

// --- Fixup types for function calls (by name) ---

export type Arm64CallFixup
	export var instrOffset as Arm64Offset
	export var targetName as String

	export static function create(instrOffset Arm64Offset, targetName String) returns Arm64CallFixup
		return Self{instrOffset: instrOffset, targetName: targetName}
	end 'create'
end 'Arm64CallFixup'

export typealias Arm64CallFixupArray = Array with Arm64CallFixup

// ADR fixup: patch an ADR instruction to point at a named function.
export type Arm64AdrFixup
	export var instrOffset as Arm64Offset
	export var destReg as MachineWord
	export var targetName as String

	export static function create(instrOffset Arm64Offset, destReg MachineWord, targetName String) returns Arm64AdrFixup
		return Self{instrOffset: instrOffset, destReg: destReg, targetName: targetName}
	end 'create'
end 'Arm64AdrFixup'

export typealias Arm64AdrFixupArray = Array with Arm64AdrFixup

// --- Fixup resolution ---

// Resolve block-based jump fixups using BlockId -> offset map.
export function arm64ResolveBlockJumpFixups(code ByteArray, blockOffsets BlockOffsetMap, jumpFixups BlockIdFixupArray)
	for fixup in jumpFixups 'resolve'
		let targetOffset = blockOffsetMapGet(blockOffsets, blockId: fixup.targetBlock)
		if fixup.isCond 'cond'
			arm64PatchCondBranch(code, instrOffset: fixup.instrOffset, targetOffset: targetOffset)
		end 'cond' else 'uncond'
			arm64PatchBranch(code, instrOffset: fixup.instrOffset, targetOffset: targetOffset)
		end 'uncond'
	end 'resolve'
end 'arm64ResolveBlockJumpFixups'

// A resolved function-address ADRP+ADD relocation. `adrpCodeOffset` is the
// absolute `.text` offset of the ADRP (its paired ADD is at +4);
// `targetCodeOffset` is the target function's absolute `.text` offset. The
// per-target binary writer computes both absolute VAs (`textBase + offset`) and
// patches the pair via `patchArm64FuncAdrpRelocs`. This is the ±4 GiB-reach
// replacement for the old single-ADR function fixups (see arm64EmitLeaFuncAddrOp).
export type Arm64FuncAdrpReloc
	export var adrpCodeOffset as Arm64Offset
	export var targetCodeOffset as Arm64Offset

	export static function create(adrpCodeOffset Arm64Offset, targetCodeOffset Arm64Offset) returns Arm64FuncAdrpReloc
		return Self{adrpCodeOffset: adrpCodeOffset, targetCodeOffset: targetCodeOffset}
	end 'create'
end 'Arm64FuncAdrpReloc'

export typealias Arm64FuncAdrpRelocArray = Array with Arm64FuncAdrpReloc

// Resolve function-address ADR fixups (leaFuncAddr / green-thread func pointers)
// to text-section-targeting ADRP+ADD relocations, looking each target up in the
// function name -> `.text` offset map. The binary writer patches the pairs once
// the `.text` VM base is known (`patchArm64FuncAdrpRelocs`), giving ±4 GiB reach
// — the single-ADR form this replaced silently truncated any target past ±1 MiB.
export function arm64ResolveFuncAdrpFixups(labelOffsetMap Arm64LabelOffsetMap, adrFixups Arm64AdrFixupArray) returns Arm64FuncAdrpRelocArray
	var relocs = Arm64FuncAdrpRelocArray.create()
	for fixup in adrFixups 'resolve'
		let targetOffset = arm64LookupLabel(labelOffsetMap, name: fixup.targetName)
		relocs.push(Arm64FuncAdrpReloc.create(fixup.instrOffset, targetCodeOffset: targetOffset))
	end 'resolve'
	return relocs
end 'arm64ResolveFuncAdrpFixups'

// Patch every function-address ADRP+ADD pair with the target function's absolute
// `.text` VA. Shared by all three binary writers; `textBase` is the `.text`
// section's runtime base (Mach-O __text VM addr / ELF text VAddr / PE text RVA —
// the ADRP page delta is invariant under a page-aligned image base, so the RVA
// form patches identically to the VA form). ADRP+ADD is PC-relative, so a PIE
// slide moves the instruction and its target together — no rebase entry needed.
export function patchArm64FuncAdrpRelocs(code ByteArray, funcAdrpRelocs Arm64FuncAdrpRelocArray, textBase MachineWord)
	for reloc in funcAdrpRelocs 'patch'
		let instrVA = textBase + reloc.adrpCodeOffset
		let targetVA = textBase + reloc.targetCodeOffset
		patchArm64Adrp(code, codeOffset: reloc.adrpCodeOffset, instrAddr: instrVA, targetAddr: targetVA)
		patchArm64PageOff(code, codeOffset: reloc.adrpCodeOffset + 4, targetAddr: targetVA)
	end 'patch'
end 'patchArm64FuncAdrpRelocs'

// Resolve call fixups using function name -> offset labels.
export function arm64ResolveCallFixups(code ByteArray, labelOffsetMap Arm64LabelOffsetMap, callFixups Arm64CallFixupArray)
	logTrace(LogCategory.codegen, message: function() gives "ARM64 resolving {callFixups.count()} call fixups")
	for fixup in callFixups 'resolve'
		let targetOffset = arm64LookupLabel(labelOffsetMap, name: fixup.targetName)
		arm64PatchBranch(code, instrOffset: fixup.instrOffset, targetOffset: targetOffset)
	end 'resolve'
end 'arm64ResolveCallFixups'

// --- OS-parameterized stubs ---

// Emit mrt_start: BL main (patched later), then exit via OsDescriptor strategy
function arm64EmitStart(code ByteArray, osDesc OsDescriptor, callFixups Arm64CallFixupArray, relocations RelocationArray) returns Arm64Offset
	let mainCallFixupOffset = code.count()
	let mainName = "main"
	callFixups.push(Arm64CallFixup.create(mainCallFixupOffset, targetName: mainName))
	arm64EmitBranchLink(code)

	match osDesc.exit 'exitStrategy'
		syscall(num) then arm64EmitExitSyscall(code, syscallNumber: num)
		iatCall(slotIdx) then arm64EmitExitIat(code, relocations: relocations, slotIndex: slotIdx)
	end 'exitStrategy'

	return mainCallFixupOffset
end 'arm64EmitStart'

// Exit via syscall: MOV X8, #N; SVC #0
function arm64EmitExitSyscall(code ByteArray, syscallNumber MachineWord)
	arm64EmitMovz(code, rd: 8, imm16: syscallNumber)
	arm64EmitSvc(code)
end 'arm64EmitExitSyscall'

// Exit via IAT (Windows): load ExitProcess from IAT, tail-call with exit code in X0
function arm64EmitExitIat(code ByteArray, relocations RelocationArray, slotIndex MachineWord)
	relocations.push(Relocation.create(code.count(), slotIndex: slotIndex))
	arm64EmitAdrp(code, rd: 16)
	arm64EmitLdrImm(code, rt: 16, rn: 16, imm12: 0)
	arm64EmitBr(code, rn: 16)
end 'arm64EmitExitIat'

// Emit mrt_write_stdout stub parameterized by OsDescriptor
function arm64EmitWriteStdout(code ByteArray, osDesc OsDescriptor, relocations RelocationArray) returns Arm64Offset
	let offset = code.count()
	match osDesc.write 'writeStrategy'
		syscall(writeNum, fd) then arm64EmitWriteStdoutSyscall(code, writeNumber: writeNum, fd: fd)
		winApi(getHandleSlot, handleConstant, writeFileSlot) then arm64EmitWriteStdoutWinApi(code, relocations: relocations, getHandleSlot: getHandleSlot, handleConstant: handleConstant, writeFileSlot: writeFileSlot)
		libcall(writeSlot, fd) then arm64EmitWriteStdoutLibcall(code, relocations: relocations, writeSlot: writeSlot, fd: fd)
	end 'writeStrategy'
	return offset
end 'arm64EmitWriteStdout'

// mrt_write_stdout via syscall: caller X0=ptr, X1=len
function arm64EmitWriteStdoutSyscall(code ByteArray, writeNumber MachineWord, fd MachineWord)
	arm64EmitStpPreIndex(code, frameSize: 32)
	arm64EmitMovFpSp(code)

	// Remap args: caller X0=ptr, X1=len -> syscall X0=fd, X1=ptr, X2=len
	arm64EmitMovReg(code, rd: 2, rn: 1)
	arm64EmitMovReg(code, rd: 1, rn: 0)
	arm64EmitMovz(code, rd: 0, imm16: fd)
	arm64EmitMovz(code, rd: 8, imm16: writeNumber)
	arm64EmitSvc(code)

	arm64EmitLdpPostIndex(code, frameSize: 32)
	arm64EmitRet(code)
end 'arm64EmitWriteStdoutSyscall'

// mrt_write_stdout via libcall: write(fd, buf, len) through GOT slot.
// Used for macOS (libSystem.B.dylib).
// Caller: X0=ptr, X1=len
function arm64EmitWriteStdoutLibcall(code ByteArray, relocations RelocationArray, writeSlot MachineWord, fd MachineWord)
	arm64EmitStpPreIndex(code, frameSize: 32)
	arm64EmitMovFpSp(code)

	// Remap args: caller X0=ptr, X1=len -> write(X0=fd, X1=ptr, X2=len)
	arm64EmitMovReg(code, rd: 2, rn: 1)
	arm64EmitMovReg(code, rd: 1, rn: 0)
	arm64EmitMovz(code, rd: 0, imm16: fd)

	// Call write through GOT slot
	relocations.push(Relocation.create(code.count(), slotIndex: writeSlot))
	arm64EmitAdrp(code, rd: 16)
	arm64EmitLdrImm(code, rt: 16, rn: 16, imm12: 0)
	arm64EmitBlr(code, rn: 16)

	arm64EmitLdpPostIndex(code, frameSize: 32)
	arm64EmitRet(code)
end 'arm64EmitWriteStdoutLibcall'

// mrt_write_stdout via Win32 API (GetStdHandle + WriteFile through IAT)
// Caller: X0=ptr, X1=len
function arm64EmitWriteStdoutWinApi(code ByteArray, relocations RelocationArray, getHandleSlot MachineWord, handleConstant MachineWord, writeFileSlot MachineWord)
	arm64EmitStpPreIndex(code, frameSize: 80)
	arm64EmitMovFpSp(code)

	// Save args: [FP+16] = X0 (ptr), [FP+24] = X1 (len)
	arm64EmitStrSlot(code, rt: 0, slotIndex: 0)
	arm64EmitStrSlot(code, rt: 1, slotIndex: 1)

	// Zero bytesWritten at [FP+32]
	arm64EmitMovz(code, rd: 2, imm16: 0)
	arm64EmitStrSlot(code, rt: 2, slotIndex: 2)

	// GetStdHandle(STD_OUTPUT_HANDLE): X0 = handleConstant
	arm64EmitMovImm(code, rd: 0, value: handleConstant)
	relocations.push(Relocation.create(code.count(), slotIndex: getHandleSlot))
	arm64EmitAdrp(code, rd: 16)
	arm64EmitLdrImm(code, rt: 16, rn: 16, imm12: 0)
	arm64EmitBlr(code, rn: 16)

	// Save handle to [FP+40]
	arm64EmitStrSlot(code, rt: 0, slotIndex: 3)

	// WriteFile(handle, buffer, length, &bytesWritten, NULL)
	arm64EmitLdrSlot(code, rt: 0, slotIndex: 3)
	arm64EmitLdrSlot(code, rt: 1, slotIndex: 0)
	arm64EmitLdrSlot(code, rt: 2, slotIndex: 1)
	arm64EmitAddImm(code, rd: 3, rn: 29, imm12: 32)
	arm64EmitMovz(code, rd: 4, imm16: 0)

	relocations.push(Relocation.create(code.count(), slotIndex: writeFileSlot))
	arm64EmitAdrp(code, rd: 16)
	arm64EmitLdrImm(code, rt: 16, rn: 16, imm12: 0)
	arm64EmitBlr(code, rn: 16)

	arm64EmitLdpPostIndex(code, frameSize: 80)
	arm64EmitRet(code)
end 'arm64EmitWriteStdoutWinApi'

// mrt_read_stdin stub parameterized by OsDescriptor. Like arm64EmitWriteStdout
// this exists as a hand-coded counterpart to the regular `std osRead`
// lowering — callers that splice in mrt_read_stdin without going through MIR
// pipe the OS-specific code in directly via this entrypoint. Caller passes
// X0=ptr, X1=len; result (bytes read) returned in X0.
function arm64EmitReadStdin(code ByteArray, osDesc OsDescriptor, relocations RelocationArray) returns Arm64Offset
	let offset = code.count()
	match osDesc.read 'readStrategy'
		syscall(readNum, fd) then arm64EmitReadStdinSyscall(code, readNumber: readNum, fd: fd)
		winApi(getHandleSlot, handleConstant, readFileSlot) then arm64EmitReadStdinWinApi(code, relocations: relocations, getHandleSlot: getHandleSlot, handleConstant: handleConstant, readFileSlot: readFileSlot)
		libcall(readSlot, fd) then arm64EmitReadStdinLibcall(code, relocations: relocations, readSlot: readSlot, fd: fd)
	end 'readStrategy'
	return offset
end 'arm64EmitReadStdin'

// mrt_read_stdin via syscall: caller X0=ptr, X1=len; bytes-read in X0.
function arm64EmitReadStdinSyscall(code ByteArray, readNumber MachineWord, fd MachineWord)
	arm64EmitStpPreIndex(code, frameSize: 32)
	arm64EmitMovFpSp(code)

	// Remap args: caller X0=ptr, X1=len -> syscall X0=fd, X1=ptr, X2=len
	arm64EmitMovReg(code, rd: 2, rn: 1)
	arm64EmitMovReg(code, rd: 1, rn: 0)
	arm64EmitMovz(code, rd: 0, imm16: fd)
	arm64EmitMovz(code, rd: 8, imm16: readNumber)
	arm64EmitSvc(code)

	arm64EmitLdpPostIndex(code, frameSize: 32)
	arm64EmitRet(code)
end 'arm64EmitReadStdinSyscall'

// mrt_read_stdin via libcall: read(fd, buf, len) through GOT slot.
// Used for macOS (libSystem.B.dylib). Caller: X0=ptr, X1=len.
function arm64EmitReadStdinLibcall(code ByteArray, relocations RelocationArray, readSlot MachineWord, fd MachineWord)
	arm64EmitStpPreIndex(code, frameSize: 32)
	arm64EmitMovFpSp(code)

	// Remap args: caller X0=ptr, X1=len -> read(X0=fd, X1=ptr, X2=len)
	arm64EmitMovReg(code, rd: 2, rn: 1)
	arm64EmitMovReg(code, rd: 1, rn: 0)
	arm64EmitMovz(code, rd: 0, imm16: fd)

	// Call read through GOT slot
	relocations.push(Relocation.create(code.count(), slotIndex: readSlot))
	arm64EmitAdrp(code, rd: 16)
	arm64EmitLdrImm(code, rt: 16, rn: 16, imm12: 0)
	arm64EmitBlr(code, rn: 16)

	arm64EmitLdpPostIndex(code, frameSize: 32)
	arm64EmitRet(code)
end 'arm64EmitReadStdinLibcall'

// mrt_read_stdin via Win32 API (GetStdHandle(STD_INPUT_HANDLE) + ReadFile through IAT).
// Caller: X0=ptr, X1=len. Stack frame: slot 0=ptr, slot 1=len, slot 2=bytesRead,
// slot 3=handle. Returns bytesRead in X0.
function arm64EmitReadStdinWinApi(code ByteArray, relocations RelocationArray, getHandleSlot MachineWord, handleConstant MachineWord, readFileSlot MachineWord)
	arm64EmitStpPreIndex(code, frameSize: 80)
	arm64EmitMovFpSp(code)

	// Save args: [FP+16] = X0 (ptr), [FP+24] = X1 (len)
	arm64EmitStrSlot(code, rt: 0, slotIndex: 0)
	arm64EmitStrSlot(code, rt: 1, slotIndex: 1)

	// Zero bytesRead at [FP+32]
	arm64EmitMovz(code, rd: 2, imm16: 0)
	arm64EmitStrSlot(code, rt: 2, slotIndex: 2)

	// GetStdHandle(STD_INPUT_HANDLE): X0 = handleConstant
	arm64EmitMovImm(code, rd: 0, value: handleConstant)
	relocations.push(Relocation.create(code.count(), slotIndex: getHandleSlot))
	arm64EmitAdrp(code, rd: 16)
	arm64EmitLdrImm(code, rt: 16, rn: 16, imm12: 0)
	arm64EmitBlr(code, rn: 16)

	// Save handle to [FP+40]
	arm64EmitStrSlot(code, rt: 0, slotIndex: 3)

	// ReadFile(handle, buffer, length, &bytesRead, NULL)
	arm64EmitLdrSlot(code, rt: 0, slotIndex: 3)
	arm64EmitLdrSlot(code, rt: 1, slotIndex: 0)
	arm64EmitLdrSlot(code, rt: 2, slotIndex: 1)
	arm64EmitAddImm(code, rd: 3, rn: 29, imm12: 32)
	arm64EmitMovz(code, rd: 4, imm16: 0)

	relocations.push(Relocation.create(code.count(), slotIndex: readFileSlot))
	arm64EmitAdrp(code, rd: 16)
	arm64EmitLdrImm(code, rt: 16, rn: 16, imm12: 0)
	arm64EmitBlr(code, rn: 16)

	// Load bytesRead from [FP+32] into X0 — discards the BOOL return.
	arm64EmitLdrSlot(code, rt: 0, slotIndex: 2)

	arm64EmitLdpPostIndex(code, frameSize: 80)
	arm64EmitRet(code)
end 'arm64EmitReadStdinWinApi'

// --- mrt_i64_to_string stub ---
// Input: X0 = value to convert
// Returns: X0 = pointer to string, X1 = length

function arm64EmitI64ToString(code ByteArray) returns Arm64Offset
	let offset = code.count()
	let frameSize = 80

	arm64EmitStpPreIndex(code, frameSize: frameSize)
	arm64EmitMovFpSp(code)

	// Save value in X4
	arm64EmitMovReg(code, rd: 4, rn: 0)

	// Handle zero special case: CBZ X4, zero_case
	let cbzOffset = code.count()
	arm64EmitCbz(code, rn: 4, imm19: 0)

	// X5 = pointer to end of temp buffer = X29 + 48
	arm64EmitAddImm(code, rd: 5, rn: 29, imm12: 48)
	// X6 = digit count
	arm64EmitMovz(code, rd: 6, imm16: 0)
	// X7 = 10 (divisor)
	arm64EmitMovz(code, rd: 7, imm16: 10)

	// digit_loop:
	let digitLoopOffset = code.count()

	// UDIV X3, X4, X7 => quotient
	arm64EmitUdiv(code, rd: 3, rn: 4, rm: 7)
	// MSUB X2, X3, X7, X4 => remainder
	arm64EmitMsub(code, rd: 2, rn: 3, rm: 7, ra: 4)
	// ADD X2, X2, #0x30 ('0')
	arm64EmitAddImm(code, rd: 2, rn: 2, imm12: 0x30)
	// Decrement buffer pointer
	arm64EmitSubImm(code, rd: 5, rn: 5, imm12: 1)
	// STRB W2, [X5, #0]
	arm64EmitStrb(code, rt: 2, rn: 5, offset: 0)
	// Increment digit count
	arm64EmitAddImm(code, rd: 6, rn: 6, imm12: 1)
	// X4 = quotient
	arm64EmitMovReg(code, rd: 4, rn: 3)
	// CBNZ X4, digit_loop
	let cbnzOffset = code.count()
	let loopRelInsns = (digitLoopOffset - cbnzOffset) / 4
	arm64EmitCbnz(code, rn: 4, imm19: loopRelInsns and 0x7FFFF)

	// Return X0 = X5 (pointer), X1 = X6 (length)
	arm64EmitMovReg(code, rd: 0, rn: 5)
	arm64EmitMovReg(code, rd: 1, rn: 6)

	// B to epilogue
	let branchToEpilogueOffset = code.count()
	arm64EmitBranch(code)

	// zero_case: patch CBZ to here
	let zeroCaseOffset = code.count()
	let cbzRelInsns = (zeroCaseOffset - cbzOffset) / 4
	let cbzPatched = 0xB4000000 or ((cbzRelInsns and 0x7FFFF) shl 5) or 4
	patchDword(code, offset: cbzOffset, value: cbzPatched)

	// Store '0' at [X29+47] and return pointer/length
	arm64EmitMovz(code, rd: 2, imm16: 0x30)
	arm64EmitAddImm(code, rd: 0, rn: 29, imm12: 47)
	arm64EmitStrb(code, rt: 2, rn: 0, offset: 0)
	arm64EmitMovz(code, rd: 1, imm16: 1)

	// Epilogue: patch the branch-to-epilogue
	let epilogueOffset = code.count()
	arm64PatchBranch(code, instrOffset: branchToEpilogueOffset, targetOffset: epilogueOffset)

	arm64EmitLdpPostIndex(code, frameSize: frameSize)
	arm64EmitRet(code)

	return offset
end 'arm64EmitI64ToString'

// --- Prologue/Epilogue for user functions ---

// Total frame size = saved frame record (16) + the var/spill/callee-save area
// (`stackSize`) + the outgoing-stack-arg area reserved at the bottom, rounded
// up to the 16-byte sp alignment. `outgoingArgSize` is 0 for the vast majority
// of functions (those that never pass >8 GPR args).
function arm64ComputeFrameSize(stackSize StackSize, outgoingArgSize StackSize) returns StackSize
	let raw = 16 + stackSize + outgoingArgSize
	let aligned = (raw + 15) and not 15
	return aligned
end 'arm64ComputeFrameSize'

// Frame layout (low → high address). When `outgoingArgSize == 0` the bottom
// outgoing-arg block is empty and the prologue collapses to the original
// pre-indexed form, leaving every existing function's encoding unchanged:
//
//   [sp + 0 .. outgoingArgSize)         outgoing call args (written by THIS fn's calls)
//   [sp + outgoingArgSize]              saved x29   = [x29 + 0]
//   [sp + outgoingArgSize + 8]          saved x30   = [x29 + 8]
//   [x29 + 16 .. )                      var/spill/callee-save area
//   [x29 + (frameSize - outgoingArgSize) .. )   incoming args (caller's outgoing area)
//
// x29 always points at the saved frame record, so `[x29 + 16 + slot]` slot
// addressing and the callee-save base are independent of outgoingArgSize.
function arm64EmitPrologue(code ByteArray, stackSize StackSize, tracker Arm64StackTracker)
	let outgoing = tracker.outgoingArgSize
	let frameSize = arm64ComputeFrameSize(stackSize, outgoingArgSize: outgoing)
	if outgoing == 0 'noOutgoing'
		if frameSize <= ARM64_FRAME_PAIR_INDEX_MAX 'compactFrame'
			arm64EmitStpPreIndex(code, frameSize: frameSize)
			arm64EmitMovFpSp(code)
		end 'compactFrame' else 'largeFrame'
			// Frame exceeds the STP pre-indexed imm7 reach (±512 scaled). Adjust
			// SP with ADD/SUB-immediate (which the helper splits across the imm12
			// limit), store the frame record at the new SP, then point x29 at it.
			arm64EmitStackAlloc(code, amount: frameSize)
			arm64EmitStpOffset(code, rt1: 29, rt2: 30, baseReg: 31, offset: 0)
			arm64EmitMovFpSp(code)
		end 'largeFrame'
	end 'noOutgoing' else 'withOutgoing'
		// Reserve the whole frame, then place the frame record ABOVE the
		// outgoing-arg block and point x29 at it.
		arm64EmitStackAlloc(code, amount: frameSize)
		arm64EmitStpOffset(code, rt1: 29, rt2: 30, baseReg: 31, offset: outgoing)
		arm64EmitAddImm(code, rd: 29, rn: 31, imm12: outgoing)
	end 'withOutgoing'
	// Save callee-saved registers after frame setup.
	// They are stored at the end of the frame, after the var+spill area.
	let calleeSaveBase = arm64CalleeSaveBaseOffset(stackSize, tracker: tracker)
	arm64EmitCalleeSavedSaves(code, tracker: tracker, baseOffset: calleeSaveBase)
end 'arm64EmitPrologue'

function arm64EmitEpilogue(code ByteArray, stackSize StackSize, tracker Arm64StackTracker)
	let outgoing = tracker.outgoingArgSize
	let frameSize = arm64ComputeFrameSize(stackSize, outgoingArgSize: outgoing)
	// Restore callee-saved registers before frame teardown.
	let calleeSaveBase = arm64CalleeSaveBaseOffset(stackSize, tracker: tracker)
	arm64EmitCalleeSavedRestores(code, tracker: tracker, baseOffset: calleeSaveBase)
	if outgoing == 0 'noOutgoing'
		if frameSize <= ARM64_FRAME_PAIR_INDEX_MAX 'compactFrame'
			arm64EmitLdpPostIndex(code, frameSize: frameSize)
		end 'compactFrame' else 'largeFrame'
			// Mirror the large-frame prologue: reload the frame record from SP,
			// then free the frame with ADD-immediate (split across the imm12 limit).
			arm64EmitLdpOffset(code, rt1: 29, rt2: 30, baseReg: 31, offset: 0)
			arm64EmitStackFree(code, amount: frameSize)
		end 'largeFrame'
	end 'noOutgoing' else 'withOutgoing'
		arm64EmitLdpOffset(code, rt1: 29, rt2: 30, baseReg: 31, offset: outgoing)
		arm64EmitStackFree(code, amount: frameSize)
	end 'withOutgoing'
	arm64EmitRet(code)
end 'arm64EmitEpilogue'

// Compute the byte offset from x29 where callee-saved registers are stored.
// Layout: [x29/x30 (16 bytes)] [var+spill area] [callee-save GPRs] [callee-save FPs]
function arm64CalleeSaveBaseOffset(stackSize StackSize, tracker Arm64StackTracker) returns StackSize
	let gprCount = tracker.calleeSavedGprs.count()
	let fpCount = tracker.calleeSavedFps.count()
	let gprPairs = (gprCount + 1) / 2
	let fpPairs = (fpCount + 1) / 2
	let calleeSaveArea = (gprPairs + fpPairs) * 16
	// The callee-save area sits at the end of the stack frame.
	// stackSize includes the callee-save area, so the base is at:
	return 16 + stackSize - calleeSaveArea
end 'arm64CalleeSaveBaseOffset'

// Emit save instructions for callee-saved GPRs and FPs.
// Uses STP pairs when offset fits in signed imm7 range (<=504), otherwise individual STR.
function arm64EmitCalleeSavedSaves(code ByteArray, tracker Arm64StackTracker, baseOffset StackSize)
	var offset = baseOffset
	let gprCount = tracker.calleeSavedGprs.count()
	var i = 0
	while i + 1 < gprCount 'gprPairs'
		let r1 = try tracker.calleeSavedGprs.get(i) otherwise panic("arm64EmitCalleeSavedSaves.gprPairs: i+1 < gprCount = calleeSavedGprs.count() but get({i}) failed")
		let r2 = try tracker.calleeSavedGprs.get(i + 1) otherwise panic("arm64EmitCalleeSavedSaves.gprPairs: i+1 < gprCount but get({i + 1}) failed")
		if offset <= 504 'useStp'
			arm64EmitStpOffset(code, rt1: r1, rt2: r2, baseReg: 29, offset: offset)
		end 'useStp' else 'useStr'
			arm64EmitStrRegOffset(code, rt: r1, baseReg: 29, offset: offset)
			arm64EmitStrRegOffset(code, rt: r2, baseReg: 29, offset: offset + 8)
		end 'useStr'
		offset = offset + 16
		i = i + 2
	end 'gprPairs'
	if i < gprCount 'oddGpr'
		let r1 = try tracker.calleeSavedGprs.get(i) otherwise panic("arm64EmitCalleeSavedSaves.oddGpr: i < gprCount just checked but get({i}) failed")
		arm64EmitStrRegOffset(code, rt: r1, baseReg: 29, offset: offset)
		offset = offset + 8
	end 'oddGpr'
	// Align to 16 after GPRs for FP pair alignment
	if gprCount mod 2 != 0 'alignAfterOddGpr'
		offset = offset + 8
	end 'alignAfterOddGpr'

	let fpCount = tracker.calleeSavedFps.count()
	var j = 0
	while j + 1 < fpCount 'fpPairs'
		let r1 = try tracker.calleeSavedFps.get(j) otherwise panic("arm64EmitCalleeSavedSaves.fpPairs: j+1 < fpCount = calleeSavedFps.count() but get({j}) failed")
		let r2 = try tracker.calleeSavedFps.get(j + 1) otherwise panic("arm64EmitCalleeSavedSaves.fpPairs: j+1 < fpCount but get({j + 1}) failed")
		if offset <= 504 'useStp'
			arm64EmitFpStpOffset(code, rt1: r1, rt2: r2, baseReg: 29, offset: offset)
		end 'useStp' else 'useStr'
			arm64EmitFpStrRegOffset(code, rt: r1, baseReg: 29, offset: offset)
			arm64EmitFpStrRegOffset(code, rt: r2, baseReg: 29, offset: offset + 8)
		end 'useStr'
		offset = offset + 16
		j = j + 2
	end 'fpPairs'
	if j < fpCount 'oddFp'
		let r1 = try tracker.calleeSavedFps.get(j) otherwise panic("arm64EmitCalleeSavedSaves.oddFp: j < fpCount just checked but get({j}) failed")
		arm64EmitFpStrRegOffset(code, rt: r1, baseReg: 29, offset: offset)
	end 'oddFp'
end 'arm64EmitCalleeSavedSaves'

// Emit restore instructions for callee-saved GPRs and FPs.
function arm64EmitCalleeSavedRestores(code ByteArray, tracker Arm64StackTracker, baseOffset StackSize)
	var offset = baseOffset
	let gprCount = tracker.calleeSavedGprs.count()
	var i = 0
	while i + 1 < gprCount 'gprPairs'
		let r1 = try tracker.calleeSavedGprs.get(i) otherwise panic("arm64EmitCalleeSavedRestores.gprPairs: i+1 < gprCount = calleeSavedGprs.count() but get({i}) failed")
		let r2 = try tracker.calleeSavedGprs.get(i + 1) otherwise panic("arm64EmitCalleeSavedRestores.gprPairs: i+1 < gprCount but get({i + 1}) failed")
		if offset <= 504 'useLdp'
			arm64EmitLdpOffset(code, rt1: r1, rt2: r2, baseReg: 29, offset: offset)
		end 'useLdp' else 'useLdr'
			arm64EmitLdrRegOffset(code, rt: r1, baseReg: 29, offset: offset)
			arm64EmitLdrRegOffset(code, rt: r2, baseReg: 29, offset: offset + 8)
		end 'useLdr'
		offset = offset + 16
		i = i + 2
	end 'gprPairs'
	if i < gprCount 'oddGpr'
		let r1 = try tracker.calleeSavedGprs.get(i) otherwise panic("arm64EmitCalleeSavedRestores.oddGpr: i < gprCount just checked but get({i}) failed")
		arm64EmitLdrRegOffset(code, rt: r1, baseReg: 29, offset: offset)
		offset = offset + 8
	end 'oddGpr'
	// Align to 16 after GPRs for FP pair alignment
	if gprCount mod 2 != 0 'alignAfterOddGpr'
		offset = offset + 8
	end 'alignAfterOddGpr'

	let fpCount = tracker.calleeSavedFps.count()
	var j = 0
	while j + 1 < fpCount 'fpPairs'
		let r1 = try tracker.calleeSavedFps.get(j) otherwise panic("arm64EmitCalleeSavedRestores.fpPairs: j+1 < fpCount = calleeSavedFps.count() but get({j}) failed")
		let r2 = try tracker.calleeSavedFps.get(j + 1) otherwise panic("arm64EmitCalleeSavedRestores.fpPairs: j+1 < fpCount but get({j + 1}) failed")
		if offset <= 504 'useLdp'
			arm64EmitFpLdpOffset(code, rt1: r1, rt2: r2, baseReg: 29, offset: offset)
		end 'useLdp' else 'useLdr'
			arm64EmitFpLdrRegOffset(code, rt: r1, baseReg: 29, offset: offset)
			arm64EmitFpLdrRegOffset(code, rt: r2, baseReg: 29, offset: offset + 8)
		end 'useLdr'
		offset = offset + 16
		j = j + 2
	end 'fpPairs'
	if j < fpCount 'oddFp'
		let r1 = try tracker.calleeSavedFps.get(j) otherwise panic("arm64EmitCalleeSavedRestores.oddFp: j < fpCount just checked but get({j}) failed")
		arm64EmitFpLdrRegOffset(code, rt: r1, baseReg: 29, offset: offset)
	end 'oddFp'
end 'arm64EmitCalleeSavedRestores'

// Mutable tracker for the current function's stack size and callee-saved registers
export type Arm64StackTracker
	export var currentStackSize as StackSize
	export var calleeSavedGprs as RegIntArray
	export var calleeSavedFps as RegIntArray
	// Bytes reserved at the bottom of the frame for outgoing (>8th GPR) call
	// args. Zero for the overwhelming majority of functions; non-zero only when
	// some call site passes more than 8 GPR args. Drives the prologue/epilogue
	// frame layout and the incoming-arg load offset.
	export var outgoingArgSize as StackSize

	export static function create() returns Arm64StackTracker
		return Self{currentStackSize: 0, calleeSavedGprs: RegIntArray.create(), calleeSavedFps: RegIntArray.create(), outgoingArgSize: 0}
	end 'create'
end 'Arm64StackTracker'

// --- Block jump handlers ---

function arm64HandleCondBranch(code ByteArray, jumpFixups BlockIdFixupArray, condition Arm64CondCode, targetBlock BlockId)
	jumpFixups.push(BlockIdFixup.create(code.count(), targetBlock: targetBlock, isCond: true))
	arm64EmitCondBranch(code, cond: condition.rawValue)
end 'arm64HandleCondBranch'

function arm64HandleBranch(code ByteArray, jumpFixups BlockIdFixupArray, targetBlock BlockId)
	jumpFixups.push(BlockIdFixup.create(code.count(), targetBlock: targetBlock, isCond: false))
	arm64EmitBranch(code)
end 'arm64HandleBranch'

function arm64HandleBranchLink(code ByteArray, callFixups Arm64CallFixupArray, linkTarget String)
	callFixups.push(Arm64CallFixup.create(code.count(), targetName: linkTarget))
	arm64EmitBranchLink(code)
end 'arm64HandleBranchLink'

// Emit ARM64 machine code per-function for stdlib cache building.
// Each function is emitted into its own ObjectFunction with code bytes and
// unresolved fixups (offsets relative to function start).
export function emitArm64PerFunction(module TargetModule, globalData GlobalDataTable) returns ObjectFunctionArray
	var result = ObjectFunctionArray.create()
	var stackTracker = Arm64StackTracker.create()

	registerPanicStrings(globalData)

	for func in module.functions 'eachFunc'
		var objFunc = ObjectFunction.create(func.name, returnType: func.returnType, paramCount: func.paramCount)
		objFunc.paramTypes = func.paramTypes
		var code = objFunc.code
		var callFixups = Arm64CallFixupArray.create()
		var adrFixups = Arm64AdrFixupArray.create()
		var jumpFixups = BlockIdFixupArray.create()
		var blockOffsets = BlockOffsetMap.create()
		var relocations = objFunc.relocations
		var rdataRelocs = objFunc.rdataRelocs

		stackTracker.calleeSavedGprs = func.calleeSavedGprs
		stackTracker.calleeSavedFps = func.calleeSavedFps
		stackTracker.outgoingArgSize = func.outgoingArgSize

		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")

			blockOffsetMapSet(blockOffsets, blockId: block.id, offset: code.count())

			for packed in block.opRefs 'eachOp'
				emitArm64PackedOp(module, packed: packed, code: code, jumpFixups: jumpFixups, callFixups: callFixups, adrFixups: adrFixups, stackTracker: stackTracker, relocations: relocations, rdataRelocs: rdataRelocs)
			end 'eachOp'

			if block.hasTerminatorOp() 'hasTerm'
				emitArm64PackedOp(module, packed: block.terminatorIndex(), code: code, jumpFixups: jumpFixups, callFixups: callFixups, adrFixups: adrFixups, stackTracker: stackTracker, relocations: relocations, rdataRelocs: rdataRelocs)
			end 'hasTerm'
		end 'eachBlock'

		// Resolve block-local jump fixups within this function
		arm64ResolveBlockJumpFixups(code, blockOffsets: blockOffsets, jumpFixups: jumpFixups)

		// Convert ARM64 call fixups to generic CallFixup for storage
		for fixup in callFixups 'convertFixups'
			objFunc.callFixups.push(CallFixup.create(fixup.instrOffset, targetName: fixup.targetName))
		end 'convertFixups'

		// Convert ARM64 adr fixups to CachedAdrFixup for storage
		for fixup in adrFixups 'convertAdr'
			objFunc.adrFixups.push(CachedAdrFixup.create(fixup.instrOffset, destReg: fixup.destReg, targetName: fixup.targetName))
		end 'convertAdr'

		result.push(objFunc)
	end 'eachFunc'

	return result
end 'emitArm64PerFunction'

// Link pre-compiled stdlib functions into the ARM64 code output. `stdlibCache`
// is the pre-link snapshot; this function links from the post-lazy-grow cache
// (`libraryLinkCacheAfterLazyGrow`) so external-library (N>1) builds don't miss
// lazily-grown stdlib bodies — see the X64 `linkX64StdlibFunctionsConcat` mirror.
export function linkArm64StdlibFunctions(project Project, code ByteArray, labelNames StringArray, labelOffsets Arm64OffsetArray, labelOffsetMap Arm64LabelOffsetMap, callFixups Arm64CallFixupArray, adrFixups Arm64AdrFixupArray, rdataRelocs RdataRelocationArray, relocations RelocationArray, globalData GlobalDataTable, stdlibCache StdlibCacheData)
	// Collect seed names from user call fixups and adr fixups
	var seeds = StringArray.create()

	for fixup in callFixups 'collectCallSeeds'
		seeds.push(fixup.targetName)
	end 'collectCallSeeds'

	for fixup in adrFixups 'collectAdrSeeds'
		seeds.push(fixup.targetName)
	end 'collectAdrSeeds'

	// Phase 11.2/11.3: rdata-resident `funcAbs64InRdata` relocs reference
	// __layout_copy_*/destroy thunks and witness method-impls that are
	// reachable only through static rdata pointers — never via a `call`
	// op. Without seeding them as link-roots here, the PE writer panics
	// when the reloc target is missing from `.text`. The witness/layout
	// relocs live on `globalData.pendingRdataRelocs` until the post-link
	// merge below, so seed from both places to cover stdlib targets.
	appendFuncAbs64Seeds(seeds, relocs: rdataRelocs)
	appendFuncAbs64Seeds(seeds, relocs: globalData.pendingRdataRelocs)

	// arm64-macOS hand-emitted-runtime floor seeds. The green-thread + subprocess
	// runtimes (emitArm64MacosGreenThread / emitArm64MacosSubprocess) are emitted
	// UNCONDITIONALLY for every macOS program AFTER this link pass, and their
	// hand-rolled bodies `BL` directly into runtime.std helpers (the async-trace
	// printers `__diag_print_tag`/`__diag_print_i64` via `__gt_trace_emit`, the
	// slab allocator, etc.). Those call fixups don't exist yet when this link
	// computes `needed`, and `computeNeededStdlibFunctions` doesn't consult
	// `backendSynthesizedRuntimeEdges`, so without an explicit seed the cached
	// bodies are never spliced into `.text` and the post-link fixups resolve to a
	// missing label ("Unresolved label '__diag_print_tag'"). Mirrors the
	// unconditional x64-Windows `appendX64Win32RuntimeSeeds` floor — both back the
	// post-link hand-emitted runtime that no IR call edge reaches.
	appendArm64MacosRuntimeSeeds(seeds, target: project.target)

	// v80 lazy codegen: compile (regalloc + emit) every function reachable from
	// `seeds` that the metadata-only cold cache hasn't emitted yet, into the
	// registry's stdlib `cacheData.functions` (index 0), before the closure reads
	// it. Mirrors the x64 concat path. No-op once the cache carries every
	// reachable function.
	ensureStdlibFunctionsCompiled(project, seeds: seeds)

	// Link from the post-lazy-grow cache (mirrors X64Backend): the threaded
	// `stdlibCache` aliases the registry's stdlib array only on the N=1 fast path;
	// with an external library registered it is a detached union COPY that does
	// NOT see the lazily-grown stdlib bodies, so the closure + link loop would
	// miss them (crash at runtime startup). `libraryLinkCacheAfterLazyGrow` uses
	// the param directly on N=1 (byte-identical) and re-derives on N>1.
	let linkedCache = libraryLinkCacheAfterLazyGrow(stdlibCache)
	let needed = computeNeededStdlibFunctions(seeds, stdlibCache: linkedCache)

	// Append each needed function's code and fixups
	for func in linkedCache.functions 'linkFuncs'
		if not needed.contains(func.name) 'skip'
			continue
		end 'skip'

		let funcStart = code.count()

		labelNames.push(func.name)
		labelOffsets.push(funcStart)
		labelOffsetMap.upsert(func.name, value: funcStart)
		code.append(func.code)

		// Convert generic CallFixups to ARM64 call fixups
		for fixup in func.callFixups 'adjustFixups'
			callFixups.push(Arm64CallFixup.create(funcStart + fixup.codeOffset, targetName: fixup.targetName))
		end 'adjustFixups'

		// Convert cached adr fixups to ARM64 adr fixups
		for fixup in func.adrFixups 'adjustAdr'
			adrFixups.push(Arm64AdrFixup.create(funcStart + fixup.instrOffset, destReg: fixup.destReg, targetName: fixup.targetName))
		end 'adjustAdr'

		for reloc in func.rdataRelocs 'adjustRdata'
			rdataRelocs.push(RdataRelocation.create(funcStart + reloc.codeOffset, rdataLabel: reloc.rdataLabel, kind: reloc.kind))
		end 'adjustRdata'

		for reloc in func.relocations 'adjustRelocs'
			relocations.push(Relocation.create(funcStart + reloc.codeOffset, slotIndex: reloc.slotIndex))
		end 'adjustRelocs'
	end 'linkFuncs'

	mergeStdlibGlobalData(globalData, rdataRelocs: rdataRelocs, stdlibCache: linkedCache)
	logInfo(LogCategory.compiler, message: function() gives "Linked {needed.count()} stdlib functions ({linkedCache.functions.count()} available)")
end 'linkArm64StdlibFunctions'

// Append the arm64-macOS hand-emitted-runtime floor: the runtime.std function
// names whose bodies are `BL`'d by the green-thread + subprocess runtimes that
// `concatArm64FunctionChunks` emits unconditionally AFTER the stdlib link pass.
// Because those call fixups are added post-link and `computeNeededStdlibFunctions`
// only walks real cache call/adr edges (not `backendSynthesizedRuntimeEdges`),
// these names must be seeded into the link-root set explicitly or the cached
// bodies are pruned and the post-link fixups resolve to a missing label. No-op
// off arm64-macOS (no hand-emitted runtime there). Shares the SAME name lists the
// reachability / lazy-codegen closures use (`arm64MacosGreenThreadRuntimeNames` /
// `arm64MacosSubprocessRuntimeNames`) so the link floor can't drift from the set
// those closures compiled into the cache.
function appendArm64MacosRuntimeSeeds(seeds StringArray, target Target)
	if not (target.cpu == CpuArch.arm64 and target.os == Os.macos) 'notArm64Macos'
		return
	end 'notArm64Macos'
	for name in arm64MacosGreenThreadRuntimeNames() 'gtSeed'
		seeds.push(name)
	end 'gtSeed'
	for name in arm64MacosSubprocessRuntimeNames() 'subpSeed'
		seeds.push(name)
	end 'subpSeed'
end 'appendArm64MacosRuntimeSeeds'

// Emit a single target op by index.
export function emitArm64PackedOp(module TargetModule, packed OpIndex, code ByteArray, jumpFixups BlockIdFixupArray, callFixups Arm64CallFixupArray, adrFixups Arm64AdrFixupArray, stackTracker Arm64StackTracker, relocations RelocationArray, rdataRelocs RdataRelocationArray)
	let a64Op = try module.arm64Ops.get(packed) otherwise panic("invariant: packed opIdx not in module.arm64Ops")
	emitArm64Instruction(a64Op, code: code, jumpFixups: jumpFixups, callFixups: callFixups, adrFixups: adrFixups, stackTracker: stackTracker, relocations: relocations, rdataRelocs: rdataRelocs)
end 'emitArm64PackedOp'

// Emit machine code for a single Arm64Op.
function emitArm64Instruction(op Arm64Op, code ByteArray, jumpFixups BlockIdFixupArray, callFixups Arm64CallFixupArray, adrFixups Arm64AdrFixupArray, stackTracker Arm64StackTracker, relocations RelocationArray, rdataRelocs RdataRelocationArray)
	match op 'emit'
		prologue(stackSize) then emitArm64PrologueOp(code, stackSize: stackSize, tracker: stackTracker)
		epilogue then arm64EmitEpilogue(code, stackSize: stackTracker.currentStackSize, tracker: stackTracker)
		movImm(dest, value) then arm64EmitMovImm(code, rd: resolveArm64Gpr(dest).rawValue, value: value)
		strToSlot(slotIndex, src) then arm64EmitStrSlot(code, rt: resolveArm64Gpr(src).rawValue, slotIndex: slotIndex)
		ldrFromSlot(dest, slotIndex) then arm64EmitLdrSlot(code, rt: resolveArm64Gpr(dest).rawValue, slotIndex: slotIndex)
		addRegs(dest, src1, src2) then arm64EmitAdd(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		addsRegs(dest, src1, src2) then arm64EmitAdds(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		subRegs(dest, src1, src2) then arm64EmitSub(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		subsRegs(dest, src1, src2) then arm64EmitSubs(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		mulRegs(dest, src1, src2) then arm64EmitMul(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		sdivRegs(dest, src1, src2) then arm64EmitSdiv(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		remRegs(dest, src1, src2) then arm64EmitRem(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		negReg(dest, src) then arm64EmitNeg(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src).rawValue)
		mvnReg(dest, src) then arm64EmitMvn(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src).rawValue)
		andRegs(dest, src1, src2) then arm64EmitAnd(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		andsRegs(dest, src1, src2) then arm64EmitAnds(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		orrRegs(dest, src1, src2) then arm64EmitOrr(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		eorRegs(dest, src1, src2) then arm64EmitEor(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		lslRegs(dest, src1, src2) then arm64EmitLslv(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		asrRegs(dest, src1, src2) then arm64EmitAsrv(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		lsrRegs(dest, src1, src2) then arm64EmitLsrv(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		cmpRegs(src1, src2) then arm64EmitCmp(code, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue)
		cmpRegZero(src) then arm64EmitCmpRegZero(code, rn: resolveArm64Gpr(src).rawValue)
		condBranch(condition, targetBlock) then arm64HandleCondBranch(code, jumpFixups: jumpFixups, condition: condition, targetBlock: targetBlock)
		branch(targetBlock) then arm64HandleBranch(code, jumpFixups: jumpFixups, targetBlock: targetBlock)
		branchLink(linkTarget) then arm64HandleBranchLink(code, callFixups: callFixups, linkTarget: linkTarget)
		ret then arm64EmitRet(code)
		syscall(resultSlot, number, argSlots) then arm64EmitSyscallOp(code, resultSlot: resultSlot, number: number, argSlots: argSlots)
		iatCall(resultSlot, slotIndex, argSlots) then arm64EmitIatCallOp(code, relocations: relocations, resultSlot: resultSlot, slotIndex: slotIndex, argSlots: argSlots)
		globalAddr(resultSlot, name) then arm64EmitGlobalAddrOp(code, rdataRelocs: rdataRelocs, resultSlot: resultSlot, name: name)
		stackAddrOp(resultSlot, targetSlot) then arm64EmitStackAddrOp(code, resultSlot: resultSlot, targetSlot: targetSlot)
		storeByteOp(baseSlot, offsetSlot, byteSlot) then arm64EmitStoreByteOp(code, baseSlot: baseSlot, offsetSlot: offsetSlot, byteSlot: byteSlot)
		loadByteOp(resultSlot, baseSlot, offsetSlot) then arm64EmitLoadByteOp(code, resultSlot: resultSlot, baseSlot: baseSlot, offsetSlot: offsetSlot)
		memcpyOp(dstSlot, srcSlot, lenSlot) then arm64EmitMemcpyOp(code, dstSlot: dstSlot, srcSlot: srcSlot, lenSlot: lenSlot)
		memzeroOp(dstSlot, lenSlot) then arm64EmitMemzeroOp(code, dstSlot: dstSlot, lenSlot: lenSlot)
		// Register allocator ops
		movRegReg(dest, src) then arm64EmitMovRegReg(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src).rawValue)
		spillToStack(offset, src) then arm64EmitSpillToStack(code, rt: resolveArm64Gpr(src).rawValue, byteOffset: offset)
		reloadFromStack(dest, offset) then arm64EmitReloadFromStack(code, rt: resolveArm64Gpr(dest).rawValue, byteOffset: offset)
		loadIncomingArg(dest, argIndex) then arm64EmitLoadIncomingArg(code, rt: resolveArm64Gpr(dest).rawValue, argIndex: argIndex, tracker: stackTracker)
		branchLinkReg(reg) then arm64EmitBlr(code, rn: resolveArm64Gpr(reg).rawValue)
		subSpImm(value) then arm64EmitSubImm(code, rd: 31, rn: 31, imm12: value)
		addSpImm(value) then arm64EmitAddImm(code, rd: 31, rn: 31, imm12: value)
		strToSpOffset(offset, src) then arm64EmitStrSpOffset(code, rt: resolveArm64Gpr(src).rawValue, byteOffset: offset)
		// FP ops — emit using ARM64 FP instruction encodings
		fmovRegReg(dest, src, _) then arm64EmitFmovDD(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue)
		spillFpToStack(offset, src, _) then arm64EmitFpSpillToStack(code, rt: resolveArm64Fp(src).rawValue, byteOffset: offset)
		reloadFpFromStack(dest, offset, _) then arm64EmitFpReloadFromStack(code, rt: resolveArm64Fp(dest).rawValue, byteOffset: offset)
		fpLoadRdata(dest, rdataLabel, precision) then arm64EmitFpLoadRdata(code, dest: resolveArm64Fp(dest), rdataLabel: rdataLabel, precision: precision, rdataRelocs: rdataRelocs)
		fmovToFloat(dest, src, precision) then arm64EmitFmovGprToFp(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Gpr(src).rawValue, precision: precision)
		fmovToGpr(dest, src, precision) then arm64EmitFmovFpToGpr(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		fadd(dest, src1, src2, precision) then arm64EmitFadd(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src1).rawValue, rm: resolveArm64Fp(src2).rawValue, precision: precision)
		fsub(dest, src1, src2, precision) then arm64EmitFsub(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src1).rawValue, rm: resolveArm64Fp(src2).rawValue, precision: precision)
		fmul(dest, src1, src2, precision) then arm64EmitFmul(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src1).rawValue, rm: resolveArm64Fp(src2).rawValue, precision: precision)
		fdiv(dest, src1, src2, precision) then arm64EmitFdiv(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src1).rawValue, rm: resolveArm64Fp(src2).rawValue, precision: precision)
		fmin(dest, src1, src2, precision) then arm64EmitFmin(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src1).rawValue, rm: resolveArm64Fp(src2).rawValue, precision: precision)
		fmax(dest, src1, src2, precision) then arm64EmitFmax(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src1).rawValue, rm: resolveArm64Fp(src2).rawValue, precision: precision)
		fsqrt(dest, src, precision) then arm64EmitFsqrt(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		fabs(dest, src, precision) then arm64EmitFabs(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		fneg(dest, src, precision) then arm64EmitFneg(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		fcmp(src1, src2, precision) then arm64EmitFcmp(code, rn: resolveArm64Fp(src1).rawValue, rm: resolveArm64Fp(src2).rawValue, precision: precision)
		scvtf(dest, src, precision) then arm64EmitScvtf(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Gpr(src).rawValue, precision: precision)
		fcvtzs(dest, src, precision) then arm64EmitFcvtzs(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		fcvt(dest, src, destPrecision) then arm64EmitFcvt(code, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue, destPrecision: destPrecision)
		frintm(dest, src, precision) then arm64EmitFrint(code, opcodeDouble: 0x1E654000, opcodeSingle: 0x1E254000, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		frintp(dest, src, precision) then arm64EmitFrint(code, opcodeDouble: 0x1E64C000, opcodeSingle: 0x1E24C000, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		frintz(dest, src, precision) then arm64EmitFrint(code, opcodeDouble: 0x1E65C000, opcodeSingle: 0x1E25C000, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		frintn(dest, src, precision) then arm64EmitFrint(code, opcodeDouble: 0x1E644000, opcodeSingle: 0x1E244000, rd: resolveArm64Fp(dest).rawValue, rn: resolveArm64Fp(src).rawValue, precision: precision)
		loadIndirect(destReg, baseReg, offset, width, signed) then arm64EmitLoadIndirectOp(code, destReg: destReg, baseReg: baseReg, offset: offset, width: width, signed: signed)
		leaFuncAddr(dest, funcName) then arm64EmitLeaFuncAddrOp(code, dest: dest, funcName: funcName, adrFixups: adrFixups, rdataRelocs: rdataRelocs)
		fpStoreIndirect(baseReg, offset, src, precision) then arm64EmitFpStoreIndirectOp(code, baseReg: baseReg, offset: offset, src: src, precision: precision)
		fpLoadIndirect(dest, baseReg, offset, precision) then arm64EmitFpLoadIndirectOp(code, dest: dest, baseReg: baseReg, offset: offset, precision: precision)
		storeIndirect(baseReg, offset, srcReg, width) then arm64EmitStoreIndirectOp(code, baseReg: baseReg, offset: offset, srcReg: srcReg, width: width)
		globalLoad(dest, name, size) then arm64EmitGlobalLoadOp(code, dest: dest, name: name, size: size, rdataRelocs: rdataRelocs)
		globalStore(name, src, size) then arm64EmitGlobalStoreOp(code, name: name, src: src, size: size, rdataRelocs: rdataRelocs)
		globalLoadFloat(dest, name, precision) then arm64EmitGlobalLoadFloatOp(code, dest: dest, name: name, precision: precision)
		globalStoreFloat(name, src, precision) then arm64EmitGlobalStoreFloatOp(code, name: name, src: src, precision: precision)
		leaFromStack(dest, stackOffset) then arm64EmitLeaFromStackOp(code, dest: dest, stackOffset: stackOffset)
		leaRdata(dest, rdataLabel) then arm64EmitLeaRdataOp(code, dest: dest, rdataLabel: rdataLabel, rdataRelocs: rdataRelocs)
		cset(dest, condition) then arm64EmitCset(code, rd: resolveArm64Gpr(dest).rawValue, cond: condition.rawValue)
		csel(dest, src1, src2, condition) then arm64EmitCsel(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src1).rawValue, rm: resolveArm64Gpr(src2).rawValue, cond: condition.rawValue)
		sxtw(dest, src) then arm64EmitSxtw(code, rd: resolveArm64Gpr(dest).rawValue, rn: resolveArm64Gpr(src).rawValue)
		nullSafeLoad(dest, baseReg, offset) then arm64EmitNullSafeLoadOp(code, dest: dest, baseReg: baseReg, offset: offset)
		atomicIncMem(addrReg) then arm64EmitAtomicIncMem(code, addrReg: addrReg)
		atomicDecMem(addrReg) then arm64EmitAtomicDecMem(code, addrReg: addrReg)
		atomicXaddMem(resultReg, addrReg, valReg) then arm64EmitAtomicXaddMem(code, resultReg: resultReg, addrReg: addrReg, valReg: valReg)
		atomicCasMem(resultReg, addrReg, oldReg, newReg) then arm64EmitAtomicCasMem(code, resultReg: resultReg, addrReg: addrReg, oldReg: oldReg, newReg: newReg)
		stashEntryArgv then arm64EmitStashEntryArgvOp(code, rdataRelocs: rdataRelocs)
		// Phase 2 dialect groundwork. No codegen path emits these yet — Phase 3's
		// memory-operand fold capability flag is false on arm64, so the fold pass
		// never builds these ops. If anything ever does, the encoder panics with a
		// clear message so the regression is loud rather than silent miscompilation.
		// The arm64 add/sub-imm encoding uses ADD/SUB (immediate) with a 12-bit imm
		// (optionally shifted by 12); and/orr/eor use the bitmask-immediate encoder
		// (N:immr:imms triple), which is non-trivial. Wiring real encoders is
		// deferred until a phase actually emits these ops on arm64.
		addRegImm then panic("arm64 addRegImm encoder not yet implemented (Phase 2 dialect-only)")
		subRegImm then panic("arm64 subRegImm encoder not yet implemented (Phase 2 dialect-only)")
		andRegImm then panic("arm64 andRegImm encoder not yet implemented (Phase 2 dialect-only)")
		orRegImm then panic("arm64 orRegImm encoder not yet implemented (Phase 2 dialect-only)")
		xorRegImm then panic("arm64 xorRegImm encoder not yet implemented (Phase 2 dialect-only)")
	end 'emit'
end 'emitArm64Instruction'

function emitArm64PrologueOp(code ByteArray, stackSize StackSize, tracker Arm64StackTracker)
	tracker.currentStackSize = stackSize
	arm64EmitPrologue(code, stackSize: stackSize, tracker: tracker)
end 'emitArm64PrologueOp'

// --- StdSystemOp emission (ARM64) ---

// sys.syscall: Linux ARM64 syscall (svc #0)
// ARM64 syscall ABI: x0-x5 = args, x8 = syscall number, result in x0
function arm64EmitSyscallOp(code ByteArray, resultSlot VarSlot, number MachineWord, argSlots VarSlotArray)
	let argCount = argSlots.count()

	// Load args into x0-x5
	if argCount >= 1 'arg0'
		let slot0 = try argSlots.get(0) otherwise panic("arm64EmitSyscallOp.arg0: argCount >= 1 just checked but get(0) failed")
		arm64EmitLdrSlot(code, rt: 0, slotIndex: slot0)
	end 'arg0'
	if argCount >= 2 'arg1'
		let slot1 = try argSlots.get(1) otherwise panic("arm64EmitSyscallOp.arg1: argCount >= 2 just checked but get(1) failed")
		arm64EmitLdrSlot(code, rt: 1, slotIndex: slot1)
	end 'arg1'
	if argCount >= 3 'arg2'
		let slot2 = try argSlots.get(2) otherwise panic("arm64EmitSyscallOp.arg2: argCount >= 3 just checked but get(2) failed")
		arm64EmitLdrSlot(code, rt: 2, slotIndex: slot2)
	end 'arg2'
	if argCount >= 4 'arg3'
		let slot3 = try argSlots.get(3) otherwise panic("arm64EmitSyscallOp.arg3: argCount >= 4 just checked but get(3) failed")
		arm64EmitLdrSlot(code, rt: 3, slotIndex: slot3)
	end 'arg3'
	if argCount >= 5 'arg4'
		let slot4 = try argSlots.get(4) otherwise panic("arm64EmitSyscallOp.arg4: argCount >= 5 just checked but get(4) failed")
		arm64EmitLdrSlot(code, rt: 4, slotIndex: slot4)
	end 'arg4'
	if argCount >= 6 'arg5'
		let slot5 = try argSlots.get(5) otherwise panic("arm64EmitSyscallOp.arg5: argCount >= 6 just checked but get(5) failed")
		arm64EmitLdrSlot(code, rt: 5, slotIndex: slot5)
	end 'arg5'

	// mov x8, number
	arm64EmitMovImm(code, rd: 8, value: number)
	// svc #0
	arm64EmitSvc(code)

	// Store result (x0) to resultSlot
	arm64EmitStrSlot(code, rt: 0, slotIndex: resultSlot)
end 'arm64EmitSyscallOp'

// sys.iatCall: Windows ARM64 IAT indirect call
// AAPCS64: x0-x7 for args, result in x0
function arm64EmitIatCallOp(code ByteArray, relocations RelocationArray, resultSlot VarSlot, slotIndex MachineWord, argSlots VarSlotArray)
	let argCount = argSlots.count()

	// Load args into x0-x7 (AAPCS64 integer arg registers). mmap needs all six
	// of x0-x5; functions like _NSGetExecutablePath use two.
	if argCount >= 1 'arg0'
		let slot0 = try argSlots.get(0) otherwise panic("arm64EmitIatCallOp.arg0: argCount >= 1 just checked but get(0) failed")
		arm64EmitLdrSlot(code, rt: 0, slotIndex: slot0)
	end 'arg0'
	if argCount >= 2 'arg1'
		let slot1 = try argSlots.get(1) otherwise panic("arm64EmitIatCallOp.arg1: argCount >= 2 just checked but get(1) failed")
		arm64EmitLdrSlot(code, rt: 1, slotIndex: slot1)
	end 'arg1'
	if argCount >= 3 'arg2'
		let slot2 = try argSlots.get(2) otherwise panic("arm64EmitIatCallOp.arg2: argCount >= 3 just checked but get(2) failed")
		arm64EmitLdrSlot(code, rt: 2, slotIndex: slot2)
	end 'arg2'
	if argCount >= 4 'arg3'
		let slot3 = try argSlots.get(3) otherwise panic("arm64EmitIatCallOp.arg3: argCount >= 4 just checked but get(3) failed")
		arm64EmitLdrSlot(code, rt: 3, slotIndex: slot3)
	end 'arg3'
	if argCount >= 5 'arg4'
		let slot4 = try argSlots.get(4) otherwise panic("arm64EmitIatCallOp.arg4: argCount >= 5 just checked but get(4) failed")
		arm64EmitLdrSlot(code, rt: 4, slotIndex: slot4)
	end 'arg4'
	if argCount >= 6 'arg5'
		let slot5 = try argSlots.get(5) otherwise panic("arm64EmitIatCallOp.arg5: argCount >= 6 just checked but get(5) failed")
		arm64EmitLdrSlot(code, rt: 5, slotIndex: slot5)
	end 'arg5'
	if argCount >= 7 'arg6'
		let slot6 = try argSlots.get(6) otherwise panic("arm64EmitIatCallOp.arg6: argCount >= 7 just checked but get(6) failed")
		arm64EmitLdrSlot(code, rt: 6, slotIndex: slot6)
	end 'arg6'
	if argCount >= 8 'arg7'
		let slot7 = try argSlots.get(7) otherwise panic("arm64EmitIatCallOp.arg7: argCount >= 8 just checked but get(7) failed")
		arm64EmitLdrSlot(code, rt: 7, slotIndex: slot7)
	end 'arg7'

	// Load IAT slot address via ADRP + LDR, then BLR
	relocations.push(Relocation.create(code.count(), slotIndex: slotIndex))
	arm64EmitAdrp(code, rd: 16)
	arm64EmitLdrImm(code, rt: 16, rn: 16, imm12: 0)
	arm64EmitBlr(code, rn: 16)

	// Store result (x0) to resultSlot
	arm64EmitStrSlot(code, rt: 0, slotIndex: resultSlot)
end 'arm64EmitIatCallOp'

// sys.globalAddr: ADRP X0, page(label) ; ADD X0, X0, #pageoff(label) — patched by
// the binary writer after layout. The ADRP+ADD pair has ±4 GiB reach; the single
// ADR it replaced reached only ±1 MiB and silently truncated a global's address once
// a program's code-to-data distance exceeded that window (the same hazard the
// green-thread runtime accessors hit at multi-M scale). The label's output section
// (writable .data heap arena vs read-only .rdata vs .covdata) is decided by the
// shared classifyGlobalLabel so the data-section global set matches the x64 backend
// and never silently drops a mutable-global prefix into read-only .rdata.
function arm64EmitGlobalAddrOp(code ByteArray, rdataRelocs RdataRelocationArray, resultSlot VarSlot, name String)
	let (adrpKind, pageOffKind) = arm64AdrpPageOffKindsForLabel(name)
	// ADRP X0, page(label) — page reloc on this instruction.
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: name, kind: adrpKind))
	arm64EmitAdrp(code, rd: 0)
	// ADD X0, X0, #pageoff(label) — within-page reloc on the following instruction.
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: name, kind: pageOffKind))
	arm64EmitAddImm(code, rd: 0, rn: 0, imm12: 0)

	// Store to resultSlot
	arm64EmitStrSlot(code, rt: 0, slotIndex: resultSlot)
end 'arm64EmitGlobalAddrOp'

// loadIndirect: dispatches to the dedicated ARMv8 unsigned-immediate
// load instruction for each width. The narrow forms come in signed and
// unsigned variants (LDRSB vs LDRB, LDRSH vs LDRH, LDRSW vs LDR W). At
// the qword width signedness is moot — `LDR Xn` already loads a full
// 64-bit value with no extension.
function arm64EmitLoadIndirectOp(code ByteArray, destReg Arm64VReg, baseReg Arm64VReg, offset MachineWord, width StoreWidth, signed bool)
	let rd = resolveArm64Gpr(destReg).rawValue
	let rn = resolveArm64Gpr(baseReg).rawValue
	match width 'w'
		qword then arm64EmitLdrImm(code, rt: rd, rn: rn, imm12: offset)
		word then arm64EmitLoadWordWidth(code, rt: rd, rn: rn, offset: offset, signed: signed)
		halfword then arm64EmitLoadHalfwordWidth(code, rt: rd, rn: rn, offset: offset, signed: signed)
		byte then arm64EmitLoadByteWidth(code, rt: rd, rn: rn, offset: offset, signed: signed)
	end 'w'
end 'arm64EmitLoadIndirectOp'

// LDR Wt, [Xn, #imm12] (unsigned 32-bit) zero-extends to Xt automatically.
// LDRSW Xt, [Xn, #imm12] sign-extends to 64 bits. imm12 is scaled by 4
// for both encodings.
export function arm64EmitLoadWordWidth(code ByteArray, rt MachineWord, rn MachineWord, offset MachineWord, signed bool)
	let base = 0xB9800000 if signed else 0xB9400000
	let insn = base or (((offset / 4) and 0xFFF) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLoadWordWidth'

// LDRH Wt, [Xn, #imm12] (unsigned 16-bit, zero-extends to Wt; the upper
// 32 bits of Xt are then zero per the writeback semantics of W-register
// destinations). LDRSH Xt, [Xn, #imm12] sign-extends directly into Xt.
// imm12 is scaled by 2.
function arm64EmitLoadHalfwordWidth(code ByteArray, rt MachineWord, rn MachineWord, offset MachineWord, signed bool)
	let base = 0x79800000 if signed else 0x79400000
	let insn = base or (((offset / 2) and 0xFFF) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLoadHalfwordWidth'

// LDRB Wt, [Xn, #imm12] (unsigned 8-bit, zero-extends). LDRSB Xt sign-
// extends into Xt. imm12 is unscaled.
function arm64EmitLoadByteWidth(code ByteArray, rt MachineWord, rn MachineWord, offset MachineWord, signed bool)
	let base = 0x39800000 if signed else 0x39400000
	let insn = base or ((offset and 0xFFF) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitLoadByteWidth'

// leaFuncAddr: materialize a function's `.text` address into `dest`.
//
// A function pointer needs ±4 GiB reach: the single `ADR` this used to emit
// reaches only ±1 MiB, and `arm64PatchAdr` SILENTLY truncated the fixup to 21
// bits once the target sat farther than that in a large binary — wrapping the
// address to a garbage mid-function offset. That was the self-built compiler's
// startup crash: a heap object's destructor pointer (`__mm_alloc`'s
// `funcAddr __destruct___ManagedMemory`) was ~6.86 MiB from its use in
// `__module_init_3`, so the ADR wrapped and `__mm_free` jumped into the middle
// of an unrelated function. Emit an `ADRP dest, page(func)` + `ADD dest, dest,
// #pageoff(func)` pair instead (the shape `Arm64Dialect` already names for
// leaFuncAddr); the per-target writer patches both with the absolute VA via
// `arm64ResolveFuncAdrpFixups` -> `patchArm64FuncAdrpRelocs`.
//
// `__symtable` stays a single ADR against the separate `.symtab` section: it is
// resolved through the writer's `symdataArm64Adr` reloc, which guards its ±1 MiB
// reach with `assertSignedReach` (a loud link error, never a silent wrap).
function arm64EmitLeaFuncAddrOp(code ByteArray, dest Arm64VReg, funcName String, adrFixups Arm64AdrFixupArray, rdataRelocs RdataRelocationArray)
	let rd = resolveArm64Gpr(dest).rawValue
	if funcName == "__symtable" 'isSymtable'
		rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: "__symtable", kind: RdataRelocKind.symdataArm64Adr))
		arm64EmitAdr(code, rd: rd, offset: 0)
	end 'isSymtable' else 'isFunc'
		// Record the fixup at the ADRP; the paired ADD sits at instrOffset + 4.
		adrFixups.push(Arm64AdrFixup.create(code.count(), destReg: rd, targetName: funcName))
		arm64EmitAdrp(code, rd: rd)
		arm64EmitAddImm(code, rd: rd, rn: rd, imm12: 0)
	end 'isFunc'
end 'arm64EmitLeaFuncAddrOp'

// sys.stackAddr: ADD Xd, X29, #offset to get address of a stack slot
function arm64EmitStackAddrOp(code ByteArray, resultSlot VarSlot, targetSlot VarSlot)
	let offset = 16 + targetSlot * 8
	// ADD X0, X29, #offset — wide form: `offset` reaches past 0xFFF for
	// high slot indices (e.g. mrt_executable_path's slot-522 path buffer),
	// which a plain 12-bit ADD would truncate.
	arm64EmitAddImmWide(code, rd: 0, rn: 29, imm: offset)
	arm64EmitStrSlot(code, rt: 0, slotIndex: resultSlot)
end 'arm64EmitStackAddrOp'

// sys.storeByte: STRB at base+offset
function arm64EmitStoreByteOp(code ByteArray, baseSlot VarSlot, offsetSlot VarSlot, byteSlot VarSlot)
	// Load base into x0
	arm64EmitLdrSlot(code, rt: 0, slotIndex: baseSlot)
	// Load offset into x1
	arm64EmitLdrSlot(code, rt: 1, slotIndex: offsetSlot)
	// Load byte value into x2
	arm64EmitLdrSlot(code, rt: 2, slotIndex: byteSlot)
	// ADD X0, X0, X1 (base + offset)
	arm64EmitAdd(code, rd: 0, rn: 0, rm: 1)
	// STRB W2, [X0, #0]
	arm64EmitStrb(code, rt: 2, rn: 0, offset: 0)
end 'arm64EmitStoreByteOp'

// sys.loadByte: LDRB from base+offset
function arm64EmitLoadByteOp(code ByteArray, resultSlot VarSlot, baseSlot VarSlot, offsetSlot VarSlot)
	// Load base into x0
	arm64EmitLdrSlot(code, rt: 0, slotIndex: baseSlot)
	// Load offset into x1
	arm64EmitLdrSlot(code, rt: 1, slotIndex: offsetSlot)
	// ADD X0, X0, X1 (base + offset)
	arm64EmitAdd(code, rd: 0, rn: 0, rm: 1)
	// LDRB W0, [X0, #0]
	arm64EmitLdrb(code, rt: 0, rn: 0, offset: 0)
	// Store result
	arm64EmitStrSlot(code, rt: 0, slotIndex: resultSlot)
end 'arm64EmitLoadByteOp'

// sys.memcpy: byte-by-byte copy loop
function arm64EmitMemcpyOp(code ByteArray, dstSlot VarSlot, srcSlot VarSlot, lenSlot VarSlot)
	// Load dst into x0, src into x1, len into x2
	arm64EmitLdrSlot(code, rt: 0, slotIndex: dstSlot)
	arm64EmitLdrSlot(code, rt: 1, slotIndex: srcSlot)
	arm64EmitLdrSlot(code, rt: 2, slotIndex: lenSlot)

	// CBZ X2, done (skip if length is 0)
	let cbzOffset = code.count()
	arm64EmitCbz(code, rn: 2, imm19: 0)

	// loop: LDRB W3, [X1], #1; STRB W3, [X0], #1; SUB X2, X2, #1; CBNZ X2, loop
	let loopOffset = code.count()

	// LDRB W3, [X1, #0]
	arm64EmitLdrb(code, rt: 3, rn: 1, offset: 0)
	// STRB W3, [X0, #0]
	arm64EmitStrb(code, rt: 3, rn: 0, offset: 0)
	// ADD X0, X0, #1 (advance dst)
	arm64EmitAddImm(code, rd: 0, rn: 0, imm12: 1)
	// ADD X1, X1, #1 (advance src)
	arm64EmitAddImm(code, rd: 1, rn: 1, imm12: 1)
	// SUB X2, X2, #1 (decrement len)
	arm64EmitSubImm(code, rd: 2, rn: 2, imm12: 1)
	// CBNZ X2, loop
	let cbnzOffset = code.count()
	let loopRelInsns = (loopOffset - cbnzOffset) / 4
	arm64EmitCbnz(code, rn: 2, imm19: loopRelInsns and 0x7FFFF)

	// done: patch CBZ
	let doneOffset = code.count()
	let cbzRelInsns = (doneOffset - cbzOffset) / 4
	let cbzPatched = 0xB4000000 or ((cbzRelInsns and 0x7FFFF) shl 5) or 2
	patchDword(code, offset: cbzOffset, value: cbzPatched)
end 'arm64EmitMemcpyOp'

// --- memzero (arm64 counterpart of emitX64MemzeroOp) ---

// Condition codes used by the ladder.
let ARM64_COND_LO = 0x3
let ARM64_COND_HS = 0x2

// Register numbers. XZR is encoded as register 31 in the Rt/Rt2 fields.
let ARM64_XZR = 31
let ARM64_MEMZERO_DST = 0
let ARM64_MEMZERO_LEN = 1
let ARM64_MEMZERO_END = 2

// Bytes per iteration of the bulk loop: four STPs of a zero pair.
let ARM64_MEMZERO_LOOP_STRIDE = 64

// STP XZR, XZR, [base, #offset] — store 16 zero bytes.
function arm64EmitStpZeroPair(code ByteArray, baseReg MachineWord, offset MachineWord)
	arm64EmitStpOffset(code, rt1: ARM64_XZR, rt2: ARM64_XZR, baseReg: baseReg, offset: offset)
end 'arm64EmitStpZeroPair'

// `count` consecutive zero-pair stores (16 bytes each) from [base + startOffset].
function arm64EmitStpZeroRun(code ByteArray, baseReg MachineWord, startOffset MachineWord, count MachineWord)
	for i in 0 upto count 'pairs'
		arm64EmitStpZeroPair(code, baseReg: baseReg, offset: startOffset + i * 16)
	end 'pairs'
end 'arm64EmitStpZeroRun'

// Patch a B.cond emitted with a placeholder so it targets the current end of `code`.
function arm64PatchCondBranchToHere(code ByteArray, site ByteOffset, cond MachineWord)
	let rel = (code.count() - site) / 4
	patchDword(code, offset: site, value: 0x54000000 or ((rel and 0x7FFFF) shl 5) or cond)
end 'arm64PatchCondBranchToHere'

// Patch a B emitted with a placeholder so it targets the current end of `code`.
function arm64PatchBranchToHere(code ByteArray, site ByteOffset)
	let rel = (code.count() - site) / 4
	patchDword(code, offset: site, value: 0x14000000 or (rel and 0x3FFFFFF))
end 'arm64PatchBranchToHere'

// arm64.memzero — zero `len` bytes at `dst`. The counterpart of emitX64MemzeroOp,
// and the same shape: a size ladder inside ONE macro-op's emitter, with locally
// patched branches, because the MIR->target conversion cannot create blocks.
//
// x2 is pinned to the END of the region so every arm can anchor its backward
// stores on it; each band writes forward from the start AND backward from the end,
// letting the middle be written twice. That covers any length in the band with
// straight-line stores — no loop, and no ragged-tail handling for lengths that
// are not multiples of 8.
//
// Uses STP (16 B/store) rather than STR (8 B): an STP retires as a single uop
// writing 16 bytes, so it halves the instruction count at identical store
// bandwidth. No `dc zva` — it needs the block size read from DCZID_EL0, requires
// 64-byte alignment, can be disabled by DCZID_EL0.DZP, and buys nothing at the
// 8-64 byte sizes that dominate the slab's hot path. There is no `rep stosq`
// analogue here, so unlike x64 there is no separate large-size arm: the bulk loop
// IS the large path.
function arm64EmitMemzeroOp(code ByteArray, dstSlot VarSlot, lenSlot VarSlot)
	arm64EmitLdrSlot(code, rt: ARM64_MEMZERO_DST, slotIndex: dstSlot)
	arm64EmitLdrSlot(code, rt: ARM64_MEMZERO_LEN, slotIndex: lenSlot)
	// x2 = dst + len (the end), computed before anything mutates x0/x1.
	arm64EmitAdd(code, rd: ARM64_MEMZERO_END, rn: ARM64_MEMZERO_DST, rm: ARM64_MEMZERO_LEN)

	arm64EmitCmpImm(code, rn: ARM64_MEMZERO_LEN, imm12: 8)
	let bLt8 = code.count()
	arm64EmitCondBranchOffset(code, cond: ARM64_COND_LO, imm19: 0)
	arm64EmitCmpImm(code, rn: ARM64_MEMZERO_LEN, imm12: 16)
	let bN8 = code.count()
	arm64EmitCondBranchOffset(code, cond: ARM64_COND_LO, imm19: 0)
	arm64EmitCmpImm(code, rn: ARM64_MEMZERO_LEN, imm12: 32)
	let bN16 = code.count()
	arm64EmitCondBranchOffset(code, cond: ARM64_COND_LO, imm19: 0)
	arm64EmitCmpImm(code, rn: ARM64_MEMZERO_LEN, imm12: ARM64_MEMZERO_LOOP_STRIDE)
	let bN32 = code.count()
	arm64EmitCondBranchOffset(code, cond: ARM64_COND_LO, imm19: 0)

	// --- >= 64: four zero-pairs (64 B) per iteration, then one overlapping 64 B block ---
	let loopTop = code.count()
	arm64EmitStpZeroRun(code, baseReg: ARM64_MEMZERO_DST, startOffset: 0, count: 4)
	arm64EmitAddImm(code, rd: ARM64_MEMZERO_DST, rn: ARM64_MEMZERO_DST, imm12: ARM64_MEMZERO_LOOP_STRIDE)
	arm64EmitSubImm(code, rd: ARM64_MEMZERO_LEN, rn: ARM64_MEMZERO_LEN, imm12: ARM64_MEMZERO_LOOP_STRIDE)
	arm64EmitCmpImm(code, rn: ARM64_MEMZERO_LEN, imm12: ARM64_MEMZERO_LOOP_STRIDE)
	arm64EmitCondBranchOffset(code, cond: ARM64_COND_HS, imm19: (loopTop - code.count()) / 4)
	// len >= 64 on entry, so [end-64, end) is always inside the region. No remainder
	// test — re-zeroing is cheaper than branching.
	arm64EmitStpZeroRun(code, baseReg: ARM64_MEMZERO_END, startOffset: -ARM64_MEMZERO_LOOP_STRIDE, count: 4)
	let bDoneFromLoop = code.count()
	arm64EmitBranchOffset(code, imm26: 0)

	// --- 32..63 ---
	arm64PatchCondBranchToHere(code, site: bN32, cond: ARM64_COND_LO)
	arm64EmitStpZeroRun(code, baseReg: ARM64_MEMZERO_DST, startOffset: 0, count: 2)
	arm64EmitStpZeroRun(code, baseReg: ARM64_MEMZERO_END, startOffset: -32, count: 2)
	let bDoneFromN32 = code.count()
	arm64EmitBranchOffset(code, imm26: 0)

	// --- 16..31 ---
	arm64PatchCondBranchToHere(code, site: bN16, cond: ARM64_COND_LO)
	arm64EmitStpZeroPair(code, baseReg: ARM64_MEMZERO_DST, offset: 0)
	arm64EmitStpZeroPair(code, baseReg: ARM64_MEMZERO_END, offset: -16)
	let bDoneFromN16 = code.count()
	arm64EmitBranchOffset(code, imm26: 0)

	// --- 8..15: one qword from each end (STUR for the negative displacement) ---
	arm64PatchCondBranchToHere(code, site: bN8, cond: ARM64_COND_LO)
	arm64EmitStrRegOffset(code, rt: ARM64_XZR, baseReg: ARM64_MEMZERO_DST, offset: 0)
	arm64EmitStur(code, rt: ARM64_XZR, baseReg: ARM64_MEMZERO_END, offset: -8)
	let bDoneFromN8 = code.count()
	arm64EmitBranchOffset(code, imm26: 0)

	// --- 0..7: byte loop. No whole qword to anchor the overlap on; vanishingly rare. ---
	arm64PatchCondBranchToHere(code, site: bLt8, cond: ARM64_COND_LO)
	let cbzDone = code.count()
	arm64EmitCbz(code, rn: ARM64_MEMZERO_LEN, imm19: 0)
	let byteLoopTop = code.count()
	arm64EmitStrb(code, rt: ARM64_XZR, rn: ARM64_MEMZERO_DST, offset: 0)
	arm64EmitAddImm(code, rd: ARM64_MEMZERO_DST, rn: ARM64_MEMZERO_DST, imm12: 1)
	arm64EmitSubImm(code, rd: ARM64_MEMZERO_LEN, rn: ARM64_MEMZERO_LEN, imm12: 1)
	arm64EmitCbnz(code, rn: ARM64_MEMZERO_LEN, imm19: (byteLoopTop - code.count()) / 4)

	// --- done ---
	let doneOffset = code.count()
	patchDword(code, offset: cbzDone, value: 0xB4000000 or ((((doneOffset - cbzDone) / 4) and 0x7FFFF) shl 5) or ARM64_MEMZERO_LEN)
	arm64PatchBranchToHere(code, site: bDoneFromLoop)
	arm64PatchBranchToHere(code, site: bDoneFromN32)
	arm64PatchBranchToHere(code, site: bDoneFromN16)
	arm64PatchBranchToHere(code, site: bDoneFromN8)
end 'arm64EmitMemzeroOp'

// --- cset / csel / sxtw / nullSafeLoad ---

// CSET Xd, cond => CSINC Xd, XZR, XZR, invert(cond)
// Encoding: 1001 1010 1001 1111 cccc 0111 111n nnnn
//         = 0x9A9F07E0 | (invCond << 12) | Rd
// Invert the condition by XORing the low bit (eq<->ne, hi<->ls, ge<->lt, gt<->le).
function arm64EmitCset(code ByteArray, rd MachineWord, cond MachineWord)
	let invCond = cond xor 1
	let insn = 0x9A9F07E0 or ((invCond and 0xF) shl 12) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCset'

// CSEL Xd, Xn, Xm, cond
// Encoding: 1001 1010 100m mmmm cccc 00nn nnnd dddd
//         = 0x9A800000 | (Rm << 16) | (cond << 12) | (Rn << 5) | Rd
export function arm64EmitCsel(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, cond MachineWord)
	let insn = 0x9A800000 or (rm shl 16) or ((cond and 0xF) shl 12) or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitCsel'

// SXTW Xd, Wn => SBFM Xd, Xn, #0, #31
// Encoding: 1001 0011 0100 0000 0111 11nn nnnd dddd = 0x93407C00 | (Rn << 5) | Rd
function arm64EmitSxtw(code ByteArray, rd MachineWord, rn MachineWord)
	let insn = 0x93407C00 or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitSxtw'

// --- FP arithmetic (double-precision) ---

// FADD Dd, Dn, Dm  => 0x1E602800 | (Rm << 16) | (Rn << 5) | Rd
// FSUB Dd, Dn, Dm  => 0x1E603800
// FMUL Dd, Dn, Dm  => 0x1E600800
// FDIV Dd, Dn, Dm  => 0x1E601800
// Single-precision variants replace 0x1E60 with 0x1E20 in the top 16 bits.
function arm64FpBinOpcode(base MachineWord, precision FloatPrecision) returns MachineWord
	return match precision 'selectPrec'
		f64 gives 0x1E600000 or base
		f32 gives 0x1E200000 or base
	end 'selectPrec'
end 'arm64FpBinOpcode'

function arm64EmitFpBin(code ByteArray, opcodeLow MachineWord, rd MachineWord, rn MachineWord, rm MachineWord, precision FloatPrecision)
	let opcode = arm64FpBinOpcode(opcodeLow, precision: precision)
	let insn = opcode or (rm shl 16) or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpBin'

function arm64EmitFadd(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, precision FloatPrecision)
	arm64EmitFpBin(code, opcodeLow: 0x2800, rd: rd, rn: rn, rm: rm, precision: precision)
end 'arm64EmitFadd'

function arm64EmitFsub(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, precision FloatPrecision)
	arm64EmitFpBin(code, opcodeLow: 0x3800, rd: rd, rn: rn, rm: rm, precision: precision)
end 'arm64EmitFsub'

function arm64EmitFmul(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, precision FloatPrecision)
	arm64EmitFpBin(code, opcodeLow: 0x0800, rd: rd, rn: rn, rm: rm, precision: precision)
end 'arm64EmitFmul'

function arm64EmitFdiv(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, precision FloatPrecision)
	arm64EmitFpBin(code, opcodeLow: 0x1800, rd: rd, rn: rn, rm: rm, precision: precision)
end 'arm64EmitFdiv'

// FMAX Dd, Dn, Dm => 0x1E604800 | (Rm << 16) | (Rn << 5) | Rd
function arm64EmitFmax(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, precision FloatPrecision)
	arm64EmitFpBin(code, opcodeLow: 0x4800, rd: rd, rn: rn, rm: rm, precision: precision)
end 'arm64EmitFmax'

// FMIN Dd, Dn, Dm => 0x1E605800 | (Rm << 16) | (Rn << 5) | Rd
function arm64EmitFmin(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, precision FloatPrecision)
	arm64EmitFpBin(code, opcodeLow: 0x5800, rd: rd, rn: rn, rm: rm, precision: precision)
end 'arm64EmitFmin'

// FCMP Dn, Dm
// Encoding (double): 0x1E602000 | (Rm << 16) | (Rn << 5)
// Single-precision: 0x1E202000
function arm64EmitFcmp(code ByteArray, rn MachineWord, rm MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives 0x1E602000
		f32 gives 0x1E202000
	end 'selectPrec'
	let insn = opcode or (rm shl 16) or (rn shl 5)
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFcmp'

// --- FP / integer conversion ---

// FCVTZS Xd, Dn (double -> i64, truncate toward zero)
// Encoding: 0x9E780000 | (Rn << 5) | Rd
// FCVTZS Xd, Sn (single -> i64): 0x9E380000
function arm64EmitFcvtzs(code ByteArray, rd MachineWord, rn MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives 0x9E780000
		f32 gives 0x9E380000
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFcvtzs'

// SCVTF Dd, Xn (i64 -> double)
// Encoding: 0x9E620000 | (Rn << 5) | Rd
// SCVTF Sd, Xn (i64 -> single): 0x9E220000
function arm64EmitScvtf(code ByteArray, rd MachineWord, rn MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives 0x9E620000
		f32 gives 0x9E220000
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitScvtf'

// FMOV Dd, Xn (move 64 bits from GPR to FP register)
// Encoding: 0x9E670000 | (Rn << 5) | Rd
// Single-precision (Sd, Wn): 0x1E270000
function arm64EmitFmovGprToFp(code ByteArray, rd MachineWord, rn MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives 0x9E670000
		f32 gives 0x1E270000
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFmovGprToFp'

// FMOV Xd, Dn (move 64 bits from FP register to GPR)
// Encoding: 0x9E660000 | (Rn << 5) | Rd
// Single-precision (Wd, Sn): 0x1E260000
function arm64EmitFmovFpToGpr(code ByteArray, rd MachineWord, rn MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives 0x9E660000
		f32 gives 0x1E260000
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFmovFpToGpr'

// --- FP unary ops ---

// FSQRT Dd, Dn: 0x1E61C000 | (Rn << 5) | Rd     (single: 0x1E21C000)
function arm64EmitFsqrt(code ByteArray, rd MachineWord, rn MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives 0x1E61C000
		f32 gives 0x1E21C000
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFsqrt'

// FABS Dd, Dn: 0x1E60C000 | (Rn << 5) | Rd    (single: 0x1E20C000)
function arm64EmitFabs(code ByteArray, rd MachineWord, rn MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives 0x1E60C000
		f32 gives 0x1E20C000
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFabs'

// FNEG Dd, Dn: 0x1E614000 | (Rn << 5) | Rd    (single: 0x1E214000)
function arm64EmitFneg(code ByteArray, rd MachineWord, rn MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives 0x1E614000
		f32 gives 0x1E214000
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFneg'

// FRINTM Dd, Dn (floor): 0x1E654000      single: 0x1E254000
// FRINTP Dd, Dn (ceil):  0x1E64C000      single: 0x1E24C000
// FRINTZ Dd, Dn (trunc): 0x1E65C000      single: 0x1E25C000
// FRINTN Dd, Dn (round to nearest-even): 0x1E644000    single: 0x1E244000
function arm64EmitFrint(code ByteArray, opcodeDouble MachineWord, opcodeSingle MachineWord, rd MachineWord, rn MachineWord, precision FloatPrecision)
	let opcode = match precision 'selectPrec'
		f64 gives opcodeDouble
		f32 gives opcodeSingle
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFrint'

// FCVT between precisions: Dd <- Sn (single to double) or Sd <- Dn (double to single)
// FCVT Dd, Sn: 0x1E22C000 | (Rn << 5) | Rd
// FCVT Sd, Dn: 0x1E624000 | (Rn << 5) | Rd
function arm64EmitFcvt(code ByteArray, rd MachineWord, rn MachineWord, destPrecision FloatPrecision)
	let opcode = match destPrecision 'selectPrec'
		f64 gives 0x1E22C000
		f32 gives 0x1E624000
	end 'selectPrec'
	let insn = opcode or (rn shl 5) or rd
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFcvt'

// --- Indirect memory ops ---

// Indirect store. STR / STRH / STRB select the dedicated width op; the
// imm12 immediate is scaled by the transfer size in every form. The byte
// arm shares its encoding with `arm64EmitStrb` (the legacy storeByte
// syscall path), so we route through that helper directly.
function arm64EmitStoreIndirectOp(code ByteArray, baseReg Arm64VReg, offset MachineWord, srcReg Arm64VReg, width StoreWidth)
	let rn = resolveArm64Gpr(baseReg).rawValue
	let rt = resolveArm64Gpr(srcReg).rawValue
	match width 'w'
		qword then arm64EmitStrQword(code, rt: rt, rn: rn, offset: offset)
		word then arm64EmitStrWord(code, rt: rt, rn: rn, offset: offset)
		halfword then arm64EmitStrHalfword(code, rt: rt, rn: rn, offset: offset)
		byte then arm64EmitStrb(code, rt: rt, rn: rn, offset: offset)
	end 'w'
end 'arm64EmitStoreIndirectOp'

function arm64EmitStrQword(code ByteArray, rt MachineWord, rn MachineWord, offset MachineWord)
	let insn = 0xF9000000 or (((offset / 8) and 0xFFF) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStrQword'

export function arm64EmitStrWord(code ByteArray, rt MachineWord, rn MachineWord, offset MachineWord)
	let insn = 0xB9000000 or (((offset / 4) and 0xFFF) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStrWord'

// STRH Wt, [Xn, #imm12] — imm12 scaled by 2 (offset must be 2-byte aligned).
function arm64EmitStrHalfword(code ByteArray, rt MachineWord, rn MachineWord, offset MachineWord)
	let insn = 0x79000000 or (((offset / 2) and 0xFFF) shl 10) or (rn shl 5) or rt
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitStrHalfword'

// STR Dt, [Xn, #imm12] for 64-bit FP store; STR St for 32-bit.
function arm64EmitFpStoreIndirectOp(code ByteArray, baseReg Arm64VReg, offset MachineWord, src Arm64FpVReg, precision FloatPrecision)
	let rn = resolveArm64Gpr(baseReg).rawValue
	let rt = resolveArm64Fp(src).rawValue
	let insn = match precision 'selectPrec'
		f64 gives 0xFD000000 or (((offset / 8) and 0xFFF) shl 10) or (rn shl 5) or rt
		f32 gives 0xBD000000 or (((offset / 4) and 0xFFF) shl 10) or (rn shl 5) or rt
	end 'selectPrec'
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpStoreIndirectOp'

// LDR Dt, [Xn, #imm12] for 64-bit FP load; LDR St for 32-bit.
function arm64EmitFpLoadIndirectOp(code ByteArray, dest Arm64FpVReg, baseReg Arm64VReg, offset MachineWord, precision FloatPrecision)
	let rn = resolveArm64Gpr(baseReg).rawValue
	let rt = resolveArm64Fp(dest).rawValue
	let insn = match precision 'selectPrec'
		f64 gives 0xFD400000 or (((offset / 8) and 0xFFF) shl 10) or (rn shl 5) or rt
		f32 gives 0xBD400000 or (((offset / 4) and 0xFFF) shl 10) or (rn shl 5) or rt
	end 'selectPrec'
	arm64EmitInsn(code, insn: insn)
end 'arm64EmitFpLoadIndirectOp'

// nullSafeLoad: branch over LDR if base == 0, otherwise load.
// Emits: CBZ Xbase, +8 ; LDR Xdest, [Xbase, #offset] ; (fall-through leaves Xdest untouched)
// The skipped path leaves dest unchanged. Callers that need a defined value on
// null should zero dest first.
function arm64EmitNullSafeLoadOp(code ByteArray, dest Arm64VReg, baseReg Arm64VReg, offset MachineWord)
	let rd = resolveArm64Gpr(dest).rawValue
	let rn = resolveArm64Gpr(baseReg).rawValue
	// CBZ Xn, #8 (skip next instruction if base is null)
	arm64EmitCbz(code, rn: rn, imm19: 2)
	// LDR Xd, [Xn, #offset]
	arm64EmitLdrImm(code, rt: rd, rn: rn, imm12: offset)
end 'arm64EmitNullSafeLoadOp'

// --- Atomic ops (LL/SC sequences) ---
//
// Each atomic op expands inline to a full ARMv8.0 LDAXR/STLXR retry loop.
// Scratch registers x16/x17 (and x18 for atomicXaddMem) live outside the
// regalloc pool, so they cannot collide with any virtual register the
// allocator has assigned. The backward branch in CBNZ uses a hardcoded
// negative offset measured in instructions — no label resolution required.

// atomicIncMem(addrReg):
//   .loop:
//     LDAXR x16, [Xaddr]            ; load-acquire exclusive
//     ADD   x16, x16, #1
//     STLXR w17, x16, [Xaddr]       ; store-release exclusive (w17 = status)
//     CBNZ  w17, .loop              ; retry on contention
function arm64EmitAtomicIncMem(code ByteArray, addrReg Arm64VReg)
	let rn = resolveArm64Gpr(addrReg).rawValue
	arm64EmitLdaxr(code, rt: 16, rn: rn)
	arm64EmitAddImm(code, rd: 16, rn: 16, imm12: 1)
	arm64EmitStlxr(code, rs: 17, rt: 16, rn: rn)
	// CBNZ W17, -3 instructions (back to LDAXR). imm19 is sign-extended; -3 in
	// 19-bit two's complement = 0x7FFFD.
	arm64EmitCbnzW(code, rn: 17, imm19: 0x7FFFD)
end 'arm64EmitAtomicIncMem'

// atomicDecMem(addrReg): mirrors inc with SUB instead of ADD. AArch64 has no
// flags-based "is the result zero?" idiom analogous to x86's LOCK DEC ZF; the
// MIR atomicDec op intentionally exposes no result, so callers that need to
// branch on zero must read the memory value separately.
function arm64EmitAtomicDecMem(code ByteArray, addrReg Arm64VReg)
	let rn = resolveArm64Gpr(addrReg).rawValue
	arm64EmitLdaxr(code, rt: 16, rn: rn)
	arm64EmitSubImm(code, rd: 16, rn: 16, imm12: 1)
	arm64EmitStlxr(code, rs: 17, rt: 16, rn: rn)
	arm64EmitCbnzW(code, rn: 17, imm19: 0x7FFFD)
end 'arm64EmitAtomicDecMem'

// atomicXaddMem(resultReg, addrReg, valReg):
//   LDR x16, [Xaddr]              ; x16 = prev
//   ADD x17, x16, Xval           ; x17 = new
//   STR x17, [Xaddr]             ; *addr = new
//   MOV Xresult, x16             ; result = prior value
//
// A non-atomic load-add-store (mirrors the C# bootstrap's `AtomicXadd`). The
// LL/SC form this replaced needed a THIRD scratch register beyond the x16/x17
// the inc/dec/cas emitters use, and reached for x18 — but x18 is the reserved
// platform register on arm64-macos (the Apple ABI forbids touching it), so
// clobbering it corrupted thread state and silently corrupted the heap (the
// slab allocator double-allocated slots). Refcount xadd runs under the
// cooperative green-thread model where this counter has a single writer at a
// time, so true atomicity is unnecessary here — same trade-off the bootstrap
// makes. Only x16/x17 (outside the regalloc pool) are scratched, so no
// implicit defs need tracking, matching inc/dec/cas.
function arm64EmitAtomicXaddMem(code ByteArray, resultReg Arm64VReg, addrReg Arm64VReg, valReg Arm64VReg)
	let rd = resolveArm64Gpr(resultReg).rawValue
	let rn = resolveArm64Gpr(addrReg).rawValue
	let rv = resolveArm64Gpr(valReg).rawValue
	arm64EmitLdrImm(code, rt: 16, rn: rn, imm12: 0)
	arm64EmitAdd(code, rd: 17, rn: 16, rm: rv)
	arm64EmitStrRegOffset(code, rt: 17, baseReg: rn, offset: 0)
	// MOV Xresult, X16 (ORR Xresult, XZR, X16) — result = prior value. Emitted
	// last, so rd aliasing rn/rv is harmless (both are dead by here).
	arm64EmitMovRegReg(code, rd: rd, rn: 16)
end 'arm64EmitAtomicXaddMem'

// atomicCasMem(resultReg, addrReg, oldReg, newReg):
//   .loop:                                  ; instr 0
//     LDAXR x16, [Xaddr]                     ; x16 = observed
//     CMP   x16, Xold                        ; instr 1 — EQ iff observed == old
//     B.NE  .exit                            ; instr 2 — mismatch: leave NE, bail
//     STLXR w17, Xnew, [Xaddr]               ; instr 3 — w17 = store status
//     CBNZ  w17, .loop                       ; instr 4 — retry on lost reservation
//   .exit:                                   ; instr 5
//     CSET  Xresult, EQ                      ; result = 1 iff last CMP was EQ
//
// STLXR and CBNZ leave the condition flags untouched, so at `.exit` the flags
// still reflect the final CMP: EQ on the success path (store landed), NE on the
// mismatch path. The B.NE forward offset is +3 instructions (instr 2 -> instr 5);
// the CBNZ backward offset is -4 instructions (instr 4 -> instr 0, encoded as the
// 19-bit two's complement 0x7FFFC). x16/x17 are LL/SC scratch outside the
// regalloc pool, matching the inc/dec/xadd emitters.
function arm64EmitAtomicCasMem(code ByteArray, resultReg Arm64VReg, addrReg Arm64VReg, oldReg Arm64VReg, newReg Arm64VReg)
	let rd = resolveArm64Gpr(resultReg).rawValue
	let rn = resolveArm64Gpr(addrReg).rawValue
	let ro = resolveArm64Gpr(oldReg).rawValue
	let rv = resolveArm64Gpr(newReg).rawValue
	arm64EmitLdaxr(code, rt: 16, rn: rn)
	arm64EmitCmp(code, rn: 16, rm: ro)
	// B.NE +3 instructions to the CSET (skips STLXR + CBNZ). cond ne = 1.
	arm64EmitCondBranchOffset(code, cond: 1, imm19: 3)
	arm64EmitStlxr(code, rs: 17, rt: rv, rn: rn)
	// CBNZ W17, -4 instructions back to LDAXR.
	arm64EmitCbnzW(code, rn: 17, imm19: 0x7FFFC)
	// CSET Xresult, EQ — 1 on the matched-and-stored path, 0 on mismatch. cond eq = 0.
	arm64EmitCset(code, rd: rd, cond: 0)
end 'arm64EmitAtomicCasMem'

// leaFromStack: ADD Xd, X29, #stackOffset (PC-neutral address materialization).
function arm64EmitLeaFromStackOp(code ByteArray, dest Arm64VReg, stackOffset MachineWord)
	let rd = resolveArm64Gpr(dest).rawValue
	// Wide ADD: a plain 12-bit immediate truncates `stackOffset` past 0xFFF,
	// producing a wrong slot address in large frames (see arm64EmitStackAddrOp).
	arm64EmitAddImmWide(code, rd: rd, rn: 29, imm: stackOffset)
end 'arm64EmitLeaFromStackOp'

// leaRdata: ADRP+ADD materialization of an rdata label address with ±4 GiB reach.
// The single-ADR form reached only ±1 MiB. ADRP page reloc on the ADRP, within-page
// reloc on the ADD; the writer patches both fields.
function arm64EmitLeaRdataOp(code ByteArray, dest Arm64VReg, rdataLabel String, rdataRelocs RdataRelocationArray)
	let rd = resolveArm64Gpr(dest).rawValue
	let (adrpKind, pageOffKind) = arm64AdrpPageOffKindsForLabel(rdataLabel)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: rdataLabel, kind: adrpKind))
	arm64EmitAdrp(code, rd: rd)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: rdataLabel, kind: pageOffKind))
	arm64EmitAddImm(code, rd: rd, rn: rd, imm12: 0)
end 'arm64EmitLeaRdataOp'

// globalLoad / globalStore for GPR values. Phase D1 wires these up so the
// Linux `osGetArgc` / `osGetArgv` lowerings can read `__mrt_argc` / `__mrt_argv`
// inline. Both emit an ADRP + LDR/STR pair: the ADRP+within-page-offset materialises
// the global's runtime address with ±4 GiB reach (the single-ADR form this replaced
// reached only ±1 MiB and could truncate at scale). The LDR/STR folds the within-page
// offset directly into its imm12 via the dataSectionArm64PageOff reloc (scaled by 8
// for an LDR/STR Xn), so no separate ADD is needed.
function arm64EmitGlobalLoadOp(code ByteArray, dest Arm64VReg, name String, size MachineWord, rdataRelocs RdataRelocationArray)
	if size != 8 'sizeOk'
		panic("arm64EmitGlobalLoadOp: only 8-byte global loads supported (name={name}, size={size})")
	end 'sizeOk'
	let rd = resolveArm64Gpr(dest).rawValue
	let (adrpKind, pageOffKind) = arm64AdrpPageOffKindsForLabel(name)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: name, kind: adrpKind))
	arm64EmitAdrp(code, rd: rd)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: name, kind: pageOffKind))
	arm64EmitLdrRegOffset(code, rt: rd, baseReg: rd, offset: 0)
end 'arm64EmitGlobalLoadOp'

function arm64EmitGlobalStoreOp(code ByteArray, name String, src Arm64VReg, size MachineWord, rdataRelocs RdataRelocationArray)
	if size != 8 'sizeOk'
		panic("arm64EmitGlobalStoreOp: only 8-byte global stores supported (name={name}, size={size})")
	end 'sizeOk'
	let rs = resolveArm64Gpr(src).rawValue
	// Use x16 (scratch IP0) as the address holder so the source register
	// stays intact for the store.
	let (adrpKind, pageOffKind) = arm64AdrpPageOffKindsForLabel(name)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: name, kind: adrpKind))
	arm64EmitAdrp(code, rd: 16)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: name, kind: pageOffKind))
	arm64EmitStrRegOffset(code, rt: rs, baseReg: 16, offset: 0)
end 'arm64EmitGlobalStoreOp'

// Route an rdata label to the correct ARM64 relocation kind. Mirrors the
// x64 `relocKindForLabel` logic — `__data_cov_` covdata first, then `__data_`,
// then the allocator/runtime mutable-global prefixes (`__slab_`, `__mm_`,
// `__mrt_`), with everything else falling through to read-only .rdata.
function arm64RelocKindForLabel(label String) returns RdataRelocKind
	// Section class is shared with the x64 backend via classifyGlobalLabel so the
	// writable-.data global set (incl. __sched_/__gt_/__at_/__subp_/__io_, which an
	// earlier hand-maintained list here omitted) stays consistent across targets.
	return match classifyGlobalLabel(label) 'cls'
		covData gives RdataRelocKind.covdataArm64Adr
		dataSection gives RdataRelocKind.dataSectionArm64Adr
		rdata gives RdataRelocKind.arm64Adr
	end 'cls'
end 'arm64RelocKindForLabel'

// The (ADRP-page, within-page) reloc-kind pair for a global label's output section.
// Twin of arm64RelocKindForLabel for the ±4 GiB ADRP+ADD/LDR/STR sequence: the page
// reloc patches the ADRP, the page-off reloc patches the following ADD/LDR/STR. Shares
// classifyGlobalLabel so the section choice stays identical to the single-ADR path.
function arm64AdrpPageOffKindsForLabel(label String) returns (RdataRelocKind, RdataRelocKind)
	return match classifyGlobalLabel(label) 'cls'
		covData gives (RdataRelocKind.covdataArm64Adrp, RdataRelocKind.covdataArm64PageOff)
		dataSection gives (RdataRelocKind.dataSectionArm64Adrp, RdataRelocKind.dataSectionArm64PageOff)
		rdata gives (RdataRelocKind.arm64Adrp, RdataRelocKind.arm64PageOff)
	end 'cls'
end 'arm64AdrpPageOffKindsForLabel'

function arm64EmitGlobalLoadFloatOp(code ByteArray, dest Arm64FpVReg, name String, precision FloatPrecision)
	let precisionName = match precision 'p'
		f64 gives "f64"
		f32 gives "f32"
	end 'p'
	panic("arm64EmitGlobalLoadFloatOp: global FP load emission not yet implemented (dest={dest}, name={name}, precision={precisionName}, codeLen={code.count()})")
end 'arm64EmitGlobalLoadFloatOp'

function arm64EmitGlobalStoreFloatOp(code ByteArray, name String, src Arm64FpVReg, precision FloatPrecision)
	let precisionName = match precision 'p'
		f64 gives "f64"
		f32 gives "f32"
	end 'p'
	panic("arm64EmitGlobalStoreFloatOp: global FP store emission not yet implemented (name={name}, src={src}, precision={precisionName}, codeLen={code.count()})")
end 'arm64EmitGlobalStoreFloatOp'

// Phase D2: stash kernel-supplied argc/argv from x0/x1 into the
// `__mrt_argc` / `__mrt_argv` globals. Only inserted by the prologue pass on
// Linux/macOS for `mrt_start` / `mrt_start_with_coverage`. Uses x16 (scratch
// IP0) to hold the global address — x0/x1 are preserved so subsequent ABI
// code still sees them if a future revision needs to.
function arm64EmitStashEntryArgvOp(code ByteArray, rdataRelocs RdataRelocationArray)
	// STR x0, [ADRP+ADD __mrt_argc] — ±4 GiB-reach store address (the single-ADR
	// form reached only ±1 MiB and could truncate at scale, like sys.globalAddr).
	arm64EmitStashOneEntryGlobal(code, rdataRelocs: rdataRelocs, name: "__mrt_argc", src: 0)
	// STR x1, [ADRP+ADD __mrt_argv].
	arm64EmitStashOneEntryGlobal(code, rdataRelocs: rdataRelocs, name: "__mrt_argv", src: 1)
end 'arm64EmitStashEntryArgvOp'

// ADRP x16, page(name) ; ADD x16, x16, #pageoff(name) ; STR Xsrc, [x16] — store `src`
// into an 8-byte global through an x16-based ±4 GiB-reach address.
function arm64EmitStashOneEntryGlobal(code ByteArray, rdataRelocs RdataRelocationArray, name String, src MachineWord)
	let (adrpKind, pageOffKind) = arm64AdrpPageOffKindsForLabel(name)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: name, kind: adrpKind))
	arm64EmitAdrp(code, rd: 16)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: name, kind: pageOffKind))
	arm64EmitAddImm(code, rd: 16, rn: 16, imm12: 0)
	arm64EmitStrRegOffset(code, rt: src, baseReg: 16, offset: 0)
end 'arm64EmitStashOneEntryGlobal'
