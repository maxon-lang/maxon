// SSA-chordal interference graph coloring.
// Exploits the property that SSA interference graphs are chordal,
// so greedy coloring on a dominance-tree preorder gives optimal results.

export typealias RegIntArrayArray = Array with RegIntArray

// ============================================================
// Types
// ============================================================

export type InterferenceGraph
	export var neighbors as RegIntArrayArray
	export var numRanges as RegInt

	export static function create(numRanges RegInt) returns InterferenceGraph
		var nbrs = RegIntArrayArray.create()
		var i = 0
		while i < numRanges 'init'
			nbrs.push(RegIntArray.create())
			i = i + 1
		end 'init'
		return Self{neighbors: nbrs, numRanges: numRanges}
	end 'create'

	// Wrap existing neighbor lists without copying — lets LiveSetSweep hand its
	// swept adjacency to consumers still typed on InterferenceGraph.
	export static function wrap(neighbors RegIntArrayArray, numRanges RegInt) returns InterferenceGraph
		return Self{neighbors: neighbors, numRanges: numRanges}
	end 'wrap'
end 'InterferenceGraph'

export type ColoringResult
	export var assignment as RegIntArray

	export static function create(maxValueId RegInt) returns ColoringResult
		var arr = RegIntArray.create()
		var i = 0
		while i < maxValueId 'init'
			arr.push(RM_NONE)
			i = i + 1
		end 'init'
		return Self{assignment: arr}
	end 'create'

	// Identity coloring: assignment[i] == i for i in 0..valueCount. Used by
	// backends that don't run register allocation (wasm), where each SSA
	// value lives in the like-numbered location (a wasm local), so resolving
	// a value to its "ordinal" is just the identity. `valueCount` should be
	// maxValueId+1 so every value id in use indexes in range.
	export static function identity(valueCount RegInt) returns ColoringResult
		var arr = RegIntArray.create()
		var i = 0
		while i < valueCount 'init'
			arr.push(i)
			i = i + 1
		end 'init'
		return Self{assignment: arr}
	end 'identity'
end 'ColoringResult'

// Diagnostic context for colorLookupGpr/Fp panics. Populated by applyColoring
// at the start of each function so that an uncolored-vreg panic can dump the
// failing range's full state (def block/pos, intervals) before aborting,
// without threading the LiveRangeArray through every per-op color helper.
// The dump is no-overhead in the success path — it only fires when a panic
// is already inevitable.
//
// Wrapped in a holder type so a single module-level var works (Maxon does not
// allow module-level vars to be initialized with String values directly).
type ColoringDiagContext
	export var funcName as String
	export var ranges as LiveRangeArray
	export var isSet as bool

	export static function create() returns ColoringDiagContext
		return Self{funcName: "", ranges: LiveRangeArray.create(), isSet: false}
	end 'create'
end 'ColoringDiagContext'

var diagContext = ColoringDiagContext.create()

export function setColoringDiagnosticContext(funcName String, ranges LiveRangeArray)
	diagContext.funcName = funcName
	diagContext.ranges = ranges
	diagContext.isSet = true
end 'setColoringDiagnosticContext'

function dumpFailingVreg(id ValueId, kind String)
	if not diagContext.isSet 'noContext'
		logError(LogCategory.ir, message: function() gives "{kind}: vreg v{id} dump skipped — diagnostic context not set")
		return
	end 'noContext'
	logError(LogCategory.ir, message: function() gives "{kind}: vreg v{id} in func={diagContext.funcName} (ranges.count={diagContext.ranges.count()})")
	var found = false
	for range in diagContext.ranges 'scan'
		if range.valueId == id 'match'
			found = true
			logError(LogCategory.ir, message: function() gives "  range: defBlock={range.defBlock} defPosition={range.defPosition} regClass={range.regClass.name} fixedReg={range.fixedReg} hint={range.hint} assignedReg={range.assignedReg} spillWeight={range.spillWeight} crossesCall={range.crossesCall}")
			logError(LogCategory.ir, message: function() gives "  intervals.count={range.intervals.count()}")
			for iv in range.intervals 'eachIv'
				logError(LogCategory.ir, message: function() gives "    interval blockId={iv.blockId} startPos={iv.startPos} endPos={iv.endPos}")
			end 'eachIv'
			logError(LogCategory.ir, message: function() gives "  copyEdges.count={range.copyEdges.count()}")
			for ce in range.copyEdges 'eachCe'
				logError(LogCategory.ir, message: function() gives "    copyEdge partner=v{ce.partnerValueId} blockId={ce.blockId} copyPos={ce.copyPos}")
			end 'eachCe'
		end 'match'
	end 'scan'
	if not found 'notFound'
		logError(LogCategory.ir, message: function() gives "  NO live range was built for v{id} — scanDefinitions never recorded a def for this vreg (likely a missing noteOpDefs arm or a spill/reload rewrite that drops the def)")
	end 'notFound'
end 'dumpFailingVreg'

// Look up the physical GPR ordinal assigned to a virtual value, panicking
// with a helpful message if the value was never colored. Used by every
// target's colorXxxGpr helper.
export function colorLookupGpr(id ValueId, coloring ColoringResult) returns RegOrdinal
	let result = getOr(coloring.assignment, index: id, fallback: RM_NONE)
	if result == RM_NONE 'uncolored'
		dumpFailingVreg(id, kind: "colorLookupGpr")
		panic("colorLookupGpr: virtual GPR v{id} has no coloring assignment (coloring.count={coloring.assignment.count()})")
	end 'uncolored'
	return result
end 'colorLookupGpr'

// Look up the physical FP ordinal assigned to a virtual value, panicking
// with a helpful message if the value was never colored. Used by every
// target's colorXxxFp helper.
export function colorLookupFp(id ValueId, coloring ColoringResult) returns RegOrdinal
	let result = getOr(coloring.assignment, index: id, fallback: RM_NONE)
	if result == RM_NONE 'uncolored'
		dumpFailingVreg(id, kind: "colorLookupFp")
		panic("colorLookupFp: virtual FP vf{id} has no coloring assignment (uncolored/spilled)")
	end 'uncolored'
	return result
end 'colorLookupFp'

// ============================================================
// Public entry point
// ============================================================

// Maximum cascade depth for the Greedy-style eviction picker. Once a range
// has been evicted MAX_CASCADE times, it can no longer be evicted (the
// eviction rule requires strictly-smaller evictee cascade). This bounds the
// number of evictions to `n * MAX_CASCADE` per coloring pass, guaranteeing
// termination. Matches LLVM Greedy's cascade limit.
let MAX_CASCADE = 8

// Maximum recursion depth for Phase 6's last-chance recoloring. When simple
// eviction (Phase 4) cannot find a register for an infinite-weight reload,
// the colorer tries to recursively re-color each interferer to a different
// register, freeing up a slot. Depth 3 matches LLVM Greedy's bound and keeps
// worst-case work proportional to `depth * fanout * pool_size`. Recursion
// terminates either by finding a placement (success), by exhausting all
// register candidates at every level (failure → spill loop / panic), or by
// hitting the depth cap.
let MAX_RECOLOR_DEPTH = 3

// Interference cap for one last-chance-recolor candidate register. If giving
// `range` a particular register would require displacing more than this many
// colored neighbors, that candidate is abandoned (the recursion would fan out
// combinatorially: each displaced neighbor recurses up to MAX_RECOLOR_DEPTH
// levels, so an uncapped attempt on a dense interference graph explores
// O(fanout^depth) nodes — the explosion that walls the self-compile on its
// densest test-runner functions, where a single call-site clique has 20-40
// simultaneously-live ranges). Mirrors LLVM Greedy's tryRecolorCandidates
// interference limit. Abandoning a candidate is always SAFE: the eviction
// fixup's spill backstop (runSpillColorLoop) still colors or spills every
// range, so the cap only trades a small amount of recolor quality for
// tractable compile time, never correctness (no colorLookupGpr panic).
let MAX_RECOLOR_INTERFERERS = 8

// Hard work budget for ALL last-chance recoloring in ONE coloring pass
// (one runEvictionFixup): the maximum total number of per-register placement
// attempts (tryRecolorAtReg invocations) summed across every range's recolor
// search. The interference cap bounds one node's breadth and MAX_RECOLOR_DEPTH
// bounds recursion, but neither bounds the COUNT of recolor entries — a dense
// function leaves many ranges uncolored, each starting a fresh search, so the
// aggregate still walls the self-compile. A single pass-wide budget caps the
// total exploration to O(budget) regardless of graph density or pending count.
// When exhausted every further attempt bails clean and the range falls through
// to the spill loop — so the budget trades recolor QUALITY for bounded compile
// time, never correctness (the spill backstop still colors or spills every
// range; no colorLookupGpr panic). The spill loop re-runs coloring with a fresh
// budget each iteration, so genuine recolors that legitimately need work still
// get it across iterations. 4096 is generous for the handful of nodes real
// recolors use (the spec suite never approaches it) yet tiny next to the
// millions an unbudgeted dense search visits.
let MAX_RECOLOR_NODES_PER_PASS = 4096

// Mutable per-top-level-recolor work counter. Threaded through the recursion so
// every tryRecolorAtReg attempt decrements one shared budget; once it reaches
// zero the whole search unwinds via clean bails. Created fresh at each
// runEvictionFixup last-chance-recolor entry point.
type RecolorBudget
	export var remaining as RegInt

	export static function create(budget RegInt) returns RecolorBudget
		return Self{remaining: budget}
	end 'create'

	// Consume one unit; returns true while budget remains, false once exhausted.
	export function tryConsume() returns bool
		if remaining <= 0 'exhausted'
			return false
		end 'exhausted'
		remaining = remaining - 1
		return true
	end 'tryConsume'
end 'RecolorBudget'

// The effective last-chance-recolor recursion depth for a coloring pass.
// In the cheap-coloring path (`cheapColoring` — set by the global `--fast`
// flag OR the per-function density gate; see FunctionRegAllocator.useCheapRegalloc)
// this is 0, which makes `tryLastChanceRecolor` return immediately (its
// `depth <= 0` early-out), so a range that simple eviction couldn't place just
// spills instead of triggering the recursive recolor search. That search
// explores up to `MAX_RECOLOR_DEPTH * fanout * poolSize` nodes per uncolored
// range — hundreds of thousands of nodes for a handful of successful recolors
// on pressured functions, and the memory blow-up that walls the self-compile —
// and is the single largest regalloc cost. Full-quality coloring keeps the full
// depth so its codegen is identical to today.
function effectiveRecolorDepth(cheapColoring bool) returns RegInt
	if cheapColoring 'cheap'
		return 0
	end 'cheap'
	return MAX_RECOLOR_DEPTH
end 'effectiveRecolorDepth'

export function colorSSA(ranges LiveRangeArray, domPreorder BlockIdArray, gprPool RegIntArray, callerSavedGprs RegIntArray, fpPool RegIntArray, callerSavedFps RegIntArray, cascadeByValueId RegIntArray, cheapColoring bool, sweepMode SweepMode, colorerMode ColorerMode) returns ColoringResult
	// Find max valueId for result sizing
	var maxValueId = 0
	for range in ranges 'findMax'
		if range.valueId >= maxValueId 'higher'
			maxValueId = range.valueId + 1
		end 'higher'
	end 'findMax'

	var result = ColoringResult.create(maxValueId)

	// Separate ranges by register class
	var gprRanges = LiveRangeArray.create()
	var fpRanges = LiveRangeArray.create()

	for range in ranges 'classify'
		match range.regClass 'rc'
			gpr then gprRanges.push(range)
			fp then fpRanges.push(range)
		end 'rc'
	end 'classify'

	// Color each class independently
	colorClass(gprRanges, pool: gprPool, callerSaved: callerSavedGprs, domPreorder: domPreorder, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring, sweepMode: sweepMode, colorerMode: colorerMode)
	colorClass(fpRanges, pool: fpPool, callerSaved: callerSavedFps, domPreorder: domPreorder, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring, sweepMode: sweepMode, colorerMode: colorerMode)

	logDebug(LogCategory.ir, message: function() gives "ssa-color: gpr={gprRanges.count()} fp={fpRanges.count()} maxVal={maxValueId}")
	return result
end 'colorSSA'

// ============================================================
// Per-class coloring
// ============================================================

// Build the per-range interference adjacency for one register class, choosing the
// construction path by SweepMode. `legacy` = buildInterferenceGraph (the
// pre-existing dedicated sweep). `sweep` = LiveSetSweep off a shared
// BlockIntervalEvents (byte-identical edge set, one fewer flatten+sweep).
// `validate` = build both, assert per-range neighbor-set equality, and return the
// LEGACY graph so validation can never change codegen even if the sweep has a bug.
function selectInterference(ranges LiveRangeArray, callerSavedByOrdinal BoolArray, sweepMode SweepMode) returns InterferenceGraph
	return match sweepMode 'mode'
		legacy gives buildInterferenceGraph(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
		sweep gives sweptInterference(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
		validate gives validatedInterference(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
	end 'mode'
end 'selectInterference'

// SweepMode.sweep: build interference via the unified LiveSetSweep.
function sweptInterference(ranges LiveRangeArray, callerSavedByOrdinal BoolArray) returns InterferenceGraph
	let s = LiveSetSweep.build(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
	return s.buildAdjacency(ranges).asInterferenceGraph()
end 'sweptInterference'

// SweepMode.validate: build BOTH, assert the edge sets match, return the legacy
// graph (so a latent sweep bug cannot change codegen while validation runs).
function validatedInterference(ranges LiveRangeArray, callerSavedByOrdinal BoolArray) returns InterferenceGraph
	let ig = buildInterferenceGraph(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
	let s = LiveSetSweep.build(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
	let swept = s.buildAdjacency(ranges)
	assertAdjacencyMatches(ig, swept: swept, ranges: ranges)
	return ig
end 'validatedInterference'

// Shared register picker: given a range and the interference-derived
// usedRegs / hintReservedRegs sets (plus the raw neighbor list for the
// fixed-neighbor hint check), decide which register this range should take.
// Both the first-fit pass in `colorClass` and `tryColorRange` (the eviction
// fixup's per-range recolor) call this, so the two paths provably agree on
// register selection. The picker only READS `range`.
//
// Order: hard fixed-reg constraint → copy-link hint resolution → soft hint
// eval (must be free, must not conflict with a fixed neighbor, must be class-
// safe for a call-crossing range) → tiered pool fallback. Returns RM_NONE when
// no register of the required class is available.
function pickRegisterForRange(range LiveRange, usedRegs BoolArray, hintReservedRegs BoolArray, nbrs RegIntArray, pool RegIntArray, callerSavedMask BoolArray, poolIndexOf RegIntArray, vidToRangeIdx RegIntArray, rangeColors RegIntArray, ranges LiveRangeArray) returns RegOrdinal
	var chosenReg = RM_NONE

	// Hard constraint: fixed register
	if range.fixedReg != RM_NONE 'hasFixed'
		chosenReg = range.fixedReg
	end 'hasFixed' else 'pickReg'

		// Soft constraint: register hint.
		// Check both already-colored neighbors AND uncolored fixed-reg
		// neighbors (which will inevitably get their fixed register).
		var effectiveHint = range.hint

		// Resolve copy-link hint: if no physical hint but a copy partner
		// has been colored, use the partner's color as the hint.
		// If the partner isn't colored yet, check its static hint (e.g.,
		// from the loop body's two-address coalescing) and use that.
		if effectiveHint == RM_NONE and range.copyHintValueId >= 0 'resolveCopyHint'
			effectiveHint = resolveCopyLinkHint(range.copyHintValueId, vidToRangeIdx: vidToRangeIdx, rangeColors: rangeColors, ranges: ranges)
		end 'resolveCopyHint'

		if effectiveHint != RM_NONE 'hasHint'
			let hintConflictsFixed = hintConflictsWithFixedNeighbor(effectiveHint, nbrs: nbrs, ranges: ranges, rangeColors: rangeColors)

			// Honor the hint only when its class is safe for this range.
			// A call-crossing range cannot live in a caller-saved hint;
			// the call would clobber it silently.
			let hintIsCallerSaved = regIsCallerSaved(effectiveHint, pool: pool, callerSavedMask: callerSavedMask)
			let hintClassSafe = range.crossesCall == false or not hintIsCallerSaved

			// Honor the hint only when it names a register in this class's
			// ALLOCATABLE pool. A `mov virt, phys` from a reserved register
			// seeds a hint to that register — `load_frame_ptr` lowers to
			// `mov virt, rbp` (x29 on arm64) — and honoring it colors the
			// virtual INTO the frame pointer: usedRegs cannot report a
			// non-pool register as busy (it is not tracked), so the hint
			// passes every other check, and a two-address op then mutates
			// rbp in place, corrupting the epilogue's `mov rsp, rbp` frame
			// teardown (observed as a return to a garbage address the first
			// time stdlib code read its own frame pointer).
			let hintInPool = poolIndexOfReg(effectiveHint, poolIndexOf: poolIndexOf) != RM_NONE

			if hintInPool and not isRegUsed(usedRegs, regOrd: effectiveHint, poolIndexOf: poolIndexOf) and not hintConflictsFixed and hintClassSafe 'hintAvail'
				chosenReg = effectiveHint
			end 'hintAvail'
		end 'hasHint'

		// Fallback: walk the pool, preferring caller-saved or callee-saved
		// based on whether the range survives across a call. The picker
		// also defers registers that an uncolored interfering neighbor
		// has explicitly hinted, falling back to them only when nothing
		// else of the right class is free.
		if chosenReg == RM_NONE 'needFallback'
			let preferCallerSaved = not range.crossesCall
			chosenReg = pickRegFromPool(pool, callerSavedMask: callerSavedMask, usedRegs: usedRegs, hintReservedRegs: hintReservedRegs, preferCallerSaved: preferCallerSaved)
		end 'needFallback'
	end 'pickReg'

	return chosenReg
end 'pickRegisterForRange'

// Color one register class, dispatching on ColorerMode (Track A step A3).
//   legacy   → colorClassLegacy: the materialized-graph first-fit + eviction.
//   sweep    → colorClassSweep: the dominance-order availability sweep.
//   validate → validateColorClass: run BOTH, assert spill parity, and keep the
//              LEGACY assignments (so validation can never change codegen even
//              if the sweep has a bug).
function colorClass(ranges LiveRangeArray, pool RegIntArray, callerSaved RegIntArray, domPreorder BlockIdArray, result ColoringResult, cascadeByValueId RegIntArray, cheapColoring bool, sweepMode SweepMode, colorerMode ColorerMode)
	match colorerMode 'mode'
		legacy then colorClassLegacy(ranges, pool: pool, callerSaved: callerSaved, domPreorder: domPreorder, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring, sweepMode: sweepMode)
		sweep then _ = colorClassSweep(ranges, pool: pool, callerSaved: callerSaved, domPreorder: domPreorder, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring, isValidateSweep: false)
		validate then validateColorClass(ranges, pool: pool, callerSaved: callerSaved, domPreorder: domPreorder, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring, sweepMode: sweepMode)
	end 'mode'
end 'colorClass'

function colorClassLegacy(ranges LiveRangeArray, pool RegIntArray, callerSaved RegIntArray, domPreorder BlockIdArray, result ColoringResult, cascadeByValueId RegIntArray, cheapColoring bool, sweepMode SweepMode)
	let numRanges = ranges.count()
	if numRanges == 0 'empty'
		return
	end 'empty'

	// Build range index -> valueId mapping and reverse (valueId -> range index)
	var rangeValueIds = RegIntArray.create()
	var vidToRangeIdx = RegIntArray.create()
	for range in ranges 'buildMap'
		let ri = rangeValueIds.count()
		rangeValueIds.push(range.valueId)
		let vid = range.valueId
		while vidToRangeIdx.count() <= vid 'grow'
			vidToRangeIdx.push(-1)
		end 'grow'
		try vidToRangeIdx.set(vid, value: ri) otherwise panic("invariant: vidToRangeIdx.set OOB")
	end 'buildMap'

	// Caller-saved lookup keyed by register ordinal, used by the interference
	// graph build to drop edges between a caller-saved fixed-reg pseudo-range
	// (a call-clobber / param / phys-dest range) and a call-crossing virtual.
	// Such an edge can never change a coloring decision — the picker forbids a
	// crossesCall virtual from taking ANY caller-saved register on every path
	// (hint, first-fit fallback, eviction-victim acceptance, last-chance
	// recolor) — so the edge is pure dead weight on the (very dense) graph.
	// See `buildCallerSavedByOrdinal` / `interferenceEdgeIsRedundant`.
	let callerSavedByOrdinal = buildCallerSavedByOrdinal(pool, callerSaved: callerSaved)

	// Step 1: Build interference graph. `legacy` uses buildInterferenceGraph;
	// `sweep` uses the unified LiveSetSweep (byte-identical edge set); `validate`
	// builds both, asserts the edge sets match, and returns the legacy graph.
	let tIg = passTimerStart()
	let ig = selectInterference(ranges, callerSavedByOrdinal: callerSavedByOrdinal, sweepMode: sweepMode)
	recordPassSince("__regalloc-interference", startMs: tIg)
	recordInterferenceStats(ig)

	// Step 2: Compute dominance-tree preorder index for sorting
	let domIndex = buildDomPreorderIndex(domPreorder)

	// Step 3: Sort ranges by dom-tree preorder of their def block
	let tSort = passTimerStart()
	let sortedOrder = sortByDomPreorder(ranges, domIndex: domIndex)
	recordPassSince("__regalloc-sortdom", startMs: tSort)

	// Step 4: Greedy coloring in dom-tree preorder
	let poolSize = pool.count()

	// Build reverse map: register ordinal -> pool index for O(1) lookup.
	// Used by markRegUsed/isRegUsed to avoid scanning the pool array.
	var poolIndexOf = RegIntArray.create()
	var pii = 0
	while pii < poolSize 'buildPoolIndex'
		let regOrd = try pool.get(pii) otherwise RM_NONE
		if regOrd != RM_NONE 'valid'
			while poolIndexOf.count() <= regOrd 'grow'
				poolIndexOf.push(RM_NONE)
			end 'grow'
			try poolIndexOf.set(regOrd, value: pii) otherwise panic("invariant: poolIndexOf.set OOB")
		end 'valid'
		pii = pii + 1
	end 'buildPoolIndex'

	// Build pool-index masks marking which pool slots are caller-saved.
	// This lets the fallback walk the pool in the natural order (which
	// preserves the existing scheduling-driven ordering — rax/rdx/rcx last
	// to avoid div/shift clobbers) but still bias the choice toward
	// caller-saved or callee-saved based on the range's crossesCall flag.
	let callerSavedMask = buildCallerSavedMask(pool, callerSaved: callerSaved)

	// Track which color (register) each range index has been assigned
	var rangeColors = RegIntArray.create()
	var ri = 0
	while ri < numRanges 'initColors'
		rangeColors.push(RM_NONE)
		ri = ri + 1
	end 'initColors'

	// First-fit pass in dominance-tree preorder. This pass is optimal under
	// SSA-chordal interference (no eviction needed when register pressure is
	// within bounds), and the dom-preorder ordering preserves the
	// scheduling-friendly hint propagation downstream tools rely on. Phase 4's
	// eviction logic runs as a SECOND pass below, touching only the ranges
	// this first pass left uncolored — so a successful first-fit produces
	// IDENTICAL coloring to the pre-Phase-4 allocator.
	let tFirstFit = passTimerStart()
	for sortedIdx in sortedOrder 'colorEach'
		let range = try ranges.get(sortedIdx) otherwise panic("invariant: sortedIdx from sortedOrder out of bounds in ranges")

		// Collect registers used by already-colored neighbors
		var usedRegs = BoolArray.create()
		growColorBoolArray(usedRegs, size: poolSize)
		// Track registers strongly preferred by uncolored interfering
		// neighbors (their range.hint). The fallback picker defers these
		// in its first pass so a "scratch" range doesn't burn a register
		// some interfering neighbor has a specific reason to want.
		var hintReservedRegs = BoolArray.create()
		growColorBoolArray(hintReservedRegs, size: poolSize)

		let nbrs = try ig.neighbors.get(sortedIdx) otherwise panic("invariant: sortedIdx out of bounds in ig.neighbors (sized to numRanges)")

		for nbrIdx in nbrs 'eachNbr'
			let nbrColor = getOr(rangeColors, index: nbrIdx, fallback: RM_NONE)
			if nbrColor != RM_NONE 'colored'
				// Find which pool index this register ordinal maps to
				markRegUsed(usedRegs, regOrd: nbrColor, poolIndexOf: poolIndexOf)
			end 'colored' else 'uncoloredNbr'
				let nbrRange = try ranges.get(nbrIdx) otherwise panic("invariant: nbrIdx from ig.neighbors out of bounds in ranges")
				// A fixed-reg neighbor will inevitably take its fixed register
				// when it's colored — that decision isn't optional. Treat
				// that reg as already taken even while the neighbor is
				// uncolored; otherwise a virtual that interferes with the
				// neighbor can grab the same color and the two ranges share
				// a register, with the downstream codegen silently
				// overwriting one. Hints are still soft (hintReservedRegs)
				// and fall through to the picker's tiered fallback.
				if nbrRange.fixedReg != RM_NONE 'hasFixed'
					markRegUsed(usedRegs, regOrd: nbrRange.fixedReg, poolIndexOf: poolIndexOf)
				end 'hasFixed' else 'noFixed'
					if nbrRange.hint != RM_NONE 'hasHint'
						markRegUsed(hintReservedRegs, regOrd: nbrRange.hint, poolIndexOf: poolIndexOf)
					end 'hasHint'
				end 'noFixed'
			end 'uncoloredNbr'
		end 'eachNbr'

		// Choose a register via the shared picker so this first-fit pass and
		// the eviction fixup's tryColorRange never disagree on register choice.
		let chosenReg = pickRegisterForRange(range, usedRegs: usedRegs, hintReservedRegs: hintReservedRegs, nbrs: nbrs, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, vidToRangeIdx: vidToRangeIdx, rangeColors: rangeColors, ranges: ranges)

		// Store the assignment
		try rangeColors.set(sortedIdx, value: chosenReg) otherwise panic("invariant: rangeColors.set OOB")

		if chosenReg != RM_NONE 'hasColor'
			let vid = range.valueId
			if vid < result.assignment.count() 'inBounds'
				try result.assignment.set(vid, value: chosenReg) otherwise panic("invariant: result.assignment.set OOB")
			end 'inBounds'
		end 'hasColor'
	end 'colorEach'
	recordPassSince("__regalloc-firstfit", startMs: tFirstFit)

	// Phase 4: Greedy-style eviction fixup. For every virtual range still
	// uncolored after the first-fit pass, try to evict a lower-priority
	// colored neighbor to make room. The eviction rule (strictly-smaller
	// evictee weight or smaller cascade at equal weight) plus the
	// MAX_CASCADE bound guarantees termination — see the LiveRange.cascade
	// comment for the proof sketch.
	let tEvict = passTimerStart()
	runEvictionFixup(ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring)
	recordPassSince("__regalloc-eviction", startMs: tEvict)
end 'colorClassLegacy'

// ============================================================
// A3: availability-sweep colorer
// ============================================================

// Incremental register-occupancy reservation set for the availability-sweep
// colorer. Instead of materializing the (very dense, mostly pseudo-range) full
// interference graph and walking a range's neighbor list, the sweep asks, per
// range R and per pool index pi, "does any occupant of pi have an interval that
// overlaps one of R's intervals?" Occupants are:
//   * HARD reserves — the fixed pseudo-ranges (clobber / param / phys-dest,
//     fixedReg != RM_NONE). Installed once before the sweep; never colored.
//   * OCCUPANCY — each virtual range as it is colored, appended under the pool
//     index of its chosen register.
//
// Storage is bucketed per block: `spans.get(blockId)` holds this block's
// occupant records as flat quadruples (startPos, endPos, rangeIdx, poolIndex),
// so a query for R scans only the blocks R lives in, and within each only that
// block's occupants (bounded by the block's register pressure, ~poolSize), not
// the whole occupancy set. rangeIdx is retained so the overlap test can apply
// isCopyBoundaryOverlap — a colored copy source must not block its copy dest at
// the single shared copy-boundary position (the two may share a register).
type SweepReservations
	export var spans as RegIntArrayArray
	export var numBlocks as RegInt

	export static function create(numBlocks RegInt) returns SweepReservations
		var spans = RegIntArrayArray.create()
		var i = 0
		while i < numBlocks 'init'
			spans.push(RegIntArray.create())
			i = i + 1
		end 'init'
		return Self{spans: spans, numBlocks: numBlocks}
	end 'create'

	// Append every interval of `rangeIdx` as an occupant at `poolIndex`. Called
	// for each hard reserve up front and for each virtual range as it is colored.
	// Intervals in blocks outside [0, numBlocks) are skipped (they cannot overlap
	// any swept range, whose blocks were used to size `numBlocks`).
	export function occupy(range LiveRange, rangeIdx RegInt, poolIndex RegInt)
		for iv in range.intervals 'eachIv'
			let bid = iv.blockId
			if bid < 0 or bid >= numBlocks 'outOfRange'
				continue
			end 'outOfRange'
			var bucket = try spans.get(bid) otherwise panic("SweepReservations.occupy: spans.get({bid}) OOB after numBlocks guard")
			bucket.push(iv.startPos)
			bucket.push(iv.endPos)
			bucket.push(rangeIdx)
			bucket.push(poolIndex)
		end 'eachIv'
	end 'occupy'
end 'SweepReservations'

// Number of RegInts per occupant record in a SweepReservations block bucket:
// (startPos, endPos, rangeIdx, poolIndex).
let SWEEP_OCC_STRIDE = 4

// Compute BOTH availability sets the legacy first-fit derives from the
// interference graph, but reading reservation spans directly rather than a
// neighbor list:
//
//   * usedRegs[pi] — HARD: pi is unavailable iff some HARD occupant (a colored
//     virtual at its color, or a fixed pseudo-range at its fixed register)
//     overlaps one of R's intervals. Mirrors legacy's "colored neighbor marks
//     its color used" + "uncolored fixed neighbor marks its fixedReg used".
//   * hintReservedRegs[pi] — SOFT: pi is hint-reserved iff some STILL-UNCOLORED
//     non-fixed range whose hint maps to pi overlaps R. Mirrors legacy's
//     "uncolored non-fixed neighbor with a hint marks hintReservedRegs". The
//     picker defers a hint-reserved register (Tier-2) so a scratch range does
//     not burn a register an interfering neighbor specifically wants — WITHOUT
//     this, the sweep's first-fit picks differ from legacy's and the divergence
//     cascades into genuine spills, breaking spill parity.
//
// Both scans apply the same two edge filters legacy applies at graph-build time
// (isCopyBoundaryOverlap, interferenceEdgeIsRedundant), so the swept sets equal
// the graph-derived ones. `hintReservations` holds one span per (range with a
// hint), keyed by poolIndex(hint); a span counts only while its range is still
// uncolored (rangeColors == RM_NONE) — exactly legacy's uncolored-neighbor gate.
function computeSweepAvailability(reservations SweepReservations, hintReservations SweepReservations, rangeIdx RegInt, range LiveRange, usedRegs BoolArray, hintReservedRegs BoolArray, ranges LiveRangeArray, rangeColors RegIntArray, callerSavedByOrdinal BoolArray)
	for iv in range.intervals 'eachIv'
		let bid = iv.blockId
		if bid < 0 or bid >= reservations.numBlocks 'outOfRange'
			continue
		end 'outOfRange'
		let s1 = iv.startPos
		let e1 = iv.endPos

		// HARD reserves → usedRegs.
		markOverlappingSpans(reservations, bid: bid, s1: s1, e1: e1, rangeIdx: rangeIdx, ranges: ranges, callerSavedByOrdinal: callerSavedByOrdinal, target: usedRegs, requireUncolored: false, rangeColors: rangeColors)

		// SOFT hint reserves → hintReservedRegs (only while the hinting range is
		// still uncolored, matching legacy's uncolored-neighbor gate).
		markOverlappingSpans(hintReservations, bid: bid, s1: s1, e1: e1, rangeIdx: rangeIdx, ranges: ranges, callerSavedByOrdinal: callerSavedByOrdinal, target: hintReservedRegs, requireUncolored: true, rangeColors: rangeColors)
	end 'eachIv'
end 'computeSweepAvailability'

// Scan one block's reservation bucket and mark `target[occPoolIndex]` for every
// occupant span that genuinely overlaps [s1, e1) (half-open), applying the same
// copy-boundary and redundant-edge suppression the legacy graph applies. When
// `requireUncolored` is set, an occupant is skipped unless its range is still
// uncolored (rangeColors == RM_NONE) — the gate the soft hint reservation needs.
// An occupant that is R itself is skipped (a range never reserves against
// itself). Shared by the HARD (usedRegs) and SOFT (hintReservedRegs) passes.
function markOverlappingSpans(reservations SweepReservations, bid BlockId, s1 RegInt, e1 RegInt, rangeIdx RegInt, ranges LiveRangeArray, callerSavedByOrdinal BoolArray, target BoolArray, requireUncolored bool, rangeColors RegIntArray)
	let bucket = try reservations.spans.get(bid) otherwise panic("markOverlappingSpans: spans.get({bid}) OOB after caller guard")
	let n = bucket.count()
	var k = 0
	while k < n 'eachOcc'
		let s2 = try bucket.get(k) otherwise panic("markOverlappingSpans: bucket.get start OOB")
		let e2 = try bucket.get(k + 1) otherwise panic("markOverlappingSpans: bucket.get end OOB")
		let occRangeIdx = try bucket.get(k + 2) otherwise panic("markOverlappingSpans: bucket.get rangeIdx OOB")
		let occPoolIndex = try bucket.get(k + 3) otherwise panic("markOverlappingSpans: bucket.get poolIndex OOB")
		k = k + SWEEP_OCC_STRIDE

		if occRangeIdx == rangeIdx 'self'
			continue
		end 'self'

		// Half-open overlap: s1 < e2 and s2 < e1.
		if s1 >= e2 or s2 >= e1 'noOverlap'
			continue
		end 'noOverlap'

		if requireUncolored 'gateUncolored'
			let occColor = getOr(rangeColors, index: occRangeIdx, fallback: RM_NONE)
			if occColor != RM_NONE 'alreadyColored'
				continue
			end 'alreadyColored'
		end 'gateUncolored'

		// A copy-connected occupant overlapping R by exactly one position at a
		// recorded copy boundary does NOT block R — the dest may share the source's
		// register (same suppression the legacy graph applies via
		// isCopyBoundaryOverlap when deciding whether to emit the edge).
		if isCopyBoundaryOverlap(s1, e1: e1, s2: s2, e2: e2, blockId: bid, ranges: ranges, ri1: rangeIdx, ri2: occRangeIdx) 'copyBoundary'
			continue
		end 'copyBoundary'

		// A redundant edge (caller-saved fixed range vs a call-crossing virtual)
		// is dropped by the legacy graph and must be dropped here too so the swept
		// set matches — otherwise a caller-saved clobber's hard reserve would mark
		// that pool index used against a crossesCall range the legacy first-fit
		// left free, diverging the pick.
		if interferenceEdgeIsRedundant(ranges, ri1: rangeIdx, ri2: occRangeIdx, callerSavedByOrdinal: callerSavedByOrdinal) 'redundant'
			continue
		end 'redundant'

		if occPoolIndex >= 0 and occPoolIndex < target.count() 'inPool'
			try target.set(occPoolIndex, value: true) otherwise panic("markOverlappingSpans: target.set OOB")
		end 'inPool'
	end 'eachOcc'
end 'markOverlappingSpans'

// Max blockId + 1 over every interval of every range, used to size the
// per-block occupancy buckets. Mirrors buildInterferenceGraph's numBlocks.
function sweepNumBlocks(ranges LiveRangeArray) returns RegInt
	var maxBlockId = 0
	for range in ranges 'findMax'
		for iv in range.intervals 'eachIv'
			if iv.blockId > maxBlockId 'higher'
				maxBlockId = iv.blockId
			end 'higher'
		end 'eachIv'
	end 'findMax'
	return maxBlockId + 1
end 'sweepNumBlocks'

// The availability-sweep colorer (Track A step A3). Visits ranges in the SAME
// dominance-tree preorder the legacy first-fit uses and picks each register with
// the SAME shared picker (pickRegisterForRange), but derives the used-register
// set from an incremental occupancy reservation set rather than a materialized
// interference graph. Fixed pseudo-ranges are installed as hard reserves up
// front (never colored); each virtual is queried, colored, and added to
// occupancy. The residual uncolored set is handed to the unchanged eviction
// fixup — in Step 2 that still consumes the full legacy-built graph; Step 4
// replaces it with an on-demand partial adjacency.
//
// Returns the per-range colors so the validate path can compare spill parity
// against the legacy colorer without re-reading `result`.
function colorClassSweep(ranges LiveRangeArray, pool RegIntArray, callerSaved RegIntArray, domPreorder BlockIdArray, result ColoringResult, cascadeByValueId RegIntArray, cheapColoring bool, isValidateSweep bool) returns RegIntArray
	let numRanges = ranges.count()
	if numRanges == 0 'empty'
		return RegIntArray.create()
	end 'empty'

	// Same valueId -> range-index map the legacy path builds — the shared picker
	// consumes it (resolveCopyLinkHint / hint resolution). The value stored is the
	// range's index in THIS class's `ranges` array, so a running counter is used
	// (not vidToRangeIdx.count(), which grows to vid+1 via the fill loop).
	var vidToRangeIdx = RegIntArray.create()
	var mapIdx = 0
	for range in ranges 'buildMap'
		let vid = range.valueId
		while vidToRangeIdx.count() <= vid 'grow'
			vidToRangeIdx.push(-1)
		end 'grow'
		try vidToRangeIdx.set(vid, value: mapIdx) otherwise panic("invariant: vidToRangeIdx.set OOB")
		mapIdx = mapIdx + 1
	end 'buildMap'

	let callerSavedByOrdinal = buildCallerSavedByOrdinal(pool, callerSaved: callerSaved)
	let domIndex = buildDomPreorderIndex(domPreorder)

	let tSort = passTimerStart()
	let sortedOrder = sortByDomPreorder(ranges, domIndex: domIndex)
	recordPassSince("__regalloc-sortdom", startMs: tSort)

	let poolSize = pool.count()
	var poolIndexOf = RegIntArray.create()
	var pii = 0
	while pii < poolSize 'buildPoolIndex'
		let regOrd = try pool.get(pii) otherwise RM_NONE
		if regOrd != RM_NONE 'valid'
			while poolIndexOf.count() <= regOrd 'grow'
				poolIndexOf.push(RM_NONE)
			end 'grow'
			try poolIndexOf.set(regOrd, value: pii) otherwise panic("invariant: poolIndexOf.set OOB")
		end 'valid'
		pii = pii + 1
	end 'buildPoolIndex'

	let callerSavedMask = buildCallerSavedMask(pool, callerSaved: callerSaved)

	var rangeColors = RegIntArray.create()
	var ri2 = 0
	while ri2 < numRanges 'initColors'
		rangeColors.push(RM_NONE)
		ri2 = ri2 + 1
	end 'initColors'

	// Install hard-reserve OCCUPANCY: every fixed pseudo-range's intervals occupy
	// the pool index of its fixed register, so a fixed range is visible as "used"
	// to every query from the start — matching legacy's uncolored-fixed-neighbor
	// gate (an uncolored fixed neighbor marks its fixedReg used even before it is
	// colored). Registers outside this class's pool map to RM_NONE and are skipped
	// (they cannot make a pool slot used).
	//
	// The fixed range's COLOR (rangeColors + result) is NOT written here: it is set
	// when the range is reached in the dom-preorder sweep below, exactly as the
	// legacy first-fit colors fixed ranges in order. Pre-coloring them would let a
	// copy-link hint resolve against a fixed partner EARLIER than legacy does
	// (legacy sees it uncolored → uses its static hint, not its color), shifting a
	// virtual's hint and diverging the pick.
	let numBlocks = sweepNumBlocks(ranges)
	var reservations = SweepReservations.create(numBlocks)
	var hi = 0
	while hi < numRanges 'installHard'
		let range = try ranges.get(hi) otherwise panic("colorClassSweep: ranges.get({hi}) OOB installing hard reserves")
		if range.fixedReg != RM_NONE 'isFixed'
			let pi = poolIndexOfReg(range.fixedReg, poolIndexOf: poolIndexOf)
			if pi != RM_NONE 'inPool'
				reservations.occupy(range, rangeIdx: hi, poolIndex: pi)
			end 'inPool'
		end 'isFixed'
		hi = hi + 1
	end 'installHard'

	// Install SOFT hint reserves: every range carrying a register hint contributes
	// a span under the pool index of that hint. Consulted (with an uncolored gate)
	// to reproduce legacy's hintReservedRegs so the sweep's first-fit picks track
	// legacy's. A hint outside this class's pool maps to RM_NONE and is skipped.
	var hintReservations = SweepReservations.create(numBlocks)
	var si2 = 0
	while si2 < numRanges 'installHints'
		let range = try ranges.get(si2) otherwise panic("colorClassSweep: ranges.get({si2}) OOB installing hint reserves")
		if range.fixedReg == RM_NONE and range.hint != RM_NONE 'hasHint'
			let pi = poolIndexOfReg(range.hint, poolIndexOf: poolIndexOf)
			if pi != RM_NONE 'inPool'
				hintReservations.occupy(range, rangeIdx: si2, poolIndex: pi)
			end 'inPool'
		end 'hasHint'
		si2 = si2 + 1
	end 'installHints'

	// Sweep in dom-preorder, coloring fixed ranges in place (mirroring legacy,
	// which colors fixed ranges to their fixedReg when reached in sortedOrder) and
	// picking a register for each virtual off the availability set. The fixed
	// range's occupancy is already installed, so it is NOT re-added here.
	//
	// Empty neighbor list to the picker: the sweep's usedRegs / hintReservedRegs
	// already encode every hard-reserve and hint conflict, so the picker's
	// nbrs-based fixed-neighbor hint check (hintConflictsWithFixedNeighbor) is
	// subsumed and needs no materialized graph.
	let emptyNbrs = RegIntArray.create()
	let tFirstFit = passTimerStart()
	for sortedIdx in sortedOrder 'colorEach'
		let range = try ranges.get(sortedIdx) otherwise panic("invariant: sortedIdx from sortedOrder out of bounds in ranges")

		if range.fixedReg != RM_NONE 'colorFixed'
			// Color the fixed pseudo-range to its fixed register, exactly as legacy
			// does at its sortedOrder position. Codegen resolves the pinned vreg via
			// colorLookupGpr/Fp, so its assignment MUST be present; and the eviction
			// fixup's pending collection excludes colored ranges. Occupancy is
			// already installed, so nothing is re-added.
			try rangeColors.set(sortedIdx, value: range.fixedReg) otherwise panic("invariant: rangeColors.set OOB for fixed range")
			let vidF = range.valueId
			if vidF < result.assignment.count() 'inBoundsF'
				try result.assignment.set(vidF, value: range.fixedReg) otherwise panic("invariant: result.assignment.set OOB for fixed range")
			end 'inBoundsF'
			continue
		end 'colorFixed'

		var usedRegs = BoolArray.create()
		growColorBoolArray(usedRegs, size: poolSize)
		var hintReservedRegs = BoolArray.create()
		growColorBoolArray(hintReservedRegs, size: poolSize)

		computeSweepAvailability(reservations, hintReservations: hintReservations, rangeIdx: sortedIdx, range: range, usedRegs: usedRegs, hintReservedRegs: hintReservedRegs, ranges: ranges, rangeColors: rangeColors, callerSavedByOrdinal: callerSavedByOrdinal)

		let chosenReg = pickRegisterForRange(range, usedRegs: usedRegs, hintReservedRegs: hintReservedRegs, nbrs: emptyNbrs, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, vidToRangeIdx: vidToRangeIdx, rangeColors: rangeColors, ranges: ranges)

		try rangeColors.set(sortedIdx, value: chosenReg) otherwise panic("invariant: rangeColors.set OOB")

		if chosenReg != RM_NONE 'hasColor'
			let vid = range.valueId
			if vid < result.assignment.count() 'inBounds'
				try result.assignment.set(vid, value: chosenReg) otherwise panic("invariant: result.assignment.set OOB")
			end 'inBounds'
			// Add to occupancy so later ranges see this register taken.
			let pi = poolIndexOfReg(chosenReg, poolIndexOf: poolIndexOf)
			if pi != RM_NONE 'colorInPool'
				reservations.occupy(range, rangeIdx: sortedIdx, poolIndex: pi)
			end 'colorInPool'
		end 'hasColor'
	end 'colorEach'
	recordPassSince("__regalloc-firstfit", startMs: tFirstFit)

	// Residual + eviction. Rather than materialize the full (dense, mostly
	// pseudo-range) interference graph, build a PARTIAL adjacency populated only
	// for the interference-connected component of the residual uncolored set — the
	// exact set of indices the eviction fixup can read. The vast majority of ranges
	// are colored by the sweep first-fit, never enter the fixup's worklist, and are
	// unreachable from it over interference edges, so their neighbor lists are
	// never materialized. Neighbors come from a shared BlockIntervalEvents (the
	// same event stream the pressure passes use), emitted by the same ordered block
	// sweep buildInterferenceGraph uses, so each component member's list equals the
	// full graph's — order included, which the eviction's first-in-list victim
	// tie-break depends on.
	let tIg = passTimerStart()
	let partial = buildResidualAdjacency(ranges, rangeColors: rangeColors, callerSavedByOrdinal: callerSavedByOrdinal)
	recordPassSince("__regalloc-interference", startMs: tIg)

	// Under validate, assert the partial adjacency matches the full graph for
	// every index the eviction fixup can read (the residual component) before it
	// is consumed, so a latent neighborsFromEvents bug is caught at the edge level.
	if isValidateSweep 'verifyPartial'
		assertPartialAdjacencyMatches(ranges, partial: partial, rangeColors: rangeColors, callerSavedByOrdinal: callerSavedByOrdinal)
	end 'verifyPartial'

	let tEvict = passTimerStart()
	runEvictionFixup(ranges, ig: partial, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring)
	recordPassSince("__regalloc-eviction", startMs: tEvict)

	return rangeColors
end 'colorClassSweep'

// Residual uncolored set for the partial-adjacency build: the virtual (non-fixed)
// ranges the sweep first-fit left uncolored. These are the only ranges the
// eviction fixup seeds its worklist from.
function collectResidual(ranges LiveRangeArray, rangeColors RegIntArray) returns RegIntArray
	var residual = RegIntArray.create()
	let n = ranges.count()
	var i = 0
	while i < n 'each'
		let range = try ranges.get(i) otherwise panic("collectResidual: ranges.get({i}) OOB")
		if range.fixedReg == RM_NONE 'virtual'
			let c = try rangeColors.get(i) otherwise panic("collectResidual: rangeColors.get({i}) OOB")
			if c == RM_NONE 'uncolored'
				residual.push(i)
			end 'uncolored'
		end 'virtual'
		i = i + 1
	end 'each'
	return residual
end 'collectResidual'

// Build an InterferenceGraph whose neighbor lists are populated ONLY for the
// interference-connected component of the residual uncolored set — the exact set
// of indices the eviction fixup can ever read.
//
// Why the whole component (not a fixed depth): the fixup seeds its worklist from
// the residual, then cascade-evicts. Each eviction victim is a NEIGHBOR of a
// range already in the worklist, and the evicted victim is re-queued and itself
// read (tryColorRange / pickEvictionVictim / last-chance recolor all read the
// popped range's neighbor list). So the read frontier advances one interference
// hop per eviction, with no a-priori depth bound (the cascade length is bounded
// by MAX_CASCADE and the strictly-cheaper-victim rule, not by recolor depth).
// The transitive closure over interference edges — the connected component — is
// therefore the tight, correct over-approximation of the read set. Ranges outside
// it have NO interference path from any residual range, so the fixup never reads
// their lists; their neighbor list stays empty and the dense pseudo-range
// adjacency is never materialized. Neighbors are computed on demand from a shared
// BlockIntervalEvents, applying the same filters buildInterferenceGraph applies,
// so each materialized list equals the full graph's for that index.
function buildResidualAdjacency(ranges LiveRangeArray, rangeColors RegIntArray, callerSavedByOrdinal BoolArray) returns InterferenceGraph
	let numRanges = ranges.count()
	var partial = InterferenceGraph.create(numRanges)

	let sweep = LiveSetSweep.build(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
	let events = sweep.events

	// `computed[i]` marks that index i's neighbor list has been materialized, so
	// each component member is expanded exactly once (the BFS terminates).
	var computed = BoolArray.create()
	var ci = 0
	while ci < numRanges 'initComputed'
		computed.push(false)
		ci = ci + 1
	end 'initComputed'

	// Pass 1: BFS the interference-connected component of the residual to decide
	// membership only (`computed[i]`), using neighborsFromEvents for adjacency. The
	// order of neighbors here does not matter — this pass only computes the set.
	var frontier = collectResidual(ranges, rangeColors: rangeColors)
	while frontier.count() > 0 'bfs'
		var next = RegIntArray.create()
		for idx in frontier 'expand'
			let already = try computed.get(idx) otherwise panic("buildResidualAdjacency: computed.get({idx}) OOB")
			if already 'skip'
				continue
			end 'skip'
			try computed.set(idx, value: true) otherwise panic("buildResidualAdjacency: computed.set OOB")

			let nbrs = neighborsFromEvents(events, ranges: ranges, rangeIdx: idx, callerSavedByOrdinal: callerSavedByOrdinal)
			for nb in nbrs 'eachNb'
				let nbComputed = try computed.get(nb) otherwise panic("buildResidualAdjacency: computed.get(nb={nb}) OOB")
				if not nbComputed 'enqueue'
					next.push(nb)
				end 'enqueue'
			end 'eachNb'
		end 'expand'
		frontier = next
	end 'bfs'

	// Pass 2: emit edges via the ORDERED block sweep (identical to
	// buildInterferenceGraph / buildAdjacencyFromEvents), keeping only edges with
	// at least one endpoint in the component. Emitting in sweep order makes each
	// component member's neighbor list byte-identical to the full graph's — order
	// included — so the eviction fixup (whose victim tie-break is first-in-list)
	// reaches the SAME decisions the legacy full-graph run would, not merely a
	// different-but-valid one.
	emitComponentEdges(partial, events: events, ranges: ranges, blockMaxPos: sweep.blockMaxPos, callerSavedByOrdinal: callerSavedByOrdinal, inComponent: computed)

	recordInterferenceStats(partial)
	return partial
end 'buildResidualAdjacency'

// Ordered edge emission for the partial adjacency: the SAME per-block start-order
// active-set sweep buildAdjacencyFromEvents runs, but an edge is added to
// `partial` only when at least one endpoint is a component member. Because the
// sweep visits blocks and starts in the same order as the full build, every
// retained edge lands in the same relative position in each endpoint's neighbor
// list — so a component member's list equals the full graph's exactly (order
// included). Non-member lists receive only the edges incident to a member (their
// lists are never read by the eviction fixup, so their incompleteness is inert).
function emitComponentEdges(partial InterferenceGraph, events BlockIntervalEvents, ranges LiveRangeArray, blockMaxPos RegIntArray, callerSavedByOrdinal BoolArray, inComponent BoolArray)
	let numBlocks = blockMaxPos.count()
	var active = RegIntArray.create()
	var blockId = 0
	while blockId < numBlocks 'eachBlock'
		let sliceStart = events.sliceStart(blockId)
		let sliceEnd = events.sliceEnd(blockId)
		let count = sliceEnd - sliceStart
		if count <= 0 'emptyBlock'
			blockId = blockId + 1
			continue
		end 'emptyBlock'

		var bs = RegIntArray.create()
		var k = 0
		while k < count 'collectStarts'
			bs.push(try events.startPos.get(sliceStart + k) otherwise panic("emitComponentEdges: startPos.get OOB collecting"))
			k = k + 1
		end 'collectStarts'
		let order = sortBlockIndicesByStart(bs)

		active.clear()
		var oi = 0
		while oi < count 'sweep'
			let localIdx = try order.get(oi) otherwise panic("emitComponentEdges: order.get({oi}) OOB")
			let flatIdx = sliceStart + localIdx
			let ri1 = try events.rangeIdx.get(flatIdx) otherwise panic("emitComponentEdges: rangeIdx.get OOB")
			let s1 = try events.startPos.get(flatIdx) otherwise panic("emitComponentEdges: s1 OOB")
			let e1 = try events.endPos.get(flatIdx) otherwise panic("emitComponentEdges: e1 OOB")

			var ai = 0
			while ai < active.count() 'retire'
				let aFlat = try active.get(ai) otherwise panic("emitComponentEdges: active.get({ai}) OOB")
				let aEnd = try events.endPos.get(aFlat) otherwise panic("emitComponentEdges: aEnd OOB")
				if aEnd <= s1 'expired'
					let lastPos = active.count() - 1
					if ai != lastPos 'notLast'
						let tail = try active.get(lastPos) otherwise panic("emitComponentEdges: active tail OOB")
						try active.set(ai, value: tail) otherwise panic("emitComponentEdges: active.set OOB")
					end 'notLast'
					try active.pop() otherwise panic("emitComponentEdges: active.pop on non-empty")
				end 'expired' else 'stillLive'
					ai = ai + 1
				end 'stillLive'
			end 'retire'

			var ei = 0
			while ei < active.count() 'emit'
				let aFlat = try active.get(ei) otherwise panic("emitComponentEdges: emit active.get({ei}) OOB")
				let ri2 = try events.rangeIdx.get(aFlat) otherwise panic("emitComponentEdges: ri2 OOB")
				let s2 = try events.startPos.get(aFlat) otherwise panic("emitComponentEdges: s2 OOB")
				let e2 = try events.endPos.get(aFlat) otherwise panic("emitComponentEdges: e2 OOB")

				let ri1InComp = try inComponent.get(ri1) otherwise panic("emitComponentEdges: inComponent.get(ri1) OOB")
				let ri2InComp = try inComponent.get(ri2) otherwise panic("emitComponentEdges: inComponent.get(ri2) OOB")
				if ri1InComp or ri2InComp 'keepEdge'
					let isCopyBoundary = isCopyBoundaryOverlap(s1, e1: e1, s2: s2, e2: e2, blockId: blockId, ranges: ranges, ri1: ri1, ri2: ri2)
					if not isCopyBoundary 'realOverlap'
						if not interferenceEdgeIsRedundant(ranges, ri1: ri1, ri2: ri2, callerSavedByOrdinal: callerSavedByOrdinal) 'notRedundant'
							addInterference(partial, a: ri1, b: ri2)
						end 'notRedundant'
					end 'realOverlap'
				end 'keepEdge'

				ei = ei + 1
			end 'emit'

			active.push(flatIdx)
			oi = oi + 1
		end 'sweep'

		blockId = blockId + 1
	end 'eachBlock'
end 'emitComponentEdges'

// Materialize the interference neighbors of a single range on demand from the
// shared BlockIntervalEvents, applying the SAME overlap test and filters
// buildInterferenceGraph / buildAdjacencyFromEvents apply — so the returned set
// equals that range's neighbor list in the full graph. For each of `rangeIdx`'s
// intervals, scan that block's event slice for any OTHER range whose event
// overlaps [startPos, endPos) (half-open), skipping copy-boundary-only overlaps
// and redundant (caller-saved-fixed vs call-crossing-virtual) edges. Results are
// deduped across intervals/blocks (a neighbor may overlap in several blocks).
function neighborsFromEvents(events BlockIntervalEvents, ranges LiveRangeArray, rangeIdx RegInt, callerSavedByOrdinal BoolArray) returns RegIntArray
	var result = RegIntArray.create()
	let range = try ranges.get(rangeIdx) otherwise panic("neighborsFromEvents: ranges.get({rangeIdx}) OOB")
	let numBlockSlots = events.base.count() - 1

	for iv in range.intervals 'eachIv'
		let bid = iv.blockId
		if bid < 0 or bid >= numBlockSlots 'outOfRange'
			continue
		end 'outOfRange'
		let s1 = iv.startPos
		let e1 = iv.endPos
		let lo = events.sliceStart(bid)
		let hi = events.sliceEnd(bid)
		var e = lo
		while e < hi 'eachEvent'
			let occRangeIdx = try events.rangeIdx.get(e) otherwise panic("neighborsFromEvents: rangeIdx.get({e}) OOB in slice")
			let s2 = try events.startPos.get(e) otherwise panic("neighborsFromEvents: startPos.get({e}) OOB in slice")
			let e2 = try events.endPos.get(e) otherwise panic("neighborsFromEvents: endPos.get({e}) OOB in slice")
			e = e + 1

			if occRangeIdx == rangeIdx 'self'
				continue
			end 'self'

			// Half-open overlap: s1 < e2 and s2 < e1.
			if s1 >= e2 or s2 >= e1 'noOverlap'
				continue
			end 'noOverlap'

			// Same two suppressions the full graph applies at edge-emit time.
			if isCopyBoundaryOverlap(s1, e1: e1, s2: s2, e2: e2, blockId: bid, ranges: ranges, ri1: rangeIdx, ri2: occRangeIdx) 'copyBoundary'
				continue
			end 'copyBoundary'
			if interferenceEdgeIsRedundant(ranges, ri1: rangeIdx, ri2: occRangeIdx, callerSavedByOrdinal: callerSavedByOrdinal) 'redundant'
				continue
			end 'redundant'

			if not regIntArrayContains(result, value: occRangeIdx) 'newNbr'
				result.push(occRangeIdx)
			end 'newNbr'
		end 'eachEvent'
	end 'eachIv'

	return result
end 'neighborsFromEvents'

// Validate-mode check: assert the PARTIAL adjacency's neighbor set equals the
// FULL graph's for every index in the residual's interference-connected component
// — the exact set of indices the eviction fixup can read (see
// buildResidualAdjacency). Any index OUTSIDE the component has an empty list in
// `partial` by design and is never read, so it is not compared. Builds the full
// graph once and compares neighbor SETS (order-independent), panicking on the
// first mismatch — so a latent neighborsFromEvents bug is caught at the edge
// level before the fixup consumes the partial graph.
function assertPartialAdjacencyMatches(ranges LiveRangeArray, partial InterferenceGraph, rangeColors RegIntArray, callerSavedByOrdinal BoolArray)
	let full = buildInterferenceGraph(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
	let numRanges = ranges.count()

	// Reconstruct the component membership the same way buildResidualAdjacency
	// does (unbounded BFS over interference edges from the residual seeds).
	let sweep = LiveSetSweep.build(ranges, callerSavedByOrdinal: callerSavedByOrdinal)
	let events = sweep.events
	var computed = BoolArray.create()
	var ci = 0
	while ci < numRanges 'initComputed'
		computed.push(false)
		ci = ci + 1
	end 'initComputed'
	var frontier = collectResidual(ranges, rangeColors: rangeColors)
	while frontier.count() > 0 'bfs'
		var next = RegIntArray.create()
		for idx in frontier 'expand'
			let already = try computed.get(idx) otherwise panic("assertPartialAdjacencyMatches: computed.get({idx}) OOB")
			if already 'skip'
				continue
			end 'skip'
			try computed.set(idx, value: true) otherwise panic("assertPartialAdjacencyMatches: computed.set OOB")
			let nbrs = neighborsFromEvents(events, ranges: ranges, rangeIdx: idx, callerSavedByOrdinal: callerSavedByOrdinal)
			for nb in nbrs 'eachNb'
				let nbComputed = try computed.get(nb) otherwise panic("assertPartialAdjacencyMatches: computed.get(nb) OOB")
				if not nbComputed 'enqueue'
					next.push(nb)
				end 'enqueue'
			end 'eachNb'
		end 'expand'
		frontier = next
	end 'bfs'

	// For every component member, the partial and full neighbor SETS must match.
	var i = 0
	while i < numRanges 'eachRange'
		let isComputed = try computed.get(i) otherwise panic("assertPartialAdjacencyMatches: computed.get({i}) OOB")
		if isComputed 'compare'
			let pa = try partial.neighbors.get(i) otherwise panic("assertPartialAdjacencyMatches: partial.neighbors.get({i}) OOB")
			let fa = try full.neighbors.get(i) otherwise panic("assertPartialAdjacencyMatches: full.neighbors.get({i}) OOB")
			if not sameRegIntSet(pa, b: fa) 'mismatch'
				let r = try ranges.get(i) otherwise panic("assertPartialAdjacencyMatches: ranges.get({i}) OOB")
				panic("A3 partial-adjacency mismatch at range {i} v{r.valueId} defBlock={r.defBlock} defPos={r.defPosition}: partialDeg={pa.count()} fullDeg={fa.count()}")
			end 'mismatch'
		end 'compare'
		i = i + 1
	end 'eachRange'
end 'assertPartialAdjacencyMatches'

// Order-independent set equality of two RegInt lists that are each already
// deduped (e.g. interference neighbor lists): equal iff same length and every
// element of `a` is in `b` — with equal lengths mutual containment follows. Also
// used by LiveSetSweep.assertAdjacencyMatches (hence export).
export function sameRegIntSet(a RegIntArray, b RegIntArray) returns bool
	if a.count() != b.count() 'lenDiff'
		return false
	end 'lenDiff'
	for x in a 'eachA'
		if not regIntArrayContains(b, value: x) 'missing'
			return false
		end 'missing'
	end 'eachA'
	return true
end 'sameRegIntSet'

// SweepMode-independent validate harness for the A3 colorer. Runs the LEGACY
// colorer into `result` (the assignments codegen consumes), then runs the SWEEP
// colorer into a THROWAWAY result, and asserts the two leave the SAME set of
// vregs uncolored (spill parity — the correctness gate). Colors that differ but
// are both valid are logged, not fatal (register choice is allowed to diverge;
// only the spill/no-spill decision must match). Because `result` carries the
// legacy assignments, validate mode never changes codegen.
function validateColorClass(ranges LiveRangeArray, pool RegIntArray, callerSaved RegIntArray, domPreorder BlockIdArray, result ColoringResult, cascadeByValueId RegIntArray, cheapColoring bool, sweepMode SweepMode)
	let numRanges = ranges.count()
	if numRanges == 0 'empty'
		return
	end 'empty'

	// The eviction fixup mutates per-range cascade state (LiveRange.cascade AND the
	// shared cascadeByValueId sidetable) via bumpEvicteeCascade. Both the legacy
	// and sweep runs invoke it, so the sweep must start from the SAME cascade state
	// the legacy run saw — otherwise the legacy run's cascade bumps carry into the
	// sweep's eviction and change WHICH ranges it can evict, manufacturing a
	// spurious spill-parity divergence that is an artifact of the harness, not the
	// colorer. Snapshot the cascade state before the legacy run and restore it
	// before the sweep run. (result is not shared: legacy writes the real `result`
	// that codegen consumes; the sweep writes a throwaway, so its assignments never
	// leak into codegen — validate mode is codegen-neutral.)
	var cascadeSnapshot = RegIntArray.create()
	var ci = 0
	while ci < numRanges 'snapRange'
		let r = try ranges.get(ci) otherwise panic("validateColorClass: ranges.get({ci}) OOB snapshotting cascade")
		cascadeSnapshot.push(r.cascade)
		ci = ci + 1
	end 'snapRange'
	var cascadeSideSnapshot = RegIntArray.create()
	var cj = 0
	while cj < cascadeByValueId.count() 'snapSide'
		cascadeSideSnapshot.push(try cascadeByValueId.get(cj) otherwise panic("validateColorClass: cascadeByValueId.get({cj}) OOB snapshotting"))
		cj = cj + 1
	end 'snapSide'

	let legacyColors = colorClassCapture(ranges, pool: pool, callerSaved: callerSaved, domPreorder: domPreorder, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring, sweepMode: sweepMode)

	// Capture the cascade state the LEGACY run leaves — this is the state codegen
	// (and the next spill iteration) must see, since the legacy result is the one
	// that ships. Restored after the throwaway sweep run below.
	var cascadePostLegacy = RegIntArray.create()
	var pk = 0
	while pk < numRanges 'snapPost'
		let r = try ranges.get(pk) otherwise panic("validateColorClass: ranges.get({pk}) OOB post-legacy snapshot")
		cascadePostLegacy.push(r.cascade)
		pk = pk + 1
	end 'snapPost'
	var cascadeSidePostLegacy = RegIntArray.create()
	var pj = 0
	while pj < cascadeByValueId.count() 'snapSidePost'
		cascadeSidePostLegacy.push(try cascadeByValueId.get(pj) otherwise panic("validateColorClass: cascadeByValueId.get({pj}) OOB post-legacy"))
		pj = pj + 1
	end 'snapSidePost'

	// Restore the PRE-legacy cascade state so the sweep run starts from the same
	// slate the legacy run started from.
	restoreCascadeState(ranges, cascadeByValueId: cascadeByValueId, rangeSnapshot: cascadeSnapshot, sideSnapshot: cascadeSideSnapshot, numRanges: numRanges)

	var throwaway = ColoringResult.create(result.assignment.count())
	let sweepColors = colorClassSweep(ranges, pool: pool, callerSaved: callerSaved, domPreorder: domPreorder, result: throwaway, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring, isValidateSweep: true)

	// Restore the post-legacy cascade state so validate mode is fully codegen-
	// neutral: the shipping (legacy) result and its cascade side-effects are what
	// the rest of the pipeline sees, exactly as an un-instrumented legacy run.
	restoreCascadeState(ranges, cascadeByValueId: cascadeByValueId, rangeSnapshot: cascadePostLegacy, sideSnapshot: cascadeSidePostLegacy, numRanges: numRanges)

	assertSpillParity(ranges, legacyColors: legacyColors, sweepColors: sweepColors)
end 'validateColorClass'

// Restore per-range LiveRange.cascade and the cascadeByValueId sidetable from a
// prior snapshot. Used by the validate harness to run the legacy and sweep
// colorers from identical cascade slates (the eviction fixup mutates both).
function restoreCascadeState(ranges LiveRangeArray, cascadeByValueId RegIntArray, rangeSnapshot RegIntArray, sideSnapshot RegIntArray, numRanges RegInt)
	var i = 0
	while i < numRanges 'restoreRange'
		var r = try ranges.get(i) otherwise panic("restoreCascadeState: ranges.get({i}) OOB")
		r.cascade = try rangeSnapshot.get(i) otherwise panic("restoreCascadeState: rangeSnapshot.get({i}) OOB")
		i = i + 1
	end 'restoreRange'
	var j = 0
	while j < sideSnapshot.count() 'restoreSide'
		try cascadeByValueId.set(j, value: try sideSnapshot.get(j) otherwise panic("restoreCascadeState: sideSnapshot.get({j}) OOB")) otherwise panic("restoreCascadeState: cascadeByValueId.set({j}) OOB")
		j = j + 1
	end 'restoreSide'
end 'restoreCascadeState'

// Run the legacy colorer, writing assignments into `result` AND returning the
// per-range color array (so validate can compare spill parity). Factored out of
// colorClassLegacy so the validate path gets the legacy `rangeColors` without a
// second coloring or a signature change on the legacy entry point.
function colorClassCapture(ranges LiveRangeArray, pool RegIntArray, callerSaved RegIntArray, domPreorder BlockIdArray, result ColoringResult, cascadeByValueId RegIntArray, cheapColoring bool, sweepMode SweepMode) returns RegIntArray
	colorClassLegacy(ranges, pool: pool, callerSaved: callerSaved, domPreorder: domPreorder, result: result, cascadeByValueId: cascadeByValueId, cheapColoring: cheapColoring, sweepMode: sweepMode)
	// Reconstruct the per-range color array from `result` (indexed by valueId)
	// so it is comparable to colorClassSweep's return (indexed by range index).
	var colors = RegIntArray.create()
	var i = 0
	while i < ranges.count() 'each'
		let range = try ranges.get(i) otherwise panic("colorClassCapture: ranges.get({i}) OOB")
		let c = getOr(result.assignment, index: range.valueId, fallback: RM_NONE)
		colors.push(c)
		i = i + 1
	end 'each'
	return colors
end 'colorClassCapture'

// Assert SPILL PARITY between the legacy and sweep colorers: for every range,
// both must be colored or both uncolored (a fixed range is colored in both by
// construction). A divergence where one colors and the other spills is a
// correctness break — panic naming the range. Different-but-valid colors are not
// checked here (register choice may legitimately differ). Panics on the first
// spill-parity break so a latent sweep bug is caught deterministically.
function assertSpillParity(ranges LiveRangeArray, legacyColors RegIntArray, sweepColors RegIntArray)
	let n = ranges.count()
	var colorDiffs = 0
	var i = 0
	while i < n 'each'
		let range = try ranges.get(i) otherwise panic("assertSpillParity: ranges.get({i}) OOB")
		let legacyC = getOr(legacyColors, index: i, fallback: RM_NONE)
		let sweepC = getOr(sweepColors, index: i, fallback: RM_NONE)
		let legacyColored = legacyC != RM_NONE
		let sweepColored = sweepC != RM_NONE
		if legacyColored != sweepColored 'spillParityBreak'
			panic("A3 spill-parity break at range {i} v{range.valueId} defBlock={range.defBlock} defPos={range.defPosition} fixedReg={range.fixedReg} crossesCall={range.crossesCall}: legacy={legacyC} sweep={sweepC} (one colored, one spilled)")
		end 'spillParityBreak'
		if legacyColored and legacyC != sweepC 'colorDiff'
			colorDiffs = colorDiffs + 1
		end 'colorDiff'
		i = i + 1
	end 'each'
	if colorDiffs > 0 'hadDiffs'
		logDebug(LogCategory.ir, message: function() gives "A3 validate: {colorDiffs} range(s) got a different (but valid) color under sweep vs legacy")
	end 'hadDiffs'
end 'assertSpillParity'

// Accumulate interference-graph edge count E (summed over every coloring
// invocation, so divide by __regalloc-colorings for a per-coloring average).
// neighbors is symmetric adjacency, so total endpoints / 2 = undirected edges.
// The O(numRanges) walk is only paid when timings are active.
function recordInterferenceStats(ig InterferenceGraph)
	if not passTimingsActive() 'inactive'
		return
	end 'inactive'
	var endpoints = 0
	for nbrs in ig.neighbors 'sumDegree'
		endpoints = endpoints + nbrs.count()
	end 'sumDegree'
	recordPassCounter("__regalloc-edges-sum", delta: endpoints / 2)
end 'recordInterferenceStats'

// Attempt to color a single range, writing the assignment to `rangeColors` and
// `result` if successful. Computes the used-register set from currently-colored
// neighbors plus fixed-reg neighbors (whose color is inevitable), then runs the
// hint → fallback picker pipeline. Pulled out of the main first-fit loop so the
// eviction fixup can reuse the exact same picker logic — guaranteeing the two
// passes never disagree on what counts as a valid color for a range.
function tryColorRange(sortedIdx RegInt, ranges LiveRangeArray, ig InterferenceGraph, rangeColors RegIntArray, vidToRangeIdx RegIntArray, pool RegIntArray, callerSavedMask BoolArray, poolIndexOf RegIntArray, poolSize RegInt, result ColoringResult) returns RegOrdinal
	let range = try ranges.get(sortedIdx) otherwise panic("invariant: sortedIdx out of bounds in ranges")

	// Collect registers used by already-colored neighbors
	var usedRegs = BoolArray.create()
	growColorBoolArray(usedRegs, size: poolSize)
	// Track registers strongly preferred by uncolored interfering
	// neighbors (their range.hint). The fallback picker defers these
	// in its first pass so a "scratch" range doesn't burn a register
	// some interfering neighbor has a specific reason to want.
	var hintReservedRegs = BoolArray.create()
	growColorBoolArray(hintReservedRegs, size: poolSize)

	let nbrs = try ig.neighbors.get(sortedIdx) otherwise panic("invariant: sortedIdx out of bounds in ig.neighbors (sized to numRanges)")

	for nbrIdx in nbrs 'eachNbr'
		let nbrColor = getOr(rangeColors, index: nbrIdx, fallback: RM_NONE)
		if nbrColor != RM_NONE 'colored'
			// Find which pool index this register ordinal maps to
			markRegUsed(usedRegs, regOrd: nbrColor, poolIndexOf: poolIndexOf)
		end 'colored' else 'uncoloredNbr'
			let nbrRange = try ranges.get(nbrIdx) otherwise panic("invariant: nbrIdx from ig.neighbors out of bounds in ranges")
			// A fixed-reg neighbor will inevitably take its fixed register
			// when it's colored — that decision isn't optional. Treat
			// that reg as already taken even while the neighbor is
			// uncolored; otherwise a virtual that interferes with the
			// neighbor can grab the same color and the two ranges share
			// a register, with the downstream codegen silently
			// overwriting one. Hints are still soft (hintReservedRegs)
			// and fall through to the picker's tiered fallback.
			if nbrRange.fixedReg != RM_NONE 'hasFixed'
				markRegUsed(usedRegs, regOrd: nbrRange.fixedReg, poolIndexOf: poolIndexOf)
			end 'hasFixed' else 'noFixed'
				if nbrRange.hint != RM_NONE 'hasHint'
					markRegUsed(hintReservedRegs, regOrd: nbrRange.hint, poolIndexOf: poolIndexOf)
				end 'hasHint'
			end 'noFixed'
		end 'uncoloredNbr'
	end 'eachNbr'

	// Choose a register via the shared picker (same logic as the first-fit
	// pass in colorClass) so the eviction fixup and first-fit never disagree.
	let chosenReg = pickRegisterForRange(range, usedRegs: usedRegs, hintReservedRegs: hintReservedRegs, nbrs: nbrs, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, vidToRangeIdx: vidToRangeIdx, rangeColors: rangeColors, ranges: ranges)

	// Store the assignment
	try rangeColors.set(sortedIdx, value: chosenReg) otherwise panic("invariant: rangeColors.set OOB")

	if chosenReg != RM_NONE 'hasColor'
		let vid = range.valueId
		if vid < result.assignment.count() 'inBounds'
			try result.assignment.set(vid, value: chosenReg) otherwise panic("invariant: result.assignment.set OOB")
		end 'inBounds'
	end 'hasColor'

	return chosenReg
end 'tryColorRange'

// Greedy-style eviction fixup. After the first-fit pass leaves some virtual
// ranges uncolored, iteratively try to find a colored neighbor with strictly
// lower (weight, cascade) that the uncolored range can evict. The freed
// register goes to the uncolored range; the evictee is re-queued for
// recoloring with cascade bumped by one.
//
// Termination: each eviction strictly increases the evictee's
// (weight, cascade) lexicographic key (weight unchanged, cascade += 1). The
// MAX_CASCADE bound means any individual range can be evicted at most
// MAX_CASCADE times. So the total work across the fixup is O(n * MAX_CASCADE)
// pops.
//
// Ranges left uncolored after this pass fall through to the spill loop
// (RegisterAllocator.runSpillColorLoop) just as before — the fixup never
// makes the picker fail where the first-fit pass succeeded.
function runEvictionFixup(ranges LiveRangeArray, ig InterferenceGraph, rangeColors RegIntArray, vidToRangeIdx RegIntArray, pool RegIntArray, callerSavedMask BoolArray, poolIndexOf RegIntArray, poolSize RegInt, result ColoringResult, cascadeByValueId RegIntArray, cheapColoring bool)
	let numRanges = ranges.count()
	// Effective last-chance-recolor depth. 0 in fast mode disables the
	// recursive recolor search (the dominant regalloc cost) — the simple
	// cascade-eviction below still runs, so termination and correctness are
	// unaffected; a range eviction can't place just spills.
	let recolorDepth = effectiveRecolorDepth(cheapColoring)
	// Single work budget shared by EVERY last-chance-recolor in this coloring
	// pass. A per-entry budget bounds one search but not the count of entries:
	// a dense function leaves many ranges uncolored, each triggering a fresh
	// recolor, so the aggregate still explodes. One pass-wide budget hard-caps
	// the TOTAL recolor work for the whole eviction fixup regardless of how many
	// ranges are pending. Once spent, every further attempt bails clean and the
	// range falls through to the spill loop — bounded compile time, never
	// incorrect (see RecolorBudget / MAX_RECOLOR_NODES_PER_PASS).
	var recolorBudget = RecolorBudget.create(MAX_RECOLOR_NODES_PER_PASS)
	// Worklist of range indices to (re-)try coloring. Initialized from
	// the set of virtual ranges still uncolored after first-fit.
	var pending = RegIntArray.create()
	var ri = 0
	while ri < numRanges 'collect'
		let range = try ranges.get(ri) otherwise panic("invariant: ri < numRanges but ranges.get OOB")
		if range.fixedReg == RM_NONE 'isVirtual'
			let color = try rangeColors.get(ri) otherwise panic("invariant: rangeColors sized to numRanges but get OOB")
			if color == RM_NONE 'uncolored'
				pending.push(ri)
			end 'uncolored'
		end 'isVirtual'
		ri = ri + 1
	end 'collect'

	if pending.count() == 0 'allColored'
		return
	end 'allColored'

	// Per-range priority/eligibility keys, hoisted once so pickHighestPriority
	// and pickEvictionVictim read scalars instead of copying a LiveRange per
	// scanned candidate. Built only when some range is actually pending (the
	// common all-colored case returns above without paying for them).
	// `cascade` is the only key that changes during the fixup; every bump goes
	// through bumpEvicteeCascade, which mirrors it into cascadeByRange.
	var spillWeightByRange = RegIntArray.create()
	var cascadeByRange = RegIntArray.create()
	var fixedRegByRange = RegIntArray.create()
	var crossesCallByRange = BoolArray.create()
	for range in ranges 'hoistKeys'
		spillWeightByRange.push(range.spillWeight)
		cascadeByRange.push(range.cascade)
		fixedRegByRange.push(range.fixedReg)
		crossesCallByRange.push(range.crossesCall)
	end 'hoistKeys'

	// Safety belt: hard cap on total pops. With proper cascade discipline
	// the cap is `numRanges * (MAX_CASCADE + 1)`; the extra headroom catches
	// any subtle ordering bug without masking a real infinite loop.
	let popCap = numRanges * (MAX_CASCADE + 2) + 32
	var popCount = 0
	// Track whether any eviction has freed a register so far in this pass.
	// If not, calling tryColorRange a SECOND time on a range that first-fit
	// already failed to color is wasted work AND can produce a different
	// (still-valid but observably distinct) coloring because the picker
	// has a hint-deferral tiebreaker that depends on whether interfering
	// neighbors are colored or uncolored — and fixup sees more neighbors
	// colored than first-fit did. Skipping the re-color preserves the
	// pre-Phase-4 coloring on the no-eviction-needed path.
	var anyEvicted = false

	while pending.count() > 0 and popCount < popCap 'evictLoop'
		popCount = popCount + 1

		// Pop the highest-priority pending range: highest spill weight first
		// (so reload vregs with SPILL_WEIGHT_INFINITE go before normal-weight
		// ranges), tiebreak by lowest cascade (a freshly-pending range goes
		// before a range that has already cycled through eviction).
		let pickPos = pickHighestPriority(pending, spillWeightByRange: spillWeightByRange, cascadeByRange: cascadeByRange)
		let sortedIdx = try pending.get(pickPos) otherwise panic("invariant: pickPos in pending bounds")
		swapPopAt(pending, idx: pickPos)

		// Skip if this range was already colored in a previous eviction step
		// (e.g. an evictee may have been re-queued and then colored on a
		// fresh attempt). Defensive — the cascade discipline should prevent
		// the same range from being colored twice, but cheap to verify.
		let curColor = try rangeColors.get(sortedIdx) otherwise panic("invariant: rangeColors sized to numRanges")
		if curColor != RM_NONE 'alreadyColored'
			continue
		end 'alreadyColored'

		// Only retry coloring if an earlier eviction in THIS pass has freed
		// some register. Otherwise the picker sees the same constraints as
		// first-fit and would produce the same uncolored result — except
		// the hint-deferral tiebreaker can flip if a previously-uncolored
		// neighbor is now colored, which silently shifts the picker's
		// choice for THIS range. That shift is sound but not bit-identical
		// to the pre-Phase-4 baseline, which breaks the "no-eviction
		// inputs produce identical coloring" invariant.
		if anyEvicted 'evictedRecolor'
			let recolor = tryColorRange(sortedIdx, ranges: ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result)
			if recolor != RM_NONE 'gotColor'
				continue
			end 'gotColor'
		end 'evictedRecolor'

		// Still no register. Try eviction.
		let range = try ranges.get(sortedIdx) otherwise panic("invariant: sortedIdx in ranges bounds")

		// Eviction is offered to BOTH infinite-weight reloads and normal-weight
		// ranges, but with different stakes:
		//
		//   • Reloads (SPILL_WEIGHT_INFINITE) MUST be colored — they have no
		//     stack home of their own — so they cascade-evict aggressively and
		//     fall through to last-chance recoloring on failure.
		//
		//   • Normal-weight ranges evict ONLY when a strictly-cheaper colored
		//     neighbor exists (pickEvictionVictim enforces the strict
		//     (weight, cascade) ordering). This is not a free "trade one spill
		//     for another": it is the fix for a class of spill-loop non-
		//     termination. A range whose def site is register-pressure-
		//     saturated cannot be relieved by spilling ITSELF — its def must
		//     still land in a register before the spill-store can read it, so
		//     the def→store remnant re-enters the next iteration uncolored and
		//     the spiller re-spills the same value forever (loadSourceDirectory:
		//     a 2-position loadIndirect def→store wedged among 14 colored
		//     neighbors of equal-or-lower weight). The only way to color the
		//     remnant is to free a register at that point by evicting a cheaper
		//     neighbor — exactly what LLVM Greedy does. Because the victim is
		//     always strictly cheaper, the net spill cost never rises, and the
		//     cascade bound guarantees termination just as it does for reloads.
		//
		// A normal-weight range with NO strictly-cheaper victim still falls
		// through to the spill loop unchanged (evicteeIdx < 0 below), so the
		// only behavioral change is: when a cheaper neighbor IS available, we
		// spill it instead of pointlessly re-spilling the evictor.

		if range.cascade >= MAX_CASCADE 'cascadeExhausted'
			// Cannot evict any neighbor — the eviction rule requires the
			// evictee's (weight, cascade) be STRICTLY smaller than the
			// evictor's, and a range at MAX_CASCADE has the maximum possible
			// cascade. Leave uncolored; the spill loop handles it.
			logTrace(LogCategory.ir, message: function() gives "ssa-color: cascade-exhausted v{range.valueId} (cascade={range.cascade})")
			continue
		end 'cascadeExhausted'

		let evicteeIdx = pickEvictionVictim(sortedIdx, ig: ig, rangeColors: rangeColors, pool: pool, callerSavedMask: callerSavedMask, spillWeightByRange: spillWeightByRange, cascadeByRange: cascadeByRange, fixedRegByRange: fixedRegByRange, crossesCallByRange: crossesCallByRange)
		if evicteeIdx < 0 'noVictim'
			// Phase 6 backstop: try last-chance recursive recoloring before
			// giving up. Eviction failed because every colored neighbor is
			// either fixed-reg (cannot be moved), an infinite-weight reload
			// (we never displace one reload for another), or not strictly
			// cheaper than the evictor. Recursive recoloring can still succeed
			// by moving an interferer to a different register — even one held
			// by yet another colored neighbor — provided the cascading moves
			// bottom out within MAX_RECOLOR_DEPTH steps. It never spills, so
			// it is safe to attempt for normal-weight evictors too.
			var fixed = BoolArray.create()
			let recolored = tryLastChanceRecolor(sortedIdx, depth: recolorDepth, fixed: fixed, ranges: ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result, budget: recolorBudget)
			if recolored 'recolorOk'
				logTrace(LogCategory.ir, message: function() gives "ssa-color: last-chance-recolor v{range.valueId} (weight={range.spillWeight}, cascade={range.cascade})")
				continue
			end 'recolorOk'
			// No eligible victim AND last-chance recoloring failed — fall
			// through to spill loop, which spills this range (or, for an
			// infinite-weight reload with no parent merge, panics via
			// panicUnresolvableReload).
			logTrace(LogCategory.ir, message: function() gives "ssa-color: no-evictee v{range.valueId} (weight={range.spillWeight}, cascade={range.cascade})")
			continue
		end 'noVictim'

		// Evict the victim: clear its color, bump its cascade, persist the
		// new cascade to the sidetable so it survives the next liveness
		// rebuild, and push it back onto the pending list.
		let evictedReg = try rangeColors.get(evicteeIdx) otherwise panic("invariant: evicteeIdx is colored neighbor (just selected)")
		try rangeColors.set(evicteeIdx, value: RM_NONE) otherwise panic("invariant: rangeColors.set OOB")
		// Mutate the evictee's cascade and clear its color in result.
		// Pulled into a helper so the `var evictee` borrow of `ranges`
		// is released before the next iteration tries to scan it.
		let evicteeVid = bumpEvicteeCascade(ranges, evicteeIdx: evicteeIdx, cascadeByValueId: cascadeByValueId, result: result, cascadeByRange: cascadeByRange)
		pending.push(evicteeIdx)
		anyEvicted = true

		logTrace(LogCategory.ir, message: function() gives "ssa-color: evict v{evicteeVid} reg={evictedReg} for v{range.valueId}(w={range.spillWeight},c={range.cascade})")

		// Now retry coloring the evictor. With the evictee's register freed,
		// the picker should succeed — unless another neighbor also occupies
		// every register acceptable for this range's class. In that
		// pathological case the picker returns RM_NONE again, and we leave
		// the range pending for another round (a different victim may be
		// eligible next time).
		let postEvictColor = tryColorRange(sortedIdx, ranges: ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result)
		if postEvictColor == RM_NONE 'stillUncolored'
			// Re-queue for another eviction attempt. Cascade unchanged for
			// the evictor — only the evictee's cascade was bumped. The next
			// pop will try a different victim (or fall through if none).
			pending.push(sortedIdx)
		end 'stillUncolored'
	end 'evictLoop'

	if popCount >= popCap 'capHit'
		// Safety belt — should never fire if the cascade discipline is
		// correct. If it does, the spill loop still recovers (uncolored
		// ranges are spilled), but the bug needs investigating.
		logError(LogCategory.ir, message: function() gives "ssa-color: eviction-fixup pop-cap hit ({popCount} pops, {pending.count()} still pending) — possible cascade-bookkeeping bug")
	end 'capHit'
end 'runEvictionFixup'

// ============================================================
// Phase 6: Last-Chance Recoloring (Formal Backstop)
// ============================================================

// Mirrors LLVM Greedy's `tryLastChanceRecoloring`. When simple eviction
// (Phase 4) cannot find a register for `rangeIdx`, walk every register r in
// the pool and ask: "if I were to take r, can I recursively re-place all
// the neighbors currently holding r?" An interferer can move if it has
// some other register available, possibly after itself displacing one of
// its own neighbors at the next recursion depth.
//
// The `fixed` set tracks ranges that have *tentatively* been pinned to
// their current color higher up in the recursion stack; the recursion is
// not allowed to unfix those (otherwise the caller's choice would be
// undone underneath it). On success, the assignments stick; on failure,
// every tentative change made by this invocation is rolled back so the
// caller sees the colored state unchanged.
//
// Depth is bounded by MAX_RECOLOR_DEPTH so the worst-case work is
// `O(depth * fanout * pool_size)`. At depth 0 the helper degrades to
// "find a literally-free register" — no further recursion is permitted.
//
// Performance: the per-register interferer scan that `tryRecolorAtReg` used
// to do (re-walking `nbrs` once per pool register, O(poolSize * nbrs)) is
// replaced by a `RecolorInterferers` precompute that `tryRecolorPass` builds
// in a single O(nbrs) scan and reuses across the register attempts. The
// precompute is refreshed only after an attempt that actually mutated colors
// (rare on the hot path), keeping it bit-identical with the old fresh-per-call
// scan — see `RecolorInterferers` / `RecolorAttempt`.
function tryLastChanceRecolor(rangeIdx RegInt, depth RegInt, fixed BoolArray, ranges LiveRangeArray, ig InterferenceGraph, rangeColors RegIntArray, vidToRangeIdx RegIntArray, pool RegIntArray, callerSavedMask BoolArray, poolIndexOf RegIntArray, poolSize RegInt, result ColoringResult, budget RecolorBudget) returns bool
	if depth <= 0 'noDepth'
		return false
	end 'noDepth'

	let range = try ranges.get(rangeIdx) otherwise panic("tryLastChanceRecolor: rangeIdx out of bounds in ranges")
	// A fixed-reg range never enters last-chance recoloring — its color is
	// hardwired and cannot be chosen. (The eviction-fixup worklist only
	// holds virtual ranges, so this is a defensive check.)
	if range.fixedReg != RM_NONE 'isFixed'
		return false
	end 'isFixed'

	let nbrs = try ig.neighbors.get(rangeIdx) otherwise panic("tryLastChanceRecolor: rangeIdx out of bounds in ig.neighbors")
	let preferCallerSaved = not range.crossesCall

	// Walk the pool in fallback-picker order (caller-saved bias for non-call-
	// crossing ranges, callee-saved bias otherwise). The two-pass order
	// mirrors `pickRegFromPool`: preferred class first, then the off-class
	// fallback for non-call-crossing ranges. Call-crossing ranges never
	// accept a caller-saved register (would be silently clobbered). Each pass
	// builds (and refreshes) its own interferer-lookup precompute against the
	// current colors.
	if tryRecolorPass(rangeIdx, depth: depth, fixed: fixed, ranges: ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result, nbrs: nbrs, range: range, preferClass: preferCallerSaved, budget: budget) 'preferOk'
		return true
	end 'preferOk'
	if preferCallerSaved 'tryOffClass'
		// Tier-3 fallback for non-call-crossing ranges: callee-saved is
		// acceptable but costs an extra prologue save.
		if tryRecolorPass(rangeIdx, depth: depth, fixed: fixed, ranges: ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result, nbrs: nbrs, range: range, preferClass: false, budget: budget) 'offClassOk'
			return true
		end 'offClassOk'
	end 'tryOffClass'
	return false
end 'tryLastChanceRecolor'

// Interferer-collection precompute for last-chance recoloring, keyed by pool
// index. Built (and refreshed) by `tryRecolorPass` against the colors current
// at each per-register attempt, so a single O(nbrs) scan replaces the old
// O(poolSize * nbrs) per-register re-scan inside tryRecolorAtReg.
//
// Layout: a flat counting-sort bucketization rather than `poolSize` separate
// arrays. `bucketStart` has poolSize+1 entries; the colored neighbors holding
// the register at pool index `pi` occupy `flatColoredNeighbors[bucketStart[pi]
// .. bucketStart[pi+1])`, in the SAME order `nbrs` enumerates them. The old
// per-pool-index `RegIntArrayArray` (poolSize fresh `RegIntArray`s allocated on
// every build, the dominant regalloc allocation churn on high-pressure
// functions) is replaced by two flat `RegIntArray`s total, independent of
// poolSize. `bucketRangeFor` reproduces the per-targetReg interferer slice; the
// stable counting-sort placement keeps the slice order byte-identical to the
// old bucket-push order.
//
//   • uncoloredFixedRegSet[poolIndexOf[reg]] is true when some uncolored
//     neighbor has fixedReg == reg — it will inevitably take that register,
//     so handing it to `range` would conflict (the old `futureFixed` guard).
//
// Out-of-pool neighbor colors / fixedRegs are skipped: a targetReg always
// comes from the pool, so an ordinal absent from the pool can never equal it,
// matching the old per-reg `==` test exactly.
type RecolorInterferers
	export var flatColoredNeighbors as RegIntArray
	export var bucketStart as RegIntArray
	export var uncoloredFixedRegSet as BoolArray

	export static function create(nbrs RegIntArray, ranges LiveRangeArray, rangeColors RegIntArray, poolIndexOf RegIntArray, poolSize RegInt) returns RecolorInterferers
		var uncoloredFixedRegSet = BoolArray.create()
		growColorBoolArray(uncoloredFixedRegSet, size: poolSize)

		// Counting sort pass 1: tally colored neighbors per pool index while
		// marking uncolored fixed-reg conflicts. `bucketStart` is sized
		// poolSize+1 and first used as the per-bucket count, then prefix-summed
		// into start offsets.
		var bucketStart = RegIntArray.create()
		var s = 0
		while s <= poolSize 'initCounts'
			bucketStart.push(0)
			s = s + 1
		end 'initCounts'

		var totalColored = 0
		for nbrIdx in nbrs 'tally'
			let nbrColor = getOr(rangeColors, index: nbrIdx, fallback: RM_NONE)
			if nbrColor != RM_NONE 'colored'
				let pi = poolIndexOfReg(nbrColor, poolIndexOf: poolIndexOf)
				if pi != RM_NONE 'inPool'
					let prev = try bucketStart.get(pi) otherwise panic("RecolorInterferers.create: bucketStart.get OOB during tally")
					try bucketStart.set(pi, value: prev + 1) otherwise panic("RecolorInterferers.create: bucketStart.set OOB during tally")
					totalColored = totalColored + 1
				end 'inPool'
			end 'colored' else 'uncolored'
				let nbrRange = try ranges.get(nbrIdx) otherwise panic("RecolorInterferers.create: nbrIdx from ig.neighbors out of bounds in ranges")
				if nbrRange.fixedReg != RM_NONE 'hasFixed'
					let pi = poolIndexOfReg(nbrRange.fixedReg, poolIndexOf: poolIndexOf)
					if pi != RM_NONE 'fixedInPool'
						try uncoloredFixedRegSet.set(pi, value: true) otherwise panic("RecolorInterferers.create: uncoloredFixedRegSet.set OOB")
					end 'fixedInPool'
				end 'hasFixed'
			end 'uncolored'
		end 'tally'

		// Prefix sum: bucketStart[pi] becomes the start offset of bucket pi.
		// `cursor` tracks the next free slot per bucket during placement.
		var cursor = RegIntArray.create()
		var acc = 0
		var bi = 0
		while bi < poolSize 'prefixSum'
			let cnt = try bucketStart.get(bi) otherwise panic("RecolorInterferers.create: bucketStart.get OOB during prefix sum")
			try bucketStart.set(bi, value: acc) otherwise panic("RecolorInterferers.create: bucketStart.set OOB during prefix sum")
			cursor.push(acc)
			acc = acc + cnt
			bi = bi + 1
		end 'prefixSum'
		try bucketStart.set(poolSize, value: acc) otherwise panic("RecolorInterferers.create: bucketStart.set sentinel OOB")

		// Pre-size the flat output so placement writes by index.
		var flatColoredNeighbors = RegIntArray.create()
		var f = 0
		while f < totalColored 'initFlat'
			flatColoredNeighbors.push(-1)
			f = f + 1
		end 'initFlat'

		// Counting sort pass 2: scatter each colored neighbor into its bucket
		// slot. The per-bucket cursor advances in `nbrs` order, so each bucket's
		// slice preserves the enumeration order of `nbrs` — byte-identical to
		// the old append-per-bucket build.
		for nbrIdx in nbrs 'scatter'
			let nbrColor = getOr(rangeColors, index: nbrIdx, fallback: RM_NONE)
			if nbrColor != RM_NONE 'coloredScatter'
				let pi = poolIndexOfReg(nbrColor, poolIndexOf: poolIndexOf)
				if pi != RM_NONE 'inPoolScatter'
					let slot = try cursor.get(pi) otherwise panic("RecolorInterferers.create: cursor.get OOB during scatter")
					try flatColoredNeighbors.set(slot, value: nbrIdx) otherwise panic("RecolorInterferers.create: flatColoredNeighbors.set OOB during scatter")
					try cursor.set(pi, value: slot + 1) otherwise panic("RecolorInterferers.create: cursor.set OOB during scatter")
				end 'inPoolScatter'
			end 'coloredScatter'
		end 'scatter'

		return Self{flatColoredNeighbors: flatColoredNeighbors, bucketStart: bucketStart, uncoloredFixedRegSet: uncoloredFixedRegSet}
	end 'create'
end 'RecolorInterferers'

// The [start, stop) range into `interferers.flatColoredNeighbors` holding the
// colored neighbors at pool index `pi`. `pi` is always a valid pool index (it
// comes from `poolIndexOfReg` on a pool register), so both reads are in bounds.
function recolorBucketRange(interferers RecolorInterferers, pi RegInt) returns RegIntPair
	let start = try interferers.bucketStart.get(pi) otherwise panic("recolorBucketRange: bucketStart.get({pi}) OOB")
	let stop = try interferers.bucketStart.get(pi + 1) otherwise panic("recolorBucketRange: bucketStart.get({pi + 1}) OOB")
	return RegIntPair.create(start, second: stop)
end 'recolorBucketRange'

// A pair of RegInts; used for the [start, stop) slice returned by
// recolorBucketRange.
type RegIntPair
	export var first as RegInt
	export var second as RegInt

	export static function create(first RegInt, second RegInt) returns RegIntPair
		return Self{first: first, second: second}
	end 'create'
end 'RegIntPair'

// Outcome of one `tryRecolorAtReg` attempt. `success` is the old boolean
// return. `mutatedColors` is true when the attempt reached the
// tentative-assignment block — i.e. it may have left `rangeColors`/`result`
// changed relative to the attempt's entry state. A failed attempt rolls back
// its OWN interferers and `range`, but a successful inner recursion it later
// abandons can leave THIRD-PARTY neighbors recolored (pre-existing behavior
// the old per-call rescan absorbed). So whenever `mutatedColors` is true, the
// frame's `RecolorInterferers` precompute must be rebuilt before the next
// per-register attempt to stay bit-identical with the old fresh-scan logic.
type RecolorAttempt
	export var success as bool
	export var mutatedColors as bool

	// `range` could not take `targetReg` and no colors were touched (an early
	// bail before the tentative-assignment block).
	export static function bailedClean() returns RecolorAttempt
		return Self{success: false, mutatedColors: false}
	end 'bailedClean'

	// `range` successfully took `targetReg`; the assignment sticks.
	export static function placed() returns RecolorAttempt
		return Self{success: true, mutatedColors: true}
	end 'placed'

	// The attempt reached the tentative-assignment block but failed and rolled
	// back its own state; third-party colors may have changed (see the type doc).
	export static function rolledBack() returns RecolorAttempt
		return Self{success: false, mutatedColors: true}
	end 'rolledBack'
end 'RecolorAttempt'

// Map a register ordinal to its pool index, or RM_NONE when the ordinal is
// not in the active pool (negative ordinals or a different register class).
// Mirrors the lookup markRegUsed/isRegUsed perform.
function poolIndexOfReg(regOrd RegInt, poolIndexOf RegIntArray) returns RegInt
	if regOrd < 0 'negative'
		return RM_NONE
	end 'negative'
	return try poolIndexOf.get(regOrd) otherwise RM_NONE
end 'poolIndexOfReg'

// One sweep of the pool at a fixed preferred class. Used by
// tryLastChanceRecolor to split the two-tier walk (preferred class first,
// then off-class fallback) without duplicating the per-register attempt
// logic.
function tryRecolorPass(rangeIdx RegInt, depth RegInt, fixed BoolArray, ranges LiveRangeArray, ig InterferenceGraph, rangeColors RegIntArray, vidToRangeIdx RegIntArray, pool RegIntArray, callerSavedMask BoolArray, poolIndexOf RegIntArray, poolSize RegInt, result ColoringResult, nbrs RegIntArray, range LiveRange, preferClass bool, budget RecolorBudget) returns bool
	// Build the interferer lookup once for this pass; the dominant per-register
	// cost (interferer collection) becomes a single O(nbrs) scan instead of
	// O(poolSize * nbrs). It is rebuilt only after a per-register attempt that
	// reached its tentative-assignment block, since only those can leave the
	// live colors changed (a failed attempt that abandons a successful inner
	// recursion can leak third-party recolors). Early-bailing attempts — the
	// common case on high-pressure functions — reuse the same precompute.
	var interferers = RecolorInterferers.create(nbrs, ranges: ranges, rangeColors: rangeColors, poolIndexOf: poolIndexOf, poolSize: poolSize)

	var pi = 0
	while pi < poolSize 'eachReg'
		let isCallerSaved = try callerSavedMask.get(pi) otherwise panic("tryRecolorPass: callerSavedMask must be parallel to pool but get({pi}) failed")
		if isCallerSaved != preferClass 'wrongClass'
			pi = pi + 1
			continue
		end 'wrongClass'

		let reg = try pool.get(pi) otherwise panic("tryRecolorPass: pi < poolSize just succeeded but pool.get({pi}) failed")
		let attempt = tryRecolorAtReg(rangeIdx, targetReg: reg, depth: depth, fixed: fixed, ranges: ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result, range: range, recolorInterferers: interferers, budget: budget)
		if attempt.success 'tookIt'
			return true
		end 'tookIt'

		if attempt.mutatedColors 'rebuild'
			// The failed attempt may have left third-party neighbor colors
			// changed; refresh the lookup so the remaining registers see the
			// same live colors the old per-call fresh scan would have seen.
			interferers = RecolorInterferers.create(nbrs, ranges: ranges, rangeColors: rangeColors, poolIndexOf: poolIndexOf, poolSize: poolSize)
		end 'rebuild'

		pi = pi + 1
	end 'eachReg'
	return false
end 'tryRecolorPass'

// Attempt to give `range` the specific register `targetReg` by recursively
// re-placing every colored neighbor currently holding `targetReg`. Returns a
// `RecolorAttempt`: `success` true means the assignment sticks; on failure
// this frame's own state is rolled back. `mutatedColors` reports whether the
// attempt reached the tentative-assignment block (see `RecolorAttempt`).
//
// Pre-conditions: `range` is virtual (fixedReg == RM_NONE) and currently
// uncolored. `targetReg` is in `pool`. `recolorInterferers` is the
// precompute built by `RecolorInterferers.create` against the colors as they
// stand at the moment this attempt begins (the caller rebuilds it after any
// mutating attempt).
function tryRecolorAtReg(rangeIdx RegInt, targetReg RegOrdinal, depth RegInt, fixed BoolArray, ranges LiveRangeArray, ig InterferenceGraph, rangeColors RegIntArray, vidToRangeIdx RegIntArray, pool RegIntArray, callerSavedMask BoolArray, poolIndexOf RegIntArray, poolSize RegInt, result ColoringResult, range LiveRange, recolorInterferers RecolorInterferers, budget RecolorBudget) returns RecolorAttempt
	// Hard work-budget gate: once the whole search has spent its node budget,
	// every further candidate bails clean so the recolor is O(MAX_RECOLOR_NODES)
	// regardless of graph density. Safe — the eviction/spill backstop still
	// colors or spills the range. (See MAX_RECOLOR_NODES / RecolorBudget.)
	if not budget.tryConsume() 'budgetExhausted'
		return RecolorAttempt.bailedClean()
	end 'budgetExhausted'

	// `targetReg` always comes from the pool, so its pool index must exist.
	let targetPi = poolIndexOfReg(targetReg, poolIndexOf: poolIndexOf)
	if targetPi == RM_NONE 'targetNotInPool'
		panic("tryRecolorAtReg: targetReg must be in the active pool")
	end 'targetNotInPool'

	// An uncolored fixed-reg neighbor will later take its fixed register; if
	// that fixed register is `targetReg`, picking it for `range` would conflict
	// once the neighbor is colored. (The old per-reg `futureFixed` guard.)
	let futureFixed = try recolorInterferers.uncoloredFixedRegSet.get(targetPi) otherwise panic("tryRecolorAtReg: uncoloredFixedRegSet must be parallel to pool but get OOB")
	if futureFixed 'futureFixed'
		return RecolorAttempt.bailedClean()
	end 'futureFixed'

	// The colored neighbors currently holding `targetReg`, already in `nbrs`
	// order from the precompute. If any is unmovable (fixed-reg, already pinned
	// by an outer recursion via `fixed`, or evicted to cascade exhaustion),
	// `targetReg` is unreachable for `range` — try the next register. The
	// per-interferer checks and their order are identical to the old full scan.
	let bucket = recolorBucketRange(recolorInterferers, pi: targetPi)
	var interferers = RegIntArray.create()
	var mi = bucket.first
	while mi < bucket.second 'eachInterferer'
		let nbrIdx = try recolorInterferers.flatColoredNeighbors.get(mi) otherwise panic("tryRecolorAtReg: flatColoredNeighbors.get({mi}) OOB")
		mi = mi + 1
		let nbrRange = try ranges.get(nbrIdx) otherwise panic("tryRecolorAtReg: nbrIdx from ig.neighbors out of bounds in ranges")
		// Cannot displace a fixed-reg neighbor.
		if nbrRange.fixedReg != RM_NONE 'nbrFixed'
			return RecolorAttempt.bailedClean()
		end 'nbrFixed'
		// Cannot displace a neighbor the outer recursion has frozen.
		if isFixedInRecolor(fixed, idx: nbrIdx) 'pinned'
			return RecolorAttempt.bailedClean()
		end 'pinned'
		// Cannot displace a neighbor that has exhausted its eviction
		// cascade — the eviction picker already determined no further
		// movement is allowed for it. (Identical to the
		// runEvictionFixup `cascadeExhausted` guard.)
		if nbrRange.cascade >= MAX_CASCADE 'cascadeOut'
			return RecolorAttempt.bailedClean()
		end 'cascadeOut'
		interferers.push(nbrIdx)
	end 'eachInterferer'

	// Interference cap: abandon this candidate register if it would require
	// displacing too many colored neighbors. The recursive re-placement of each
	// interferer fans out combinatorially with depth, so an uncapped attempt on
	// a dense call-site clique is the recolor explosion that stalls the self-
	// compile. Bailing clean here is safe — no colors have been mutated yet, and
	// the eviction/spill backstop still colors or spills `range`. (See
	// MAX_RECOLOR_INTERFERERS.)
	if interferers.count() > MAX_RECOLOR_INTERFERERS 'tooManyInterferers'
		return RecolorAttempt.bailedClean()
	end 'tooManyInterferers'

	// Class-safety check for `range` itself: a call-crossing range cannot
	// land in a caller-saved register (the intervening call would clobber
	// it silently). Same guard as `pickRegFromPool`.
	if range.crossesCall 'mustBeCalleeSaved'
		let regIsCS = regIsCallerSaved(targetReg, pool: pool, callerSavedMask: callerSavedMask)
		if regIsCS 'wouldClobber'
			return RecolorAttempt.bailedClean()
		end 'wouldClobber'
	end 'mustBeCalleeSaved'

	// Save the original colors of every interferer so we can roll back on
	// failure. The parallel index lists let the rollback loop touch exactly
	// the slots we mutated.
	var savedColors = RegIntArray.create()
	var savedAssignments = RegIntArray.create()
	for n in interferers 'snap'
		let c = try rangeColors.get(n) otherwise panic("tryRecolorAtReg: interferer index out of bounds in rangeColors")
		savedColors.push(c)
		let nr = try ranges.get(n) otherwise panic("tryRecolorAtReg: interferer index out of bounds in ranges")
		let a = getOr(result.assignment, index: nr.valueId, fallback: RM_NONE)
		savedAssignments.push(a)
	end 'snap'

	// Tentatively clear each interferer's color and assign `targetReg` to
	// `range`. The `fixed` set is extended with `range`'s index so the
	// recursion below cannot pick `range` as an interferer and undo this
	// decision.
	for n in interferers 'unassign'
		try rangeColors.set(n, value: RM_NONE) otherwise panic("tryRecolorAtReg: rangeColors.set OOB on interferer clear")
		let nr = try ranges.get(n) otherwise panic("tryRecolorAtReg: interferer index out of bounds in ranges (clear assignment)")
		if nr.valueId < result.assignment.count() 'inBounds'
			try result.assignment.set(nr.valueId, value: RM_NONE) otherwise panic("tryRecolorAtReg: result.assignment.set OOB on interferer clear")
		end 'inBounds'
	end 'unassign'
	try rangeColors.set(rangeIdx, value: targetReg) otherwise panic("tryRecolorAtReg: rangeColors.set OOB on tentative assign")
	if range.valueId < result.assignment.count() 'inBoundsSelf'
		try result.assignment.set(range.valueId, value: targetReg) otherwise panic("tryRecolorAtReg: result.assignment.set OOB on tentative assign")
	end 'inBoundsSelf'
	addFixedInRecolor(fixed, idx: rangeIdx)

	// Attempt to re-place every interferer. First try a simple pick (some
	// other register is now free thanks to chains of recoloring higher up);
	// then fall back to recursive last-chance recoloring at depth-1.
	var placedCount = 0
	var allOk = true
	for n in interferers 'replace'
		let pickColor = tryColorRange(n, ranges: ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result)
		if pickColor != RM_NONE 'simplePick'
			placedCount = placedCount + 1
			continue
		end 'simplePick'
		// Recursive recolor at depth-1. The shared `fixed` set carries the
		// outer frame's pinned assignments so the recursion cannot disturb
		// them.
		if tryLastChanceRecolor(n, depth: depth - 1, fixed: fixed, ranges: ranges, ig: ig, rangeColors: rangeColors, vidToRangeIdx: vidToRangeIdx, pool: pool, callerSavedMask: callerSavedMask, poolIndexOf: poolIndexOf, poolSize: poolSize, result: result, budget: budget) 'recursiveOk'
			placedCount = placedCount + 1
			continue
		end 'recursiveOk'
		allOk = false
		break
	end 'replace'

	if allOk 'success'
		removeFixedInRecolor(fixed, idx: rangeIdx)
		logTrace(LogCategory.ir, message: function() gives "ssa-color: recolor v{range.valueId} -> reg={targetReg} depth={depth} interferers={interferers.count()}")
		return RecolorAttempt.placed()
	end 'success'

	// Roll back: undo any successful interferer placements first (so their
	// freed registers don't poison the simple-pick path on a future try),
	// then restore the saved colors. Restoring overwrites whatever the
	// successful recursive recolorings tentatively wrote — that's the whole
	// point of saving the snapshot before the tentative assignment.
	var ri = 0
	while ri < placedCount 'undoPlaced'
		let n = try interferers.get(ri) otherwise panic("tryRecolorAtReg: interferer index out of bounds during rollback")
		let nr = try ranges.get(n) otherwise panic("tryRecolorAtReg: interferer index out of bounds in ranges during rollback")
		try rangeColors.set(n, value: RM_NONE) otherwise panic("tryRecolorAtReg: rangeColors.set OOB during rollback clear")
		if nr.valueId < result.assignment.count() 'inBoundsR'
			try result.assignment.set(nr.valueId, value: RM_NONE) otherwise panic("tryRecolorAtReg: result.assignment.set OOB during rollback clear")
		end 'inBoundsR'
		ri = ri + 1
	end 'undoPlaced'
	// Restore the original interferer colors. The shared `rangeColors`
	// array sees the same pre-tentative state regardless of how the
	// recursion fared.
	var si = 0
	let interferersCount = interferers.count()
	while si < interferersCount 'restore'
		let n = try interferers.get(si) otherwise panic("tryRecolorAtReg: interferer index out of bounds during restore")
		let nr = try ranges.get(n) otherwise panic("tryRecolorAtReg: interferer index out of bounds in ranges during restore")
		let c = try savedColors.get(si) otherwise panic("tryRecolorAtReg: savedColors index out of bounds during restore")
		let a = try savedAssignments.get(si) otherwise panic("tryRecolorAtReg: savedAssignments index out of bounds during restore")
		try rangeColors.set(n, value: c) otherwise panic("tryRecolorAtReg: rangeColors.set OOB during restore")
		if nr.valueId < result.assignment.count() 'inBoundsRR'
			try result.assignment.set(nr.valueId, value: a) otherwise panic("tryRecolorAtReg: result.assignment.set OOB during restore")
		end 'inBoundsRR'
		si = si + 1
	end 'restore'
	// Un-tentatively-assign `range` itself.
	try rangeColors.set(rangeIdx, value: RM_NONE) otherwise panic("tryRecolorAtReg: rangeColors.set OOB on unassign self")
	if range.valueId < result.assignment.count() 'inBoundsSelfR'
		try result.assignment.set(range.valueId, value: RM_NONE) otherwise panic("tryRecolorAtReg: result.assignment.set OOB on unassign self")
	end 'inBoundsSelfR'
	removeFixedInRecolor(fixed, idx: rangeIdx)
	// This attempt entered the tentative-assignment block, so a successful
	// inner recursion it has now abandoned may have left third-party neighbors
	// recolored — signal the caller to rebuild the precompute before the next
	// per-register attempt so the interferer scan stays bit-identical.
	return RecolorAttempt.rolledBack()
end 'tryRecolorAtReg'

// Mark `idx` as frozen for the duration of an outer last-chance recolor
// frame. The BoolArray grows on demand; absent slots default to `false`.
function addFixedInRecolor(fixed BoolArray, idx RegInt)
	while fixed.count() <= idx 'grow'
		fixed.push(false)
	end 'grow'
	try fixed.set(idx, value: true) otherwise panic("addFixedInRecolor: fixed.set OOB after grow")
end 'addFixedInRecolor'

// Unmark `idx` once the outer frame's attempt has resolved (either by
// committing or rolling back). The slot is guaranteed to exist because
// `addFixedInRecolor` was paired with this call.
function removeFixedInRecolor(fixed BoolArray, idx RegInt)
	if idx < fixed.count() 'inBounds'
		try fixed.set(idx, value: false) otherwise panic("removeFixedInRecolor: fixed.set OOB inside count")
	end 'inBounds'
end 'removeFixedInRecolor'

// Read the frozen-flag for `idx`. Indices past the end default to `false`
// (the BoolArray is grown lazily by addFixedInRecolor as ranges enter the
// recursion stack).
function isFixedInRecolor(fixed BoolArray, idx RegInt) returns bool
	if idx >= fixed.count() 'outOfBounds'
		return false
	end 'outOfBounds'
	return try fixed.get(idx) otherwise false
end 'isFixedInRecolor'

// Bump the evictee's cascade by 1 and clear its `result.assignment` entry.
// The `var evictee = ranges.get(...)` borrow is scoped to this function so
// the caller can immediately resume mutating `ranges` (or do another
// `ranges.get(...)`-and-mutate cycle) without tripping the borrow checker.
// Returns the evictee's valueId so the caller can fold it into a log
// message without re-borrowing `ranges`.
function bumpEvicteeCascade(ranges LiveRangeArray, evicteeIdx RegInt, cascadeByValueId RegIntArray, result ColoringResult, cascadeByRange RegIntArray) returns RegInt
	var evictee = try ranges.get(evicteeIdx) otherwise panic("invariant: evicteeIdx in ranges bounds")
	let vid = evictee.valueId
	if vid < result.assignment.count() 'inBounds'
		try result.assignment.set(vid, value: RM_NONE) otherwise panic("invariant: result.assignment.set OOB")
	end 'inBounds'
	evictee.cascade = evictee.cascade + 1
	set(cascadeByValueId, index: vid, value: evictee.cascade, sentinel: 0)
	// Mirror the bump into the fixup's hoisted key array so the priority and
	// victim scans keep reading the current cascade.
	try cascadeByRange.set(evicteeIdx, value: evictee.cascade) otherwise panic("bumpEvicteeCascade: cascadeByRange.set({evicteeIdx}) OOB; sized to numRanges")
	return vid
end 'bumpEvicteeCascade'

// Find the position in `pending` of the highest-priority range. Higher spill
// weight wins; equal weight tiebreaks on lower cascade (a fresher range goes
// before a stale one). Linear scan — `pending` is bounded by the count of
// uncolored ranges, which is small in practice (the first-fit pass colors
// the vast majority). Reads the hoisted scalar key arrays instead of copying
// a LiveRange per candidate; scan order and tie-breaking (first-encountered
// wins) are unchanged.
function pickHighestPriority(pending RegIntArray, spillWeightByRange RegIntArray, cascadeByRange RegIntArray) returns RegInt
	let n = pending.count()
	if n == 0 'empty'
		panic("pickHighestPriority: pending list empty (caller must check before calling)")
	end 'empty'
	var bestPos = 0
	let firstIdx = try pending.get(0) otherwise panic("invariant: n > 0 but pending.get(0) failed")
	var bestWeight = try spillWeightByRange.get(firstIdx) otherwise panic("invariant: firstIdx in spillWeightByRange bounds")
	var bestCascade = try cascadeByRange.get(firstIdx) otherwise panic("invariant: firstIdx in cascadeByRange bounds")
	var i = 1
	while i < n 'scan'
		let candIdx = try pending.get(i) otherwise panic("invariant: i < n but pending.get failed")
		let candWeight = try spillWeightByRange.get(candIdx) otherwise panic("invariant: candIdx in spillWeightByRange bounds")
		let candCascade = try cascadeByRange.get(candIdx) otherwise panic("invariant: candIdx in cascadeByRange bounds")
		// Higher weight wins; equal-weight tiebreak: lower cascade wins.
		if candWeight > bestWeight 'higherWeight'
			bestPos = i
			bestWeight = candWeight
			bestCascade = candCascade
		end 'higherWeight' else 'sameOrLower'
			if candWeight == bestWeight and candCascade < bestCascade 'lowerCascade'
				bestPos = i
				bestCascade = candCascade
			end 'lowerCascade'
		end 'sameOrLower'
		i = i + 1
	end 'scan'
	return bestPos
end 'pickHighestPriority'

// Remove the entry at position `idx` from `list` by swapping the last entry
// into its slot and popping. O(1); does not preserve list order — fine for
// the worklist semantics of the eviction fixup.
function swapPopAt(list RegIntArray, idx RegInt)
	let last = list.count() - 1
	if idx < last 'notLast'
		let tail = try list.get(last) otherwise panic("invariant: list non-empty before swap")
		try list.set(idx, value: tail) otherwise panic("invariant: list.set OOB during swap-pop")
	end 'notLast'
	try list.pop() otherwise panic("invariant: list non-empty before pop")
end 'swapPopAt'

// Find the best eviction victim for `evictorIdx` from among its colored
// neighbors. The victim's (weight, cascade) must be strictly less than the
// evictor's under lexicographic ordering. Among all eligible victims, we
// pick the one with the LOWEST weight (cheapest to displace); ties on weight
// break to the lowest cascade (a freshly-evicted candidate has more "room"
// for the cascade bump that eviction will inflict).
//
// Fixed-reg ranges are excluded — their assignment is hardwired and cannot
// be moved. Returns -1 if no eligible victim exists; in that case the
// evictor must remain uncolored and fall through to the spill loop.
function pickEvictionVictim(evictorIdx RegInt, ig InterferenceGraph, rangeColors RegIntArray, pool RegIntArray, callerSavedMask BoolArray, spillWeightByRange RegIntArray, cascadeByRange RegIntArray, fixedRegByRange RegIntArray, crossesCallByRange BoolArray) returns RegInt
	// All range fields this scan needs are read from the hoisted scalar key
	// arrays (no LiveRange copy per neighbor); scan order and tie-breaking
	// (first-encountered wins) are unchanged.
	let evictorWeight = try spillWeightByRange.get(evictorIdx) otherwise panic("invariant: evictorIdx in spillWeightByRange bounds")
	let evictorCascade = try cascadeByRange.get(evictorIdx) otherwise panic("invariant: evictorIdx in cascadeByRange bounds")
	let evictorCrossesCall = try crossesCallByRange.get(evictorIdx) otherwise panic("invariant: evictorIdx in crossesCallByRange bounds")
	let nbrs = try ig.neighbors.get(evictorIdx) otherwise panic("invariant: evictorIdx in ig.neighbors bounds")

	// The evictor must be able to USE the evictee's register after the swap.
	// Otherwise the eviction is pointless: the freed register is one the
	// evictor's class-safety constraint (e.g. crossesCall + caller-saved)
	// would reject. We probe this per-victim by checking whether the
	// candidate register would be acceptable for the evictor.
	let evictorPrefersCallerSaved = not evictorCrossesCall

	var bestNbr = -1
	var bestWeight = i64.max
	var bestCascade = i64.max
	for nbrIdx in nbrs 'each'
		let nbrColor = getOr(rangeColors, index: nbrIdx, fallback: RM_NONE)
		if nbrColor == RM_NONE 'uncolored'
			continue
		end 'uncolored'

		let nbrFixedReg = try fixedRegByRange.get(nbrIdx) otherwise panic("invariant: nbrIdx in fixedRegByRange bounds")
		let nbrWeight = try spillWeightByRange.get(nbrIdx) otherwise panic("invariant: nbrIdx in spillWeightByRange bounds")
		let nbrCascade = try cascadeByRange.get(nbrIdx) otherwise panic("invariant: nbrIdx in cascadeByRange bounds")
		// Fixed-reg ranges and infinite-weight reload ranges cannot be
		// evicted — the former because their assignment is hardwired, the
		// latter because the spill loop already considers them
		// unspillable (any attempt to "respill" loops indefinitely).
		if nbrFixedReg != RM_NONE 'fixed'
			continue
		end 'fixed'
		if nbrWeight == SPILL_WEIGHT_INFINITE 'unspillable'
			continue
		end 'unspillable'

		// Strict lexicographic priority: evictee MUST have either lower
		// weight, or equal weight with lower cascade. Equal (weight, cascade)
		// is NOT allowed — that would enable cycles where two same-priority
		// ranges trade the same register forever.
		let weightLower = nbrWeight < evictorWeight
		let weightEqualCascadeLower = nbrWeight == evictorWeight and nbrCascade < evictorCascade
		if not weightLower and not weightEqualCascadeLower 'notEligible'
			continue
		end 'notEligible'

		// The evictor must be able to take the freed register. A
		// non-crossesCall evictor accepts any register; a crossesCall
		// evictor only accepts a callee-saved register (a caller-saved
		// freed reg would be silently clobbered by the intervening call).
		let regIsCS = regIsCallerSaved(nbrColor, pool: pool, callerSavedMask: callerSavedMask)
		if not evictorPrefersCallerSaved and regIsCS 'wrongClass'
			continue
		end 'wrongClass'

		// Among eligible victims, pick the cheapest (lowest weight); break
		// ties on lowest cascade.
		if nbrWeight < bestWeight 'newBest'
			bestNbr = nbrIdx
			bestWeight = nbrWeight
			bestCascade = nbrCascade
		end 'newBest' else 'sameOrHigher'
			if nbrWeight == bestWeight and nbrCascade < bestCascade 'tiebreak'
				bestNbr = nbrIdx
				bestCascade = nbrCascade
			end 'tiebreak'
		end 'sameOrHigher'
	end 'each'

	return bestNbr
end 'pickEvictionVictim'

// Build a parallel BoolArray indexed by pool position: true if the register
// at that pool position is caller-saved. Computed once per coloring pass and
// reused for every range, so the fallback loop avoids quadratic re-scans of
// the (small but non-trivial) callerSaved list.
function buildCallerSavedMask(pool RegIntArray, callerSaved RegIntArray) returns BoolArray
	var mask = BoolArray.create()
	let poolSize = pool.count()
	var pi = 0
	while pi < poolSize 'each'
		let reg = try pool.get(pi) otherwise RM_NONE
		mask.push(regIntArrayContains(callerSaved, value: reg))
		pi = pi + 1
	end 'each'
	return mask
end 'buildCallerSavedMask'

// Pick a register from the pool. Walks the pool once and tracks candidates
// in priority order:
//   Tier 1 (best): preferred class AND not reserved by an uncolored hinted neighbor
//   Tier 2:        preferred class but reserved (give up the hint)
//   Tier 3:        wrong class — only safe for preferCallerSaved=true (non-
//                  call-crossing range); a callee-saved fallback there costs
//                  one extra prologue save. For preferCallerSaved=false (call-
//                  crossing range) a caller-saved fallback would be silently
//                  clobbered by the intervening call, so we return RM_NONE
//                  and let the spill-and-retry loop materialize the value to
//                  a stack slot across the call.
function pickRegFromPool(pool RegIntArray, callerSavedMask BoolArray, usedRegs BoolArray, hintReservedRegs BoolArray, preferCallerSaved bool) returns RegOrdinal
	let poolSize = pool.count()
	var bestTier1 = RM_NONE
	var bestTier2 = RM_NONE
	var bestTier3 = RM_NONE
	var pi = 0
	while pi < poolSize 'scan'
		let reg = try pool.get(pi) otherwise panic("pickColor: pi < poolSize just succeeded but pool.get({pi}) failed (poolSize={poolSize})")
		let isCallerSaved = try callerSavedMask.get(pi) otherwise panic("pickColor: callerSavedMask must be parallel to pool but get({pi}) failed (poolSize={poolSize}, mask.count={callerSavedMask.count()})")
		let matchesClass = isCallerSaved == preferCallerSaved

		let poolUsed = try usedRegs.get(pi) otherwise panic("pickColor: usedRegs must be parallel to pool but get({pi}) failed (poolSize={poolSize}, usedRegs.count={usedRegs.count()})")
		if poolUsed 'inUse'
			pi = pi + 1
			continue
		end 'inUse'

		let isReserved = try hintReservedRegs.get(pi) otherwise panic("pickColor: hintReservedRegs must be parallel to pool but get({pi}) failed (poolSize={poolSize}, hintReservedRegs.count={hintReservedRegs.count()})")

		if matchesClass and not isReserved 'tier1'
			if bestTier1 == RM_NONE 'firstTier1'
				bestTier1 = reg
			end 'firstTier1'
		end 'tier1' else if matchesClass 'tier2'
			if bestTier2 == RM_NONE 'firstTier2'
				bestTier2 = reg
			end 'firstTier2'
		end 'tier2' else 'tier3'
			if bestTier3 == RM_NONE 'firstTier3'
				bestTier3 = reg
			end 'firstTier3'
		end 'tier3'

		pi = pi + 1
	end 'scan'

	if bestTier1 != RM_NONE 'haveTier1'
		return bestTier1
	end 'haveTier1'
	if bestTier2 != RM_NONE 'haveTier2'
		return bestTier2
	end 'haveTier2'
	// Tier 3 (wrong class) is only safe for non-call-crossing ranges. A
	// call-crossing range placed in a caller-saved register would be silently
	// clobbered by the intervening call (precisely the bug that
	// `mrt_f64_to_string` exposes when the f64 pool contains no callee-saved
	// option: pow's xmm result evaporates across an intervening mrt_alloc).
	// Returning RM_NONE forces the spill-and-retry loop to materialize the
	// value to a stack slot across the call instead.
	if preferCallerSaved 'tier3OK'
		return bestTier3
	end 'tier3OK'
	return RM_NONE
end 'pickRegFromPool'

// ============================================================
// Interference graph construction
// ============================================================

function buildInterferenceGraph(ranges LiveRangeArray, callerSavedByOrdinal BoolArray) returns InterferenceGraph
	let numRanges = ranges.count()
	var ig = InterferenceGraph.create(numRanges)

	// Build a block -> list of (rangeIdx, startPos, endPos) map
	// for efficient per-block overlap checking.
	// First find the max blockId; on the same walk, hoist the per-range
	// scalar keys the O(edges) emit loop below needs, so the copy-boundary
	// and redundancy tests read scalars instead of copying two LiveRanges
	// (retain/release on every managed field) per overlapping pair.
	var maxBlockId = 0
	var fixedRegByRange = RegIntArray.create()
	var crossesCallByRange = BoolArray.create()
	for range in ranges 'findMaxBlock'
		fixedRegByRange.push(range.fixedReg)
		crossesCallByRange.push(range.crossesCall)
		for interval in range.intervals 'eachInt'
			if interval.blockId > maxBlockId 'higher'
				maxBlockId = interval.blockId
			end 'higher'
		end 'eachInt'
	end 'findMaxBlock'

	let numBlocks = maxBlockId + 1

	// blockRanges[blockId] = array of range indices that have an interval in this block
	var blockRanges = RegIntArrayArray.create()
	var blockStarts = RegIntArrayArray.create()
	var blockEnds = RegIntArrayArray.create()

	var bi = 0
	while bi < numBlocks 'initBlockMaps'
		blockRanges.push(RegIntArray.create())
		blockStarts.push(RegIntArray.create())
		blockEnds.push(RegIntArray.create())
		bi = bi + 1
	end 'initBlockMaps'

	// Populate block maps
	var rangeIdx = 0
	for range in ranges 'populateBlocks'
		for interval in range.intervals 'eachInt2'
			let bid = interval.blockId

			if bid < numBlocks 'inBounds'
				// blockRanges/blockStarts/blockEnds are all sized to numBlocks; bid < numBlocks
				// was just checked, so all three lookups are in-bounds.
				try 'recordInterval'
					var br = blockRanges.get(bid)
					var bs = blockStarts.get(bid)
					var be = blockEnds.get(bid)
					br.push(rangeIdx)
					bs.push(interval.startPos)
					be.push(interval.endPos)
				end 'recordInterval' otherwise (e) 'badInterval'
					match e 'kind'
						indexOutOfBounds then panic("invariant: bid < numBlocks but parallel block-info array.get OOB")
						emptySlot then panic("invariant: parallel block-info array slot empty (push-init guarantees fill)")
					end 'kind'
				end 'badInterval'
			end 'inBounds'
		end 'eachInt2'
		rangeIdx = rangeIdx + 1
	end 'populateBlocks'

	// For each block, sweep intervals in start-position order. The active
	// set holds positions (into the block's parallel br/bs/be arrays) for
	// ranges whose interval has begun but not yet ended at the sweep
	// point. On each new arrival we (a) retire active entries whose endPos
	// has passed, then (b) emit interference vs every survivor (they
	// overlap the new range by construction), then (c) add the new range
	// to the active set. This is O(R log R + edges) per block versus a
	// naive O(R^2) pairwise scan; both addInterference and
	// isCopyBoundaryOverlap are symmetric in (a,b), so swapping argument
	// order at the call site is safe.
	var active = RegIntArray.create()
	var blockId = 0
	while blockId < numBlocks 'eachBlock'
		let br = try blockRanges.get(blockId) otherwise 'noBr2'
			blockId = blockId + 1
			continue
		end 'noBr2'
		let bs = try blockStarts.get(blockId) otherwise 'noBs2'
			blockId = blockId + 1
			continue
		end 'noBs2'
		let be = try blockEnds.get(blockId) otherwise 'noBe2'
			blockId = blockId + 1
			continue
		end 'noBe2'

		let count = br.count()
		active.clear()

		let order = sortBlockIndicesByStart(bs)

		var oi = 0
		while oi < count 'sweep'
			let idx = try order.get(oi) otherwise panic("buildInterference: order.get({oi}) OOB (count={count}, order.count={order.count()})")
			let ri1 = try br.get(idx) otherwise panic("buildInterference: br.get({idx}) OOB (count={count})")
			let s1 = try bs.get(idx) otherwise panic("buildInterference: bs.get({idx}) OOB (count={count})")
			let e1 = try be.get(idx) otherwise panic("buildInterference: be.get({idx}) OOB (count={count})")

			// Retire active entries whose interval ended at or before s1.
			// Half-open semantics: a range ending at endPos shares no position
			// with a range starting at endPos, matching the original
			// (s1 < e2 and s2 < e1) overlap test.
			var ai = 0
			while ai < active.count() 'retire'
				let activeIdx = try active.get(ai) otherwise panic("buildInterference: active.get({ai}) OOB")
				let activeEnd = try be.get(activeIdx) otherwise panic("buildInterference: be.get({activeIdx}) OOB for active entry")
				if activeEnd <= s1 'expired'
					// Swap-pop: O(1) removal that doesn't preserve order.
					let lastPos = active.count() - 1
					if ai != lastPos 'notLast'
						let tail = try active.get(lastPos) otherwise panic("buildInterference: active.get(lastPos) OOB")
						try active.set(ai, value: tail) otherwise panic("buildInterference: active.set OOB during swap-pop")
					end 'notLast'
					try active.pop() otherwise panic("buildInterference: active.pop on non-empty active set must succeed")
				end 'expired' else 'stillLive'
					ai = ai + 1
				end 'stillLive'
			end 'retire'

			// Every surviving active entry overlaps the new range — its
			// startPos <= s1 and its endPos > s1, so [s1, min(activeEnd, e1))
			// is non-empty.
			var ei = 0
			while ei < active.count() 'emit'
				let activeIdx = try active.get(ei) otherwise panic("buildInterference: active.get({ei}) OOB during emit")
				let ri2 = try br.get(activeIdx) otherwise panic("buildInterference: br.get({activeIdx}) OOB during emit")
				let s2 = try bs.get(activeIdx) otherwise panic("buildInterference: bs.get({activeIdx}) OOB during emit")
				let e2 = try be.get(activeIdx) otherwise panic("buildInterference: be.get({activeIdx}) OOB during emit")

				// Skip interference for copy-connected ranges that overlap by
				// exactly 1 position at the copy boundary. This happens when
				// the source's interval is [_, P+1) and the dest starts at [P, _):
				// they share only position P (the movRegReg instruction).
				// The overlap size is computed from the scalars already in
				// hand so the common path (`and` short-circuits) never pays
				// isCopyBoundaryOverlap's two LiveRange fetches.
				let minEnd = e1 if e1 < e2 else e2
				let maxStart = s1 if s1 > s2 else s2
				let isCopyBoundary = minEnd - maxStart == 1 and isCopyBoundaryOverlap(s1, e1: e1, s2: s2, e2: e2, blockId: blockId, ranges: ranges, ri1: ri1, ri2: ri2)
				if not isCopyBoundary 'realOverlap'
					// Drop edges between a caller-saved fixed-reg pseudo-range and a
					// call-crossing virtual: the picker never assigns that virtual to
					// any caller-saved register on any path, so the edge is provably
					// inert yet inflates the virtual's degree and apparent pressure.
					if not interferenceEdgeIsRedundantKeys(ri1, ri2: ri2, fixedRegByRange: fixedRegByRange, crossesCallByRange: crossesCallByRange, callerSavedByOrdinal: callerSavedByOrdinal) 'notRedundant'
						addInterference(ig, a: ri1, b: ri2)
					end 'notRedundant'
				end 'realOverlap'

				ei = ei + 1
			end 'emit'

			active.push(idx)
			oi = oi + 1
		end 'sweep'

		blockId = blockId + 1
	end 'eachBlock'

	return ig
end 'buildInterferenceGraph'

// Insertion-sort permutation: returns indices 0..bs.count() sorted by
// bs[idx] ascending. Per-block live-range counts are bounded (typically
// 10-100), so insertion sort is faster than a recursive quicksort once
// constants are folded in, and trivially stable.
export function sortBlockIndicesByStart(bs RegIntArray) returns RegIntArray
	let count = bs.count()
	var order = RegIntArray.create()
	var i = 0
	while i < count 'init'
		order.push(i)
		i = i + 1
	end 'init'

	var si = 1
	while si < count 'sort'
		let keyIdx = try order.get(si) otherwise panic("sortBlockIndicesByStart: order.get({si}) OOB (count={count})")
		let keyStart = try bs.get(keyIdx) otherwise panic("sortBlockIndicesByStart: bs.get({keyIdx}) OOB (count={count})")

		var j = si - 1
		while j >= 0 'insert'
			let jIdx = try order.get(j) otherwise panic("sortBlockIndicesByStart: order.get({j}) OOB during insert")
			let jStart = try bs.get(jIdx) otherwise panic("sortBlockIndicesByStart: bs.get({jIdx}) OOB during insert")
			if jStart <= keyStart 'inPlace'
				break
			end 'inPlace'
			try order.set(j + 1, value: jIdx) otherwise panic("sortBlockIndicesByStart: order.set OOB during insert")
			j = j - 1
		end 'insert'
		try order.set(j + 1, value: keyIdx) otherwise panic("sortBlockIndicesByStart: order.set final OOB")
		si = si + 1
	end 'sort'

	return order
end 'sortBlockIndicesByStart'

// Check if two overlapping intervals only share a single position at a copy boundary.
// Edge-aware: the new `copyEdges` sidetable on each LiveRange anchors every
// copy site at its exact (blockId, copyPos). Two ranges may overlap by exactly
// one position at multiple distinct copy boundaries throughout the function;
// the previous global single-link check (areCopyConnected) over-coalesced when
// a block-arg destination had multiple predecessors, because the last writer
// to `copyHintValueId` won the suppression for every other edge too. Now we
// require the overlap to coincide with a recorded edge on either range.
export function isCopyBoundaryOverlap(s1 RegInt, e1 RegInt, s2 RegInt, e2 RegInt, blockId BlockId, ranges LiveRangeArray, ri1 RegInt, ri2 RegInt) returns bool
	// Half-open overlap size: min(e1,e2) - max(s1,s2). Exactly 1 means
	// they share a single position — the copy boundary.
	var minEnd = e1
	if e2 < minEnd 'e2Smaller'
		minEnd = e2
	end 'e2Smaller'
	var maxStart = s1
	if s2 > maxStart 's2Bigger'
		maxStart = s2
	end 's2Bigger'
	if minEnd - maxStart != 1 'notBoundary'
		return false
	end 'notBoundary'

	let overlapPos = maxStart

	let r1 = try ranges.get(ri1) otherwise panic("isCopyBoundaryOverlap: ri1={ri1} out of bounds (ranges.count={ranges.count()})")
	let r2 = try ranges.get(ri2) otherwise panic("isCopyBoundaryOverlap: ri2={ri2} out of bounds (ranges.count={ranges.count()})")

	let edge1 = hasCopyEdgeAt(r1, partner: r2.valueId, blockId: blockId, copyPos: overlapPos)
	let edge2 = hasCopyEdgeAt(r2, partner: r1.valueId, blockId: blockId, copyPos: overlapPos)
	return edge1 or edge2
end 'isCopyBoundaryOverlap'

// Resolve a copy-link hint: if the partner is colored, return its color.
// If not, return the partner's static hint (from two-address coalescing).
function resolveCopyLinkHint(partnerValueId RegInt, vidToRangeIdx RegIntArray, rangeColors RegIntArray, ranges LiveRangeArray) returns RegOrdinal
	let partnerRangeIdx = getOr(vidToRangeIdx, index: partnerValueId, fallback: -1)
	if partnerRangeIdx < 0 'noPartner'
		return RM_NONE
	end 'noPartner'
	let partnerColor = getOr(rangeColors, index: partnerRangeIdx, fallback: RM_NONE)
	if partnerColor != RM_NONE 'colored'
		return partnerColor
	end 'colored'
	// Partner not colored yet — use its static hint if available.
	// partnerRangeIdx came from vidToRangeIdx (>=0 just checked) which holds valid range indices.
	let partnerRange = try ranges.get(partnerRangeIdx) otherwise panic("invariant: partnerRangeIdx from vidToRangeIdx out of bounds in ranges")
	return partnerRange.hint
end 'resolveCopyLinkHint'

// Two ranges are copy-connected if one's copyHintValueId points to the other's valueId.
// Copy-connected ranges at their boundary point should not interfere — the dest
// is a copy of the source and can safely share the same register.
function areCopyConnected(ranges LiveRangeArray, ri1 RegInt, ri2 RegInt) returns bool
	let r1 = try ranges.get(ri1) otherwise panic("invariant: ri1 out of bounds in ranges")
	let r2 = try ranges.get(ri2) otherwise panic("invariant: ri2 out of bounds in ranges")
	return r1.copyHintValueId == r2.valueId or r2.copyHintValueId == r1.valueId
end 'areCopyConnected'

// Build a caller-saved lookup keyed by register ordinal: result[ord] is true
// when the register with ordinal `ord` is in this class's caller-saved set.
// Sized to the largest ordinal in `pool`; ordinals past the end (or absent
// from the pool) read false via `getOr`, which is correct — a fixed-reg range
// pinned to a register outside the active pool is never caller-saved from this
// class's perspective.
function buildCallerSavedByOrdinal(pool RegIntArray, callerSaved RegIntArray) returns BoolArray
	var byOrd = BoolArray.create()
	for reg in pool 'sizeToPool'
		while byOrd.count() <= reg 'grow'
			byOrd.push(false)
		end 'grow'
	end 'sizeToPool'
	for csReg in callerSaved 'markCallerSaved'
		if csReg >= 0 and csReg < byOrd.count() 'inRange'
			try byOrd.set(csReg, value: true) otherwise panic("buildCallerSavedByOrdinal: set OOB after grow")
		end 'inRange'
	end 'markCallerSaved'
	return byOrd
end 'buildCallerSavedByOrdinal'

// True when the interference edge between range indices `ri1` and `ri2` cannot
// affect any coloring decision and is therefore safe to omit from the graph.
//
// The redundant case: one endpoint is a FIXED-REG range whose fixed register is
// caller-saved (a call-clobber pseudo, a caller-saved parameter range, or a
// caller-saved phys-dest range), and the OTHER endpoint is a VIRTUAL range that
// crosses a call. A crossesCall virtual is forbidden from any caller-saved
// register on every picker path:
//   • hint path: `hintClassSafe` rejects a caller-saved hint for crossesCall;
//   • first-fit / tryColorRange fallback: `pickRegFromPool` runs with
//     preferCallerSaved=false, so caller-saved regs are Tier-3 and Tier-3 is
//     returned only for preferCallerSaved=true (never for a crossesCall range);
//   • eviction: a crossesCall evictor rejects a freed caller-saved register
//     (`pickEvictionVictim` wrongClass guard); a fixed-reg range is never a
//     victim anyway;
//   • last-chance recolor: `tryRecolorAtReg` bails on a caller-saved targetReg
//     for a crossesCall range, and a fixed-reg interferer is never displaced.
// So the virtual would never occupy the fixed range's register regardless of
// the edge; removing it changes no `usedRegs`/hint/victim/recolor outcome but
// lowers the virtual's degree, reducing first-fit failures and recolor work.
export function interferenceEdgeIsRedundant(ranges LiveRangeArray, ri1 RegInt, ri2 RegInt, callerSavedByOrdinal BoolArray) returns bool
	let r1 = try ranges.get(ri1) otherwise panic("interferenceEdgeIsRedundant: ri1={ri1} OOB in ranges")
	let r2 = try ranges.get(ri2) otherwise panic("interferenceEdgeIsRedundant: ri2={ri2} OOB in ranges")
	return edgeRedundantOrderedKeys(r1.fixedReg, otherCrossesCall: r2.crossesCall, otherFixedReg: r2.fixedReg, callerSavedByOrdinal: callerSavedByOrdinal) or edgeRedundantOrderedKeys(r2.fixedReg, otherCrossesCall: r1.crossesCall, otherFixedReg: r1.fixedReg, callerSavedByOrdinal: callerSavedByOrdinal)
end 'interferenceEdgeIsRedundant'

// Hot-path variant of `interferenceEdgeIsRedundant` for buildInterferenceGraph:
// reads the hoisted per-range scalar keys instead of copying two LiveRanges
// per overlapping interval pair. Same predicate, same result.
function interferenceEdgeIsRedundantKeys(ri1 RegInt, ri2 RegInt, fixedRegByRange RegIntArray, crossesCallByRange BoolArray, callerSavedByOrdinal BoolArray) returns bool
	let fixed1 = try fixedRegByRange.get(ri1) otherwise panic("interferenceEdgeIsRedundantKeys: ri1={ri1} OOB in fixedRegByRange")
	let fixed2 = try fixedRegByRange.get(ri2) otherwise panic("interferenceEdgeIsRedundantKeys: ri2={ri2} OOB in fixedRegByRange")
	let crosses1 = try crossesCallByRange.get(ri1) otherwise panic("interferenceEdgeIsRedundantKeys: ri1={ri1} OOB in crossesCallByRange")
	let crosses2 = try crossesCallByRange.get(ri2) otherwise panic("interferenceEdgeIsRedundantKeys: ri2={ri2} OOB in crossesCallByRange")
	return edgeRedundantOrderedKeys(fixed1, otherCrossesCall: crosses2, otherFixedReg: fixed2, callerSavedByOrdinal: callerSavedByOrdinal) or edgeRedundantOrderedKeys(fixed2, otherCrossesCall: crosses1, otherFixedReg: fixed1, callerSavedByOrdinal: callerSavedByOrdinal)
end 'interferenceEdgeIsRedundantKeys'

// Directed half of `interferenceEdgeIsRedundant`, over scalar keys: true when
// the (fixedReg) endpoint is a caller-saved fixed-reg range and the other
// endpoint is a call-crossing virtual.
function edgeRedundantOrderedKeys(fixedReg RegOrdinal, otherCrossesCall bool, otherFixedReg RegOrdinal, callerSavedByOrdinal BoolArray) returns bool
	if fixedReg == RM_NONE 'notFixed'
		return false
	end 'notFixed'
	if not otherCrossesCall 'otherNotCallCrossing'
		return false
	end 'otherNotCallCrossing'
	if otherFixedReg != RM_NONE 'otherIsFixed'
		// Two fixed-reg ranges: their colors are hardwired, never picked, so
		// the edge is moot — but leave it in to avoid reasoning about fixed
		// vs fixed overlap; the cheap early-outs above already exclude the
		// common cases. A fixed range's crossesCall flag is left at its
		// default, so this branch is effectively unreachable for clobber
		// pseudos (crossesCall==false); guarding it keeps the predicate's
		// "other is the virtual" precondition explicit.
		return false
	end 'otherIsFixed'
	// Out-of-range ordinals (a register outside this class's pool) read false:
	// such a fixed range is not caller-saved from this class's perspective.
	if fixedReg < 0 or fixedReg >= callerSavedByOrdinal.count() 'outOfRange'
		return false
	end 'outOfRange'
	return try callerSavedByOrdinal.get(fixedReg) otherwise false
end 'edgeRedundantOrderedKeys'

export function addInterference(ig InterferenceGraph, a RegInt, b RegInt)
	// Add edge a <-> b, deduplicating against the existing neighbor set. The edge
	// is symmetric and both neighbor lists are updated together, so a single
	// membership scan of nbrsA covers both call orders (addInterference(a,b) and
	// addInterference(b,a)). This replaces a former numRanges*numRanges dedup
	// matrix that was allocated and zero-filled on EVERY coloring pass (~495MB at
	// 22270 ranges, ×2 for gpr+fp, rebuilt each spill iteration) yet was never
	// read by coloring — only here, for dedup. Per-range degree is small relative
	// to numRanges, and `b` is appended only on first sight, so neighbor lists
	// remain byte-identical to the matrix version.
	var nbrsA = try ig.neighbors.get(a) otherwise panic("addInterference: a={a} out of bounds in ig.neighbors (numRanges={ig.numRanges})")
	if regIntArrayContains(nbrsA, value: b) 'duplicate'
		return
	end 'duplicate'

	var nbrsB = try ig.neighbors.get(b) otherwise panic("addInterference: b={b} out of bounds in ig.neighbors (numRanges={ig.numRanges})")
	nbrsA.push(b)
	nbrsB.push(a)
end 'addInterference'

function regIntArrayContains(arr RegIntArray, value RegInt) returns bool
	for v in arr 'each'
		if v == value 'found'
			return true
		end 'found'
	end 'each'
	return false
end 'regIntArrayContains'

// ============================================================
// Dominance-tree preorder sorting
// ============================================================

// Build domPreorderIndex[blockId] = position in dominance-tree preorder
function buildDomPreorderIndex(domPreorder BlockIdArray) returns RegIntArray
	var index = RegIntArray.create()
	var pos = 0

	for blockId in domPreorder 'build'
		while index.count() <= blockId 'grow'
			index.push(i64.max)
		end 'grow'
		try index.set(blockId, value: pos) otherwise panic("invariant: index.set OOB")
		pos = pos + 1
	end 'build'

	return index
end 'buildDomPreorderIndex'

// Return range indices sorted by dominator-tree preorder of their def block.
// Sorted with an inline O(n log n) merge sort — see the note inside about the
// former insertion sort it replaced.
function sortByDomPreorder(ranges LiveRangeArray, domIndex RegIntArray) returns RegIntArray
	let numRanges = ranges.count()
	var order = RegIntArray.create()

	// Initialize with identity permutation
	var i = 0
	while i < numRanges 'init'
		order.push(i)
		i = i + 1
	end 'init'

	// Hoist the comparator's key tuple per range index ONCE. The comparator
	// used to fetch (copy) both LiveRanges on every comparison inside the
	// merge sort; the keys (defBlock's dom-preorder position, fixed-vs-
	// virtual kind, defPosition) are immutable during the sort, so extract
	// them up front and compare scalars.
	var domPosByRange = RegIntArray.create()
	var isVirtualByRange = BoolArray.create()
	var defPositionByRange = RegIntArray.create()
	for range in ranges 'hoistKeys'
		domPosByRange.push(getOr(domIndex, index: range.defBlock, fallback: i64.max))
		isVirtualByRange.push(range.fixedReg == RM_NONE)
		defPositionByRange.push(range.defPosition)
	end 'hoistKeys'

	// Sort by (domPreorderIndex[range.defBlock], fixed-before-virtual,
	// defPosition, range index). Fixed-reg ranges sort before virtual ranges at
	// the same dom position so their physical register is marked used before
	// virtual ranges are colored.
	//
	// Was an O(numRanges²) insertion sort; on the compiler's largest functions
	// the spill loop rebuilds + re-sorts tens of thousands of ranges every
	// iteration, so it dominated backend time. This is an inline O(n log n) merge
	// sort (NOT stdlib Array.sort — its comparator path is unused and crashes in
	// the self-hosted compiler). `rangeBeforeByDomPreorder` is a TOTAL order (the
	// range-index tiebreaker), and the former insertion sort was stable over the
	// identity permutation, so the two produce byte-identical orders.
	if numRanges > 1 'doSort'
		var scratch = RegIntArray.create()
		var s = 0
		while s < numRanges 'initScratch'
			scratch.push(0)
			s = s + 1
		end 'initScratch'
		mergeSortByDomPreorder(order, lo: 0, hi: numRanges, scratch: scratch, domPosByRange: domPosByRange, isVirtualByRange: isVirtualByRange, defPositionByRange: defPositionByRange)
	end 'doSort'

	return order
end 'sortByDomPreorder'

// Recursive merge sort of order[lo..hi) (indices into `ranges`) by
// `rangeBeforeByDomPreorder`. `scratch` is a caller-provided buffer sized to
// order.count(); each merge writes only its own [lo, hi) slice, so the shared
// buffer is safe under depth-first recursion.
function mergeSortByDomPreorder(order RegIntArray, lo RegInt, hi RegInt, scratch RegIntArray, domPosByRange RegIntArray, isVirtualByRange BoolArray, defPositionByRange RegIntArray)
	if hi - lo < 2 'base'
		return
	end 'base'
	let mid = lo + (hi - lo) / 2
	mergeSortByDomPreorder(order, lo: lo, hi: mid, scratch: scratch, domPosByRange: domPosByRange, isVirtualByRange: isVirtualByRange, defPositionByRange: defPositionByRange)
	mergeSortByDomPreorder(order, lo: mid, hi: hi, scratch: scratch, domPosByRange: domPosByRange, isVirtualByRange: isVirtualByRange, defPositionByRange: defPositionByRange)

	var i = lo
	var j = mid
	var k = lo
	while i < mid and j < hi 'merge'
		let a = try order.get(i) otherwise panic("mergeSortByDomPreorder: order.get({i}) OOB")
		let b = try order.get(j) otherwise panic("mergeSortByDomPreorder: order.get({j}) OOB")
		if rangeBeforeByDomPreorder(a, bIdx: b, domPosByRange: domPosByRange, isVirtualByRange: isVirtualByRange, defPositionByRange: defPositionByRange) 'takeLeft'
			try scratch.set(k, value: a) otherwise panic("mergeSortByDomPreorder: scratch.set OOB")
			i = i + 1
		end 'takeLeft' else 'takeRight'
			try scratch.set(k, value: b) otherwise panic("mergeSortByDomPreorder: scratch.set OOB")
			j = j + 1
		end 'takeRight'
		k = k + 1
	end 'merge'
	while i < mid 'drainLeft'
		let a = try order.get(i) otherwise panic("mergeSortByDomPreorder: drainLeft.get OOB")
		try scratch.set(k, value: a) otherwise panic("mergeSortByDomPreorder: drainLeft.set OOB")
		i = i + 1
		k = k + 1
	end 'drainLeft'
	while j < hi 'drainRight'
		let b = try order.get(j) otherwise panic("mergeSortByDomPreorder: drainRight.get OOB")
		try scratch.set(k, value: b) otherwise panic("mergeSortByDomPreorder: drainRight.set OOB")
		j = j + 1
		k = k + 1
	end 'drainRight'
	var m = lo
	while m < hi 'copyBack'
		let v = try scratch.get(m) otherwise panic("mergeSortByDomPreorder: copyBack.get OOB")
		try order.set(m, value: v) otherwise panic("mergeSortByDomPreorder: copyBack.set OOB")
		m = m + 1
	end 'copyBack'
end 'mergeSortByDomPreorder'

// True iff range `aIdx` sorts strictly before range `bIdx`: by dom-preorder
// index of the def block, then fixed-reg before virtual, then def position,
// then range index (tiebreaker → total order). Matches the former insertion
// sort's stable (domPos, isVirtual, defPos) ordering exactly. Compares the
// key tuples hoisted by sortByDomPreorder — no LiveRange copies inside the
// merge sort's comparison loop.
function rangeBeforeByDomPreorder(aIdx RegInt, bIdx RegInt, domPosByRange RegIntArray, isVirtualByRange BoolArray, defPositionByRange RegIntArray) returns bool
	let aDomPos = try domPosByRange.get(aIdx) otherwise panic("rangeBeforeByDomPreorder: domPosByRange.get({aIdx}) OOB")
	let bDomPos = try domPosByRange.get(bIdx) otherwise panic("rangeBeforeByDomPreorder: domPosByRange.get({bIdx}) OOB")
	if aDomPos != bDomPos 'domDiffers'
		return aDomPos < bDomPos
	end 'domDiffers'
	let aIsVirtual = try isVirtualByRange.get(aIdx) otherwise panic("rangeBeforeByDomPreorder: isVirtualByRange.get({aIdx}) OOB")
	let bIsVirtual = try isVirtualByRange.get(bIdx) otherwise panic("rangeBeforeByDomPreorder: isVirtualByRange.get({bIdx}) OOB")
	if aIsVirtual != bIsVirtual 'kindDiffers'
		// fixed-reg (not virtual) sorts first: a is before b iff a is fixed.
		return not aIsVirtual
	end 'kindDiffers'
	let aDefPos = try defPositionByRange.get(aIdx) otherwise panic("rangeBeforeByDomPreorder: defPositionByRange.get({aIdx}) OOB")
	let bDefPos = try defPositionByRange.get(bIdx) otherwise panic("rangeBeforeByDomPreorder: defPositionByRange.get({bIdx}) OOB")
	if aDefPos != bDefPos 'defDiffers'
		return aDefPos < bDefPos
	end 'defDiffers'
	return aIdx < bIdx
end 'rangeBeforeByDomPreorder'

// ============================================================
// Register availability helpers
// ============================================================

function growColorBoolArray(arr BoolArray, size RegInt)
	while arr.count() < size 'grow'
		arr.push(false)
	end 'grow'
end 'growColorBoolArray'

// Check if any uncolored neighbor has a fixedReg matching the hint.
// These neighbors will inevitably be colored to that register, so using
// the hint would create a conflict.
function hintConflictsWithFixedNeighbor(hint RegOrdinal, nbrs RegIntArray, ranges LiveRangeArray, rangeColors RegIntArray) returns bool
	for nbrIdx in nbrs 'eachNbr'
		let nbrColor = getOr(rangeColors, index: nbrIdx, fallback: RM_NONE)
		if nbrColor == RM_NONE 'uncolored'
			let nbrRange = try ranges.get(nbrIdx) otherwise panic("invariant: nbrIdx from ig.neighbors out of bounds in ranges")
			if nbrRange.fixedReg == hint 'conflicts'
				return true
			end 'conflicts'
		end 'uncolored'
	end 'eachNbr'
	return false
end 'hintConflictsWithFixedNeighbor'

// `regOrd` may be RM_NONE (=-1) for unhinted ranges, or a register from a
// different class than the active pool. Treat both as "not in pool" no-ops.
function markRegUsed(usedRegs BoolArray, regOrd RegInt, poolIndexOf RegIntArray)
	if regOrd < 0 'negative'
		return
	end 'negative'
	let pi = try poolIndexOf.get(regOrd) otherwise RM_NONE
	if pi != RM_NONE 'inPool'
		try usedRegs.set(pi, value: true) otherwise panic("markRegUsed: usedRegs.set({pi}) OOB; usedRegs must be parallel to pool")
	end 'inPool'
end 'markRegUsed'

// Check if a register ordinal is marked as used. See `markRegUsed` for why
// the negative / out-of-pool inputs are valid.
function isRegUsed(usedRegs BoolArray, regOrd RegInt, poolIndexOf RegIntArray) returns bool
	if regOrd < 0 'negative'
		return false
	end 'negative'
	let pi = try poolIndexOf.get(regOrd) otherwise RM_NONE
	if pi == RM_NONE 'notInPool'
		return false
	end 'notInPool'
	return try usedRegs.get(pi) otherwise panic("isRegUsed: usedRegs.get({pi}) OOB; usedRegs must be parallel to pool")
end 'isRegUsed'

// Check if a register ordinal is caller-saved. Used by the hint path to
// reject hints that would place a call-crossing range into a register the
// call would clobber. The pool/mask lookup mirrors isRegUsed so the
// caller-saved classification stays consistent with the fallback tier logic.
function regIsCallerSaved(regOrd RegInt, pool RegIntArray, callerSavedMask BoolArray) returns bool
	let poolSize = pool.count()
	var pi = 0
	while pi < poolSize 'find'
		let poolReg = try pool.get(pi) otherwise panic("regIsCallerSaved: pi < poolSize just succeeded but pool.get({pi}) failed (poolSize={poolSize})")
		if poolReg == regOrd 'match'
			return try callerSavedMask.get(pi) otherwise panic("regIsCallerSaved: callerSavedMask must be parallel to pool but get({pi}) failed (poolSize={poolSize}, mask.count={callerSavedMask.count()})")
		end 'match'
		pi = pi + 1
	end 'find'
	return false
end 'regIsCallerSaved'

// ============================================================
// Conservative coalescing (hint-based)
// ============================================================

// Scan for copy-like operations (movRegReg) and set register hints
// on destination ranges to prefer the same register as the source.
// This is a lightweight form of coalescing that the coloring phase
// supports via the hint field on LiveRange.
//
// returnGprOrd is the target's return register ordinal (or RM_NONE if the
// target has no special return-register handling). When non-RM_NONE, the
// coalescer also runs a reverse-direction pass that overrides any existing
// hint on the value flowing into a trailing `mov retReg, vreg` right before
// a `ret` terminator. The closest-to-death hint is the most valuable one
// for a return value because it costs zero extra moves to honor.
//
// errorFlagOrd is the target's error-flag return register ordinal (RDX on
// x64, X1 on arm64), used to pin inlined-continuation error-flag phis to
// the same register the multi-value-return ABI would have placed them in.
export function coalesceRanges(module TargetModule, ranges LiveRangeArray, func IrFunction, returnGprOrd RegOrdinal, errorFlagOrd RegOrdinal, opQuery TargetOpQuery)
	// Build valueId -> range index map for fast lookup
	var vidToRangeIdx = RegIntArray.create()

	var ri = 0
	while ri < ranges.count() 'buildVidMap'
		let range = try ranges.get(ri) otherwise 'skip'
			ri = ri + 1
			continue
		end 'skip'

		let vid = range.valueId
		while vidToRangeIdx.count() <= vid 'grow'
			vidToRangeIdx.push(-1)
		end 'grow'
		try vidToRangeIdx.set(vid, value: ri) otherwise panic("invariant: vidToRangeIdx.set OOB")

		ri = ri + 1
	end 'buildVidMap'

	// blockId -> blockRef index so hintBranchArgs resolves each branch
	// edge's target block in O(1). It used to re-scan func.blockRefs (an
	// IrBlock copy per probed block) once per outgoing edge of every block —
	// O(blocks²) on branch-dense functions.
	let blockIdToRef = buildFuncBlockIdToRef(module, func: func)

	// Scan all ops for copy-like patterns. opIdx is the 0-indexed position
	// within the block; opPos = opIdx + 1 matches the interval space used by
	// scanDefinitions (block-arg defs at 0, ops at 1..N, terminator at N+1).
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")
		var opIdx = 0
		for packed in block.opRefs 'eachOp'
			extractCopyHintsWith(module, packed: packed, blockId: block.id, opPos: opIdx + 1, ranges: ranges, vidToRangeIdx: vidToRangeIdx, opQuery: opQuery)
			opIdx = opIdx + 1
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerm'
			extractCopyHintsWith(module, packed: block.terminatorIndex(), blockId: block.id, opPos: opIdx + 1, ranges: ranges, vidToRangeIdx: vidToRangeIdx, opQuery: opQuery)
		end 'hasTerm'

		// Hint from outgoing branch edge args -> successor block args.
		// The parallel copy for each branch edge executes in the predecessor
		// block (`block`) at the slot immediately before its terminator —
		// see CopyResolution.buildBlockArgCopies. Anchor the CopyEdge there.
		let predBlockLen = block.opRefs.count() + 1
		let copyPos = predBlockLen - 1
		for edge in block.branchEdges 'eachEdge'
			hintBranchArgs(edge.argIds, targetBlockId: edge.targetBlockId, predBlockId: block.id, copyPos: copyPos, ranges: ranges, vidToRangeIdx: vidToRangeIdx, blockIdToRef: blockIdToRef, module: module)
		end 'eachEdge'
	end 'eachBlock'

	// Reverse-direction pass: override the hint on the return value so that
	// the coloring prefers the return register. This only fires for blocks
	// ending in `ret` and only affects the single vreg feeding the final
	// `mov retReg, vreg`. The override wins over whatever forward pass set
	// earlier because for a return value the death-site hint is terminal.
	if returnGprOrd != RM_NONE 'hasReturnReg'
		applyReturnRegHintOverride(module, ranges: ranges, func: func, vidToRangeIdx: vidToRangeIdx, returnGprOrd: returnGprOrd, opQuery: opQuery)
	end 'hasReturnReg'

	// Final pass: fill in ABI-role hints on inlined-continuation phis that
	// still have no hint after everything else. The role is what the
	// post-call capture mov (`mov virtual(resultId), r8`) used to seed
	// before the inliner replaced calls with continuations. We apply it
	// LAST and only when no other pass has hinted the phi (and the
	// phi's copy-link partner has no hint of its own + doesn't cross a
	// call), so a downstream constraint wins over the role default.
	applyContinuationRoleHints(module, ranges: ranges, func: func, vidToRangeIdx: vidToRangeIdx, returnGprOrd: returnGprOrd, errorFlagOrd: errorFlagOrd)
end 'coalesceRanges'

// Walk every block's blockArgs and seed a physical-register hint on each
// arg whose `returnRole` is non-`none`. These args are continuation phis
// the inliner synthesizes when splicing a multi-block callee; before
// inlining, the post-call capture mov (`mov virtual(resultId), r8`)
// provided the R8 hint anchor and the bidirectional copy link in
// setGprCopyHint propagated it to downstream phis. After inlining, no
// such mov exists — this seed restores the anchor.
//
// Only fills in the hint when the phi has none and its copy-link partner
// also has no hint — i.e. no downstream constraint has pinned this phi
// chain to a different register. If downstream pinned the merge phi to
// a callee-saved register (e.g. because the merge result crosses a
// caller's call), let that constraint flow back through the copy-link
// instead of forcing R8/RDX and synthesizing a save-call-return move
// on every success edge.
function applyContinuationRoleHints(module TargetModule, ranges LiveRangeArray, func IrFunction, vidToRangeIdx RegIntArray, returnGprOrd RegOrdinal, errorFlagOrd RegOrdinal)
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")
		for blockArg in block.blockArgs 'eachArg'
			let physOrd = match blockArg.returnRole 'role'
				none gives RM_NONE
				primaryReturn gives returnGprOrd
				errorFlag gives errorFlagOrd
			end 'role'
			maybeSeedRoleHint(physOrd, virtualId: blockArg.valueId, ranges: ranges, vidToRangeIdx: vidToRangeIdx)
		end 'eachArg'
	end 'eachBlock'
end 'applyContinuationRoleHints'

// Set the role-derived phys hint only when no copy-link partner has a
// stronger preference. Skips the seed when:
//   * the partner already has a hint or fixed register of its own —
//     resolveCopyLinkHint will surface it at coloring time; or
//   * the partner crosses a call. The role hint is always a caller-
//     saved register (R8/RDX), and forcing the inlined return value to
//     a caller-saved register when its downstream merge phi must live
//     in a callee-saved register manufactures a forced save-call-
//     return copy on every success edge.
function maybeSeedRoleHint(physOrd RegOrdinal, virtualId RegInt, ranges LiveRangeArray, vidToRangeIdx RegIntArray)
	if virtualId < 0 or physOrd == RM_NONE 'invalid'
		return
	end 'invalid'

	let rangeIdx = getOr(vidToRangeIdx, index: virtualId, fallback: -1)
	if rangeIdx < 0 'noRange'
		return
	end 'noRange'

	var range = try ranges.get(rangeIdx) otherwise panic("invariant: rangeIdx from vidToRangeIdx out of bounds in ranges")
	if range.hint != RM_NONE 'alreadyHinted'
		return
	end 'alreadyHinted'

	if range.copyHintValueId >= 0 'hasPartner'
		let partnerIdx = getOr(vidToRangeIdx, index: range.copyHintValueId, fallback: -1)
		if partnerIdx >= 0 'partnerExists'
			let partner = try ranges.get(partnerIdx) otherwise panic("invariant: partnerIdx from vidToRangeIdx out of bounds in ranges")
			if partner.hint != RM_NONE or partner.fixedReg != RM_NONE 'partnerHinted'
				return
			end 'partnerHinted'
			if partner.crossesCall 'partnerCrossesCall'
				return
			end 'partnerCrossesCall'
		end 'partnerExists'
	end 'hasPartner'

	range.hint = physOrd
end 'maybeSeedRoleHint'

// (destOrd, srcId) describing a `movRegReg` op as decoded by a target-
// specific helper. destOrd is the destination's physical-register ordinal
// (RM_NONE if not physical); srcId is the source's virtual-register id
// (negative if not virtual). A `notFound` value means the op wasn't a mov.
export type ReturnMovProbe
	export var destOrd as RegOrdinal
	export var srcId as RegInt
	export var found as bool

	export static function notFound() returns ReturnMovProbe
		return Self{destOrd: RM_NONE, srcId: -1, found: false}
	end 'notFound'

	export static function ok(destOrd RegOrdinal, srcId RegInt) returns ReturnMovProbe
		return Self{destOrd: destOrd, srcId: srcId, found: true}
	end 'ok'
end 'ReturnMovProbe'

// (destId, srcOrd) describing an entry-block ABI parameter materialization mov
// as decoded by a target-specific helper. ISel emits one
// movRegReg(virtual(destId), physical(srcOrd)) per incoming register argument at
// the top of the entry block, copying the argument register into the param's
// vreg. destId is the destination's virtual-register id; srcOrd is the source's
// physical (argument-register) ordinal. `found` is true ONLY for a genuine GPR
// param mov (virtual dest + physical src); it is false for every other op —
// including FP param movs and stack-param loads. The greedy allocator (GPR-only
// this phase) consumes this to pre-seed the incoming argument registers into its
// register file by scanning the LEADING contiguous run of param movs; a `found`
// of false stops that scan, so a later physical-source mov (e.g. an idiv result
// extraction `mov vQ, rax`, which always follows compute ops) is never seeded,
// and an FP param op falls through to the existing FP-not-supported panic when
// the forward walk reaches it.
export type ParamMovProbe
	export var destId as RegInt
	export var srcOrd as RegOrdinal
	export var found as bool

	export static function notFound() returns ParamMovProbe
		return Self{destId: -1, srcOrd: RM_NONE, found: false}
	end 'notFound'

	export static function gpr(destId RegInt, srcOrd RegOrdinal) returns ParamMovProbe
		return Self{destId: destId, srcOrd: srcOrd, found: true}
	end 'gpr'
end 'ParamMovProbe'

// For each block that ends in a `ret` terminator, walk opRefs in reverse and
// find the first `movRegReg(physical retReg, virtual src)`. Force src's range
// hint to the return register, overriding any earlier forward-pass hint.
//
// The block walk and reverse scan are shared across targets; only the per-op
// decoding (and the matching ret-terminator check) is target-specific. Both
// are dispatched on `module.cpu` per block and op.
function applyReturnRegHintOverride(module TargetModule, ranges LiveRangeArray, func IrFunction, vidToRangeIdx RegIntArray, returnGprOrd RegOrdinal, opQuery TargetOpQuery)
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")

		if not block.hasTerminatorOp() 'noTerm'
			continue
		end 'noTerm'
		if not opQuery.isReturnTerminator(module, packed: block.terminatorIndex()) 'notRet'
			continue
		end 'notRet'

		// Walk opRefs in reverse. The first movRegReg we find is the
		// return-value setup emitted by the target's lowerReturn (which
		// runs immediately before the epilogue+ret pair). Non-mov ops are
		// skipped; the scan stops on the first decoded mov.
		var j = block.opRefs.count() - 1
		while j >= 0 'scanBack'
			let packed = try block.opRefs.get(j) otherwise 'skipBack'
				j = j - 1
				continue
			end 'skipBack'

			let probe = opQuery.decodeReturnMovProbe(module, packed: packed)
			if probe.found 'isMov'
				tryApplyReturnHint(probe.destOrd, srcId: probe.srcId, returnGprOrd: returnGprOrd, ranges: ranges, vidToRangeIdx: vidToRangeIdx)
				break
			end 'isMov'
			j = j - 1
		end 'scanBack'
	end 'eachBlock'
end 'applyReturnRegHintOverride'

// Apply the return-register override if this mov-reg-reg op is the return-
// value setup: movRegReg(physical retReg, virtual src). No-op when the dest
// isn't a physical register, isn't the return register, or src isn't virtual.
function tryApplyReturnHint(destOrd RegOrdinal, srcId RegInt, returnGprOrd RegOrdinal, ranges LiveRangeArray, vidToRangeIdx RegIntArray)
	if destOrd == RM_NONE 'destNotPhys'
		return
	end 'destNotPhys'
	if destOrd != returnGprOrd 'notReturnReg'
		return
	end 'notReturnReg'
	if srcId < 0 'srcNotVirt'
		return
	end 'srcNotVirt'

	setPhysHintForce(returnGprOrd, virtualId: srcId, ranges: ranges, vidToRangeIdx: vidToRangeIdx)
end 'tryApplyReturnHint'

function extractCopyHintsWith(module TargetModule, packed OpIndex, blockId BlockId, opPos RegInt, ranges LiveRangeArray, vidToRangeIdx RegIntArray, opQuery TargetOpQuery)
	opQuery.extractCopyHints(module, packed: packed, blockId: blockId, opPos: opPos, ranges: ranges, vidToRangeIdx: vidToRangeIdx)
end 'extractCopyHintsWith'

// For each branch arg, set a copy hint between the arg value and the
// corresponding block arg in the target block. The parallel copy for this
// edge executes in the predecessor block at `copyPos`; CopyEdges anchored
// there let isCopyBoundaryOverlap distinguish per-edge interference (Step 7).
function hintBranchArgs(argIds ValueIdArray, targetBlockId BlockId, predBlockId BlockId, copyPos RegInt, ranges LiveRangeArray, vidToRangeIdx RegIntArray, blockIdToRef FuncBlockIdToRefMap, module TargetModule)
	if argIds.count() == 0 'noArgs'
		return
	end 'noArgs'
	let targetBlock = getBlockInFunc(module, blockIdToRef: blockIdToRef, blockId: targetBlockId)
	var i = 0
	while i < argIds.count() 'eachArg'
		let srcId = try argIds.get(i) otherwise 'skipArg'
			i = i + 1
			continue
		end 'skipArg'
		let blockArg = try targetBlock.blockArgs.get(i) otherwise 'skipBlockArg'
			i = i + 1
			continue
		end 'skipBlockArg'
		let destId = blockArg.valueId
		setGprCopyHintEdge(destId, srcReg: srcId, blockId: predBlockId, copyPos: copyPos, ranges: ranges, vidToRangeIdx: vidToRangeIdx)
		i = i + 1
	end 'eachArg'
end 'hintBranchArgs'

// Hint a virtual register to prefer a specific physical register ordinal.
export function setPhysHint(physOrd RegOrdinal, virtualId RegInt, ranges LiveRangeArray, vidToRangeIdx RegIntArray)
	if virtualId < 0 or physOrd == RM_NONE 'invalid'
		return
	end 'invalid'

	let rangeIdx = getOr(vidToRangeIdx, index: virtualId, fallback: -1)
	if rangeIdx < 0 'noRange'
		return
	end 'noRange'

	var range = try ranges.get(rangeIdx) otherwise panic("invariant: rangeIdx from vidToRangeIdx out of bounds in ranges")

	if range.hint == RM_NONE 'noHintYet'
		range.hint = physOrd
	end 'noHintYet'
end 'setPhysHint'

// Like setPhysHint but unconditionally overwrites any existing hint. Used by
// the return-register reverse pass, where the death-site hint is always more
// valuable than a forward-pass birth-site hint.
function setPhysHintForce(physOrd RegOrdinal, virtualId RegInt, ranges LiveRangeArray, vidToRangeIdx RegIntArray)
	if virtualId < 0 or physOrd == RM_NONE 'invalid'
		return
	end 'invalid'

	let rangeIdx = getOr(vidToRangeIdx, index: virtualId, fallback: -1)
	if rangeIdx < 0 'noRange'
		return
	end 'noRange'

	var range = try ranges.get(rangeIdx) otherwise panic("invariant: rangeIdx from vidToRangeIdx out of bounds in ranges")

	range.hint = physOrd
end 'setPhysHintForce'

// Set hint: destination should prefer the same register as source
function setGprCopyHint(destReg RegInt, srcReg RegInt, ranges LiveRangeArray, vidToRangeIdx RegIntArray)
	if destReg < 0 or srcReg < 0 'physical'
		return
	end 'physical'

	let srcRangeIdx = getOr(vidToRangeIdx, index: srcReg, fallback: -1)
	let destRangeIdx = getOr(vidToRangeIdx, index: destReg, fallback: -1)

	if srcRangeIdx < 0 or destRangeIdx < 0 'noRange'
		return
	end 'noRange'

	// Propagate hint: if source already has a hint, pass it to dest
	var srcRange = try ranges.get(srcRangeIdx) otherwise panic("invariant: srcRangeIdx from vidToRangeIdx out of bounds in ranges")
	var destRange = try ranges.get(destRangeIdx) otherwise panic("invariant: destRangeIdx from vidToRangeIdx out of bounds in ranges")

	// Only set hint if dest doesn't already have one
	// Always maintain the bidirectional copy-link, regardless of whether
	// either side already has a phys hint set. The link is what lets
	// `areCopyConnected` suppress interference at the 1-position copy
	// boundary, so dropping it would prevent the two ranges from ever
	// sharing a register even when their hint says they should.
	if destRange.copyHintValueId < 0 'destNoLink'
		destRange.copyHintValueId = srcReg
	end 'destNoLink'
	if srcRange.copyHintValueId < 0 'srcNoLink'
		srcRange.copyHintValueId = destReg
	end 'srcNoLink'

	if destRange.hint == RM_NONE 'destNoHint'
		if srcRange.fixedReg != RM_NONE 'srcFixed'
			// Source is in a fixed physical register — that's where it
			// inevitably lives, so the dest can prefer the same register
			// directly. This is a strong hint we can never improve on.
			destRange.hint = srcRange.fixedReg
		end 'srcFixed'
		// Note: we do NOT forward-propagate `srcRange.hint` here. A
		// soft hint on src may reflect a birth-side preference, while
		// dest may later acquire a stronger death-side preference via
		// applyReturnRegHintOverride. Leave dest unhinted so
		// resolveCopyLinkHint can lazily pull whichever color src
		// settles on at coloring time.
	end 'destNoHint' else 'destHasHint'
		// Reverse-direction propagation: dest is already pinned (e.g. by
		// applyContinuationRoleHints for an inlined-continuation phi, or
		// by an earlier extractCopyHints physical-side anchor). If src
		// has no hint of its own, push dest's into src directly so the
		// inlined body's value computes into the destination register and
		// the edge copy collapses to a no-op identity move.
		if srcRange.hint == RM_NONE and srcRange.fixedReg == RM_NONE 'srcNoHint'
			srcRange.hint = destRange.hint
		end 'srcNoHint'
	end 'destHasHint'
end 'setGprCopyHint'

// Edge-aware variant of setGprCopyHint. Performs the same hint propagation
// and bidirectional copyHintValueId seeding as setGprCopyHint, then also
// records a CopyEdge on both ranges anchored at (blockId, copyPos). The
// CopyEdge entries are what isCopyBoundaryOverlap will consult (in Step 7)
// to decide whether to suppress interference at exactly this copy site,
// replacing the global single-slot copyHintValueId match.
export function setGprCopyHintEdge(destReg RegInt, srcReg RegInt, blockId BlockId, copyPos RegInt, ranges LiveRangeArray, vidToRangeIdx RegIntArray)
	if destReg < 0 or srcReg < 0 'physical'
		return
	end 'physical'

	// Delegate hint/link seeding to setGprCopyHint. The bidirectional
	// copyHintValueId remains useful for resolveCopyLinkHint's color-hint
	// propagation, so we keep that pathway intact and only add the
	// per-edge anchor on top.
	setGprCopyHint(destReg, srcReg: srcReg, ranges: ranges, vidToRangeIdx: vidToRangeIdx)

	let srcRangeIdx = getOr(vidToRangeIdx, index: srcReg, fallback: -1)
	let destRangeIdx = getOr(vidToRangeIdx, index: destReg, fallback: -1)

	if srcRangeIdx < 0 or destRangeIdx < 0 'noRange'
		return
	end 'noRange'

	var srcRange = try ranges.get(srcRangeIdx) otherwise panic("invariant: srcRangeIdx from vidToRangeIdx out of bounds in ranges")
	var destRange = try ranges.get(destRangeIdx) otherwise panic("invariant: destRangeIdx from vidToRangeIdx out of bounds in ranges")

	addCopyEdge(destRange, partner: srcReg, blockId: blockId, copyPos: copyPos)
	addCopyEdge(srcRange, partner: destReg, blockId: blockId, copyPos: copyPos)
end 'setGprCopyHintEdge'

export function setFpCopyHintEdge(destReg RegInt, srcReg RegInt, blockId BlockId, copyPos RegInt, ranges LiveRangeArray, vidToRangeIdx RegIntArray)
	// Same logic as GPR edge-aware copy hint
	setGprCopyHintEdge(destReg, srcReg: srcReg, blockId: blockId, copyPos: copyPos, ranges: ranges, vidToRangeIdx: vidToRangeIdx)
end 'setFpCopyHintEdge'
