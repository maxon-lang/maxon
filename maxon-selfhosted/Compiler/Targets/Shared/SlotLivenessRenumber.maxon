// Target-agnostic slot liveness analysis and renumbering.
//
// After ISel, each backend has assigned stack slots greedily — each new
// slot request bumps a counter and never reuses prior slots, even when
// those slots are dead. Most temps generated inside the OS/stdlib lowering
// helpers die the moment the consuming op is emitted.
//
// This pass walks the lowered op stream, builds per-slot liveness
// intervals (treating slots as pseudo-values), and renumbers slot indices
// via linear-scan coloring so non-overlapping slots share storage.
//
// Slots whose address escapes (`lea`-of-slot constructs) cannot be tracked
// statically past the address-leak, so they're treated as live across the
// whole function and never coalesced.
//
// Runs after MirTo<Target>Conversion, before the SSA register allocator.
// The regalloc's own spill slots (`spillToStack`/`reloadFromStack`) use
// a separate raw-byte-offset namespace and run later, so they don't
// participate in this pass.
//
// Target-specific concerns — projecting an op to its (reads, writes,
// escapes) slot lists, and rewriting an op with a remapped slot index —
// are factored out behind the SlotProjection interface.

// ============================================================
// Target-specific projection interface
// ============================================================

export interface SlotProjection
	// Append all slot indices READ by this op to `reads`.
	function collectReads(module TargetModule, packed OpIndex, reads VarSlotArray)
	// Append all slot indices WRITTEN by this op to `writes`.
	function collectWrites(module TargetModule, packed OpIndex, writes VarSlotArray)
	// Append all slot indices whose ADDRESS is taken by this op to `escapes`.
	function collectEscapes(module TargetModule, packed OpIndex, escapes VarSlotArray)
	// Rewrite the op at `packed` in `module`, replacing every slot index
	// `s` with `remap[s]`. The implementation should mutate module storage
	// in place (e.g. via module.x64Ops.set(packed, ...) or the arm64
	// equivalent).
	function rewriteOp(module TargetModule, packed OpIndex, remap RegIntArray)
end 'SlotProjection'

// ============================================================
// Slot range and helpers
// ============================================================

// A slot's live range, expressed as a list of per-block intervals
// (half-open [startPos, endPos)) using the same op-position scheme as
// LiveRangeBuilder: op at index i has position i+1; live-in covers
// startPos 0, live-out covers endPos = blockLen.
type SlotRange
	export var slotIdx as VarSlot
	export var intervals as IntervalArray
	export var escaped as bool

	export static function create(slotIdx VarSlot) returns SlotRange
		return Self{slotIdx: slotIdx, intervals: IntervalArray.create(), escaped: false}
	end 'create'
end 'SlotRange'

export typealias SlotRangeArray = Array with SlotRange

// ============================================================
// Max slot index
// ============================================================

function findMaxSlotIdx(module TargetModule, func IrFunction, projection SlotProjection) returns VarSlot
	var maxSlot = -1
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")
		for packed in block.opRefs 'eachOp'
			maxSlot = updateMaxSlotForOp(module, packed: packed, projection: projection, maxSlot: maxSlot)
		end 'eachOp'
		if block.hasTerminatorOp() 'hasTerm'
			maxSlot = updateMaxSlotForOp(module, packed: block.terminatorIndex(), projection: projection, maxSlot: maxSlot)
		end 'hasTerm'
	end 'eachBlock'
	return maxSlot + 1
end 'findMaxSlotIdx'

function updateMaxSlotForOp(module TargetModule, packed OpIndex, projection SlotProjection, maxSlot VarSlot) returns VarSlot
	var current = maxSlot

	let reads = VarSlotArray.create()
	projection.collectReads(module, packed: packed, reads: reads)
	current = maxOfVarSlotArray(reads, current: current)

	let writes = VarSlotArray.create()
	projection.collectWrites(module, packed: packed, writes: writes)
	current = maxOfVarSlotArray(writes, current: current)

	let escapes = VarSlotArray.create()
	projection.collectEscapes(module, packed: packed, escapes: escapes)
	current = maxOfVarSlotArray(escapes, current: current)

	return current
end 'updateMaxSlotForOp'

function maxOfVarSlotArray(slots VarSlotArray, current VarSlot) returns VarSlot
	var best = current
	for s in slots 'each'
		if s > best 'higher'
			best = s
		end 'higher'
	end 'each'
	return best
end 'maxOfVarSlotArray'

// ============================================================
// Per-block use/def + escaped-slot scan
// ============================================================

type SlotUseDef
	export var useSets as LiveSetArray
	export var defSets as LiveSetArray
	export var escaped as BoolArray
	export var maxSlotIdx as VarSlot

	export static function create(useSets LiveSetArray, defSets LiveSetArray, escaped BoolArray, maxSlotIdx VarSlot) returns SlotUseDef
		return Self{useSets: useSets, defSets: defSets, escaped: escaped, maxSlotIdx: maxSlotIdx}
	end 'create'
end 'SlotUseDef'

function scanSlotUseDef(module TargetModule, func IrFunction, numBlocks BlockId, maxSlotIdx VarSlot, projection SlotProjection) returns SlotUseDef
	var useSets = LiveSetArray.create()
	var defSets = LiveSetArray.create()
	var bi = 0
	while bi < numBlocks 'init'
		useSets.push(LiveSet.create(maxSlotIdx))
		defSets.push(LiveSet.create(maxSlotIdx))
		bi = bi + 1
	end 'init'

	var escaped = createBoolVector(maxSlotIdx)

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")
		let blockId = block.id
		var useSet = try useSets.get(blockId) otherwise panic("invariant: useSets sized to numBlocks but get({blockId}) failed")
		var defSet = try defSets.get(blockId) otherwise panic("invariant: defSets sized to numBlocks but get({blockId}) failed")

		for packed in block.opRefs 'eachOp'
			scanOpSlots(module, packed: packed, projection: projection, useSet: useSet, defSet: defSet, escaped: escaped)
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerm'
			scanOpSlots(module, packed: block.terminatorIndex(), projection: projection, useSet: useSet, defSet: defSet, escaped: escaped)
		end 'hasTerm'
	end 'eachBlock'

	return SlotUseDef.create(useSets, defSets: defSets, escaped: escaped, maxSlotIdx: maxSlotIdx)
end 'scanSlotUseDef'

function scanOpSlots(module TargetModule, packed OpIndex, projection SlotProjection, useSet LiveSet, defSet LiveSet, escaped BoolArray)
	let reads = VarSlotArray.create()
	projection.collectReads(module, packed: packed, reads: reads)
	for s in reads 'eachR'
		if not defSet.contains(s) 'notDef'
			_ = useSet.add(s)
		end 'notDef'
	end 'eachR'

	let writes = VarSlotArray.create()
	projection.collectWrites(module, packed: packed, writes: writes)
	for s in writes 'eachW'
		_ = defSet.add(s)
	end 'eachW'

	let escapes = VarSlotArray.create()
	projection.collectEscapes(module, packed: packed, escapes: escapes)
	for s in escapes 'eachE'
		try escaped.set(s, value: true) otherwise panic("scanOpSlots: escaped.set({s}) OOB; escaped sized to maxSlotIdx")
	end 'eachE'
end 'scanOpSlots'

// ============================================================
// Liveness fixed point
// ============================================================

function computeSlotLiveness(cfg CfgInfo, rpo RpoInfo, ud SlotUseDef) returns LivenessInfo
	let numBlocks = cfg.numBlocks
	let maxSlotIdx = ud.maxSlotIdx

	var liveIn = LiveSetArray.create()
	var liveOut = LiveSetArray.create()
	var bi = 0
	while bi < numBlocks 'init'
		liveIn.push(LiveSet.create(maxSlotIdx))
		liveOut.push(LiveSet.create(maxSlotIdx))
		bi = bi + 1
	end 'init'

	var changed = true
	while changed 'fp'
		changed = false
		var ri = rpo.order.count() - 1
		while ri >= 0 'eachBlock'
			let blockId = try rpo.order.get(ri) otherwise 'skip'
				ri = ri - 1
				continue
			end 'skip'

			var blockLiveOut = try liveOut.get(blockId) otherwise panic("invariant: liveOut sized to numBlocks but get({blockId}) failed")
			var blockLiveIn = try liveIn.get(blockId) otherwise panic("invariant: liveIn sized to numBlocks but get({blockId}) failed")
			let succs = try cfg.successors.get(blockId) otherwise panic("invariant: cfg.successors sized to numBlocks but get({blockId}) failed")

			for succ in succs 'eachSucc'
				let succLiveIn = try liveIn.get(succ) otherwise panic("invariant: succ id < numBlocks but liveIn.get failed")
				if liveSetUnionInto(blockLiveOut, from: succLiveIn) 'unionChanged'
					changed = true
				end 'unionChanged'
			end 'eachSucc'

			let blockUse = try ud.useSets.get(blockId) otherwise panic("invariant: useSets sized to numBlocks but get({blockId}) failed")
			let blockDef = try ud.defSets.get(blockId) otherwise panic("invariant: defSets sized to numBlocks but get({blockId}) failed")
			if liveSetComputeLiveIn(blockLiveIn, liveOut: blockLiveOut, useSet: blockUse, defSet: blockDef) 'inChanged'
				changed = true
			end 'inChanged'

			ri = ri - 1
		end 'eachBlock'
	end 'fp'

	// Escaped slots are live everywhere — their address may be
	// dereferenced anywhere in the function and we can't track the
	// indirection statically.
	var si = 0
	while si < maxSlotIdx 'eachSlot'
		let isEsc = try ud.escaped.get(si) otherwise panic("computeSlotLiveness: escaped.get({si}) OOB; escaped sized to maxSlotIdx")
		if isEsc 'esc'
			var bi2 = 0
			while bi2 < numBlocks 'eachBlk'
				var inVec = try liveIn.get(bi2) otherwise panic("invariant: liveIn sized to numBlocks but get({bi2}) failed")
				var outVec = try liveOut.get(bi2) otherwise panic("invariant: liveOut sized to numBlocks but get({bi2}) failed")
				_ = inVec.add(si)
				_ = outVec.add(si)
				bi2 = bi2 + 1
			end 'eachBlk'
		end 'esc'
		si = si + 1
	end 'eachSlot'

	return LivenessInfo.create(liveIn, liveOut: liveOut, maxValueId: maxSlotIdx)
end 'computeSlotLiveness'

// ============================================================
// Per-slot interval construction
// ============================================================

function buildSlotRanges(module TargetModule, func IrFunction, liveness LivenessInfo, ud SlotUseDef, projection SlotProjection) returns SlotRangeArray
	let maxSlotIdx = ud.maxSlotIdx
	var ranges = SlotRangeArray.create()

	var s = 0
	while s < maxSlotIdx 'eachSlot'
		var range = SlotRange.create(s)
		range.escaped = try ud.escaped.get(s) otherwise panic("buildSlotRanges: escaped.get({s}) OOB; escaped sized to maxSlotIdx")
		ranges.push(range)
		s = s + 1
	end 'eachSlot'

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")
		let blockId = block.id
		let blockLen = block.opRefs.count() + 1  // +1 for terminator slot
		let blockLiveIn = try liveness.liveIn.get(blockId) otherwise panic("invariant: liveIn sized to numBlocks but get({blockId}) failed")
		let blockLiveOut = try liveness.liveOut.get(blockId) otherwise panic("invariant: liveOut sized to numBlocks but get({blockId}) failed")

		var firstWrite = RegIntArray.create()
		var lastUse = RegIntArray.create()
		var si = 0
		while si < maxSlotIdx 'initPerSlot'
			firstWrite.push(-1)
			lastUse.push(-1)
			si = si + 1
		end 'initPerSlot'

		var opIdx = 0
		for packed in block.opRefs 'eachOp'
			recordBlockSlotPositions(module, packed: packed, projection: projection, opPos: opIdx + 1, firstWrite: firstWrite, lastUse: lastUse)
			opIdx = opIdx + 1
		end 'eachOp'
		if block.hasTerminatorOp() 'hasTerm'
			recordBlockSlotPositions(module, packed: block.terminatorIndex(), projection: projection, opPos: opIdx + 1, firstWrite: firstWrite, lastUse: lastUse)
		end 'hasTerm'

		var t = 0
		while t < maxSlotIdx 'buildPerSlot'
			let liveIn = blockLiveIn.contains(t)
			let liveOut = blockLiveOut.contains(t)
			let fw = try firstWrite.get(t) otherwise panic("invariant: firstWrite sized to maxSlotIdx but get({t}) failed")
			let lu = try lastUse.get(t) otherwise panic("invariant: lastUse sized to maxSlotIdx but get({t}) failed")

			let hasLocalActivity = fw >= 0 or lu >= 0

			if not liveIn and not liveOut and not hasLocalActivity 'noActivity'
				t = t + 1
				continue
			end 'noActivity'

			var startPos = 0
			if liveIn 'liveInStart'
				startPos = 0
			end 'liveInStart' else 'startFromDef'
				if fw >= 0 'fromFw'
					startPos = fw
				end 'fromFw' else 'fromLuOnly'
					startPos = lu
				end 'fromLuOnly'
			end 'startFromDef'

			var endPos = blockLen
			if liveOut 'liveOutEnd'
				endPos = blockLen
			end 'liveOutEnd' else 'endFromUse'
				if lu >= 0 'fromLu'
					endPos = lu + 1
				end 'fromLu' else 'fromStartOnly'
					endPos = startPos + 1
				end 'fromStartOnly'
			end 'endFromUse'

			pushInterval(ranges, slotIdx: t, blockId: blockId, startPos: startPos, endPos: endPos)
			t = t + 1
		end 'buildPerSlot'
	end 'eachBlock'

	return ranges
end 'buildSlotRanges'

function pushInterval(ranges SlotRangeArray, slotIdx VarSlot, blockId BlockId, startPos RegInt, endPos RegInt)
	var range = try ranges.get(slotIdx) otherwise panic("invariant: ranges.get OOB in pushInterval")
	range.intervals.push(Interval.create(blockId, startPos: startPos, endPos: endPos))
end 'pushInterval'

function recordBlockSlotPositions(module TargetModule, packed OpIndex, projection SlotProjection, opPos RegInt, firstWrite RegIntArray, lastUse RegIntArray)
	let reads = VarSlotArray.create()
	projection.collectReads(module, packed: packed, reads: reads)
	for s in reads 'eachR'
		if s < lastUse.count() 'inBounds'
			try lastUse.set(s, value: opPos) otherwise panic("invariant: lastUse.set OOB")
		end 'inBounds'
	end 'eachR'

	let writes = VarSlotArray.create()
	projection.collectWrites(module, packed: packed, writes: writes)
	for s in writes 'eachW'
		if s < firstWrite.count() 'inBoundsFw'
			let existing = try firstWrite.get(s) otherwise panic("invariant: firstWrite.get OOB after bounds check")
			if existing < 0 'firstSeen'
				try firstWrite.set(s, value: opPos) otherwise panic("invariant: firstWrite.set OOB")
			end 'firstSeen'
		end 'inBoundsFw'
		if s < lastUse.count() 'inBoundsLu'
			try lastUse.set(s, value: opPos) otherwise panic("invariant: lastUse.set OOB")
		end 'inBoundsLu'
	end 'eachW'
end 'recordBlockSlotPositions'

// ============================================================
// Interference + coloring
// ============================================================

// Per-slot interference graph: `neighbors[slotIdx]` is the dedup'd list of
// slot indices whose live ranges overlap slot `slotIdx` (same-block half-open
// overlap, exactly the relation the former `slotRangesInterfere` computed).
// Built once via a per-block active-set sweep — O(Σ_block (intervals + edges))
// instead of the O(slots²) pairwise occupant scan the coloring used before.
export typealias SlotIntArrayArray = Array with RegIntArray

type SlotInterferenceGraph
	export var neighbors as SlotIntArrayArray

	export static function create(maxSlotIdx VarSlot) returns SlotInterferenceGraph
		var nbrs = SlotIntArrayArray.create()
		var i = 0
		while i < maxSlotIdx 'init'
			nbrs.push(RegIntArray.create())
			i = i + 1
		end 'init'
		return Self{neighbors: nbrs}
	end 'create'
end 'SlotInterferenceGraph'

// Add the symmetric edge a <-> b, deduplicating against `a`'s neighbor set in
// O(1) via the caller-owned `adjStamp` epoch scratch (instead of an O(degree)
// membership scan of nbrsA).
//
// The caller seeds `adjStamp[n] = epoch` for every existing neighbor `n` of `a`
// ONCE per emit batch (one arrival in the sweep), then calls this for each
// candidate `b` with that same `epoch`. A `b` already adjacent to `a` — whether
// from this batch or a prior block/interval — carries the current `epoch` and
// is rejected here; a fresh `b` is appended to both lists and its stamp updated
// so a repeated `b` in the same batch is also caught.
//
// Why this matters: in a high-spill function (e.g. the test-runner functions
// with >1000 coalescing slots all live across one dense region) the old
// O(degree) dedup scan made the whole build O(slots³) — the self-compile wall.
// The epoch-stamped dedup drops it to O(Σ neighbors + Σ active-set sizes).
function addSlotInterference(ig SlotInterferenceGraph, a VarSlot, b VarSlot, adjStamp RegIntArray, epoch RegInt)
	let bStamp = try adjStamp.get(b) otherwise panic("addSlotInterference: b={b} OOB in adjStamp (sized to maxSlotIdx)")
	if bStamp == epoch 'already'
		return
	end 'already'
	try adjStamp.set(b, value: epoch) otherwise panic("addSlotInterference: adjStamp.set({b}) OOB")

	var nbrsA = try ig.neighbors.get(a) otherwise panic("addSlotInterference: a={a} OOB in neighbors (sized to maxSlotIdx)")
	var nbrsB = try ig.neighbors.get(b) otherwise panic("addSlotInterference: b={b} OOB in neighbors (sized to maxSlotIdx)")
	nbrsA.push(b)
	nbrsB.push(a)
end 'addSlotInterference'

// Build the slot interference graph via a per-block active-set sweep over slot
// intervals. For each block we collect its (slotIdx, startPos, endPos) triples,
// sort them by startPos, then sweep: on each arrival retire active entries that
// ended at or before the new start (half-open: an entry ending at endPos shares
// no position with one starting at endPos, matching `startA < endB and
// startB < endA`), then emit an interference edge against every survivor (they
// overlap the arrival by construction), then add the arrival to the active set.
// Two slots end up adjacent iff some pair of their intervals overlaps in the
// same block — exactly the old `slotRangesInterfere`.
function buildSlotInterferenceGraph(ranges SlotRangeArray, maxSlotIdx VarSlot) returns SlotInterferenceGraph
	var ig = SlotInterferenceGraph.create(maxSlotIdx)

	var maxBlockId = 0
	var s = 0
	while s < maxSlotIdx 'findMaxBlock'
		let range = try ranges.get(s) otherwise panic("buildSlotInterferenceGraph: ranges.get({s}) OOB (sized to maxSlotIdx)")
		let intervals = range.intervals
		let n = intervals.count()
		var k = 0
		while k < n 'eachInterval'
			let iv = try intervals.get(k) otherwise panic("buildSlotInterferenceGraph: intervals.get({k}) OOB")
			if iv.blockId > maxBlockId 'higher'
				maxBlockId = iv.blockId
			end 'higher'
			k = k + 1
		end 'eachInterval'
		s = s + 1
	end 'findMaxBlock'

	let numBlocks = maxBlockId + 1

	// Parallel per-block triples: slot index, interval start, interval end.
	var blockSlots = SlotIntArrayArray.create()
	var blockStarts = SlotIntArrayArray.create()
	var blockEnds = SlotIntArrayArray.create()
	var bi = 0
	while bi < numBlocks 'initBlockMaps'
		blockSlots.push(RegIntArray.create())
		blockStarts.push(RegIntArray.create())
		blockEnds.push(RegIntArray.create())
		bi = bi + 1
	end 'initBlockMaps'

	var s2 = 0
	while s2 < maxSlotIdx 'populate'
		let range = try ranges.get(s2) otherwise panic("buildSlotInterferenceGraph: ranges.get({s2}) OOB during populate")
		let intervals = range.intervals
		let n = intervals.count()
		var k = 0
		while k < n 'eachInterval2'
			let iv = try intervals.get(k) otherwise panic("buildSlotInterferenceGraph: intervals.get({k}) OOB during populate")
			let bid = iv.blockId
			var bSlots = try blockSlots.get(bid) otherwise panic("invariant: bid < numBlocks but blockSlots.get OOB")
			var bStarts = try blockStarts.get(bid) otherwise panic("invariant: bid < numBlocks but blockStarts.get OOB")
			var bEnds = try blockEnds.get(bid) otherwise panic("invariant: bid < numBlocks but blockEnds.get OOB")
			bSlots.push(s2)
			bStarts.push(iv.startPos)
			bEnds.push(iv.endPos)
			k = k + 1
		end 'eachInterval2'
		s2 = s2 + 1
	end 'populate'

	// O(1)-dedup epoch scratch for addSlotInterference: `adjStamp[slot] == epoch`
	// means `slot` is already a neighbor of the arrival being emitted this batch.
	// One stamp slot per slot index; a monotonically increasing `epoch` per
	// arrival means no per-batch clearing is needed (a stale stamp from an
	// earlier batch never equals the current epoch).
	var adjStamp = RegIntArray.create()
	var stampInit = 0
	while stampInit < maxSlotIdx 'initAdjStamp'
		adjStamp.push(-1)
		stampInit = stampInit + 1
	end 'initAdjStamp'
	var epoch = 0

	var active = RegIntArray.create()
	var blockId = 0
	while blockId < numBlocks 'eachBlock'
		let bSlots = try blockSlots.get(blockId) otherwise panic("invariant: blockSlots sized to numBlocks but get({blockId}) OOB")
		let bStarts = try blockStarts.get(blockId) otherwise panic("invariant: blockStarts sized to numBlocks but get({blockId}) OOB")
		let bEnds = try blockEnds.get(blockId) otherwise panic("invariant: blockEnds sized to numBlocks but get({blockId}) OOB")

		let count = bSlots.count()
		active.clear()

		let order = sortIntervalIndicesByStart(bStarts)

		var oi = 0
		while oi < count 'sweep'
			let idx = try order.get(oi) otherwise panic("buildSlotInterferenceGraph: order.get({oi}) OOB (count={count})")
			let slot1 = try bSlots.get(idx) otherwise panic("buildSlotInterferenceGraph: bSlots.get({idx}) OOB")
			let s1 = try bStarts.get(idx) otherwise panic("buildSlotInterferenceGraph: bStarts.get({idx}) OOB")

			// Retire active entries whose interval ended at or before s1.
			var ai = 0
			while ai < active.count() 'retire'
				let activeIdx = try active.get(ai) otherwise panic("buildSlotInterferenceGraph: active.get({ai}) OOB")
				let activeEnd = try bEnds.get(activeIdx) otherwise panic("buildSlotInterferenceGraph: bEnds.get({activeIdx}) OOB")
				if activeEnd <= s1 'expired'
					// Swap-pop: O(1) removal that doesn't preserve order.
					let lastPos = active.count() - 1
					if ai != lastPos 'notLast'
						let tail = try active.get(lastPos) otherwise panic("buildSlotInterferenceGraph: active.get(lastPos) OOB")
						try active.set(ai, value: tail) otherwise panic("buildSlotInterferenceGraph: active.set OOB during swap-pop")
					end 'notLast'
					try active.pop() otherwise panic("buildSlotInterferenceGraph: active.pop on non-empty set must succeed")
				end 'expired' else 'stillLive'
					ai = ai + 1
				end 'stillLive'
			end 'retire'

			// New epoch for this arrival's emit batch. Seed slot1's existing
			// neighbors (from earlier blocks / earlier intervals) so addSlotInterference
			// dedups against them in O(1). Reseeding once per arrival keeps the
			// build O(Σ neighbors + Σ active-set sizes) instead of O(slots³).
			epoch = epoch + 1
			let priorNbrs = try ig.neighbors.get(slot1) otherwise panic("buildSlotInterferenceGraph: neighbors.get({slot1}) OOB during reseed")
			for n in priorNbrs 'seedStamp'
				try adjStamp.set(n, value: epoch) otherwise panic("buildSlotInterferenceGraph: adjStamp.set({n}) OOB during reseed")
			end 'seedStamp'

			// Every surviving active entry overlaps the arrival.
			var ei = 0
			while ei < active.count() 'emit'
				let activeIdx = try active.get(ei) otherwise panic("buildSlotInterferenceGraph: active.get({ei}) OOB during emit")
				let slot2 = try bSlots.get(activeIdx) otherwise panic("buildSlotInterferenceGraph: bSlots.get({activeIdx}) OOB during emit")
				if slot1 != slot2 'distinctSlots'
					addSlotInterference(ig, a: slot1, b: slot2, adjStamp: adjStamp, epoch: epoch)
				end 'distinctSlots'
				ei = ei + 1
			end 'emit'

			active.push(idx)
			oi = oi + 1
		end 'sweep'

		blockId = blockId + 1
	end 'eachBlock'

	return ig
end 'buildSlotInterferenceGraph'

// Insertion-sort permutation: indices 0..starts.count() sorted by
// starts[idx] ascending. Per-block interval counts are bounded, so insertion
// sort beats a recursive sort once constants fold in, and is trivially stable.
function sortIntervalIndicesByStart(starts RegIntArray) returns RegIntArray
	let count = starts.count()
	var order = RegIntArray.create()
	var i = 0
	while i < count 'init'
		order.push(i)
		i = i + 1
	end 'init'

	var si = 1
	while si < count 'sort'
		let keyIdx = try order.get(si) otherwise panic("sortIntervalIndicesByStart: order.get({si}) OOB (count={count})")
		let keyStart = try starts.get(keyIdx) otherwise panic("sortIntervalIndicesByStart: starts.get({keyIdx}) OOB")

		var j = si - 1
		while j >= 0 'insert'
			let jIdx = try order.get(j) otherwise panic("sortIntervalIndicesByStart: order.get({j}) OOB during insert")
			let jStart = try starts.get(jIdx) otherwise panic("sortIntervalIndicesByStart: starts.get({jIdx}) OOB during insert")
			if jStart <= keyStart 'inPlace'
				break
			end 'inPlace'
			try order.set(j + 1, value: jIdx) otherwise panic("sortIntervalIndicesByStart: order.set OOB during insert")
			j = j - 1
		end 'insert'
		try order.set(j + 1, value: keyIdx) otherwise panic("sortIntervalIndicesByStart: order.set final OOB")
		si = si + 1
	end 'sort'

	return order
end 'sortIntervalIndicesByStart'

function rangeEarliestStart(range SlotRange) returns RegInt
	var best = i64.max
	let intervals = range.intervals
	let n = intervals.count()
	var k = 0
	while k < n 'each'
		let iv = try intervals.get(k) otherwise panic("rangeEarliestStart: intervals.get({k}) OOB")
		if iv.startPos < best 'lower'
			best = iv.startPos
		end 'lower'
		k = k + 1
	end 'each'
	if best == i64.max 'noIntervals'
		return 0
	end 'noIntervals'
	return best
end 'rangeEarliestStart'

// True iff slot `aIdx` sorts strictly before slot `bIdx`: escaped slots first,
// then earliestStart ascending, then slotIdx ascending. `aIdx`/`bIdx` are the
// slot indices stored in `order`, and `order` is built in ascending-slotIdx
// order, so the slotIdx tiebreak reproduces the original positional order. This
// is a TOTAL order (distinct slots compare unequal), so the inline merge sort
// below yields byte-identical output to the former stable insertion sort.
function slotRangeBefore(aIdx VarSlot, bIdx VarSlot, ranges SlotRangeArray, earliestStart RegIntArray) returns bool
	let aRange = try ranges.get(aIdx) otherwise panic("slotRangeBefore: ranges.get({aIdx}) OOB")
	let bRange = try ranges.get(bIdx) otherwise panic("slotRangeBefore: ranges.get({bIdx}) OOB")
	let aEsc = aRange.escaped
	let bEsc = bRange.escaped

	if aEsc != bEsc 'escapedFirst'
		return aEsc
	end 'escapedFirst'

	let aStart = try earliestStart.get(aIdx) otherwise panic("slotRangeBefore: earliestStart.get({aIdx}) OOB")
	let bStart = try earliestStart.get(bIdx) otherwise panic("slotRangeBefore: earliestStart.get({bIdx}) OOB")
	if aStart != bStart 'byStart'
		return aStart < bStart
	end 'byStart'

	return aIdx < bIdx
end 'slotRangeBefore'

// Recursive merge sort of `order[lo..hi)` (slot indices) by `slotRangeBefore`.
// `scratch` is a caller-provided buffer sized to order.count(); each merge
// writes only its own [lo, hi) slice, so the shared buffer is safe under
// depth-first recursion. Mirrors `mergeSortByDomPreorder` in SSAColoring.
function mergeSortSlots(order RegIntArray, lo RegInt, hi RegInt, scratch RegIntArray, ranges SlotRangeArray, earliestStart RegIntArray)
	if hi - lo < 2 'base'
		return
	end 'base'
	let mid = lo + (hi - lo) / 2
	mergeSortSlots(order, lo: lo, hi: mid, scratch: scratch, ranges: ranges, earliestStart: earliestStart)
	mergeSortSlots(order, lo: mid, hi: hi, scratch: scratch, ranges: ranges, earliestStart: earliestStart)

	var i = lo
	var j = mid
	var k = lo
	while i < mid and j < hi 'merge'
		let a = try order.get(i) otherwise panic("mergeSortSlots: order.get({i}) OOB")
		let b = try order.get(j) otherwise panic("mergeSortSlots: order.get({j}) OOB")
		if slotRangeBefore(a, bIdx: b, ranges: ranges, earliestStart: earliestStart) 'takeLeft'
			try scratch.set(k, value: a) otherwise panic("mergeSortSlots: scratch.set OOB")
			i = i + 1
		end 'takeLeft' else 'takeRight'
			try scratch.set(k, value: b) otherwise panic("mergeSortSlots: scratch.set OOB")
			j = j + 1
		end 'takeRight'
		k = k + 1
	end 'merge'
	while i < mid 'drainLeft'
		let a = try order.get(i) otherwise panic("mergeSortSlots: drainLeft.get OOB")
		try scratch.set(k, value: a) otherwise panic("mergeSortSlots: drainLeft.set OOB")
		i = i + 1
		k = k + 1
	end 'drainLeft'
	while j < hi 'drainRight'
		let b = try order.get(j) otherwise panic("mergeSortSlots: drainRight.get OOB")
		try scratch.set(k, value: b) otherwise panic("mergeSortSlots: drainRight.set OOB")
		j = j + 1
		k = k + 1
	end 'drainRight'
	var m = lo
	while m < hi 'copyBack'
		let v = try scratch.get(m) otherwise panic("mergeSortSlots: copyBack.get OOB")
		try order.set(m, value: v) otherwise panic("mergeSortSlots: copyBack.set OOB")
		m = m + 1
	end 'copyBack'
end 'mergeSortSlots'

// Linear-scan color slot ranges. Returns (remap, newSlotCount):
//   remap[oldSlot] = newSlot, or -1 for slots with no intervals.
// Escaped slots are colored first, each into its own color, so they never
// share storage with anything else.
//
// Coloring is driven by a precomputed slot interference graph (per-block
// active-set sweep) rather than a per-color occupant scan: for each slot we
// pick the lowest color index not held by any already-colored interfering
// neighbor. This is provably identical to a first-fit over a color pool — a
// color is reusable iff none of its occupants interfere, iff no interfering
// neighbor already holds it — but runs in O(Σ neighbors) instead of
// O(slots² × intervals).
function colorSlots(ranges SlotRangeArray, maxSlotIdx VarSlot) returns (RegIntArray, VarSlot)
	var remap = RegIntArray.create()
	var i = 0
	while i < maxSlotIdx 'init'
		remap.push(-1)
		i = i + 1
	end 'init'

	// Build the work list AND cache each slot's earliest-start once (indexed by
	// slotIdx). The merge sort below compares earliest-starts O(slots log slots)
	// times; recomputing `rangeEarliestStart` (an O(intervals) scan) per
	// comparison would be an O(slots log slots × intervals) hot spot.
	var order = RegIntArray.create()
	var earliestStart = RegIntArray.create()
	var s = 0
	while s < maxSlotIdx 'initOrder'
		earliestStart.push(0)
		let r = try ranges.get(s) otherwise panic("invariant: ranges sized to maxSlotIdx but get({s}) failed")
		if r.intervals.count() > 0 or r.escaped 'live'
			order.push(s)
			try earliestStart.set(s, value: rangeEarliestStart(r)) otherwise panic("invariant: earliestStart.set({s}) OOB")
		end 'live'
		s = s + 1
	end 'initOrder'

	// Stable O(n log n) sort by (escaped first, then earliestStart ascending,
	// slotIdx tiebreak) — replaces the former O(slots²) insertion sort, same order.
	let count = order.count()
	if count > 1 'doSort'
		var scratch = RegIntArray.create()
		var sc = 0
		while sc < count 'initScratch'
			scratch.push(0)
			sc = sc + 1
		end 'initScratch'
		mergeSortSlots(order, lo: 0, hi: count, scratch: scratch, ranges: ranges, earliestStart: earliestStart)
	end 'doSort'

	let ig = buildSlotInterferenceGraph(ranges, maxSlotIdx: maxSlotIdx)

	// `forbidden[color]` is stamped with the current slot's `epoch` while
	// scanning its colored neighbors, so the lowest unstamped color is the
	// first-fit choice — no per-color clearing needed across slots.
	var forbidden = RegIntArray.create()
	var fi = 0
	while fi < count 'initForbidden'
		forbidden.push(-1)
		fi = fi + 1
	end 'initForbidden'

	var nextColor = 0
	var oi = 0
	while oi < count 'assign'
		let slotIdx = try order.get(oi) otherwise panic("invariant: order.get OOB during assign")
		let range = try ranges.get(slotIdx) otherwise panic("invariant: ranges.get OOB during assign")

		var chosenColor = -1

		if not range.escaped 'tryReuse'
			// Mark every color held by an already-colored interfering neighbor as
			// forbidden, then take the lowest color not forbidden at this epoch.
			let nbrs = try ig.neighbors.get(slotIdx) otherwise panic("invariant: ig.neighbors.get({slotIdx}) OOB")
			let epoch = oi
			for nbrIdx in nbrs 'eachNbr'
				let nbrColor = try remap.get(nbrIdx) otherwise panic("invariant: remap.get({nbrIdx}) OOB for neighbor")
				if nbrColor >= 0 'colored'
					try forbidden.set(nbrColor, value: epoch) otherwise panic("invariant: forbidden.set({nbrColor}) OOB; forbidden sized to count() >= nextColor")
				end 'colored'
			end 'eachNbr'

			var c = 0
			while c < nextColor 'firstFit'
				let stamp = try forbidden.get(c) otherwise panic("invariant: forbidden.get({c}) OOB during first-fit")
				if stamp != epoch 'free'
					chosenColor = c
					break
				end 'free'
				c = c + 1
			end 'firstFit'
		end 'tryReuse'

		if chosenColor < 0 'newColor'
			chosenColor = nextColor
			nextColor = nextColor + 1
		end 'newColor'

		try remap.set(slotIdx, value: chosenColor) otherwise panic("invariant: remap.set OOB")
		oi = oi + 1
	end 'assign'

	return (remap, nextColor)
end 'colorSlots'

function anyEscaped(escaped BoolArray, maxSlotIdx VarSlot) returns bool
	var i = 0
	while i < maxSlotIdx 'each'
		let isEsc = try escaped.get(i) otherwise panic("anyEscaped: escaped.get({i}) OOB; escaped sized to maxSlotIdx")
		if isEsc 'esc'
			return true
		end 'esc'
		i = i + 1
	end 'each'
	return false
end 'anyEscaped'

// ============================================================
// Public entry point
// ============================================================

// Caller-supplied CFG/RPO. We accept these instead of computing them inside
// so the shared body doesn't need a TargetOpQuery type parameter, which
// previously caused a duplicate-monomorphization crash in the bootstrap
// compiler when both the regalloc and this pass specialized
// `buildIrFunctionCfg` for the same target.
export function renumberSlotsForFunction(module TargetModule, func IrFunction, cfg CfgInfo, rpo RpoInfo, projection SlotProjection)
	let maxSlotIdx = findMaxSlotIdx(module, func: func, projection: projection)
	if maxSlotIdx == 0 'noSlots'
		// No slot-bearing ops — nothing to do, but still pin varSlotCount to 0.
		func.stackSize = func.stackSize - func.varSlotCount * 8
		func.varSlotCount = 0
		return
	end 'noSlots'

	let ud = scanSlotUseDef(module, func: func, numBlocks: cfg.numBlocks, maxSlotIdx: maxSlotIdx, projection: projection)

	// Bail out of any function whose slots are escaped via address-taking
	// (e.g. `lea reg, [rbp - N]`). Escapes are emitted by stdlib lowering
	// helpers that treat a contiguous BLOCK of slots as a scratch buffer
	// addressed by pointer arithmetic against one canonical slot's address
	// — see `mrt_i64_to_string`'s 20-byte stack buffer at `[rbp-0x18 .. rbp-0x4]`.
	// Slot liveness alone doesn't reason about adjacent-slot buffer use,
	// so coalescing here is unsafe for those functions.
	if anyEscaped(ud.escaped, maxSlotIdx: maxSlotIdx) 'escapesPresent'
		logDebug(LogCategory.ir, message: function() gives "slot-renumber: skip func={func.name} reason=escapes")
		return
	end 'escapesPresent'

	let liveness = computeSlotLiveness(cfg, rpo: rpo, ud: ud)
	let ranges = buildSlotRanges(module, func: func, liveness: liveness, ud: ud, projection: projection)
	let (remap, newSlotCount) = colorSlots(ranges, maxSlotIdx: maxSlotIdx)

	for blockRef in func.blockRefs 'rewriteBlocks'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")
		for packed in block.opRefs 'rewriteOps'
			projection.rewriteOp(module, packed: packed, remap: remap)
		end 'rewriteOps'
		if block.hasTerminatorOp() 'rewriteTerm'
			projection.rewriteOp(module, packed: block.terminatorIndex(), remap: remap)
		end 'rewriteTerm'
	end 'rewriteBlocks'

	let oldVarBytes = func.varSlotCount * 8
	let newVarBytes = newSlotCount * 8
	func.stackSize = func.stackSize - oldVarBytes + newVarBytes
	func.varSlotCount = newSlotCount

	logDebug(LogCategory.ir, message: function() gives "slot-renumber: func={func.name} oldSlots={maxSlotIdx} newSlots={newSlotCount}")
end 'renumberSlotsForFunction'
