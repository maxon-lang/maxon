// MIR-phase helpers for target lowering.
// These take MirModule / IrFunction / IrBlock. Target-phase helpers
// (computeStackSizeForFunc, scanPromotedParams, etc.) live in
// TargetOpHelpers.maxon on TargetModule.

export typealias SlotIndex = int(i64.min to i64.max)

enum NotComparison implements Error
	notComparison
end 'NotComparison'

export enum JumpKind
	eq
	ne
	lt
	le
	gt
	ge
	ugt
	feq
	fne
	flt
	fle
	fgt
	fge
	boolTest
end 'JumpKind'

// Value location tracking for SSA-based register management.
// Maps ValueId -> VarSlot so binary ops can load operands from the right slots.
export typealias ValueSlotMap = Array with VarSlot

let VALUE_SLOT_NONE = i64.max

export function valueSlotMapHas(m ValueSlotMap, valueId ValueId) returns bool
	// Map grows lazily — an OOB index just means "no entry for valueId yet".
	let slot = try m.get(valueId) otherwise VALUE_SLOT_NONE
	return slot != VALUE_SLOT_NONE
end 'valueSlotMapHas'

export function valueSlotMapGet(m ValueSlotMap, valueId ValueId) returns VarSlot
	return try m.get(valueId) otherwise panic("valueSlotMapGet: no slot for ValueId {valueId}")
end 'valueSlotMapGet'

export function valueSlotMapSet(m ValueSlotMap, valueId ValueId, slot VarSlot)
	while m.count() <= valueId 'grow'
		m.push(VALUE_SLOT_NONE)
	end 'grow'
	try m.set(valueId, value: slot) otherwise panic("invariant: m.set OOB")
end 'valueSlotMapSet'

function maxOf(a SlotIndex, b SlotIndex) returns SlotIndex
	if a > b 'aGreater'
		return a
	end 'aGreater'
	return b
end 'maxOf'

// Mutating-method self-assignment helper, shared by every target's call
// lowering. The parser desugars `arr = arr.push(...)` (and similar mutating
// methods on void-returning callees) into a MIR call whose RHS is a
// void-returning method: the MIR carries `%R = mir.call @void_fn(%recv, ...)`
// where `R` has no defining op in the lowered backend because void calls
// leave nothing in the return register. Downstream consumers still read `R`
// as the new (mutated) receiver, so each target emits a synthetic
// `mov virtual(R), virtual(receiver)` after the call.
//
// The alias is only emitted when `R` actually has readers (`resultUsed`,
// from the function's MIR use counts). Most void-call result ids are dead
// defs — LowerMaxonToStd's voidChainAlias renames chained uses to the
// receiver's ValueId up front — and materializing a dead post-call read of
// the receiver extends the receiver's live range ACROSS the call. That
// flips the range to crossesCall, which bans caller-saved registers and
// discards the arg-register copy hint, so e.g. a panic-message `lea` ends
// up staged through a callee-saved register (`lea rbx` + `mov rcx, rbx`)
// instead of targeting the arg register directly.
//
// Returns the receiver value-id when an alias should be emitted. Throws
// `VoidResultAliasNotApplicable.notApplicable` when no alias is needed:
// resultId is the tailCall sentinel (0), resultId has no uses, or the
// call has no arguments to use as the receiver. Callers `try ... otherwise
// return` to short-circuit, then issue their target-specific mov.
export enum VoidResultAliasNotApplicable implements Error
	notApplicable
end 'VoidResultAliasNotApplicable'

export function voidResultAliasReceiverId(resultId ValueId, argIds ValueIdArray, resultUsed bool) returns ValueId throws VoidResultAliasNotApplicable
	if resultId == 0 'noResult'
		throw VoidResultAliasNotApplicable.notApplicable
	end 'noResult'
	if not resultUsed 'deadResult'
		throw VoidResultAliasNotApplicable.notApplicable
	end 'deadResult'
	if argIds.count() == 0 'noArgs'
		throw VoidResultAliasNotApplicable.notApplicable
	end 'noArgs'
	return try argIds.get(0) otherwise panic("voidResultAliasReceiverId: argIds.count() > 0 just checked but get(0) failed")
end 'voidResultAliasReceiverId'

// ============================================================
// Jump kind determination (MIR phase, reads block ops backward)
// ============================================================

// Scan backward within a block's ops to find the comparison that produced the condition.
function determineJumpKindInBlock(module MirModule, block IrBlock) returns JumpKind
	return determineJumpKindForCond(module, block: block, condId: -1)
end 'determineJumpKindInBlock'

// Determine the jump kind, optionally verifying the comparison defines condId.
// If condId >= 0, the fused comparison jumpKind is returned ONLY when the last
// comparison before the branch (first found scanning back — intervening
// cset/mov/orr leave the flags from that compare intact) is the op that produced
// condId. If condId came from a later combinator instead (e.g. an or-pattern's
// `(x==a) | (x==b) | (x==c)`), the stale compare flags do NOT reflect condId, so
// a fused flags-branch would test the wrong thing — fall back to boolTest, which
// emits an explicit `cmp condId, #0`. On x64 the combining `or` sets ZF so the
// fused branch is correct there; arm64's `orr` leaves NZCV untouched, which is
// why the pinned-condId form is needed for the arm64 lowering.
// If condId < 0, the first comparison found (scanning backward) is used.
export function determineJumpKindForCond(module MirModule, block IrBlock, condId ValueId) returns JumpKind
	var j = block.opRefs.count() - 1
	while j >= 0 'scanBack'
		let opIdx = try block.opRefs.get(j) otherwise 'skipBack'
			j = j - 1
			continue
		end 'skipBack'
		let kind = try getJumpKindFromMirOpIdx(module, opIdx: opIdx) otherwise 'notCmp'
			j = j - 1
			continue
		end 'notCmp'
		// This is the last flag-setting comparison before the branch. When condId
		// is pinned, the fused branch is valid only if THIS compare produced it;
		// otherwise the live flags belong to a different value -> boolTest.
		if condId >= 0 'checkResultId'
			let defId = try getCmpResultIdFromOpIdx(module, opIdx: opIdx) otherwise return JumpKind.boolTest
			if defId != condId 'wrongCmp'
				return JumpKind.boolTest
			end 'wrongCmp'
		end 'checkResultId'
		return kind
	end 'scanBack'
	return JumpKind.boolTest
end 'determineJumpKindForCond'

// Extract the result value ID from a comparison op looked up by OpIndex.
function getCmpResultIdFromOpIdx(module MirModule, opIdx OpIndex) returns ValueId throws NotComparison
	let mirOp = try module.ops.get(opIdx) otherwise throw NotComparison.notComparison
	return try getMirCmpResultId(mirOp)
end 'getCmpResultIdFromOpIdx'

function getMirCmpResultId(op MirOp) returns ValueId throws NotComparison
	return match op 'check'
		cmp(resultId, _, _, _) gives resultId
		default throws NotComparison.notComparison
	end 'check'
end 'getMirCmpResultId'

function getJumpKindFromMirOpIdx(module MirModule, opIdx OpIndex) returns JumpKind throws NotComparison
	let mirOp = try module.ops.get(opIdx) otherwise throw NotComparison.notComparison
	return try getJumpKindFromMir(mirOp)
end 'getJumpKindFromMirOpIdx'

function getJumpKindFromMir(op MirOp) returns JumpKind throws NotComparison
	return match op 'check'
		cmp(_, _, _, predicate) gives mirPredicateToJumpKind(predicate)
		default throws NotComparison.notComparison
	end 'check'
end 'getJumpKindFromMir'

export function mirPredicateToJumpKind(predicate MirCmpPredicate) returns JumpKind
	return match predicate 'map'
		eq gives JumpKind.eq
		ne gives JumpKind.ne
		lt gives JumpKind.lt
		le gives JumpKind.le
		gt gives JumpKind.gt
		ge gives JumpKind.ge
		ugt gives JumpKind.ugt
		feq gives JumpKind.feq
		fne gives JumpKind.fne
		flt gives JumpKind.flt
		fle gives JumpKind.fle
		fgt gives JumpKind.fgt
		fge gives JumpKind.fge
	end 'map'
end 'mirPredicateToJumpKind'

// ============================================================
// Param slot calculation (pure; no module needed)
// ============================================================

// Sentinel valueIds for params: slot N uses sentinel PARAM_SENTINEL_BASE + N.
// Body SSA valueIds are small (typically < 100), so 1000000+ won't conflict.
let PARAM_SENTINEL_BASE = 1000000

function paramSentinel(slotIdx VarSlot) returns RegInt
	return PARAM_SENTINEL_BASE + slotIdx
end 'paramSentinel'

// Compute the GPR or FP calling convention slot index for a parameter.
// Counts how many preceding parameters share the same type domain.
export function computeParamSlotIndex(paramIndex VarSlot, paramTypes StdTypeArray) returns VarSlot
	var slotIdx = 0
	let targetType = try paramTypes.get(paramIndex) otherwise panic("unreachable: param index out of bounds")
	let targetIsFloat = stdTypeIsFloat(targetType)
	var i = 0
	while i < paramIndex 'countPreceding'
		let pt = try paramTypes.get(i) otherwise panic("unreachable: param index out of bounds")
		if stdTypeIsFloat(pt) == targetIsFloat 'sameClass'
			slotIdx = slotIdx + 1
		end 'sameClass'
		i = i + 1
	end 'countPreceding'
	return slotIdx
end 'computeParamSlotIndex'

// Compute the overflow-arg index — the 0-based position of `paramIndex` among
// only the stack-passed (register-overflowing) params. The caller-side packing
// (`emitDirectCall`/`emitArm64DirectCall`) and the callee-side param lowering
// both consult this so their slot assignments agree. `gprRegCount` / `fpRegCount`
// are the per-domain register-file sizes (x64: 7/8, arm64: 8/8). Counts how many
// preceding params overflowed before this one. Panics if the param itself fits
// in a register — callers must check before calling.
export function computeOverflowArgIndex(paramIndex VarSlot, paramTypes StdTypeArray, gprRegCount VarSlot, fpRegCount VarSlot) returns VarSlot
	var overflowIdx = 0
	var gprIdx = 0
	var fpIdx = 0
	var i = 0
	while i <= paramIndex 'walk'
		let pt = try paramTypes.get(i) otherwise panic("unreachable: param index out of bounds")
		let isFloat = stdTypeIsFloat(pt)
		var fitsInReg = false
		if isFloat 'isFp'
			if fpIdx < fpRegCount 'fpFits'
				fpIdx = fpIdx + 1
				fitsInReg = true
			end 'fpFits'
		end 'isFp' else 'isGpr'
			if gprIdx < gprRegCount 'gprFits'
				gprIdx = gprIdx + 1
				fitsInReg = true
			end 'gprFits'
		end 'isGpr'
		if not fitsInReg 'overflowSlot'
			if i == paramIndex 'thisParam'
				return overflowIdx
			end 'thisParam'
			overflowIdx = overflowIdx + 1
		end 'overflowSlot'
		i = i + 1
	end 'walk'
	panic("computeOverflowArgIndex: paramIndex {paramIndex} fits in a register; caller must check before calling")
end 'computeOverflowArgIndex'

// Compute the `[rbp + offset]` byte offset for an overflow stack param on x64.
// The caller has already determined that this param doesn't fit in the
// per-domain register file. The X64 stack-arg base offset (0x10 = saved RBP +
// return address) plus the overflow index scaled by 8.
export function computeOverflowStackOffset(paramIndex VarSlot, paramTypes StdTypeArray) returns StackSize
	let baseOffset = 0x10 as StackSize
	let overflowIdx = computeOverflowArgIndex(paramIndex, paramTypes: paramTypes, gprRegCount: 7, fpRegCount: 8)
	return baseOffset + overflowIdx * 8
end 'computeOverflowStackOffset'

// Look up a callee's parameter types from the MIR-phase function list,
// falling back to the pre-compiled stdlib function list.
// Bridge a call-site callee name against a function's stored name. Exact match
// wins; otherwise a bare runtime callee (e.g. `__mm_alloc` written in runtime.std)
// also matches the `stdlib.`-qualified Internals definition (`stdlib.__mm_alloc`).
// Runtime helpers (runtime.std, parsed as Std-IR) reference Internals helpers by
// bare name because Std-IR call syntax has no namespace form; the Internals bodies
// carry a `stdlib.` prefix from Maxon-phase qualification. The linker resolves the
// two by the bare symbol, but pre-link backend param/return type lookups need this
// bridge to find the qualified definition.
function calleeNameMatches(funcName String, callee String) returns bool
	if funcName == callee 'exact'
		return true
	end 'exact'
	// Bare callee (runtime.std) -> `stdlib.`-qualified def (Internals).
	if funcName.startsWith("stdlib.") and not callee.startsWith("stdlib.") 'qualifiedDef'
		return funcName == "stdlib.{callee}"
	end 'qualifiedDef'
	// `stdlib.`-qualified callee (a Maxon-phase-qualified call to a helper now
	// defined bare in runtime.std, e.g. `stdlib.__slab_alloc` -> `__slab_alloc`).
	if callee.startsWith("stdlib.") and not funcName.startsWith("stdlib.") 'bareDef'
		return callee == "stdlib.{funcName}"
	end 'bareDef'
	return false
end 'calleeNameMatches'

enum FuncSignatureLookupError implements Error
	notRegistered
end 'FuncSignatureLookupError'

// The two fields a backend type lookup needs off a function definition,
// returned by `findCalleeSignature` so the two-pass search order lives in one
// place regardless of whether the hit came from an `IrFunction` or an
// `ObjectFunction` (which have distinct types but the same three fields).
type CalleeSignature
	export var paramTypes as StdTypeArray
	export var returnType as StdReturnType

	export static function create(paramTypes StdTypeArray, returnType StdReturnType) returns CalleeSignature
		return Self{paramTypes: paramTypes, returnType: returnType}
	end 'create'
end 'CalleeSignature'

// Exact-name → signature map for `findCalleeSignature`'s O(1) fast path. Built
// once per backend lowering by `buildCalleeSigMap`.
export typealias CalleeSigMap = Map with (String, CalleeSignature)

// Build the exact-name → signature map. `allFunctions` (the MIR-phase list) are
// inserted first and win on a name clash; each `stdlibFunctions` entry is added
// only when its name isn't already mapped — matching `findCalleeSignature`'s
// prior pass-1 order (search allFunctions exact, then stdlibFunctions exact),
// and "first occurrence wins" within each list. Built ONCE per backend lowering:
// the prior per-call linear scan over BOTH lists made call emission
// O(calls × functions), the dominant backend cost at self-host scale.
export function buildCalleeSigMap(allFunctions IrFunctionArray, stdlibFunctions ObjectFunctionArray) returns CalleeSigMap
	var sigMap = CalleeSigMap.create()
	for func in allFunctions 'eachAll'
		if not sigMap.contains(func.name) 'absentAll'
			sigMap.upsert(func.name, value: CalleeSignature.create(func.paramTypes, returnType: func.returnType))
		end 'absentAll'
	end 'eachAll'
	for func in stdlibFunctions 'eachStd'
		if not sigMap.contains(func.name) 'absentStd'
			sigMap.upsert(func.name, value: CalleeSignature.create(func.paramTypes, returnType: func.returnType))
		end 'absentStd'
	end 'eachStd'
	return sigMap
end 'buildCalleeSigMap'

// Locate `callee`'s signature. Pass 1 is an O(1) exact-name match via the
// prebuilt `sigMap` (allFunctions take precedence over stdlibFunctions on a name
// clash — a bare runtime symbol defined bare, e.g. runtime.std's sharded
// `__slab_refill_mcache`, MUST win over any `stdlib.`-qualified copy Internals
// may carry). Pass 2 falls back to the bare-callee → `stdlib.`-qualified bridge
// (`calleeNameMatches`) — reached ONLY on an exact miss (rare), so its linear
// scan is not a hot path. Both `lookupFuncParamTypes` and `lookupFuncReturnStdType`
// route through this so the search order lives in exactly one place.
function findCalleeSignature(callee String, sigMap CalleeSigMap, allFunctions IrFunctionArray, stdlibFunctions ObjectFunctionArray) returns CalleeSignature throws FuncSignatureLookupError
	if let sig = try sigMap.get(callee) 'exact'
		return sig
	end 'exact'

	for func in allFunctions 'search'
		if calleeNameMatches(func.name, callee: callee) 'found'
			return CalleeSignature.create(func.paramTypes, returnType: func.returnType)
		end 'found'
	end 'search'
	for func in stdlibFunctions 'searchStdlib'
		if calleeNameMatches(func.name, callee: callee) 'found'
			return CalleeSignature.create(func.paramTypes, returnType: func.returnType)
		end 'found'
	end 'searchStdlib'

	throw FuncSignatureLookupError.notRegistered
end 'findCalleeSignature'

export function lookupFuncParamTypes(callee String, sigMap CalleeSigMap, allFunctions IrFunctionArray, stdlibFunctions ObjectFunctionArray) returns StdTypeArray
	let sig = try findCalleeSignature(callee, sigMap: sigMap, allFunctions: allFunctions, stdlibFunctions: stdlibFunctions) otherwise panic("lookupFuncParamTypes: callee '{callee}' not registered in funcSignatures (allFunctions={allFunctions.count()}, stdlibFunctions={stdlibFunctions.count()})")
	return sig.paramTypes
end 'lookupFuncParamTypes'

// Look up a callee's return type from the MIR-phase function list,
// falling back to the pre-compiled stdlib function list.
export function lookupFuncReturnStdType(callee String, sigMap CalleeSigMap, allFunctions IrFunctionArray, stdlibFunctions ObjectFunctionArray) returns StdReturnType
	let sig = try findCalleeSignature(callee, sigMap: sigMap, allFunctions: allFunctions, stdlibFunctions: stdlibFunctions) otherwise panic("lookupFuncReturnStdType: callee '{callee}' not registered in funcSignatures (allFunctions={allFunctions.count()}, stdlibFunctions={stdlibFunctions.count()})")
	return sig.returnType
end 'lookupFuncReturnStdType'

// ============================================================
// Slot scanning (MIR phase)
// ============================================================

// Scan which variable slots are referenced by memref ops.
// Used by both x64 and arm64 lowering to compute variable stack space.
export function scanLoadedSlots(module MirModule, func IrFunction) returns VarSlotArray
	var loaded = VarSlotArray.create()
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")
		for opIdx in block.opRefs 'eachOp'
			let mirOp = try module.ops.get(opIdx) otherwise panic("invariant: opIdx from block.opRefs not in module.ops")
			match mirOp 'checkMir'
				stackSlotAddr(_, slotId) then loaded.push(slotId)
				loadSlot(_, slotId) then loaded.push(slotId)
				storeSlot(slotId, _) then loaded.push(slotId)
				movImm to store then break 'checkMir'
				globalAddr to loadByte then break 'checkMir'
				osAllocPages to osLockRelease then break 'checkMir'
				tryCall to errorReturn then break 'checkMir'
			end 'checkMir'
		end 'eachOp'
	end 'eachBlock'
	return loaded
end 'scanLoadedSlots'

// Slots whose ADDRESS is taken via `stackSlotAddr`. The stdlib runtime helpers
// use such a slot as the base of a multi-slot SCRATCH BUFFER addressed by
// pointer arithmetic (e.g. `mrt_i64_to_string`'s 21-byte decimal buffer at
// `stackAddr 2`, spanning slots 2..4). Callers must reserve the buffer's full
// footprint so other slots/spills don't alias it — see the arm64 backend's
// escaped-slot reservation.
export function scanEscapedSlots(module MirModule, func IrFunction) returns VarSlotArray
	var escaped = VarSlotArray.create()
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("invariant: blockRef from func.blockRefs not in module.blocks")
		for opIdx in block.opRefs 'eachOp'
			let mirOp = try module.ops.get(opIdx) otherwise panic("invariant: opIdx from block.opRefs not in module.ops")
			match mirOp 'checkMir'
				stackSlotAddr(_, slotId) then escaped.push(slotId)
				loadSlot then break 'checkMir'
				storeSlot then break 'checkMir'
				movImm to store then break 'checkMir'
				globalAddr to loadByte then break 'checkMir'
				osAllocPages to osLockRelease then break 'checkMir'
				tryCall to errorReturn then break 'checkMir'
			end 'checkMir'
		end 'eachOp'
	end 'eachBlock'
	return escaped
end 'scanEscapedSlots'

// ============================================================
// Diverging block detection (MIR phase)
// ============================================================

function isMirOpPanicCall(op MirOp) returns bool
	match op 'check'
		call(_, callee, _) then return callee == "mrt_panic"
		movImm to branch then break 'check'
		indirectCall to loadByte then break 'check'
		osAllocPages to osLockRelease then break 'check'
		tryCall(_, callee, _, _) then return callee == "mrt_panic"
		// witnessTryCall dispatches through a witness table, never the static
		// mrt_panic helper.
		witnessTryCall then break 'check'
		errorReturn then break 'check'
	end 'check'
	return false
end 'isMirOpPanicCall'

export function isMirDivergingBlock(module MirModule, block IrBlock) returns bool
	for opIdx in block.opRefs 'checkOps'
		let mirOp = try module.ops.get(opIdx) otherwise panic("invariant: opIdx from block.opRefs not in module.ops")
		if isMirOpPanicCall(mirOp) 'isPanic2'
			return true
		end 'isPanic2'
	end 'checkOps'
	return false
end 'isMirDivergingBlock'

// ============================================================
// Float constant data registration
// ============================================================

// Register float constant data in globalData and return the label.
// Deduplicates: returns the existing label if already registered.
export function registerFloatConstant(rawBits ParsedInt, globalData GlobalDataTable) returns String
	let label = "__float_{rawBits}"
	let existing = lookupGlobalData(globalData, name: label)
	if existing.count() == 0 'register'
		var data = ByteArray.create()
		writeQword(data, value: rawBits)
		addNamedGlobalData(globalData, name: label, data: data)
	end 'register'
	return label
end 'registerFloatConstant'

// Register a 128-bit XMM mask (low/high 64-bit halves) in globalData and
// return the label. The `__xmmmask_` name prefix is recognized by the rdata
// emission pass which aligns the entry to 16 bytes — required because SSE
// packed instructions like `ANDPD xmm, m128` raise #GP on misaligned memory
// operands.
export function registerXmmMaskConstant(rawBitsLo ParsedInt, rawBitsHi ParsedInt, globalData GlobalDataTable) returns String
	let label = "__xmmmask_{rawBitsLo}_{rawBitsHi}"
	let existing = lookupGlobalData(globalData, name: label)
	if existing.count() == 0 'register'
		var data = ByteArray.create()
		writeQword(data, value: rawBitsLo)
		writeQword(data, value: rawBitsHi)
		addNamedGlobalData(globalData, name: label, data: data)
	end 'register'
	return label
end 'registerXmmMaskConstant'

// Whether `name` is a rdata constant registered LAZILY during target lowering
// (as a side effect of emitting an op). These are the only entries a cache-hit
// chunk must re-register, because emitting its ops is what would normally add
// them. `__float_<bits>` (registerFloatConstant) and `__xmmmask_<lo>_<hi>`
// (registerXmmMaskConstant) are the complete set; string/panic rdata is
// registered eagerly elsewhere and is always present.
function isLazyChunkRdataConstant(name String) returns bool
	return name.startsWith("__float_") or name.startsWith("__xmmmask_")
end 'isLazyChunkRdataConstant'

// Capture into `chunk.rdataConstants` every lazily-registered float/xmm-mask
// constant the freshly-emitted chunk references, copying its bytes out of
// `globalData` (where op emission just added them). Called at the end of each
// backend's `emitFunctionChunk`. On a later cache hit (which skips op emission),
// `reregisterChunkRdataConstants` replays these into the build's globalData so
// the chunk's `rdataRelocs` resolve to the correct constant.
export function captureChunkRdataConstants(chunk FunctionCodeChunk, globalData GlobalDataTable)
	for reloc in chunk.rdataRelocs 'eachReloc'
		let label = reloc.rdataLabel
		if not isLazyChunkRdataConstant(label) 'notLazy'
			continue
		end 'notLazy'
		if chunk.rdataConstants.nameIndex.contains(label) 'alreadyCaptured'
			continue
		end 'alreadyCaptured'
		let value = lookupGlobalData(globalData, name: label)
		if value.count() == 0 'absent'
			continue
		end 'absent'
		addNamedGlobalData(chunk.rdataConstants, name: label, data: value)
	end 'eachReloc'
end 'captureChunkRdataConstants'

// Replay a reused chunk's captured float/xmm-mask rdata constants into the
// build's `globalData`, so the chunk's `rdataRelocs` resolve to the right bytes.
// Idempotent: skips a label already present (the cold/first-emit path, or a
// constant another function already registered). This closes the gap where a
// cache HIT skips op emission and would otherwise leave its lazy float/mask
// constants out of globalData (corrupt binary).
export function reregisterChunkRdataConstants(chunk FunctionCodeChunk, globalData GlobalDataTable)
	for i in 0 upto chunk.rdataConstants.names.count() 'eachConst'
		let name = try chunk.rdataConstants.names.get(i) otherwise continue
		if lookupGlobalData(globalData, name: name).count() > 0 'present'
			continue
		end 'present'
		let value = try chunk.rdataConstants.values.get(i) otherwise continue
		addNamedGlobalData(globalData, name: name, data: value)
	end 'eachConst'
end 'reregisterChunkRdataConstants'

// ============================================================
// MIR ValueId ceiling scan (MIR phase)
// ============================================================

// Highest ValueId referenced (defined or used) in an entire function. Used by
// target lowering to seed a per-function scratch-id allocator one past the
// MIR's ceiling so synthetic virtuals can't collide with MIR-numbered ones.
export function scanMaxMirValueId(module MirModule, func IrFunction) returns ValueId
	var maxId = 0
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("scanMaxMirValueId: blockRef from func.blockRefs not in module.blocks")
		for arg in block.blockArgs 'eachArg'
			if arg.valueId > maxId 'updateArg'
				maxId = arg.valueId
			end 'updateArg'
		end 'eachArg'
		for opIdx in block.opRefs 'eachOp'
			let opMax = scanMaxMirValueIdForOp(module, packed: opIdx)
			if opMax > maxId 'updateOp'
				maxId = opMax
			end 'updateOp'
		end 'eachOp'
		if block.hasTerminatorOp() 'hasTerm'
			let termMax = scanMaxMirValueIdForOp(module, packed: block.terminatorIndex())
			if termMax > maxId 'updateTerm'
				maxId = termMax
			end 'updateTerm'
		end 'hasTerm'
	end 'eachBlock'
	return maxId
end 'scanMaxMirValueId'

function scanMaxMirValueIdForOp(module MirModule, packed OpIndex) returns ValueId
	let op = try module.ops.get(packed) otherwise panic("scanMaxMirValueIdForOp: packed opIdx not in module.ops")
	return mirOpMaxValueId(op)
end 'scanMaxMirValueIdForOp'

// Compute the maximum ValueId defined or used by a single MIR op. Operates
// directly on `MirOp`, so callers that already hold the op (e.g. ISel
// dispatchers) can skip the module.ops indirection.
function mirOpMaxValueId(op MirOp) returns ValueId
	return match op 'pick'
		movImm(resultId, _, _) gives resultId
		movReg(resultId, srcId) gives maxOfTwoValueIds(resultId, b: srcId)
		binOp(resultId, leftId, rightId, _) gives maxOfThreeValueIds(resultId, b: leftId, c: rightId)
		unaryOp(resultId, operandId, _) gives maxOfTwoValueIds(resultId, b: operandId)
		cmp(resultId, leftId, rightId, _) gives maxOfThreeValueIds(resultId, b: leftId, c: rightId)
		condBranch(condId, _, thenArgs, _, elseArgs) gives maxOfThreeValueIds(condId, b: maxValueIdInArray(thenArgs), c: maxValueIdInArray(elseArgs))
		branch(_, args) gives maxValueIdInArray(args)
		call(resultId, _, argIds) gives maxOfTwoValueIds(resultId, b: maxValueIdInArray(argIds))
		indirectCall(resultId, calleeId, argIds, _, _, errorFlagId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: calleeId, c: maxValueIdInArray(argIds)), b: errorFlagId)
		witnessCall(resultId, witnessAddrId, _, _, argIds) gives maxOfThreeValueIds(resultId, b: witnessAddrId, c: maxValueIdInArray(argIds))
		ret(retValId) gives retValId
		param(resultId, _, _) gives resultId
		load(resultId, baseId, _, _, _, _) gives maxOfTwoValueIds(resultId, b: baseId)
		store(valueId, baseId, _, _, _) gives maxOfTwoValueIds(valueId, b: baseId)
		loadSlot(resultId, _) gives resultId
		storeSlot(_, valueId) gives valueId
		stackSlotAddr(resultId, _) gives resultId
		globalAddr(resultId, _) gives resultId
		funcAddr(resultId, _) gives resultId
		loadFramePtr(resultId) gives resultId
		osExit(codeId) gives codeId
		osSleep(msId) gives msId
		osWrite(ptrId, lenId) gives maxOfTwoValueIds(ptrId, b: lenId)
		osWriteErr(ptrId, lenId) gives maxOfTwoValueIds(ptrId, b: lenId)
		osRead(resultId, ptrId, lenId) gives maxOfThreeValueIds(resultId, b: ptrId, c: lenId)
		osOpenWrite(resultId, pathPtrId, pathLenId) gives maxOfThreeValueIds(resultId, b: pathPtrId, c: pathLenId)
		osWriteFd(fdId, ptrId, lenId) gives maxOfThreeValueIds(fdId, b: ptrId, c: lenId)
		osClose(fdId) gives fdId
		osGetEnv(resultId, namePtrId, nameLenId, outBufPtrId, outBufLenId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: namePtrId, c: nameLenId), b: maxOfTwoValueIds(outBufPtrId, b: outBufLenId))
		osGetArgc(resultId) gives resultId
		osClockMs(resultId) gives resultId
		osGetArgv(resultId, indexId) gives maxOfTwoValueIds(resultId, b: indexId)
		osGetExecutablePath(resultId, bufPtrId, bufSizeId) gives maxOfThreeValueIds(resultId, b: bufPtrId, c: bufSizeId)
		memcpy(dstId, srcId, lenId) gives maxOfThreeValueIds(dstId, b: srcId, c: lenId)
		storeByte(baseId, offsetId, byteId) gives maxOfThreeValueIds(baseId, b: offsetId, c: byteId)
		loadByte(resultId, baseId, offsetId) gives maxOfThreeValueIds(resultId, b: baseId, c: offsetId)
		osAllocPages(resultId, sizeId) gives maxOfTwoValueIds(resultId, b: sizeId)
		osAllocPagesLarge(resultId, sizeId) gives maxOfTwoValueIds(resultId, b: sizeId)
		osFreePages(ptrId, sizeId) gives maxOfTwoValueIds(ptrId, b: sizeId)
		osFileOpen(resultId, cStringPtrId, flagsId, fileModeId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: cStringPtrId, c: flagsId), b: fileModeId)
		osFileRead(resultId, fdId, bufPtrId, countId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: fdId, c: bufPtrId), b: countId)
		osFileWrite(resultId, fdId, bufPtrId, countId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: fdId, c: bufPtrId), b: countId)
		osFileClose(resultId, fdId) gives maxOfTwoValueIds(resultId, b: fdId)
		osFileLseek(resultId, fdId, offsetId, whenceId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: fdId, c: offsetId), b: whenceId)
		osFileStat(resultId, cStringPtrId, statBufPtrId) gives maxOfThreeValueIds(resultId, b: cStringPtrId, c: statBufPtrId)
		osFileAccess(resultId, cStringPtrId, modeId) gives maxOfThreeValueIds(resultId, b: cStringPtrId, c: modeId)
		osFileUnlink(resultId, cStringPtrId) gives maxOfTwoValueIds(resultId, b: cStringPtrId)
		osFileRename(resultId, oldPathPtrId, newPathPtrId) gives maxOfThreeValueIds(resultId, b: oldPathPtrId, c: newPathPtrId)
		osDirGetdents64(resultId, fdId, bufPtrId, bufSizeId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: fdId, c: bufPtrId), b: bufSizeId)
		osDirGetcwd(resultId, bufPtrId, bufSizeId) gives maxOfThreeValueIds(resultId, b: bufPtrId, c: bufSizeId)
		osDirMkdir(resultId, cStringPtrId, modeId) gives maxOfThreeValueIds(resultId, b: cStringPtrId, c: modeId)
		atomicInc(addrId) gives addrId
		atomicDec(addrId) gives addrId
		atomicXadd(resultId, addrId, valId) gives maxOfThreeValueIds(resultId, b: addrId, c: valId)
		atomicCas(resultId, addrId, oldId, newId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: addrId, c: oldId), b: newId)
		osLockInit(addrId) gives addrId
		osLockAcquire(addrId) gives addrId
		osLockRelease(addrId) gives addrId
		tryCall(resultId, _, argIds, errorFlagId) gives maxOfThreeValueIds(resultId, b: maxValueIdInArray(argIds), c: errorFlagId)
		witnessTryCall(resultId, witnessAddrId, _, _, argIds, errorFlagId) gives maxOfTwoValueIds(maxOfThreeValueIds(resultId, b: witnessAddrId, c: maxValueIdInArray(argIds)), b: errorFlagId)
		errorReturn(retValId, errorFlagId) gives maxOfTwoValueIds(retValId, b: errorFlagId)
	end 'pick'
end 'mirOpMaxValueId'

function maxOfTwoValueIds(a ValueId, b ValueId) returns ValueId
	return a if a >= b else b
end 'maxOfTwoValueIds'

function maxOfThreeValueIds(a ValueId, b ValueId, c ValueId) returns ValueId
	return maxOfTwoValueIds(maxOfTwoValueIds(a, b: b), b: c)
end 'maxOfThreeValueIds'

export function maxValueIdInArray(ids ValueIdArray) returns ValueId
	var m = 0
	for id in ids 'each'
		if id > m 'update'
			m = id
		end 'update'
	end 'each'
	return m
end 'maxValueIdInArray'
