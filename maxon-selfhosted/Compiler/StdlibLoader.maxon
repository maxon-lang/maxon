// Phase 1: the keyed Library registry. stdlib is the first (and, in Phase 1,
// only) entry, created lazily on first access under key "stdlib" and pinned
// at index 0. Later phases push the user program + external libraries.
var libraryRegistry = LibraryRegistry.create()

// Phase 6: set of an external library's own function names (its emit filter).
typealias StringSet = Set with String

// Phase 7: wasm function lookup by name for incremental preservation.
typealias WasmObjectFunctionByName = Map with (String, WasmObjectFunction)

// Fetch-or-create the stdlib Library (always index 0). Created lazily because
// `findStdlibPath()` walks the filesystem; the anchors are filled in on first
// access. `rootPath` is the parent of `stdlib/` (namespace anchor, so
// `stdlib/Math.maxon` parses as namespace `stdlib`); `cacheDirRoot` is the
// `stdlib/` dir itself (Phase 2), so the cache lives adjacent to its sources at
// `<stdlibDir>/.maxon/cache/` and is shared across every project that resolves
// the same stdlib — not duplicated per user project. Returns a SNAPSHOT; mutate
// via `setStdlibLib`.
function stdlibLib() returns Library
	if libraryRegistry.libs.count() == 0 'create'
		let stdlibPath = findStdlibPath()
		let projectRoot = try stdlibPath.parent() otherwise FilePath from ""
		libraryRegistry.libs.push(Library.create("stdlib", rootPath: projectRoot, cacheDirRoot: stdlibPath, isStdlib: true))
	end 'create'
	return try libraryRegistry.libs.get(0) otherwise panic("stdlibLib: registry empty after create")
end 'stdlibLib'

// Store a mutated stdlib Library back into the registry (index 0). Required
// after any scalar-field write (value-type copy semantics — see the header).
function setStdlibLib(lib Library)
	try libraryRegistry.libs.set(0, value: lib) otherwise panic("setStdlibLib: registry index 0 missing")
end 'setStdlibLib'

// The `<cacheDirRoot>/.maxon/cache/` directory a library's cache files live in,
// honoring the `--cache-root=DIR` testing override (empty = the library's own
// root). Shared by the per-target and meta path computations below.
//
// `cacheRootOverride` (from `project.cacheRootOverride`, set by the internal
// `maxon build --cache-root=DIR` testing flag) redirects the cache to
// `DIR/.maxon/cache/` so the `maxon test-lib-cache` harness can isolate a
// cold/hit/delete sequence in a throwaway temp dir.
function libraryCacheDir(lib Library, cacheRootOverride FilePath) returns FilePath
	var root = lib.cacheDirRoot
	if not cacheRootOverride.isEmpty() 'override'
		root = cacheRootOverride
	end 'override'
	return root.join(".maxon").join("cache")
end 'libraryCacheDir'

// The build-options component of a library-cache filename. `--rc-sanitize`
// changes the library's emitted bytes (the sanitizer gate in
// stdlib/Internals.maxon lowers to 1, expanding poison/quarantine/check code
// into every inlined mm helper) while the compiler fingerprint and the source
// checksum stay identical — so the option MUST split the filename, or a
// sanitized build would silently reuse (and overwrite) the normal cache.
// Empty for a default build so default filenames keep their historical shape.
// The parameter is deliberately non-defaulted everywhere it is threaded: a
// call site that forgot to pass it would silently mix sanitized and normal
// caches.
function libraryOptionsToken(rcSanitize bool) returns String
	return "-rcsan" if rcSanitize else ""
end 'libraryOptionsToken'

// Phase 3: the PER-TARGET cache file (Tier C — linkable bytecode + globalData).
// Lives in the library's own dir, shared across projects; the filename carries
// the target AND the compiler-fingerprint token so two compiler versions sharing
// the dir write distinct, coexisting files instead of stomping each other (see
// *Cache validity key*), plus the build-options token (`libraryOptionsToken`)
// so byte-changing options coexist the same way.
// Filename `<lib>-<target>-<fp>[<opts>].mxc`.
function libraryCachePath(lib Library, target Target, rcSanitize bool, cacheRootOverride FilePath = FilePath from "") returns FilePath
	let cacheDir = libraryCacheDir(lib, cacheRootOverride: cacheRootOverride)
	let fp = compilerFingerprintToken()
	return cacheDir.join("{lib.name}-{targetToString(target)}-{fp}{libraryOptionsToken(rcSanitize)}.mxc")
end 'libraryCachePath'

// Phase 3: the META cache file (Tier A library metadata + Tier B inlinable Std
// IR). Filename `<lib>-meta-<target>-<fp>.mxc`. PER-TARGET, not shared across
// targets: Tier A+B is NOT target-independent — `layoutDescriptors` /
// `structTypes` byte sizes bake in the pointer width (wasm32 = 4 bytes, x64/arm64
// = 8), so the meta content legitimately differs by target. (The original plan
// hoped for one shared meta file; the target-independence guard proved x64 ≠
// wasm32, so this is the plan's documented per-target fallback — correctness over
// the dedup win. The split still cleanly separates the bulky Tier A+B metadata
// from the per-target Tier C bytecode, each reused across rebuilds of the SAME
// target.) The `-meta-` infix distinguishes it from the Tier-C file
// `<lib>-<target>-<fp>.mxc`; the Tier-C file stores this file's content hash so
// the two stay paired. Carries the same build-options token as the Tier-C file
// (the Tier-B inlinable Std IR embeds the sanitizer branches too).
function libraryMetaCachePath(lib Library, target Target, rcSanitize bool, cacheRootOverride FilePath = FilePath from "") returns FilePath
	let cacheDir = libraryCacheDir(lib, cacheRootOverride: cacheRootOverride)
	let fp = compilerFingerprintToken()
	return cacheDir.join("{lib.name}-meta-{targetToString(target)}-{fp}{libraryOptionsToken(rcSanitize)}.mxc")
end 'libraryMetaCachePath'

// Delete the on-disk caches the project at `projectDir` uses (backs the
// `maxon clean` command). Sweeps the shared stdlib cache dir AND the project's
// OWN `.maxon/cache/` (the Phase-5 user-program chunk cache lives there,
// project-private). Phase 6 extends the set to the project's external
// libraries. For each location, removes every `*.mxc` (all fingerprint × target
// × options combinations) and any stray `*.tmp` left by a crashed/aborted
// atomic write. Returns the paths actually removed (for the CLI to report). A
// missing cache dir or an unreadable/undeletable file is skipped silently —
// clean is best-effort.
export function cleanLibraryCaches(projectDir FilePath, extraLibraryDirs FilePathArray = FilePathArray.create()) returns StringArray
	var deleted = StringArray.create()
	var swept = StringSet.create()
	sweepCacheDirOnce(stdlibLib().cacheDirRoot, swept: swept, into: deleted)
	// The project's own cache dir (the Phase-5 user-program chunk cache).
	if not projectDir.isEmpty() 'hasProjectDir'
		sweepCacheDirOnce(projectDir, swept: swept, into: deleted)
	end 'hasProjectDir'
	// Phase 6: every external library this project links — the `build.maxon`
	// `library("...")` manifest entries ∪ the CLI `--library=DIR` dirs the caller
	// forwards. Cleaning a shared lib's cache also affects other projects' next
	// build (expected for an explicit clean). `swept` dedups so a dir named twice
	// (or coinciding with stdlib/projectDir) is only walked once.
	for dir in parseLibraryDirs(projectDir) 'eachManifestLib'
		sweepCacheDirOnce(dir, swept: swept, into: deleted)
	end 'eachManifestLib'
	for dir in extraLibraryDirs 'eachExtraLib'
		sweepCacheDirOnce(dir, swept: swept, into: deleted)
	end 'eachExtraLib'
	return deleted
end 'cleanLibraryCaches'

// Sweep one library cache root's `.maxon/cache/` exactly once: skip if its
// normalized root is already in `swept` (so stdlib / the project dir / a
// repeated library dir aren't double-walked), then delegate to
// `deleteCacheFilesUnder`.
function sweepCacheDirOnce(cacheDirRoot FilePath, swept StringSet, into StringArray)
	if cacheDirRoot.isEmpty() 'empty'
		return
	end 'empty'
	let key = cacheDirRoot.normalize().toString()
	if swept.contains(key) 'already'
		return
	end 'already'
	swept.insert(key)
	deleteCacheFilesUnder(cacheDirRoot, into: into)
end 'sweepCacheDirOnce'

// Delete `*.mxc` + `*.tmp` directly under `<libCacheDirRoot>/.maxon/cache/`,
// appending each removed path to `out`. Non-recursive: cache files live flat in
// that one directory. Tolerates a missing dir / list failure / per-file delete
// failure by skipping (best-effort clean).
function deleteCacheFilesUnder(libCacheDirRoot FilePath, into StringArray)
	if libCacheDirRoot.isEmpty() 'noRoot'
		return
	end 'noRoot'
	let cacheDir = libCacheDirRoot.join(".maxon").join("cache")
	if not Directory.exists(cacheDir) 'noDir'
		return
	end 'noDir'
	let entries = try Directory.list(cacheDir) otherwise return
	for entry in entries 'eachEntry'
		let name = entry.filename()
		if not (name.endsWith(".mxc") or name.endsWith(".tmp")) 'notCache'
			continue
		end 'notCache'
		try File.delete(entry) otherwise continue
		into.push(entry.toString())
	end 'eachEntry'
end 'deleteCacheFilesUnder'

// =============================================================================
// Phase 4: combined (union-of-N-libraries) accessors
// =============================================================================
//
// Codegen + link consume the *union* of every registered library's cache
// instead of the single stdlib cache. Today the registry holds only stdlib
// (the user program + external libs land in Phases 5/6), so each accessor
// short-circuits the single-valid-library case and returns that library's
// exact value — making the union machinery a provable no-op at N=1
// (byte-identical exe vs the Phase-3 binary). The N>1 merge path
// (stdlib-first, registration-order-stable) is dormant until Phase 6
// populates the registry.
//
// `restoreStdlibMetadata` is NOT folded into the combined cache: id-space
// translation is per-`StdlibCacheData` and re-interns into the destination
// project, so metadata is restored one library at a time by
// `restoreLibraryMetadata` (the sequential-restore correctness argument).
// The combined cache therefore carries only what the linker / backend read
// directly off it: the Tier C arrays (`functions` / `wasmFunctions` /
// `globalData`).

// Tri-state result of `findSoleValidLibrary`: zero valid library caches, one
// (with its registry index — the byte-identical fast path), or several
// (forcing the union merge). Avoids a `-1` sentinel index.
type SoleValidLibrary
	export let kind as SoleValidLibraryKind
	export let index as LibraryIndex

	export static function none() returns SoleValidLibrary
		return Self{kind: SoleValidLibraryKind.none, index: 0}
	end 'none'

	export static function one(index LibraryIndex) returns SoleValidLibrary
		return Self{kind: SoleValidLibraryKind.one, index: index}
	end 'one'

	export static function several() returns SoleValidLibrary
		return Self{kind: SoleValidLibraryKind.several, index: 0}
	end 'several'
end 'SoleValidLibrary'

enum SoleValidLibraryKind
	none
	one
	several
end 'SoleValidLibraryKind'

typealias LibraryIndex = int(0 to u64.max)

// Classify how many registered libraries have a valid cache. Exactly one is
// the byte-identical fast path taken throughout Phases 1-5 (the registry holds
// only stdlib): its cache value flows through the combined accessors verbatim
// with no copy or merge, so the emitted layout is bit-for-bit unchanged.
function findSoleValidLibrary() returns SoleValidLibrary
	var result = SoleValidLibrary.none()
	for i in 0 upto libraryRegistry.libs.count() 'eachLib'
		let lib = try libraryRegistry.libs.get(i) otherwise continue
		if not lib.cacheValid 'invalid'
			continue
		end 'invalid'
		match result.kind 'tally'
			none then result = SoleValidLibrary.one(i)
			one to several then result = SoleValidLibrary.several()
		end 'tally'
	end 'eachLib'
	return result
end 'findSoleValidLibrary'

// The union of every registered library's linkable cache (Tier C), stdlib
// first. With exactly one valid library this returns its `cacheData`
// verbatim — no copy, no merge — so the single-library layout the linker
// emits is bit-for-bit unchanged. With N>1 (Phase 6) it concatenates each
// library's `functions` / `wasmFunctions` and unions their `globalData` into
// a fresh combined value, stdlib first.
export function combinedLibraryCache() returns StdlibCacheData
	let sole = findSoleValidLibrary()
	if sole.kind == SoleValidLibraryKind.one 'fastPath'
		return (try libraryRegistry.libs.get(sole.index) otherwise panic("combinedLibraryCache: sole index vanished")).cacheData
	end 'fastPath'

	var combined = StdlibCacheData.create()
	for lib in libraryRegistry.libs 'eachLib'
		if not lib.cacheValid 'invalid'
			continue
		end 'invalid'
		mergeLibraryTierCInto(combined, source: lib.cacheData)
	end 'eachLib'
	return combined
end 'combinedLibraryCache'

// The cache a native linker should LINK FROM, given the `preLink` snapshot it was
// handed before the backend ran. The link path lazily compiles stdlib bodies in
// place into the registry's stdlib array (`ensureStdlibFunctionsCompiled`), so the
// linked-from cache must reflect that growth:
//   - N=1 (only stdlib valid): `preLink` IS the registry's stdlib `cacheData`
//     (the `combinedLibraryCache` fast path returns it by reference), so the
//     in-place grow is already visible — return it unchanged for byte-identity.
//   - N>1 (an external library is registered): `preLink` was a DETACHED union
//     COPY taken before the grow, so it misses the lazily-grown bodies; re-derive
//     the union NOW (after the grow) so they are present.
// Keyed on the live registry's valid-library count, NOT on `preLink`, so the
// decision matches how `combinedLibraryCache` would assemble the cache right now.
module function libraryLinkCacheAfterLazyGrow(preLink StdlibCacheData) returns StdlibCacheData
	if findSoleValidLibrary().kind == SoleValidLibraryKind.one 'singleLibrary'
		return preLink
	end 'singleLibrary'
	return combinedLibraryCache()
end 'libraryLinkCacheAfterLazyGrow'

// Concatenate one library's Tier C (linkable bytecode + rdata) into the
// destination combined cache. Native + wasm function arrays append in
// registration order; `globalData` entries are unioned by name (skipping
// duplicates) so shared rdata labels collapse to one entry. Names are unique
// across libraries (each library is namespace-anchored; un-namespaced
// runtime/builtin helpers live only in stdlib's cache), so concatenation is
// collision-free — a genuine duplicate fully-qualified symbol is a hard error
// caught upstream at metadata restore.
function mergeLibraryTierCInto(dest StdlibCacheData, source StdlibCacheData)
	dest.functions.append(source.functions)
	dest.wasmFunctions.append(source.wasmFunctions)
	for i in 0 upto source.globalData.names.count() 'eachGlobal'
		let name = try source.globalData.names.get(i) otherwise continue
		if dest.globalData.nameIndex.contains(name) 'alreadyPresent'
			continue
		end 'alreadyPresent'
		let value = try source.globalData.values.get(i) otherwise continue
		addNamedGlobalData(dest.globalData, name: name, data: value)
	end 'eachGlobal'
end 'mergeLibraryTierCInto'

// The union of every registered library's post-dce Std-IR snapshot, the
// inliner's source of inlinable bodies across libraries. One valid library
// returns its snapshot verbatim; N>1 merges each (stdlib first) so a user
// call site can inline a body from any library.
export function combinedInlinerStdModule() returns StdModule
	let sole = findSoleValidLibrary()
	if sole.kind == SoleValidLibraryKind.one 'fastPath'
		return (try libraryRegistry.libs.get(sole.index) otherwise panic("combinedInlinerStdModule: sole index vanished")).inlinerStdModule
	end 'fastPath'

	var combined = StdModule.create()
	for lib in libraryRegistry.libs 'eachLib'
		if not lib.cacheValid 'invalid'
			continue
		end 'invalid'
		combined.merge(lib.inlinerStdModule)
	end 'eachLib'
	return combined
end 'combinedInlinerStdModule'

// The union of every registered library's precomputed Std-DFE edge table, so
// load-time dead-function elimination follows the call graph of bodies served
// from any library's cache. One valid library returns its map verbatim; N>1
// unions each (stdlib first). Edge keys are fully-qualified function names,
// unique across libraries, so the union never collides.
module function combinedFuncEdges() returns CachedFuncEdgeMap
	let sole = findSoleValidLibrary()
	if sole.kind == SoleValidLibraryKind.one 'fastPath'
		return (try libraryRegistry.libs.get(sole.index) otherwise panic("combinedFuncEdges: sole index vanished")).funcEdges
	end 'fastPath'

	var combined = CachedFuncEdgeMap.create()
	for lib in libraryRegistry.libs 'eachLib'
		if not lib.cacheValid 'invalid'
			continue
		end 'invalid'
		for (name, edges) in lib.funcEdges 'eachEdge'
			combined.upsert(name, value: edges)
		end 'eachEdge'
	end 'eachLib'
	return combined
end 'combinedFuncEdges'

// Whether any registered library has a valid linkable cache — the
// generalized form of `isStdlibCacheValid()` gating the cache-on link /
// runtime-trim path. True iff at least one library's cache is populated and
// valid for the active target.
module function anyLibraryCacheValid() returns bool
	for lib in libraryRegistry.libs 'eachLib'
		if lib.cacheValid 'valid'
			return true
		end 'valid'
	end 'eachLib'
	return false
end 'anyLibraryCacheValid'

// v80 lazy codegen: process-wide memo of the reconstructed, fully-lowered
// stdlib MIR module that `ensureStdlibFunctionsCompiled` codegens subsets
// from on demand. Built once (the first time any stdlib function must be
// lazily compiled) by re-merging the persisted post-dce Std-IR snapshot
// (the stdlib Library's `inlinerStdModule`) with the cache-side runtime bodies
// and running lowerStdToMir + commuteForCoalescing + scheduleInstructions over the
// union — the exact prefix `buildAndWriteStdlibCache` runs before its
// backend tail, so per-function lowering is byte-identical to the eager
// path. `lazyStdlibMirBuilt` guards the one-time build; keyed implicitly to
// the process's single active target.
var lazyStdlibMir = MirModule.create()
var lazyStdlibMirBuilt = false

// The reconstructed stdlib+runtime Std module (snapshot ∪ cache-side runtime),
// retained between the cheap edge-build and the on-demand MIR lowering so the
// merge isn't repeated. Built by `ensureLazyStdlibEdges`.
var lazyReconstructed = StdModule.create()
var lazyStdlibEdgesBuilt = false

// Full Std-IR call-edge map over the RECONSTRUCTED module (stdlib snapshot +
// runtime bodies), so the lazy needed-closure can follow runtime->runtime and
// runtime->stdlib edges that the stdlib Library's `funcEdges` (stdlib-only
// snapshot) omits. Built by `ensureLazyStdlibEdges` (cheap; no MIR lowering).
var lazyStdlibFuncEdges = CachedFuncEdgeMap.create()

// Names already present in the stdlib Library's `cacheData.functions`, for O(1)
// missing-set computation without rescanning the function array each link.
var lazyCompiledStdlibNames = StdlibFuncNameSet.create()

// Process-wide accessor for the parsed stdlib MaxonModule (the Maxon-IR
// shape of every stdlib function body whitelisted by `stdlibWhitelist`).
// Consumers — today only `MonomorphizeExtensions` falling back when a
// stdlib-declared interface-extension callee isn't in the user module —
// read this to discover Maxon-IR bodies that the codegen cache doesn't
// persist.
//
// J.4e: the underlying sandbox parse uses its own dedicated `Project` so
// the parse never collides with user-code project state (E2001 duplicate
// names). MaxonType / StringId / FunctionTypeId payloads in the parsed
// IR reference the sandbox project's registries; we translate them into
// the caller's project on every call via `translateStdlibParsedModule`.
// The first call in a process triggers the lazy parse; subsequent calls
// re-use the cached sandbox snapshot.
module function getStdlibParsedModule(userProject Project) returns MaxonModule
	if stdlibLib().parsedSnapshot.count() == 0 'needsParse'
		ensureStdlibSandboxParsed(userProject.target)
	end 'needsParse'
	let snapshot = try stdlibLib().parsedSnapshot.get(0) otherwise panic("getStdlibParsedModule: sandbox snapshot not present after ensure")
	return translateStdlibParsedModule(snapshot.project, user: userProject, src: snapshot.module)
end 'getStdlibParsedModule'

// Build the sandbox snapshot if it hasn't been populated yet. The sandbox
// project is a dedicated empty Project with the same target as the user's
// pipeline; the parse runs against it so user-code projects' registries
// stay pristine. The bootstrap source + every whitelisted stdlib file are
// parsed into a single fresh MaxonModule, then stashed alongside the
// sandbox project for the cross-project translator to consume on demand.
function ensureStdlibSandboxParsed(target Target)
	if stdlibLib().parsedSnapshot.count() > 0 'alreadyDone'
		return
	end 'alreadyDone'
	let stdlibPath = findStdlibPath()
	if stdlibPath.isEmpty() 'noStdlib'
		return
	end 'noStdlib'
	let projectRoot = try stdlibPath.parent() otherwise FilePath from ""
	if projectRoot.isEmpty() 'noRoot'
		return
	end 'noRoot'
	var sandbox = createProject(projectRoot, target: target)
	// Builtin-type surface (`__mm_*`, `__Managed*`, `__Builtins.*`) — the block
	// shared with the main stdlib load (`getStdlibModule`), extracted into one
	// reusable helper in `Library.maxon`.
	registerBuiltinTypeBootstrap(sandbox)
	// `__Internals.*` raw system ops stay stdlib-only (file-path gated), so
	// this register is called separately, not folded into the bootstrap.
	registerInternalsIntrinsicSignatures(sandbox)
	var module = MaxonModule.create()
	for fp in collectStdlibFiles() 'eachFile'
		if File.exists(fp) 'exists'
			let content = try File.readText(fp) otherwise 'readErr'
				continue
			end 'readErr'
			parseStdlibSource(sandbox, allModule: module, filePath: fp, rootPath: projectRoot, content: content)
		end 'exists'
	end 'eachFile'
	// Drain pending cross-file function renames produced when a late-parsed
	// file overloaded a function declared in an earlier-parsed sibling. The
	// per-file parser's in-module rekey couldn't reach the IrFunction once
	// it had been merged into `allModule`; we now apply each rename here so
	// the unified IrFunction.name matches the project-level mangled key.
	applyPendingFuncRenames(sandbox, allModule: module)
	// G.2: now that every stdlib file is parsed, the parser's optimistic
	// `<TypeName>.fromRawValue` / `<TypeName>.fromName` rewrite gets
	// validated against the now-fully-populated enum tables. Bare-case
	// enums get their per-enum lookup helper synthesized into `module`;
	// struct- / alt-backed enums and associated-value unions get E3034
	// diagnostics; non-enum receivers get the callee rewritten back to
	// the natural form so the standard unknown-callee diagnostic fires.
	validateEnumLookupCalls(sandbox, allModule: module)
	var lib = stdlibLib()
	lib.parsedSnapshot.push(StdlibParseSnapshot.create(sandbox, module: module))
	setStdlibLib(lib)
end 'ensureStdlibSandboxParsed'

// Walk `allModule.functions` and rename any IrFunction whose `.name` matches
// a pending rename entry. The map is cleared after the walk so a follow-up
// parse (user project) starts with a fresh state.
//
// This is the stdlib / external-library path: their cross-file overload renames
// are baked into the library's whole-module cache here, so they never need the
// PERSISTENT `crossFileOverloadRenames` map the user pipeline relies on. The
// persistent map is reset in lockstep with `pendingFuncRenames` so stdlib/lib
// renames don't leak into the user-file apply pass (which would re-target
// already-mangled cached names — a no-op, but the map must stay user-only so
// per-file rollback stays correct).
function applyPendingFuncRenames(project Project, allModule MaxonModule)
	if project.pendingFuncRenames.count() == 0 'noRenames'
		return
	end 'noRenames'
	renameFunctionsByMap(allModule, renames: project.pendingFuncRenames)
	project.pendingFuncRenames = FuncRenameMap.create()
	project.crossFileOverloadRenames = FuncRenameMap.create()
end 'applyPendingFuncRenames'

// User-pipeline counterpart of `applyPendingFuncRenames`. Applies the
// PERSISTENT `crossFileOverloadRenames` map (re-applied on every `queryAllModule`
// recompute, including incremental rebuilds whose overloaded files were
// parse-cache hits) to the freshly-merged user `allModule`, and folds in any
// renames still sitting in the transient `pendingFuncRenames` from this pass.
// Unlike the stdlib path it does NOT discard the persistent map — that map is
// the source of truth across rebuilds and is pruned only by per-file rollback.
// `pendingFuncRenames` IS cleared so a follow-up re-parse of an overloaded file
// (which re-queues its rename) does not hit the duplicate-entry panic.
export function applyCrossFileOverloadRenames(project Project, allModule MaxonModule)
	for (oldName, newName) in project.pendingFuncRenames 'foldPending'
		project.crossFileOverloadRenames.upsert(oldName, value: newName)
	end 'foldPending'
	project.pendingFuncRenames = FuncRenameMap.create()
	if project.crossFileOverloadRenames.count() == 0 'noRenames'
		return
	end 'noRenames'
	renameFunctionsByMap(allModule, renames: project.crossFileOverloadRenames)
end 'applyCrossFileOverloadRenames'

// Rewrite every IrFunction in `allModule` whose `.name` is a key in `renames`
// to the mapped value. Shared by the stdlib/library drain
// (`applyPendingFuncRenames`) and the user drain
// (`applyCrossFileOverloadRenames`), which differ only in WHICH map they apply
// and whether they discard it afterward.
function renameFunctionsByMap(allModule MaxonModule, renames FuncRenameMap)
	for i in 0 upto allModule.functions.count() 'eachFunc'
		var f = try allModule.functions.get(i) otherwise continue
		if let newName = try renames.get(f.name) 'haveRename'
			f.name = newName
			try allModule.functions.set(i, value: f) otherwise ignore
		end 'haveRename'
	end 'eachFunc'
end 'renameFunctionsByMap'

// Discovery cache for the BuiltinArrayLiteral protocol, stored on the stdlib
// Library's `builtinArrayLiteralTypeName`. The parser walks
// `project.unresolvedStructTypes` once at parse time and writes the
// implementing type's name there; subsequent array-literal expansions in the
// same process read the cached value rather than re-walking. The disk-cache
// write/read paths plumb this through `StdlibCacheData.builtinArrayLiteralTypeName`
// so cache-hit runs (which skip the stdlib parse) still find the type name.
// The field is a ByteArray; these accessors round-trip through String at the
// boundary.
export function getCachedBuiltinArrayLiteralTypeName() returns String
	return String.from(stdlibLib().builtinArrayLiteralTypeName)
end 'getCachedBuiltinArrayLiteralTypeName'

export function setCachedBuiltinArrayLiteralTypeName(name String)
	var lib = stdlibLib()
	lib.builtinArrayLiteralTypeName = name.toByteArray()
	setStdlibLib(lib)
end 'setCachedBuiltinArrayLiteralTypeName'

// Mirror of `builtinArrayLiteralTypeName` for the `BuiltinDictionaryLiteral`
// protocol — the parser walks `project.unresolvedStructTypes` once at parse
// time and records the implementing type's name on the stdlib Library's
// `builtinDictionaryLiteralTypeName` so user-code map literals resolve through
// whichever stdlib type opted in.
export function getCachedBuiltinDictionaryLiteralTypeName() returns String
	return String.from(stdlibLib().builtinDictionaryLiteralTypeName)
end 'getCachedBuiltinDictionaryLiteralTypeName'

export function setCachedBuiltinDictionaryLiteralTypeName(name String)
	var lib = stdlibLib()
	lib.builtinDictionaryLiteralTypeName = name.toByteArray()
	setStdlibLib(lib)
end 'setCachedBuiltinDictionaryLiteralTypeName'

// Mirror of `builtinArrayLiteralTypeName` for the `BuiltinCharLiteral`
// protocol — the type a single-quote character literal (`'x'`) lowers to. The
// compiler knows nothing about "Character" specifically; it discovers whichever
// stdlib type declares `implements BuiltinCharLiteral` (parser walk over
// `unresolvedStructTypes`, republished into the stdlib Library's
// `builtinCharLiteralTypeName` by `restoreStdlibMetadata` on cache-hit runs).
// Every site that previously hardcoded the `"Character"` type name reads
// `builtinCharLiteralTypeName(project)` instead.
export function getCachedBuiltinCharLiteralTypeName() returns String
	return String.from(stdlibLib().builtinCharLiteralTypeName)
end 'getCachedBuiltinCharLiteralTypeName'

export function setCachedBuiltinCharLiteralTypeName(name String)
	var lib = stdlibLib()
	lib.builtinCharLiteralTypeName = name.toByteArray()
	setStdlibLib(lib)
end 'setCachedBuiltinCharLiteralTypeName'

// Mirror of `builtinCharLiteralTypeName` for the `BuiltinStringLiteral`
// protocol — the type a double-quote string literal (`"..."`) and the `string`
// primitive type-arm lower to. The compiler knows nothing about "String"
// specifically; it discovers whichever stdlib type declares `implements
// BuiltinStringLiteral`.
export function getCachedBuiltinStringLiteralTypeName() returns String
	return String.from(stdlibLib().builtinStringLiteralTypeName)
end 'getCachedBuiltinStringLiteralTypeName'

export function setCachedBuiltinStringLiteralTypeName(name String)
	var lib = stdlibLib()
	lib.builtinStringLiteralTypeName = name.toByteArray()
	setStdlibLib(lib)
end 'setCachedBuiltinStringLiteralTypeName'

// Invalidate the v80 lazy-codegen memo (reconstructed MIR, edge map, and the
// already-compiled-name set). Called on every cross-target switch
// (`loadCacheForTarget`) — the memo is keyed to one target's reconstructed
// module + arch backend and must not leak across.
// `lazyCompiledStdlibNames` is re-seeded from the loaded cache's real-code
// entries by `syncLazyCompiledNames` on the next lazy fill.
function resetLazyStdlibState()
	lazyStdlibMir = MirModule.create()
	lazyStdlibMirBuilt = false
	lazyReconstructed = StdModule.create()
	lazyStdlibEdgesBuilt = false
	lazyStdlibFuncEdges = CachedFuncEdgeMap.create()
	lazyCompiledStdlibNames = StdlibFuncNameSet.create()
end 'resetLazyStdlibState'

// Reset all stdlib-loader process state: drop the keyed Library registry (the
// stdlib Library and every cached/parsed/typealias/literal field it carries is
// recreated lazily on the next access) and clear the v80 lazy-codegen memo. The
// public entry point for a clean-slate reload within a process.
function resetStdlibLoaderState()
	libraryRegistry = LibraryRegistry.create()
	resetLazyStdlibState()
end 'resetStdlibLoaderState'

export function findStdlibPath() returns FilePath
	var dir = Directory.currentPath()
	for _ in 0 upto 10 'search'
		let candidate = dir.join("stdlib")
		if Directory.exists(candidate) 'found'
			return candidate
		end 'found'
		let parentDir = try dir.parent() otherwise return FilePath from ""
		dir = parentDir
	end 'search'
	return FilePath from ""
end 'findStdlibPath'

// Resolve the project root that holds `stdlib/`. Returned path is the parent
// of `findStdlibPath()`; empty when stdlib can't be located. All whitelist
// entries are joined onto this root.
function findStdlibProjectRoot() returns FilePath
	let stdlibPath = findStdlibPath()
	if stdlibPath.isEmpty() 'noStdlib'
		return FilePath from ""
	end 'noStdlib'
	return try stdlibPath.parent() otherwise FilePath from ""
end 'findStdlibProjectRoot'

// Recursively collect every `.maxon` file under `stdlib/`, returned in a
// DETERMINISTIC byte-wise-lexicographic order (spike A2). `collectMaxonFilesUnder`
// consumes `Directory.list` unsorted, so the raw walk order depends on
// filesystem enumeration — and parse order feeds interner id allocation, which
// feeds map/byte layout, so an unsorted walk makes the on-disk cache differ
// across machines / checkouts. Sorting here makes the cache build reproducible,
// which the cross-project byte-parity gates depend on. The type / conformance
// resolver is order-independent, so a fixed order changes only the byte layout,
// not the compiled semantics. `currentStdlibChecksum` calls this same function,
// so the checksum input and the parse input stay in lockstep by construction.
function collectStdlibFiles() returns FilePathArray
	var files = FilePathArray.create()
	let stdlibPath = findStdlibPath()
	if stdlibPath.isEmpty() 'noStdlib'
		return files
	end 'noStdlib'
	collectMaxonFilesUnder(stdlibPath, into: files)
	return sortFilePathsAscending(files)
end 'collectStdlibFiles'

// Selection sort of a FilePathArray by the byte-wise lexicographic order of
// each path's string form. The stdlib tree is a few dozen files, so O(n^2) is
// fine. Rather than the swap-and-pop trick `sortStringsAscending` uses (which
// would borrow the tail element while mutating the array — E3070), this tracks
// consumed slots in a parallel bool array and never mutates the input, picking
// the smallest not-yet-emitted path each round. Keyed on `FilePath.toString()`.
function sortFilePathsAscending(paths FilePathArray) returns FilePathArray
	let total = paths.count()
	var used = BoolArray.create()
	for _ in 0 upto total 'initUsed'
		used.push(false)
	end 'initUsed'
	var out = FilePathArray.create()
	for _ in 0 upto total 'emit'
		var minIdx = 0
		var haveMin = false
		var k = 0
		while k < total 'scan'
			let consumed = try used.get(k) otherwise panic("sortFilePathsAscending: used.get({k}) failed")
			if not consumed 'candidate'
				let candidate = try paths.get(k) otherwise panic("sortFilePathsAscending: paths.get({k}) failed")
				if not haveMin 'firstCandidate'
					minIdx = k
					haveMin = true
				end 'firstCandidate' else 'compare'
					let cur = try paths.get(minIdx) otherwise panic("sortFilePathsAscending: paths.get(min={minIdx}) failed")
					if stringLexLess(candidate.toString(), b: cur.toString()) 'smaller'
						minIdx = k
					end 'smaller'
				end 'compare'
			end 'candidate'
			k = k + 1
		end 'scan'
		if not haveMin 'noneLeft'
			panic("sortFilePathsAscending: no unconsumed path on emit round")
		end 'noneLeft'
		out.push(try paths.get(minIdx) otherwise panic("sortFilePathsAscending: paths.get(picked={minIdx}) failed"))
		try used.set(minIdx, value: true) otherwise panic("sortFilePathsAscending: used.set({minIdx}) failed")
	end 'emit'
	return out
end 'sortFilePathsAscending'

// Walk `dir` recursively and push every `.maxon` file into `out`. Hidden
// entries (`.something`) and non-existent / unreadable directories are
// silently ignored — the stdlib tree is trusted content, so a missing
// subdirectory is treated as "nothing to add" rather than a fatal error.
function collectMaxonFilesUnder(dir FilePath, into FilePathArray)
	let entries = try Directory.list(dir) otherwise return
	for entry in entries 'eachEntry'
		if Directory.exists(entry) 'isDir'
			collectMaxonFilesUnder(entry, into: into)
		end 'isDir' else 'isFile'
			let name = entry.filename()
			if not name.endsWith(".maxon") 'notMaxon'
				continue
			end 'notMaxon'
			into.push(entry)
		end 'isFile'
	end 'eachEntry'
end 'collectMaxonFilesUnder'

// Cache key for the currently-discoverable stdlib: every file the recursive
// walk surfaces plus runtime.std (the latter affects compiled output, so
// the on-disk cache must invalidate when runtime.std changes). The wasm green
// thread runtime (runtime_wasm.std) is folded in alongside the stdlib files so
// edits to the wasm coroutine bodies bust the on-disk cache too.
function currentStdlibChecksum(_ Target) returns CacheChecksum
	var files = collectStdlibFiles()
	let wasmGtRuntime = findWasmGtRuntimePath()
	if not wasmGtRuntime.isEmpty() 'hasWasmGt'
		files.push(wasmGtRuntime)
	end 'hasWasmGt'
	return computeStdlibChecksum(files, runtimePath: findRuntimePath())
end 'currentStdlibChecksum'

// Parse a single stdlib source string and merge its module into `allModule`.
// Bundled stdlib content (whitelisted files + the synthesized bootstrap) is
// trusted: any lex/parse failure is a compiler bug rather than a user input
// problem, so we panic with a precise message instead of skipping silently.
//
// `rootPath` is the per-file compile anchor for namespace derivation — for
// stdlib files this is the parent of the `stdlib/` install dir
// (`findStdlibProjectRoot()`). The directory-as-module redesign derives
// each file's namespace from its path relative to that anchor, so
// `stdlib/Math.maxon` parses with namespace `stdlib` and
// `stdlib/helpers/string/utf8.maxon` parses with namespace
// `stdlib.helpers.string`. Decl-registration in the parser then qualifies
// every free function under the file's directory namespace, matching the
// C# bootstrap's behavior.
// Pre-parse pass over every stdlib file: seed the builtin-literal type-name
// caches (char/string/array/dictionary) from each `type ... implements
// Builtin*Literal` header before any file's body is parsed. Without this, a file
// sorted before the implementor (e.g. `Ascii.maxon` before `Character.maxon`)
// parses its bodies against an empty cache — the concrete symptom was
// `Ascii.isWhitespace`'s `match c` over a Character silently pointer-comparing
// the boxed scrutinee (the codepoint() unbox was skipped) and always returning
// its default arm. Runs only on the from-source (cache-miss) path; the tokens
// are re-tokenized in the subsequent parse loop, an acceptable one-time cost.
function prescanStdlibBuiltinLiteralTypes(project Project, stdlibFiles FilePathArray, stdlibRoot FilePath)
	for fp in stdlibFiles 'eachFile'
		if File.exists(fp) 'exists'
			let content = try File.readText(fp) otherwise 'readErr'
				continue
			end 'readErr'
			let tokens = try tokenize(content) otherwise 'lexErr'
				continue
			end 'lexErr'
			let ns = deriveNamespace(fp, rootPath: stdlibRoot)
			var parser = try Parser.create(project, tokens: tokens, filePath: fp, rootPath: stdlibRoot, namespace: ns) otherwise continue
			parser.prescanBuiltinLiteralTypes()
		end 'exists'
	end 'eachFile'
end 'prescanStdlibBuiltinLiteralTypes'

function parseStdlibSource(project Project, allModule MaxonModule, filePath FilePath, rootPath FilePath, content String)
	logDebug(LogCategory.compiler, message: function() gives "  Parsing {filePath}")
	let tokens = try tokenize(content) otherwise panic("StdlibLoader: lexer error in bundled stdlib file {filePath}")
	let ns = deriveNamespace(filePath, rootPath: rootPath)
	var parser = try Parser.create(project, tokens: tokens, filePath: filePath, rootPath: rootPath, namespace: ns) otherwise panic("StdlibLoader: empty or malformed stdlib file {filePath}")
	let parsed = try parser.parseModule() otherwise panic("StdlibLoader: parse failed for stdlib file {filePath}")
	// Whitelist-grade stdlib content must parse without diagnostics. The
	// downstream pipeline assumes well-formed IR; running on a broken parse
	// risks an infinite loop in one of the passes that walks unterminated
	// CFGs. Surface the parser diagnostics here rather than rolling forward
	// into a hang.
	if hasErrors(project) 'parseErrors'
		panic("StdlibLoader: parse errors in stdlib file — see diagnostics above")
	end 'parseErrors'
	parsed.assertAllBlocksTerminated()
	allModule.merge(parsed)
end 'parseStdlibSource'

// Phase 6: parse one EXTERNAL-library source file. Same namespace-anchoring as
// `parseStdlibSource`, but external library code is USER input, not trusted
// bundled stdlib — a lex/parse error must surface as a diagnostic + clean build
// failure, never a compiler-bug panic. Returns false (with diagnostics already
// reported by the lexer/parser, or one minted here) on any failure so the caller
// can stop the build; true on a clean parse.
function parseLibrarySource(project Project, allModule MaxonModule, filePath FilePath, rootPath FilePath, content String) returns bool
	logDebug(LogCategory.compiler, message: function() gives "  Parsing library file {filePath}")
	let tokens = try tokenize(content) otherwise 'lexErr'
		reportSemanticError(project, code: ErrorCode.semanticLibraryNotFound, message: "lexer error in library file {filePath}")
		return false
	end 'lexErr'
	let ns = deriveNamespace(filePath, rootPath: rootPath)
	var parser = try Parser.create(project, tokens: tokens, filePath: filePath, rootPath: rootPath, namespace: ns) otherwise 'createErr'
		reportSemanticError(project, code: ErrorCode.semanticLibraryNotFound, message: "empty or malformed library file {filePath}")
		return false
	end 'createErr'
	let parsed = try parser.parseModule() otherwise 'parseErr'
		// The parser already pushed precise per-site diagnostics; this is the
		// build-stopping signal.
		return false
	end 'parseErr'
	if hasErrors(project) 'parseErrors'
		// Per-site diagnostics already reported by the parser.
		return false
	end 'parseErrors'
	parsed.assertAllBlocksTerminated()
	allModule.merge(parsed)
	return true
end 'parseLibrarySource'

// Seed the allocator/MM boundary functions the runtime calls into as stdlib-DFE
// liveness roots. The runtime bodies (`mrt_start` + the runtime.std MM/container
// helpers) are merged into the user module AFTER the stdlib DFE runs (see
// `augmentWithRuntime`), so the DFE never sees edges like `mrt_start`→`__slab_init`
// or `mrt_alloc`→`__mm_alloc` and would prune the Internals bodies — leaving the
// cache-off leg (empty `stdlibFunctions`) with no definition to
// resolve those calls' signatures against. The cache-on linker pulls the same
// closure transitively from `mrt_start`/`mrt_alloc`, so rooting them keeps the
// from-source and cached builds' function sets in lockstep. Transitive callees
// follow the DFE walk.
function seedRuntimeBootstrapStdlibRoots(project Project)
	let roots = [
		"stdlib.__slab_init",
		"stdlib.__slab_free",
		"stdlib.__mm_alloc",
		"stdlib.__mm_free",
		"stdlib.__mm_incref",
		"stdlib.__mm_decref",
		"stdlib.__mm_drop",
		"stdlib.__mm_panic_list_empty",
		"stdlib.__managed_mem_create"
	]
	for r in roots 'seed'
		project.livenessRoots.push(r)
	end 'seed'
end 'seedRuntimeBootstrapStdlibRoots'

export function getStdlibModule(project Project) returns MaxonModule
	// Register the builtin-type surface (`__mm_*` allocator intrinsics, the
	// `__Managed*` builtin structs + error enums + method signatures, and the
	// `__Builtins.*` write intrinsics) on every project before any of the
	// cache / parse paths below populate the rest of the registries — these
	// names are stable across all projects and don't depend on user code or
	// cached stdlib state. Idempotent: each underlying `register*` helper's
	// `try ... insert ... otherwise ignore` drops a duplicate silently if a
	// previous call in the same process already populated the same project.
	// The block is the one shared with `ensureStdlibSandboxParsed`, extracted
	// into one reusable helper in `Library.maxon`.
	registerBuiltinTypeBootstrap(project)
	// Register `__Internals.*` intrinsic signatures so `stdlib/Internals.maxon`
	// can call raw Std-level system ops (atomicInc, atomicXadd, ...) using a
	// qualified-static call shape. File-path gating in `lowerInternalsIntrinsic`
	// rejects callers outside the designated internals file.
	registerInternalsIntrinsicSignatures(project)
	// The runtime (`mrt_start` + the runtime.std MM/container bodies) calls a
	// fixed set of allocator/MM functions defined in `stdlib/Internals.maxon`
	// (`__slab_init`, `__mm_alloc`, `__managed_mem_create`, …). The runtime is
	// merged into the user module AFTER the stdlib DFE runs (see
	// `augmentWithRuntime`), so the stdlib DFE never sees those call edges and
	// would prune the Internals bodies — leaving `mrt_start`'s `call __slab_init`
	// with no definition to resolve its signature against (the cache-off leg,
	// where `stdlibFunctions` is empty). Seeding them as
	// liveness roots keeps the bodies alive through the from-source build. The
	// cache-on path restores the same roots from `data.livenessRoots`.
	seedRuntimeBootstrapStdlibRoots(project)
	if stdlibLib().loaded 'cached'
		let restoreStart = passTimerStart()
		let warmLib = stdlibLib()
		// Restore metadata into the new project
		if warmLib.cacheValid 'restoreFromCache'
			restoreLibraryMetadata(project, libIndex: 0)
		end 'restoreFromCache' else 'restoreFromParse'
			for (name, baseType) in warmLib.typealiases 'restoreAliases'
				try project.typealiases.insert(name, value: baseType) otherwise ignore
			end 'restoreAliases'
			for (name, infos) in warmLib.typealiasVisibilities 'restoreAliasVis'
				for info in infos 'eachInfo'
					appendTypealiasVisibility(project, name: name, info: info)
				end 'eachInfo'
			end 'restoreAliasVis'
			for (name, range) in warmLib.typealiasRanges 'restoreRanges'
				recordTypealiasRange(project, name: name, range: range)
			end 'restoreRanges'
			for (name, category) in warmLib.typealiasCastCategories 'restoreCategories'
				try project.typealiasCastCategories.insert(name, value: category) otherwise ignore
			end 'restoreCategories'
		end 'restoreFromParse'
		recordPassSince("__restoreStdlibMetadata", startMs: restoreStart)

		// If the target changed, try loading the disk cache for the new target
		let targetChanged = not warmLib.cacheTargetSet or project.target.cpu != warmLib.cacheCpu or project.target.os != warmLib.cacheOs
		if targetChanged 'loadNewTarget'
			loadCacheForTarget(project)
		end 'loadNewTarget'

		return stdlibLib().cachedModule
	end 'cached'

	let stdlibPath = findStdlibPath()
	if stdlibPath.isEmpty() 'noStdlib'
		logInfo(LogCategory.compiler, message: function() gives "No stdlib/ found, skipping stdlib")
		var noStdlibLib = stdlibLib()
		noStdlibLib.loaded = true
		setStdlibLib(noStdlibLib)
		return stdlibLib().cachedModule
	end 'noStdlib'

	logInfo(LogCategory.compiler, message: function() gives "Loading stdlib from {stdlibPath}")

	// Phase 2: the stdlib cache lives in the stdlib's OWN directory
	// (`<stdlibDir>/.maxon/cache/`), shared across every project that resolves
	// it, with the target + compiler-fingerprint baked into the filename for
	// coexistence. The path no longer depends on the user project, so the old
	// per-project `.maxon/cache/` location, the single-file parent resolution,
	// and the sticky `stdlibCacheProjectDirs` pin are all gone.
	let metaPath = libraryMetaCachePath(stdlibLib(), target: project.target, rcSanitize: project.rcSanitizeEnabled, cacheRootOverride: project.cacheRootOverride)
	let cachePath = libraryCachePath(stdlibLib(), target: project.target, rcSanitize: project.rcSanitizeEnabled, cacheRootOverride: project.cacheRootOverride)
	let checksumStart = passTimerStart()
	let contentChecksum = currentStdlibChecksum(project.target)
	recordPassSince("__stdlib-checksum", startMs: checksumStart)
	let cacheResult = readStdlibCache(project, metaPath: metaPath, targetPath: cachePath, target: project.target, expectedChecksum: contentChecksum)

	if cacheResult.valid 'cacheHit'
		logInfo(LogCategory.compiler, message: function() gives "Stdlib cache hit: {countCompiledStdlibFunctions(cacheResult.data)} functions cached")
		activateStdlibCache(cacheResult.data, target: project.target)
		setStdlibCacheMetaHash(cacheResult.metaHash)

		// Read a single mutable snapshot of the just-activated stdlib Library.
		// `cacheData` is reference-backed, so `restoreStdlibMetadata`'s in-place
		// rebuild of `data.writerGidToProjectGid` writes through to the
		// registry's storage (persisting for subsequent compiles); the trailing
		// `setStdlibLib` writes back the scalar / field-slot changes below.
		var hitLib = stdlibLib()

		// Restore parser metadata so user code can reference stdlib types,
		// routing through the registry's just-activated `cacheData` (the
		// per-library restore seam; index 0 is stdlib).
		restoreLibraryMetadata(project, libIndex: 0)

		// Phase 11.6 cross-module inlining: republish the stdlib StdModule
		// snapshot pulled from disk so the user pipeline's inliner pass can
		// see stdlib accessor bodies.
		hitLib.inlinerStdModule = cacheResult.data.inlinerStdModule

		// v68: republish the precomputed Std-DFE edge table so the load-time
		// Std-DFE follows the cached call graph + witness/layout demands
		// without re-walking the snapshot IR.
		hitLib.funcEdges = cacheResult.data.stdFuncEdges

		// Return empty module — stdlib is pre-compiled to machine code
		hitLib.cachedModule = MaxonModule.create()
		hitLib.loaded = true
		setStdlibLib(hitLib)
		return stdlibLib().cachedModule
	end 'cacheHit'

	logInfo(LogCategory.compiler, message: function() gives "Stdlib cache miss: compiling from source")

	// Cache miss — parse from source. Whitelist drives which stdlib files the
	// self-hosted compiler can handle today; see stdlibWhitelist above.
	let stdlibFiles = collectStdlibFiles()

	var allModule = MaxonModule.create()
	let stdlibRoot = findStdlibProjectRoot()

	// Pre-parse builtin-literal discovery across ALL stdlib files, before any
	// body is parsed. The single-pass per-file parse discovers each
	// `implements Builtin*Literal` conformance only when it reaches that type's
	// own decl, so a `match`/literal in a file sorted before the implementor
	// (e.g. `Ascii.maxon`'s Character `match` vs `Character.maxon`) would see an
	// empty cache and mis-lower. Seeding the caches up front closes that gap.
	// Mirrors the `preRegisterInterfaceNames` / `preRegisterFunctionThrows`
	// cross-file prescans on the user-file path.
	prescanStdlibBuiltinLiteralTypes(project, stdlibFiles: stdlibFiles, stdlibRoot: stdlibRoot)

	let parseStart = passTimerStart()
	for fp in stdlibFiles 'eachFile'
		if File.exists(fp) 'exists'
			let content = try File.readText(fp) otherwise 'readErr'
				logDebug(LogCategory.compiler, message: function() gives "  Failed to read {fp}")
				continue
			end 'readErr'
			parseStdlibSource(project, allModule: allModule, filePath: fp, rootPath: stdlibRoot, content: content)
		end 'exists'
	end 'eachFile'
	recordPassSince("__stdlib-parse", startMs: parseStart)
	// Drain cross-file overload renames produced by `rekeyExistingFunction`
	// when a late-parsed file overloaded a sibling's function name. The
	// per-file parser couldn't reach the IrFunction sitting in `allModule`,
	// so the rename was queued; apply it now before the cache build keys
	// off `.name`.
	applyPendingFuncRenames(project, allModule: allModule)
	// G.2: validate every `<TypeName>.fromRawValue(...)` /
	// `<TypeName>.fromName(...)` call the parser optimistically rewrote
	// to `__enum_<TypeName>_fromRawValue` / `__enum_<TypeName>_fromName`.
	// See `validateEnumLookupCalls` for the synth-/diagnose-/restore
	// contract; this must run before the cache build because codegen
	// would otherwise panic on an unrewritten callee.
	validateEnumLookupCalls(project, allModule: allModule)
	var missLib = stdlibLib()
	missLib.cachedModule = allModule
	// J.4e: do NOT stash the just-parsed module here. The `allModule` we
	// just produced is about to be mutated in-place by
	// `buildAndWriteStdlibCache` below — the stdlib pipeline's DCE pass
	// prunes unreachable blocks from each stdlib function's `blockRefs`
	// while leaving their `nextBlockId` and the Maxon-form terminator ops
	// pointing at the pruned ids. If we stashed `allModule` here and a
	// later user compile in this process asked the monomorphizer to clone
	// a stdlib extension method (e.g. `Iterable.map` -> `Array.map`), the
	// cloner would copy the post-DCE `blockRefs` (sparse) but inherit the
	// pre-DCE Maxon-form terminators (referencing pruned ids), producing a
	// cloned function whose `cf.br`/`cf.condBr` targets blocks that don't
	// exist — Mem2Reg's `findBlockById` then panics.
	//
	// Instead, let `getStdlibParsedModule` trigger a fresh parse on demand
	// (see `ensureStdlibSandboxParsed`). The lazy re-parse runs in its own
	// sandbox project and is invariant against downstream pipeline
	// mutation.

	// Snapshot the just-parsed library's typealiases (+ visibility / range /
	// cast-category sidecars) off `project` into the Library so a same-process
	// cache hit can restore them without re-parsing (the `restoreFromParse` leg
	// in `getStdlibModule`). Shared with `registerExternalLibrary`.
	snapshotTypealiasesInto(missLib, project: project)
	setStdlibLib(missLib)

	// Build and write the stdlib cache for next time, then switch to cached
	// mode so subsequent calls in the same process (e.g. spec tests)
	// consistently use the pre-compiled path. `buildAndWriteStdlibCache`
	// mutates the registry (cacheData / inlinerStdModule / funcEdges), so
	// re-read a fresh snapshot afterward before the final scalar writes.
	buildAndWriteStdlibCache(project, allModule: allModule, metaPath: metaPath, cachePath: cachePath, contentChecksum: contentChecksum)
	var doneLib = stdlibLib()
	doneLib.loaded = true

	// The user binary picks up stdlib via the pre-compiled cache (linked at
	// codegen) plus the metadata already restored on this project, so the
	// parsed module must NOT flow into the user pipeline — otherwise
	// emitWasm/x64 sees the same stdlib functions twice (once from the IR and
	// once from the cache) and the wasm validator rejects the duplicate
	// definitions. Return an empty module.
	doneLib.cachedModule = MaxonModule.create()
	setStdlibLib(doneLib)
	return stdlibLib().cachedModule
end 'getStdlibModule'

// Snapshot a just-parsed library's typealiases and their visibility / range /
// cast-category sidecars off `project` into `lib`'s own maps (mutated in place;
// the caller writes `lib` back into the registry). On a same-process cache hit
// these are restored without re-parsing (the `restoreFromParse` leg of
// `getStdlibModule`). Factored out of the stdlib miss path so
// `registerExternalLibrary` reuses exactly the same capture.
function snapshotTypealiasesInto(lib Library, project Project)
	for (name, baseType) in project.typealiases 'cacheAliases'
		lib.typealiases.upsert(name, value: baseType)
	end 'cacheAliases'
	for (name, infos) in project.typealiasVisibilities 'cacheAliasVis'
		var copied = TypealiasVisibilityInfoArray.create()
		for info in infos 'eachInfo'
			copied.push(info)
		end 'eachInfo'
		lib.typealiasVisibilities.upsert(name, value: copied)
	end 'cacheAliasVis'
	for (name, range) in project.typealiasRanges 'cacheRanges'
		lib.typealiasRanges.upsert(name, value: range)
	end 'cacheRanges'
	for (name, category) in project.typealiasCastCategories 'cacheCategories'
		lib.typealiasCastCategories.upsert(name, value: category)
	end 'cacheCategories'
end 'snapshotTypealiasesInto'

// ============================================================
// Phase 6: external library discovery
// ============================================================

// Recursively collect every `.maxon` file under an external library's root, in
// the same DETERMINISTIC byte-wise-lexicographic order `collectStdlibFiles`
// uses (spike A2) so the cache build is reproducible across machines/checkouts.
function collectLibraryFiles(rootDir FilePath) returns FilePathArray
	var files = FilePathArray.create()
	if rootDir.isEmpty() or not Directory.exists(rootDir) 'noDir'
		return files
	end 'noDir'
	collectMaxonFilesUnder(rootDir, into: files)
	return sortFilePathsAscending(files)
end 'collectLibraryFiles'

// Cache key for an external library: an FNV over every `.maxon` file the walk
// surfaces. Unlike the stdlib checksum it folds in NO runtime.std — external
// libraries carry no runtime bodies (they resolve `mrt_*`/`mm_*` by name against
// stdlib's cache via the Phase-4 union), so only their own sources affect their
// bytes. Empty `runtimePath` keeps `computeStdlibChecksum`'s runtime byte-mix a
// no-op.
function currentLibraryChecksum(rootDir FilePath) returns CacheChecksum
	return computeStdlibChecksum(collectLibraryFiles(rootDir), runtimePath: FilePath from "")
end 'currentLibraryChecksum'

// Result of `findLibraryByName`: found (with its registry index) or absent.
// Avoids a `-1` sentinel index (mirrors `SoleValidLibrary`).
type LibraryLookup
	export let found as bool
	export let index as LibraryIndex

	export static function missing() returns LibraryLookup
		return Self{found: false, index: 0}
	end 'missing'

	export static function at(index LibraryIndex) returns LibraryLookup
		return Self{found: true, index: index}
	end 'at'
end 'LibraryLookup'

// Find a registered library by name. Linear scan over the handful of
// registered libraries.
function findLibraryByName(name String) returns LibraryLookup
	for i in 0 upto libraryRegistry.libs.count() 'eachLib'
		let lib = try libraryRegistry.libs.get(i) otherwise continue
		if lib.name == name 'match'
			return LibraryLookup.at(i)
		end 'match'
	end 'eachLib'
	return LibraryLookup.missing()
end 'findLibraryByName'

// Raised when two distinct library directories resolve to the same basename
// (their dir-derived namespaces would alias, so symbols can't be disambiguated).
export union LibraryError implements Error
	duplicateName(name String)
	directoryNotFound(path FilePath)
	parseError(path FilePath)
end 'LibraryError'

// Phase 6: discover, build/load, and register an external library so its
// `export` symbols become globally visible to the user build (implicit import —
// no new syntax) and its bytecode/metadata flow through the Phase-4 combined
// accessors. Idempotent per process: a second call for an already-registered
// library (same basename) is a no-op. Throws `LibraryError.duplicateName` if a
// DIFFERENT directory already claimed this basename (the name-collision hard
// rule — dir-derived namespaces mean a basename clash would alias two
// libraries' namespaces).
//
// The library's cache lives in its OWN dir (`<rootDir>/.maxon/cache/`), shared
// across projects, mirroring stdlib. `rootDir` is BOTH the namespace anchor
// (its basename is the top namespace segment) and the cache-dir root.
export function registerExternalLibrary(project Project, rootDir FilePath, target Target) throws LibraryError
	let name = rootDir.filename()
	let existing = findLibraryByName(name)
	if existing.found 'already'
		let other = try libraryRegistry.libs.get(existing.index) otherwise panic("registerExternalLibrary: index {existing.index} vanished")
		// Same dir re-registered → idempotent no-op. Different dir, same
		// basename → a hard collision (the namespaces would alias).
		if other.rootPath.toString() == rootDir.toString() 'sameDir'
			return
		end 'sameDir'
		throw LibraryError.duplicateName(name)
	end 'already'

	// The user-program registry slot is NOT pre-allocated (the user program is
	// not a registry entry — Phase 5's chunk cache is project-private), so an
	// external library is pushed at the current tail. stdlib is index 0; the
	// first external library is index 1, etc.
	let libIndex = libraryRegistry.libs.count()
	libraryRegistry.libs.push(Library.create(name, rootPath: rootDir, cacheDirRoot: rootDir, isStdlib: false))

	// `registerBuiltinTypeBootstrap` is the language runtime surface (every
	// project needs it) and is idempotent, so it's already been applied by the
	// stdlib path on this project; calling it again is a safe no-op. We do NOT
	// call `registerInternalsIntrinsicSignatures` / `seedRuntimeBootstrapStdlibRoots`
	// (both stdlib-only).
	registerBuiltinTypeBootstrap(project)

	let metaPath = libraryMetaCachePath(try libraryRegistry.libs.get(libIndex) otherwise panic("registerExternalLibrary: index {libIndex} vanished"), target: target, rcSanitize: project.rcSanitizeEnabled, cacheRootOverride: project.cacheRootOverride)
	let cachePath = libraryCachePath(try libraryRegistry.libs.get(libIndex) otherwise panic("registerExternalLibrary: index {libIndex} vanished"), target: target, rcSanitize: project.rcSanitizeEnabled, cacheRootOverride: project.cacheRootOverride)
	let contentChecksum = currentLibraryChecksum(rootDir)
	let cacheResult = readStdlibCache(project, metaPath: metaPath, targetPath: cachePath, target: target, expectedChecksum: contentChecksum)

	if cacheResult.valid 'cacheHit'
		logInfo(LogCategory.compiler, message: function() gives "Library cache hit ({name}): {countCompiledStdlibFunctions(cacheResult.data)} functions cached")
		activateLibraryCache(libIndex, data: cacheResult.data, target: target)
		setLibraryCacheMetaHash(libIndex, metaHash: cacheResult.metaHash)
		restoreLibraryMetadata(project, libIndex: libIndex)
		var hitLib = try libraryRegistry.libs.get(libIndex) otherwise panic("registerExternalLibrary: index {libIndex} vanished at hit publish")
		hitLib.inlinerStdModule = cacheResult.data.inlinerStdModule
		hitLib.funcEdges = cacheResult.data.stdFuncEdges
		hitLib.cachedModule = MaxonModule.create()
		hitLib.loaded = true
		try libraryRegistry.libs.set(libIndex, value: hitLib) otherwise panic("registerExternalLibrary: index {libIndex} vanished at hit publish")
		return
	end 'cacheHit'

	logInfo(LogCategory.compiler, message: function() gives "Library cache miss ({name}): compiling from source")

	let libFiles = collectLibraryFiles(rootDir)
	var allModule = MaxonModule.create()
	for fp in libFiles 'eachFile'
		if File.exists(fp) 'exists'
			let content = try File.readText(fp) otherwise 'readErr'
				logDebug(LogCategory.compiler, message: function() gives "  Failed to read {fp}")
				continue
			end 'readErr'
			// External library files parse with the library's own root as the
			// namespace anchor (so `<lib>/api/types.maxon` → namespace `<lib>.api`).
			// UNLIKE stdlib, external library source is USER input, not trusted —
			// a lex/parse error is a user error to diagnose, not a compiler-bug
			// panic. `parseLibrarySource` reports diagnostics and returns false on
			// failure; we surface the first failure to the caller as a thrown
			// `directoryNotFound`-style error so the build stops cleanly.
			let ok = parseLibrarySource(project, allModule: allModule, filePath: fp, rootPath: rootDir, content: content)
			if not ok 'parseFailed'
				throw LibraryError.parseError(fp)
			end 'parseFailed'
		end 'exists'
	end 'eachFile'
	applyPendingFuncRenames(project, allModule: allModule)
	validateEnumLookupCalls(project, allModule: allModule)

	var missLib = try libraryRegistry.libs.get(libIndex) otherwise panic("registerExternalLibrary: index {libIndex} vanished at parse")
	missLib.cachedModule = allModule
	snapshotTypealiasesInto(missLib, project: project)
	try libraryRegistry.libs.set(libIndex, value: missLib) otherwise panic("registerExternalLibrary: index {libIndex} vanished at parse")

	buildAndWriteLibraryCache(project, allModule: allModule, metaPath: metaPath, cachePath: cachePath, contentChecksum: contentChecksum, libIndex: libIndex)
	// Restore the freshly-built library's metadata into THIS project so the
	// user pipeline can name + type-check against it (the cache-hit path above
	// restores it from disk; the from-source path restores it from the just-
	// activated in-memory cacheData — same seam).
	restoreLibraryMetadata(project, libIndex: libIndex)

	var doneLib = try libraryRegistry.libs.get(libIndex) otherwise panic("registerExternalLibrary: index {libIndex} vanished at done")
	doneLib.loaded = true
	// Like stdlib, the external library is linked from its pre-compiled cache,
	// so its parsed module must NOT flow into the user pipeline (it would emit
	// every function twice). Return an empty module from `getLibraryModule`.
	doneLib.cachedModule = MaxonModule.create()
	try libraryRegistry.libs.set(libIndex, value: doneLib) otherwise panic("registerExternalLibrary: index {libIndex} vanished at done")
end 'registerExternalLibrary'

// The (empty) module an already-registered external library contributes to
// `queryAllModule`. Libraries are linked from their cache, so — exactly like
// stdlib — they return an empty MaxonModule (their functions live in the cache,
// not the user pipeline's IR). Present as a seam for symmetry with
// `getStdlibModule` and a future lazy-parse path.
export function getLibraryModule(libIndex LibraryIndex) returns MaxonModule
	return (try libraryRegistry.libs.get(libIndex) otherwise panic("getLibraryModule: registry index {libIndex} missing")).cachedModule
end 'getLibraryModule'

// The number of registered libraries (stdlib + every external library). Drives
// `queryAllModule`'s per-library merge loop and `maxon clean`'s full-set sweep.
export function registeredLibraryCount() returns ElementCount
	return libraryRegistry.libs.count()
end 'registeredLibraryCount'

// True when `namespace` is the namespace anchor (or a sub-namespace) of any
// registered library — stdlib OR an external library. Generalizes
// `isStdlibNamespace`. Used to gate library-only behaviors (e.g. the Internals
// carve-out stays stdlib-only via `isStdlib`, but namespace-level checks use
// this).
function isLibraryNamespace(namespace String) returns bool
	for i in 0 upto libraryRegistry.libs.count() 'eachLib'
		let lib = try libraryRegistry.libs.get(i) otherwise continue
		if lib.name == namespace or namespace.startsWith("{lib.name}.") 'match'
			return true
		end 'match'
	end 'eachLib'
	return false
end 'isLibraryNamespace'

// Build the stdlib cache by compiling the parsed MaxonModule through the mid
// pipeline + metadata capture. v80: on NATIVE targets it writes the cache
// metadata-only (signature stubs, no eager regalloc — the ~7.8s backend tail
// over ~992 functions is deferred to lazy per-function codegen at link time),
// then eagerly compiles just the universal runtime floor; on WASM it emits
// every function eagerly (wasm has no lazy path — see the emit block below).
// Phase-2 backward-compat wrapper: the stdlib is the library at registry index
// 0. `getStdlibModule` / `loadCacheForTarget` call this name unchanged; it
// delegates to the index-parameterized `buildAndWriteLibraryCache` so the
// stdlib build path stays byte-untouched.
function buildAndWriteStdlibCache(project Project, allModule MaxonModule, metaPath FilePath, cachePath FilePath, contentChecksum CacheChecksum)
	buildAndWriteLibraryCache(project, allModule: allModule, metaPath: metaPath, cachePath: cachePath, contentChecksum: contentChecksum, libIndex: 0)
end 'buildAndWriteStdlibCache'

// Phase 6: build and write a registered library's cache (Tier A metadata + Tier
// B inlinable Std IR + Tier C linkable bytecode) by compiling its parsed
// MaxonModule through the mid pipeline + metadata capture. Generalizes the old
// stdlib-only `buildAndWriteStdlibCache` over the registry index. The library's
// `isStdlib` flag (read from the registry) gates the three stdlib-only legs:
//   - the native runtime-body splice (external libs resolve `mrt_*`/`mm_*` by
//     name against stdlib's cache through the Phase-4 union — they carry no
//     runtime bodies of their own),
//   - the metadata-only signature-stub + lazy-floor native emit (v80 lazy
//     codegen is stdlib-pinned process-global state; external libs emit their
//     full native bytecode eagerly here instead),
//   - the eager runtime FLOOR compile (stdlib-only — external libs have no
//     floor).
// Everything else — the shared mid/late pass pipeline, metadata capture, and
// the two-file cache write — is identical for every library. At `libIndex == 0`
// with `isStdlib == true` the behavior is byte-identical to the old function.
function buildAndWriteLibraryCache(project Project, allModule MaxonModule, metaPath FilePath, cachePath FilePath, contentChecksum CacheChecksum, libIndex LibraryIndex)
	let buildingLib = try libraryRegistry.libs.get(libIndex) otherwise panic("buildAndWriteLibraryCache: registry index {libIndex} missing")
	let isStdlib = buildingLib.isStdlib
	let libName = buildingLib.name
	var globalData = createGlobalDataTable()
	let sourceFileName = ""

	// Capture the external library's OWN function names BEFORE the pipeline runs.
	// The pipeline pulls in stdlib bodies (monomorphized generics, inlined
	// accessors) via the project's restored stdlib state, so `pipeline.mirModule`
	// after lowering carries far more than the library defines. Those stdlib
	// functions already live in stdlib's cache; re-emitting them into THIS
	// library's cache would duplicate definitions at link. So an external lib
	// emits only the functions it declares (`ownFuncNames`). (stdlib is the base
	// library — it emits everything, so this set is unused on the stdlib path.)
	var ownFuncNames = StringSet.create()
	if not isStdlib 'collectOwn'
		for func in allModule.functions 'eachOwn'
			ownFuncNames.insert(func.name)
		end 'eachOwn'
	end 'collectOwn'

	// `isStdlib` gates the semantic-check skips (stdlib source is trusted and
	// has no `main()`); it no longer affects panic-message labels (those are
	// content-hashed and dedupe across pipelines — see `panicLabelFor`).
	var pipeline = PassPipeline.create(allModule, project: project, globalData: globalData, target: project.target, sourceFileName: sourceFileName, isStdlib: isStdlib)

	// Phases 2-5: shared across all targets (through MIR)
	// resolveTypes drains the unresolvedTypealiases registry (populated by
	// the stdlib parse) into the resolved typealiases/typealiasRanges maps
	// so lowerMaxonToStd can look up named types successfully.
	// Skip semanticCheck — it requires main() which stdlib doesn't have
	pipeline.addPass(PassKind.resolveTypes)
	// Splice `__field_init_<field>` calls for every defaulted field a stdlib
	// `Self{...}` literal omits, exactly as the user pipeline does. Without
	// this, a stdlib container's `Self{}` (e.g. `Map.create`'s empty literal)
	// only gets its managed fields NULL-initialized by `lowerStructAlloc`'s
	// `synthesizeManagedFieldInits`; scalar-default fields like `count`/`capacity`
	// are left holding whatever bytes `mrt_alloc_with_dtor` (which does NOT
	// zero-fill) hands back. A reused slab slot then leaves `capacity` non-zero,
	// so `Map.findSlot` skips its `capacity == 0` early-out and dereferences the
	// still-NULL `states` array, faulting. `MaxonFieldInitCheck` self-gates on
	// `isStdlib` (splices the inits but skips E3086 + the static-factory
	// rewrite), so running it here is safe. Must run after resolveTypes (needs
	// resolved field lists) and before lowerMaxonToStd (which consumes the
	// spliced fieldStore ops).
	pipeline.addPass(PassKind.fieldInitCheck)
	// Phase 11.2 / 11.3: emit layout descriptors and witness tables for
	// every interned generic instance / conformance the stdlib parse
	// produced. lowerMaxonToStd's `materializeLayoutArg` reads
	// `project.layoutDescriptors` at every generic-method call site, so
	// without these passes stdlib lowering panics with a
	// "no descriptor for gid …" tripwire on the first such call.
	pipeline.addPass(PassKind.buildLayoutDescriptors)
	pipeline.addPass(PassKind.buildWitnessTables)
	// Expand parser-emitted `castCheck` placeholders before lowering so
	// stdlib's own `as RangedAlias` casts get their runtime guards.
	pipeline.addPass(PassKind.expandCastRangeChecks)
	pipeline.addPass(PassKind.constantArrayLiteralRdata)
	pipeline.addPass(PassKind.lowerMaxonToStd)
	// No maxonBorrowCheck in the stdlib sandbox — stdlib is exempt from the
	// E3070 borrow check (user code can't fix it, and the bootstrap skips it).
	pipeline.addPass(PassKind.mem2reg)
	pipeline.addPass(PassKind.canonicalize)
	pipeline.addPass(PassKind.cse)
	pipeline.addPass(PassKind.licm)
	pipeline.addPass(PassKind.dce)
	// Argument-consume analysis (Concept C) — compute the stdlib's structural
	// per-parameter consume facts on the FULL stdlib call graph (every container
	// body present, nothing inlined away here), so they can be PERSISTED in the cache
	// (`captureStdlibMetadata`) and restored into the user project. Without this the
	// user build's consuming stdlib callees are signature-only stubs with no body to
	// analyze, leaving `funcParamConsumes` empty and forcing the inserter onto the
	// retired callee-name allowlists. Must run before `insertRefcounts` (which reads
	// the facts to suppress a consumed arg's release).
	pipeline.addPass(PassKind.analyzeParamConsumes)
	// Return-borrow analysis (Concept C's return-side dual) — compute the stdlib's
	// structural return-borrow facts on the FULL stdlib call graph so they can be
	// PERSISTED in the cache (`captureStdlibMetadata` → `funcReturnsBorrow`) and
	// restored into the user project. The bodyless element-loader intrinsics
	// (`__managed_mem_get` → `__managed_mem_load_sized` → `__Internals.loadIndirect`)
	// ARE real Maxon functions whose bodies return a param-derived `load`, so the
	// structural leaf rule classifies them borrow-returning HERE (where their bodies are
	// present) — replacing the `calleeIsBorrowIntrinsic` name allowlist the user build
	// fell back on (the user module sees them only as bodyless external calls). Must run
	// after `analyzeParamConsumes` (its container-consume narrowing reads the consume
	// set) and before `insertRefcounts` (which reads the borrow classes).
	pipeline.addPass(PassKind.analyzeReturnBorrows)
	// SSA refcount inserter (post-mem2reg) — the retired pre-mem2reg injectDrops's
	// replacement; runs on the SSA form from per-value liveness + ownership class.
	pipeline.addPass(PassKind.insertRefcounts)
	// Skip insertRangeChecks — it emits mrt_panic calls that require runtime
	// functions, but stdlib functions take validated inputs from their callers.
	pipeline.addPass(PassKind.lowerABI)

	// Run Phase 4 passes first; runtime bodies (already-Std, post-mem2reg
	// from loadRuntimeModule) get spliced in next so they ride through
	// lowerStdToMir + backend phases the same way stdlib bodies do.
	//
	// Stdlib content is trusted: a pipeline failure here is a compiler bug
	// (an unsupported language feature reached lowering, or a pass crashed
	// on a stdlib-only shape). Surfacing it as a panic prevents the cache
	// from silently rolling forward in a half-built state where downstream
	// user code dispatches to phantom witnesses or missing builtin methods.
	try pipeline.run() otherwise panic("Stdlib cache build failed during mid pipeline; see error diagnostics above")

	// Detach the post-dce snapshot before merging runtime bodies. The
	// snapshot and `pipeline.stdModule` share array references — mutating
	// one mutates the other — and the user-pipeline inliner reads the
	// snapshot as its source of stdlib bodies. If runtime bodies leak into
	// the snapshot, the inliner inlines runtime helpers (mm_alloc, the
	// __slab_* family) into user `main`, both bloating user code and
	// breaking the linker's expectation that runtime callees resolve
	// through the cached ObjectFunctions by name.
	var detachedSnapshot = StdModule.create()
	detachedSnapshot.merge(pipeline.stdModulePostDceSnapshot)
	pipeline.stdModulePostDceSnapshot = detachedSnapshot

	let isWasm = project.target.cpu == CpuArch.wasm32

	// Splice runtime bodies into the stdlib StdModule on native targets.
	// The cache then emits ObjectFunctions for the ~46 project-independent
	// runtime functions (mrt_panic, mrt_write_*, __slab_*, mm_*,
	// __managed_mem_*, __layout_word_*, __destruct_*) — the linker pulls
	// them in by name when user code references them. The per-compile
	// names (entry-point variants and coverage helpers) stay out because
	// `patchMrtStartWithModuleInits` and the coverage globals are project-
	// specific and applied freshly per user compile.
	//
	// WASM emission stays on the old "runtime emitted by user pipeline"
	// path because the wasm `call_indirect` instruction encodes a type-
	// section index inline in the body bytes — caching wasm runtime bodies
	// would require a fixup mechanism similar to `callFixups` for those
	// type indices, plus walking stdlib/runtime indirect-call types in
	// `emitWasmModule`'s type-section build. The win on wasm is also
	// smaller because wasm doesn't go through commuteForCoalescing /
	// scheduleInstructions / lowerMirToTarget / allocateRegisters.
	// STDLIB-ONLY: only stdlib's cache carries the project-independent runtime
	// bodies. External libraries' calls into `mrt_*`/`mm_*`/`__slab_*` resolve
	// by name against stdlib's cache through the Phase-4 combined union at link
	// time, so they must NOT splice (or re-emit) runtime bodies of their own.
	if isStdlib and not isWasm 'spliceRuntime'
		let runtimeForCache = buildCacheSideRuntime(loadRuntimeModule())
		pipeline.stdModule.merge(runtimeForCache)
	end 'spliceRuntime'

	// Continue through Phase 5+: lowerStdToMir converts the merged module
	// (stdlib functions + runtime bodies on native, stdlib only on wasm)
	// to MIR. Reset the pass list and re-run on the same pipeline so the
	// stdModule, mirModule, and project state stay coherent.
	pipeline.passes = PassKindArray.create()
	pipeline.addPass(PassKind.lowerStdToMir)

	if not isWasm 'nativePasses'
		pipeline.addPass(PassKind.commuteForCoalescing)
		pipeline.addPass(PassKind.scheduleInstructions)
	end 'nativePasses'

	try pipeline.run() otherwise panic("Stdlib cache build failed during late pipeline; see error diagnostics above")

	// On wasm, restore the old `injectRuntimeSignatures` post-MIR fixup so
	// stdlib calls into runtime resolve at backend lowering time. The
	// per-target filter below strips runtime stubs back out before cache
	// write, mirroring the pre-change wasm behavior.
	if isWasm 'injectWasmRuntimeSigs'
		injectRuntimeSignatures(pipeline.mirModule)
	end 'injectWasmRuntimeSigs'

	// Phase 11.6 cross-module inlining: capture the stdlib's post-dce
	// StdModule (PassPipeline.stdModulePostDceSnapshot is populated at the
	// `dce` step's exit) for the user pipeline's inliner to consume.
	// Stored both in-process (so the immediately-following user pipeline
	// run sees it) and into the cache buffer (for next-run cache hits).
	// Captured pre-runtime-merge so the inliner doesn't see runtime bodies
	// it would never inline anyway (panic-helper gate, splice-shape limits).
	// v68: extract each snapshot function's Std-DFE edges once (a pure
	// function of the body) so the load-time Std-DFE consults a flat table
	// instead of re-walking the snapshot. Both the StdModule snapshot and the
	// edge table are published into the registry's Library (for the
	// immediately-following user pipeline run) and into the cache buffer (for
	// next-run cache hits).
	let stdFuncEdges = buildStdFuncEdgeMap(pipeline.stdModulePostDceSnapshot)
	var edgeLib = try libraryRegistry.libs.get(libIndex) otherwise panic("buildAndWriteLibraryCache: registry index {libIndex} missing at edge publish")
	edgeLib.inlinerStdModule = pipeline.stdModulePostDceSnapshot
	edgeLib.funcEdges = stdFuncEdges
	try libraryRegistry.libs.set(libIndex, value: edgeLib) otherwise panic("buildAndWriteLibraryCache: registry index {libIndex} vanished at edge publish")

	// Build cache data
	let metaStart = passTimerStart()
	var cacheData = StdlibCacheData.create()
	cacheData.globalData = pipeline.globalData
	captureStdlibMetadata(project, data: cacheData)
	cacheData.inlinerStdModule = pipeline.stdModulePostDceSnapshot
	cacheData.stdFuncEdges = stdFuncEdges
	// v84 (Phase 7): record each function's post-inline content hash + declaring
	// file so a later incremental rebuild can PRESERVE the Tier-C bytecode of
	// functions whose hash is unchanged (`preserveUnchangedTierC`). Iterates the
	// SAME `pipeline.mirModule` the stub/emit pass below iterates, so the keyspace
	// matches the cache's `functions` / `wasmFunctions` exactly.
	captureFuncContentHashes(project, data: cacheData)
	recordPassSince("__stdlib-captureMetadata", startMs: metaStart)

	// Emit per-function bytecode (dispatched by target).
	//
	// v80 lazy codegen: on the metadata-only cold path, SKIP all per-function
	// regalloc + emit (the ~7.8s `buildStdlibNativeWith` cost over ~992
	// functions). `cacheData.functions` holds signature-only stubs; the user
	// build compiles each reached function on demand at link time (see
	// `ensureStdlibFunctionsCompiled`), filling the stubs' real bytecode.
	// Everything ABOVE this point (metadata,
	// `inlinerStdModule` Std-IR snapshot, `stdFuncEdges`, the merged-MIR
	// `pipeline.mirModule` that the in-process lazy-fill reuses) is still
	// produced in full — only the expensive backend tail is deferred.
	//
	// Native: the merged stdModule contains runtime bodies (excluding
	// per-compile names — entry-point variants and coverage helpers); they
	// lower into ObjectFunctions identically to stdlib bodies, and the
	// linker pulls them by name when user code references them. The
	// per-compile filter strips empties for those names defensively.
	// Wasm: runtime bodies are NOT in the pipeline (signatures only via
	// `injectRuntimeSignatures`); the user pipeline supplies them. Strip
	// every runtime function from the cache so the empty stubs the wasm
	// emitter produces for runtime signatures don't shadow real bodies.
	// Native (x64/arm64): write SIGNATURE-ONLY stubs (name + return type + param
	// types, empty code/fixups) for every function — NO eager regalloc/emit (the
	// ~7.8s cost over ~992 functions is deferred). The stubs let the user
	// build's per-function target lowering resolve callee signatures via
	// `findCalleeSignature`'s `stdlibFunctions` fallback (runtime callees like
	// `__gt_init` aren't in the user module on a valid native cache). Lazy
	// codegen fills each reached stub's real code in place at link time
	// (`ensureStdlibFunctionsCompiled`). Stubs carry no callFixups, so the
	// linker's fixup-closure (`computeNeededStdlibFunctions`) never traverses a
	// stub — the edge-map closure (`lazyNeededClosure`) drives compilation, then
	// the linker sees real fixups on the filled-in entries.
	//
	// Wasm stays EAGER: its runtime sigs come from the user pipeline's
	// `injectRuntimeSignatures` (not the cache), so the native signature-stub +
	// lazy-backend mechanism doesn't apply. Emit every wasm function now.
	if isWasm and isStdlib 'emitWasmStdlib'
		let wasmEmitStart = passTimerStart()
		// stdlib emits every non-runtime function (its module defines every callee
		// it references). v84 (Phase 7): on a REBUILD, PRESERVE the unchanged wasm
		// bodies from the prior on-disk cache (gated on the per-function content
		// hash) and EMIT only the changed/new functions — the wasm analogue of the
		// native preservation. Wasm is eager (no lazy path), so the preserved bodies
		// are full bytecode; their name-keyed fixups re-resolve at final link.
		cacheData.wasmFunctions = preserveUnchangedWasm(pipeline.mirModule, globalData: pipeline.globalData, newHashes: cacheData.funcContentHash, oldTargetPath: cachePath, target: project.target)
		recordPassSince("__stdlib-emitWasm", startMs: wasmEmitStart)
		logInfo(LogCategory.compiler, message: function() gives "Wrote library cache ({libName}): {cacheData.wasmFunctions.count()} WASM functions to {cachePath}")
	end 'emitWasmStdlib' else if isWasm 'emitWasmExternal'
		// EXTERNAL LIBRARY wasm: emit ONLY the library's own functions. The
		// pipeline pulled stdlib bodies into `pipeline.mirModule`, but those live
		// in stdlib's own cache — re-emitting would double-define at link. Wasm
		// cached functions are name-relocatable: their `callFixups` / `typeFixups`
		// / `funcAddrFixups` / `globalAddrFixups` store NAMES (not baked indices)
		// and are re-resolved at final link (`emitWasmModule`) against the merged
		// function / type / data tables, so the library's functions link against
		// stdlib's separately-cached bodies by name — exactly like the native path.
		// Seed `extraCalleeSigs` from stdlib's cached wasm functions so a callee a
		// library body references but that wasn't pulled into the library's MIR
		// still gets a placeholder index minted at emit time (overwritten at link).
		let wasmEmitStart = passTimerStart()
		let stdlibWasm = (try libraryRegistry.libs.get(0) otherwise panic("buildAndWriteLibraryCache: stdlib (index 0) not registered for wasm extern emit")).cacheData.wasmFunctions
		cacheData.wasmFunctions = emitWasmPerFunctionFiltered(pipeline.mirModule, globalData: pipeline.globalData, onlyOwnNames: ownFuncNames, emitAll: false, extraCalleeSigs: stdlibWasm).filter(function(func) gives not isRuntimeFunctionName(func.name))
		recordPassSince("__stdlib-emitWasm", startMs: wasmEmitStart)
		logInfo(LogCategory.compiler, message: function() gives "Wrote library cache ({libName}): {cacheData.wasmFunctions.count()} WASM functions to {cachePath}")
	end 'emitWasmExternal' else if isStdlib 'nativeStubs'
		// STDLIB native: write SIGNATURE-ONLY stubs (v80 lazy codegen). The user
		// build fills each reached stub's real bytecode on demand at link time.
		cacheData.functions = buildSignatureStubs(pipeline.mirModule)
		// v84 (Phase 7): on a REBUILD (the old target file is still on disk at
		// `cachePath` until the write below overwrites it), preserve the
		// lazily-compiled Tier-C bytecode of every function whose content hash is
		// unchanged — filling its fresh stub slot with the real body instead of
		// throwing it away and forcing a re-regalloc. The per-function content
		// hash is the gate (a changed function's hash flips; an inlined-callee
		// change flips the caller's hash too, because the hash is op-content-deep
		// over the post-DCE Std IR the body lowers from). No-op on a first-ever
		// cold build (no old file).
		preserveUnchangedTierC(cacheData, oldTargetPath: cachePath, target: project.target)
		logInfo(LogCategory.compiler, message: function() gives "Wrote stdlib cache (metadata-only): {cacheData.functions.count()} signature stubs, bytecode compiled lazily on demand -> {cachePath}")
	end 'nativeStubs' else 'nativeEager'
		// EXTERNAL LIBRARY native: emit every function's full bytecode EAGERLY.
		// The v80 lazy-codegen machinery is stdlib-pinned process-global state
		// (`lazyStdlibMir*`), so an external lib cannot use the signature-stub +
		// lazy-fill path. Eager emit is sound: an external function's calls into
		// stdlib/runtime resolve by name through `combinedLibraryCache()`'s
		// name-keyed union at link time, and the external lib carries no runtime
		// bodies of its own. (Phase 7 generalizes the lazy state per-library.)
		cacheData.functions = emitLibraryNativeEager(pipeline.mirModule, target: project.target, globalData: pipeline.globalData, ownFuncNames: ownFuncNames, fastRegalloc: project.fastRegalloc)
		logInfo(LogCategory.compiler, message: function() gives "Wrote library cache ({libName}): {cacheData.functions.count()} native functions to {cachePath}")
	end 'nativeEager'

	// Write to disk and activate cache for subsequent compilations in this process.
	// Phase 3: the cold build produces full Tier A+B+C, so it writes BOTH files —
	// the shared meta file first (returning the content-hash) and the per-target
	// file stamped with that hash. The meta-hash is recorded on the stdlib Library
	// so a later cross-compile to another target can pair its target file with the
	// SAME meta file (see `loadCacheForTarget`).
	let writeStart = passTimerStart()
	let metaHash = writeLibraryMetaCache(metaPath, data: cacheData, target: project.target, contentChecksum: contentChecksum)
	if metaHash != 0 'metaWritten'
		writeLibraryTargetCache(cachePath, data: cacheData, target: project.target, contentChecksum: contentChecksum, metaHash: metaHash)
	end 'metaWritten'
	setLibraryCacheMetaHash(libIndex, metaHash: metaHash)
	recordPassSince("__stdlib-writeCache", startMs: writeStart)
	activateLibraryCache(libIndex, data: cacheData, target: project.target)

	// STDLIB-ONLY: on native, eagerly compile the universal runtime FLOOR (the
	// functions every native program links — the `mrt_*`/`mm_*`/`__slab_*`
	// runtime + entry machinery) into the just-written cache. This runs in the
	// STDLIB BUILD project, whose interner holds the metadata's constant string
	// ids, so the re-serialize (inside `ensureStdlibFunctionsCompiled`, when
	// persist is allowed) is safe. The payoff: the very next build of ANY program
	// finds the floor already compiled on disk and lazily compiles nothing for a
	// stdlib-free program — a sub-500ms warm `return 0`. Program-specific
	// functions a user build reaches beyond the floor are compiled (and, on a CLI
	// build, persisted) lazily by the user-build link path. External libraries
	// emit all their bytecode eagerly above and have no runtime floor, so they
	// skip this entirely.
	if isStdlib and not isWasm 'eagerFloor'
		var floorSeeds = StringArray.create()
		appendX64EagerFloorSeeds(floorSeeds, os: project.target.os)
		ensureStdlibFunctionsCompiled(project, seeds: floorSeeds)
	end 'eagerFloor'
end 'buildAndWriteLibraryCache'

// Emit full native bytecode for every function in an external library's lowered
// MIR module (no lazy stubs — see the `nativeEager` branch in
// `buildAndWriteLibraryCache`). Runs the same per-function backend tail the v80
// lazy stdlib path uses (`runNativeBackendTail`: lower → regalloc →
// prologue/epilogue → emit), but over the WHOLE module at once and against an
// EMPTY `stdlibFunctions` table — the external lib defines none of stdlib's
// functions; its calls into them resolve by name through the Phase-4 union at
// link time. Runtime functions are filtered out (the external lib carries none;
// the filter is defensive, mirroring the wasm path).
function emitLibraryNativeEager(mirModule MirModule, target Target, globalData GlobalDataTable, ownFuncNames StringSet, fastRegalloc bool) returns ObjectFunctionArray
	// Emit ONLY the library's own functions. The pipeline pulls stdlib bodies
	// (monomorphized generics, inlined accessors) into `mirModule`; those already
	// live in stdlib's cache, so re-emitting them here would double-define them at
	// link. Runtime functions are excluded too (the external lib carries none).
	var funcsToLower = IrFunctionArray.create()
	for func in mirModule.functions 'eachFunc'
		if isRuntimeFunctionName(func.name) or not ownFuncNames.contains(func.name) 'notOwn'
			continue
		end 'notOwn'
		funcsToLower.push(func)
	end 'eachFunc'
	// The backend resolves each callee's param types from the `stdlibFunctions`
	// table (`lookupFuncParamTypes`). An external library's functions call into
	// stdlib (and may pull stdlib generics transitively), so pass stdlib's cached
	// function table — the signature stubs are enough for callee-signature
	// resolution; the actual stdlib bodies are linked by name at the final
	// `writeExecutable` via the Phase-4 union. (Index 0 is stdlib, already
	// activated before any external library is registered.)
	let stdlibFuncs = (try libraryRegistry.libs.get(0) otherwise panic("emitLibraryNativeEager: stdlib (index 0) not registered")).cacheData.functions
	match target.cpu 'arch'
		x64 then return runNativeBackendTail(X64Backend.create(mirModule, target: target, globalData: globalData, stdlibFunctions: stdlibFuncs), funcsToLower: funcsToLower, target: target, fastRegalloc: fastRegalloc)
		arm64 then return runNativeBackendTail(Arm64Backend.create(mirModule, target: target, globalData: globalData, stdlibFunctions: stdlibFuncs), funcsToLower: funcsToLower, target: target, fastRegalloc: fastRegalloc)
		default panic("emitLibraryNativeEager: non-native target reached eager native emit")
	end 'arch'
end 'emitLibraryNativeEager'

// Load `runtime.std` and push signature-only entries (name, paramCount,
// paramTypes, returnType) for every runtime function into the stdlib
// pipeline's MirModule. Backend param-type lookups (lookupFuncParamTypes)
// walk IrFunctionArray looking for a name match, so once these entries
// exist, calls from stdlib code into `mrt_*` resolve correctly during
// per-function wasm lowering. Used only on the wasm cache build path —
// native targets splice the full runtime bodies into the StdModule before
// lowerStdToMir, so they don't need this post-MIR signature fixup.
//
// We don't copy blockRefs or any ops — only the header — so the backend
// emits an empty stub that the per-target filter strips before the cache
// is written. The wasm path's filter strips every runtime body (matching
// the pre-change behavior where the user pipeline supplied them).
function injectRuntimeSignatures(mirModule MirModule)
	let runtimePath = findRuntimePath()
	if runtimePath.isEmpty() 'noRuntime'
		return
	end 'noRuntime'
	let runtime = loadRuntimeModule()
	for rtFunc in runtime.functions 'eachRt'
		var alreadyPresent = false
		for existing in mirModule.functions 'checkExisting'
			if existing.name == rtFunc.name 'match'
				alreadyPresent = true
				break
			end 'match'
		end 'checkExisting'
		if alreadyPresent 'skip'
			continue
		end 'skip'
		let sig = IrFunction.createFromStd(rtFunc.name, returnType: rtFunc.returnType, paramCount: rtFunc.paramCount, paramTypes: rtFunc.paramTypes, returnLine: 0)
		mirModule.functions.push(sig)
	end 'eachRt'
end 'injectRuntimeSignatures'

// Try to load the stdlib cache for a different target (cross-compilation).
// The metadata is already loaded; only the target-specific code data changes.
// Reserve `__module_init_<n>` name slots so the user pipeline's parser
// allocates fresh names that don't collide with stdlib init names already
// baked into the cached function table. Without this reservation, a
// cache-hit user compile starts with `count() == 0`, the user's first
// init grabs `__module_init_0`, and the linker call from `mrt_start`
// resolves to either the cached stdlib body or the user body depending on
// symbol resolution order — silent ABI corruption (the cached stdlib
// body writes to `__data_<stdlibVar>` slots that don't exist in the user
// project's `.data` section, scribbling on whatever lives at offset 0).
//
// After v55 the cache persists `project.moduleInitFuncs` directly via
// `restoreStdlibMetadata`, so the names are already present (with their
// real callable identifiers, not placeholders). This function then
// becomes a no-op fallback for legacy paths where the cache restore
// hasn't populated `moduleInitFuncs`. The fallback pushes empty strings
// — `patchMrtStartWithModuleInits` filters empty entries via the same
// `name.isEmpty()` guard used elsewhere for inactive runtime helpers.
function seedModuleInitFuncsFromLivenessRoots(project Project)
	if project.moduleInitFuncs.count() > 0 'alreadyPopulated'
		return
	end 'alreadyPopulated'
	let prefix = "__module_init_"
	var stdlibInitCount = 0
	for root in project.livenessRoots 'eachRoot'
		if root.startsWith(prefix) 'isInit'
			stdlibInitCount = stdlibInitCount + 1
		end 'isInit'
	end 'eachRoot'
	for _ in 0 upto stdlibInitCount 'reserveSlots'
		project.moduleInitFuncs.push("")
	end 'reserveSlots'
end 'seedModuleInitFuncsFromLivenessRoots'

function loadCacheForTarget(project Project)
	// Cross-target switch: the lazy MIR / edge map / compiled-name set are all
	// keyed to the PREVIOUS target's reconstructed module and arch backend.
	// Invalidate them so the new target rebuilds its own (otherwise
	// `ensureStdlibFunctionsCompiled` would run the new arch's backend over the
	// old arch's lazy MIR and treat old-target names as already compiled).
	resetLazyStdlibState()

	let stdlibPath = findStdlibPath()
	if stdlibPath.isEmpty() 'noStdlib'
		return
	end 'noStdlib'

	// Phase 3: same library-owned cache dir, keyed by the NEW target for the
	// per-target (Tier C) file; the shared meta (Tier A+B) file is
	// target-independent, so a previous target's build already wrote it and this
	// cross-compile reads + reuses it (case 2 of the cold/partial lifecycle).
	let metaPath = libraryMetaCachePath(stdlibLib(), target: project.target, rcSanitize: project.rcSanitizeEnabled, cacheRootOverride: project.cacheRootOverride)
	let cachePath = libraryCachePath(stdlibLib(), target: project.target, rcSanitize: project.rcSanitizeEnabled, cacheRootOverride: project.cacheRootOverride)
	let contentChecksum = currentStdlibChecksum(project.target)

	let cacheResult = readStdlibCache(project, metaPath: metaPath, targetPath: cachePath, target: project.target, expectedChecksum: contentChecksum)

	if cacheResult.valid 'cacheHit'
		logInfo(LogCategory.compiler, message: function() gives "Stdlib cache hit for {targetToString(project.target)}: {countCompiledStdlibFunctions(cacheResult.data)} of {cacheResult.data.functions.count()} native functions have bytecode (rest deferred stubs) + {cacheResult.data.wasmFunctions.count()} WASM functions")
		activateStdlibCache(cacheResult.data, target: project.target)
		setStdlibCacheMetaHash(cacheResult.metaHash)
		return
	end 'cacheHit'

	// Cache miss for this target — parse fresh into the destination project
	// so its registries / interners hold the same entries a from-source
	// build would. `loadCacheForTarget` runs after the in-process fast path
	// already restored stdlib metadata for *another* target, so we can't
	// re-use the cross-project sandbox snapshot here without conflating its
	// id-space with `project`'s.
	let stdlibFiles = collectStdlibFiles()
	var allModule = MaxonModule.create()
	let stdlibRoot = findStdlibProjectRoot()
	for fp in stdlibFiles 'iter'
		if File.exists(fp) 'exists'
			let content = try File.readText(fp) otherwise panic("StdlibLoader: failed to read bundled stdlib file {fp}")
			parseStdlibSource(project, allModule: allModule, filePath: fp, rootPath: stdlibRoot, content: content)
		end 'exists'
	end 'iter'
	// Drain cross-file overload renames (see comments in the cache-miss path
	// in `getStdlibModule`). Same rationale: the per-file parser rekey can't
	// reach the merged IrFunction in `allModule`.
	applyPendingFuncRenames(project, allModule: allModule)
	// G.2: same post-parse validation as in `getStdlibModule`. See there
	// for the contract; required here too because `loadCacheForTarget`
	// reparses from source on a per-target cache miss.
	validateEnumLookupCalls(project, allModule: allModule)

	logInfo(LogCategory.compiler, message: function() gives "Stdlib cache miss for {targetToString(project.target)}: building")
	buildAndWriteStdlibCache(project, allModule: allModule, metaPath: metaPath, cachePath: cachePath, contentChecksum: contentChecksum)
end 'loadCacheForTarget'

export function getStdlibCacheData() returns StdlibCacheData
	return stdlibLib().cacheData
end 'getStdlibCacheData'

function activateStdlibCache(data StdlibCacheData, target Target)
	activateLibraryCache(0, data: data, target: target)
end 'activateStdlibCache'

// Phase 6: activate a registered library's just-loaded / just-built cache for
// the current target. Generalizes `activateStdlibCache` over the registry
// index — stdlib is index 0 (so `activateStdlibCache` is the index-0 delegate
// above, keeping every stdlib call site byte-untouched); external libraries use
// their own index. Mutates the registry's Library in place (value-type copy
// semantics — read, mutate scalars, set back).
function activateLibraryCache(libIndex LibraryIndex, data StdlibCacheData, target Target)
	var lib = try libraryRegistry.libs.get(libIndex) otherwise panic("activateLibraryCache: registry index {libIndex} missing")
	lib.cacheData = data
	lib.cacheValid = true
	lib.cacheCpu = target.cpu
	lib.cacheOs = target.os
	lib.cacheTargetSet = true
	try libraryRegistry.libs.set(libIndex, value: lib) otherwise panic("activateLibraryCache: registry index {libIndex} vanished")
end 'activateLibraryCache'

// Phase 4: restore one registered library's cached parser metadata into
// `project`, then seed its module-init funcs from its liveness roots. This is
// the per-library seam Phase 6 loops over (stdlib-first); today the only
// registered library is stdlib at index 0, so it's called once with that
// index. Pulling `cacheData` from the registry array (rather than a
// `lib.cacheData` field copy) yields a mutable binding `restoreStdlibMetadata`
// can write its `writerGidToProjectGid` rebuild through — the reference-backed
// Maps/Arrays alias the registry's shared heap storage, so the mutations
// persist without a set-back. The library's `cacheData` must already be
// activated for `libIndex`.
function restoreLibraryMetadata(project Project, libIndex LibraryIndex)
	var cacheData = (try libraryRegistry.libs.get(libIndex) otherwise panic("restoreLibraryMetadata: registry index {libIndex} missing")).cacheData
	restoreStdlibMetadata(project, data: cacheData)
	seedModuleInitFuncsFromLivenessRoots(project)
end 'restoreLibraryMetadata'

// Phase 3: record / read the META file content-hash the stdlib's in-memory
// `cacheData` corresponds to (see `Library.cacheMetaHash`).
function setStdlibCacheMetaHash(metaHash MachineWord)
	setLibraryCacheMetaHash(0, metaHash: metaHash)
end 'setStdlibCacheMetaHash'

// Phase 6: record the META file content-hash a registered library's in-memory
// `cacheData` corresponds to (see `Library.cacheMetaHash`). Generalizes
// `setStdlibCacheMetaHash` over the registry index; stdlib is index 0.
function setLibraryCacheMetaHash(libIndex LibraryIndex, metaHash MachineWord)
	var lib = try libraryRegistry.libs.get(libIndex) otherwise panic("setLibraryCacheMetaHash: registry index {libIndex} missing")
	lib.cacheMetaHash = metaHash
	try libraryRegistry.libs.set(libIndex, value: lib) otherwise panic("setLibraryCacheMetaHash: registry index {libIndex} vanished")
end 'setLibraryCacheMetaHash'

// Exported so the Phase-5 user chunk cache memoizes its upstream-API digest
// keyed by the loaded stdlib's meta-hash (the content identity of the library
// API it digests). 0 means no meta-hash is recorded yet (cold from-source
// build) — the caller treats 0 as "don't memoize".
export function getStdlibCacheMetaHash() returns MachineWord
	return stdlibLib().cacheMetaHash
end 'getStdlibCacheMetaHash'

module function isStdlibCacheValid() returns bool
	return stdlibLib().cacheValid
end 'isStdlibCacheValid'

// v68: extract the precomputed Std-DFE edge table from a post-dce Std-IR
// snapshot — one record per function, each a pure function of the body
// (call edges + witness/layout/globalAddr label demands). Built once at
// cache-build time so the load-time Std-DFE follows the cached call graph +
// witness/layout demands by consulting a flat table instead of re-walking
// the snapshot IR. This keeps the witness-method impls
// (`Character.hash`/`equals`) and their funcAbs64 slot relocs alive for
// generics built only inside a cached `<Type>.<field>.__lazy_init`.
// Target-independent (works for x64 and wasm alike) because it names only
// callees + rdata labels.
function buildStdFuncEdgeMap(snapshot StdModule) returns CachedFuncEdgeMap
	var edgeMap = CachedFuncEdgeMap.create()
	for func in snapshot.functions 'eachFunc'
		edgeMap.upsert(func.name, value: extractFuncEdges(snapshot, func: func))
	end 'eachFunc'
	return edgeMap
end 'buildStdFuncEdgeMap'

// ============================================================
// v80 lazy per-function stdlib codegen
// ============================================================

// v84 (Phase 7): record each library function's Std-IR content hash into the
// cache, for incremental Tier-C preservation across a source edit.
//
// The gate hash MUST be over the exact Std IR that produces the function's
// Tier-C bytecode. Native lazy codegen reconstructs its MIR from
// `inlinerStdModule` (the post-DCE Std snapshot, `ensureLazyStdlibMir` ~1796) and
// the cache-side runtime splice, then lowers each function to MIR + regalloc. So
// `F`'s bytecode is a deterministic function of `F`'s body in `inlinerStdModule`
// (or the runtime module). We hash each snapshot function via
// `computeStdContentHashFor` — the op-content-deep Std hash. Functions present
// in the MIR module but absent from the snapshot are the spliced RUNTIME bodies
// (`mrt_*`/`mm_*`/`__slab_*`): project-independent and invariant across stdlib
// SOURCE edits, so they carry no hash entry and are always preserved by the
// "no old hash AND no new hash → unchanged" rule in `preserveUnchangedTierC`.
function captureFuncContentHashes(project Project, data StdlibCacheData)
	let snapshot = data.inlinerStdModule
	for func in snapshot.functions 'eachSnap'
		data.funcContentHash.upsert(func.name, value: computeStdContentHashFor(project, module: snapshot, func: func))
	end 'eachSnap'
end 'captureFuncContentHashes'

// Build signature-only `ObjectFunction` stubs (name + return type + param
// count/types, empty code/fixups) from the lowered MIR module, one per
// function the eager native path would have emitted (same
// `isPerCompileRuntimeName` filter). These let the user build's per-function
// target lowering resolve every stdlib/runtime callee signature on a cold
// metadata-only cache, before lazy codegen fills in the real bytecode. The
// MIR `IrFunction` carries the post-lowerStdToMir signature (paramTypes are
// already StdType, matching the eager ObjectFunction's paramTypes).
function buildSignatureStubs(mirModule MirModule) returns ObjectFunctionArray
	var stubs = ObjectFunctionArray.create()
	for func in mirModule.functions 'eachFunc'
		if isPerCompileRuntimeName(func.name) 'perCompile'
			continue
		end 'perCompile'
		var stub = ObjectFunction.create(func.name, returnType: func.returnType, paramCount: func.paramCount)
		stub.paramTypes = func.paramTypes
		stubs.push(stub)
	end 'eachFunc'
	return stubs
end 'buildSignatureStubs'

// Reconstruct the merged stdlib+runtime StdModule and extract its full
// call-edge map — the CHEAP half of lazy setup (a couple of merges + an edge
// walk, no lowering). Memoized via `lazyStdlibEdgesBuilt`. The needed-closure
// only needs the edge map, so a warm build whose every reachable function is
// already compiled pays just this — never the expensive MIR lowering below.
//
// The stdlib Library's `inlinerStdModule` is the post-dce snapshot (stdlib
// bodies, no runtime); merging the cache-side runtime bodies mirrors the eager
// build's `pipeline.stdModule.merge(buildCacheSideRuntime(...))` splice point.
// The reconstructed module is retained for `ensureLazyStdlibMir` to lower on
// demand.
function ensureLazyStdlibEdges()
	if lazyStdlibEdgesBuilt 'already'
		return
	end 'already'

	var reconstructed = StdModule.create()
	reconstructed.merge(stdlibLib().inlinerStdModule)
	let runtimeForCache = buildCacheSideRuntime(loadRuntimeModule())
	reconstructed.merge(runtimeForCache)

	lazyReconstructed = reconstructed
	lazyStdlibFuncEdges = buildStdFuncEdgeMap(reconstructed)
	lazyStdlibEdgesBuilt = true
end 'ensureLazyStdlibEdges'

// Lower the reconstructed module to MIR — the EXPENSIVE half (lowerStdToMir +
// commuteForCoalescing + scheduleInstructions over ~992 functions, ~170ms).
// Only called when there is at least one function to compile, so a fully-warm
// build skips it. Memoized via `lazyStdlibMirBuilt`. Because every one of those
// passes is `perFunction` (intra-function) and panic-message labels are
// content-hashed (pipeline-independent), a function lowered here is
// byte-identical to the same function in a whole-module eager build.
//
// `project` supplies the target + globalData context. Native-only; wasm lazy
// codegen is handled on its own path.
function ensureLazyStdlibMir(project Project)
	if lazyStdlibMirBuilt 'already'
		return
	end 'already'
	ensureLazyStdlibEdges()

	var pipeline = PassPipeline.create(MaxonModule.create(), project: project, globalData: stdlibLib().cacheData.globalData, target: project.target, sourceFileName: "", isStdlib: true)
	pipeline.stdModule = lazyReconstructed
	pipeline.addPass(PassKind.lowerStdToMir)
	pipeline.addPass(PassKind.commuteForCoalescing)
	pipeline.addPass(PassKind.scheduleInstructions)
	try pipeline.run() otherwise panic("Lazy stdlib MIR build failed; see error diagnostics above")

	lazyStdlibMir = pipeline.mirModule
	lazyStdlibMirBuilt = true
end 'ensureLazyStdlibMir'

// Transitive closure over the reconstructed Std-IR call-edge map, resolving
// each (possibly bare) seed name to its actual function key (mirrors
// `resolveStdlibCacheKey`: a bare runtime call to a `stdlib.`-qualified
// Internals function probes the qualified form). Returns every function name
// reachable from `seeds` — the set the lazy backend must compile so the
// linker's name-keyed closure resolves with no gap.
function lazyNeededClosure(project Project, seeds StringArray) returns StdlibFuncNameSet
	var needed = StdlibFuncNameSet.create()
	var worklist = StringArray.create()

	for name in seeds 'seed'
		let key = resolveLazyEdgeKey(name)
		if not key.isEmpty() and not needed.contains(key) 'isFunc'
			needed.insert(key)
			worklist.push(key)
		end 'isFunc'
	end 'seed'

	var wi = 0
	while wi < worklist.count() 'walk'
		let nameRef = try worklist.get(wi) otherwise 'skip'
			wi = wi + 1
			continue
		end 'skip'
		let name = "{nameRef}"
		wi = wi + 1
		let edges = try lazyStdlibFuncEdges.get(name) otherwise continue
		for callee in edges.callees 'eachCallee'
			let depKey = resolveLazyEdgeKey(callee)
			if not depKey.isEmpty() and not needed.contains(depKey) 'newDep'
				needed.insert(depKey)
				worklist.push(depKey)
			end 'newDep'
		end 'eachCallee'
		// Witness/layout conditional-root labels (`loadWitnessTable` /
		// `loadLayoutDescriptor`) reach their impl functions only through
		// `project.witnessConditionalRoots`, NOT a `call`/`funcAddr` edge — mirror
		// the in-module DFE's `promoteConditionalRoots` so a generic whose witness
		// impls are reachable solely via a conditional-root label still gets those
		// impls compiled (otherwise they would link as `.text+0` stubs). `seen`
		// for labels is `needed` membership of the resolved impl names — the
		// closure converges because impls are finite.
		for label in edges.conditionalRootLabels 'eachCondRoot'
			if let bucket = try project.witnessConditionalRoots.get(label) 'haveBucket'
				for i in 0 upto bucket.count() 'eachImpl'
					let implName = try bucket.get(i) otherwise panic("lazyNeededClosure: witnessConditionalRoots bucket OOB at {i}")
					let implKey = resolveLazyEdgeKey(implName)
					if not implKey.isEmpty() and not needed.contains(implKey) 'newImpl'
						needed.insert(implKey)
						worklist.push(implKey)
					end 'newImpl'
				end 'eachImpl'
			end 'haveBucket'
		end 'eachCondRoot'

		// Backend-synthesized runtime edges (e.g. arm64-macos osDirGetdents64 ->
		// mrt_macos_dirent_relayout): the per-arch lowering emits the `bl`, so no
		// Std-IR `call` op records the edge and the callee would otherwise stay a
		// 0-byte signature stub. Mirror the runtime DCE filter's seedNativeBackendEdges.
		// A leaf callee (no outgoing calls) is absent from `lazyStdlibFuncEdges`, so
		// `resolveLazyEdgeKey` returns "" for it — fall back to the raw name, which
		// still matches its `lazyStdlibMir` entry so the fill selects it (without this
		// the callee never leaves stub state and the caller's `bl` lands on the next
		// function's bytes).
		for callee in backendSynthesizedRuntimeEdges(name, target: project.target) 'backendEdge'
			var backendName = resolveLazyEdgeKey(callee)
			if backendName.isEmpty() 'noEdge'
				backendName = callee
			end 'noEdge'
			if not needed.contains(backendName) 'newBackendDep'
				needed.insert(backendName)
				worklist.push(backendName)
			end 'newBackendDep'
		end 'backendEdge'
	end 'walk'

	return needed
end 'lazyNeededClosure'

// Resolve a (possibly bare) name to its key in `lazyStdlibFuncEdges`, probing
// the `stdlib.`-qualified form for bare runtime->Internals calls. Empty when
// neither form is a known function.
function resolveLazyEdgeKey(name String) returns String
	if lazyStdlibFuncEdges.contains(name) 'exact'
		return name
	end 'exact'
	let qualified = "stdlib.{name}"
	if lazyStdlibFuncEdges.contains(qualified) 'qualified'
		return qualified
	end 'qualified'
	return ""
end 'resolveLazyEdgeKey'

// Seed `lazyCompiledStdlibNames` from cache entries that already carry REAL
// machine code (non-empty `code`). Signature-only stubs (empty `code`, written
// by `buildSignatureStubs` on a cold cache) are NOT marked compiled — they
// still need their bytecode filled in. On a warm cache that accreted real code
// over prior builds, those entries pre-mark so we don't recompile them.
// Idempotent — safe to call before each lazy-fill.
function syncLazyCompiledNames()
	let data = stdlibLib().cacheData
	for func in data.functions 'eachEntry'
		if func.code.count() > 0 and not lazyCompiledStdlibNames.contains(func.name) 'isReal'
			lazyCompiledStdlibNames.insert(func.name)
		end 'isReal'
	end 'eachEntry'
end 'syncLazyCompiledNames'

// Count cache entries that carry REAL machine code (non-empty `code`), as
// opposed to v80 signature-only stubs (empty `code`, bytecode still deferred).
// Used for honest cache-hit logging — `functions.count()` alone counts stubs
// as if they were compiled.
export function countCompiledStdlibFunctions(data StdlibCacheData) returns MachineWord
	var n = 0
	for func in data.functions 'eachFunc'
		if func.code.count() > 0 'hasCode'
			n = n + 1
		end 'hasCode'
	end 'eachFunc'
	return n
end 'countCompiledStdlibFunctions'

// Map each cache function name to its index in the stdlib Library's
// `cacheData.functions`, so lazy codegen can replace a signature stub in place
// (`.set`) rather than append — keeping the array's order (and the linker's
// `.text` layout derived from it) stable and stub-free of duplicates.
function buildCacheFuncIndex() returns StdlibFuncIndexMap
	var index = StdlibFuncIndexMap.create()
	let data = stdlibLib().cacheData
	for (iter, func) in data.functions.withIterator() 'eachEntry'
		index.upsert(func.name, value: iter.index())
	end 'eachEntry'
	return index
end 'buildCacheFuncIndex'

// Compile every native stdlib/runtime function transitively reachable from
// `seeds` that is not yet present in the cache's `functions` array, filling
// each freshly-emitted ObjectFunction into its pre-existing signature-stub
// slot. Called by the native linkers (x64/arm64) BEFORE
// `computeNeededStdlibFunctions` so the cache holds every function the
// name-keyed link closure will then resolve. A no-op (beyond the cheap
// missing-set scan) when the cache already carries every reachable function —
// the steady-state warm-cache hit.
//
// The closure runs over the reconstructed Std-IR edge map (`lazyNeededClosure`),
// NOT the compiled `callFixups`: on a metadata-only cold cache the `functions`
// entries are signature-only stubs with EMPTY callFixups, so
// `computeNeededStdlibFunctions`' own fixup closure would resolve nothing past
// the seeds. The edge map is the codegen-free call graph derived from the same
// bodies, so its closure equals the eventual fixup closure.
//
// Determinism: each emitted body is written IN PLACE into the slot its
// signature stub already occupies (`.set` by name index, below), so the
// `functions` array order never deviates from the cold-build stub order — and
// the linker's `.text` layout, which iterates that array, stays stable across
// builds regardless of which program triggered which compiles. The stub order
// is itself build-order-independent (`buildSignatureStubs` emits in
// `mirModule.functions` order, a pure function of the stdlib's structure), so
// slot-preservation — NOT a name sort — is what makes cache-parity hold. Do
// not "sort by name" here: that would reorder fills relative to the stubs and
// break parity.
//
// Mutates the registry Library's `cacheData` array directly (not a passed-in
// value) so the link path's immutable `stdlibCache` binding — which aliases
// the same heap-backed `functions` array via `getStdlibCacheData()` — sees the
// additions without threading a `mutates` annotation up through
// `queryCodeResult`. Maxon `Array` is reference-backed, so a push on the
// registry's array is visible through every alias.
module function ensureStdlibFunctionsCompiled(project Project, seeds StringArray)
	syncLazyCompiledNames()

	let lazyStart = passTimerStart()
	// Cheap: build the edge map (no MIR lowering) and compute what the program
	// transitively reaches, minus what the cache already has real code for.
	ensureLazyStdlibEdges()
	let needed = lazyNeededClosure(project, seeds: seeds)

	var missingSet = StdlibFuncNameSet.create()
	for name in needed 'eachNeeded'
		if not lazyCompiledStdlibNames.contains(name) 'isMissing'
			missingSet.insert(name)
		end 'isMissing'
	end 'eachNeeded'

	if missingSet.count() == 0 'nothingToDo'
		// Fully-warm hit: every reachable function already carries real code.
		// We paid only the cheap edge build — no MIR lowering, no regalloc.
		return
	end 'nothingToDo'

	// Something to compile — NOW pay the expensive MIR lowering (once).
	ensureLazyStdlibMir(project)

	// Select the MIR functions to lower in the SAME order they appear in the
	// reconstructed module (preserving lowering context), restricted to the
	// missing set. The emitted results are filled back into their existing
	// stub slots below (`.set` by name index), so the cache's function order
	// stays fixed at the build-order-independent stub order.
	var funcsToLower = IrFunctionArray.create()
	for func in lazyStdlibMir.functions 'pickMir'
		if missingSet.contains(func.name) 'wanted'
			funcsToLower.push(func)
		end 'wanted'
	end 'pickMir'

	let emitted = compileStdlibMirSubsetNative(project, funcsToLower: funcsToLower)

	// Fill each freshly-emitted function's real bytecode into its existing
	// signature-stub slot (`.set` by name index), preserving the cache array's
	// order so the linker's `.text` layout stays stable regardless of which
	// program triggered the compile. Every MIR function gets a stub on the cold
	// build, so the `.set` path always taken; the `else` push is a correctness
	// backstop for the unreachable no-stub case (it keeps the body linkable,
	// though an out-of-stub-order append would perturb parity — which is why it
	// must stay unreachable).
	let index = buildCacheFuncIndex()
	// `cacheData` is the registry Library's reference-backed `cacheData` field;
	// mutating its `functions` array in place writes through to the registry
	// without a set-back (Maxon Array is reference-backed), matching the
	// original "mutate the global's array in place" intent. Pulled from the
	// registry array via a `try`-expression (not a `let`-field copy — E3078
	// rejects binding a `var` from an immutable field) so it is a mutable
	// binding whose `.functions.set` / `.push` are permitted.
	var cacheData = (try libraryRegistry.libs.get(0) otherwise panic("ensureStdlibFunctionsCompiled: stdlib registry empty")).cacheData
	var keptCount = 0
	for func in emitted 'fill'
		if isPerCompileRuntimeName(func.name) 'perCompile'
			continue
		end 'perCompile'
		if lazyCompiledStdlibNames.contains(func.name) 'alreadyReal'
			continue
		end 'alreadyReal'
		if let slot = try index.get(func.name) 'hasStub'
			try cacheData.functions.set(slot, value: func) otherwise panic("lazy codegen: stub slot {slot} for '{func.name}' out of bounds")
		end 'hasStub' else 'noStub'
			cacheData.functions.push(func)
		end 'noStub'
		lazyCompiledStdlibNames.insert(func.name)
		keptCount = keptCount + 1
	end 'fill'

	// Safety tripwire (risk #2 in the design): every reachable function MUST now
	// carry real code, or the linker's name-keyed closure would link a stub's
	// empty `code` and resolve calls into it to `.text+0` — a silent corruption.
	// A miss here means `lazyNeededClosure` (edge map) under-approximated the
	// linker's fixup closure. Per-compile runtime names are intentionally NOT in
	// the cache (the user pipeline supplies them), so they're exempt.
	for name in missingSet 'verify'
		if isPerCompileRuntimeName(name) 'exemptPerCompile'
			continue
		end 'exemptPerCompile'
		if not lazyCompiledStdlibNames.contains(name) 'gap'
			panic("lazy codegen: needed stdlib function '{name}' has no compiled body after lazy fill — edge-map closure under-approximated the linker closure (would link .text+0)")
		end 'gap'
	end 'verify'

	// Persist the grown cache so the NEXT build — in ANY process, including the
	// spec runner's cross-project workers — reuses the just-compiled bytecode
	// (zero regalloc). Safe from any project since Phase 3.5 made the cache codec
	// project-independent. Only reached when functions were actually compiled
	// (the fully-warm hit returns early above), so steady state writes nothing.
	// `persistGrownStdlibCache` re-reads + merges the on-disk Tier-C set before
	// the atomic write, so concurrent writers converge to the UNION of every
	// project's lazily-grown functions instead of clobbering each other.
	persistGrownStdlibCache(project)

	recordPassSince("__stdlib-lazyCodegen", startMs: lazyStart)
	// `lazyCompiledStdlibNames` counts entries that now carry REAL machine code;
	// `functions.count()` is the TOTAL of compiled bodies + signature-only stubs
	// (the un-reached functions whose bytecode is still deferred). Report both so
	// the line doesn't misclaim every stub as compiled.
	logInfo(LogCategory.compiler, message: function() gives "Lazily compiled {keptCount} stdlib functions ({lazyCompiledStdlibNames.count()} cached)")
end 'ensureStdlibFunctionsCompiled'

// Re-serialize the in-memory stdlib `cacheData` (now carrying the
// lazily-compiled bytecode) to the cache file, so subsequent builds reuse it.
// Skips persistence when stdlib couldn't be located (empty `cacheDirRoot`),
// which would otherwise resolve to a bare relative path under the cwd.
function persistGrownStdlibCache(project Project)
	let lib = stdlibLib()
	if lib.cacheDirRoot.isEmpty() 'noPath'
		return
	end 'noPath'
	let cachePath = libraryCachePath(lib, target: project.target, rcSanitize: project.rcSanitizeEnabled, cacheRootOverride: project.cacheRootOverride)
	let contentChecksum = currentStdlibChecksum(project.target)
	// Phase 3: lazy codegen fills ONLY name-keyed Tier-C bytecode
	// (`cacheData.functions`) — it lowers already-resolved cached Std IR to machine
	// code without interning any new TypeNameId / StringId / GenericInstanceId, so
	// Tier A+B (the meta file) is unchanged. We therefore rewrite ONLY the
	// per-target (Tier C) file, pairing it with the meta file we already loaded via
	// its recorded content-hash. (v81 Phase 3.5 note: `data`'s id-space snapshots
	// are the complete-at-build, stdlib-only source — we must NOT append the
	// project's id-space tail, which by persist time also carries the user
	// program's ids.)
	let metaHash = getStdlibCacheMetaHash()
	if metaHash == 0 'noMetaHash'
		// No meta-hash on record (the cache was never read/written this process):
		// can't safely pair a target file to a meta file, so skip the persist. The
		// next from-source build regenerates both.
		return
	end 'noMetaHash'

	// Read-modify-write MERGE (cross-project convergence fix): another process
	// may have grown the on-disk cache with DIFFERENT functions since we loaded
	// it (project A compiled `Array.concat`, we compiled `Map.insert`). A plain
	// whole-file overwrite is last-writer-wins and drops the other's growth, so
	// the shared cache oscillates instead of accumulating the union every project
	// needs. Re-read the on-disk Tier-C bytecode and adopt any real-code function
	// we still hold only as a stub, so the file we write is the UNION.
	mergeOnDiskGrownStdlibFunctions(project.target, rcSanitize: project.rcSanitizeEnabled, cacheRootOverride: project.cacheRootOverride, contentChecksum: contentChecksum, metaHash: metaHash)

	writeLibraryTargetCache(cachePath, data: lib.cacheData, target: project.target, contentChecksum: contentChecksum, metaHash: metaHash)
end 'persistGrownStdlibCache'

// v84 (Phase 7): the count of bodies the most recent `preserveUnchangedTierC`
// call adopted from the prior on-disk cache. Exported for the test harness /
// CACHE_STATS so a scenario can assert preservation actually happened (and how
// much). Reset at the top of each `preserveUnchangedTierC`.
export var lastPreservedTierCCount = 0 as ElementCount

// v84 (Phase 7): on a stdlib REBUILD, adopt the lazily-compiled Tier-C bodies of
// every function whose CONTENT HASH is unchanged from the prior on-disk cache,
// filling its fresh signature stub with the real (post-regalloc) body instead of
// discarding it and forcing a re-regalloc on the next link. `cacheData` carries
// the freshly-built stubs + the NEW `funcContentHash` map; `oldTargetPath` is the
// prior target file (still on disk until the write that follows this call).
//
// Gate: the per-function content hash. `data.funcContentHash[name]` (new) ==
// `old.funcContentHash[name]` (old) means the function's post-DCE Std IR — the
// exact input to its lazy lower+regalloc — is identical, so its already-compiled
// bytecode is byte-compatible and adopted. A changed function's hash flips; a
// function that inlined a changed callee flips too (the hash is op-content-deep
// over the post-DCE body). Runtime bodies carry no hash entry on either side, so
// the `try ... otherwise continue` skips them (they are project-independent and
// recompiled fresh — cheap, and not the target of this optimization).
//
// Like `mergeOnDiskGrownStdlibFunctions`, this fills EXISTING stub slots by name
// (no reorder → stub-ordered `.text` parity preserved) and unions the old
// globalData so adopted bodies' `rdataRelocs` resolve. It also seeds
// `lazyCompiledStdlibNames` so the subsequent lazy fill skips the adopted bodies.
// No-op on a first-ever cold build (no old file → empty read).
function preserveUnchangedTierC(cacheData StdlibCacheData, oldTargetPath FilePath, target Target)
	lastPreservedTierCCount = 0
	let old = readOldTierCForPreserve(oldTargetPath, target: target)
	if old.functions.count() == 0 'noOld'
		return
	end 'noOld'

	// Index the fresh stubs by name (cacheData is a local, not yet in the
	// registry, so `buildCacheFuncIndex` — which reads the registry — can't serve).
	var index = StdlibFuncIndexMap.create()
	for (iter, func) in cacheData.functions.withIterator() 'eachStub'
		index.upsert(func.name, value: iter.index())
	end 'eachStub'

	var adoptedAny = false
	for oldFunc in old.functions 'eachOld'
		if oldFunc.code.count() == 0 'oldStub'
			continue
		end 'oldStub'
		let oldHash = try old.funcContentHash.get(oldFunc.name) otherwise continue
		let newHash = try cacheData.funcContentHash.get(oldFunc.name) otherwise continue
		if oldHash != newHash 'changed'
			continue
		end 'changed'
		if let slot = try index.get(oldFunc.name) 'fill'
			try cacheData.functions.set(slot, value: oldFunc) otherwise continue
			lazyCompiledStdlibNames.insert(oldFunc.name)
			lastPreservedTierCCount = lastPreservedTierCCount + 1
			adoptedAny = true
		end 'fill'
	end 'eachOld'

	if adoptedAny 'unionGlobals'
		mergeGrownGlobalDataInto(cacheData, source: old.globalData)
	end 'unionGlobals'

	if lastPreservedTierCCount > 0 'logIt'
		logInfo(LogCategory.compiler, message: function() gives "Phase 7: preserved {lastPreservedTierCCount} unchanged stdlib function bodies across rebuild (skipped re-regalloc)")
	end 'logIt'
end 'preserveUnchangedTierC'

// v84 (Phase 7): the WASM analogue of `preserveUnchangedTierC`. Wasm emits
// eagerly (no lazy path), so on a REBUILD we PRESERVE the unchanged wasm bodies
// from the prior on-disk cache and EMIT only the changed/new functions, then
// return the union. Gate: the per-function content hash (a function whose new
// hash == its old hash has identical post-DCE Std IR → identical wasm bytecode →
// adopt the old body; a missing old hash, missing old body, or hash change → it
// is in the recompute set and gets re-emitted). Wasm cached bodies are
// name-relocatable (call/type/funcAddr/globalAddr fixups store names, resolved at
// final link), so a preserved body links correctly alongside re-emitted siblings.
// On a first-ever cold build (no old file) every function is "changed" → full
// emit, identical to the pre-Phase-7 behavior.
function preserveUnchangedWasm(mirModule MirModule, globalData GlobalDataTable, newHashes FuncContentHashMap, oldTargetPath FilePath, target Target) returns WasmObjectFunctionArray
	lastPreservedTierCCount = 0
	let old = readOldTierCForPreserve(oldTargetPath, target: target)

	// Build the set of names to RE-EMIT: a function whose new hash differs from
	// (or is absent in) the old cache, OR whose old wasm body is missing. The
	// complement (present old body + unchanged hash) is preserved.
	var oldWasmByName = WasmObjectFunctionByName.create()
	for f in old.wasmFunctions 'indexOld'
		oldWasmByName.upsert(f.name, value: f)
	end 'indexOld'

	// First pass: decide preserve-vs-recompute per function, in `mirModule` order.
	var recompute = StringSet.create()
	for func in mirModule.functions 'eachFunc'
		if isRuntimeFunctionName(func.name) 'isRuntime'
			continue
		end 'isRuntime'
		let newHash = try newHashes.get(func.name) otherwise 'noNewHash'
			// No content hash → cannot reason per-function; re-emit to be safe.
			recompute.insert(func.name)
			continue
		end 'noNewHash'
		if old.funcContentHash.contains(func.name) and oldWasmByName.contains(func.name) 'haveOld'
			let oldHash = try old.funcContentHash.get(func.name) otherwise 0 as ContentHash
			if oldHash == newHash 'unchanged'
				continue
			end 'unchanged'
		end 'haveOld'
		recompute.insert(func.name)
	end 'eachFunc'

	// Emit ONLY the recompute set (everything on a cold build with no old data).
	// `extraCalleeSigs` empty: the stdlib module defines every callee.
	var emittedByName = WasmObjectFunctionByName.create()
	for f in emitWasmPerFunctionFiltered(mirModule, globalData: globalData, onlyOwnNames: recompute, emitAll: false, extraCalleeSigs: WasmObjectFunctionArray.create()) 'indexEmitted'
		emittedByName.upsert(f.name, value: f)
	end 'indexEmitted'

	// Second pass: assemble the result in `mirModule` order (IDENTICAL ordering to
	// a full `emitWasmPerFunction`, so the target cache is byte-parity-safe vs a
	// from-scratch rebuild). Each non-runtime function is either freshly emitted
	// (recompute set) or its preserved old body.
	var result = WasmObjectFunctionArray.create()
	for func in mirModule.functions 'assemble'
		if isRuntimeFunctionName(func.name) 'isRuntime2'
			continue
		end 'isRuntime2'
		if let emitted = try emittedByName.get(func.name) 'wasEmitted'
			result.push(emitted)
		end 'wasEmitted' else 'preserve'
			let oldFunc = try oldWasmByName.get(func.name) otherwise continue
			result.push(oldFunc)
			lastPreservedTierCCount = lastPreservedTierCCount + 1
		end 'preserve'
	end 'assemble'

	if lastPreservedTierCCount > 0 'logIt'
		logInfo(LogCategory.compiler, message: function() gives "Phase 7: preserved {lastPreservedTierCCount} unchanged stdlib wasm function bodies across rebuild (skipped re-emit)")
	end 'logIt'
	return result
end 'preserveUnchangedWasm'

// Adopt every real-code function from the on-disk Tier-C cache that the
// in-memory `cacheData` still holds as a signature-only stub, so a concurrent
// writer's lazily-grown bodies survive our write (the union, not last-writer-
// wins). Reads ONLY the Tier-C payload (`readOnDiskTargetTierC`) — it must NOT
// re-run `readStdlibCache`'s meta decode, which re-seeds the live project's
// interners mid-build and corrupts the id-space (miscompiling bodies that
// reference interned constants).
//
// Unions BOTH `functions` AND `globalData`: a Tier-C body is NOT self-contained
// — math functions (`sqrt`/`pow`/`floor`/…) reference float constants via
// `rdataRelocs` into the cache's `globalData`, which itself grows lazily. A
// worker that adopts another worker's `sqrt` body without ALSO adopting its
// float-constant globalData entry links the wrong constant → garbage result
// (the parallel-only math-function regression). So every adopted body's
// globalData label must come with it; we union the entire on-disk globalData by
// name (a superset is harmless — unreferenced rdata blobs are pruned by DFE).
//
// Validity: the on-disk file is validated against our exact key (source
// checksum, target, meta-hash via `readOnDiskTargetTierC`), so an adopted body
// is byte-compatible by construction; filling EXISTING stub slots by name (no
// reorder) preserves the stub-ordered `.text` layout and byte parity. A missing
// / corrupt / key-mismatched file yields nothing → we write our own grown set.
function mergeOnDiskGrownStdlibFunctions(target Target, rcSanitize bool, cacheRootOverride FilePath, contentChecksum CacheChecksum, metaHash MachineWord)
	let lib = stdlibLib()
	let cachePath = libraryCachePath(lib, target: target, rcSanitize: rcSanitize, cacheRootOverride: cacheRootOverride)
	let disk = readOnDiskTargetTierC(cachePath, target: target, expectedChecksum: contentChecksum, expectedMetaHash: metaHash)
	if disk.functions.count() == 0 'noOnDisk'
		return
	end 'noOnDisk'

	let index = buildCacheFuncIndex()
	let cacheData = (try libraryRegistry.libs.get(0) otherwise panic("mergeOnDiskGrownStdlibFunctions: stdlib registry empty")).cacheData

	// Track whether we actually adopted any body — only then is unioning the
	// on-disk globalData worthwhile (and only the adopted bodies' labels matter,
	// but unioning the whole table is simpler and a harmless superset).
	var adoptedAny = false
	for diskFunc in disk.functions 'eachDisk'
		if diskFunc.code.count() == 0 'diskStub'
			continue
		end 'diskStub'
		if lazyCompiledStdlibNames.contains(diskFunc.name) 'haveReal'
			continue
		end 'haveReal'
		if let slot = try index.get(diskFunc.name) 'fillStub'
			try cacheData.functions.set(slot, value: diskFunc) otherwise continue
			lazyCompiledStdlibNames.insert(diskFunc.name)
			adoptedAny = true
		end 'fillStub'
	end 'eachDisk'

	if adoptedAny 'unionGlobals'
		mergeGrownGlobalDataInto(cacheData, source: disk.globalData)
	end 'unionGlobals'
end 'mergeOnDiskGrownStdlibFunctions'

// Union the on-disk Tier-C `globalData` rdata entries into `cacheData`'s table by
// name (skip any already present), so an adopted body's `rdataRelocs` resolve to
// the same constant the body was emitted against. Mirrors Phase 4's
// `mergeLibraryTierCInto` globalData union. Takes `cacheData` (the reference-
// backed registry value) and mutates its `globalData` field through the
// reference — the same in-place pattern the function-stub fill uses, so a
// `let`-bound `cacheData` suffices.
function mergeGrownGlobalDataInto(cacheData StdlibCacheData, source GlobalDataTable)
	for i in 0 upto source.names.count() 'eachGlobal'
		let name = try source.names.get(i) otherwise continue
		if cacheData.globalData.nameIndex.contains(name) 'present'
			continue
		end 'present'
		let value = try source.values.get(i) otherwise continue
		addNamedGlobalData(cacheData.globalData, name: name, data: value)
	end 'eachGlobal'
end 'mergeGrownGlobalDataInto'

// Run the native backend tail (target lowering + regalloc + prologue/epilogue
// + emit) over a SUBSET of the lazy MIR module's functions, returning their
// ObjectFunctions. Mirrors `buildStdlibNativeWith` exactly except it lowers
// `funcsToLower` instead of the whole module — `lowerMirToTargetForFunctions`
// keeps `allFunctions` pointing at the full module for callee-signature
// resolution, and per-function regalloc/emit are byte-identical to the eager
// whole-module path (the existing incremental-emit guarantee).
//
// `lowerMirToTargetForFunctions` stores the lowered module into the backend's
// own `targetModule` field (which `emitPerFunction` later reads); the same
// reference is what `allocateRegisters` (in-place mutation) and
// `insertPrologueEpilogueWith` operate on, so all four steps act on one
// module — exactly as `buildStdlibNativeWith` does.
function compileStdlibMirSubsetNative(project Project, funcsToLower IrFunctionArray) returns ObjectFunctionArray
	let data = stdlibLib().cacheData
	match project.target.cpu 'arch'
		x64 then return runNativeBackendTail(X64Backend.create(lazyStdlibMir, target: project.target, globalData: data.globalData, stdlibFunctions: data.functions), funcsToLower: funcsToLower, target: project.target, fastRegalloc: project.fastRegalloc)
		arm64 then return runNativeBackendTail(Arm64Backend.create(lazyStdlibMir, target: project.target, globalData: data.globalData, stdlibFunctions: data.functions), funcsToLower: funcsToLower, target: project.target, fastRegalloc: project.fastRegalloc)
		default panic("compileStdlibMirSubsetNative: non-native target reached lazy native codegen")
	end 'arch'
end 'compileStdlibMirSubsetNative'

// Run the backend tail (subset target-lowering -> regalloc -> prologue/epilogue
// -> per-function emit) on `backend`, returning the emitted ObjectFunctions.
// Takes `backend` as a `TargetBackend` parameter (the proven dispatch shape
// used by `prepareTargetModuleForFunctions`); the per-arch concrete backend is
// constructed by the caller's `match` so the interface value is a parameter,
// not a local from a returning function (which the C# bootstrap can't resolve
// interface-dispatch on).
function runNativeBackendTail(backend TargetBackend, funcsToLower IrFunctionArray, target Target, fastRegalloc bool) returns ObjectFunctionArray
	var targetModule = backend.lowerMirToTargetForFunctions(funcsToLower)
	targetModule = allocateRegisters(targetModule, target: target, fastRegalloc: fastRegalloc)
	// Reclaim regalloc's orphan ops (applyColoring / insertSpillCode clear and
	// rebuild opRefs, leaving the old entries unreferenced in the shared ops
	// array) before prologue/epilogue grows the array again. Compaction is
	// byte-identical to a no-op — it only renumbers indices and drops the
	// unreachable ops. See TargetModule.compactOps.
	targetModule.compactOps()
	insertPrologueEpilogueWith(targetModule, backend: backend)
	targetModule.compactOps()
	return backend.emitPerFunction()
end 'runNativeBackendTail'
