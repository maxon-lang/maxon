// Parsed command line arguments for the Maxon compiler.

export union Command
	build
	specTest
	testIncremental
	testLibCache
	coverageReport
	clean
	unknown
end 'Command'

export union TargetOption
	host
	all
	x64Windows
	x64Linux
	arm64Windows
	arm64Linux
	arm64Macos
	wasm32Wasi
end 'TargetOption'

export union ArgError implements Error
	invalidOption(arg String)
end 'ArgError'

export typealias WorkerCount = int(1 to u64.max)

export type MaxonArgs
	export var command as Command
	export var path as String
	export var filter as String
	export var targetOption as TargetOption
	export var emitIr as bool
	export var dumpStages as bool
	// `--dump-stages-stdlib`: like `--dump-stages` but renders the full stdlib
	// IR into each stage file too. Off by default because serializing the whole
	// stdlib after every pass is the bulk of `--dump-stages`' cost; only the
	// rare case of inspecting post-pass stdlib lowering needs it. Implies
	// `dumpStages`.
	export var dumpStagesStdlib as bool
	// Optional stage selection for `--dump-stages[=NAMES]` /
	// `--dump-stages-stdlib[=NAMES]`: a comma-separated list of pass-name
	// substrings (e.g. `insert-refcounts` or `dce,inliner`). Only matching
	// stages are rendered and written; the per-stage file numbering still
	// advances for skipped stages so a filtered dump keeps the same `NN-`
	// prefixes as a full one. Empty = dump every stage (the bare-flag default).
	export var dumpStagesFilter as String
	export var trackAllocs as bool
	export var updateRequired as bool
	export var verbose as bool
	export var coverage as bool
	// `maxon build --leak-check <file>` wires the process-exit leak gate
	// (`mrt_leak_check`) into the binary so it exits 101 if any allocation is
	// still live at exit. The spec runner enables this internally; this flag
	// lets you reproduce/debug a leak-gated build standalone. It does NOT bypass
	// the stdlib cache, so it reproduces the cached-build path.
	export var leakCheck as bool
	// Print per-pass wall-clock timings at the end of the run. Useful for
	// understanding where compile time is being spent during spec runs.
	export var profilePasses as bool
	// `maxon build --fast <file>`: use the fast register allocator. Register
	// allocation dominates self-hosted compile time, and the bulk of that cost
	// is the expensive last-chance recoloring search plus the call/use range
	// splitters — quality machinery that earns release-grade codegen at a steep
	// compile-time price. `--fast` disables that machinery (depth-0 recolor, no
	// splitting) so dev/iteration builds compile much faster at the cost of
	// slightly worse code on register-pressured functions. Off by default: a
	// default build keeps today's exact, byte-identical allocation (the
	// `-O0`-fast vs `-O2`-slow split LLVM draws between `regalloc=fast` and
	// `regalloc=greedy`).
	export var fastRegalloc as bool
	// `maxon build --cache-stats <file>`: print a `CACHE_STATS …` line after the
	// build reporting per-function regalloc hits/misses, the stdlib cache
	// hit/miss, and the compiled-function count. Drives the `maxon test-lib-cache`
	// harness's assertions (cold build writes / 2nd build hits / delete rebuilds).
	export var cacheStats as bool
	// `maxon build --cache-root=DIR <file>`: redirect this build's library cache
	// to `DIR/.maxon/cache/` instead of the library's own on-disk location, so a
	// test scenario can run a cold/hit/delete sequence in a throwaway temp dir
	// without disturbing the persistent shared cache. Empty = use each library's
	// own root (the normal path). Internal/testing use only.
	export var cacheRoot as String
	// `maxon build --library=DIR <file>` (repeatable): link an external library
	// rooted at DIR. Its `export` symbols become globally visible to the program
	// (implicit import — no syntax), and it is compiled+cached to its own
	// `<DIR>/.maxon/cache/`. Combined with any `build.maxon` `library("...")`
	// manifest entries (deduped by absolute path) by the build driver. Empty on a
	// normal stdlib-only build.
	export var libraries as StringArray
	// Number of parallel persistent-worker processes (default 12). 1 = serial.
	export var workers as WorkerCount
	// Internal flag set by the parent dispatcher to launch a long-lived worker
	// that reads jobs (batch/singles/fallback) line-by-line from stdin and
	// emits result markers + WORKER_READY on stdout. Amortises stdlib warmup
	// across every job assigned to this worker for the parent's whole run.
	export var workerPersistent as bool
	// Internal flag set by the parent to make this process run one spec's batch only.
	export var workerSpec as String
	// Internal flag set by the parent to make this process run only the
	// non-batchable (single) tests for a comma-separated list of specs.
	export var workerSingles as String
	// Internal flag for fallback mode: a semicolon-separated list of
	// `specName:testName1|testName2|...` groups. Each group's named tests are
	// run via the per-fragment path (used when the batch rewriter rejected
	// them mid-batch). Subprocess-isolated to contain compile-time panics.
	export var workerFallback as String
	// `maxon build --greedy-only=NAME <file>` (or the comma-separated
	// `--greedy-only=NAME1,NAME2,...`): force the named function(s) through the
	// alternative single-pass greedy register allocator instead of the SSA
	// coloring pipeline. Test/dev trigger for the multi-phase greedy-allocator
	// port (Phase 1: single-block, GPR-only, call-free). Empty = greedy path
	// never fires (normal compilation). The comma-separated list is split in
	// setGreedyOnlyFunc; this raw value is passed through verbatim.
	export var greedyOnly as String
	// `maxon build --sweep-mode=MODE <file>`: interference-construction mode for
	// the SSA colorer. `legacy` (default) = the pre-existing buildInterferenceGraph;
	// `sweep` = the unified LiveSetSweep; `validate` = build both and assert their
	// edge sets match (Track-A rewrite validation). Passed to setSweepMode.
	export var sweepMode as String
	// `maxon build -o PATH` / `--output PATH` (also `--output=PATH`): overrides
	// the output executable path. Empty = derive it from the build name / first
	// source file (the normal behavior). Threaded through compile() into
	// project.outputPathOverride, which resolveBuildOutputPath consults first.
	export var outputOverride as String

	export static function parse() returns MaxonArgs throws ArgError
		let allArgs = CommandLine.args()

		var args = MaxonArgs{
			command: Command.unknown,
			path: "",
			filter: "",
			targetOption: TargetOption.host,
			emitIr: false,
			dumpStages: false,
			dumpStagesStdlib: false,
			dumpStagesFilter: "",
			trackAllocs: false,
			updateRequired: false,
			verbose: false,
			coverage: false,
			leakCheck: false,
			profilePasses: false,
			fastRegalloc: false,
			cacheStats: false,
			cacheRoot: "",
			libraries: StringArray.create(),
			workers: 12,
			workerPersistent: false,
			workerSpec: "",
			workerSingles: "",
			workerFallback: "",
			greedyOnly: "",
			sweepMode: "",
			outputOverride: ""
		}

		if allArgs.count() < 2 'noArgs'
			return args
		end 'noArgs'

		let cmdStr = try allArgs.get(1) otherwise panic("MaxonArgs: allArgs.count() >= 2 just checked but get(1) failed")
		// `coverage report <exe>` is a two-token command where the positional
		// arg comes third. All other commands are one token and take flag/path
		// args starting at index 2, so start the flag scanner accordingly.
		var firstFlagIndex = 2
		if cmdStr == "build" 'isBuild'
			args.command = Command.build
		end 'isBuild' else if cmdStr == "spec-test" 'isSpec'
			args.command = Command.specTest
		end 'isSpec' else if cmdStr == "test-incremental" 'isInc'
			args.command = Command.testIncremental
		end 'isInc' else if cmdStr == "test-lib-cache" 'isLibCache'
			args.command = Command.testLibCache
		end 'isLibCache' else if cmdStr == "clean" 'isClean'
			args.command = Command.clean
		end 'isClean' else if cmdStr == "coverage" 'isCov'
			// Sentinel: user may type "coverage" alone; empty string flows to the 'notReport' else below.
			let sub = try allArgs.get(2) otherwise ""
			if sub == "report" 'isReport'
				args.command = Command.coverageReport
				// Sentinel: user may omit the path; downstream validates the empty string.
				args.path = try allArgs.get(3) otherwise ""
				firstFlagIndex = 4
			end 'isReport' else 'notReport'
				args.command = Command.unknown
			end 'notReport'
		end 'isCov' else 'unknown'
			args.command = Command.unknown
		end 'unknown'

		// Set true when a flag consumed the FOLLOWING token as its value (e.g.
		// `-o PATH`); the loop then skips that token so it is not misread as the
		// positional path argument.
		var skipNext = false

		for i in firstFlagIndex upto allArgs.count() 'scan'
			if skipNext 'consumedByPrevFlag'
				skipNext = false
				continue
			end 'consumedByPrevFlag'

			let arg = try allArgs.get(i) otherwise panic("MaxonArgs.scan: i < allArgs.count() by loop guard but get({i}) failed")
			if arg.startsWith("--log=") 'isLog'
				// Sentinel: empty string signals malformed --log=; handled by isEmpty() check below.
				var optionStr = try CommandLine.optionValue(arg) otherwise ""
				if optionStr.isEmpty() 'emptyLog'
					throw ArgError.invalidOption(arg)
				end 'emptyLog'
				let ok = parseLogOption(optionStr)
				if not ok 'badLog'
					throw ArgError.invalidOption(arg)
				end 'badLog'
			end 'isLog' else if arg.startsWith("--filter=") 'isFilter'
				// Sentinel: empty filter = no filtering, a valid state.
				args.filter = try CommandLine.optionValue(arg) otherwise ""
			end 'isFilter' else if arg.startsWith("--target=") 'isTarget'
				// Sentinel: empty flows to parseTargetOption which throws on empty.
				let targetStr = try CommandLine.optionValue(arg) otherwise ""
				args.targetOption = try parseTargetOption(targetStr) otherwise throw ArgError.invalidOption(arg)
			end 'isTarget' else if arg == "--emit-ir" 'isEmitIr'
				args.emitIr = true
			end 'isEmitIr' else if arg == "--leak-check" 'isLeakCheck'
				args.leakCheck = true
			end 'isLeakCheck' else if arg == "--dump-stages" 'isDumpStages'
				args.dumpStages = true
			end 'isDumpStages' else if arg.startsWith("--dump-stages=") 'isDumpStagesFiltered'
				// Sentinel: an empty NAMES list means "dump every stage" — same
				// as the bare flag, a valid state.
				args.dumpStages = true
				args.dumpStagesFilter = try CommandLine.optionValue(arg) otherwise ""
			end 'isDumpStagesFiltered' else if arg == "--dump-stages-stdlib" 'isDumpStagesStdlib'
				args.dumpStages = true
				args.dumpStagesStdlib = true
			end 'isDumpStagesStdlib' else if arg.startsWith("--dump-stages-stdlib=") 'isDumpStagesStdlibFiltered'
				// Sentinel: empty NAMES = dump every stage, same as the bare flag.
				args.dumpStages = true
				args.dumpStagesStdlib = true
				args.dumpStagesFilter = try CommandLine.optionValue(arg) otherwise ""
			end 'isDumpStagesStdlibFiltered' else if arg == "--track-allocs" 'isTrackAllocs'
				args.trackAllocs = true
			end 'isTrackAllocs' else if arg == "--update-required" 'isUpdateRequired'
				args.updateRequired = true
			end 'isUpdateRequired' else if arg == "--verbose" 'isVerbose'
				args.verbose = true
			end 'isVerbose' else if arg == "--coverage" 'isCoverage'
				args.coverage = true
			end 'isCoverage' else if arg == "--profile-passes" 'isProfilePasses'
				args.profilePasses = true
			end 'isProfilePasses' else if arg == "--fast" 'isFast'
				args.fastRegalloc = true
			end 'isFast' else if arg == "--cache-stats" 'isCacheStats'
				args.cacheStats = true
			end 'isCacheStats' else if arg.startsWith("--cache-root=") 'isCacheRoot'
				// Sentinel: empty value flows to runBuild, which leaves the override
				// empty (normal cache path) rather than redirecting to bare cwd.
				args.cacheRoot = try CommandLine.optionValue(arg) otherwise ""
			end 'isCacheRoot' else if arg.startsWith("--library=") 'isLibrary'
				// Repeatable: each `--library=DIR` appends one external library dir.
				let libDir = try CommandLine.optionValue(arg) otherwise ""
				if not libDir.isEmpty() 'nonEmpty'
					args.libraries.push(libDir)
				end 'nonEmpty'
			end 'isLibrary' else if arg.startsWith("--workers=") 'isWorkers'
				let workersStr = try CommandLine.optionValue(arg) otherwise ""
				let w = try int.fromString(workersStr) otherwise throw ArgError.invalidOption(arg)
				if w < 1 'badWorkers'
					throw ArgError.invalidOption(arg)
				end 'badWorkers'
				args.workers = w as WorkerCount
			end 'isWorkers' else if arg == "--worker-persistent" 'isWorkerPersistent'
				args.workerPersistent = true
			end 'isWorkerPersistent' else if arg.startsWith("--worker-spec=") 'isWorkerSpec'
				args.workerSpec = try CommandLine.optionValue(arg) otherwise ""
			end 'isWorkerSpec' else if arg.startsWith("--worker-singles=") 'isWorkerSingles'
				args.workerSingles = try CommandLine.optionValue(arg) otherwise ""
			end 'isWorkerSingles' else if arg.startsWith("--worker-fallback=") 'isWorkerFallback'
				args.workerFallback = try CommandLine.optionValue(arg) otherwise ""
			end 'isWorkerFallback' else if arg.startsWith("--greedy-only=") 'isGreedyOnly'
				// Sentinel: empty value leaves the greedy path disabled (normal compilation).
				args.greedyOnly = try CommandLine.optionValue(arg) otherwise ""
			end 'isGreedyOnly' else if arg.startsWith("--sweep-mode=") 'isSweepMode'
				// legacy (default) | sweep | validate — see setSweepMode.
				args.sweepMode = try CommandLine.optionValue(arg) otherwise ""
			end 'isSweepMode' else if arg == "-o" or arg == "--output" 'isOutputSpaced'
				// `-o PATH` / `--output PATH`: the output path is the NEXT token.
				args.outputOverride = try allArgs.get(i + 1) otherwise throw ArgError.invalidOption(arg)
				skipNext = true
			end 'isOutputSpaced' else if arg.startsWith("--output=") 'isOutputEq'
				// `--output=PATH`: value is inline. Empty flows through as "" =
				// no override (normal path derivation).
				args.outputOverride = try CommandLine.optionValue(arg) otherwise ""
			end 'isOutputEq' else if not arg.startsWith("--") 'isPositional'
				args.path = arg
			end 'isPositional'
		end 'scan'

		// Default the positional path to cwd for commands where that is the
		// conventional target (build operates on the current directory when
		// no path is given). coverageReport must receive an explicit exe
		// path, so leave it empty for the main dispatcher to diagnose.
		let needsCwdDefault = match args.command 'needsDefault'
			build gives true
			specTest gives true
			testIncremental gives true
			testLibCache gives true
			coverageReport gives false
			clean gives true
			unknown gives true
		end 'needsDefault'
		if args.path.isEmpty() and needsCwdDefault 'defaultPath'
			args.path = Directory.currentPath().toString()
		end 'defaultPath'

		return args
	end 'parse'

	export function target() returns Target
		return match targetOption 'resolve'
			host gives detectHostTarget()
			all gives detectHostTarget()
			x64Windows gives Target.create(CpuArch.x64, os: Os.windows)
			x64Linux gives Target.create(CpuArch.x64, os: Os.linux)
			arm64Windows gives Target.create(CpuArch.arm64, os: Os.windows)
			arm64Linux gives Target.create(CpuArch.arm64, os: Os.linux)
			arm64Macos gives Target.create(CpuArch.arm64, os: Os.macos)
			wasm32Wasi gives Target.create(CpuArch.wasm32, os: Os.wasi)
		end 'resolve'
	end 'target'
end 'MaxonArgs'

function parseTargetOption(s String) returns TargetOption throws StringError
	return match s 'parse'
		"all" gives TargetOption.all
		"x64-windows" gives TargetOption.x64Windows
		"x64-linux" gives TargetOption.x64Linux
		"arm64-windows" gives TargetOption.arm64Windows
		"arm64-linux" gives TargetOption.arm64Linux
		"arm64-macos" gives TargetOption.arm64Macos
		"wasm32-wasi" gives TargetOption.wasm32Wasi
		default throws StringError.notFound
	end 'parse'
end 'parseTargetOption'
