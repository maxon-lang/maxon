// Self-hosted Maxon compiler entry point.
// Mirrors maxon-sharp/Program.cs command structure.

function main() returns ExitCode
	let args = try MaxonArgs.parse() otherwise (e) 'badArgs'
		match e 'matchErr'
			invalidOption(a) then print("Invalid option: {a}\n")
		end 'matchErr'
		return 1
	end 'badArgs'

	if args.profilePasses 'enableTimings'
		enablePassTimings()
	end 'enableTimings'

	// Phase-1 greedy-allocator test trigger: route the named function through the
	// greedy allocator during register allocation. Empty (the default) is a no-op.
	setGreedyOnlyFunc(args.greedyOnly)

	// Track-A rewrite: interference-construction mode (legacy | sweep | validate).
	// Empty (the default) → legacy, so normal compilation is unchanged.
	setSweepMode(args.sweepMode)

	// Track-A step A3: colorer strategy (legacy | sweep | validate). Empty (the
	// default) → legacy, so normal compilation is unchanged.
	setColorerMode(args.colorerMode)

	// Refcount sanitizer for SPEC RUNS: `maxon spec-test --rc-sanitize` compiles
	// every fragment with the sanitizer expanded (build-command sanitizing flows
	// through `compile(...)` instead). False (the default) leaves spec runs
	// byte-identical to before the sanitizer existed.
	setSpecRcSanitize(args.rcSanitize)

	let exit = match args.command 'cmd'
		build gives runBuild(args)
		specTest gives runSpecTests(args)
		testIncremental gives runIncrementalTests()
		testLibCache gives runLibCacheTests()
		coverageReport gives runCoverageReportCli(args)
		clean gives runClean(args)
		unknown gives unknownCommand()
	end 'cmd'

	if args.profilePasses 'emitTimings'
		dumpPassTimings()
	end 'emitTimings'

	return exit
end 'main'

function unknownCommand() returns ExitCode
	printUsage()
	return 1
end 'unknownCommand'

function runCoverageReportCli(args MaxonArgs) returns ExitCode
	if args.path.isEmpty() 'noPath'
		print("Usage: maxon coverage report <exe-path>\n")
		return 1
	end 'noPath'
	let exePath = try FilePath.from(args.path) otherwise panic("invalid path: {args.path}")
	return runCoverageReport(exePath)
end 'runCoverageReportCli'

// `maxon clean` — delete the on-disk caches for every library this project
// uses (Phase 2: stdlib; Phase 5: the project's own user-program chunk cache;
// Phase 6 extends to external libraries). Removes all `*.mxc` (every
// fingerprint × target × options combo) and stray `*.tmp` under the shared
// stdlib `.maxon/cache/` AND the project's own `.maxon/cache/`. The project dir
// is `args.path` (resolved to a directory) or the current working directory.
// Because the stdlib cache is shared, cleaning it also affects other projects'
// next build — expected for an explicit clean.
function runClean(args MaxonArgs) returns ExitCode
	let projectDir = resolveCleanProjectDir(args)
	// Forward any `--library=DIR` flags (resolved against cwd, like a build) so
	// clean sweeps those external libraries' caches too, in addition to the
	// `build.maxon` manifest entries `cleanLibraryCaches` discovers itself.
	var extraLibDirs = FilePathArray.create()
	let cwd = Directory.currentPath()
	for s in args.libraries 'eachCliLib'
		extraLibDirs.push(resolveLibraryDir(cwd, pathStr: s))
	end 'eachCliLib'
	var deleted = cleanLibraryCaches(projectDir, extraLibraryDirs: extraLibDirs)
	// Also sweep the spec-test run-skip caches (`specs/fragments-*/.spec-cache/
	// <spec>/run-cache.bin`) so a clean forces a full re-run. No-op outside the
	// maxon-libraries dev repo (no `specs/` tree).
	for path in cleanSpecRunCaches(projectDir) 'eachRunCache'
		deleted.push(path)
	end 'eachRunCache'
	if deleted.count() == 0 'nothing'
		print("maxon clean: no cache files to remove\n")
	end 'nothing' else 'some'
		for path in deleted 'eachDeleted'
			print("removed {path}\n")
		end 'eachDeleted'
		print("maxon clean: removed {deleted.count()} cache file(s)\n")
	end 'some'
	return 0
end 'runClean'

// The project directory `maxon clean` targets: the `args.path` argument
// resolved to a directory (a single-file `foo.maxon` arg → its parent), or the
// current working directory when no path is given.
function resolveCleanProjectDir(args MaxonArgs) returns FilePath
	if args.path.isEmpty() 'noArg'
		return Directory.currentPath()
	end 'noArg'
	let argPath = try FilePath.from(args.path) otherwise return Directory.currentPath()
	if Directory.exists(argPath) 'isDir'
		return argPath
	end 'isDir'
	return try argPath.parent() otherwise argPath
end 'resolveCleanProjectDir'

function printUsage()
	print("Usage: maxon <command> [options]\n")
	print("\n")
	print("Commands:\n")
	print("  build [<file|directory>] Build a project (default: current directory)\n")
	print("  run <file|directory>     Build and run\n")
	print("  spec-test [options]      Run spec tests\n")
	print("  test-incremental         Run incremental compilation tests\n")
	print("  test-lib-cache           Run library-cache tests (cold/hit/delete, fingerprint coexistence, fault injection)\n")
	print("  coverage report <exe>    Aggregate <exe>.covmap + <exe>*.covdata into <exe>.lcov\n")
	print("  clean                    Delete this project's library caches (stdlib .maxon/cache)\n")
	print("\n")
	print("Build options (build, run):\n")
	print("  --emit-ir                Write .ir file\n")
	print("  --leak-check             Wire the process-exit leak gate: exit 101 if any allocation is live at exit (uses the stdlib cache)\n")
	print("  --rc-sanitize            Refcount sanitizer: poison+quarantine freed objects so the first touch of a freed object panics immediately (diagnostic; zero cost when off)\n")
	print("  --dump-stages[=NAMES]    Write IR at each pipeline stage (user program only); NAMES = comma-separated pass-name substrings to dump only matching stages (e.g. =insert-refcounts)\n")
	print("  --dump-stages-stdlib[=NAMES]  Like --dump-stages but include the full stdlib IR in each stage file\n")
	print("  --dump-func=NAMES         Restrict --dump-stages output to functions whose name contains one of the comma-separated NAMES (e.g. =parsePostfix)\n")
	print("  --track-allocs           Track heap allocations and print memory stats\n")
	print("  --fast                   Fast register allocation: much faster dev builds, slightly worse codegen (default is quality)\n")
	print("  --coverage               Emit a coverage-instrumented executable + .covmap\n")
	print("  --cache-stats            Print a CACHE_STATS line after the build (library-cache hit/miss diagnostics)\n")
	print("\n")
	print("Spec test options:\n")
	print("  --filter=PATTERN         Run only tests matching pattern\n")
	print("  --target=<TARGET|all>    Cross-compile tests for target (e.g. x64-linux)\n")
	print("  --update-required        Update RequiredLowering/stderr blocks in spec files\n")
	print("  --verbose                Show pass/fail per test\n")
	print("  --profile-passes         Print per-pass wall-clock timings at the end of the run\n")
	print("  --workers=N              Number of parallel batch workers (default: 12, 1=serial)\n")
	print("\n")
	print("Logging (all commands):\n")
	print("  --log=LEVEL              Set all log categories to LEVEL\n")
	print("  --log=CATEGORY:LEVEL     Set specific category to LEVEL\n")
	print("\n")
	print("Log levels: none, error, info, debug, trace\n")
	print("Log categories: compiler, lexer, parser, semantic, ir, codegen, pe, testing\n")
end 'printUsage'

function runBuild(args MaxonArgs) returns ExitCode
	let fp = try FilePath.from(args.path) otherwise panic("invalid path: {args.path}")

	// --emit-ir → <path>.ir next to the source; --dump-stages → numbered files
	// sharing the source's base path (extension stripped).
	var irDump = IrDumpOptions.disabled()
	irDump.emitFinal = args.emitIr
	if args.dumpStages 'wantStages'
		irDump.stagesBasePath = fp.changeExtension("").toString()
		irDump.stagesIncludeStdlib = args.dumpStagesStdlib
		irDump.stagesFilter = args.dumpStagesFilter
		irDump.stagesFuncFilter = args.dumpFuncFilter
	end 'wantStages'
	var irOutputPath = FilePath from ""
	if args.emitIr 'wantIr'
		irOutputPath = fp.changeExtension(".ir")
	end 'wantIr'

	// `--cache-root=DIR` (internal, testing): empty string → empty FilePath →
	// normal per-library cache path; non-empty redirects the cache to DIR.
	var cacheRoot = FilePath from ""
	if not args.cacheRoot.isEmpty() 'hasCacheRoot'
		cacheRoot = try FilePath.from(args.cacheRoot) otherwise panic("invalid --cache-root path: {args.cacheRoot}")
	end 'hasCacheRoot'

	let startMs = Clock.nowMs()
	let outputPath = try compile(fp, target: args.target(), coverage: args.coverage, irDump: irDump, irOutputPath: irOutputPath, leakCheck: args.leakCheck, cacheStats: args.cacheStats, cacheRoot: cacheRoot, libraryDirs: args.libraries, fastRegalloc: args.fastRegalloc, outputPathOverride: args.outputOverride, rcSanitize: args.rcSanitize) otherwise (e) 'err'
		match e 'report'
			fileNotFound(p) then printError("error: file not found: {p}\n")
			directoryNotFound(p) then printError("error: directory not found: {p}\n")
			noSourceFiles(r) then printError("error: no source files under {r}\n")
			readError(p) then printError("error: could not read {p}\n")
			compileError then printError("error: compilation failed\n")
		end 'report'
		return 1
	end 'err'
	let elapsedMs = Clock.nowMs() - startMs

	print("Compiled -> {outputPath} ({elapsedMs}ms)\n")

	return 0
end 'runBuild'

function runSpecTests(args MaxonArgs) returns ExitCode
	match args.targetOption 'dispatch'
		host then return runSpecTestsForTarget(args)
		all then return runAllTargetTests(args.filter)
		x64Windows to wasm32Wasi then return runSpecTestsForTarget(args)
	end 'dispatch'
end 'runSpecTests'

function runSpecTestsForTarget(args MaxonArgs) returns ExitCode
	// Golden blocks pin DEFAULT-build output; a sanitized build's IR and .rdata
	// legitimately differ, so regenerating goldens from one would poison every
	// subsequent default run. Reject the combination outright.
	if args.updateRequired and args.rcSanitize 'sanitizedRegen'
		printError("error: --update-required cannot be combined with --rc-sanitize (goldens must be regenerated from a default build)\n")
		return 1
	end 'sanitizedRegen'

	let target = args.target()
	if not isSupportedTarget(target) 'unsupported'
		let host = detectHostTarget()
		printError("error: cannot run spec tests for {targetToString(target)} on {targetToString(host)} host (cross-execution not supported; only the host target and wasm32-wasi can be tested)\n")
		return 1
	end 'unsupported'
	// Persistent worker mode: stay alive for the parent's whole run, reading
	// one JOB:<kind>:<payload> per line from stdin and emitting WORKER_READY +
	// result markers on stdout. Spawned by the parallel dispatcher.
	if args.workerPersistent 'isPersistentWorker'
		return runPersistentWorker(args.filter, target: target, verbose: args.verbose)
	end 'isPersistentWorker'
	logInfo(LogCategory.testing, message: function() gives "Running self-hosted spec tests ({targetToString(target)})...")
	if args.workers == 1 'isSerial'
		return runAllSpecTests(args.filter, target: target, updateRequired: args.updateRequired, verbose: args.verbose)
	end 'isSerial'
	// Parallel mode: spawn `workers` persistent worker subprocesses and
	// dispatch jobs from a single slowest-first queue, draining whichever
	// worker has results ready (no head-of-line blocking on slow specs).
	return runAllSpecTestsParallel(args.filter, target: target, workerCount: args.workers, updateRequired: args.updateRequired, verbose: args.verbose, sweepMode: args.sweepMode)
end 'runSpecTestsForTarget'

function runAllTargetTests(filter String) returns ExitCode
	var totalFailed = 0

	for cpu in CpuArch.allCases 'cpus'
		for os in Os.allCases 'oses'
			let t = Target.create(cpu, os: os)
			if not isSupportedTarget(t) 'skipUnsupported'
				continue
			end 'skipUnsupported'
			logInfo(LogCategory.testing, message: function() gives "Testing target: {targetToString(t)}")
			totalFailed = totalFailed + runAllSpecTests(filter, target: t)
		end 'oses'
	end 'cpus'

	if totalFailed > 0 'hasFail'
		return 1
	end 'hasFail'

	return 0
end 'runAllTargetTests'
