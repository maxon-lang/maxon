{
  "permissions": {
    "allow": [
      "mcp__maxon__build",
      "mcp__maxon__run_spec_test",
      "mcp__maxon__spec_test_outcome",
      "mcp__maxon__execute",
      "mcp__maxon__check",
      "mcp__maxon__info",
      "mcp__maxon__dump_ir",
      "mcp__maxon__lookup_error_code",
      "mcp__maxon__run_scale_test",
      "mcp__maxon__fmt",
      "Bash(./maxon-bin/.maxon/maxon.exe spec-test:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/statusline.mjs\"",
    "refreshInterval": 60
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sweep-temp.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-heredoc.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__maxon__run_spec_test",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-full-suite.sh\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "maxon": {
      "source": {
        "source": "github",
        "repo": "maxon-lang/maxon"
      }
    }
  },
  "enabledPlugins": {
    "maxon-lsp@maxon": true
  }
}
