public let benchmarkName = "aes"
let ctrCounter = 2

public type Fixtures
	let key128 as ByteArray
	let nonce as ByteArray
	let block as ByteArray
	let aad as ByteArray
	let small as ByteArray
	let kib1 as ByteArray
	let kib16 as ByteArray
	let sealed16k as ByteArray
	let aes128 as Aes
	let aes256 as Aes
	let gcm128 as AesGcm
	let gcm256 as AesGcm

	public static function create(_ Settings) returns Fixtures
		let key128 = filled(16, seed: 0)
		let key256 = filled(32, seed: 0)
		let nonce = filled(12, seed: 100)
		let aad = filled(13, seed: 50)
		let kib16 = filled(16384, seed: 7)
		let gcm128 = try AesGcm.create(key128) otherwise panic("key")

		return Self{
			key128: key128,
			nonce: nonce,
			block: filled(16, seed: 200),
			aad: aad,
			small: filled(64, seed: 7),
			kib1: filled(1024, seed: 7),
			kib16: kib16,
			sealed16k: try gcm128.seal(nonce, plaintext: kib16, additionalData: aad) otherwise panic("seal"),
			aes128: try Aes.create(key128) otherwise panic("key"),
			aes256: try Aes.create(key256) otherwise panic("key"),
			gcm128: gcm128,
			gcm256: try AesGcm.create(key256) otherwise panic("key")
		}
	end 'create'
end 'Fixtures'

public type Outcome
	let bytes as ByteArray

	static function create(bytes ByteArray) returns Outcome
		return Self{bytes: bytes}
	end 'create'

	public function answer() returns Count
		return digest(bytes)
	end 'answer'
end 'Outcome'

public enum Workload
	keySetup128
	keySetup128Into
	block128
	block128Into
	ctr128
	ctr256
	gcm128Seal64
	gcm128Seal64Into
	gcm128Seal1k
	gcm128Seal1kInto
	gcm128Seal16k
	gcm128Seal16kInto
	gcm128Open16k
	gcm256Seal16k
	gcm256Seal16kInto
end 'Workload'

public function nameOf(workload Workload) returns String
	return match workload 'name'
		keySetup128 gives "keysetup-128"
		keySetup128Into gives "keysetup-128-into"
		block128 gives "block-128"
		block128Into gives "block-128-into"
		ctr128 gives "ctr-128-16k"
		ctr256 gives "ctr-256-16k"
		gcm128Seal64 gives "gcm-128-seal-64"
		gcm128Seal64Into gives "gcm-128-seal-64-into"
		gcm128Seal1k gives "gcm-128-seal-1k"
		gcm128Seal1kInto gives "gcm-128-seal-1k-into"
		gcm128Seal16k gives "gcm-128-seal-16k"
		gcm128Seal16kInto gives "gcm-128-seal-16k-into"
		gcm128Open16k gives "gcm-128-open-16k"
		gcm256Seal16k gives "gcm-256-seal-16k"
		gcm256Seal16kInto gives "gcm-256-seal-16k-into"
	end 'name'
end 'nameOf'

public function baseIterationsOf(workload Workload) returns Count
	return match workload 'iterations'
		keySetup128 or
		keySetup128Into gives 20000
		block128 or
		block128Into gives 200000
		gcm128Seal64 or
		gcm128Seal64Into gives 100000
		gcm128Seal1k or
		gcm128Seal1kInto gives 10000
		ctr128 or
		ctr256 or
		gcm128Seal16k or
		gcm128Seal16kInto or
		gcm128Open16k or
		gcm256Seal16k or
		gcm256Seal16kInto gives 1000
	end 'iterations'
end 'baseIterationsOf'

public function bytesOf(workload Workload) returns Count
	return match workload 'bytes'
		keySetup128 or
		keySetup128Into gives 0
		block128 or
		block128Into gives 16
		gcm128Seal64 or
		gcm128Seal64Into gives 64
		gcm128Seal1k or
		gcm128Seal1kInto gives 1024
		ctr128 or
		ctr256 or
		gcm128Seal16k or
		gcm128Seal16kInto or
		gcm128Open16k or
		gcm256Seal16k or
		gcm256Seal16kInto gives 16384
	end 'bytes'
end 'bytesOf'

function keySetup(key ByteArray) returns ByteArray
	let cipher = try Aes.create(key) otherwise panic("key")

	return try cipher.encryptBlock(key) otherwise panic("block")
end 'keySetup'

function keySetupInto(key ByteArray, output ByteArray) returns ByteArray
	let cipher = try Aes.create(key) otherwise panic("key")
	try cipher.encryptBlockInto(key, output: output, at: 0) otherwise panic("block")

	return output
end 'keySetupInto'

function encryptInPlace(cipher Aes, block ByteArray) returns ByteArray
	try cipher.encryptBlockInto(block, output: block, at: 0) otherwise panic("block")

	return block
end 'encryptInPlace'

function sealReusing(aead AesGcm, f Fixtures, plaintext ByteArray, output ByteArray) returns ByteArray
	try aead.sealInto(output, at: 0, nonce: f.nonce, plaintext: plaintext, additionalData: f.aad) otherwise panic("seal")

	return output
end 'sealReusing'

function step(workload Workload, f Fixtures, previous ByteArray) returns ByteArray
	return match workload 'byWorkload'
		keySetup128 gives keySetup(f.key128)
		keySetup128Into gives keySetupInto(f.key128, output: previous)
		block128 gives try f.aes128.encryptBlock(previous) otherwise panic("block")
		block128Into gives encryptInPlace(f.aes128, block: previous)
		ctr128 gives try f.aes128.xorKeyStream(f.nonce, counter: ctrCounter, data: f.kib16) otherwise panic("ctr")
		ctr256 gives try f.aes256.xorKeyStream(f.nonce, counter: ctrCounter, data: f.kib16) otherwise panic("ctr")
		gcm128Seal64 gives try f.gcm128.seal(f.nonce, plaintext: f.small, additionalData: f.aad) otherwise panic("seal")
		gcm128Seal64Into gives sealReusing(f.gcm128, f: f, plaintext: f.small, output: previous)
		gcm128Seal1k gives try f.gcm128.seal(f.nonce, plaintext: f.kib1, additionalData: f.aad) otherwise panic("seal")
		gcm128Seal1kInto gives sealReusing(f.gcm128, f: f, plaintext: f.kib1, output: previous)
		gcm128Seal16k gives try f.gcm128.seal(f.nonce, plaintext: f.kib16, additionalData: f.aad) otherwise panic("seal")
		gcm128Seal16kInto gives sealReusing(f.gcm128, f: f, plaintext: f.kib16, output: previous)
		gcm128Open16k gives try f.gcm128.open(f.nonce, sealed: f.sealed16k, additionalData: f.aad) otherwise panic("open")
		gcm256Seal16k gives try f.gcm256.seal(f.nonce, plaintext: f.kib16, additionalData: f.aad) otherwise panic("seal")
		gcm256Seal16kInto gives sealReusing(f.gcm256, f: f, plaintext: f.kib16, output: previous)
	end 'byWorkload'
end 'step'

public function runOnce(workload Workload, f Fixtures, iterations Count) returns Outcome
	var last = f.block.clone()

	for _ in 0 upto iterations 'each'
		last = step(workload, f: f, previous: last)
	end 'each'

	return Outcome.create(last)
end 'runOnce'
