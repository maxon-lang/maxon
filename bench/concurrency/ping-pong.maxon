let defaultRoundTrips = 1000000
let usageExit = 2

type Partner
	static function create() returns Self
		return Self{}
	end 'create'

	export function ping(round Count) returns Count
		return round + 1
	end 'ping'
end 'Partner'

function main() returns ExitCode
	let roundTrips = try CommandLine.readOptionalIntArgument(1, otherwise: defaultRoundTrips) otherwise 'badArgument'
		printError("ping-pong: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badArgument'

	let partner = spawn Partner.create()
	var sum = 0 as Count

	for round in 0 upto roundTrips 'eachRound'
		let reply = try await partner.ping(round) otherwise panic("ping-pong: the partner stopped before it answered")
		sum = sum + reply
	end 'eachRound'

	print("ping-pong {sum}\n")
	return 0
end 'main'
