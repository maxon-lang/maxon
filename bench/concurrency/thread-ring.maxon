typealias RingLabel = int(1 to 503)
typealias RingSlot = int(0 to 502) implements ElementIndex

let defaultPasses = 1000
let ringSize = 503
let usageExit = 2

enum ReporterError implements Error
	notReported
end 'ReporterError'

union Holder
	unreported
	reported(label RingLabel)
end 'Holder'

type Reporter
	var holder as Holder

	static function create() returns Self
		return Self{holder: Holder.unreported}
	end 'create'

	export function report(label RingLabel)
		self.holder = Holder.reported(label)
	end 'report'

	export function whoHolds() returns RingLabel throws ReporterError
		match self.holder 'held'
			reported(label) then return label
			unreported then throw ReporterError.notReported
		end 'held'
	end 'whoHolds'
end 'Reporter'

typealias RingNodeArray = Array with RingNode.handle

type RingNode
	var label as RingLabel
	var reporter as Reporter.handle

	static function create(label RingLabel, reporter Reporter.handle) returns Self
		return Self{label: label, reporter: reporter}
	end 'create'

	export function pass(ring immutable RingNodeArray, remaining Count)
		if remaining == 0 'holdsZero'
			try self.reporter.report(self.label) otherwise panic("RingNode.pass: the reporter refused the only report")
			return
		end 'holdsZero'

		let following = (self.label mod ringSize) as RingSlot
		let next = try ring.get(following) otherwise panic("RingNode.pass: every slot lies inside the ring")
		try next.pass(ring, remaining: remaining - 1) otherwise panic("RingNode.pass: the only token in the ring was refused")
	end 'pass'
end 'RingNode'

function spawnRing(reporter Reporter.handle) returns immutable RingNodeArray
	let nodes = RingNodeArray.create(0) as isolated RingNodeArray

	modify nodes 'fill'
		for slot in 0 upto ringSize 'spawnNodes'
			nodes.push(spawn RingNode.create((slot + 1) as RingLabel, reporter: reporter.clone()))
		end 'spawnNodes'
	end 'fill'

	return freeze nodes
end 'spawnRing'

function main() returns ExitCode
	let passes = try CommandLine.readOptionalIntArgument(1, otherwise: defaultPasses) otherwise 'badArgument'
		printError("thread-ring: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badArgument'

	let reporter = spawn Reporter.create()
	let ring = spawnRing(reporter)
	let first = try ring.get(0) otherwise panic("thread-ring: the ring holds a first node")

	try first.pass(ring, remaining: passes) otherwise panic("thread-ring: the first node refused the token")

	// The report is a reply-less send, so only an idle ring guarantees it has landed before the read.
	_ = Scheduler.quiesce()
	let holder = try await reporter.whoHolds() otherwise panic("thread-ring: the token never reached zero")

	print("thread-ring {holder}\n")
	return 0
end 'main'
