typealias IncrementedPromise = Promise with (Count)
typealias IncrementedPromiseArray = Array with IncrementedPromise

let incrementerCount = 64
let defaultPerIncrementer = 100000
let usageExit = 2

type Counter
	var count as Count

	static function create() returns Self
		return Self{count: 0}
	end 'create'

	export function inc()
		self.count = self.count + 1
	end 'inc'

	export function read() returns Count
		return self.count
	end 'read'
end 'Counter'

function deliverIncrement(counter Counter.handle)
	try counter.inc(sendTimeout: ForeverMs) otherwise (e) 'refused'
		match e 'why'
			mailboxFull then panic("shared-counter: an incrementer runs on its service's green thread, which no promise names and so nothing cancels, and a send given ForeverMs waits for room — mailboxFull cannot occur")
			serviceStopped then panic("shared-counter: the counter stopped while an incrementer was sending")
		end 'why'
	end 'refused'
end 'deliverIncrement'

function readCount(counter Counter.handle) returns Count
	return try await counter.read(sendTimeout: ForeverMs) otherwise (e) 'refused'
		match e 'why'
			mailboxFull then panic("shared-counter: main's green thread is named by no promise and so nothing cancels it, and a send given ForeverMs waits for room — mailboxFull cannot occur")
			serviceStopped then panic("shared-counter: the counter stopped before the final read")
		end 'why'
	end 'refused'
end 'readCount'

type Incrementer
	var counter as Counter.handle

	static function create(counter Counter.handle) returns Self
		return Self{counter: counter}
	end 'create'

	export function increment(perIncrementer Count) returns Count
		for _ in 0 upto perIncrementer 'eachIncrement'
			deliverIncrement(self.counter)
		end 'eachIncrement'

		return perIncrementer
	end 'increment'
end 'Incrementer'

function main() returns ExitCode
	let perIncrementer = try CommandLine.readOptionalIntArgument(1, otherwise: defaultPerIncrementer) otherwise 'badArgument'
		printError("shared-counter: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badArgument'

	let counter = spawn Counter.create()
	var finished = IncrementedPromiseArray.create()

	for _ in 0 upto incrementerCount 'spawnIncrementers'
		let incrementer = spawn Incrementer.create(counter.clone())
		finished.push(try incrementer.increment(perIncrementer) otherwise panic("shared-counter: a fresh incrementer refused its only message"))
	end 'spawnIncrementers'

	// An incrementer replies only after its last `inc()`, and the counter's mailbox is FIFO, so once
	// every reply is in, every increment is queued ahead of the read below.
	for completion in finished 'awaitIncrementers'
		_ = await completion
	end 'awaitIncrementers'

	print("shared-counter {readCount(counter)}\n")
	return 0
end 'main'
