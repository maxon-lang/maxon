typealias Word = bits(64)
typealias KernelPromise = Promise with (Count)
typealias KernelPromiseArray = Array with KernelPromise
typealias WorkerArray = Array with Worker.handle

let defaultTaskCount = 4096
let defaultIterations = 250000
let xorshiftLeftFirst = 13
let xorshiftRight = 7
let xorshiftLeftSecond = 17
let resultShift = 32
let usageExit = 2
let minimumMailboxCapacity = 1

function kernel(task Count, iterations Count) returns Count
	var x = (task + 1) as Word

	for _ in 0 upto iterations 'eachIteration'
		x = x xor (x shl xorshiftLeftFirst)
		x = x xor (x shr xorshiftRight)
		x = x xor (x shl xorshiftLeftSecond)
	end 'eachIteration'

	return (x shr resultShift) as Count
end 'kernel'

type Worker
	static function create() returns Self
		return Self{}
	end 'create'

	export function run(task Count, iterations Count) returns Count
		return kernel(task, iterations: iterations)
	end 'run'
end 'Worker'

function main() returns ExitCode
	let taskCount = try CommandLine.readOptionalIntArgument(1, otherwise: defaultTaskCount) otherwise 'badTaskCount'
		printError("worker-pool: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badTaskCount'

	let iterations = try CommandLine.readOptionalIntArgument(2, otherwise: defaultIterations) otherwise 'badIterations'
		printError("worker-pool: argument 2 is not a non-negative integer\n")
		return usageExit
	end 'badIterations'

	let workerCount = Scheduler.processorCount() as Count
	let tasksPerWorker = try ((taskCount + workerCount - 1) / workerCount) otherwise panic("worker-pool: the processor count is at least 1")
	let mailboxCapacity = (tasksPerWorker if tasksPerWorker > minimumMailboxCapacity else minimumMailboxCapacity) as MailboxCapacity
	var workers = WorkerArray.create()

	for _ in 0 upto workerCount 'spawnWorkers'
		workers.push(spawn(capacity: mailboxCapacity) Worker.create())
	end 'spawnWorkers'

	var results = KernelPromiseArray.create()
	results.reserve(taskCount)

	for task in 0 upto taskCount 'sendTasks'
		let slot = try (task mod workerCount) otherwise panic("worker-pool: the processor count is at least 1")
		view worker = try workers.get(slot as Count) otherwise panic("worker-pool: the slot is below the worker count")
		results.push(try worker.run(task, iterations: iterations) otherwise panic("worker-pool: a worker's mailbox holds its whole share of the tasks, so a send is refused only by a worker that stopped"))
	end 'sendTasks'

	var sum = 0 as Count

	for result in results 'awaitResults'
		sum = sum + (await result)
	end 'awaitResults'

	print("worker-pool {sum}\n")
	return 0
end 'main'
