typealias Tally = int(0 to u64.max)
typealias Word = bits(64)
typealias KernelPromise = Promise with (Tally, ServiceError)
typealias KernelPromiseArray = Array with KernelPromise
typealias WorkerArray = Array with Worker.handle

let defaultTaskCount = 4096
let defaultIterations = 250000
let xorshiftLeftFirst = 13
let xorshiftRight = 7
let xorshiftLeftSecond = 17
let resultShift = 32
let usageExit = 2

function kernel(task Tally, iterations Tally) returns Tally
	var x = (task + 1) as Word

	for _ in 0 upto iterations 'eachIteration'
		x = x xor (x shl xorshiftLeftFirst)
		x = x xor (x shr xorshiftRight)
		x = x xor (x shl xorshiftLeftSecond)
	end 'eachIteration'

	return (x shr resultShift) as Tally
end 'kernel'

type Worker
	static function create() returns Self
		return Self{}
	end 'create'

	export function run(task Tally, iterations Tally) returns Tally
		return kernel(task, iterations: iterations)
	end 'run'
end 'Worker'

function sizeArgument(position Count, fallback Tally) returns Tally throws ParseError
	let args = CommandLine.args()

	if args.count() <= position 'absent'
		return fallback
	end 'absent'

	let raw = try args.get(position) otherwise panic("sizeArgument: count() > position, so the index is live")
	let value = try int.fromString(raw)

	if value < 0 'negative'
		throw ParseError.invalidFormat
	end 'negative'

	return value as Tally
end 'sizeArgument'

function main() returns ExitCode
	let taskCount = try sizeArgument(1, fallback: defaultTaskCount) otherwise 'badTaskCount'
		printError("worker-pool: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badTaskCount'

	let iterations = try sizeArgument(2, fallback: defaultIterations) otherwise 'badIterations'
		printError("worker-pool: argument 2 is not a non-negative integer\n")
		return usageExit
	end 'badIterations'

	let workerCount = Scheduler.processorCount() as Tally
	var workers = WorkerArray.create()

	for _ in 0 upto workerCount 'spawnWorkers'
		workers.push(spawn Worker.create())
	end 'spawnWorkers'

	var results = KernelPromiseArray.create()
	results.reserve(taskCount as Count)

	for task in 0 upto taskCount 'sendTasks'
		let slot = try (task mod workerCount) otherwise panic("worker-pool: the processor count is at least 1")
		let worker = try workers.get(slot as Count) otherwise panic("worker-pool: the slot is below the worker count")
		results.push(worker.run(task, iterations: iterations))
	end 'sendTasks'

	var sum = 0 as Tally

	for result in results 'awaitResults'
		sum = sum + (try await result otherwise panic("worker-pool: a worker stopped before it answered"))
	end 'awaitResults'

	print("worker-pool {sum}\n")
	return 0
end 'main'
