typealias CountPromise = Promise with Count
typealias CountPromiseArray = Array with CountPromise

let defaultCoroutineCount = 100000
let usageExit = 2

function yieldOnce(value Count) returns Count
	Scheduler.yield()
	return value
end 'yieldOnce'

function main() returns ExitCode
	let coroutineCount = try CommandLine.readOptionalIntArgument(1, otherwise: defaultCoroutineCount) otherwise 'badArgument'
		printError("coroutine-churn: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badArgument'

	var coroutines = CountPromiseArray.create()
	coroutines.reserve(coroutineCount)

	for index in 0 upto coroutineCount 'startCoroutines'
		coroutines.push(async yieldOnce(index))
	end 'startCoroutines'

	var sum = 0 as Count

	for coroutine in coroutines 'awaitCoroutines'
		sum = sum + await coroutine
	end 'awaitCoroutines'

	print("coroutine-churn {sum}\n")
	return 0
end 'main'
