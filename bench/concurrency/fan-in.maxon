typealias ProducerIndex = int(0 to 63)
typealias SentPromise = Promise with (Count)
typealias SentPromiseArray = Array with SentPromise

let producerCount = 64
let defaultPerProducer = 100000
let usageExit = 2

type Sink
	var total as Count

	static function create() returns Self
		return Self{total: 0}
	end 'create'

	export function receive(value Count)
		self.total = self.total + value
	end 'receive'

	export function received() returns Count
		return self.total
	end 'received'
end 'Sink'

function deliver(sink Sink.handle, value Count)
	try sink.receive(value, sendTimeout: ForeverMs) otherwise (e) 'refused'
		match e 'why'
			mailboxFull then panic("fan-in: a producer is a coroutine whose promise main awaits, and a send given ForeverMs waits for room — mailboxFull cannot occur")
			serviceStopped then panic("fan-in: the sink stopped while a producer was sending")
		end 'why'
	end 'refused'
end 'deliver'

function readTotal(sink Sink.handle) returns Count
	return try await sink.received(sendTimeout: ForeverMs) otherwise (e) 'refused'
		match e 'why'
			mailboxFull then panic("fan-in: main's green thread is named by no promise and so nothing cancels it, and a send given ForeverMs waits for room — mailboxFull cannot occur")
			serviceStopped then panic("fan-in: the sink stopped before the final read")
		end 'why'
	end 'refused'
end 'readTotal'

function produce(sink Sink.handle, index ProducerIndex, perProducer Count) returns Count
	let base = (index as Count) * perProducer

	for offset in 0 upto perProducer 'eachValue'
		deliver(sink, value: base + offset)
	end 'eachValue'

	return perProducer
end 'produce'

function main() returns ExitCode
	let perProducer = try CommandLine.readOptionalIntArgument(1, otherwise: defaultPerProducer) otherwise 'badArgument'
		printError("fan-in: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badArgument'

	let sink = spawn Sink.create()
	let sent = SentPromiseArray.create(0)

	for index in 0 upto producerCount 'startProducers'
		sent.push(async produce(sink, index: index as ProducerIndex, perProducer: perProducer))
	end 'startProducers'

	// A producer's promise resolves after its last send is queued, and the sink's mailbox is FIFO, so
	// the read below must follow every await or the total comes up short.
	for completion in sent 'awaitProducers'
		_ = await completion
	end 'awaitProducers'

	print("fan-in {readTotal(sink)}\n")
	return 0
end 'main'
