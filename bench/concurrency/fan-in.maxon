typealias ProducerIndex = int(0 to 63)
typealias SentPromise = Promise with (Count)
typealias SentPromiseArray = Array with SentPromise

let producerCount = 64
let defaultPerProducer = 100000
let usageExit = 2

type Sink
	var total as Count

	static function create() returns Self
		return Self{total: 0}
	end 'create'

	export function receive(value Count)
		self.total = self.total + value
	end 'receive'

	export function received() returns Count
		return self.total
	end 'received'
end 'Sink'

function deliver(sink Sink.handle, value Count)
	var landed = false

	while not landed 'untilItLands'
		try sink.receive(value) otherwise (e) 'refused'
			match e 'why'
				mailboxFull then Scheduler.yield()
				serviceStopped then panic("fan-in: the sink stopped while a producer was sending")
			end 'why'

			continue
		end 'refused'

		landed = true
	end 'untilItLands'
end 'deliver'

function readTotal(sink Sink.handle) returns Count
	var total = 0 as Count
	var read = false

	while not read 'untilItLands'
		let received = try await sink.received() otherwise (e) 'refused'
			match e 'why'
				mailboxFull then Scheduler.yield()
				serviceStopped then panic("fan-in: the sink stopped before the final read")
			end 'why'

			continue
		end 'refused'

		total = received
		read = true
	end 'untilItLands'

	return total
end 'readTotal'

type Producer
	var index as ProducerIndex
	var sink as Sink.handle

	static function create(index ProducerIndex, sink Sink.handle) returns Self
		return Self{index: index, sink: sink}
	end 'create'

	export function produce(perProducer Count) returns Count
		let base = (self.index as Count) * perProducer

		for offset in 0 upto perProducer 'eachValue'
			deliver(self.sink, value: base + offset)
		end 'eachValue'

		return perProducer
	end 'produce'
end 'Producer'

function main() returns ExitCode
	let perProducer = try CommandLine.readOptionalIntArgument(1, otherwise: defaultPerProducer) otherwise 'badArgument'
		printError("fan-in: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badArgument'

	let sink = spawn Sink.create()
	var sent = SentPromiseArray.create()

	for index in 0 upto producerCount 'spawnProducers'
		let producer = spawn Producer.create(index as ProducerIndex, sink: sink.clone())
		sent.push(try producer.produce(perProducer) otherwise panic("fan-in: a fresh producer refused its only message"))
	end 'spawnProducers'

	// A producer replies only after its last send, and the sink's mailbox is FIFO, so once every reply
	// is in, every value is queued ahead of the read below.
	for completion in sent 'awaitProducers'
		_ = await completion
	end 'awaitProducers'

	print("fan-in {readTotal(sink)}\n")
	return 0
end 'main'
