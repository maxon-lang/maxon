typealias DoubledPromise = Promise with (Count)
typealias DoubledPromiseArray = Array with DoubledPromise

let defaultThreadCount = 100000
let usageExit = 2

type Doubler
	var index as Count

	static function create(index Count) returns Self
		return Self{index: index}
	end 'create'

	export function doubled() returns Count
		return self.index * 2
	end 'doubled'
end 'Doubler'

function main() returns ExitCode
	let threadCount = try CommandLine.readOptionalIntArgument(1, otherwise: defaultThreadCount) otherwise 'badArgument'
		printError("spawn-many: argument 1 is not a non-negative integer\n")
		return usageExit
	end 'badArgument'

	var replies = DoubledPromiseArray.create()
	replies.reserve(threadCount)

	for index in 0 upto threadCount 'spawnDoublers'
		let doubler = spawn Doubler.create(index)
		replies.push(try doubler.doubled() otherwise panic("spawn-many: a fresh doubler refused its only message"))
	end 'spawnDoublers'

	var sum = 0 as Count

	for reply in replies 'awaitDoublers'
		sum = sum + (await reply)
	end 'awaitDoublers'

	print("spawn-many {sum}\n")
	return 0
end 'main'
